{
  "name": "@mewhhaha/fig",
  "version": "0.0.2",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./cli": "./src/cli.ts",
    "./lsp": "./src/lsp/main.ts",
    "./unstable": "./src/unstable.ts"
  },
  "imports": {
    "@mewhhaha/baba": "jsr:@mewhhaha/baba@0.3.7",
    "tsdoc": "npm:@microsoft/tsdoc@0.15.1",
    "web-tree-sitter": "npm:web-tree-sitter@0.26.6"
  },
  "tasks": {
    "grammar": "DENO_DIR=.deno-cache deno run --allow-read --allow-write scripts/generate_grammar.ts",
    "parser": "DENO_DIR=.deno-cache deno run --allow-read --allow-write --allow-run scripts/build_wasm_parser.ts",
    "codegen": "deno task grammar && deno task parser",
    "check": "DENO_DIR=.deno-cache deno check src/**/*.ts tests/**/*.ts scripts/**/*.ts tmp/large_compile_bench/run.ts tmp/large_compile_bench/generate.ts",
    "test": "DENO_DIR=.deno-cache deno test --allow-read --allow-write --allow-run --ignore=.deno-cache",
    "lsp": "DENO_DIR=.deno-cache deno run --allow-read src/lsp/main.ts",
    "bench:const": "DENO_DIR=.deno-cache deno run --allow-read scripts/bench_const_params.ts",
    "bench:eff-rows": "DENO_DIR=.deno-cache deno run --allow-read scripts/bench_eff_rows.ts",
    "bench:range-fold": "DENO_DIR=.deno-cache deno run --allow-read scripts/bench_range_fold_compile.ts",
    "bench:monad-stack": "DENO_DIR=.deno-cache deno run --allow-read scripts/bench_monad_stack.ts",
    "bench:memory-model": "DENO_DIR=.deno-cache deno run --allow-read scripts/bench_memory_model.ts",
    "bench:watch-compile": "DENO_DIR=.deno-cache deno run --allow-read scripts/bench_watch_compile.ts",
    "bench:large-compile": "DENO_DIR=.deno-cache deno run --allow-read --allow-write --allow-run tmp/large_compile_bench/run.ts",
    "bench:compiler-sources": "DENO_DIR=.deno-cache deno run --v8-flags=--stack-size=8192 --allow-read --allow-write --allow-run scripts/bench_compiler_sources.ts",
    "bench:ecs-compare": "DENO_DIR=.deno-cache deno run --allow-read --allow-write --allow-run scripts/bench_ecs_compare.ts",
    "entrypoint:check": "DENO_DIR=.deno-cache deno check src/mod.ts src/cli.ts src/lsp/main.ts && DENO_DIR=.deno-cache deno run --allow-read --allow-write src/cli.ts run examples/hello.fig",
    "release:binaries": "DENO_DIR=.deno-cache deno run --allow-read --allow-write --allow-run --allow-env=RELEASE_TAG scripts/build_release_binaries.ts",
    "release:binary:check": "DENO_DIR=.deno-cache deno run --allow-read --allow-write --allow-run scripts/check_release_binary.ts",
    "snapshots": "DENO_DIR=.deno-cache deno test --allow-read --allow-write tests/wat_snapshot_test.ts",
    "smoke": "DENO_DIR=.deno-cache deno run --allow-read --allow-write src/cli.ts run examples/hello.fig",
    "helix": "DENO_DIR=.deno-cache deno run --allow-read --allow-write --allow-run scripts/build_helix_parser.ts && env FIG_HELIX_CONFIG=$PWD/helix/config/helix FIG_HELIX_RUNTIME=$PWD/helix/runtime DENO_DIR=.deno-cache deno run --allow-read --allow-write --allow-env scripts/install_helix.ts && env XDG_CONFIG_HOME=$PWD/helix/config HELIX_RUNTIME=$PWD/helix/runtime hx --health fig"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2
  }
}
