{
  "name": "@mewhhaha/shovel",
  "version": "0.1.0",
  "exports": {
    ".": "./src/mod.ts"
  },
  "imports": {
    "@mewhhaha/baba": "../baba/src/mod.ts",
    "web-tree-sitter": "npm:web-tree-sitter@0.26.6"
  },
  "tasks": {
    "grammar": "deno run --allow-read --allow-write scripts/generate_grammar.ts",
    "parser": "deno run --allow-read --allow-write --allow-run scripts/build_wasm_parser.ts",
    "codegen": "deno task grammar && deno task parser",
    "check": "deno check src/**/*.ts tests/**/*.ts scripts/**/*.ts",
    "test": "deno test --allow-read --allow-write --allow-run",
    "bench:const": "deno run --allow-read scripts/bench_const_params.ts",
    "snapshots": "deno test --allow-read --allow-write tests/wat_snapshot_test.ts",
    "smoke": "deno run --allow-read --allow-write src/cli.ts run examples/hello.shovel",
    "helix": "deno run --allow-read --allow-write --allow-run scripts/build_helix_parser.ts && env XDG_CONFIG_HOME=$PWD/helix/config HELIX_RUNTIME=$PWD/helix/runtime hx --health shovel"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2
  }
}
