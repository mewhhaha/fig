{
  "keywords": [
    "_",
    "const",
    "do",
    "else",
    "enum",
    "f32",
    "f64",
    "false",
    "fn",
    "i32",
    "i64",
    "if",
    "import",
    "infix",
    "infixl",
    "infixr",
    "let",
    "match",
    "pub",
    "struct",
    "true",
    "type",
    "u32",
    "u64",
    "union"
  ],
  "symbols": [
    "@external",
    "@profile",
    "@assert",
    "@trace",
    "...",
    "->",
    "::",
    "..",
    "{}",
    "@[",
    "<-",
    "=>",
    "-",
    ",",
    ";",
    ":",
    ".",
    "(",
    ")",
    "[",
    "]",
    "{",
    "}",
    "@",
    "\\",
    "=",
    "|"
  ],
  "tokens": [
    {
      "name": "CountRepeat",
      "pattern": "[0-9]+\\*"
    },
    {
      "name": "CollectionOpen",
      "pattern": "#\\["
    },
    {
      "name": "Number",
      "pattern": "[0-9]+(\\.[0-9]+)?(i32|u32|i64|u64|f32|f64)?"
    },
    {
      "name": "Char",
      "pattern": "'([^'\\\\]|\\\\.)'"
    },
    {
      "name": "String",
      "pattern": "\"([^\"\\\\]|\\\\.)*\""
    },
    {
      "name": "LiteralType",
      "pattern": "#([a-z_][a-z0-9_]*|[A-Z][A-Za-z0-9]*)"
    },
    {
      "name": "OperatorSymbol",
      "pattern": "[+\\-*\\/%<>=!&|^$]+"
    },
    {
      "name": "LowerIdentRepeat",
      "pattern": "[a-z_][a-z0-9_]*\\*"
    },
    {
      "name": "PascalIdentRepeat",
      "pattern": "[A-Z][A-Za-z0-9]*\\*"
    },
    {
      "name": "TypeRepeatPrefix",
      "pattern": "([a-z_][a-z0-9_]*|[A-Z][A-Za-z0-9]*|[0-9]+)\\*(\\s*[0-9]+\\*)*"
    },
    {
      "name": "LowerIdent",
      "pattern": "[a-z_][a-z0-9_]*"
    },
    {
      "name": "PascalIdent",
      "pattern": "[A-Z][A-Za-z0-9]*"
    }
  ],
  "skips": [
    {
      "name": "Whitespace",
      "pattern": "[ \\t\\r\\n]+"
    },
    {
      "name": "Comment",
      "pattern": "\\/\\/[^\\n]*"
    }
  ]
}
