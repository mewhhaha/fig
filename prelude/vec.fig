const core = @import("prelude.core");
const layout = @import("prelude.layout");
const option = @import("prelude.option");
const operators = @import("prelude.operators");

type fn Vec(a: type) -> type {
  layout.HeapArray(a)
}

type fn Builder(a: type) -> type {
  Vec(a)
}

type fn Slice(a: type) -> type {
  let Slice = {
    source: Vec(a),
    start: i32,
    len: i32,
  };
  struct(Slice)
}

fn Vec::new(const a: type, capacity: i32) -> Vec(a) {
  layout.HeapArray::new(a, capacity)
}

fn Vec::empty() -> Vec(a) {
  layout.HeapArray::empty(a)
}

fn Vec::len(xs: Vec(a)) -> i32 {
  xs.len
}

fn Vec::capacity(xs: Vec(a)) -> i32 {
  xs.cap
}

fn Vec::get(xs: Vec(a), index: i32) -> a {
  Vec::get_t(a, xs, index)
}

fn Vec::get_t(const a: type, xs: Vec(a), index: i32) -> a {
  layout.HeapArray::get(a, xs, index)
}

fn Vec::set(
  xs: Vec(a),
  index: i32,
  value: a
) -> Vec(a) {
  layout.HeapArray::set(a, xs, index, value)
}

fn Vec::push(xs: Vec(a), value: a) -> Vec(a) {
  layout.HeapArray::push(a, xs, value)
}

fn Vec::is_empty(xs: Vec(a)) -> bool {
  Vec::len(xs) == 0
}

fn Vec::pure(value: a) -> Vec(a) {
  Vec::push(Vec::new(a, 1), value)
}

fn Vec::append(xs: Vec(a), ys: Vec(a)) -> Vec(a) {
  Vec::append_loop(xs, ys, 0)
}

fn Vec::choose(xs: Vec(a), ys: Vec(a)) -> Vec(a) {
  Vec::append(xs, ys)
}

fn Vec::append_loop(
  out: Vec(a),
  ys: Vec(a),
  index: i32
) -> Vec(a) {
  match index < Vec::len(ys) {
    true => Vec::append_loop(
      Vec::push(out, Vec::get_t(a, ys, index)),
      ys,
      index + 1
    ),
    false => out,
  }
}

fn Vec::fold_map(
  const f: fn(x: a) -> m,
  xs: Vec(a)
) -> m {
  @assert(core.Monoid(m));
  let empty_value: m = m::empty();
  Vec::fold_map_loop(f, xs, 0, empty_value)
}

fn Vec::fold_map_loop(
  const f: fn(x: a) -> m,
  xs: Vec(a),
  index: i32,
  acc: m
) -> m {
  @assert(core.Semigroup(m));
  match index < Vec::len(xs) {
    true => m::append(acc, f(Vec::get_t(a, xs, index)))
      \next -> Vec::fold_map_loop(f, xs, index + 1, next),
    false => acc,
  }
}

fn Vec::map(
  const f: fn(x: a) -> b,
  xs: Vec(a)
) -> Vec(b) {
  Vec::map_loop(
    xs,
    f,
    0,
    Vec::new(b, Vec::len(xs))
  )
}

fn Vec::map_loop(
  xs: Vec(a),
  const f: fn(x: a) -> b,
  index: i32,
  out: Vec(b)
) -> Vec(b) {
  match index < Vec::len(xs) {
    true => Vec::map_loop(
      xs,
      f,
      index + 1,
      Vec::push(out, f(Vec::get_t(a, xs, index)))
    ),
    false => out,
  }
}

fn Vec::apply(fns: Vec(fn(x: a) -> b), xs: Vec(a)) -> Vec(b) {
  Vec::apply_loop(fns, xs, 0, Vec::new(b, Vec::len(fns) * Vec::len(xs)))
}

fn Vec::apply_loop(
  fns: Vec(fn(x: a) -> b),
  xs: Vec(a),
  index: i32,
  out: Vec(b)
) -> Vec(b) {
  match index < Vec::len(fns) {
    true => Vec::apply_loop(
      fns,
      xs,
      index + 1,
      Vec::apply_one(Vec::get_t(core.UnaryFn(a, b), fns, index), xs, 0, out)
    ),
    false => out,
  }
}

fn Vec::apply_one(
  f: fn(x: a) -> b,
  xs: Vec(a),
  index: i32,
  out: Vec(b)
) -> Vec(b) {
  match index < Vec::len(xs) {
    true => Vec::apply_one(
      f,
      xs,
      index + 1,
      Vec::push(out, f(Vec::get_t(a, xs, index)))
    ),
    false => out,
  }
}

fn Vec::bind(xs: Vec(a), const f: fn(x: a) -> Vec(b)) -> Vec(b) {
  Vec::bind_loop(xs, f, 0, Vec::new(b, 0))
}

fn Vec::bind_loop(
  xs: Vec(a),
  const f: fn(x: a) -> Vec(b),
  index: i32,
  out: Vec(b)
) -> Vec(b) {
  match index < Vec::len(xs) {
    true => Vec::get_t(a, xs, index)
      \value -> f(value)
      \next -> Vec::append(out, next)
      \appended -> Vec::bind_loop(xs, f, index + 1, appended),
    false => out,
  }
}

fn Vec::filter(
  xs: Vec(a),
  const pred: fn(x: a) -> bool
) -> Vec(a) {
  Vec::filter_loop(xs, pred, 0, Vec::new(a, 0))
}

fn Vec::filter_loop(
  xs: Vec(a),
  const pred: fn(x: a) -> bool,
  index: i32,
  out: Vec(a)
) -> Vec(a) {
  match index < Vec::len(xs) {
    true => Vec::get_t(a, xs, index)
      \value -> match pred(value) {
      true => Vec::filter_loop(
        xs,
        pred,
        index + 1,
        Vec::push(out, value)
      ),
      false => Vec::filter_loop(
        xs,
        pred,
        index + 1,
        out
      ),
    },
    false => out,
  }
}

fn Vec::fold(
  xs: Vec(a),
  acc: b,
  const f: fn(acc: b, x: a) -> b
) -> b {
  Vec::fold_loop(xs, acc, f, 0)
}

fn Vec::fold_loop(
  xs: Vec(a),
  acc: b,
  const f: fn(acc: b, x: a) -> b,
  index: i32
) -> b {
  match index < Vec::len(xs) {
    true => Vec::fold_loop(
      xs,
      f(acc, Vec::get_t(a, xs, index)),
      f,
      index + 1
    ),
    false => acc,
  }
}

fn Vec::find(
  xs: Vec(a),
  const pred: fn(x: a) -> bool
) -> core.Option(a) {
  Vec::find_loop(xs, pred, 0)
}

fn Vec::find_loop(
  xs: Vec(a),
  const pred: fn(x: a) -> bool,
  index: i32
) -> core.Option(a) {
  match index < Vec::len(xs) {
    true => Vec::get_t(a, xs, index)
      \value -> match pred(value) {
      true => option.some(value),
      false => Vec::find_loop(xs, pred, index + 1),
    },
    false => None,
  }
}

fn Vec::any(
  xs: Vec(a),
  const pred: fn(x: a) -> bool
) -> bool {
  match Vec::find(xs, pred) {
    Some => true,
    None => false
  }
}

fn Vec::all(
  xs: Vec(a),
  const pred: fn(x: a) -> bool
) -> bool {
  Vec::all_loop(xs, pred, 0)
}

fn Vec::all_loop(
  xs: Vec(a),
  const pred: fn(x: a) -> bool,
  index: i32
) -> bool {
  match index < Vec::len(xs) {
    true => match pred(Vec::get_t(a, xs, index)) {
      true => Vec::all_loop(xs, pred, index + 1),
      false => false,
    },
    false => true,
  }
}

fn Builder::start(const a: type, capacity: i32) -> Builder(a) {
  Vec::new(a, capacity)
}

fn Builder::push(
  builder: Builder(a),
  value: a
) -> Builder(a) {
  Vec::push(builder, value)
}

fn Builder::finish(builder: Builder(a)) -> Vec(a) {
  builder
}

fn Slice::from_vec(xs: Vec(a)) -> Slice(a) {
  Slice {source: xs, start: 0, len: Vec::len(xs)}
}

fn Slice::range(
  xs: Vec(a),
  start: i32,
  len: i32
) -> Slice(a) {
  Slice {source: xs, start, len}
}

fn Slice::len(xs: Slice(a)) -> i32 {
  xs.len
}

fn Slice::empty() -> Slice(a) {
  Slice::from_vec(Vec::new(a, 0))
}

fn Slice::get(xs: Slice(a), index: i32) -> a {
  Vec::get_t(a, xs.source, xs.start + index)
}

fn Slice::fold(
  xs: Slice(a),
  acc: b,
  const f: fn(acc: b, x: a) -> b
) -> b {
  Slice::fold_loop(xs, acc, f, 0)
}

fn Slice::fold_loop(
  xs: Slice(a),
  acc: b,
  const f: fn(acc: b, x: a) -> b,
  index: i32
) -> b {
  match index < xs.len {
    true => Slice::fold_loop(
      xs,
      f(acc, Slice::get(xs, index)),
      f,
      index + 1
    ),
    false => acc,
  }
}

fn Slice::to_vec(xs: Slice(a)) -> Vec(a) {
  Slice::to_vec_loop(xs, 0, Vec::new(a, Slice::len(xs)))
}

fn Slice::to_vec_loop(
  xs: Slice(a),
  index: i32,
  out: Vec(a)
) -> Vec(a) {
  match index < Slice::len(xs) {
    true => Slice::to_vec_loop(
      xs,
      index + 1,
      Vec::push(out, Slice::get(xs, index))
    ),
    false => out,
  }
}

fn Slice::pure(value: a) -> Slice(a) {
  Slice::from_vec(Vec::pure(value))
}

fn Slice::append(xs: Slice(a), ys: Slice(a)) -> Slice(a) {
  Slice::from_vec(
    Vec::append(Slice::to_vec(xs), Slice::to_vec(ys))
  )
}

fn Slice::map(
  const f: fn(x: a) -> b,
  xs: Slice(a)
) -> Slice(b) {
  Slice::from_vec(Vec::map(f, Slice::to_vec(xs)))
}

fn Slice::apply(fns: Slice(fn(x: a) -> b), xs: Slice(a)) -> Slice(b) {
  Slice::from_vec(
    Vec::apply(Slice::to_vec(fns), Slice::to_vec(xs))
  )
}

fn Slice::bind(xs: Slice(a), const f: fn(x: a) -> Slice(b)) -> Slice(b) {
  Slice::from_vec(Slice::bind_loop(xs, f, 0, Vec::new(b, 0)))
}

fn Slice::bind_loop(
  xs: Slice(a),
  const f: fn(x: a) -> Slice(b),
  index: i32,
  out: Vec(b)
) -> Vec(b) {
  match index < Slice::len(xs) {
    true => Slice::get(xs, index)
      \value -> f(value)
      \next -> Slice::to_vec(next)
      \next_vec -> Vec::append(out, next_vec)
      \appended -> Slice::bind_loop(xs, f, index + 1, appended),
    false => out,
  }
}
