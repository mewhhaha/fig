const core = @import("prelude.core");
const layout = @import("prelude.layout");
const option = @import("prelude.option");

type fn ListNode(a: type) -> type {
  let ListNode = {
    value: a,
    next: i32,
  };
  struct(ListNode)
}

type fn List(a: type) -> type {
  let List = {
    nodes: layout.HeapArray(ListNode(a)),
    head: i32,
    len: i32,
  };
  struct(List)
}

fn List::empty() -> List(a) {
  List {nodes: layout.HeapArray::empty(ListNode(a)), head:
    - 1, len: 0}
}

fn List::singleton(value: a) -> List(a) {
  List::cons(value, List::empty())
}

fn List::pure(value: a) -> List(a) {
  List::singleton(value)
}

fn List::cons(value: a, xs: List(a)) -> List(a) {
  let index = layout.HeapArray::len(
    ListNode(a),
    xs.nodes
  );
  List {
    nodes: layout.HeapArray::push(
      ListNode(a),
      xs.nodes,
      ListNode {value, next: xs.head}
    ),
    head: index,
    len: xs.len + 1,
  }
}

fn List::is_empty(xs: List(a)) -> bool {
  xs.len == 0
}

fn List::len(xs: List(a)) -> i32 {
  xs.len
}

fn List::head(xs: List(a)) -> core.Option(a) {
  match xs.head < 0 {
    true => None,
    false => option.some(layout.HeapArray::get(
      ListNode(a),
      xs.nodes,
      xs.head
    ).value),
  }
}

fn List::tail(xs: List(a)) -> List(a) {
  match xs.head < 0 {
    true => xs,
    false => layout.HeapArray::get(
      ListNode(a),
      xs.nodes,
      xs.head
    )
      \node -> List {
      nodes: xs.nodes,
      head: node.next,
      len: xs.len - 1,
    },
  }
}

fn List::fold(
  xs: List(a),
  acc: b,
  const f: fn(acc: b, x: a) -> b
) -> b {
  List::fold_loop(xs.nodes, xs.head, acc, f)
}

fn List::fold_loop(
  nodes: layout.HeapArray(ListNode(a)),
  index: i32,
  acc: b,
  const f: fn(acc: b, x: a) -> b
) -> b {
  match index < 0 {
    true => acc,
    false => layout.HeapArray::get(
      ListNode(a),
      nodes,
      index
    )
      \node -> List::fold_loop(
      nodes,
      node.next,
      f(acc, node.value),
      f
    ),
  }
}

fn List::reverse(xs: List(a)) -> List(a) {
  List::fold(
    xs,
    List::empty(),
    List::reverse_step
  )
}

fn List::reverse_step(acc: List(a), value: a) -> List(a) {
  List::cons(value, acc)
}

fn List::append(xs: List(a), ys: List(a)) -> List(a) {
  List::append_reversed(List::reverse(xs), ys)
}

fn List::append_reversed(
  xs: List(a),
  out: List(a)
) -> List(a) {
  match List::head(xs) {
    Some(value) => List::append_reversed(
      List::tail(xs),
      List::cons(value, out)
    ),
    None => out,
  }
}

fn List::map(
  const f: fn(x: a) -> b,
  xs: List(a)
) -> List(b) {
  List::reverse(
    List::map_loop(
      xs.nodes,
      xs.head,
      List::empty(),
      f
    )
  )
}

fn List::map_loop(
  nodes: layout.HeapArray(ListNode(a)),
  index: i32,
  out: List(b),
  const f: fn(x: a) -> b
) -> List(b) {
  match index < 0 {
    true => out,
    false => layout.HeapArray::get(
      ListNode(a),
      nodes,
      index
    )
      \node -> List::map_loop(
      nodes,
      node.next,
      List::cons(f(node.value), out),
      f
    ),
  }
}

fn List::apply(fns: List(fn(x: a) -> b), xs: List(a)) -> List(b) {
  List::apply_loop(fns, xs, List::empty())
}

fn List::apply_loop(
  fns: List(fn(x: a) -> b),
  xs: List(a),
  out: List(b)
) -> List(b) {
  match List::head(fns) {
    Some(f) => List::apply_loop(
      List::tail(fns),
      xs,
      List::append(out, List::apply_one(f, xs))
    ),
    None => out,
  }
}

fn List::apply_one(f: fn(x: a) -> b, xs: List(a)) -> List(b) {
  List::reverse(List::apply_one_loop(f, xs, List::empty()))
}

fn List::apply_one_loop(
  f: fn(x: a) -> b,
  xs: List(a),
  out: List(b)
) -> List(b) {
  match List::head(xs) {
    Some(value) => List::apply_one_loop(
      f,
      List::tail(xs),
      List::cons(f(value), out)
    ),
    None => out,
  }
}

fn List::bind(xs: List(a), const f: fn(x: a) -> List(b)) -> List(b) {
  List::bind_loop(xs, f, List::empty())
}

fn List::bind_loop(
  xs: List(a),
  const f: fn(x: a) -> List(b),
  out: List(b)
) -> List(b) {
  match List::head(xs) {
    Some(value) => List::bind_loop(
      List::tail(xs),
      f,
      List::append(out, f(value))
    ),
    None => out,
  }
}
