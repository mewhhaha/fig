const core = @import("prelude.core");
const list = @import("prelude.list");
const option = @import("prelude.option");
const tree = @import("prelude.tree");
const operators = @import("prelude.operators");

type fn Crumb() -> type {
  let Crumb = {
    parent: i32,
    from_left: bool,
  };
  struct(Crumb)
}

type fn TreeZipper(a: type) -> type {
  let TreeZipper = {
    tree: tree.Tree(a),
    focus: i32,
    crumbs: list.List(Crumb),
  };
  struct(TreeZipper)
}

fn TreeZipper::from_tree(
  value: tree.Tree(a)
) -> TreeZipper(a) {
  let crumbs: list.List(Crumb) = list.List::empty();
  TreeZipper {tree: value, focus: value.root, crumbs}
}

fn TreeZipper::map(
  const f: fn(x: a) -> b,
  zipper: TreeZipper(a)
) -> TreeZipper(b) {
  TreeZipper {
    tree: tree.Tree::map(f, zipper.tree),
    focus: zipper.focus,
    crumbs: zipper.crumbs,
  }
}

fn TreeZipper::value(
  const a: type,
  zipper: TreeZipper(a)
) -> core.Option(a) {
  match tree.Tree::node_at(
    a,
    zipper.tree,
    zipper.focus
  ) {
    Some(node) => option.some(node.value),
    None => None,
  }
}

fn TreeZipper::go_left(
  zipper: TreeZipper(a)
) -> core.Option(TreeZipper(a)) {
  match tree.Tree::node_at(
    a,
    zipper.tree,
    zipper.focus
  ) {
    Some(node) => match node.left < 0 {
      true => None,
      false => option.some(TreeZipper {
        tree: zipper.tree,
        focus: node.left,
        crumbs: list.List::cons(
          Crumb {parent: zipper.focus, from_left: true},
          zipper.crumbs
        ),
      }),
    },
    None => None,
  }
}

fn TreeZipper::go_right(
  zipper: TreeZipper(a)
) -> core.Option(TreeZipper(a)) {
  match tree.Tree::node_at(
    a,
    zipper.tree,
    zipper.focus
  ) {
    Some(node) => match node.right < 0 {
      true => None,
      false => option.some(TreeZipper {
        tree: zipper.tree,
        focus: node.right,
        crumbs: list.List::cons(
          Crumb {parent: zipper.focus, from_left: false},
          zipper.crumbs
        ),
      }),
    },
    None => None,
  }
}

fn TreeZipper::go_up(
  zipper: TreeZipper(a)
) -> core.Option(TreeZipper(a)) {
  match list.List::head(zipper.crumbs) {
    Some(crumb) => option.some(TreeZipper {
      tree: zipper.tree,
      focus: crumb.parent,
      crumbs: list.List::tail(zipper.crumbs),
    }),
    None => None,
  }
}
