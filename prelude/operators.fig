type fn OpAdd(t: type) -> type {
  let Expected = fn(a: t, b: t) -> t;
  @require(@type_has_member(t, #add), "operator + requires add");
  @require(@type_member_type(t, #add) == Expected, "operator + add has wrong type");
  t
}

fn op_add(a: t, b: t) -> t {
  @assert(OpAdd(t));
  t::add(a, b)
}

infixl 60 (+) = op_add;

type fn OpSub(t: type) -> type {
  let Expected = fn(a: t, b: t) -> t;
  @require(@type_has_member(t, #sub), "operator - requires sub");
  @require(@type_member_type(t, #sub) == Expected, "operator - sub has wrong type");
  t
}

fn op_sub(a: t, b: t) -> t {
  @assert(OpSub(t));
  t::sub(a, b)
}

infixl 60 (-) = op_sub;

