type fn OpAdd(t: type) -> type {
  let Expected = fn(a: t, b: t) -> t;
  @require(@type_has_member(t, #add), "operator + requires add");
  @require(@type_member_type(t, #add) == Expected, "operator + add has wrong type");
  t
}

fn op_add(a: t, b: t, const _proof: OpAdd(t)) -> t {
  t::add(a, b)
}

const (+) = @operator(#infixl, 60, op_add);

type fn OpSub(t: type) -> type {
  let Expected = fn(a: t, b: t) -> t;
  @require(@type_has_member(t, #sub), "operator - requires sub");
  @require(@type_member_type(t, #sub) == Expected, "operator - sub has wrong type");
  t
}

fn op_sub(a: t, b: t, const _proof: OpSub(t)) -> t {
  t::sub(a, b)
}

const (-) = @operator(#infixl, 60, op_sub);

type fn OpMul(t: type) -> type {
  let Expected = fn(a: t, b: t) -> t;
  @require(@type_has_member(t, #mul), "operator * requires mul");
  @require(@type_member_type(t, #mul) == Expected, "operator * mul has wrong type");
  t
}

fn op_mul(a: t, b: t, const _proof: OpMul(t)) -> t {
  t::mul(a, b)
}

const (*) = @operator(#infixl, 70, op_mul);

type fn OpDiv(t: type) -> type {
  let Expected = fn(a: t, b: t) -> t;
  @require(@type_has_member(t, #div), "operator / requires div");
  @require(@type_member_type(t, #div) == Expected, "operator / div has wrong type");
  t
}

fn op_div(a: t, b: t, const _proof: OpDiv(t)) -> t {
  t::div(a, b)
}

const (/) = @operator(#infixl, 70, op_div);

type fn OpRem(t: type) -> type {
  let Expected = fn(a: t, b: t) -> t;
  @require(@type_has_member(t, #rem), "operator % requires rem");
  @require(@type_member_type(t, #rem) == Expected, "operator % rem has wrong type");
  t
}

fn op_rem(a: t, b: t, const _proof: OpRem(t)) -> t {
  t::rem(a, b)
