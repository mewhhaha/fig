type fn OpAppend(t: type) -> type {
  let Expected = fn(a: t, b: t) -> t;
  @require(@type_has_member(t, #append), "operator <> requires append");
  @require(@type_member_type(t, #append) == Expected, "operator <> append has wrong type");
  t
}

fn op_append(a: t, b: t) -> t {
  @assert(OpAppend(t));
  t::append(a, b)
}

infixr 55 (<>) = op_append;

type fn OpChoice(t: type fn(a: type) -> type) -> type {
  let Expected = fn(left: t(a), right: t(a)) -> t(a);
  @require(@type_has_member(t, #choose), "operator <|> requires choose");
  @require(@type_member_type(t, #choose) == Expected, "operator <|> choose has wrong type");
  t
}

fn op_choice(left: t(a), right: t(a)) -> t(a) {
  @assert(OpChoice(t));
  t::choose(left, right)
}

infixr 15 (<|>) = op_choice;

type fn OpApply(t: type fn(a: type) -> type) -> type {
  let Expected = fn(v: t(fn(x: a) -> b), x: t(a)) -> t(b);
  @require(@type_has_member(t, #apply), "operator <*> requires apply");
  @require(@type_member_type(t, #apply) == Expected, "operator <*> apply has wrong type");
  t
}

fn op_apply(
  v: t(fn(x: a) -> b),
  x: t(a)
) -> t(b) {
  @assert(OpApply(t));
  t::apply(v, x)
}

infixl 65 (<*>) = op_apply;

fn op_apply_flipped(
  x: t(a),
  v: t(fn(x: a) -> b)
) -> t(b) {
  @assert(OpApply(t));
  t::apply(v, x)
}

infixl 65 (<**>) = op_apply_flipped;

type fn OpThenRight(t: type fn(a: type) -> type) -> type {
  let Expected = fn(left: t(a), right: t(b)) -> t(b);
  @require(@type_has_member(t, #then_right), "operator *> requires then_right");
  @require(@type_member_type(t, #then_right) == Expected, "operator *> then_right has wrong type");
  t
}

fn op_then_right(left: t(a), right: t(b)) -> t(b) {
  @assert(OpThenRight(t));
  t::then_right(left, right)
}

infixl 65 (*>) = op_then_right;

type fn OpThenLeft(t: type fn(a: type) -> type) -> type {
  let Expected = fn(left: t(a), right: t(b)) -> t(a);
  @require(@type_has_member(t, #then_left), "operator <* requires then_left");
  @require(@type_member_type(t, #then_left) == Expected, "operator <* then_left has wrong type");
  t
}

fn op_then_left(left: t(a), right: t(b)) -> t(a) {
  @assert(OpThenLeft(t));
  t::then_left(left, right)
}

infixl 65 (<*) = op_then_left;

type fn OpMap(t: type fn(a: type) -> type) -> type {
  let Expected = fn(const f: fn(x: a) -> b, v: t(a)) -> t(b);
  @require(@type_has_member(t, #map), "operator <$> requires map");
  @require(@type_member_type(t, #map) == Expected, "operator <$> map has wrong type");
  t
}

fn op_map(
  const f: fn(x: a) -> b,
  v: t(a)
) -> t(b) {
  @assert(OpMap(t));
  t::map(f, v)
}

infixl 65 (<$>) = op_map;

fn op_map_flipped(
  v: t(a),
  const f: fn(x: a) -> b
) -> t(b) {
  @assert(OpMap(t));
  t::map(f, v)
}

infixl 65 (<&>) = op_map_flipped;

type fn OpBind(t: type fn(a: type) -> type) -> type {
  let Expected = fn(v: t(a), const f: fn(x: a) -> t(b)) -> t(b);
  @require(@type_has_member(t, #bind), "operator >>= requires bind");
  @require(@type_member_type(t, #bind) == Expected, "operator >>= bind has wrong type");
  t
}

fn op_bind(
  v: t(a),
  const f: fn(x: a) -> t(b)
) -> t(b) {
  @assert(OpBind(t));
  t::bind(v, f)
}

infixl 10 (>>=) = op_bind;

fn op_bind_flipped(
  const f: fn(x: a) -> t(b),
  v: t(a)
) -> t(b) {
  @assert(OpBind(t));
  t::bind(v, f)
}

infixr 10 (=<<) = op_bind_flipped;

fn op_kleisli_forward(
  const f: fn(x: a) -> t(b),
  const g: fn(x: b) -> t(c)
) -> fn(x: a) -> t(c) {
  @assert(OpBind(t));
  \x -> t::bind(f(x), g)
}

infixr 10 (>=>) = op_kleisli_forward;

fn op_kleisli_reverse(
  const g: fn(x: b) -> t(c),
  const f: fn(x: a) -> t(b)
) -> fn(x: a) -> t(c) {
  @assert(OpBind(t));
  \x -> t::bind(f(x), g)
}

infixr 10 (<=<) = op_kleisli_reverse;
