type fn OpAdd(t: type) -> operator {
  operator(#infixl, 60, "+", t.add)
}

type fn OpSub(t: type) -> operator {
  operator(#infixl, 60, "-", t.sub)
}

type fn OpMul(t: type) -> operator {
  operator(#infixl, 70, "*", t.mul)
}

type fn OpDiv(t: type) -> operator {
  operator(#infixl, 70, "/", t.div)
}

type fn OpRem(t: type) -> operator {
  operator(#infixl, 70, "%", t.rem)
}

type fn OpEql(t: type) -> operator {
  operator(#infix, 40, "==", t.eql)
}

type fn OpNeq(t: type) -> operator {
  operator(#infix, 40, "!=", t.neq)
}

type fn OpLt(t: type) -> operator {
  operator(#infix, 50, "<", t.lt)
}

type fn OpLte(t: type) -> operator {
  operator(#infix, 50, "<=", t.lte)
}

type fn OpGt(t: type) -> operator {
  operator(#infix, 50, ">", t.gt)
}

type fn OpGte(t: type) -> operator {
  operator(#infix, 50, ">=", t.gte)
}

fn bool_and(a: bool, b: bool) -> bool {
  match a { true => b, false => false }
}

fn bool_or(a: bool, b: bool) -> bool {
  match a { true => true, false => b }
}

fn bool_xor(a: bool, b: bool) -> bool {
  match a {
    true => match b { true => false, false => true },
    false => b,
  }
}

fn bool_eq(a: bool, b: bool) -> bool {
  match a { true => b, false => match b { true => false, false => true } }
}

fn bool_neq(a: bool, b: bool) -> bool {
  bool_xor(a, b)
}

type fn OpBoolAnd() -> operator {
  operator(#infixr, 30, "&&", bool_and)
}

type fn OpBoolOr() -> operator {
  operator(#infixr, 20, "||", bool_or)
}

type fn OpBoolXor() -> operator {
  operator(#infixr, 25, "^^", bool_xor)
}

type fn OpBoolEq() -> operator {
  operator(#infix, 40, "==", bool_eq)
}

type fn OpBoolNeq() -> operator {
  operator(#infix, 40, "!=", bool_neq)
}

type fn OpAppend(t: type) -> operator {
  operator(#infixr, 55, "<>", t.append)
}

type fn OpApply(t: type) -> operator {
  operator(#infixl, 65, "<*>", t.apply)
}

type fn OpMap(t: type) -> operator {
  operator(#infixl, 65, "<$>", t.map)
}

type fn OpBind(t: type) -> operator {
  operator(#infixl, 10, ">>=", t.bind)
}
