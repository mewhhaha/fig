const core = @import("prelude.core");

// Static inline layouts. These are value layouts today, not memory-backed arrays.

type fn InlineArray(n: count, a: type) {
  let InlineArray = {n*a};
  struct(InlineArray)
}

type fn InlineArrayList(n: count, a: type) {
  let InlineArrayList = {n*a};
  struct(InlineArrayList)
}

type fn HeapArray(a: type) -> type {
  let HeapArray = {
    ptr: i32,
    len: i32,
    cap: i32
  };
  struct(HeapArray)
}

type fn Collector(target: type, item: type, builder: type) {
  let Start = fn() -> builder;
  let Push = fn(builder: builder, item: item) -> builder;
  let Finish = fn(builder: builder) -> target;
  @require(@type_has_member(target, #collect_start), "collector requires collect_start");
  @require(@type_has_member(target, #collect_push), "collector requires collect_push");
  @require(@type_has_member(target, #collect_finish), "collector requires collect_finish");
  @require(@type_member_type(target, #collect_start) == Start, "collector collect_start has wrong type");
  @require(@type_member_type(target, #collect_push) == Push, "collector collect_push has wrong type");
  @require(@type_member_type(target, #collect_finish) == Finish, "collector collect_finish has wrong type");
}

fn InlineArrayList::nil(const a: type) -> InlineArrayList(0, a) {
  []
}

fn HeapArray::new(
  const a: type,
  initial_capacity: i32
) -> HeapArray(a) {
  @heap_array_new(a, initial_capacity)
}

fn HeapArray::empty(const a: type) -> HeapArray(a) {
  HeapArray::new(a, 0)
}

fn HeapArray::ensure_capacity(
  const a: type,
  xs: HeapArray(a),
  needed_capacity: i32
) -> HeapArray(a) {
  @heap_array_ensure_capacity(a, xs, needed_capacity)
}

fn HeapArray::get(
  const a: type,
  xs: HeapArray(a),
  index: i32
) -> a {
  @heap_array_get(a, xs, index)
}

fn HeapArray::set(
  const a: type,
  xs: HeapArray(a),
  index: i32,
  value: a
) -> HeapArray(a) {
  @heap_array_set(a, xs, index, value)
}

fn HeapArray::push(
  const a: type,
  xs: HeapArray(a),
  value: a
) -> HeapArray(a) {
  @heap_array_push(a, xs, value)
}

fn HeapArray::len(const a: type, xs: HeapArray(a)) -> i32 {
  xs.len
}

fn HeapArray::capacity(const a: type, xs: HeapArray(a)) -> i32 {
  xs.cap
}

fn InlineArray::from_list(const n: count, const a: type, xs: InlineArrayList(n, a)) -> InlineArray(n, a) {
  xs
}

type fn InlineArrayBuilder(n: count, a: type) -> type {
  let Builder = {n*a};
  struct(Builder)
}

fn InlineArrayBuilder::start(const n: count, const a: type) -> InlineArrayBuilder(n, a) {
  @inline_array_builder_start(n, a)
}

fn InlineArrayBuilder::push(
  const n: count,
  const a: type,
  builder: InlineArrayBuilder(n, a),
  i: core.Index(n),
  value: a
) -> InlineArrayBuilder(n, a) {
  @inline_array_builder_push(n, a, builder, i, value)
}

fn InlineArrayBuilder::finish(const n: count, const a: type, builder: InlineArrayBuilder(n, a)) -> InlineArray(n, a) {
  @inline_array_builder_finish(n, a, builder)
}

fn InlineArray::tabulate(const n: count, const a: type, const f: fn(i: core.Index(n)) -> a) -> InlineArray(n, a) {
  InlineArray::tabulate_loop(n, a, core.IndexCursor::start(n), InlineArrayBuilder::start(n, a), f)
}

fn InlineArray::tabulate_loop(
  const n: count,
  const a: type,
  cursor: core.IndexCursor(n),
  builder: InlineArrayBuilder(n, a),
  const f: fn(i: core.Index(n)) -> a
) -> InlineArray(n, a) {
  let builder_then = builder;
let builder_else = builder;
  match core.IndexCursor::next(n, cursor) {
    Yield(i, next) => InlineArray::tabulate_loop(n, a, next, InlineArrayBuilder::push(n, a, builder_then, i, f(i)), f),
    Done => InlineArrayBuilder::finish(n, a, builder_else),
  }
}

fn InlineArray::tabulate_with(
  const n: count,
  const a: type,
  const state: type,
  state_value: state,
  const f: fn(i: core.Index(n), state_value: state) -> a
) -> InlineArray(n, a) {
  InlineArray::tabulate_with_loop(n, a, state, core.IndexCursor::start(n), InlineArrayBuilder::start(n, a), state_value, f)
}

fn InlineArray::tabulate_with_loop(
  const n: count,
  const a: type,
  const state: type,
  cursor: core.IndexCursor(n),
  builder: InlineArrayBuilder(n, a),
  state_value: state,
  const f: fn(i: core.Index(n), state_value: state) -> a
) -> InlineArray(n, a) {
  let builder_then = builder;
let builder_else = builder;
  let state_then = state_value;
let state_else = state_value;
  let state_call = state_then;
let state_next = state_then;
  match core.IndexCursor::next(n, cursor) {
    Yield(i, next) => InlineArray::tabulate_with_loop(n, a, state, next, InlineArrayBuilder::push(n, a, builder_then, i, f(i, state_call)), state_next, f),
    Done => InlineArrayBuilder::finish(n, a, builder_else),
  }
}

fn InlineArray::fill(const n: count, const a: type, value: a) -> InlineArray(n, a) {
  InlineArray::fill_loop(n, a, core.IndexCursor::start(n), InlineArrayBuilder::start(n, a), value)
}

fn InlineArray::fill_loop(
  const n: count,
  const a: type,
  cursor: core.IndexCursor(n),
  builder: InlineArrayBuilder(n, a),
  value: a
) -> InlineArray(n, a) {
  let builder_then = builder;
let builder_else = builder;
  let value_then = value;
let value_else = value;
  let value_push = value_then;
let value_next = value_then;
  match core.IndexCursor::next(n, cursor) {
    Yield(i, next) => InlineArray::fill_loop(n, a, next, InlineArrayBuilder::push(n, a, builder_then, i, value_push), value_next),
    Done => InlineArrayBuilder::finish(n, a, builder_else),
  }
}

fn InlineArray::map(
  const n: count,
  const a: type,
  const b: type,
  xs: InlineArray(n, a),
  const f: fn(x: a) -> b
) -> InlineArray(n, b) {
  InlineArray::map_loop(n, a, b, core.IndexCursor::start(n), InlineArrayBuilder::start(n, b), xs, f)
}

fn InlineArray::map_loop(
  const n: count,
  const a: type,
  const b: type,
  cursor: core.IndexCursor(n),
  builder: InlineArrayBuilder(n, b),
  xs: InlineArray(n, a),
  const f: fn(x: a) -> b
) -> InlineArray(n, b) {
  let builder_then = builder;
let builder_else = builder;
  let xs_then = xs;
let xs_else = xs;
  let xs_current = xs_then;
let xs_next = xs_then;
  match core.IndexCursor::next(n, cursor) {
    Yield(i, next) => InlineArray::map_loop(n, a, b, next, InlineArrayBuilder::push(n, b, builder_then, i, f(xs_current[i])), xs_next, f),
    Done => InlineArrayBuilder::finish(n, b, builder_else),
  }
}

fn InlineArray::imap(
  const n: count,
  const a: type,
  const b: type,
  xs: InlineArray(n, a),
  const f: fn(i: core.Index(n), x: a) -> b
) -> InlineArray(n, b) {
  InlineArray::imap_loop(n, a, b, core.IndexCursor::start(n), InlineArrayBuilder::start(n, b), xs, f)
}

fn InlineArray::imap_loop(
  const n: count,
  const a: type,
  const b: type,
  cursor: core.IndexCursor(n),
  builder: InlineArrayBuilder(n, b),
  xs: InlineArray(n, a),
  const f: fn(i: core.Index(n), x: a) -> b
) -> InlineArray(n, b) {
  let builder_then = builder;
let builder_else = builder;
  let xs_then = xs;
let xs_else = xs;
  let xs_current = xs_then;
let xs_next = xs_then;
  match core.IndexCursor::next(n, cursor) {
    Yield(i, next) => InlineArray::imap_loop(n, a, b, next, InlineArrayBuilder::push(n, b, builder_then, i, f(i, xs_current[i])), xs_next, f),
    Done => InlineArrayBuilder::finish(n, b, builder_else),
  }
}

fn InlineArray::imap_with_state(
  const n: count,
  const a: type,
  const b: type,
  const state: type,
  xs: InlineArray(n, a),
  state_value: state,
  const f: fn(i: core.Index(n), x: a, state_value: state) -> b
) -> InlineArray(n, b) {
  InlineArray::imap_with_state_loop(n, a, b, state, core.IndexCursor::start(n), InlineArrayBuilder::start(n, b), xs, state_value, f)
}

fn InlineArray::imap_with_state_loop(
  const n: count,
  const a: type,
  const b: type,
  const state: type,
  cursor: core.IndexCursor(n),
  builder: InlineArrayBuilder(n, b),
  xs: InlineArray(n, a),
  state_value: state,
  const f: fn(i: core.Index(n), x: a, state_value: state) -> b
) -> InlineArray(n, b) {
  let builder_then = builder;
let builder_else = builder;
  let xs_then = xs;
let xs_else = xs;
  let state_then = state_value;
let state_else = state_value;
  let xs_current = xs_then;
let xs_next = xs_then;
  let state_call = state_then;
let state_next = state_then;
  match core.IndexCursor::next(n, cursor) {
    Yield(i, next) => InlineArray::imap_with_state_loop(n, a, b, state, next, InlineArrayBuilder::push(n, b, builder_then, i, f(i, xs_current[i], state_call)), xs_next, state_next, f),
    Done => InlineArrayBuilder::finish(n, b, builder_else),
  }
}

fn InlineArray::set(const n: count, const a: type, xs: InlineArray(n, a), index: core.Index(n), value: a) -> InlineArray(n, a) {
  [...xs, [index]: value]
}

fn InlineArray::update(
  const n: count,
  const a: type,
  xs: InlineArray(n, a),
  index: core.Index(n),
  const f: fn(x: a) -> a
) -> InlineArray(n, a) {
  let old = xs[index];
  [...xs, [index]: f(old)]
}

fn InlineArray::fold_indices(
  const n: count,
  const acc_type: type,
  cursor: core.IndexCursor(n),
  acc: acc_type,
  const f: fn(acc: acc_type, i: core.Index(n)) -> acc_type
) -> acc_type {
  let acc_then = acc;
let acc_else = acc;
  match core.IndexCursor::next(n, cursor) {
    Yield(i, next) => InlineArray::fold_indices(n, acc_type, next, f(acc_then, i), f),
    Done => acc_else,
  }
}

type fn Lane4I32() -> type {
  InlineArray(4, i32)
}

type fn Lane4Bool() -> type {
  InlineArray(4, bool)
}

type fn Lane4ScalarI32() -> type {
  InlineArray(4, core.ScalarI32)
}

type fn Tile2x4I32() -> type {
  InlineArray(2, Lane4I32)
}

type fn Tile4x4I32() -> type {
  InlineArray(4, Lane4I32)
}

type fn Mat4I32() -> type {
  Tile4x4I32
}

type fn ViewI328x2() {
  let ViewI32x8x2 = {base: InlineArray(8, i32), len: i32, stride: i32};
  struct(ViewI32x8x2)
}
