const core = @import("prelude.core");

fn ok(value: a) -> core.Result(a, e) {
  value
}

fn err(error: e) -> core.Result(a, e) {
  error
}

fn result_is_ok(value: core.Result(a, e)) -> bool {
  match value { Ok => true, Err => false }
}

fn result_is_err(value: core.Result(a, e)) -> bool {
  match value { Ok => false, Err => true }
}

fn result_unwrap_or(value: core.Result(a, e), fallback: a) -> a {
  match value { Ok(inner) => inner, Err => fallback }
}

fn result_map(value: core.Result(a, e), const f: fn(x: a) -> b) -> core.Result(b, e) {
  match value { Ok(inner) => ok(f(inner)), Err(error) => err(error) }
}

fn result_map_err(value: core.Result(a, e), const f: fn(x: e) -> f) -> core.Result(a, f) {
  match value { Ok(inner) => ok(inner), Err(error) => err(f(error)) }
}

fn result_and_then(value: core.Result(a, e), const f: fn(x: a) -> core.Result(b, e)) -> core.Result(b, e) {
  match value { Ok(inner) => f(inner), Err(error) => err(error) }
}
