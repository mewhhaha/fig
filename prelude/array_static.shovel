module prelude.array_static;

import module prelude.layout;

// Futhark-style SOAC names for fixed inline layouts. Work/span comments describe
// intent only; the current backend proves parsing, checking, specialization, and
// scalar direct calls after optimization.

fn map4_i32(const f: fn(x: i32) -> i32, xs: lane4_i32) -> lane4_i32 {
  [f(xs[0]), f(xs[1]), f(xs[2]), f(xs[3])]
}

fn zip_with4_i32(const f: fn(a: i32, b: i32) -> i32, xs: lane4_i32, ys: lane4_i32) -> lane4_i32 {
  [f(xs[0], ys[0]), f(xs[1], ys[1]), f(xs[2], ys[2]), f(xs[3], ys[3])]
}

fn fold4_i32(const f: fn(acc: i32, x: i32) -> i32, init: i32, xs: lane4_i32) -> i32 {
  f(f(f(f(init, xs[0]), xs[1]), xs[2]), xs[3])
}

fn reduce4_i32(const f: fn(a: i32, b: i32) -> i32, xs: lane4_i32) -> i32 {
  f(f(xs[0], xs[1]), f(xs[2], xs[3]))
}

fn map4_scalar_i32(const f: fn(x: scalar_i32) -> scalar_i32, x: scalar_i32) -> scalar_i32 {
  f(f(f(f(x))))
}

fn zip_with4_scalar_i32(
  const f: fn(a: scalar_i32, b: scalar_i32) -> scalar_i32,
  x: scalar_i32,
  y0: scalar_i32,
  y1: scalar_i32,
  y2: scalar_i32,
  y3: scalar_i32
) -> scalar_i32 {
  f(f(f(f(x, y0), y1), y2), y3)
}
