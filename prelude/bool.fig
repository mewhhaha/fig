fn bool_not(value: bool) -> bool {
  match value { true => false, false => true }
}

fn bool_and(a: bool, b: bool) -> bool {
  match a { true => b, false => false }
}

fn bool_or(a: bool, b: bool) -> bool {
  match a { true => true, false => b }
}

fn bool_xor(a: bool, b: bool) -> bool {
  match a {
    true => match b { true => false, false => true },
    false => b,
  }
}

fn select(cond: bool, when_true: a, when_false: a) -> a {
  match cond { true => when_true, false => when_false }
}
