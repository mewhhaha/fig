const fixed = @import("prelude.fixed");
const core = @import("prelude.core");
const layout = @import("prelude.layout");

// Builder fallback for fixed values when direct slot literals or spreads are
// not convenient. Fixed updates should prefer prelude.fixed.Array spread forms.

type fn ArrayBuilder(n: count, a: type) -> type {
  layout.InlineArrayBuilder(n, a)
}

fn ArrayBuilder.start(const n: count, const a: type) -> ArrayBuilder(n, a) {
  @inline_array_builder_start(n, a)
}

fn ArrayBuilder.push(
  const n: count,
  const a: type,
  builder: ArrayBuilder(n, a),
  i: core.Index(n),
  value: a
) -> ArrayBuilder(n, a) {
  @inline_array_builder_push(n, a, builder, i, value)
}

fn ArrayBuilder.finish(const n: count, const a: type, builder: ArrayBuilder(n, a)) -> fixed.Array(n, a) {
  @inline_array_builder_finish(n, a, builder)
}
