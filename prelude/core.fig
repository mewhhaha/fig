// Core contracts are ordinary Fig type functions. They are intentionally
// small so fragments can be concatenated or imported without compiler magic.

type fn Eq(t: type) {
  let Expected = fn(a: t, b: t) -> bool;
  @require(@type_has_member(t, #eql), "Eq requires eql");
  @require(@type_member_type(t, #eql) == Expected, "Eq.eql has wrong type");
}

type fn Semigroup(t: type) -> type {
  let Expected = fn(a: t, b: t) -> t;
  @require(@type_has_member(t, #append), "Semigroup requires append");
  @require(@type_member_type(t, #append) == Expected, "Semigroup.append has wrong type");
  t
}

type fn EmptyValue(t: type) -> type {
  let Empty = fn() -> t;
  @require(@type_has_member(t, #empty), "Empty requires empty");
  @require(@type_member_type(t, #empty) == Empty, "Empty.empty has wrong type");
  t
}

type fn Monoid(t: type) -> type {
  let Append = fn(a: t, b: t) -> t;
  @require(@type_has_member(t, #append), "Monoid requires append");
  @require(@type_member_type(t, #append) == Append, "Monoid.append has wrong type");
  EmptyValue(t)
}

fn append(const t, const _proof: Semigroup(t), a: t, b: t) -> t {
  t::append(a, b)
}

fn empty(const t: type) -> t {
  @empty(t)
}

type fn Copyable(t: type) -> type {
  t
}

type fn Option(a: type) -> union {
  let None = {};
  let Some = {value: a};
  union(None, Some)
}

type fn Result(a: type, e: type) -> union {
  let Ok = {value: a};
  let Err = {error: e};
  union(Ok, Err)
}

type fn Pair(a: type, b: type) -> type {
  let Pair = {first: a, second: b};
  struct(Pair)
}

type fn Tuple2(a: type, b: type) -> type {
  Pair(a, b)
}

type fn Tuple3(a: type, b: type, c: type) -> type {
  let Tuple3 = {first: a, second: b, third: c};
  struct(Tuple3)
}

type fn Index(n: count) -> type {
  i32(0..n)
}

fn i32::try_domain(const domain: type, x: i32) -> Option(domain) {
  x
}

fn Index::try(const n: count, x: i32) -> Option(Index(n)) {
  match 0 <= x {
    true => match x < n { true => x, false => 0 },
    false => 0,
  }
}

type fn IterStep(state: type, item: type) -> union {
  let Done = {};
  let Yield = {item: item, next: state};
  union(Done, Yield)
}

type fn Iterator(state: type, item: type) -> type {
  let Next = fn(state: state) -> IterStep(state, item);
  @require(@type_has_member(state, #next), "Iterator requires next");
  @require(@type_member_type(state, #next) == Next, "Iterator.next has wrong type");
  state
}

type fn IndexCursor(n: count) -> type {
  i32
}

fn IndexCursor::start(const n: count) -> IndexCursor(n) {
  0
}

fn IndexCursor::next(const n: count, cursor: IndexCursor(n)) -> IterStep(IndexCursor(n), Index(n)) {
  @index_cursor_next(n, cursor)
}

type fn Droppable(t: type) -> type {
  t
}

type fn ScalarI32() {
  let ScalarI32 = {value: i32};
  struct(ScalarI32)
}
