const operators = @import("prelude.operators");
fn identity(x: a) -> a {
  x
}

fn constant(value: a, _ignored: b) -> a {
  value
}

fn compose(
  const f: fn(x: b) -> c,
  const g: fn(x: a) -> b,
  value: a
) -> c {
  f(g(value))
}

fn pipe(value: a, const f: fn(x: a) -> b) -> b {
  f(value)
}

fn apply_to(value: a, const f: fn(x: a) -> b) -> b {
  f(value)
}

fn flip(const f: fn(a: a, b: b) -> c, b: b, a: a) -> c {
  f(a, b)
}

type fn Functor(t: type fn(a: type) -> type) -> type {
  let Expected = fn(const f: fn(x: a) -> b, v: t(a)) -> t(b);
  @require(
    @type_has_member(t, #map),
    "Functor requires map"
  );
  @require(
    @type_member_type(t, #map) == Expected,
    "Functor.map has wrong type"
  );
  t
}

fn fmap(
  v: t(a),
  const f: fn(x: a) -> b
) -> t(b) {
  @assert(Functor(t));
  t::map(f, v)
}

type fn Applicative(t: type fn(a: type) -> type) -> type {
  let Pure = fn(value: a) -> t(a);
  let Apply = fn(v: t(fn(x: a) -> b), x: t(a)) -> t(b);
  Functor(t);
  @require(
    @type_has_member(t, #pure),
    "Applicative requires pure"
  );
  @require(
    @type_has_member(t, #apply),
    "Applicative requires apply"
  );
  @require(
    @type_member_type(t, #pure) == Pure,
    "Applicative.pure has wrong type"
  );
  @require(
    @type_member_type(t, #apply) == Apply,
    "Applicative.apply has wrong type"
  );
  t
}

fn pure(
  value: a
) -> t(a) {
  @assert(Applicative(t));
  t::pure(value)
}

fn apply(
  v: t(fn(x: a) -> b),
  x: t(a)
) -> t(b) {
  @assert(Applicative(t));
  t::apply(v, x)
}

type fn Monad(t: type fn(a: type) -> type) -> type {
  let Bind = fn(v: t(a), const f: fn(x: a) -> t(b)) -> t(b);
  Applicative(t);
  @require(
    @type_has_member(t, #bind),
    "Monad requires bind"
  );
  @require(
    @type_member_type(t, #bind) == Bind,
    "Monad.bind has wrong type"
  );
  t
}

fn bind(
  v: t(a),
  const f: fn(x: a) -> t(b)
) -> t(b) {
  @assert(Monad(t));
  t::bind(v, f)
}
