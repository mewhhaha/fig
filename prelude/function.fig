fn identity(x: A) -> A {
  x
}

fn constant(value: A, _ignored: B) -> A {
  value
}

fn compose(const f: fn(x: B) -> C, const g: fn(x: A) -> B, value: A) -> C {
  f(g(value))
}

fn pipe(value: A, const f: fn(x: A) -> B) -> B {
  f(value)
}

fn apply_to(value: A, const f: fn(x: A) -> B) -> B {
  f(value)
}

fn flip(const f: fn(a: A, b: B) -> C, b: B, a: A) -> C {
  f(a, b)
}

type fn functor(T: type fn(A: type) -> type) -> type {
  let Expected = fn(const f: fn(x: A) -> B, v: T(A)) -> T(B);
  @require(@type_has_member(T, #map), "Functor requires map");
  @require(@type_member_type(T, #map) == Expected, "Functor.map has wrong type");
  T
}

fn fmap(v: T(A), const f: fn(x: A) -> B, const _proof: functor(T)) -> T(B) {
  T.map(f, v)
}

type fn applicative(T: type fn(A: type) -> type) -> type {
  let Map = fn(const f: fn(x: A) -> B, v: T(A)) -> T(B);
  let Pure = fn(value: A) -> T(A);
  let Apply = fn(v: T(fn(x: A) -> B), x: T(A)) -> T(B);
  @require(@type_has_member(T, #map), "Applicative requires map");
  @require(@type_member_type(T, #map) == Map, "Applicative.map has wrong type");
  @require(@type_has_member(T, #pure), "Applicative requires pure");
  @require(@type_has_member(T, #apply), "Applicative requires apply");
  @require(@type_member_type(T, #pure) == Pure, "Applicative.pure has wrong type");
  @require(@type_member_type(T, #apply) == Apply, "Applicative.apply has wrong type");
  T
}

fn pure(const T, value: A, const _proof: applicative(T)) -> T(A) {
  T.pure(value)
}

fn apply(v: T(fn(x: A) -> B), x: T(A), const _proof: applicative(T)) -> T(B) {
  T.apply(v, x)
}

type fn monad(T: type fn(A: type) -> type) -> type {
  let Map = fn(const f: fn(x: A) -> B, v: T(A)) -> T(B);
  let Bind = fn(v: T(A), const f: fn(x: A) -> T(B)) -> T(B);
  @require(@type_has_member(T, #map), "Monad requires map");
  @require(@type_member_type(T, #map) == Map, "Monad.map has wrong type");
  @require(@type_has_member(T, #bind), "Monad requires bind");
  @require(@type_member_type(T, #bind) == Bind, "Monad.bind has wrong type");
  T
}

fn bind(v: T(A), const f: fn(x: A) -> T(B), const _proof: monad(T)) -> T(B) {
  T.bind(v, f)
}
