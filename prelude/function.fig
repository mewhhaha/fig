fn identity(x: a) -> a {
  x
}

fn constant(value: a, _ignored: b) -> a {
  value
}

fn compose(
  const f: fn(x: b) -> c,
  const g: fn(x: a) -> b,
  value: a
) -> c {
  f(g(value))
}

fn pipe(value: a, const f: fn(x: a) -> b) -> b {
  f(value)
}

fn apply_to(value: a, const f: fn(x: a) -> b) -> b {
  f(value)
}

fn flip(const f: fn(a: a, b: b) -> c, b: b, a: a) -> c {
  f(a, b)
}

type fn Functor(t: type fn(a: type) -> type) -> type {
  let Expected = fn(const f: fn(x: a) -> b, v: t(a)) -> t(b);
  @require(
    @type_has_member(t, #map),
    "Functor requires map"
  );
  @require(
    @type_member_type(t, #map) == Expected,
    "Functor.map has wrong type"
  );
  t
}

contract fn Functor::map_identity(const T: type fn(a: type) -> type) -> rewrite {
  const proof = Functor(T);
  @assume(\x -> T::map(identity, x), \x -> x)
}

fn fmap(
  v: t(a),
  const f: fn(x: a) -> b,
  const _proof: Functor(t)
) -> t(b) {
  t::map(f, v)
}

type fn Applicative(t: type fn(a: type) -> type) -> type {
  let Pure = fn(value: a) -> t(a);
  let Apply = fn(v: t(fn(x: a) -> b), x: t(a)) -> t(b);
  Functor(t);
  @require(
    @type_has_member(t, #pure),
    "Applicative requires pure"
  );
  @require(
    @type_has_member(t, #apply),
    "Applicative requires apply"
  );
  @require(
    @type_member_type(t, #pure) == Pure,
    "Applicative.pure has wrong type"
  );
  @require(
    @type_member_type(t, #apply) == Apply,
    "Applicative.apply has wrong type"
  );
  t
}

contract fn Applicative::apply_pure_identity(
const T: type fn(a: type) -> type) -> rewrite {
  const proof = Applicative(T);
  @assume(
    \x -> T::apply(T::pure(identity), x),
    \x -> x
  )
}

contract fn Applicative::apply_pure(
const T: type fn(a: type) -> type) -> rewrite {
  const proof = Applicative(T);
  @assume(
    \(f, x) -> T::apply(T::pure(f), x),
    \(f, x) -> T::map(f, x)
  )
}

fn pure(
  const t,
  value: a,
  const _proof: Applicative(t)
) -> t(a) {
  t::pure(value)
}

fn apply(
  v: t(fn(x: a) -> b),
  x: t(a),
  const _proof: Applicative(t)
) -> t(b) {
  t::apply(v, x)
}

type fn Monad(t: type fn(a: type) -> type) -> type {
  let Bind = fn(v: t(a), const f: fn(x: a) -> t(b)) -> t(b);
  Applicative(t);
  @require(
    @type_has_member(t, #bind),
    "Monad requires bind"
  );
  @require(
    @type_member_type(t, #bind) == Bind,
    "Monad.bind has wrong type"
  );
  t
}

contract fn Monad::bind_pure_left(const T: type fn(a: type) -> type) -> rewrite {
  const proof = Monad(T);
  @assume(
    \(x, f) -> T::bind(T::pure(x), f),
    \(x, f) -> f(x)
  )
}

contract fn Monad::bind_pure_right(const T: type fn(a: type) -> type) -> rewrite {
  const proof = Monad(T);
  @assume(\m -> T::bind(m, T::pure), \m -> m)
}

fn bind(
  v: t(a),
  const f: fn(x: a) -> t(b),
  const _proof: Monad(t)
) -> t(b) {
  t::bind(v, f)
}
