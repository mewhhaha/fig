const layout = @import("prelude.layout");

// Futhark-style SOAC names for fixed inline layouts. Work/span comments describe
// intent only; the current backend proves parsing, checking, specialization, and
// scalar direct calls after optimization.

fn map4_i32(const f: fn(x: i32) -> i32, xs: layout.Lane4I32) -> layout.Lane4I32 {
  <f(xs[0]), f(xs[1]), f(xs[2]), f(xs[3])>
}

fn zip_with4_i32(const f: fn(a: i32, b: i32) -> i32, xs: layout.Lane4I32, ys: layout.Lane4I32) -> layout.Lane4I32 {
  <f(xs[0], ys[0]), f(xs[1], ys[1]), f(xs[2], ys[2]), f(xs[3], ys[3])>
}

fn fold4_i32(const f: fn(acc: i32, x: i32) -> i32, init: i32, xs: layout.Lane4I32) -> i32 {
  f(f(f(f(init, xs[0]), xs[1]), xs[2]), xs[3])
}

fn reduce4_i32(const f: fn(a: i32, b: i32) -> i32, xs: layout.Lane4I32) -> i32 {
  f(f(xs[0], xs[1]), f(xs[2], xs[3]))
}

fn lane4_add_i32(xs: layout.Lane4I32, ys: layout.Lane4I32) -> layout.Lane4I32 {
  <xs[0] + ys[0], xs[1] + ys[1], xs[2] + ys[2], xs[3] + ys[3]>
}

fn lane4_mul_i32(xs: layout.Lane4I32, ys: layout.Lane4I32) -> layout.Lane4I32 {
  <xs[0] * ys[0], xs[1] * ys[1], xs[2] * ys[2], xs[3] * ys[3]>
}

fn lane4_dot_i32(xs: layout.Lane4I32, ys: layout.Lane4I32) -> i32 {
  xs[0] * ys[0] + xs[1] * ys[1] + xs[2] * ys[2] + xs[3] * ys[3]
}

fn lane4_is_empty_i32(xs: layout.Lane4I32) -> bool {
  false
}

fn lane4_length_i32(xs: layout.Lane4I32) -> i32 {
  4
}

fn lane4_any_i32(xs: layout.Lane4I32, const pred: fn(x: i32) -> bool) -> bool {
  match pred(xs[0]) {
    true => true,
    false => match pred(xs[1]) {
      true => true,
      false => match pred(xs[2]) {
        true => true,
        false => pred(xs[3]),
      },
    },
  }
}

fn lane4_all_i32(xs: layout.Lane4I32, const pred: fn(x: i32) -> bool) -> bool {
  match pred(xs[0]) {
    true => match pred(xs[1]) {
      true => match pred(xs[2]) {
        true => pred(xs[3]),
        false => false,
      },
      false => false,
    },
    false => false,
  }
}

fn lane4_count_i32(xs: layout.Lane4I32, const pred: fn(x: i32) -> bool) -> i32 {
  let c0 = match pred(xs[0]) { true => 1, false => 0 };
  let c1 = match pred(xs[1]) { true => 1, false => 0 };
  let c2 = match pred(xs[2]) { true => 1, false => 0 };
  let c3 = match pred(xs[3]) { true => 1, false => 0 };
  c0 + c1 + c2 + c3
}

fn lane4_contains_i32(xs: layout.Lane4I32, value: i32) -> bool {
  match xs[0] == value {
    true => true,
    false => match xs[1] == value {
      true => true,
      false => match xs[2] == value {
        true => true,
        false => xs[3] == value,
      },
    },
  }
}

fn lane4_index_of_i32(xs: layout.Lane4I32, value: i32) -> layout.core.Option(i32) {
  match xs[0] == value {
    true => 0,
    false => match xs[1] == value {
      true => 1,
      false => match xs[2] == value {
        true => 2,
        false => match xs[3] == value { true => 3, false => 0 },
      },
    },
  }
}

fn lane4_sum_i32(xs: layout.Lane4I32) -> i32 {
  xs[0] + xs[1] + xs[2] + xs[3]
}

fn lane4_product_i32(xs: layout.Lane4I32) -> i32 {
  xs[0] * xs[1] * xs[2] * xs[3]
}

fn lane4_min_i32(xs: layout.Lane4I32) -> i32 {
  let min01 = match xs[0] < xs[1] { true => xs[0], false => xs[1] };
  let min23 = match xs[2] < xs[3] { true => xs[2], false => xs[3] };
  match min01 < min23 { true => min01, false => min23 }
}

fn lane4_max_i32(xs: layout.Lane4I32) -> i32 {
  let max01 = match xs[0] > xs[1] { true => xs[0], false => xs[1] };
  let max23 = match xs[2] > xs[3] { true => xs[2], false => xs[3] };
  match max01 > max23 { true => max01, false => max23 }
}

fn lane4_set_i32(xs: layout.Lane4I32, i: i32, value: i32) -> layout.Lane4I32 {
  match i {
    0 => <value, xs[1], xs[2], xs[3]>,
    1 => <xs[0], value, xs[2], xs[3]>,
    2 => <xs[0], xs[1], value, xs[3]>,
    3 => <xs[0], xs[1], xs[2], value>,
    _ => xs,
  }
}

fn lane4_update_i32(xs: layout.Lane4I32, i: i32, const f: fn(x: i32) -> i32) -> layout.Lane4I32 {
  match i {
    0 => <f(xs[0]), xs[1], xs[2], xs[3]>,
    1 => <xs[0], f(xs[1]), xs[2], xs[3]>,
    2 => <xs[0], xs[1], f(xs[2]), xs[3]>,
    3 => <xs[0], xs[1], xs[2], f(xs[3])>,
    _ => xs,
  }
}

fn lane4_replace_where_i32(
  xs: layout.Lane4I32,
  const pred: fn(x: i32) -> bool,
  value: i32
) -> layout.Lane4I32 {
  <
    match pred(xs[0]) { true => value, false => xs[0] },
    match pred(xs[1]) { true => value, false => xs[1] },
    match pred(xs[2]) { true => value, false => xs[2] },
    match pred(xs[3]) { true => value, false => xs[3] }
  >
}

fn lane4_take_i32(xs: layout.Lane4I32, n: i32) -> layout.Lane4I32 {
  <
    match n > 0 { true => xs[0], false => 0 },
    match n > 1 { true => xs[1], false => 0 },
    match n > 2 { true => xs[2], false => 0 },
    match n > 3 { true => xs[3], false => 0 }
  >
}

fn lane4_drop_i32(xs: layout.Lane4I32, n: i32) -> layout.Lane4I32 {
  match n {
    0 => xs,
    1 => <xs[1], xs[2], xs[3], 0>,
    2 => <xs[2], xs[3], 0, 0>,
    3 => <xs[3], 0, 0, 0>,
    _ => <0, 0, 0, 0>,
  }
}

fn lane4_reverse_i32(xs: layout.Lane4I32) -> layout.Lane4I32 {
  <xs[3], xs[2], xs[1], xs[0]>
}

fn lane4_rotate_left_i32(xs: layout.Lane4I32) -> layout.Lane4I32 {
  <xs[1], xs[2], xs[3], xs[0]>
}

fn lane4_rotate_right_i32(xs: layout.Lane4I32) -> layout.Lane4I32 {
  <xs[3], xs[0], xs[1], xs[2]>
}

fn mat4_rows_i32(
  r0: layout.Lane4I32,
  r1: layout.Lane4I32,
  r2: layout.Lane4I32,
  r3: layout.Lane4I32
) -> layout.Mat4I32 {
  <r0, r1, r2, r3>
}

fn capacity(xs: layout.Lane4I32) -> i32 {
  4
}

fn in_bounds(xs: layout.Lane4I32, i: i32) -> bool {
  match 0 <= i { true => i < capacity(xs), false => false }
}

fn get(xs: layout.Lane4I32, i: i32) -> layout.core.Option(i32) {
  match i {
    0 => xs[0],
    1 => xs[1],
    2 => xs[2],
    3 => xs[3],
    _ => 0,
  }
}

type fn RuntimeView(a: type) {
  let RuntimeView = {base: a, len: i32, stride: i32};
  struct(RuntimeView)
}

type fn RuntimeRange() {
  let RuntimeRange = {start: i32, end: i32, step: i32};
  struct(RuntimeRange)
}

type fn RangeI32() {
  let RangeI32 = {start: i32, end: i32};
  struct(RangeI32)
}

type fn Iter() {
  let Iter = {items: layout.Lane4I32, keep: layout.Lane4Bool};
  struct(Iter)
}

type fn CompactArray(n: count, a: type) {
  let CompactArray = {items: layout.InlineArray(n, a), len: i32};
  struct(CompactArray)
}

type fn CompactArrayBuilder(n: count, a: type) {
  let CompactArrayBuilder = {items: layout.InlineArrayBuilder(n, a), len: i32};
  struct(CompactArrayBuilder)
}

type fn CompactIter(n: count, a: type) {
  let CompactIter = {source: CompactArray(n, a)};
  struct(CompactIter)
}

type fn RangeIter() {
  let RangeIter = {source: RangeI32};
  struct(RangeIter)
}

fn layout.InlineArray.Iter(xs: layout.Lane4I32) -> Iter {
  Iter {items: xs, keep: <true, true, true, true>}
}

fn RangeI32.Iter(r: RangeI32) -> RangeIter {
  RangeIter {source: r}
}

fn Iter.map(xs: Iter, const f: fn(x: i32) -> i32) -> Iter {
  Iter {items: <f(xs.items[0]), f(xs.items[1]), f(xs.items[2]), f(xs.items[3])>, keep: xs.keep}
}

fn Iter.filter(xs: Iter, const pred: fn(x: i32) -> bool) -> Iter {
  Iter {
    items: xs.items,
    keep: <
      match xs.keep[0] { true => pred(xs.items[0]), false => false },
      match xs.keep[1] { true => pred(xs.items[1]), false => false },
      match xs.keep[2] { true => pred(xs.items[2]), false => false },
      match xs.keep[3] { true => pred(xs.items[3]), false => false }
    >
  }
}

fn Iter.reverse(xs: Iter) -> Iter {
  Iter {
    items: <xs.items[3], xs.items[2], xs.items[1], xs.items[0]>,
    keep: <xs.keep[3], xs.keep[2], xs.keep[1], xs.keep[0]>
  }
}

fn Iter.take2(xs: Iter) -> Iter {
  Iter {items: xs.items, keep: <xs.keep[0], xs.keep[1], false, false>}
}

fn Iter.drop1(xs: Iter) -> Iter {
  Iter {items: xs.items, keep: <false, xs.keep[1], xs.keep[2], xs.keep[3]>}
}

fn Iter.fold(xs: Iter, init: i32, const f: fn(acc: i32, x: i32) -> i32) -> i32 {
  let init_then = init;
let init_else = init;
  let acc0 = match xs.keep[0] { true => f(init_then, xs.items[0]), false => init_else };
  let acc0_then = acc0;
let acc0_else = acc0;
  let acc1 = match xs.keep[1] { true => f(acc0_then, xs.items[1]), false => acc0_else };
  let acc1_then = acc1;
let acc1_else = acc1;
  let acc2 = match xs.keep[2] { true => f(acc1_then, xs.items[2]), false => acc1_else };
  let acc2_then = acc2;
let acc2_else = acc2;
  match xs.keep[3] { true => f(acc2_then, xs.items[3]), false => acc2_else }
}

fn Iter.reduce(xs: Iter, const f: fn(a: i32, b: i32) -> i32) -> i32 {
  Iter.fold(Iter.drop1(xs), xs.items[0], f)
}

fn Iter.any(xs: Iter, const pred: fn(x: i32) -> bool) -> bool {
  match xs.keep[0] {
    true => match pred(xs.items[0]) {
      true => true,
      false => match xs.keep[1] {
        true => match pred(xs.items[1]) {
          true => true,
          false => match xs.keep[2] {
            true => match pred(xs.items[2]) {
              true => true,
              false => match xs.keep[3] { true => pred(xs.items[3]), false => false },
            },
            false => match xs.keep[3] { true => pred(xs.items[3]), false => false },
          },
        },
        false => match xs.keep[2] {
          true => match pred(xs.items[2]) {
            true => true,
            false => match xs.keep[3] { true => pred(xs.items[3]), false => false },
          },
          false => match xs.keep[3] { true => pred(xs.items[3]), false => false },
        },
      },
    },
    false => match xs.keep[1] {
      true => match pred(xs.items[1]) {
        true => true,
        false => match xs.keep[2] {
          true => match pred(xs.items[2]) {
            true => true,
            false => match xs.keep[3] { true => pred(xs.items[3]), false => false },
          },
          false => match xs.keep[3] { true => pred(xs.items[3]), false => false },
        },
      },
      false => match xs.keep[2] {
        true => match pred(xs.items[2]) {
          true => true,
          false => match xs.keep[3] { true => pred(xs.items[3]), false => false },
        },
        false => match xs.keep[3] { true => pred(xs.items[3]), false => false },
      },
    },
  }
}

fn Iter.all(xs: Iter, const pred: fn(x: i32) -> bool) -> bool {
  match xs.keep[0] {
    true => match pred(xs.items[0]) {
      true => match xs.keep[1] {
        true => match pred(xs.items[1]) {
          true => match xs.keep[2] {
            true => match pred(xs.items[2]) {
              true => match xs.keep[3] { true => pred(xs.items[3]), false => true },
              false => false,
            },
            false => match xs.keep[3] { true => pred(xs.items[3]), false => true },
          },
          false => false,
        },
        false => match xs.keep[2] {
          true => match pred(xs.items[2]) {
            true => match xs.keep[3] { true => pred(xs.items[3]), false => true },
            false => false,
          },
          false => match xs.keep[3] { true => pred(xs.items[3]), false => true },
        },
      },
      false => false,
    },
    false => match xs.keep[1] {
      true => match pred(xs.items[1]) {
        true => match xs.keep[2] {
          true => match pred(xs.items[2]) {
            true => match xs.keep[3] { true => pred(xs.items[3]), false => true },
            false => false,
          },
          false => match xs.keep[3] { true => pred(xs.items[3]), false => true },
        },
        false => false,
      },
      false => match xs.keep[2] {
        true => match pred(xs.items[2]) {
          true => match xs.keep[3] { true => pred(xs.items[3]), false => true },
          false => false,
        },
        false => match xs.keep[3] { true => pred(xs.items[3]), false => true },
      },
    },
  }
}

fn Iter.count(xs: Iter) -> i32 {
  let c0 = match xs.keep[0] { true => 1, false => 0 };
  let c1 = match xs.keep[1] { true => 1, false => 0 };
  let c2 = match xs.keep[2] { true => 1, false => 0 };
  let c3 = match xs.keep[3] { true => 1, false => 0 };
  c0 + c1 + c2 + c3
}

fn Iter.sum(xs: Iter) -> i32 {
  let v0 = match xs.keep[0] { true => xs.items[0], false => 0 };
  let v1 = match xs.keep[1] { true => xs.items[1], false => 0 };
  let v2 = match xs.keep[2] { true => xs.items[2], false => 0 };
  let v3 = match xs.keep[3] { true => xs.items[3], false => 0 };
  v0 + v1 + v2 + v3
}

fn Iter.collect(xs: Iter) -> CompactArray(4, i32) {
  let len0 = match xs.keep[0] { true => 1, false => 0 };
  let i0 = match xs.keep[0] { true => xs.items[0], false => 0 };

  let len0_for_i0 = len0;
let len0_for_i1 = len0;
let len0_for_len = len0;
  let i0_for_i0 = i0;
let i0_for_i1 = i0;
  let i0_after1 = match xs.keep[1] {
    true => match len0_for_i0 { 0 => xs.items[1], _ => i0_for_i0 },
    false => i0_for_i1,
  };
  let i1_after1 = match xs.keep[1] {
    true => match len0_for_i1 { 0 => 0, _ => xs.items[1] },
    false => 0,
  };
  let len1 = match xs.keep[1] { true => len0_for_len + 1, false => len0_for_len };

  let len1_for_i0 = len1;
let len1_for_i1 = len1;
let len1_for_i2 = len1;
let len1_for_len = len1;
  let i0_after1_for_i0 = i0_after1;
let i0_after1_for_i1 = i0_after1;
  let i1_after1_for_i1 = i1_after1;
let i1_after1_for_i2 = i1_after1;
  let i0_after2 = match xs.keep[2] {
    true => match len1_for_i0 { 0 => xs.items[2], _ => i0_after1_for_i0 },
    false => i0_after1_for_i1,
  };
  let i1_after2 = match xs.keep[2] {
    true => match len1_for_i1 {
      0 => 0,
      1 => xs.items[2],
      _ => i1_after1_for_i1,
    },
    false => i1_after1_for_i2,
  };
  let i2_after2 = match xs.keep[2] {
    true => match len1_for_i2 { 2 => xs.items[2], _ => 0 },
    false => 0,
  };
  let len2 = match xs.keep[2] { true => len1_for_len + 1, false => len1_for_len };

  let len2_for_i0 = len2;
let len2_for_i1 = len2;
let len2_for_i2 = len2;
let len2_for_i3 = len2;
let len2_for_len = len2;
  let i0_after2_for_i0 = i0_after2;
let i0_after2_for_final = i0_after2;
  let i1_after2_for_i1 = i1_after2;
let i1_after2_for_final = i1_after2;
  let i2_after2_for_i2 = i2_after2;
let i2_after2_for_final = i2_after2;
  let i0_final = match xs.keep[3] {
    true => match len2_for_i0 { 0 => xs.items[3], _ => i0_after2_for_i0 },
    false => i0_after2_for_final,
  };
  let i1_final = match xs.keep[3] {
    true => match len2_for_i1 {
      0 => 0,
      1 => xs.items[3],
      _ => i1_after2_for_i1,
    },
    false => i1_after2_for_final,
  };
  let i2_final = match xs.keep[3] {
    true => match len2_for_i2 {
      2 => xs.items[3],
      _ => i2_after2_for_i2,
    },
    false => i2_after2_for_final,
  };
  let i3_final = match xs.keep[3] {
    true => match len2_for_i3 { 3 => xs.items[3], _ => 0 },
    false => 0,
  };
  let len_final = match xs.keep[3] { true => len2_for_len + 1, false => len2_for_len };
  CompactArray {items: <i0_final, i1_final, i2_final, i3_final>, len: len_final}
}

fn CompactArray.collect_start(const n: count, const a: type) -> CompactArrayBuilder(n, a) {
  CompactArrayBuilder {items: layout.InlineArrayBuilder.start(n, a), len: 0}
}

fn CompactArray.collect_push(
  const n: count,
  const a: type,
  builder: CompactArrayBuilder(n, a),
  item: a
) -> CompactArrayBuilder(n, a) {
  CompactArrayBuilder {
    items: layout.InlineArrayBuilder.push(n, a, builder.items, builder.len, item),
    len: builder.len + 1
  }
}

fn CompactArray.collect_finish(
  const n: count,
  const a: type,
  builder: CompactArrayBuilder(n, a)
) -> CompactArray(n, a) {
  CompactArray {items: layout.InlineArrayBuilder.finish(n, a, builder.items), len: builder.len}
}

fn CompactArray.empty(const n: count, const a: type) -> CompactArray(n, a) {
  CompactArray.collect_finish(n, a, CompactArray.collect_start(n, a))
}

fn CompactArray.capacity(const n: count, const a: type, xs: CompactArray(n, a)) -> i32 {
  n
}

fn CompactArray.len(const n: count, const a: type, xs: CompactArray(n, a)) -> i32 {
  xs.len
}

fn CompactArray.is_empty(const n: count, const a: type, xs: CompactArray(n, a)) -> bool {
  xs.len == 0
}

fn CompactArray.is_full(const n: count, const a: type, xs: CompactArray(n, a)) -> bool {
  xs.len == n
}

fn CompactArray.get(const n: count, const a: type, xs: CompactArray(n, a), i: i32) -> layout.core.Option(a) {
  let xs_for_len = xs;
let xs_for_items = xs;
  match 0 <= i {
    true => match i < xs_for_len.len {
      true => xs_for_items.items[i],
      false => 0,
    },
    false => 0,
  }
}

fn CompactArray.push(
  const n: count,
  const a: type,
  xs: CompactArray(n, a),
  value: a
) -> CompactArray(n, a) {
  let xs_update = xs;
let xs_full = xs;
  match xs_update.len < n {
    true => CompactArray {items: layout.InlineArrayBuilder.push(n, a, xs_update.items, xs_update.len, value), len: xs_update.len + 1},
    false => xs_full,
  }
}

fn CompactArray.map(
  const n: count,
  const a: type,
  const b: type,
  xs: CompactArray(n, a),
  const f: fn(x: a) -> b
) -> CompactArray(n, b) {
  CompactArray.map_loop(n, a, b, layout.core.IndexCursor.start(n), CompactArray.collect_start(n, b), xs, f)
}

fn CompactArray.map_loop(
  const n: count,
  const a: type,
  const b: type,
  cursor: layout.core.IndexCursor(n),
  builder: CompactArrayBuilder(n, b),
  xs: CompactArray(n, a),
  const f: fn(x: a) -> b
) -> CompactArray(n, b) {
  let builder_next = builder;
let builder_finish = builder;
  let builder_false = builder_finish;
let builder_done = builder_finish;
  let xs_for_len = xs;
let xs_for_value = xs;
  let xs_item = xs_for_value;
let xs_next = xs_for_value;
  match layout.core.IndexCursor.next(n, cursor) {
    Yield(i, next) => match i < xs_for_len.len {
      true => CompactArray.map_loop(n, a, b, next, CompactArray.collect_push(n, b, builder_next, f(xs_item.items[i])), xs_next, f),
      false => CompactArray.collect_finish(n, b, builder_false),
    },
    Done => CompactArray.collect_finish(n, b, builder_done),
  }
}

fn CompactArray.fold(
  const n: count,
  const a: type,
  const acc: type,
  xs: CompactArray(n, a),
  init: acc,
  const f: fn(acc: acc, x: a) -> acc
) -> acc {
  CompactArray.fold_loop(n, a, acc, layout.core.IndexCursor.start(n), xs, init, f)
}

fn CompactArray.fold_loop(
  const n: count,
  const a: type,
  const acc: type,
  cursor: layout.core.IndexCursor(n),
  xs: CompactArray(n, a),
  state: acc,
  const f: fn(acc: acc, x: a) -> acc
) -> acc {
  let xs_for_len = xs;
let xs_for_value = xs;
  let xs_item = xs_for_value;
let xs_next = xs_for_value;
  let state_next = state;
let state_finish = state;
  let state_false = state_finish;
let state_done = state_finish;
  match layout.core.IndexCursor.next(n, cursor) {
    Yield(i, next) => match i < xs_for_len.len {
      true => CompactArray.fold_loop(n, a, acc, next, xs_next, f(state_next, xs_item.items[i]), f),
      false => state_false,
    },
    Done => state_done,
  }
}

fn CompactArray.count(const n: count, const a: type, xs: CompactArray(n, a), const pred: fn(x: a) -> bool) -> i32 {
  CompactArray.count_loop(n, a, layout.core.IndexCursor.start(n), xs, pred, 0)
}

fn CompactArray.count_loop(
  const n: count,
  const a: type,
  cursor: layout.core.IndexCursor(n),
  xs: CompactArray(n, a),
  const pred: fn(x: a) -> bool,
  total: i32
) -> i32 {
  let xs_for_len = xs;
let xs_for_value = xs;
  let xs_item = xs_for_value;
let xs_next = xs_for_value;
  let total_next = total;
let total_finish = total;
  let total_false = total_finish;
let total_done = total_finish;
  match layout.core.IndexCursor.next(n, cursor) {
    Yield(i, next) => match i < xs_for_len.len {
      true => CompactArray.count_loop(n, a, next, xs_next, pred, total_next + (match pred(xs_item.items[i]) { true => 1, false => 0 })),
      false => total_false,
    },
    Done => total_done,
  }
}

fn CompactArray.Iter(const n: count, const a: type, xs: CompactArray(n, a)) -> CompactIter(n, a) {
  CompactIter {source: xs}
}

fn RangeIter.fold_loop(i: i32, end: i32, acc: i32, const f: fn(acc: i32, x: i32) -> i32) -> i32 {
  let acc_then = acc;
let acc_else = acc;
  match i < end {
    true => RangeIter.fold_loop(i + 1, end, f(acc_then, i), f),
    false => acc_else,
  }
}

fn RangeIter.fold(xs: RangeIter, init: i32, const f: fn(acc: i32, x: i32) -> i32) -> i32 {
  RangeIter.fold_loop(xs.source.start, xs.source.end, init, f)
}

fn RangeIter.count(xs: RangeIter) -> i32 {
  match xs.source.start < xs.source.end {
    true => xs.source.end - xs.source.start,
    false => 0,
  }
}

fn RangeIter.sum(xs: RangeIter) -> i32 {
  RangeIter.fold(xs, 0, i32_add)
}

fn RangeIter.product(xs: RangeIter) -> i32 {
  RangeIter.fold(xs, 1, i32_mul)
}

fn i32_add(acc: i32, x: i32) -> i32 {
  acc + x
}

fn i32_mul(acc: i32, x: i32) -> i32 {
  acc * x
}

fn map4_scalar_i32(const f: fn(x: layout.core.ScalarI32) -> layout.core.ScalarI32, x: layout.core.ScalarI32) -> layout.core.ScalarI32 {
  f(f(f(f(x))))
}

fn zip_with4_scalar_i32(
  const f: fn(a: layout.core.ScalarI32, b: layout.core.ScalarI32) -> layout.core.ScalarI32,
  x: layout.core.ScalarI32,
  y0: layout.core.ScalarI32,
  y1: layout.core.ScalarI32,
  y2: layout.core.ScalarI32,
  y3: layout.core.ScalarI32
) -> layout.core.ScalarI32 {
  f(f(f(f(x, y0), y1), y2), y3)
}
