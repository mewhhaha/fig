const layout = @import("prelude.layout");

// Futhark-style SOAC names for fixed inline layouts. Work/span comments describe
// intent only; the current backend proves parsing, checking, specialization, and
// scalar direct calls after optimization.

fn add_i32(a: i32, b: i32) -> i32 {
  a + b
}

fn mul_i32(a: i32, b: i32) -> i32 {
  a * b
}

fn min_i32(a: i32, b: i32) -> i32 {
  match a < b { true => a, false => b }
}

fn max_i32(a: i32, b: i32) -> i32 {
  match a > b { true => a, false => b }
}

fn map4_i32(const f: fn(x: i32) -> i32, xs: layout.Lane4I32) -> layout.Lane4I32 {
  map4_i32_go(0, f, xs, layout.InlineArrayBuilder.start(4, i32))
}

fn map4_i32_go(
  i: i32(4),
  const f: fn(x: i32) -> i32,
  xs: layout.Lane4I32,
  builder: layout.InlineArrayBuilder(4, i32)
) -> layout.Lane4I32 {
  layout.InlineArrayBuilder.finish(4, i32, builder)
}

fn map4_i32_go(
  i: i32(0..4),
  const f: fn(x: i32) -> i32,
  xs: layout.Lane4I32,
  builder: layout.InlineArrayBuilder(4, i32)
) -> layout.Lane4I32 {
  map4_i32_go(
    i + 1,
    f,
    xs,
    layout.InlineArrayBuilder.push(4, i32, builder, i, f(xs[i]))
  )
}

fn zip_with4_i32(const f: fn(a: i32, b: i32) -> i32, xs: layout.Lane4I32, ys: layout.Lane4I32) -> layout.Lane4I32 {
  zip_with4_i32_go(0, f, xs, ys, layout.InlineArrayBuilder.start(4, i32))
}

fn zip_with4_i32_go(
  i: i32(4),
  const f: fn(a: i32, b: i32) -> i32,
  xs: layout.Lane4I32,
  ys: layout.Lane4I32,
  builder: layout.InlineArrayBuilder(4, i32)
) -> layout.Lane4I32 {
  layout.InlineArrayBuilder.finish(4, i32, builder)
}

fn zip_with4_i32_go(
  i: i32(0..4),
  const f: fn(a: i32, b: i32) -> i32,
  xs: layout.Lane4I32,
  ys: layout.Lane4I32,
  builder: layout.InlineArrayBuilder(4, i32)
) -> layout.Lane4I32 {
  zip_with4_i32_go(
    i + 1,
    f,
    xs,
    ys,
    layout.InlineArrayBuilder.push(4, i32, builder, i, f(xs[i], ys[i]))
  )
}

fn fold4_i32(const f: fn(acc: i32, x: i32) -> i32, init: i32, xs: layout.Lane4I32) -> i32 {
  fold4_i32_go(0, f, init, xs)
}

fn fold4_i32_go(i: i32(4), const f: fn(acc: i32, x: i32) -> i32, acc: i32, xs: layout.Lane4I32) -> i32 {
  acc
}

fn fold4_i32_go(i: i32(0..4), const f: fn(acc: i32, x: i32) -> i32, acc: i32, xs: layout.Lane4I32) -> i32 {
  fold4_i32_go(i + 1, f, f(acc, xs[i]), xs)
}

fn reduce4_i32(const f: fn(a: i32, b: i32) -> i32, xs: layout.Lane4I32) -> i32 {
  reduce4_i32_go(1, f, xs, xs[0])
}

fn reduce4_i32_go(i: i32(4), const f: fn(a: i32, b: i32) -> i32, xs: layout.Lane4I32, acc: i32) -> i32 {
  acc
}

fn reduce4_i32_go(i: i32(1..4), const f: fn(a: i32, b: i32) -> i32, xs: layout.Lane4I32, acc: i32) -> i32 {
  reduce4_i32_go(i + 1, f, xs, f(acc, xs[i]))
}

fn lane4_add_i32(xs: layout.Lane4I32, ys: layout.Lane4I32) -> layout.Lane4I32 {
  zip_with4_i32(add_i32, xs, ys)
}

fn lane4_mul_i32(xs: layout.Lane4I32, ys: layout.Lane4I32) -> layout.Lane4I32 {
  zip_with4_i32(mul_i32, xs, ys)
}

fn lane4_dot_i32(xs: layout.Lane4I32, ys: layout.Lane4I32) -> i32 {
  lane4_sum_i32(lane4_mul_i32(xs, ys))
}

fn lane4_is_empty_i32(xs: layout.Lane4I32) -> bool {
  false
}

fn lane4_length_i32(xs: layout.Lane4I32) -> i32 {
  4
}

fn lane4_any_i32(xs: layout.Lane4I32, const pred: fn(x: i32) -> bool) -> bool {
  lane4_any_i32_go(0, xs, pred)
}

fn lane4_any_i32_go(i: i32(4), xs: layout.Lane4I32, const pred: fn(x: i32) -> bool) -> bool {
  false
}

fn lane4_any_i32_go(i: i32(0..4), xs: layout.Lane4I32, const pred: fn(x: i32) -> bool) -> bool {
  match pred(xs[i]) {
    true => true,
    false => lane4_any_i32_go(i + 1, xs, pred),
  }
}

fn lane4_all_i32(xs: layout.Lane4I32, const pred: fn(x: i32) -> bool) -> bool {
  lane4_all_i32_go(0, xs, pred)
}

fn lane4_all_i32_go(i: i32(4), xs: layout.Lane4I32, const pred: fn(x: i32) -> bool) -> bool {
  true
}

fn lane4_all_i32_go(i: i32(0..4), xs: layout.Lane4I32, const pred: fn(x: i32) -> bool) -> bool {
  match pred(xs[i]) {
    true => lane4_all_i32_go(i + 1, xs, pred),
    false => false,
  }
}

fn lane4_count_i32(xs: layout.Lane4I32, const pred: fn(x: i32) -> bool) -> i32 {
  lane4_count_i32_go(0, xs, pred, 0)
}

fn lane4_count_i32_go(i: i32(4), xs: layout.Lane4I32, const pred: fn(x: i32) -> bool, total: i32) -> i32 {
  total
}

fn lane4_count_i32_go(i: i32(0..4), xs: layout.Lane4I32, const pred: fn(x: i32) -> bool, total: i32) -> i32 {
  let add: i32 = match pred(xs[i]) { true => 1, false => 0 };
  lane4_count_i32_go(
    i + 1,
    xs,
    pred,
    total + add
  )
}

fn lane4_contains_i32(xs: layout.Lane4I32, value: i32) -> bool {
  lane4_contains_i32_go(0, xs, value)
}

fn lane4_contains_i32_go(i: i32(4), xs: layout.Lane4I32, value: i32) -> bool {
  false
}

fn lane4_contains_i32_go(i: i32(0..4), xs: layout.Lane4I32, value: i32) -> bool {
  match xs[i] == value {
    true => true,
    false => lane4_contains_i32_go(i + 1, xs, value),
  }
}

fn lane4_index_of_i32(xs: layout.Lane4I32, value: i32) -> layout.core.Option(i32) {
  lane4_index_of_i32_go(0, xs, value)
}

fn lane4_index_of_i32_go(i: i32(4), xs: layout.Lane4I32, value: i32) -> layout.core.Option(i32) {
  0
}

fn lane4_index_of_i32_go(i: i32(0..4), xs: layout.Lane4I32, value: i32) -> layout.core.Option(i32) {
  match xs[i] == value {
    true => i,
    false => lane4_index_of_i32_go(i + 1, xs, value),
  }
}

fn lane4_sum_i32(xs: layout.Lane4I32) -> i32 {
  fold4_i32(add_i32, 0, xs)
}

fn lane4_product_i32(xs: layout.Lane4I32) -> i32 {
  fold4_i32(mul_i32, 1, xs)
}

fn lane4_min_i32(xs: layout.Lane4I32) -> i32 {
  reduce4_i32(min_i32, xs)
}

fn lane4_max_i32(xs: layout.Lane4I32) -> i32 {
  reduce4_i32(max_i32, xs)
}

fn lane4_set_i32(xs: layout.Lane4I32, i: i32, value: i32) -> layout.Lane4I32 {
  lane4_set_i32_go(0, xs, i, value, layout.InlineArrayBuilder.start(4, i32))
}

fn lane4_set_i32_go(
  lane: i32(4),
  xs: layout.Lane4I32,
  i: i32,
  value: i32,
  builder: layout.InlineArrayBuilder(4, i32)
) -> layout.Lane4I32 {
  layout.InlineArrayBuilder.finish(4, i32, builder)
}

fn lane4_set_i32_go(
  lane: i32(0..4),
  xs: layout.Lane4I32,
  i: i32,
  value: i32,
  builder: layout.InlineArrayBuilder(4, i32)
) -> layout.Lane4I32 {
  lane4_set_i32_go(
    lane + 1,
    xs,
    i,
    value,
    layout.InlineArrayBuilder.push(
      4,
      i32,
      builder,
      lane,
      match lane == i { true => value, false => xs[lane] }
    )
  )
}

fn lane4_update_i32(xs: layout.Lane4I32, i: i32, const f: fn(x: i32) -> i32) -> layout.Lane4I32 {
  lane4_update_i32_go(0, xs, i, f, layout.InlineArrayBuilder.start(4, i32))
}

fn lane4_update_i32_go(
  lane: i32(4),
  xs: layout.Lane4I32,
  i: i32,
  const f: fn(x: i32) -> i32,
  builder: layout.InlineArrayBuilder(4, i32)
) -> layout.Lane4I32 {
  layout.InlineArrayBuilder.finish(4, i32, builder)
}

fn lane4_update_i32_go(
  lane: i32(0..4),
  xs: layout.Lane4I32,
  i: i32,
  const f: fn(x: i32) -> i32,
  builder: layout.InlineArrayBuilder(4, i32)
) -> layout.Lane4I32 {
  let old = xs[lane];
  lane4_update_i32_go(
    lane + 1,
    xs,
    i,
    f,
    layout.InlineArrayBuilder.push(
      4,
      i32,
      builder,
      lane,
      match lane == i { true => f(old), false => old }
    )
  )
}

fn lane4_replace_where_i32(
  xs: layout.Lane4I32,
  const pred: fn(x: i32) -> bool,
  value: i32
) -> layout.Lane4I32 {
  lane4_replace_where_i32_go(0, xs, pred, value, layout.InlineArrayBuilder.start(4, i32))
}

fn lane4_replace_where_i32_go(
  lane: i32(4),
  xs: layout.Lane4I32,
  const pred: fn(x: i32) -> bool,
  value: i32,
  builder: layout.InlineArrayBuilder(4, i32)
) -> layout.Lane4I32 {
  layout.InlineArrayBuilder.finish(4, i32, builder)
}

fn lane4_replace_where_i32_go(
  lane: i32(0..4),
  xs: layout.Lane4I32,
  const pred: fn(x: i32) -> bool,
  value: i32,
  builder: layout.InlineArrayBuilder(4, i32)
) -> layout.Lane4I32 {
  let old = xs[lane];
  lane4_replace_where_i32_go(
    lane + 1,
    xs,
    pred,
    value,
    layout.InlineArrayBuilder.push(
      4,
      i32,
      builder,
      lane,
      match pred(old) { true => value, false => old }
    )
  )
}

fn lane4_take_i32(xs: layout.Lane4I32, n: i32) -> layout.Lane4I32 {
  lane4_take_i32_go(0, xs, n, layout.InlineArrayBuilder.start(4, i32))
}

fn lane4_take_i32_go(
  lane: i32(4),
  xs: layout.Lane4I32,
  n: i32,
  builder: layout.InlineArrayBuilder(4, i32)
) -> layout.Lane4I32 {
  layout.InlineArrayBuilder.finish(4, i32, builder)
}

fn lane4_take_i32_go(
  lane: i32(0..4),
  xs: layout.Lane4I32,
  n: i32,
  builder: layout.InlineArrayBuilder(4, i32)
) -> layout.Lane4I32 {
  lane4_take_i32_go(
    lane + 1,
    xs,
    n,
    layout.InlineArrayBuilder.push(
      4,
      i32,
      builder,
      lane,
      match lane < n { true => xs[lane], false => 0 }
    )
  )
}

fn lane4_drop_i32(xs: layout.Lane4I32, n: i32) -> layout.Lane4I32 {
  match n {
    0 => xs,
    1 => lane4_drop1_i32(0, xs, layout.InlineArrayBuilder.start(4, i32)),
    2 => lane4_drop2_i32(0, xs, layout.InlineArrayBuilder.start(4, i32)),
    3 => lane4_drop3_i32(0, xs, layout.InlineArrayBuilder.start(4, i32)),
    _ => <0, 0, 0, 0>,
  }
}

fn lane4_drop1_i32(i: i32(4), xs: layout.Lane4I32, builder: layout.InlineArrayBuilder(4, i32)) -> layout.Lane4I32 {
  layout.InlineArrayBuilder.finish(4, i32, builder)
}

fn lane4_drop1_i32(i: i32(0..4), xs: layout.Lane4I32, builder: layout.InlineArrayBuilder(4, i32)) -> layout.Lane4I32 {
  lane4_drop1_i32(
    i + 1,
    xs,
    layout.InlineArrayBuilder.push(4, i32, builder, i, match i < 3 { true => xs[i + 1], false => 0 })
  )
}

fn lane4_drop2_i32(i: i32(4), xs: layout.Lane4I32, builder: layout.InlineArrayBuilder(4, i32)) -> layout.Lane4I32 {
  layout.InlineArrayBuilder.finish(4, i32, builder)
}

fn lane4_drop2_i32(i: i32(0..4), xs: layout.Lane4I32, builder: layout.InlineArrayBuilder(4, i32)) -> layout.Lane4I32 {
  lane4_drop2_i32(
    i + 1,
    xs,
    layout.InlineArrayBuilder.push(4, i32, builder, i, match i < 2 { true => xs[i + 2], false => 0 })
  )
}

fn lane4_drop3_i32(i: i32(4), xs: layout.Lane4I32, builder: layout.InlineArrayBuilder(4, i32)) -> layout.Lane4I32 {
  layout.InlineArrayBuilder.finish(4, i32, builder)
}

fn lane4_drop3_i32(i: i32(0..4), xs: layout.Lane4I32, builder: layout.InlineArrayBuilder(4, i32)) -> layout.Lane4I32 {
  lane4_drop3_i32(
    i + 1,
    xs,
    layout.InlineArrayBuilder.push(4, i32, builder, i, match i < 1 { true => xs[i + 3], false => 0 })
  )
}

fn lane4_reverse_i32(xs: layout.Lane4I32) -> layout.Lane4I32 {
  lane4_reverse_i32_go(0, xs, layout.InlineArrayBuilder.start(4, i32))
}

fn lane4_reverse_i32_go(i: i32(4), xs: layout.Lane4I32, builder: layout.InlineArrayBuilder(4, i32)) -> layout.Lane4I32 {
  layout.InlineArrayBuilder.finish(4, i32, builder)
}

fn lane4_reverse_i32_go(i: i32(0..4), xs: layout.Lane4I32, builder: layout.InlineArrayBuilder(4, i32)) -> layout.Lane4I32 {
  lane4_reverse_i32_go(
    i + 1,
    xs,
    layout.InlineArrayBuilder.push(4, i32, builder, i, xs[3 - i])
  )
}

fn lane4_rotate_left_i32(xs: layout.Lane4I32) -> layout.Lane4I32 {
  lane4_rotate_left_i32_go(0, xs, layout.InlineArrayBuilder.start(4, i32))
}

fn lane4_rotate_left_i32_go(i: i32(4), xs: layout.Lane4I32, builder: layout.InlineArrayBuilder(4, i32)) -> layout.Lane4I32 {
  layout.InlineArrayBuilder.finish(4, i32, builder)
}

fn lane4_rotate_left_i32_go(i: i32(0..4), xs: layout.Lane4I32, builder: layout.InlineArrayBuilder(4, i32)) -> layout.Lane4I32 {
  lane4_rotate_left_i32_go(
    i + 1,
    xs,
    layout.InlineArrayBuilder.push(4, i32, builder, i, match i == 3 { true => xs[0], false => xs[i + 1] })
  )
}

fn lane4_rotate_right_i32(xs: layout.Lane4I32) -> layout.Lane4I32 {
  lane4_rotate_right_i32_go(0, xs, layout.InlineArrayBuilder.start(4, i32))
}

fn lane4_rotate_right_i32_go(i: i32(4), xs: layout.Lane4I32, builder: layout.InlineArrayBuilder(4, i32)) -> layout.Lane4I32 {
  layout.InlineArrayBuilder.finish(4, i32, builder)
}

fn lane4_rotate_right_i32_go(i: i32(0..4), xs: layout.Lane4I32, builder: layout.InlineArrayBuilder(4, i32)) -> layout.Lane4I32 {
  lane4_rotate_right_i32_go(
    i + 1,
    xs,
    layout.InlineArrayBuilder.push(4, i32, builder, i, match i == 0 { true => xs[3], false => xs[i - 1] })
  )
}

fn mat4_rows_i32(
  r0: layout.Lane4I32,
  r1: layout.Lane4I32,
  r2: layout.Lane4I32,
  r3: layout.Lane4I32
) -> layout.Mat4I32 {
  <r0, r1, r2, r3>
}

fn capacity(xs: layout.Lane4I32) -> i32 {
  4
}

fn in_bounds(xs: layout.Lane4I32, i: i32) -> bool {
  match 0 <= i { true => i < capacity(xs), false => false }
}

fn get(xs: layout.Lane4I32, i: i32) -> layout.core.Option(i32) {
  get_go(0, xs, i)
}

fn get_go(lane: i32(4), xs: layout.Lane4I32, i: i32) -> layout.core.Option(i32) {
  0
}

fn get_go(lane: i32(0..4), xs: layout.Lane4I32, i: i32) -> layout.core.Option(i32) {
  match lane == i {
    true => xs[lane],
    false => get_go(lane + 1, xs, i),
  }
}

type fn RuntimeView(a: type) {
  let RuntimeView = {base: a, len: i32, stride: i32};
  struct(RuntimeView)
}

type fn RuntimeRange() {
  let RuntimeRange = {start: i32, end: i32, step: i32};
  struct(RuntimeRange)
}

type fn RangeI32() {
  let RangeI32 = {start: i32, end: i32};
  struct(RangeI32)
}

type fn Iter() {
  let Iter = {items: layout.Lane4I32, keep: layout.Lane4Bool};
  struct(Iter)
}

type fn CompactArray(n: count, a: type) {
  let CompactArray = {items: layout.InlineArray(n, a), len: i32};
  struct(CompactArray)
}

type fn CompactArrayBuilder(n: count, a: type) {
  let CompactArrayBuilder = {items: layout.InlineArrayBuilder(n, a), len: i32};
  struct(CompactArrayBuilder)
}

type fn CompactIter(n: count, a: type) {
  let CompactIter = {source: CompactArray(n, a)};
  struct(CompactIter)
}

type fn RangeIter() {
  let RangeIter = {source: RangeI32};
  struct(RangeIter)
}

fn layout.InlineArray.Iter(xs: layout.Lane4I32) -> Iter {
  Iter {items: xs, keep: <true, true, true, true>}
}

fn RangeI32.Iter(r: RangeI32) -> RangeIter {
  RangeIter {source: r}
}

fn Iter.map(xs: Iter, const f: fn(x: i32) -> i32) -> Iter {
  Iter.map_go(0, xs, f, layout.InlineArrayBuilder.start(4, i32))
}

fn Iter.map_go(
  i: i32(4),
  xs: Iter,
  const f: fn(x: i32) -> i32,
  builder: layout.InlineArrayBuilder(4, i32)
) -> Iter {
  Iter {items: layout.InlineArrayBuilder.finish(4, i32, builder), keep: xs.keep}
}

fn Iter.map_go(
  i: i32(0..4),
  xs: Iter,
  const f: fn(x: i32) -> i32,
  builder: layout.InlineArrayBuilder(4, i32)
) -> Iter {
  Iter.map_go(
    i + 1,
    xs,
    f,
    layout.InlineArrayBuilder.push(4, i32, builder, i, f(xs.items[i]))
  )
}

fn Iter.filter(xs: Iter, const pred: fn(x: i32) -> bool) -> Iter {
  Iter.filter_go(0, xs, pred, layout.InlineArrayBuilder.start(4, bool))
}

fn Iter.filter_go(
  i: i32(4),
  xs: Iter,
  const pred: fn(x: i32) -> bool,
  builder: layout.InlineArrayBuilder(4, bool)
) -> Iter {
  Iter {items: xs.items, keep: layout.InlineArrayBuilder.finish(4, bool, builder)}
}

fn Iter.filter_go(
  i: i32(0..4),
  xs: Iter,
  const pred: fn(x: i32) -> bool,
  builder: layout.InlineArrayBuilder(4, bool)
) -> Iter {
  Iter.filter_go(
    i + 1,
    xs,
    pred,
    layout.InlineArrayBuilder.push(
      4,
      bool,
      builder,
      i,
      match xs.keep[i] { true => pred(xs.items[i]), false => false }
    )
  )
}

fn Iter.reverse(xs: Iter) -> Iter {
  Iter.reverse_go(
    0,
    xs,
    layout.InlineArrayBuilder.start(4, i32),
    layout.InlineArrayBuilder.start(4, bool)
  )
}

fn Iter.reverse_go(
  i: i32(4),
  xs: Iter,
  item_builder: layout.InlineArrayBuilder(4, i32),
  keep_builder: layout.InlineArrayBuilder(4, bool)
) -> Iter {
  Iter {
    items: layout.InlineArrayBuilder.finish(4, i32, item_builder),
    keep: layout.InlineArrayBuilder.finish(4, bool, keep_builder)
  }
}

fn Iter.reverse_go(
  i: i32(0..4),
  xs: Iter,
  item_builder: layout.InlineArrayBuilder(4, i32),
  keep_builder: layout.InlineArrayBuilder(4, bool)
) -> Iter {
  let source = 3 - i;
  Iter.reverse_go(
    i + 1,
    xs,
    layout.InlineArrayBuilder.push(4, i32, item_builder, i, xs.items[source]),
    layout.InlineArrayBuilder.push(4, bool, keep_builder, i, xs.keep[source])
  )
}

fn Iter.take2(xs: Iter) -> Iter {
  Iter.take_go(0, xs, 2, layout.InlineArrayBuilder.start(4, bool))
}

fn Iter.drop1(xs: Iter) -> Iter {
  Iter.drop_go(0, xs, 1, layout.InlineArrayBuilder.start(4, bool))
}

fn Iter.take_go(
  i: i32(4),
  xs: Iter,
  n: i32,
  builder: layout.InlineArrayBuilder(4, bool)
) -> Iter {
  Iter {items: xs.items, keep: layout.InlineArrayBuilder.finish(4, bool, builder)}
}

fn Iter.take_go(
  i: i32(0..4),
  xs: Iter,
  n: i32,
  builder: layout.InlineArrayBuilder(4, bool)
) -> Iter {
  Iter.take_go(
    i + 1,
    xs,
    n,
    layout.InlineArrayBuilder.push(
      4,
      bool,
      builder,
      i,
      match i < n { true => xs.keep[i], false => false }
    )
  )
}

fn Iter.drop_go(
  i: i32(4),
  xs: Iter,
  n: i32,
  builder: layout.InlineArrayBuilder(4, bool)
) -> Iter {
  Iter {items: xs.items, keep: layout.InlineArrayBuilder.finish(4, bool, builder)}
}

fn Iter.drop_go(
  i: i32(0..4),
  xs: Iter,
  n: i32,
  builder: layout.InlineArrayBuilder(4, bool)
) -> Iter {
  Iter.drop_go(
    i + 1,
    xs,
    n,
    layout.InlineArrayBuilder.push(
      4,
      bool,
      builder,
      i,
      match i < n { true => false, false => xs.keep[i] }
    )
  )
}

fn Iter.fold(xs: Iter, init: i32, const f: fn(acc: i32, x: i32) -> i32) -> i32 {
  Iter.fold_go(0, xs, init, f)
}

fn Iter.fold_go(i: i32(4), xs: Iter, acc: i32, const f: fn(acc: i32, x: i32) -> i32) -> i32 {
  acc
}

fn Iter.fold_go(i: i32(0..4), xs: Iter, acc: i32, const f: fn(acc: i32, x: i32) -> i32) -> i32 {
  Iter.fold_go(
    i + 1,
    xs,
    match xs.keep[i] { true => f(acc, xs.items[i]), false => acc },
    f
  )
}

fn Iter.reduce(xs: Iter, const f: fn(a: i32, b: i32) -> i32) -> i32 {
  Iter.fold(Iter.drop1(xs), xs.items[0], f)
}

fn Iter.any(xs: Iter, const pred: fn(x: i32) -> bool) -> bool {
  Iter.any_go(0, xs, pred)
}

fn Iter.any_go(i: i32(4), xs: Iter, const pred: fn(x: i32) -> bool) -> bool {
  false
}

fn Iter.any_go(i: i32(0..4), xs: Iter, const pred: fn(x: i32) -> bool) -> bool {
  match xs.keep[i] {
    true => match pred(xs.items[i]) { true => true, false => Iter.any_go(i + 1, xs, pred) },
    false => Iter.any_go(i + 1, xs, pred),
  }
}

fn Iter.all(xs: Iter, const pred: fn(x: i32) -> bool) -> bool {
  Iter.all_go(0, xs, pred)
}

fn Iter.all_go(i: i32(4), xs: Iter, const pred: fn(x: i32) -> bool) -> bool {
  true
}

fn Iter.all_go(i: i32(0..4), xs: Iter, const pred: fn(x: i32) -> bool) -> bool {
  match xs.keep[i] {
    true => match pred(xs.items[i]) { true => Iter.all_go(i + 1, xs, pred), false => false },
    false => Iter.all_go(i + 1, xs, pred),
  }
}

fn Iter.count(xs: Iter) -> i32 {
  Iter.count_go(0, xs, 0)
}

fn Iter.count_go(i: i32(4), xs: Iter, total: i32) -> i32 {
  total
}

fn Iter.count_go(i: i32(0..4), xs: Iter, total: i32) -> i32 {
  let add: i32 = match xs.keep[i] { true => 1, false => 0 };
  Iter.count_go(i + 1, xs, total + add)
}

fn Iter.sum(xs: Iter) -> i32 {
  Iter.sum_go(0, xs, 0)
}

fn Iter.sum_go(i: i32(4), xs: Iter, total: i32) -> i32 {
  total
}

fn Iter.sum_go(i: i32(0..4), xs: Iter, total: i32) -> i32 {
  let add: i32 = match xs.keep[i] { true => xs.items[i], false => 0 };
  Iter.sum_go(i + 1, xs, total + add)
}

fn Iter.collect(xs: Iter) -> CompactArray(4, i32) {
  Iter.collect_go(0, xs, CompactArray.collect_start(4, i32))
}

fn Iter.collect_go(
  i: i32(4),
  xs: Iter,
  builder: CompactArrayBuilder(4, i32)
) -> CompactArray(4, i32) {
  CompactArray.collect_finish(4, i32, builder)
}

fn Iter.collect_go(
  i: i32(0..4),
  xs: Iter,
  builder: CompactArrayBuilder(4, i32)
) -> CompactArray(4, i32) {
  Iter.collect_go(
    i + 1,
    xs,
    match xs.keep[i] {
      true => CompactArray.collect_push(4, i32, builder, xs.items[i]),
      false => builder,
    }
  )
}

fn CompactArray.collect_start(const n: count, const a: type) -> CompactArrayBuilder(n, a) {
  CompactArrayBuilder {items: layout.InlineArrayBuilder.start(n, a), len: 0}
}

fn CompactArray.collect_push(
  const n: count,
  const a: type,
  builder: CompactArrayBuilder(n, a),
  item: a
) -> CompactArrayBuilder(n, a) {
  CompactArrayBuilder {
    items: layout.InlineArrayBuilder.push(n, a, builder.items, builder.len, item),
    len: builder.len + 1
  }
}

fn CompactArray.collect_finish(
  const n: count,
  const a: type,
  builder: CompactArrayBuilder(n, a)
) -> CompactArray(n, a) {
  CompactArray {items: layout.InlineArrayBuilder.finish(n, a, builder.items), len: builder.len}
}

fn CompactArray.empty(const n: count, const a: type) -> CompactArray(n, a) {
  CompactArray.collect_finish(n, a, CompactArray.collect_start(n, a))
}

fn CompactArray.capacity(const n: count, const a: type, xs: CompactArray(n, a)) -> i32 {
  n
}

fn CompactArray.len(const n: count, const a: type, xs: CompactArray(n, a)) -> i32 {
  xs.len
}

fn CompactArray.is_empty(const n: count, const a: type, xs: CompactArray(n, a)) -> bool {
  xs.len == 0
}

fn CompactArray.is_full(const n: count, const a: type, xs: CompactArray(n, a)) -> bool {
  xs.len == n
}

fn CompactArray.get(const n: count, const a: type, xs: CompactArray(n, a), i: i32) -> layout.core.Option(a) {
  let xs_for_len = xs;
let xs_for_items = xs;
  match 0 <= i {
    true => match i < xs_for_len.len {
      true => xs_for_items.items[i],
      false => 0,
    },
    false => 0,
  }
}

fn CompactArray.push(
  const n: count,
  const a: type,
  xs: CompactArray(n, a),
  value: a
) -> CompactArray(n, a) {
  let xs_update = xs;
let xs_full = xs;
  match xs_update.len < n {
    true => CompactArray {items: layout.InlineArrayBuilder.push(n, a, xs_update.items, xs_update.len, value), len: xs_update.len + 1},
    false => xs_full,
  }
}

fn CompactArray.map(
  const n: count,
  const a: type,
  const b: type,
  xs: CompactArray(n, a),
  const f: fn(x: a) -> b
) -> CompactArray(n, b) {
  CompactArray.map_loop(n, a, b, layout.core.IndexCursor.start(n), CompactArray.collect_start(n, b), xs, f)
}

fn CompactArray.map_loop(
  const n: count,
  const a: type,
  const b: type,
  cursor: layout.core.IndexCursor(n),
  builder: CompactArrayBuilder(n, b),
  xs: CompactArray(n, a),
  const f: fn(x: a) -> b
) -> CompactArray(n, b) {
  let builder_next = builder;
let builder_finish = builder;
  let builder_false = builder_finish;
let builder_done = builder_finish;
  let xs_for_len = xs;
let xs_for_value = xs;
  let xs_item = xs_for_value;
let xs_next = xs_for_value;
  match layout.core.IndexCursor.next(n, cursor) {
    Yield(i, next) => match i < xs_for_len.len {
      true => CompactArray.map_loop(n, a, b, next, CompactArray.collect_push(n, b, builder_next, f(xs_item.items[i])), xs_next, f),
      false => CompactArray.collect_finish(n, b, builder_false),
    },
    Done => CompactArray.collect_finish(n, b, builder_done),
  }
}

fn CompactArray.fold(
  const n: count,
  const a: type,
  const acc: type,
  xs: CompactArray(n, a),
  init: acc,
  const f: fn(acc: acc, x: a) -> acc
) -> acc {
  CompactArray.fold_loop(n, a, acc, layout.core.IndexCursor.start(n), xs, init, f)
}

fn CompactArray.fold_loop(
  const n: count,
  const a: type,
  const acc: type,
  cursor: layout.core.IndexCursor(n),
  xs: CompactArray(n, a),
  state: acc,
  const f: fn(acc: acc, x: a) -> acc
) -> acc {
  let xs_for_len = xs;
let xs_for_value = xs;
  let xs_item = xs_for_value;
let xs_next = xs_for_value;
  let state_next = state;
let state_finish = state;
  let state_false = state_finish;
let state_done = state_finish;
  match layout.core.IndexCursor.next(n, cursor) {
    Yield(i, next) => match i < xs_for_len.len {
      true => CompactArray.fold_loop(n, a, acc, next, xs_next, f(state_next, xs_item.items[i]), f),
      false => state_false,
    },
    Done => state_done,
  }
}

fn CompactArray.count(const n: count, const a: type, xs: CompactArray(n, a), const pred: fn(x: a) -> bool) -> i32 {
  CompactArray.count_loop(n, a, layout.core.IndexCursor.start(n), xs, pred, 0)
}

fn CompactArray.count_loop(
  const n: count,
  const a: type,
  cursor: layout.core.IndexCursor(n),
  xs: CompactArray(n, a),
  const pred: fn(x: a) -> bool,
  total: i32
) -> i32 {
  let xs_for_len = xs;
let xs_for_value = xs;
  let xs_item = xs_for_value;
let xs_next = xs_for_value;
  let total_next = total;
let total_finish = total;
  let total_false = total_finish;
let total_done = total_finish;
  match layout.core.IndexCursor.next(n, cursor) {
    Yield(i, next) => match i < xs_for_len.len {
      true => CompactArray.count_loop(n, a, next, xs_next, pred, total_next + (match pred(xs_item.items[i]) { true => 1, false => 0 })),
      false => total_false,
    },
    Done => total_done,
  }
}

fn CompactArray.Iter(const n: count, const a: type, xs: CompactArray(n, a)) -> CompactIter(n, a) {
  CompactIter {source: xs}
}

fn RangeIter.fold_loop(i: i32, end: i32, acc: i32, const f: fn(acc: i32, x: i32) -> i32) -> i32 {
  let acc_then = acc;
let acc_else = acc;
  match i < end {
    true => RangeIter.fold_loop(i + 1, end, f(acc_then, i), f),
    false => acc_else,
  }
}

fn RangeIter.fold(xs: RangeIter, init: i32, const f: fn(acc: i32, x: i32) -> i32) -> i32 {
  RangeIter.fold_loop(xs.source.start, xs.source.end, init, f)
}

fn RangeIter.count(xs: RangeIter) -> i32 {
  match xs.source.start < xs.source.end {
    true => xs.source.end - xs.source.start,
    false => 0,
  }
}

fn RangeIter.sum(xs: RangeIter) -> i32 {
  RangeIter.fold(xs, 0, range_sum_step)
}

fn RangeIter.product(xs: RangeIter) -> i32 {
  RangeIter.fold(xs, 1, range_product_step)
}

fn range_sum_step(acc: i32, x: i32) -> i32 {
  acc + x
}

fn range_product_step(acc: i32, x: i32) -> i32 {
  acc * x
}

fn map4_scalar_i32(const f: fn(x: layout.core.ScalarI32) -> layout.core.ScalarI32, x: layout.core.ScalarI32) -> layout.core.ScalarI32 {
  f(f(f(f(x))))
}

fn zip_with4_scalar_i32(
  const f: fn(a: layout.core.ScalarI32, b: layout.core.ScalarI32) -> layout.core.ScalarI32,
  x: layout.core.ScalarI32,
  y0: layout.core.ScalarI32,
  y1: layout.core.ScalarI32,
  y2: layout.core.ScalarI32,
  y3: layout.core.ScalarI32
) -> layout.core.ScalarI32 {
  f(f(f(f(x, y0), y1), y2), y3)
}
