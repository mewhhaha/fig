const layout = @import("prelude.layout");

type fn vec2_i32() -> type {
  let Vec2I32 = [x: i32, y: i32];
  struct(Vec2I32)
}

type fn vec3_i32() -> type {
  let Vec3I32 = [x: i32, y: i32, z: i32];
  struct(Vec3I32)
}

type fn color_rgba8() -> type {
  let ColorRgba8 = [r: i32, g: i32, b: i32, a: i32];
  struct(ColorRgba8)
}

type fn vertex2d_i32() -> type {
  let Vertex2dI32 = [x: i32, y: i32, z: i32, u: i32, v: i32, rgba: i32];
  struct(Vertex2dI32)
}

type fn quad2d_i32() -> type {
  layout.inline_array(4, vertex2d_i32)
}

type fn mesh_quad_i32() -> type {
  let MeshQuadI32 = [vertices: quad2d_i32];
  struct(MeshQuadI32)
}

type fn geometry2d_i32() -> type {
  let Geometry2dI32 = [vertices: quad2d_i32, vertex_count: i32];
  struct(Geometry2dI32)
}

fn vec2(x: i32, y: i32) -> vec2_i32 {
  Vec2I32 [x: x, y: y]
}

fn vec3(x: i32, y: i32, z: i32) -> vec3_i32 {
  Vec3I32 [x: x, y: y, z: z]
}

fn rgba8(r: i32, g: i32, b: i32, a: i32) -> i32 {
  r + (g * 256) + (b * 65536) + (a * 16777216)
}

fn vertex2d(pos: vec3_i32, uv: vec2_i32, color: i32) -> vertex2d_i32 {
  Vertex2dI32 [x: pos.x, y: pos.y, z: pos.z, u: uv.x, v: uv.y, rgba: color]
}




fn quad2d_rect(x: i32, y: i32, w: i32, h: i32, z: i32, color: i32) -> quad2d_i32 {
  let x0, x_for_w = fork(x);
  let y0, y_for_h = fork(y);
  let x1 = x_for_w + w;
  let y1 = y_for_h + h;
  let x00, x03 = fork(x0);
  let x11, x12 = fork(x1);
  let y00, y01 = fork(y0);
  let y12, y13 = fork(y1);
  let z01, z23 = fork(z);
  let z0, z1 = fork(z01);
  let z2, z3 = fork(z23);
  let color01, color23 = fork(color);
  let color0, color1 = fork(color01);
  let color2, color3 = fork(color23);
  [
    vertex2d(vec3(x00, y00, z0), vec2(0, 0), color0),
    vertex2d(vec3(x11, y01, z1), vec2(1, 0), color1),
    vertex2d(vec3(x12, y12, z2), vec2(1, 1), color2),
    vertex2d(vec3(x03, y13, z3), vec2(0, 1), color3)
  ]
}

fn quad2d_translate(q: quad2d_i32, dx: i32, dy: i32, dz: i32) -> quad2d_i32 {
  [
    Vertex2dI32 [x: q[0].x + dx, y: q[0].y + dy, z: q[0].z + dz, u: q[0].u, v: q[0].v, rgba: q[0].rgba],
    Vertex2dI32 [x: q[1].x + dx, y: q[1].y + dy, z: q[1].z + dz, u: q[1].u, v: q[1].v, rgba: q[1].rgba],
    Vertex2dI32 [x: q[2].x + dx, y: q[2].y + dy, z: q[2].z + dz, u: q[2].u, v: q[2].v, rgba: q[2].rgba],
    Vertex2dI32 [x: q[3].x + dx, y: q[3].y + dy, z: q[3].z + dz, u: q[3].u, v: q[3].v, rgba: q[3].rgba]
  ]
}

fn emit_quad2d(q: quad2d_i32) -> geometry2d_i32 {
  Geometry2dI32 [vertices: q, vertex_count: 4]
}

fn emit_rect2d(x: i32, y: i32, w: i32, h: i32, z: i32, color: i32) -> geometry2d_i32 {
  emit_quad2d(quad2d_rect(x, y, w, h, z, color))
}
