const asset = @import("web.asset");

const canvas_init = @external("canvas_init", fn(
  host: io,
  target: i32,
  width: i32,
  height: i32
) -> io(i32));
const gpu_create_shader = @external("gpu_create_shader", fn(host: io, shader_id: i32) -> io(i32));
const gpu_create_pipeline = @external("gpu_create_pipeline", fn(host: io, shader: i32, layout: i32) -> io(i32));
const gpu_upload_vertices = @external("gpu_upload_vertices", fn(
  host: io,
  buffer: i32,
  ptr: i32,
  byte_len: i32
) -> io(i32));
const gpu_draw_quads = @external("gpu_draw_quads", fn(
  host: io,
  pipeline: i32,
  vertices: i32,
  quad_count: i32
) -> io(i32));
const gpu_begin_frame = @external("gpu_begin_frame", fn(
  host: io,
  target: i32,
  width: i32,
  height: i32
) -> io(i32));
const gpu_draw_rect = @external("gpu_draw_rect", fn(
  host: io,
  canvas: i32,
  x: i32,
  y: i32,
  w: i32,
  h: i32,
  z: i32,
  color: i32
) -> io(i32));
const gpu_draw_sprite = @external("gpu_draw_sprite", fn(
  host: io,
  canvas: i32,
  atlas: i32,
  sx: i32,
  sy: i32,
  sw: i32,
  sh: i32,
  dx: i32,
  dy: i32,
  dw: i32,
  dh: i32,
  flip_x: i32,
  z: i32
) -> io(i32));
const gpu_present = @external("gpu_present", fn(host: io, canvas: i32) -> io(i32));
const event_poll = @external("event_poll", fn(host: io, ptr: i32, capacity: i32) -> io(i32));

type fn Rect2d() -> type {
  let Rect2d = {
    x: i32,
    y: i32,
    z: i32,
    w: i32,
    h: i32,
    color: i32
  };
  struct(Rect2d)
}

fn draw_rect(host: io, canvas: i32, rect: Rect2d) -> i32 {
  gpu_draw_rect(
    host,
    canvas,
    rect.x,
    rect.y,
    rect.w,
    rect.h,
    rect.z,
    rect.color
  )
}

type fn SpriteDraw2d() -> type {
  let SpriteDraw2d = {
    atlas: asset.Handle(#texture),
    sx: i32,
    sy: i32,
    sw: i32,
    sh: i32,
    dx: i32,
    dy: i32,
    dw: i32,
    dh: i32,
    flip_x: i32,
    z: i32
  };
  struct(SpriteDraw2d)
}

fn draw_sprite(host: io, canvas: i32, sprite: SpriteDraw2d) -> i32 {
  gpu_draw_sprite(
    host,
    canvas,
    asset.id(sprite.atlas),
    sprite.sx,
    sprite.sy,
    sprite.sw,
    sprite.sh,
    sprite.dx,
    sprite.dy,
    sprite.dw,
    sprite.dh,
    sprite.flip_x,
    sprite.z
  )
}

fn texture(id: i32) -> asset.Handle(#texture) {
  asset.handle(#texture, id)
}

type fn ShaderSource(source: string) -> type {
  string
}

type fn ShaderLayout(source: string) -> type {
  @wgsl_bindings(source)
}

fn shader_id(const source: string) -> i32 {
  @wgsl_shader_id(source)
}

type fn EventRecord() -> type {
  let EventRecord = {
    kind: i32,
    target: i32,
    code: i32,
    x: i32,
    y: i32,
    delta_x: i32,
    delta_y: i32,
    flags: i32
  };
  struct(EventRecord)
}

const event_key_down: i32 = 1;
const event_key_up: i32 = 2;
const event_pointer_move: i32 = 3;
const event_pointer_down: i32 = 4;
const event_pointer_up: i32 = 5;
const event_wheel: i32 = 6;
const event_resize: i32 = 7;
const event_record_size: i32 = 32;

fn event_kind(event: EventRecord) -> i32 {
  event.kind
}

fn event_target(event: EventRecord) -> i32 {
  event.target
}

fn event_code(event: EventRecord) -> i32 {
  event.code
}

fn event_x(event: EventRecord) -> i32 {
  event.x
}

fn event_y(event: EventRecord) -> i32 {
  event.y
}

fn event_delta_x(event: EventRecord) -> i32 {
  event.delta_x
}

fn event_delta_y(event: EventRecord) -> i32 {
  event.delta_y
}

fn event_flags(event: EventRecord) -> i32 {
  event.flags
}
