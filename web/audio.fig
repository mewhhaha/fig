const asset = @import("web.asset");

const audio_play: fn(sound_id: i32) -> i32 !{audio} = @effect("audio_play");
const audio_music: fn(track_id: i32, enabled: i32) -> i32 !{audio} = @effect("audio_music");

fn sound(id: i32) -> asset.Handle(#sound) {
  asset.handle(#sound, id)
}

fn music_track(id: i32) -> asset.Handle(#music) {
  asset.handle(#music, id)
}

fn play(sound_handle: asset.Handle(#sound)) -> i32 !{audio} {
  audio_play(asset.id(sound_handle))
}

fn music(track: asset.Handle(#music), enabled: i32) -> i32 !{audio} {
  audio_music(asset.id(track), enabled)
}
