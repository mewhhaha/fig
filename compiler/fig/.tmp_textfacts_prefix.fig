type CheckedFactKind = enum(i32) {
  CheckedDeclarationType = 1,
  CheckedDiagnostic = 2,
  LoweredDeclaration = 3,
  CheckedDeclarationRecord = 4,
  CheckedExpressionRecord = 5,
  CheckedLocalEnvironment = 6,
  CheckedExpressionShape = 7,
  CheckedExpressionChildRecord = 8,
  LoweredExportRecord = 9,
  WasmFunctionRecord = 10,
  WasmSectionRecord = 11,
  WasmByteRecord = 12
}

type FactRecordScanKind = enum(i32) {
  ScanCheckedDeclaration = 1,
  ScanCheckedExpression = 2,
  ScanCheckedExpressionChild = 3,
  ScanCheckedExpressionShape = 4,
  ScanCheckedLocal = 5,
  ScanLoweredExport = 6
}

type WasmRecordScanKind = enum(i32) {
  ScanWasmFunctionRecord = 1,
  ScanWasmSectionRecord = 2,
  ScanWasmByteRecord = 3
}

type WasmSimpleSegmentKind = enum(i32) {
  Unsupported = 0,
  NumberI32 = 1,
  Bool = 2,
  Identifier = 3
}

type WasmNonBranchSegmentKind = enum(i32) {
  Operator = 1,
  Call = 2,
  Simple = 3
}

type CheckedLocalFactKind = enum(i32) {
  LocalLet = 1,
  LocalTypeAssert = 2
}

type FactContext = struct {
  source: textlex.TextTokenStream,
}

const summary_resolved_declared_type_class =
  textmodel.SummaryKind::ResolvedDeclaredTypeClassSignature;
const summary_resolved_value_body_type_class =
  textmodel.SummaryKind::ResolvedValueBodyTypeClassSignature;
const summary_resolved_simple_body_type_check =
  textmodel.SummaryKind::ResolvedSimpleBodyTypeCheckSignature;
const summary_simple_body_type_check =
  textmodel.SummaryKind::SimpleBodyTypeCheckSignature;
const summary_resolved_declared_abi_class =
  textmodel.SummaryKind::ResolvedDeclaredAbiClassSignature;
const summary_resolved_value_body_abi_class =
  textmodel.SummaryKind::ResolvedValueBodyAbiClassSignature;
const summary_resolved_export_abi =
  textmodel.SummaryKind::ResolvedExportAbiSignature;

