type WasmFunctionBinding = struct {
  name_hash: i32,
  index: i32,
  cursor: i32,
  runtime_param_count: i32,
  local_count: i32,
  expected_type_class: i32,
  actual_type_class: i32,
  body_abi_class: i32,
  result_val_type: i32,
  terminator_opcode: i32,
  diagnostic_code: i32,
  export_tag: i32,
  body_start: i32,
  declaration_limit: i32,
}

type WasmFunctionLookupSlot = struct {
  name_hash: i32,
  index: i32,
  runtime_param_count: i32,
  occupied: bool,
}

type WasmSourceEnv = struct {
  resolution: parser.TextResolutionEnv,
  functions: layout.HeapArray(WasmFunctionBinding),
  lookup_slots: layout.HeapArray(WasmFunctionLookupSlot),
}

type WasmByteContext = struct {
  source: textlex.TextTokenStream,
  base_offset: i32,
  env: WasmSourceEnv,
}

type WasmBindingBody = struct {
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  binding: WasmFunctionBinding,
}

type WasmScalarBody = struct {
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  body_abi: i32,
}

type WasmCurrentBody = struct {
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  decl: ast.Decl,
  body_abi: i32,
}

fn wasm_byte_context(
  source: textlex.TextTokenStream,
  base_offset: i32
) -> WasmByteContext {
  WasmByteContext {
    source: source,
    base_offset: base_offset,
    env: WasmSourceEnv::from_source(source),
  }
}

fn wasm_binding_body(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  binding: WasmFunctionBinding
) -> WasmBindingBody {
  WasmBindingBody {
    context_value,
    codes,
    binding,
  }
}

fn wasm_scalar_body(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  body_abi: i32
) -> WasmScalarBody {
  WasmScalarBody {
    context_value,
    codes,
    current,
    body_abi,
  }
}

fn wasm_current_body(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  decl: ast.Decl,
  body_abi: i32
) -> WasmCurrentBody {
  WasmCurrentBody {
    context_value,
    codes,
    current,
    decl,
    body_abi,
  }
}

fn wasm_byte_context_window_state(
  context_value: WasmByteContext
) -> combinator.ParseState {
  textmodel.full_window_state(context_value.source)
}

fn wasm_function_binding(
  name_hash: i32,
  index: i32,
  cursor: i32,
  runtime_param_count: i32,
  local_count: i32,
  expected_type_class: i32,
  actual_type_class: i32,
  body_abi_class: i32,
  result_val_type: i32,
  terminator_opcode: i32,
  diagnostic_code: i32,
  export_tag: i32,
  body_start: i32,
  declaration_limit: i32
) -> WasmFunctionBinding {
  WasmFunctionBinding {
    name_hash: name_hash,
    index: index,
    cursor: cursor,
    runtime_param_count: runtime_param_count,
    local_count: local_count,
    expected_type_class: expected_type_class,
    actual_type_class: actual_type_class,
    body_abi_class: body_abi_class,
    result_val_type: result_val_type,
    terminator_opcode: terminator_opcode,
    diagnostic_code: diagnostic_code,
    export_tag: export_tag,
    body_start: body_start,
    declaration_limit: declaration_limit,
  }
}

fn WasmSourceEnv::empty(
  source: textlex.TextTokenStream
) -> WasmSourceEnv {
  WasmSourceEnv {
    resolution: parser.TextResolutionEnv::from_source(source),
    functions: layout.HeapArray::empty(WasmFunctionBinding),
    lookup_slots: layout.HeapArray::empty(WasmFunctionLookupSlot),
  }
}

fn WasmSourceEnv::push_function(
  env: WasmSourceEnv,
  binding: WasmFunctionBinding
) -> WasmSourceEnv {
  WasmSourceEnv {
    resolution: env.resolution,
    functions: layout.HeapArray::push(
      WasmFunctionBinding,
      env.functions,
      binding
    ),
    lookup_slots: env.lookup_slots,
  }
}

fn wasm_function_binding_from_decl(
  _env: WasmSourceEnv,
  source: textlex.TextTokenStream,
  current: combinator.ParseState,
  result: combinator.Reply(parser.DeclFrame),
  index: i32,
  runtime_param_count: i32
) -> WasmFunctionBinding {
  let decl = result.value.decl;
  wasm_function_binding(
    parser.text_declaration_name_hash(source, current.cursor, decl),
    index,
    current.cursor,
    runtime_param_count,
    0,
    parser.text_type_class_unknown_tag(),
    parser.text_type_class_unknown_tag(),
    parser.text_abi_class_void_tag(),
    wasm_no_val_type(),
    wasm_drop_opcode(),
    0,
    0,
    current.cursor,
    current.cursor
  )
}

fn wasm_function_binding_with_details(
  context_value: WasmByteContext,
  binding: WasmFunctionBinding
) -> WasmFunctionBinding {
  let source = context_value.source;
  let expected = parser.text_function_return_resolved_type_class_tag(
    source,
    binding.cursor
  );
  let actual = parser.TextResolutionEnv::function_body_resolved_type_class_tag(
    context_value.env.resolution,
    source,
    binding.cursor
  );
  let body_abi = parser.text_abi_class_tag_for_type_class(actual);
  let result_val_type = wasm_val_type_for_abi(
    parser.text_abi_class_tag_for_type_class(expected)
  );
  let terminator_opcode = wasm_terminator_opcode(result_val_type);
  wasm_function_binding(
    binding.name_hash,
    binding.index,
    binding.cursor,
    binding.runtime_param_count,
    parser.text_function_local_let_count(source, binding.cursor),
    expected,
    actual,
    body_abi,
    result_val_type,
    terminator_opcode,
    checked_type_status_diagnostic_code(
      parser.text_simple_body_type_check_status(expected, actual)
    ),
    parser.text_function_public_tag(source, binding.cursor),
    parser.text_function_body_value_start_index(source, binding.cursor),
    parser.text_declaration_end_from_index(source, binding.cursor)
  )
}

fn WasmSourceEnv::add_decl(
  env: WasmSourceEnv,
  source: textlex.TextTokenStream,
  current: combinator.ParseState,
  result: combinator.Reply(parser.DeclFrame),
  function_index: i32
) -> WasmSourceEnv {
  let decl = result.value.decl;
  let kind_tag = parser.text_declaration_kind_tag(source, current.cursor, decl);
  let runtime_param_count = parser.text_function_runtime_param_count(
    source,
    current.cursor
  );
  let is_function_decl = parser.text_declaration_kind_is_function(kind_tag);
  if is_function_decl {
    WasmSourceEnv::push_function(
      env,
      wasm_function_binding_from_decl(
        env,
        source,
        current,
        result,
        function_index,
        runtime_param_count
      )
    )
  } else {
    env
  }
}

fn WasmSourceEnv::next_function_index(
  source: textlex.TextTokenStream,
  current: combinator.ParseState,
  result: combinator.Reply(parser.DeclFrame),
  function_index: i32
) -> i32 {
  let decl = result.value.decl;
  let kind_tag = parser.text_declaration_kind_tag(source, current.cursor, decl);
  let is_function_decl = parser.text_declaration_kind_is_function(kind_tag);
  if is_function_decl {
    function_index + 1
  } else {
    function_index
  }
}

fn WasmSourceEnv::from_source_loop(
  source: textlex.TextTokenStream,
  current: combinator.ParseState,
  function_index: i32,
  env: WasmSourceEnv
) -> WasmSourceEnv {
  if combinator.state_has_more(current) {
    match parser.parse_text_declaration_stream(
      current,
      source,
      function_index
    ) {
      Err(_) => env,
      Ok(result) => rec(
        source,
        parser.next_text_declaration_state(result.state, source),
        WasmSourceEnv::next_function_index(source, current, result, function_index),
        WasmSourceEnv::add_decl(env, source, current, result, function_index)
      ),
    }
  } else {
    env
  }
}

fn wasm_function_lookup_slot_empty() -> WasmFunctionLookupSlot {
  WasmFunctionLookupSlot {
    name_hash: 0,
    index: 0,
    runtime_param_count: 0,
    occupied: false,
  }
}

fn wasm_function_lookup_slot_from_binding(
  binding: WasmFunctionBinding
) -> WasmFunctionLookupSlot {
  WasmFunctionLookupSlot {
    name_hash: binding.name_hash,
    index: binding.index,
    runtime_param_count: binding.runtime_param_count,
    occupied: true,
  }
}

fn wasm_lookup_slot_count(function_count: i32) -> i32 {
  if function_count <= 0 {
    1
  } else {
    function_count * 2 + 1
  }
}

fn wasm_lookup_slots_empty_loop(
  slots: layout.HeapArray(WasmFunctionLookupSlot),
  index: i32,
  count: i32
) -> layout.HeapArray(WasmFunctionLookupSlot) {
  if index >= count {
    slots
  } else {
    rec(
      layout.HeapArray::push(
        WasmFunctionLookupSlot,
        slots,
        wasm_function_lookup_slot_empty()
      ),
      index + 1,
      count
    )
  }
}

fn wasm_lookup_slots_empty(
  count: i32
) -> layout.HeapArray(WasmFunctionLookupSlot) {
  wasm_lookup_slots_empty_loop(
    layout.HeapArray::empty(WasmFunctionLookupSlot),
    0,
    count
  )
}

fn wasm_positive_mod(value: i32, modulus: i32) -> i32 {
  let raw = value % modulus;
  if raw < 0 {
    raw + modulus
  } else {
    raw
  }
}

fn wasm_lookup_next_slot(slot: i32, slot_count: i32) -> i32 {
  if slot + 1 >= slot_count {
    0
  } else {
    slot + 1
  }
}

fn wasm_lookup_probe_exhausted(probes: i32, slot_count: i32) -> bool {
  probes >= slot_count
}

fn wasm_lookup_slot_matches(
  current: WasmFunctionLookupSlot,
  binding: WasmFunctionBinding
) -> bool {
  current.name_hash == binding.name_hash
}

fn wasm_lookup_slot_replaces_binding(
  current: WasmFunctionLookupSlot,
  binding: WasmFunctionBinding
) -> bool {
  if current.occupied {
    wasm_lookup_slot_matches(current, binding)
  } else {
    true
  }
}

fn wasm_lookup_slot_insert_at(
  slots: layout.HeapArray(WasmFunctionLookupSlot),
  binding: WasmFunctionBinding,
  slot: i32,
  probes: i32
) -> layout.HeapArray(WasmFunctionLookupSlot) {
  let slot_count = layout.HeapArray::len(WasmFunctionLookupSlot, slots);
  if wasm_lookup_probe_exhausted(probes, slot_count) {
    slots
  } else {
    layout.HeapArray::get(
      WasmFunctionLookupSlot,
      slots,
      slot
    ) \current -> if wasm_lookup_slot_replaces_binding(current, binding) {
      layout.HeapArray::set(
        WasmFunctionLookupSlot,
        slots,
        slot,
        wasm_function_lookup_slot_from_binding(binding)
      )
    } else {
      rec(
        slots,
        binding,
        wasm_lookup_next_slot(slot, slot_count),
        probes + 1
      )
    }
  }
}

fn wasm_lookup_slot_insert(
  slots: layout.HeapArray(WasmFunctionLookupSlot),
  binding: WasmFunctionBinding
) -> layout.HeapArray(WasmFunctionLookupSlot) {
  let slot_count = layout.HeapArray::len(WasmFunctionLookupSlot, slots);
  wasm_lookup_slot_insert_at(
    slots,
    binding,
    wasm_positive_mod(binding.name_hash, slot_count),
    0
  )
}

fn WasmSourceEnv::build_lookup_slots_loop(
  env: WasmSourceEnv,
  slots: layout.HeapArray(WasmFunctionLookupSlot),
  index: i32
) -> layout.HeapArray(WasmFunctionLookupSlot) {
  if index >= layout.HeapArray::len(WasmFunctionBinding, env.functions) {
    slots
  } else {
    layout.HeapArray::get(
      WasmFunctionBinding,
      env.functions,
      index
    ) \binding -> rec(
      env,
      wasm_lookup_slot_insert(slots, binding),
      index + 1
    )
  }
}

fn WasmSourceEnv::with_lookup_slots(env: WasmSourceEnv) -> WasmSourceEnv {
  let function_count = layout.HeapArray::len(WasmFunctionBinding, env.functions);
  let slots = wasm_lookup_slots_empty(wasm_lookup_slot_count(function_count));
  WasmSourceEnv {
    resolution: env.resolution,
    functions: env.functions,
    lookup_slots: WasmSourceEnv::build_lookup_slots_loop(env, slots, 0),
  }
}

fn WasmSourceEnv::from_source(source: textlex.TextTokenStream) -> WasmSourceEnv {
  WasmSourceEnv::with_lookup_slots(
    WasmSourceEnv::from_source_loop(
      source,
      textmodel.full_window_state(source),
      0,
      WasmSourceEnv::empty(source)
    )
  )
}

fn WasmSourceEnv::lookup_function_loop(
  env: WasmSourceEnv,
  target_hash: i32,
  index: i32
) -> WasmFunctionLookup {
  if index < 0 {
    wasm_function_lookup_missing()
  } else {
    layout.HeapArray::get(
      WasmFunctionBinding,
      env.functions,
      index
    ) \binding -> if binding.name_hash == target_hash {
      WasmFunctionLookup {
        index: binding.index,
        runtime_param_count: binding.runtime_param_count,
        found: true,
      }
    } else {
      rec(env, target_hash, index - 1)
    }
  }
}

fn WasmSourceEnv::lookup_function_slot(
  env: WasmSourceEnv,
  target_hash: i32,
  slot: i32,
  probes: i32
) -> WasmFunctionLookup {
  let slot_count = layout.HeapArray::len(WasmFunctionLookupSlot, env.lookup_slots);
  if wasm_lookup_probe_exhausted(probes, slot_count) {
    wasm_function_lookup_missing()
  } else {
    layout.HeapArray::get(
      WasmFunctionLookupSlot,
      env.lookup_slots,
      slot
    ) \current -> if current.occupied {
      if current.name_hash == target_hash {
        WasmFunctionLookup {
          index: current.index,
          runtime_param_count: current.runtime_param_count,
          found: true,
        }
      } else {
        rec(
          env,
          target_hash,
          wasm_lookup_next_slot(slot, slot_count),
          probes + 1
        )
      }
    } else {
      wasm_function_lookup_missing()
    }
  }
}

fn wasm_function_lookup_has_target(target_hash: i32) -> bool {
  target_hash != 0
}

fn wasm_lookup_slots_available(env: WasmSourceEnv) -> bool {
  layout.HeapArray::len(WasmFunctionLookupSlot, env.lookup_slots) > 0
}

fn WasmSourceEnv::lookup_function(
  env: WasmSourceEnv,
  target_hash: i32
) -> WasmFunctionLookup {
  if wasm_function_lookup_has_target(target_hash) {
    if wasm_lookup_slots_available(env) {
      WasmSourceEnv::lookup_function_slot(
        env,
        target_hash,
        wasm_positive_mod(
          target_hash,
          layout.HeapArray::len(WasmFunctionLookupSlot, env.lookup_slots)
        ),
        0
      )
    } else {
      WasmSourceEnv::lookup_function_loop(
        env,
        target_hash,
        layout.HeapArray::len(WasmFunctionBinding, env.functions) - 1
      )
    }
  } else {
    wasm_function_lookup_missing()
  }
}

type WasmCallLowering = struct {
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  runtime_param_count: i32,
  local_count: i32,
}

type WasmSegmentBody = struct {
  lowering: WasmCallLowering,
  start: i32,
  limit: i32,
  parts: parser.TextRootOperatorParts,
}

type WasmBytePayloadKind = enum(i32) {
  TypePayload = 1,
  FunctionPayload = 2,
  ExportPayload = 3,
  CodePayload = 4
}

type WasmBytePayloadState = struct {
  kind: WasmBytePayloadKind,
  current: combinator.ParseState,
  function_index: i32,
}

fn wasm_payload_state_reader(
  kind: WasmBytePayloadKind
) -> monad.Reader(WasmByteContext, WasmBytePayloadState) {
  do @monad(monad.Reader(WasmByteContext, _)) {
    current <- monad.Reader::asks(wasm_byte_context_window_state);
    monad.Reader::pure(WasmBytePayloadState {
      kind: kind,
      current: current,
      function_index: 0,
    })
  }
}

fn WasmByteContext::payload_state(
  context_value: WasmByteContext,
  kind: WasmBytePayloadKind
) -> WasmBytePayloadState {
  monad.Reader::run(
    wasm_payload_state_reader(kind),
    context_value
  )
}

fn context(source: textlex.TextTokenStream) -> FactContext {
  FactContext {source: source}
}

fn fact_context_source(context_value: FactContext) -> textlex.TextTokenStream {
  context_value.source
}

fn FactContext::summary(
  context_value: FactContext,
  kind: textmodel.SummaryKind
) -> i32 {
  monad.Reader::run(fact_summary_reader(kind), context_value)
}

fn fact_context_window_state(
  context_value: FactContext
) -> combinator.ParseState {
  textmodel.full_window_state(fact_context_source(context_value))
}

fn fact_pair_signature(
  kind: CheckedFactKind,
  first: i32,
  second: i32
) -> i32 {
  let with_kind = textmodel.signature_mix(kind, first);
  textmodel.signature_mix(with_kind, second)
}

fn fact_triple_signature(
  kind: CheckedFactKind,
  first: i32,
  second: i32,
  third: i32
) -> i32 {
  let with_pair = fact_pair_signature(kind, first, second);
  textmodel.signature_mix(with_pair, third)
}

fn fact_summary_reader(kind: textmodel.SummaryKind) -> monad.Reader(FactContext, i32) {
  do @monad(monad.Reader(FactContext, _)) {
    source <- monad.Reader::asks(fact_context_source);
    monad.Reader::pure(textsummary.run(source, kind, 0))
  }
}

fn checked_declaration_type_signature_reader() -> monad.Reader(FactContext, i32) {
  do @monad(monad.Reader(FactContext, _)) {
    declared <- fact_summary_reader(
      summary_resolved_declared_type_class
    );
    body <- fact_summary_reader(
      summary_resolved_value_body_type_class
    );
    check <- fact_summary_reader(
      summary_resolved_simple_body_type_check
    );
    monad.Reader::pure(
      fact_triple_signature(
        CheckedFactKind::CheckedDeclarationType,
        declared,
        body,
        check
      )
    )
  }
}

fn checked_diagnostic_signature_reader() -> monad.Reader(FactContext, i32) {
  do @monad(monad.Reader(FactContext, _)) {
    declared <- fact_summary_reader(
      summary_simple_body_type_check
    );
    resolved <- fact_summary_reader(
      summary_resolved_simple_body_type_check
    );
    monad.Reader::pure(
      fact_pair_signature(
        CheckedFactKind::CheckedDiagnostic,
        declared,
        resolved
      )
    )
  }
}

fn lowered_declaration_signature_reader() -> monad.Reader(FactContext, i32) {
  do @monad(monad.Reader(FactContext, _)) {
    declared <- fact_summary_reader(
      summary_resolved_declared_abi_class
    );
    body <- fact_summary_reader(
      summary_resolved_value_body_abi_class
    );
    exports <- fact_summary_reader(
      summary_resolved_export_abi
    );
    monad.Reader::pure(
      fact_triple_signature(
        CheckedFactKind::LoweredDeclaration,
        declared,
        body,
        exports
      )
    )
  }
}

fn fact_record_signature_reader(
  kind: FactRecordScanKind
) -> monad.Reader(FactContext, i32) {
  do @monad(monad.Reader(FactContext, _)) {
    context_value <- monad.Reader::ask();
    current <- monad.Reader::asks(fact_context_window_state);
    monad.Reader::pure(
      FactContext::fact_record_scan(context_value, kind, current, 0)
    )
  }
}

fn checked_type_status_diagnostic_code(status: i32) -> i32 {
  let is_mismatch = status == parser.text_type_check_mismatch_tag();
  if is_mismatch {
    diagnostic.code_score(diagnostic.CodeTypeMismatch)
  } else {
    0
  }
}

fn checked_decl_fact(
  source: textlex.TextTokenStream,
  current: combinator.ParseState,
  result: combinator.Reply(parser.DeclFrame)
) -> CheckedDeclFact {
  let decl = result.value.decl;
  let kind_tag = parser.text_declaration_kind_tag(
    source,
    current.cursor,
    decl
  );
  let name_hash = parser.text_declaration_name_hash(source, current.cursor, decl);
  let expected = parser.text_declaration_resolved_expected_body_type_class_tag(
    source,
    current.cursor,
    decl
  );
  let actual = parser.text_declaration_resolved_value_body_type_class_tag(
    source,
    current.cursor,
    decl
  );
  let check_status = parser.text_simple_body_type_check_status(expected, actual);
  CheckedDeclFact {
    kind_tag: kind_tag,
    name_hash: name_hash,
    symbol_type_class: parser.text_declaration_resolved_type_class_tag(
      source,
      current.cursor,
      decl
    ),
    symbol_payload: parser.text_declaration_resolved_type_class_payload(
      source,
      current.cursor,
      decl
    ),
    expected_type_class: expected,
    actual_type_class: actual,
    check_status: check_status,
    diagnostic_code: checked_type_status_diagnostic_code(check_status),
    lowered_abi_class: parser.text_declaration_resolved_abi_class_tag(
      source,
      current.cursor,
      decl
    ),
  }
}

fn checked_decl_fact_with_env(
  source: textlex.TextTokenStream,
