fn text_root_call_direct_import_return_type_class_for_hash_between(
  context: TextDirectImportContext,
  index: i32,
  limit: i32,
  target_hash: i32
) -> i32 {
  let call_open = text_expression_root_call_open_between(
    context.source,
    index,
    limit
  );
  let head_limit = match call_open < limit {
    true => call_open,
    false => limit,
  };
  let operator_count = text_expression_root_operator_count_between(
    context.source,
    index,
    head_limit
  ) + text_expression_root_call_tail_operator_count_between(
    context.source,
    index,
    limit
  );
  let selector_count = text_expression_root_head_selector_count_between(
    context.source,
    index,
    head_limit
  );
  let field_count = text_expression_root_call_tail_field_count_between(
    context.source,
    index,
    limit
  );
  let pipe_bind_count = text_value_pipe_bind_count_between(
    context.source,
    index,
    limit,
    0
  );
  let call_arg_count = text_expression_root_call_arg_count_between(
    context.source,
    index,
    limit
  );
  match operator_count > 0 {
    true => text_type_class_unknown_tag(),
    false => match selector_count > 0 {
      true => text_type_class_unknown_tag(),
      false => match field_count > 0 {
        true => text_type_class_unknown_tag(),
        false => match pipe_bind_count > 0 {
          true => text_type_class_unknown_tag(),
          false => match call_arg_count == text_no_root_call_arg_count() {
            true => text_type_class_unknown_tag(),
            false => text_function_return_direct_import_type_class_for_hash(
              context,
              target_hash
            ),
          },
        },
      },
    },
  }
}

fn text_function_return_direct_import_type_class_for_hash_scan(
  context: TextDirectImportContext,
  scan: TextNamedTypeLookupScan
) -> i32 {
  if scan.index >= scan.limit {
    text_type_class_unknown_tag()
  } else {
    let is_top_declaration = is_text_top_level_declaration_start(
      context.source,
      scan.index,
      scan.brace_depth,
      scan.paren_depth
    );
    let is_function = match is_top_declaration {
      true => text_declaration_kind_tag(
        context.source,
        scan.index,
        ast.empty_decl()
      ) == 1,
      false => false,
    };
    let found = match is_function {
      true => textlex.text_hash_at(
        context.source,
        text_declaration_name_index(context.source, scan.index, ast.empty_decl())
      ) == scan.target_hash,
      false => false,
    };
    match found {
      true => text_function_return_direct_import_resolved_type_class_tag(
        context.source,
        context.import_source,
        scan.index,
        context.alias_hash
      ),
      false => text_function_return_direct_import_type_class_for_hash_scan(
        context,
        TextNamedTypeLookupScan {
          index: scan.index + 1,
          limit: scan.limit,
          brace_depth: brace_depth_after_token(
            context.source,
            scan.index,
            scan.brace_depth
          ),
          paren_depth: paren_depth_after_token(
            context.source,
            scan.index,
            scan.paren_depth
          ),
          target_hash: scan.target_hash,
          depth: scan.depth,
        }
      ),
    }
  }
}

