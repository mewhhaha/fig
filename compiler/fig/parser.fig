    ),
    29 => text_declaration_resolved_simple_body_type_check_signature_total(
      source,
      index,
      decl,
      total
    ),
    40 => text_declaration_value_operator_signature_delta(
      source,
      index,
      decl,
      total
    ),
    _ => total + text_declaration_summary_delta(
      context.summary_kind,
      context.summary_arg,
      source,
      index,
      decl
    ),
  }
}

fn text_declaration_summary_total_for_slice(
  slice: textmodel.DeclSlice,
  context: TextSummaryContext,
  total: i32
) -> i32 {
  text_declaration_summary_total(
    slice.source,
    slice.start,
    slice.decl,
    context,
    total
  )
}

