    text_direct_import_decl_context(context, index, decl)
  )
}

fn text_declaration_direct_import_resolved_value_body_signature_total_reader(
  total: i32
) -> monad.Reader(TextDirectImportDeclarationContext, i32) {
  do @monad(monad.Reader(TextDirectImportDeclarationContext, _)) {
    import_context <- monad.Reader::asks(text_direct_import_decl_import_context);
    index <- monad.Reader::asks(text_direct_import_decl_index);
    decl <- monad.Reader::asks(text_direct_import_decl_decl);
    pure(match is_text_external_import_start(import_context.source, index) {
      true => total,
      false => text_declaration_kind_tag(
        import_context.source,
        index,
        decl
      ) \kind_tag -> text_declaration_direct_import_resolved_value_body_type_class_tag(
        import_context,
        index,
        decl
      ) \type_class -> match textmodel.import_resolution_mode_is_abi(
        import_context.mode
      ) {
        true => text_signature_mix(
          total,
          text_value_body_abi_class_hash(
            kind_tag,
            text_abi_class_tag_for_type_class(type_class)
          )
        ),
        false => text_signature_mix(
          total,
          text_value_body_type_class_hash(kind_tag, type_class)
        ),
      },
    })
  }
}

