}

fn text_declaration_function_local_let_total(
  source: textlex.TextTokenStream,
  index: i32,
  total: i32
) -> i32 {
  match is_text_function_declaration_start(source, index) {
    true => total + text_function_local_let_count(source, index),
    false => total,
  }
}

fn text_declaration_function_local_type_assert_delta(
  source: textlex.TextTokenStream,
  index: i32,
  _decl: ast.Decl
) -> i32 {
  match is_text_function_declaration_start(source, index) {
    true => text_function_local_type_assert_count(source, index),
    false => 0,
  }
}

fn text_type_class_unknown_tag() -> i32 {
  0
}

fn text_type_class_i32_tag() -> i32 {
  1
}

fn text_type_class_bool_tag() -> i32 {
  2
}

fn text_type_class_function_tag() -> i32 {
  3
}

fn text_type_class_product_tag() -> i32 {
  4
}

fn text_type_class_union_tag() -> i32 {
  5
}

fn text_type_class_type_value_tag() -> i32 {
  6
}

fn text_type_class_is_scalar(type_class: i32) -> bool {
  match type_class == text_type_class_i32_tag() {
    true => true,
    false => type_class == text_type_class_bool_tag(),
  }
}

fn text_operator_hash_plus() -> i32 {
  textlex.TextCharCode::Plus
}

fn text_operator_hash_minus() -> i32 {
  textlex.TextCharCode::Minus
}

fn text_operator_hash_asterisk() -> i32 {
  textlex.TextCharCode::Asterisk
}

fn text_operator_hash_slash() -> i32 {
  textlex.TextCharCode::Slash
}

fn text_operator_hash_percent() -> i32 {
  37
}

fn text_operator_hash_less() -> i32 {
  textlex.TextCharCode::Less
}

fn text_operator_hash_greater() -> i32 {
  textlex.TextCharCode::Greater
}

fn text_operator_hash_two(first: i32, second: i32) -> i32 {
  first * 33 + second
}

fn text_operator_hash_equal_equal() -> i32 {
  text_operator_hash_two(textlex.TextCharCode::Equal, textlex.TextCharCode::Equal)
}

fn text_operator_hash_less_equal() -> i32 {
  text_operator_hash_two(textlex.TextCharCode::Less, textlex.TextCharCode::Equal)
}

fn text_operator_hash_greater_equal() -> i32 {
  text_operator_hash_two(textlex.TextCharCode::Greater, textlex.TextCharCode::Equal)
}

fn text_operator_hash_not_equal() -> i32 {
  text_operator_hash_two(textlex.TextCharCode::Bang, textlex.TextCharCode::Equal)
}

fn text_annotation_type_class_tag_from_hash(value_hash: i32) -> i32 {
  match value_hash == 116078 {
    true => text_type_class_i32_tag(),
    false => match value_hash == 3646476 {
      true => text_type_class_bool_tag(),
      false => match value_hash == 3476 {
        true => text_type_class_function_tag(),
        false => text_type_class_unknown_tag(),
      },
    },
  }
}

fn text_annotation_type_class_tag_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  match index >= limit {
    true => text_type_class_unknown_tag(),
    false => match text_param_signature_is_trivia(source, index) {
      true => text_annotation_type_class_tag_between(
        source,
        index + 1,
        limit
      ),
      false => text_annotation_type_class_tag_from_hash(
        textlex.text_hash_at(source, index)
      ),
    },
  }
}

fn text_function_return_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  let arrow = text_function_arrow_index(source, close_paren, next);
  let left_brace = text_function_left_brace_index(source, arrow, next);
  let body_start = text_function_body_start_index(source, arrow, left_brace);
  text_annotation_type_class_tag_between(source, arrow + 1, body_start)
}

fn text_value_annotation_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let equal = text_find_top_level_punctuation_score(
    source,
    index + 2,
    next,
    0,
    1
  );
  let colon = text_find_top_level_punctuation_score(
    source,
    index + 2,
    equal,
    0,
    8
  );
  match colon < equal {
    true => text_annotation_type_class_tag_between(source, colon + 1, equal),
    false => text_type_class_unknown_tag(),
  }
}

fn text_type_result_kind_type_class_tag(kind_tag: i32) -> i32 {
  match kind_tag == text_type_result_kind_struct_tag() {
    true => text_type_class_product_tag(),
    false => match kind_tag == text_type_result_kind_union_tag() {
      true => text_type_class_union_tag(),
      false => text_type_class_type_value_tag(),
    },
  }
}

fn text_declaration_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  match text_declaration_kind_tag(source, index, decl) {
    1 => text_type_class_function_tag(),
    2 => text_value_annotation_type_class_tag(source, index),
    3 => text_value_annotation_type_class_tag(source, index),
    4 => text_type_result_kind_type_class_tag(text_type_result_kind_tag(source, index)),
    _ => text_type_class_unknown_tag(),
  }
}

fn text_declaration_type_class_payload(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  match text_declaration_kind_tag(source, index, decl) {
    1 => ast.decl_param_count(decl) * 31 + text_function_return_type_class_tag(source, index),
    _ => 0,
  }
}

fn text_declared_type_class_hash(
  kind_tag: i32,
  type_class: i32,
  payload: i32
) -> i32 {
  text_signature_mix(
    text_signature_mix(
      text_signature_mix(17, kind_tag),
      type_class
    ),
    payload
  )
}

fn text_abi_class_void_tag() -> i32 {
  0
}

fn text_abi_class_scalar_tag() -> i32 {
  1
}

fn text_abi_class_handle_tag() -> i32 {
  2
}

fn text_abi_class_function_tag() -> i32 {
  3
}

fn text_abi_class_tag_for_type_class(type_class: i32) -> i32 {
  match type_class == text_type_class_i32_tag() {
    true => text_abi_class_scalar_tag(),
    false => match type_class == text_type_class_bool_tag() {
      true => text_abi_class_scalar_tag(),
      false => match type_class == text_type_class_function_tag() {
        true => text_abi_class_function_tag(),
        false => match type_class == text_type_class_product_tag() {
          true => text_abi_class_handle_tag(),
          false => match type_class == text_type_class_union_tag() {
            true => text_abi_class_handle_tag(),
            false => text_abi_class_void_tag(),
          },
        },
      },
    },
  }
}

fn text_declaration_declared_abi_class_tag(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  match text_declaration_kind_tag(source, index, decl) {
    1 => text_abi_class_function_tag(),
    2 => text_abi_class_tag_for_type_class(
      text_value_annotation_type_class_tag(source, index)
    ),
    3 => text_abi_class_tag_for_type_class(
      text_value_annotation_type_class_tag(source, index)
    ),
    4 => text_abi_class_tag_for_type_class(
      text_type_result_kind_type_class_tag(text_type_result_kind_tag(source, index))
    ),
    _ => text_abi_class_void_tag(),
  }
}

fn text_declared_abi_class_hash(kind_tag: i32, abi_class: i32) -> i32 {
  text_signature_mix(
    text_signature_mix(17, kind_tag),
    abi_class
  )
}

fn text_symbol_environment_hash(
  kind_tag: i32,
  name_hash: i32,
  type_class: i32,
  payload: i32,
  abi_class: i32
) -> i32 {
  text_signature_mix(
    text_signature_mix(
      text_signature_mix(
        text_signature_mix(
          text_signature_mix(23, kind_tag),
          name_hash
        ),
        type_class
      ),
      payload
    ),
    abi_class
  )
}

fn text_export_abi_hash(
  name_hash: i32,
  param_count: i32,
  return_abi_class: i32
) -> i32 {
  text_signature_mix(
    text_signature_mix(
      text_signature_mix(29, name_hash),
      param_count
    ),
    return_abi_class
  )
}

fn text_declaration_declared_type_class_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  text_signature_mix(
    total,
    text_declared_type_class_hash(
      kind_tag,
      text_declaration_type_class_tag(source, index, decl),
      text_declaration_type_class_payload(source, index, decl)
    )
  )
}

fn text_declaration_declared_abi_class_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  text_signature_mix(
    total,
    text_declared_abi_class_hash(
      kind_tag,
      text_declaration_declared_abi_class_tag(source, index, decl)
    )
  )
}

fn text_declaration_symbol_environment_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  let name_index = text_declaration_name_index(source, index, decl);
  text_signature_mix(
    total,
    text_symbol_environment_hash(
      kind_tag,
      textlex.text_hash_at(source, name_index),
      text_declaration_type_class_tag(source, index, decl),
      text_declaration_type_class_payload(source, index, decl),
      text_declaration_declared_abi_class_tag(source, index, decl)
    )
  )
}

fn text_declaration_export_abi_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  match text_declaration_start(source, index) {
    TextPubFunctionDeclaration => text_signature_mix(
      total,
      text_export_abi_hash(
        textlex.text_hash_at(source, text_function_name_index(source, index)),
        ast.decl_param_count(decl),
        text_abi_class_tag_for_type_class(text_function_return_type_class_tag(source, index))
      )
    ),
    _ => total,
  }
}

fn text_scalar_literal_is_standalone_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  brace_depth: i32,
  paren_depth: i32
) -> bool {
  match index >= limit {
    true => true,
    false => match text_param_signature_is_trivia(source, index) {
      true => text_scalar_literal_is_standalone_between(
        source,
        index + 1,
        limit,
        brace_depth,
        paren_depth
      ),
      false => match text_depth_is_top_level(brace_depth, paren_depth) {
        true => match textlex.punctuation_at(source, index) {
          PunctSemicolon => true,
          PunctRightBrace => true,
          _ => false,
        },
        false => text_scalar_literal_is_standalone_between(
          source,
          index + 1,
          limit,
          brace_depth_after_token(source, index, brace_depth),
          paren_depth_after_token(source, index, paren_depth)
        ),
      },
    },
  }
}

fn text_scalar_literal_is_standalone(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> bool {
  text_scalar_literal_is_standalone_between(
    source,
    index + 1,
    limit,
    0,
    0
  )
}

fn text_product_constructor_start_matches_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> bool {
  let brace_index = index + 1;
  let has_brace_token = brace_index < limit;
  match textlex.token_at(source, index).kind {
    Identifier => match has_brace_token {
      true => punctuation_matches(source, brace_index, textlex.PunctLeftBrace),
      false => false,
    },
    LiteralType => match has_brace_token {
      true => punctuation_matches(source, brace_index, textlex.PunctLeftBrace),
      false => false,
    },
    _ => false,
  }
}

fn text_expression_start_skip_trivia(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  match index >= limit {
    true => index,
    false => match text_param_signature_is_trivia(source, index) {
      true => text_expression_start_skip_trivia(source, index + 1, limit),
      false => index,
    },
  }
}

fn text_expression_root_none_tag() -> i32 {
  0
}

fn text_expression_root_number_tag() -> i32 {
  1
}

fn text_expression_root_bool_tag() -> i32 {
  2
}

fn text_expression_root_text_tag() -> i32 {
  3
}

fn text_expression_root_literal_type_tag() -> i32 {
  4
}

fn text_expression_root_identifier_tag() -> i32 {
  5
}

fn text_expression_root_const_function_tag() -> i32 {
  6
}

fn text_expression_root_shape_tag() -> i32 {
  7
}

fn text_expression_root_product_constructor_tag() -> i32 {
  8
}

fn text_expression_root_match_tag() -> i32 {
  9
}

fn text_expression_root_do_tag() -> i32 {
  10
}

fn text_expression_root_head_kind_tag_from_start(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> i32 {
  match text_token_weight_matches(source, start, token.TokenKindWeight::BoolLiteral) {
    true => text_expression_root_bool_tag(),
    false => match textlex.token_at(source, start).kind {
      NumberLiteral => text_expression_root_number_tag(),
      StringLiteral => text_expression_root_text_tag(),
      CharLiteral => text_expression_root_text_tag(),
      MultilineLiteral => text_expression_root_text_tag(),
      I32Kw => text_expression_root_identifier_tag(),
      I64Kw => text_expression_root_identifier_tag(),
      U32Kw => text_expression_root_identifier_tag(),
      U64Kw => text_expression_root_identifier_tag(),
      F32Kw => text_expression_root_identifier_tag(),
      F64Kw => text_expression_root_identifier_tag(),
      MatchKw => text_expression_root_match_tag(),
      IfKw => text_expression_root_match_tag(),
      DoKw => text_expression_root_do_tag(),
      Identifier => match text_product_constructor_start_matches_between(source, start, limit) {
        true => text_expression_root_product_constructor_tag(),
        false => text_expression_root_identifier_tag(),
      },
      LiteralType => match text_product_constructor_start_matches_between(source, start, limit) {
        true => text_expression_root_product_constructor_tag(),
        false => text_expression_root_literal_type_tag(),
      },
      _ => match textlex.punctuation_at(source, start) {
        PunctLeftBrace => text_expression_root_shape_tag(),
        PunctOther => match text_pipe_bind_token_matches(source, start) {
          true => text_expression_root_const_function_tag(),
          false => text_expression_root_none_tag(),
        },
        _ => text_expression_root_none_tag(),
      },
    },
  }
}

fn text_expression_root_head_kind_tag_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  match start >= limit {
    true => text_expression_root_none_tag(),
    false => text_expression_root_head_kind_tag_from_start(source, start, limit),
  }
}

fn text_expression_root_head_hash_needs_token(kind_tag: i32) -> bool {
  match kind_tag == text_expression_root_number_tag() {
    true => true,
    false => match kind_tag == text_expression_root_bool_tag() {
      true => true,
      false => match kind_tag == text_expression_root_literal_type_tag() {
        true => true,
        false => match kind_tag == text_expression_root_identifier_tag() {
          true => true,
          false => kind_tag == text_expression_root_product_constructor_tag(),
        },
      },
    },
  }
}

fn text_expression_root_head_hash_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  match start >= limit {
    true => 0,
    false => match text_expression_root_head_hash_needs_token(
      text_expression_root_head_kind_tag_from_start(source, start, limit)
    ) {
      true => textlex.text_hash_at(source, start),
      false => 0,
    },
  }
}

fn text_expression_qualified_head_hash_after_segment(
  source: textlex.TextTokenStream,
  segment_index: i32,
  limit: i32,
  total: i32
) -> i32 {
  let next = segment_index + 1;
  match next >= limit {
    true => total,
    false => match text_head_selector_is_dot(source, next) {
      true => match next + 1 < limit {
        true => match text_head_segment_token_matches(source, next + 1) {
          true => text_expression_qualified_head_hash_after_segment(
            source,
            next + 1,
            limit,
            text_signature_mix(
              text_signature_mix(total, 1),
              textlex.text_hash_at(source, next + 1)
            )
          ),
          false => total,
        },
        false => total,
      },
      false => match text_head_selector_is_colon_colon(source, next) {
        true => match next + 2 < limit {
          true => match text_head_segment_token_matches(source, next + 2) {
            true => text_expression_qualified_head_hash_after_segment(
              source,
              next + 2,
              limit,
              text_signature_mix(
                text_signature_mix(total, 2),
                textlex.text_hash_at(source, next + 2)
              )
            ),
            false => total,
          },
          false => total,
        },
        false => total,
      },
    },
  }
}

fn text_expression_root_qualified_head_hash_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  let has_head = match start < limit {
    true => text_head_segment_token_matches(source, start),
    false => false,
  };
  match has_head {
    true => text_expression_qualified_head_hash_after_segment(
      source,
      start,
      limit,
      textlex.text_hash_at(source, start)
    ),
    false => 0,
  }
}

fn text_head_selector_is_dot(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match textlex.punctuation_at(source, index) {
    PunctOther => textlex.text_hash_at(source, index) == text_dot_hash(),
    _ => false,
  }
}

fn text_head_selector_is_colon_colon(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match punctuation_matches(source, index, textlex.PunctColon) {
    true => punctuation_matches(source, index + 1, textlex.PunctColon),
    false => false,
  }
}

fn text_head_segment_token_matches(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match textlex.token_at(source, index).kind {
    Identifier => true,
    LiteralType => true,
    I32Kw => true,
    I64Kw => true,
    U32Kw => true,
    U64Kw => true,
    F32Kw => true,
    F64Kw => true,
    _ => false,
  }
}

fn text_root_selector_count_after_head(
  source: textlex.TextTokenStream,
  head_index: i32,
  limit: i32,
  total: i32
) -> i32 {
  let next = head_index + 1;
  match next >= limit {
    true => total,
    false => match text_head_selector_is_dot(source, next) {
      true => match next + 1 < limit {
        true => match text_head_segment_token_matches(source, next + 1) {
          true => text_root_selector_count_after_head(
            source,
            next + 1,
            limit,
            total + 1
          ),
          false => total,
        },
        false => total,
      },
      false => match text_head_selector_is_colon_colon(source, next) {
        true => match next + 2 < limit {
          true => match text_head_segment_token_matches(source, next + 2) {
            true => text_root_selector_count_after_head(
              source,
              next + 2,
              limit,
              total + 1
            ),
            false => total,
          },
          false => total,
        },
        false => total,
      },
    },
  }
}

fn text_expression_root_head_selector_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  let has_head = match start < limit {
    true => text_head_segment_token_matches(source, start),
    false => false,
  };
  match has_head {
    true => text_root_selector_count_after_head(source, start, limit, 0),
    false => 0,
  }
}

fn text_root_slot_open_after_head(
  source: textlex.TextTokenStream,
  head_index: i32,
  limit: i32
) -> i32 {
  let next = head_index + 1;
  match next >= limit {
    true => limit,
    false => match textlex.punctuation_at(source, next) {
      PunctLeftBrace => next,
      PunctLeftParen => limit,
      _ => match text_head_selector_is_dot(source, next) {
        true => match next + 1 < limit {
          true => match text_head_segment_token_matches(source, next + 1) {
            true => text_root_slot_open_after_head(source, next + 1, limit),
            false => limit,
          },
          false => limit,
        },
        false => match text_head_selector_is_colon_colon(source, next) {
          true => match next + 2 < limit {
            true => match text_head_segment_token_matches(source, next + 2) {
              true => text_root_slot_open_after_head(source, next + 2, limit),
              false => limit,
            },
            false => limit,
          },
          false => limit,
        },
      },
    },
  }
}

fn text_expression_root_slot_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  match start >= limit {
    true => 0,
    false => text_root_pipe_bind_index_from_start(source, start, limit) \pipe_index -> match pipe_index < limit {
      true => text_expression_root_slot_count_between(source, start, pipe_index),
      false => match textlex.punctuation_at(source, start) {
      PunctLeftBrace => find_text_right_brace(
        source,
        start + 1,
        limit,
        0
      ) \close_index -> match close_index < limit {
        true => text_slot_count(source, start, close_index),
        false => 0,
      },
      _ => match text_head_segment_token_matches(source, start) {
        false => 0,
        true => text_root_slot_open_after_head(source, start, limit) \open_index -> match open_index < limit {
          false => 0,
          true => find_text_right_brace(
            source,
            open_index + 1,
            limit,
            0
          ) \close_index -> match close_index < limit {
            true => text_slot_count(source, open_index, close_index),
            false => 0,
          },
        },
      },
    },
    },
  }
}

fn text_root_call_open_after_head(
  source: textlex.TextTokenStream,
  head_index: i32,
  limit: i32
) -> i32 {
  let next = head_index + 1;
  match next >= limit {
    true => limit,
    false => match textlex.punctuation_at(source, next) {
      PunctLeftParen => next,
      PunctLeftBrace => limit,
      _ => match text_head_selector_is_dot(source, next) {
        true => match next + 1 < limit {
          true => match text_head_segment_token_matches(source, next + 1) {
            true => text_root_call_open_after_head(source, next + 1, limit),
            false => limit,
          },
          false => limit,
        },
        false => match text_head_selector_is_colon_colon(source, next) {
          true => match next + 2 < limit {
            true => match text_head_segment_token_matches(source, next + 2) {
              true => text_root_call_open_after_head(source, next + 2, limit),
              false => limit,
            },
            false => limit,
          },
          false => limit,
        },
      },
    },
  }
}

fn text_expression_root_call_open_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  let has_head = match start < limit {
    true => text_head_segment_token_matches(source, start),
    false => false,
  };
  match has_head {
    false => limit,
    true => text_root_call_open_after_head(source, start, limit),
  }
}

fn text_expression_root_call_close_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let open_index = text_expression_root_call_open_between(source, index, limit);
  match open_index < limit {
    false => limit,
    true => find_text_matching_right_paren(
      source,
      open_index + 1,
      limit,
      0
    ),
  }
}

fn text_expression_root_call_tail_field_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let close_index = text_expression_root_call_close_between(source, index, limit);
  match close_index < limit {
    false => 0,
    true => text_root_field_count_after_postfix(
      source,
      close_index + 1,
      limit,
      0
    ),
  }
}

fn text_expression_root_call_tail_operator_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let close_index = text_expression_root_call_close_between(source, index, limit);
  match close_index < limit {
    false => 0,
    true => text_expression_start_skip_trivia(
      source,
      close_index + 1,
      limit
    ) \tail_start -> match tail_start >= limit {
      true => 0,
      false => match textlex.punctuation_at(source, tail_start) {
        PunctSemicolon => 0,
        PunctRightBrace => 0,
        _ => match text_root_operator_token_matches(source, tail_start) {
          true => 1,
          false => text_expression_root_operator_count_between(
            source,
            tail_start,
            limit
          ),
        },
      },
    },
  }
}

fn text_expression_root_call_consumes_segment(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> bool {
  let close_index = text_expression_root_call_close_between(source, index, limit);
  match close_index < limit {
    false => false,
    true => text_expression_start_skip_trivia(
      source,
      close_index + 1,
      limit
    ) >= limit,
  }
}

fn text_expression_root_call_arg_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let open_index = text_expression_root_call_open_between(source, index, limit);
  match open_index < limit {
    false => text_no_root_call_arg_count(),
    true => text_expression_root_call_close_between(
      source,
      index,
      limit
    ) \close_index -> match close_index < limit {
      true => text_call_argument_count(source, open_index, close_index) + 1,
      false => text_no_root_call_arg_count(),
    },
  }
}

fn text_expression_root_call_arg_segment_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  target_index: i32
) -> TextArgumentSegment {
  let start = text_expression_start_skip_trivia(source, index, limit);
  let has_head = match start < limit {
    true => text_head_segment_token_matches(source, start),
    false => false,
  };
  match has_head {
    false => text_argument_segment_none(limit),
    true => text_root_call_open_after_head(source, start, limit) \open_index -> match open_index < limit {
      false => text_argument_segment_none(limit),
      true => find_text_matching_right_paren(
        source,
        open_index + 1,
        limit,
        0
      ) \close_index -> match close_index < limit {
        true => text_call_argument_segment(
          source,
          open_index,
          close_index,
          target_index
        ),
        false => text_argument_segment_none(limit),
      },
    },
  }
}

fn text_root_child_scan_is_top_level(scan: TextRootChildScan) -> bool {
  match scan.paren_depth == 0 {
    true => match scan.brace_depth == 0 {
      true => scan.bracket_depth == 0,
      false => false,
    },
    false => false,
  }
}

fn text_root_child_segment_colon_continue(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  paren_depth: i32,
  brace_depth: i32,
  bracket_depth: i32
) -> i32 {
  let punctuation = textlex.punctuation_at(source, index);
  let top_level = match paren_depth == 0 {
    true => match brace_depth == 0 {
      true => bracket_depth == 0,
      false => false,
    },
    false => false,
  };
  let colon_matches = match top_level {
    true => match punctuation {
      PunctColon => match punctuation_matches(source, index + 1, textlex.PunctColon) {
        true => false,
        false => match index > 0 {
          true => match punctuation_matches(source, index - 1, textlex.PunctColon) {
            true => false,
            false => true,
          },
          false => true,
        },
      },
      _ => false,
    },
    false => false,
  };
  match colon_matches {
    true => index,
    false => text_root_child_segment_colon(
      source,
      index + 1,
      limit,
      text_argument_scan_next_paren_depth(punctuation, paren_depth),
      text_argument_scan_next_brace_depth(punctuation, brace_depth),
      text_argument_scan_bracket_delta(source, index, bracket_depth)
    ),
  }
}

fn text_root_child_segment_colon(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  paren_depth: i32,
  brace_depth: i32,
  bracket_depth: i32
) -> i32 {
  match index >= limit {
    true => limit,
    false => text_root_child_segment_colon_continue(
      source,
      index,
      limit,
      paren_depth,
      brace_depth,
      bracket_depth
    ),
  }
}

fn text_root_child_segment_value_start(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  let colon = text_root_child_segment_colon(
    source,
    start,
    limit,
    0,
    0,
    0
  );
  match colon < limit {
    true => colon + 1,
    false => start,
  }
}

fn text_root_child_call_role_tag() -> i32 {
  1
}

fn text_root_child_slot_role_tag() -> i32 {
  2
}

fn text_root_child_pipe_body_role_tag() -> i32 {
  3
}

fn text_root_child_do_bind_role_tag() -> i32 {
  4
}

fn text_root_child_do_expr_role_tag() -> i32 {
