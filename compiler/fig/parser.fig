  let next = text_declaration_end_from_index(source, index);
  let equal = text_find_top_level_punctuation_score(
    source,
    index + 2,
    next,
    0,
    1
  );
  match equal < next {
    true => text_value_operator_signature_between(
      source,
      equal + 1,
      next,
      total
    ),
    false => total,
  }
}

