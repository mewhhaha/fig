fn TextResolutionEnv::value_declaration_body_resolved_unknown_type_class_tag(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let body_start = text_value_declaration_body_start_index(source, index);
  let body_end = text_declaration_end_from_index(source, index);
  let identifier_hash = text_expression_root_identifier_hash_between(
    source,
    body_start,
    body_end
  );
  let symbol_type = TextResolutionEnv::lookup_symbol(env, identifier_hash);
  match symbol_type == text_type_class_unknown_tag() {
    false => symbol_type,
    true => text_named_symbol_type_class_for_hash(
      source,
      identifier_hash
    ) \source_symbol_type -> match
      source_symbol_type == text_type_class_unknown_tag() {
      false => source_symbol_type,
      true => TextResolutionEnv::root_call_return_type_class_for_hash_between(
        env,
        source,
        body_start,
        body_end,
        text_expression_root_head_hash_between(source, body_start, body_end)
      ),
    },
  }
}

fn TextResolutionEnv::declaration_resolved_value_body_type_class_tag(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  match is_text_non_value_declaration_start(source, index) {
    true => text_type_class_unknown_tag(),
    false => match text_declaration_kind_is_function(kind_tag) {
      true => TextResolutionEnv::function_body_resolved_type_class_tag(
        env,
        source,
        index
      ),
      false => match text_declaration_kind_is_value_binding(kind_tag) {
        true => TextResolutionEnv::value_declaration_body_resolved_type_class_tag(
          env,
          source,
          index
        ),
        false => text_type_class_unknown_tag(),
      },
    },
  }
}

fn TextResolutionEnv::declaration_resolved_value_body_type_signature_total(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  match is_text_external_import_start(source, index) {
    true => total,
    false => text_declaration_kind_tag(source, index, decl) \kind_tag ->
      TextResolutionEnv::declaration_resolved_value_body_type_class_tag(
        env,
        source,
        index,
        decl
      ) \type_class -> text_signature_mix(
        total,
        text_value_body_type_class_hash(kind_tag, type_class)
      ),
  }
}

