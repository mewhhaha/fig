) -> i32 {
  match scan.index >= scan.limit {
    true => text_type_class_unknown_tag(),
    false => match text_function_local_let_index_found(
      source,
      scan,
      target_hash
    ) {
      true => text_function_local_let_resolved_type_class_at(
        source,
        function_index,
        scan.index,
        text_local_let_statement_end(source, scan.index, scan.limit)
      ),
      false => rec(
        source,
        function_index,
        text_function_local_let_index_next_scan(source, scan),
        target_hash
      ),
    },
  }
}

fn text_function_local_let_resolved_type_class_for_name_hash(
  source: textlex.TextTokenStream,
  index: i32,
  target_hash: i32
) -> i32 {
  text_function_local_let_resolved_type_class_for_name_hash_between(
    source,
    index,
    text_function_local_let_bounds_scan(source, index),
    target_hash
  )
}

fn text_value_body_window(
  start: i32,
  limit: i32
) -> TextValueBodyWindow {
  TextValueBodyWindow {
    start: start,
    limit: limit,
    found: true,
  }
}

fn text_missing_value_body_window() -> TextValueBodyWindow {
  TextValueBodyWindow {
    start: 0,
    limit: 0,
    found: false,
  }
}

fn text_value_body_context(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> TextValueBodyContext {
  TextValueBodyContext {
    source: source,
    index: index,
    decl: decl,
  }
}

fn text_value_body_context_source(
  context_value: TextValueBodyContext
) -> textlex.TextTokenStream {
  context_value.source
}

fn text_value_body_context_index(context_value: TextValueBodyContext) -> i32 {
  context_value.index
}

fn text_value_body_context_decl(context_value: TextValueBodyContext) -> ast.Decl {
  context_value.decl
}

fn text_value_body_kind_tag_reader() -> monad.Reader(
  TextValueBodyContext,
  i32
) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    source <- monad.Reader::asks(text_value_body_context_source);
    index <- monad.Reader::asks(text_value_body_context_index);
    decl <- monad.Reader::asks(text_value_body_context_decl);
    pure(text_declaration_kind_tag(source, index, decl))
  }
}

fn text_function_value_body_window_reader() -> monad.Reader(
  TextValueBodyContext,
  TextValueBodyWindow
) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    source <- monad.Reader::asks(text_value_body_context_source);
    index <- monad.Reader::asks(text_value_body_context_index);
    let next = text_declaration_end_from_index(source, index);
    let open_paren = text_function_open_paren_index(source, index, next);
    let close_paren = text_function_close_paren_index(source, open_paren, next);
    let arrow = text_function_arrow_index(source, close_paren, next);
    let left_brace = text_function_left_brace_index(source, arrow, next);
    let body_start = text_function_body_start_index(source, arrow, left_brace);
    let right_brace = find_text_expression_limit(
      source,
      left_brace + 1,
      next,
      textlex.PunctRightBrace
    );
    pure(text_value_body_window(body_start, right_brace))
  }
}

fn text_value_declaration_body_window_reader() -> monad.Reader(
  TextValueBodyContext,
  TextValueBodyWindow
) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    source <- monad.Reader::asks(text_value_body_context_source);
    index <- monad.Reader::asks(text_value_body_context_index);
    let next = text_declaration_end_from_index(source, index);
    let equal = text_find_top_level_punctuation_score(
      source,
      index + 2,
      next,
      0,
      1
    );
    match equal < next {
      true => pure(text_value_body_window(equal + 1, next)),
      false => pure(text_missing_value_body_window()),
    }
  }
}

fn text_declaration_value_body_window_reader() -> monad.Reader(
  TextValueBodyContext,
  TextValueBodyWindow
) {
  text_declaration_window_reader(TextDeclarationValueBodyWindow)
}

fn text_declaration_value_body_window(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> TextValueBodyWindow {
  monad.Reader::run(
    text_declaration_value_body_window_reader(),
    text_value_body_context(source, index, decl)
  )
}

fn text_root_final_head_segment_index(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let next = index + 1;
  let step = text_head_selector_step_after(source, next, limit);
  match step.found {
    true => rec(source, step.segment_index, limit),
    false => index,
  }
}

fn text_value_declaration_shape_name_token_window_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> TextValueBodyWindow {
  let start = text_expression_start_skip_trivia(source, index, limit);
  let open_index = text_expression_root_call_open_between(
    source,
    start,
    limit
  );
  match start >= limit {
    true => text_missing_value_body_window(),
    false => match open_index < limit {
      true => text_value_declaration_shape_call_name_token_window(
        source,
        start,
        limit,
        open_index
      ),
      false => text_value_declaration_shape_head_name_token_window(
        source,
        start,
        limit
      ),
    },
  }
}

fn text_value_declaration_shape_call_name_token_window(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  open_index: i32
) -> TextValueBodyWindow {
  let close_index = text_expression_root_call_close_between(
    source,
    start,
    limit
  );
  match close_index < limit {
    true => match text_call_argument_count(source, open_index, close_index) > 0 {
      true => text_value_body_window(open_index + 1, close_index),
      false => text_value_body_window(start, close_index + 1),
    },
    false => text_value_body_window(start, limit),
  }
}

fn text_value_declaration_shape_head_name_token_window(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> TextValueBodyWindow {
  let final_index = text_root_final_head_segment_index(
    source,
    start,
    limit
  );
  match text_head_segment_token_matches(source, start) {
    true => match final_index == start {
      true => text_value_body_window(start, limit),
      false => text_value_body_window(final_index, final_index + 1),
    },
    false => text_value_body_window(start, limit),
  }
}

fn text_value_declaration_shape_name_token_window_reader() -> monad.Reader(
  TextValueBodyContext,
  TextValueBodyWindow
) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    window <- text_value_declaration_body_window_reader();
    source <- monad.Reader::asks(text_value_body_context_source);
    match window.found {
      true => pure(text_value_declaration_shape_name_token_window_between(
        source,
        window.start,
        window.limit
      )),
      false => pure(text_missing_value_body_window()),
    }
  }
}

fn text_declaration_shape_name_token_window_reader() -> monad.Reader(
  TextValueBodyContext,
  TextValueBodyWindow
) {
  text_declaration_window_reader(TextDeclarationShapeNameTokenWindow)
}

fn text_declaration_shape_name_token_window(
