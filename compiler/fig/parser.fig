}

fn text_value_name_token_matches(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match textlex.token_at(source, index).kind {
    Identifier => match index > 0 {
      false => true,
      true => match textlex.text_hash_at(source, index) == text_assert_hash() {
        false => true,
        true => match punctuation_matches(source, index - 1, textlex.PunctOther) {
          false => true,
          true => textlex.text_hash_at(source, index - 1) != text_static_marker_hash(),
        },
      },
    },
    LiteralType => true,
    _ => false,
  }
}

fn text_value_literal_token_matches(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match text_token_weight_matches(source, index, token.TokenKindWeight::BoolLiteral) {
    true => true,
    false => match textlex.token_at(source, index).kind {
      NumberLiteral => true,
      StringLiteral => true,
      CharLiteral => true,
      MultilineLiteral => true,
      _ => false,
    },
  }
}

fn text_value_name_token_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32
) -> i32 {
  text_value_body_count_scan(source, index, limit, total, TextValueBodyNameTokenCount)
}

fn text_value_literal_token_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32
) -> i32 {
  text_value_body_count_scan(
    source,
    index,
    limit,
    total,
    TextValueBodyLiteralTokenCount
  )
}

fn text_value_body_count_delta_at(
  source: textlex.TextTokenStream,
  index: i32,
  kind: TextValueBodyCount
) -> i32 {
  match kind {
    TextValueBodyMatchCount => match text_value_match_token_matches(source, index) {
      true => 1,
      false => 0,
    },
    TextValueBodyDoCount => match text_value_do_token_matches(source, index) {
      true => 1,
      false => 0,
    },
    TextValueBodyDoBindCount => match text_value_do_bind_token_matches(source, index) {
      true => 1,
      false => 0,
    },
    TextValueBodyMatchArmCount => text_value_match_arm_delta(source, index),
    TextValueBodyPipeBindCount => match text_value_pipe_bind_token_matches(source, index) {
      true => 1,
      false => 0,
    },
    TextValueBodyOperatorCount => match text_root_operator_token_matches(source, index) {
      true => 1,
      false => 0,
    },
    TextValueBodyCallCount => match text_value_call_token_matches(source, index) {
      true => 1,
      false => 0,
    },
    TextValueBodyNameTokenCount => match text_value_name_token_matches(source, index) {
      true => 1,
      false => 0,
    },
    TextValueBodyLiteralTokenCount => match text_value_literal_token_matches(source, index) {
      true => 1,
      false => 0,
    },
  }
}

fn text_value_body_type_assert_next_index(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let semicolon = text_find_top_level_punctuation_score(
    source,
    index,
    limit,
    0,
    textlex.punctuation_score(textlex.PunctSemicolon)
  );
  match semicolon < limit {
    true => semicolon + 1,
    false => limit,
  }
}

fn text_value_body_count_skips_type_assert(kind: TextValueBodyCount) -> bool {
  match kind {
    TextValueBodyNameTokenCount => false,
    TextValueBodyLiteralTokenCount => false,
    _ => true,
  }
}

fn text_value_body_count_skips_local_let_annotation(
  kind: TextValueBodyCount
) -> bool {
  match kind {
    TextValueBodyNameTokenCount => false,
    TextValueBodyLiteralTokenCount => false,
    _ => true,
  }
}

fn text_value_body_local_let_annotation_next_index(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  match index > 1 {
    false => index,
    true => match textlex.punctuation_at(source, index) {
      PunctColon => match text_token_kind_matches(source, index - 2, token.LetKw) {
        false => index,
        true => match text_find_top_level_punctuation_score(
          source,
          index + 1,
          limit,
          0,
          textlex.punctuation_score(textlex.PunctEqual)
        ) {
          equal if equal < limit => equal + 1,
          _ => index,
        },
      },
      _ => index,
    },
  }
}

fn text_value_body_count_scan(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32,
  kind: TextValueBodyCount
) -> i32 {
  if index >= limit {
    total
  } else {
    let next = match text_value_body_count_skips_local_let_annotation(kind) {
      true => text_value_body_local_let_annotation_next_index(source, index, limit),
      false => index,
    };
    if next != index {
      rec(source, next, limit, total, kind)
    } else {
      match text_value_body_count_skips_type_assert(kind) &&
        text_type_assert_token_matches(source, index, limit) {
        true => rec(
          source,
          text_value_body_type_assert_next_index(source, index, limit),
          limit,
          total,
          kind
        ),
        false => text_value_body_count_delta_at(source, index, kind) \delta -> rec(
          source,
          index + 1,
          limit,
          total + delta,
          kind
        ),
      }
    }
  }
}

fn text_value_body_signature_scan(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32,
  kind: TextValueBodySignature
) -> i32 {
  if index >= limit {
    total
  } else {
    let next = match text_value_body_signature_skips_local_let_annotation(kind) {
      true => text_value_body_local_let_annotation_next_index(source, index, limit),
      false => index,
    };
    if next != index {
      rec(source, next, limit, total, kind)
    } else {
      match text_value_body_signature_skips_type_assert(kind) &&
        text_type_assert_token_matches(source, index, limit) {
        true => rec(
          source,
          text_value_body_type_assert_next_index(source, index, limit),
          limit,
          total,
          kind
        ),
        false => rec(
          source,
          index + 1,
          limit,
          text_value_body_signature_total_at(source, index, total, kind),
          kind
        ),
      }
    }
  }
}

fn text_value_name_token_signature_between(
  source: textlex.TextTokenStream,
  index: i32,
