fn text_declaration_kind_count_delta(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  kind_tag: i32
) -> i32 {
  let actual_tag = text_declaration_kind_tag(source, index, decl);
  match actual_tag == kind_tag {
    true => 1,
    false => 0,
  }
}

fn text_declaration_type_sugar_statement_count(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  match text_token_weight_matches(source, index, 17) {
    true => match is_text_type_function_start(source, index) {
      true => 0,
      false => text_type_sugar_statement_count(source, index),
    },
    false => 0,
  }
}

fn text_declaration_type_result_kind_count_delta(
  source: textlex.TextTokenStream,
  index: i32,
  expected_tag: i32
) -> i32 {
  match text_token_weight_matches(source, index, 17) {
    true => match text_type_result_kind_tag(source, index) == expected_tag {
      true => 1,
      false => 0,
    },
    false => 0,
  }
}

fn text_declaration_kind_tag(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  let is_source_import = is_text_source_import_start(source, index);
  match is_source_import {
    true => 5,
    false => text_regular_declaration_kind_tag(source, index, decl),
  }
}

fn text_regular_declaration_kind_tag(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  let is_function = is_text_function_declaration_start(source, index);
  let is_let = text_token_weight_matches(source, index, 29);
  let is_const = text_token_weight_matches(source, index, 19);
  let is_type = text_token_weight_matches(source, index, 17);
  match is_function {
    true => 1,
    false => match is_let {
      true => 2,
      false => match is_const {
        true => 3,
        false => match is_type {
          true => 4,
          false => ast.decl_tag(decl),
        },
      },
    },
  }
}

fn text_declaration_name_index(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  match text_declaration_kind_tag(source, index, decl) {
    1 => text_function_name_index(source, index),
    4 => text_type_name_index(source, index),
    _ => index + 1,
  }
}

fn text_source_import_module_hash(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  textlex.text_hash_at(source, index + 6)
}

fn text_declaration_aux_signature_hash(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  kind_tag: i32
) -> i32 {
  match kind_tag {
    5 => text_source_import_module_hash(source, index),
    _ => ast.decl_param_count(decl),
  }
}

fn text_declaration_signature_hash(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  let name_index = text_declaration_name_index(source, index, decl);
  let name_hash = textlex.text_hash_at(source, name_index);
  let aux_hash = text_declaration_aux_signature_hash(
    source,
    index,
    decl,
    kind_tag
  );
  text_signature_mix(
    text_signature_mix(
      text_signature_mix(17, kind_tag),
      name_hash
    ),
    aux_hash
  )
}

fn text_declaration_function_param_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  total: i32
) -> i32 {
  match is_text_function_declaration_start(source, index) {
    true => text_function_param_signature_hash(source, index, total),
    false => total,
  }
}

fn text_declaration_type_param_signature_total(
