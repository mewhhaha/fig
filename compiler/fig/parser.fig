fn push_param_frame(
  value: ParamListFrame,
  param: ParamFrame,
  separator_width: i32
) -> ParamListFrame {
  param_list_frame(
    vec.Vec::push(value.params, param),
    value.count + 1,
    value.consumed + param.consumed + separator_width
  )
}

fn type_annotation_frame(
  annotation: ast.TypeAnnotation,
  consumed: i32
) -> TypeAnnotationFrame {
  TypeAnnotationFrame {
    annotation: annotation,
    consumed: consumed,
  }
}

fn program_frame(
  program: ast.Program,
  diagnostics: diagnostic.DiagnosticBag,
  consumed: i32
) -> ProgramFrame {
  ProgramFrame {
    program: program,
    diagnostics: diagnostics,
    consumed: consumed,
  }
}

fn ok_expr(
  next: combinator.ParseState,
  value: ExprFrame
) -> combinator.Parser(ExprFrame) {
  Ok(Reply {state: next, value: value})
}

fn err_expr(error: combinator.ParseError) -> combinator.Parser(ExprFrame) {
  Err(error)
}

fn ok_decl(
  next: combinator.ParseState,
  value: DeclFrame
) -> combinator.Parser(DeclFrame) {
  Ok(Reply {state: next, value: value})
}

fn err_decl(error: combinator.ParseError) -> combinator.Parser(DeclFrame) {
  Err(error)
}

fn ok_param(
  next: combinator.ParseState,
  value: ParamFrame
) -> combinator.Parser(ParamFrame) {
  Ok(Reply {state: next, value: value})
}

fn err_param(error: combinator.ParseError) -> combinator.Parser(ParamFrame) {
  Err(error)
}

fn ok_type_annotation(
  next: combinator.ParseState,
  value: TypeAnnotationFrame
) -> combinator.Parser(TypeAnnotationFrame) {
  Ok(Reply {state: next, value: value})
}

fn err_type_annotation(error: combinator.ParseError) -> combinator.Parser(TypeAnnotationFrame) {
  Err(error)
}

fn ok_program(
  next: combinator.ParseState,
  value: ProgramFrame
) -> combinator.Parser(ProgramFrame) {
  Ok(Reply {state: next, value: value})
}

fn err_program(error: combinator.ParseError) -> combinator.Parser(ProgramFrame) {
  Err(error)
}

fn primary_expr_from_kind(
  value: token.ExpressionKind,
  seed: i32,
  current_token: token.Token
) -> ast.Expr match {
  NumberExpression, seed, current_token => ast.int_expr(seed + token.token_score(current_token)),
  BooleanExpression, seed, _current_token => ast.bool_expr((seed % 2) == 0),
  NameExpression, seed, current_token => ast.var_expr(seed + token.token_score(current_token)),
  TextExpression, seed, current_token => ast.var_expr(seed + span.width(current_token.span)),
  NoExpression, _seed, _current_token => ast.Missing,
}

fn parse_primary(
  current: combinator.ParseState,
  source: stream.TokenStream,
  seed: i32
) -> combinator.Parser(ExprFrame) {
  let current_token = stream.token_at(
    source,
    current.cursor
  );
  let kind = token.expression_kind(current_token.kind);
  match token.is_expression_kind(kind) {
    false => err_expr(combinator.UnexpectedToken(
      2,
      0,
      current_token.span
    )),
    true => ok_expr(
      combinator.next_state(current),
      expression_frame(
        primary_expr_from_kind(
          kind,
          seed,
          current_token
        ),
        1
      )
    ),
  }
}

fn combine_binary(
  left: combinator.Reply(ExprFrame),
  op: token.Token,
  third: combinator.Parser(ExprFrame)
) -> combinator.Parser(ExprFrame) match {
  left, op, Ok(right) => ok_expr(
    right.state,
    expression_frame(
      ast.binary_expr(
        ast.expr_score(left.value.expr),
        token.token_score(op),
        ast.expr_score(right.value.expr)
      ),
      left.value.consumed + 1 + right.value.consumed
    )
  ),
  _left, _op, Err(error) => err_expr(error),
}

fn parse_binary_tail(
  value: combinator.Parser(ExprFrame),
  source: stream.TokenStream,
  seed: i32
) -> combinator.Parser(ExprFrame) match {
  Ok(result), source, seed => stream.token_at(source, result.state.cursor) \op -> (result.state.cursor + 1) < result.state.limit \has_rhs -> match token.is_symbol(op.kind) {
    true => has_rhs,
    false => false,
  } \can_parse_binary -> match can_parse_binary {
    true => combine_binary(
      result,
      op,
      parse_primary(
        combinator.state(
          result.state.cursor + 1,
          result.state.limit
        ),
        source,
        seed + 1
      )
    ),
    false => ok_expr(result.state, result.value),
  },
  Err(error), _source, _seed => err_expr(error),
}

fn parse_expression(
  current: combinator.ParseState,
  source: stream.TokenStream,
  seed: i32
) -> combinator.Parser(ExprFrame) {
  parse_binary_tail(
    parse_primary(current, source, seed),
    source,
    seed
  )
}

fn parse_text_primary(
  current: combinator.ParseState,
  source: textlex.TextTokenStream,
  seed: i32
) -> combinator.Parser(ExprFrame) {
  let current_token = textlex.token_at(
    source,
    current.cursor
  );
  let kind = token.expression_kind(current_token.kind);
  match token.is_expression_kind(kind) {
    false => err_expr(combinator.UnexpectedToken(
      2,
      0,
      current_token.span
    )),
    true => ok_expr(
      combinator.next_state(current),
      expression_frame(
        primary_expr_from_kind(
          kind,
          seed,
          current_token
        ),
        1
      )
    ),
  }
}

fn combine_text_binary(
  left: combinator.Reply(ExprFrame),
  op: token.Token,
  third: combinator.Parser(ExprFrame)
) -> combinator.Parser(ExprFrame) match {
  left, op, Ok(right) => combine_binary(left, op, Ok(right)),
  _left, _op, Err(error) => err_expr(error),
}

fn expr_punctuation_error(
  source: textlex.TextTokenStream,
  index: i32,
  expected: textlex.TextPunctuation
) -> combinator.Parser(ExprFrame) {
  let actual = textlex.punctuation_at(source, index);
  let current = textlex.token_at(source, index);
  err_expr(combinator.UnexpectedToken(
    textlex.punctuation_score(expected),
    textlex.punctuation_score(actual),
    current.span
  ))
}

fn combine_call(
  callee: combinator.Reply(ExprFrame),
  other: combinator.Parser(ExprFrame),
  close_index: i32
) -> combinator.Parser(ExprFrame) match {
  callee, Ok(arg), close_index => ok_expr(
    combinator.state(close_index + 1, callee.state.limit),
    expression_frame(
      ast.call_expr(
        ast.expr_score(callee.value.expr),
        ast.expr_score(arg.value.expr)
      ),
      callee.value.consumed + arg.value.consumed + 2
    )
  ),
  _callee, Err(error), _close_index => err_expr(error),
}

fn parse_text_call_tail(
  value: combinator.Parser(ExprFrame),
  source: textlex.TextTokenStream,
  seed: i32
) -> combinator.Parser(ExprFrame) match {
  Ok(result), source, seed => result.state.cursor \open_index -> result.state.cursor + 2 \close_index -> match punctuation_matches(source, open_index, textlex.PunctLeftParen) {
    false => ok_expr(result.state, result.value),
    true => match punctuation_matches(source, close_index, textlex.PunctRightParen) {
      false => expr_punctuation_error(
        source,
        close_index,
        textlex.PunctRightParen
      ),
      true => combine_call(
        result,
        parse_text_primary(
          combinator.state(
            open_index + 1,
            close_index
          ),
          source,
          seed + 1
        ),
        close_index
      ),
    },
  },
  Err(error), _source, _seed => err_expr(error),
}

fn parse_text_binary_tail(
  value: combinator.Parser(ExprFrame),
  source: textlex.TextTokenStream,
  seed: i32
) -> combinator.Parser(ExprFrame) match {
  Ok(result), source, seed => textlex.token_at(source, result.state.cursor) \op -> (result.state.cursor + 1) < result.state.limit \has_rhs -> match token.is_symbol(op.kind) {
    true => has_rhs,
    false => false,
  } \can_parse_binary -> match can_parse_binary {
    true => combine_text_binary(
      result,
      op,
      parse_text_primary(
        combinator.state(
          result.state.cursor + 1,
          result.state.limit
        ),
        source,
        seed + 1
      )
    ),
    false => ok_expr(result.state, result.value),
  },
  Err(error), _source, _seed => err_expr(error),
}

fn parse_text_expression(
  current: combinator.ParseState,
  source: textlex.TextTokenStream,
  seed: i32
) -> combinator.Parser(ExprFrame) {
  parse_text_binary_tail(
    parse_text_call_tail(
      parse_text_primary(current, source, seed),
      source,
      seed
    ),
    source,
    seed
  )
}

fn parse_decl_from_view(
  view: TokenView,
  seed: i32,
  current: combinator.ParseState
) -> combinator.Parser(DeclFrame) {
  let kind = token.declaration_kind(view.kind);
  let parsed_decl = declaration_from_kind(kind, seed);
  let parsed_frame = declaration_frame(parsed_decl, 1);
  match token.is_declaration_kind(kind) {
    false => err_decl(combinator.UnexpectedToken(
      1,
      0,
      view.span
    )),
    true => ok_decl(
      combinator.next_state(current),
      parsed_frame
    ),
  }
}

fn parse_declaration(
  current: combinator.ParseState,
  first: token.Token,
  seed: i32
) -> combinator.Parser(DeclFrame) {
  parse_decl_from_view(
    token_view(first),
    seed,
    current
  )
}

fn declaration_from_expr(
  kind: token.DeclarationKind,
  seed: i32,
  value: ast.Expr
) -> ast.Decl {
  match kind {
    FunctionDeclaration => ast.fn_decl(seed, 1, ast.named_type(seed + 1), ast.block(value)),
    LetDeclaration => ast.let_decl(seed, ast.named_type(seed + 1), value),
    ConstDeclaration => ast.const_decl(seed, ast.named_type(seed + 1), value),
    TypeDeclaration => ast.type_decl(seed, 1),
    NoDeclaration => ast.source_import_decl(seed, seed + 1),
  }
}

fn declaration_from_expr_result(
  kind: token.DeclarationKind,
  start: i32,
  seed: i32,
  result: combinator.Parser(ExprFrame)
) -> combinator.Parser(DeclFrame) {
  match result {
    Ok(reply) => ok_decl(
      reply.state,
      declaration_frame(
        declaration_from_expr(
          kind,
          seed,
          reply.value.expr
        ),
        reply.state.cursor - start
      )
    ),
    Err(error) => err_decl(error),
  }
}

fn declaration_from_named_expr(
  kind: token.DeclarationKind,
  name: token.Token,
  seed: i32,
  value: ast.Expr
) -> ast.Decl {
  match kind {
    FunctionDeclaration => ast.fn_decl(
      token.token_score(name),
      1,
      ast.named_type(seed + 1),
      ast.block(value)
    ),
    LetDeclaration => ast.let_decl(token.token_score(name), ast.named_type(seed + 1), value),
    ConstDeclaration => ast.const_decl(token.token_score(name), ast.named_type(seed + 1), value),
    TypeDeclaration => ast.type_decl(token.token_score(name), 1),
    NoDeclaration => ast.source_import_decl(seed, token.token_score(name)),
  }
}

fn declaration_from_named_result(
  kind: token.DeclarationKind,
  name: token.Token,
  start: i32,
  seed: i32,
  result: combinator.Parser(ExprFrame)
) -> combinator.Parser(DeclFrame) {
  match result {
    Ok(reply) => ok_decl(
      reply.state,
      declaration_frame(
        declaration_from_named_expr(
          kind,
          name,
          seed,
          reply.value.expr
        ),
        reply.state.cursor - start
      )
    ),
    Err(error) => err_decl(error),
  }
}

fn declaration_from_named_annotated_expr(
  kind: token.DeclarationKind,
  name: token.Token,
  annotation: ast.TypeAnnotation,
  seed: i32,
  value: ast.Expr
) -> ast.Decl {
  match kind {
    FunctionDeclaration => ast.fn_decl(
      token.token_score(name),
      1,
      annotation,
      ast.block(value)
    ),
    LetDeclaration => ast.let_decl(token.token_score(name), annotation, value),
    ConstDeclaration => ast.const_decl(token.token_score(name), annotation, value),
    TypeDeclaration => ast.type_decl(token.token_score(name), 1),
    NoDeclaration => ast.source_import_decl(seed, token.token_score(name)),
  }
}

fn declaration_from_named_annotated_result(
  context: TextNamedAnnotatedDeclContext,
  result: combinator.Parser(ExprFrame)
) -> combinator.Parser(DeclFrame) {
  match result {
    Ok(reply) => ok_decl(
      reply.state,
      declaration_frame(
        declaration_from_named_annotated_expr(
          context.kind,
          context.name,
          context.annotation,
          context.seed,
          reply.value.expr
        ),
        reply.state.cursor - context.start
      )
    ),
    Err(error) => err_decl(error),
  }
}

fn punctuation_pair_matches(
  left: textlex.TextPunctuation,
  right: textlex.TextPunctuation
) -> bool {
  match left {
    PunctNone => match right { PunctNone => true, _ => false },
    PunctEqual => match right { PunctEqual => true, _ => false },
    PunctLeftParen => match right { PunctLeftParen => true, _ => false },
    PunctRightParen => match right { PunctRightParen => true, _ => false },
    PunctArrow => match right { PunctArrow => true, _ => false },
    PunctLeftBrace => match right { PunctLeftBrace => true, _ => false },
    PunctRightBrace => match right { PunctRightBrace => true, _ => false },
    PunctComma => match right { PunctComma => true, _ => false },
    PunctColon => match right { PunctColon => true, _ => false },
    PunctSlash => match right { PunctSlash => true, _ => false },
    PunctSemicolon => match right { PunctSemicolon => true, _ => false },
    PunctOther => match right { PunctOther => true, _ => false },
  }
}

fn punctuation_matches(
  source: textlex.TextTokenStream,
  index: i32,
  expected: textlex.TextPunctuation
) -> bool {
  textlex.punctuation_score(textlex.punctuation_at(source, index))
    == textlex.punctuation_score(expected)
}

fn punctuation_score_matches(
  source: textlex.TextTokenStream,
  index: i32,
  expected_score: i32
) -> bool {
  textlex.punctuation_score(textlex.punctuation_at(source, index)) == expected_score
}

fn text_token_weight_matches(
  source: textlex.TextTokenStream,
  index: i32,
  expected_weight: i32
) -> bool {
  token.keyword_weight(textlex.token_at(source, index).kind) == expected_weight
}

fn text_token_kind_matches(
  source: textlex.TextTokenStream,
  index: i32,
  expected: token.TokenKind
) -> bool {
  text_token_weight_matches(source, index, token.keyword_weight(expected))
}

fn punctuation_error(
  source: textlex.TextTokenStream,
  index: i32,
  expected: textlex.TextPunctuation
) -> combinator.Parser(DeclFrame) {
  let actual = textlex.punctuation_at(source, index);
  let current = textlex.token_at(source, index);
  err_decl(combinator.UnexpectedToken(
    textlex.punctuation_score(expected),
    textlex.punctuation_score(actual),
    current.span
  ))
}

fn is_type_annotation_atom(current: token.Token) -> bool {
  match token.expression_kind(current.kind) {
    NameExpression => true,
    _ => false,
  }
}

fn type_annotation_error(current: token.Token) -> combinator.Parser(TypeAnnotationFrame) {
  err_type_annotation(type_annotation_parse_error(current))
}

fn type_annotation_parse_error(current: token.Token) -> combinator.ParseError {
  combinator.UnexpectedToken(
    4,
    token.keyword_weight(current.kind),
    current.span
  )
}

fn text_type_atom_parser() -> textparser.TextParser(token.Token) {
  \input_value -> {
    let current = textlex.token_at(
      input_value.source,
      input_value.state.cursor
    );
    match is_type_annotation_atom(current) {
      true => combinator.ok(
        combinator.next_state(input_value.state),
        current
      ),
      false => combinator.err(type_annotation_parse_error(current)),
    }
  }
}

fn text_applied_annotation_tail(
  name: token.Token
) -> textparser.TextParser(TypeAnnotationFrame) {
  \input_value -> {
    let arg = textlex.token_at(input_value.source, input_value.state.cursor + 1);
    match is_type_annotation_atom(arg) {
      false => type_annotation_error(arg),
      true => match punctuation_matches(
        input_value.source,
        input_value.state.cursor + 2,
        textlex.PunctRightParen
      ) {
        false => annotation_punctuation_error(
          input_value.source,
          input_value.state.cursor + 2,
          textlex.PunctRightParen
        ),
        true => ok_type_annotation(
          combinator.state(input_value.state.cursor + 3, input_value.state.limit),
          type_annotation_frame(
            ast.applied_type(
              token.token_score(name),
              token.token_score(arg)
            ),
            4
          )
        ),
      },
    }
  }
}

fn text_annotation_tail_parser(
  name: token.Token
) -> textparser.TextParser(TypeAnnotationFrame) {
  \input_value -> match punctuation_matches(
    input_value.source,
    input_value.state.cursor,
    textlex.PunctLeftParen
  ) {
    true => textparser.run(text_applied_annotation_tail(name), input_value),
    false => ok_type_annotation(
      input_value.state,
      type_annotation_frame(
        ast.named_type(token.token_score(name)),
        1
      )
    ),
  }
}

fn text_type_annotation_parser() -> textparser.TextParser(TypeAnnotationFrame) {
  \input_value -> match textparser.run(
    text_type_atom_parser(),
    input_value
  ) {
    Err(error) => err_type_annotation(error),
    Ok(name) => textparser.run(
      text_annotation_tail_parser(name.value),
      textparser.with_state(input_value, name.state)
    ),
  }
}

fn annotation_punctuation_error(
  source: textlex.TextTokenStream,
  index: i32,
  expected: textlex.TextPunctuation
) -> combinator.Parser(TypeAnnotationFrame) {
  let actual = textlex.punctuation_at(source, index);
  let current = textlex.token_at(source, index);
  err_type_annotation(combinator.UnexpectedToken(
    textlex.punctuation_score(expected),
    textlex.punctuation_score(actual),
    current.span
  ))
}

fn run_text_parser(
  parser_value: textparser.TextParser(a),
  current: combinator.ParseState,
  source: textlex.TextTokenStream,
  seed: i32
) -> combinator.Parser(a) {
  textparser.run(
    parser_value,
    textparser.input(source, current, seed)
  )
}

fn parse_text_type_annotation(
  current: combinator.ParseState,
  source: textlex.TextTokenStream
) -> combinator.Parser(TypeAnnotationFrame) {
  run_text_parser(text_type_annotation_parser(), current, source, 0)
}

fn text_param_after_name(name: token.Token) -> textparser.TextParser(ParamFrame) {
  \input_value -> match textparser.run(
    textparser.expect_punctuation(textlex.PunctColon),
    input_value
  ) {
    Err(error) => err_param(error),
    Ok(colon) => match textparser.run(
      text_type_annotation_parser(),
      textparser.with_state(input_value, colon.state)
    ) {
      Err(error) => err_param(error),
      Ok(annotation) => ok_param(
        annotation.state,
        param_from_annotation_frame(name, annotation.value)
      ),
    },
  }
}

fn text_param_parser() -> textparser.TextParser(ParamFrame) {
  \input_value -> match textparser.run(
    textparser.any_token(),
    input_value
  ) {
    Err(error) => err_param(error),
    Ok(name) => textparser.run(
      text_param_after_name(name.value),
      textparser.with_state(input_value, name.state)
    ),
  }
}

fn parse_text_param(
  current: combinator.ParseState,
  source: textlex.TextTokenStream
) -> combinator.Parser(ParamFrame) {
  run_text_parser(text_param_parser(), current, source, 0)
}

fn param_from_annotation_frame(
  name: token.Token,
  annotation: TypeAnnotationFrame
) -> ParamFrame {
  param_frame(
    ast.param(
      token.token_score(name),
      annotation.annotation,
      false
    ),
    annotation.consumed + 2
  )
}

fn text_param_list_continue(
  input_value: textparser.TextInput,
  parsed: ParamFrame,
  current: ParamListFrame
) -> combinator.Parser(ParamListFrame) {
  let with_param = push_param_frame(current, parsed, 0);
  match punctuation_matches(
    input_value.source,
    input_value.state.cursor,
    textlex.PunctComma
  ) {
    true => match textparser.run(
      textparser.expect_punctuation(textlex.PunctComma),
      input_value
    ) {
      Err(error) => Err(error),
      Ok(comma) => text_param_list_loop(
        textparser.with_state(input_value, comma.state),
        param_list_frame(
          with_param.params,
          with_param.count,
          with_param.consumed + 1
        )
      ),
    },
    false => combinator.ok(input_value.state, with_param),
  }
}

fn text_param_list_loop(
  input_value: textparser.TextInput,
  current: ParamListFrame
) -> combinator.Parser(ParamListFrame) {
  match punctuation_matches(
    input_value.source,
    input_value.state.cursor,
    textlex.PunctRightParen
  ) {
    true => combinator.ok(input_value.state, current),
    false => match textparser.run(text_param_parser(), input_value) {
      Err(error) => Err(error),
      Ok(parsed) => text_param_list_continue(
        textparser.with_state(input_value, parsed.state),
        parsed.value,
        current
      ),
    },
  }
}

fn text_param_list_parser() -> textparser.TextParser(ParamListFrame) {
  \input_value -> text_param_list_loop(input_value, empty_param_list())
}

fn find_text_punctuation(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  expected: textlex.TextPunctuation
) -> i32 {
  find_text_punctuation_score(
    source,
    index,
    limit,
    textlex.punctuation_score(expected)
  )
}

fn find_text_punctuation_score(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  expected_score: i32
) -> i32 {
  text_punctuation_scan_loop(
    source,
    limit,
    text_punctuation_scan(index, false, limit, expected_score)
  )
}

fn text_punctuation_scan_step(
  source: textlex.TextTokenStream,
  limit: i32,
  scan: TextPunctuationScan
) -> TextPunctuationScan {
  match scan.done {
    true => scan,
    false => match scan.index < limit {
      false => text_punctuation_scan(
        scan.index,
        true,
        limit,
        scan.expected_score
      ),
      true => match punctuation_score_matches(
        source,
        scan.index,
        scan.expected_score
      ) {
        true => text_punctuation_scan(
          scan.index,
          true,
          scan.index,
          scan.expected_score
        ),
        false => text_punctuation_scan(
          scan.index + 1,
          false,
          limit,
          scan.expected_score
        ),
      },
    },
  }
}

fn text_punctuation_scan_loop(
  source: textlex.TextTokenStream,
  limit: i32,
  scan: TextPunctuationScan
) -> i32 {
  match scan.done {
    true => scan.result,
    false => rec(
      source,
      limit,
      text_punctuation_scan_step(source, limit, scan)
    ),
  }
}

fn text_balanced_punctuation_next_depth(
  actual_score: i32,
  scan: TextBalancedPunctuationScan
) -> i32 {
  match actual_score == scan.open_score {
    true => scan.depth + 1,
    false => match actual_score == scan.close_score {
      true => match scan.depth > 0 {
        true => scan.depth - 1,
        false => 0,
      },
      false => scan.depth,
    },
  }
}

fn text_balanced_punctuation_scan_step(
  source: textlex.TextTokenStream,
  limit: i32,
  scan: TextBalancedPunctuationScan
) -> TextBalancedPunctuationScan {
  match scan.done {
    true => scan,
    false => match scan.index < limit {
      false => TextBalancedPunctuationScan {
        index: scan.index,
        depth: scan.depth,
        done: true,
        result: limit,
        open_score: scan.open_score,
        close_score: scan.close_score,
      },
      true => match punctuation_score_matches(
        source,
        scan.index,
        scan.close_score
      ) {
        true => match scan.depth == 0 {
          true => TextBalancedPunctuationScan {
            index: scan.index,
            depth: scan.depth,
            done: true,
            result: scan.index,
            open_score: scan.open_score,
            close_score: scan.close_score,
          },
          false => TextBalancedPunctuationScan {
            index: scan.index + 1,
            depth: scan.depth - 1,
            done: false,
            result: limit,
            open_score: scan.open_score,
            close_score: scan.close_score,
          },
        },
        false => TextBalancedPunctuationScan {
          index: scan.index + 1,
          depth: text_balanced_punctuation_next_depth(
            textlex.punctuation_score(textlex.punctuation_at(source, scan.index)),
            scan
          ),
          done: false,
          result: limit,
          open_score: scan.open_score,
          close_score: scan.close_score,
        },
      },
    },
  }
}

fn text_balanced_punctuation_scan_loop(
  source: textlex.TextTokenStream,
  limit: i32,
  scan: TextBalancedPunctuationScan
) -> i32 {
  match scan.done {
    true => scan.result,
    false => rec(
      source,
      limit,
      text_balanced_punctuation_scan_step(source, limit, scan)
    ),
  }
}

fn find_text_balanced_punctuation_score(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  open_score: i32,
  close_score: i32
) -> i32 {
  text_balanced_punctuation_scan_loop(
    source,
    limit,
    TextBalancedPunctuationScan {
      index: index,
      depth: 0,
      done: false,
      result: limit,
      open_score: open_score,
      close_score: close_score,
    }
  )
}

fn find_text_right_brace(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  _depth: i32
) -> i32 {
  find_text_balanced_punctuation_score(source, index, limit, 5, 6)
}

fn find_text_expression_limit(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  expected: textlex.TextPunctuation
) -> i32 {
  match expected {
    PunctRightBrace => find_text_right_brace(source, index, limit, 0),
    _ => find_text_punctuation(source, index, limit, expected),
  }
}

fn complete_text_expr_until(
  start: i32,
  close_index: i32,
  third: combinator.Parser(ExprFrame)
) -> combinator.Parser(ExprFrame) match {
  start, close_index, Ok(result) => ok_expr(
    combinator.state(close_index, result.state.limit),
    expression_frame(
      result.value.expr,
      close_index - start
    )
  ),
  start, close_index, Err(_) => ok_expr(
    combinator.state(close_index, close_index),
    expression_frame(
      ast.Missing,
      close_index - start
    )
  ),
}

fn text_expr_until_punctuation(
  seed: i32,
  expected: textlex.TextPunctuation
) -> textparser.TextParser(ExprFrame) {
  \input_value -> {
    let close_index = find_text_expression_limit(
      input_value.source,
      input_value.state.cursor,
      input_value.state.limit,
      expected
    );
    complete_text_expr_until(
      input_value.state.cursor,
      close_index,
      parse_text_expression(
        combinator.state(input_value.state.cursor, close_index),
        input_value.source,
        seed
      )
    )
  }
}

fn function_decl_from_parts(
  name: token.Token,
  params: ParamListFrame,
  return_type: TypeAnnotationFrame,
  body: ExprFrame
) -> DeclFrame {
  declaration_frame(
    ast.fn_decl(
      token.token_score(name),
      params.count,
      return_type.annotation,
      ast.block(body.expr)
    ),
    params.consumed + return_type.consumed + body.consumed + 7
  )
}

fn function_decl_from_signature(
  name: token.Token,
  param_count: i32,
  return_type: ast.TypeAnnotation,
  body: ExprFrame,
  consumed: i32
) -> DeclFrame {
  declaration_frame(
    ast.fn_decl(
      token.token_score(name),
      param_count,
      return_type,
      ast.block(body.expr)
    ),
    consumed
  )
}

fn text_function_decl_parser(seed: i32) -> textparser.TextParser(DeclFrame) {
  do @applicative(textparser.TextParser(_)) {
    textparser.expect_kind(token.FnKw, 1);
    name <- textparser.any_token();
    textparser.expect_punctuation(textlex.PunctLeftParen);
    params <- text_param_list_parser();
    textparser.expect_punctuation(textlex.PunctRightParen);
    textparser.expect_punctuation(textlex.PunctArrow);
    return_type <- text_type_annotation_parser();
    textparser.expect_punctuation(textlex.PunctLeftBrace);
    body <- text_expr_until_punctuation(seed, textlex.PunctRightBrace);
    textparser.expect_punctuation(textlex.PunctRightBrace);
    pure(function_decl_from_parts(name, params, return_type, body))
  }
}

fn pub_function_decl_from_frame(fn_decl: DeclFrame) -> DeclFrame {
  declaration_frame(fn_decl.decl, fn_decl.consumed + 1)
}

fn text_function_name_index(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  match text_declaration_start(source, index) {
    TextPubFunctionDeclaration => index + 2,
    _ => index + 1,
  }
}

fn find_text_matching_right_paren(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  _depth: i32
) -> i32 {
  find_text_balanced_punctuation_score(source, index, limit, 2, 3)
}

fn text_param_count_scan(
  index: i32,
  paren_depth: i32,
  separators: i32,
  saw_param: bool
) -> TextParamCountScan {
  TextParamCountScan {
    index: index,
    paren_depth: paren_depth,
    separators: separators,
    saw_param: saw_param,
  }
}

fn count_text_param_scan_step(
  source: textlex.TextTokenStream,
  close_index: i32,
  scan: TextParamCountScan
) -> TextParamCountScan {
  match scan.index >= close_index {
    true => scan,
    false => count_text_param_scan_continue(source, scan),
  }
}

fn count_text_param_scan_continue(
  source: textlex.TextTokenStream,
  scan: TextParamCountScan
) -> TextParamCountScan {
  let punctuation = textlex.punctuation_at(source, scan.index);
  let next_depth = match punctuation {
    PunctLeftParen => scan.paren_depth + 1,
    PunctRightParen => match scan.paren_depth > 0 {
      true => scan.paren_depth - 1,
      false => 0,
    },
    _ => scan.paren_depth,
  };
  let is_top_comma = match punctuation {
    PunctComma => scan.paren_depth == 0,
    _ => false,
  };
  text_param_count_scan(
    scan.index + 1,
    next_depth,
    match is_top_comma {
      true => scan.separators + 1,
      false => scan.separators,
    },
    true
  )
}

fn count_text_param_scan_loop(
  source: textlex.TextTokenStream,
  close_index: i32,
  scan: TextParamCountScan
) -> TextParamCountScan {
  match scan.index >= close_index {
    true => scan,
    false => rec(
      source,
      close_index,
      count_text_param_scan_step(source, close_index, scan)
    ),
  }
}

fn text_param_count_scan_result(scan: TextParamCountScan) -> i32 {
  match scan.saw_param {
    true => scan.separators + 1,
    false => 0,
  }
}

fn count_text_signature_params(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32
) -> i32 {
  text_param_count_scan_result(
    count_text_param_scan_loop(
      source,
      close_index,
      text_param_count_scan(open_index + 1, 0, 0, false)
    )
  )
}

fn text_no_root_call_arg_count() -> i32 {
  0
}

fn text_argument_scan_is_top_level(scan: TextArgumentCountScan) -> bool {
  match scan.paren_depth == 0 {
    true => match scan.brace_depth == 0 {
      true => scan.bracket_depth == 0,
      false => false,
    },
    false => false,
  }
}

fn text_argument_scan_bracket_delta(
  source: textlex.TextTokenStream,
  index: i32,
  current_depth: i32
) -> i32 {
  match textlex.punctuation_at(source, index) {
    PunctOther => match textlex.text_hash_at(source, index) {
      91 => current_depth + 1,
      93 => match current_depth > 0 {
        true => current_depth - 1,
        false => 0,
      },
      _ => current_depth,
    },
    _ => current_depth,
  }
}

fn text_argument_scan_next_paren_depth(
  punctuation: textlex.TextPunctuation,
  current_depth: i32
) -> i32 {
  match punctuation {
    PunctLeftParen => current_depth + 1,
    PunctRightParen => match current_depth > 0 {
      true => current_depth - 1,
      false => 0,
    },
    _ => current_depth,
  }
}

fn text_argument_scan_next_brace_depth(
  punctuation: textlex.TextPunctuation,
  current_depth: i32
) -> i32 {
  match punctuation {
    PunctLeftBrace => current_depth + 1,
    PunctRightBrace => match current_depth > 0 {
      true => current_depth - 1,
      false => 0,
    },
    _ => current_depth,
  }
}

fn text_argument_count_scan_step(
  source: textlex.TextTokenStream,
  scan: TextArgumentCountScan
) -> TextArgumentCountScan {
  let punctuation = textlex.punctuation_at(source, scan.index);
  let top_level = text_argument_scan_is_top_level(scan);
  let is_separator = match punctuation {
    PunctComma => top_level,
    _ => false,
  };
  let is_argument_token = match is_separator {
    true => false,
    false => match text_param_signature_is_trivia(source, scan.index) {
      true => false,
      false => true,
    },
  };
  TextArgumentCountScan {
    index: scan.index + 1,
    close_index: scan.close_index,
    paren_depth: text_argument_scan_next_paren_depth(
      punctuation,
      scan.paren_depth
    ),
    brace_depth: text_argument_scan_next_brace_depth(
      punctuation,
      scan.brace_depth
    ),
    bracket_depth: text_argument_scan_bracket_delta(
      source,
      scan.index,
      scan.bracket_depth
    ),
    separators: match is_separator {
      true => scan.separators + 1,
      false => scan.separators,
    },
    saw_argument: match is_argument_token {
      true => true,
      false => scan.saw_argument,
    },
  }
}

fn text_argument_count_scan_loop(
  source: textlex.TextTokenStream,
  scan: TextArgumentCountScan
) -> TextArgumentCountScan {
  match scan.index >= scan.close_index {
    true => scan,
    false => text_argument_count_scan_loop(
      source,
      text_argument_count_scan_step(source, scan)
    ),
  }
}

fn text_argument_count_scan_result(scan: TextArgumentCountScan) -> i32 {
  match scan.saw_argument {
    true => scan.separators + 1,
    false => 0,
  }
}

fn text_call_argument_count(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32
) -> i32 {
  text_argument_count_scan_result(
    text_argument_count_scan_loop(
      source,
      TextArgumentCountScan {
        index: open_index + 1,
        close_index: close_index,
        paren_depth: 0,
        brace_depth: 0,
        bracket_depth: 0,
        separators: 0,
        saw_argument: false,
      }
    )
  )
}

fn text_argument_segment_none(limit: i32) -> TextArgumentSegment {
  TextArgumentSegment {start: limit, limit: limit, found: false}
}

fn text_argument_segment_present(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> TextArgumentSegment {
  TextArgumentSegment {
    start: text_expression_start_skip_trivia(source, start, limit),
    limit: limit,
    found: true,
  }
}

fn text_argument_segment_scan_is_top_level(
  scan: TextArgumentSegmentScan
) -> bool {
  match scan.paren_depth == 0 {
    true => match scan.brace_depth == 0 {
      true => scan.bracket_depth == 0,
      false => false,
    },
    false => false,
  }
}

fn text_argument_segment_scan_finish_present(
  source: textlex.TextTokenStream,
  scan: TextArgumentSegmentScan
) -> TextArgumentSegmentScan {
  let is_target = scan.current_index == scan.target_index;
  TextArgumentSegmentScan {
    index: scan.index,
    close_index: scan.close_index,
    segment_start: scan.segment_start,
    target_index: scan.target_index,
    current_index: scan.current_index,
    paren_depth: scan.paren_depth,
    brace_depth: scan.brace_depth,
    bracket_depth: scan.bracket_depth,
    result_start: match is_target {
      true => text_expression_start_skip_trivia(
        source,
        scan.segment_start,
        scan.index
      ),
      false => scan.result_start,
    },
    result_limit: match is_target {
      true => scan.index,
      false => scan.result_limit,
    },
    segment_saw_argument: scan.segment_saw_argument,
    found: match is_target {
      true => true,
      false => scan.found,
    },
  }
}

fn text_argument_segment_scan_finish_segment(
  source: textlex.TextTokenStream,
  scan: TextArgumentSegmentScan
) -> TextArgumentSegmentScan {
  match scan.segment_saw_argument {
    true => text_argument_segment_scan_finish_present(source, scan),
    false => scan,
  }
}

fn text_argument_segment_scan_next_index(
  scan: TextArgumentSegmentScan,
  is_separator: bool
) -> i32 {
  match is_separator {
    true => match scan.segment_saw_argument {
      true => scan.current_index + 1,
      false => scan.current_index,
    },
    false => scan.current_index,
  }
}

fn text_argument_segment_scan_step(
  source: textlex.TextTokenStream,
  scan: TextArgumentSegmentScan
) -> TextArgumentSegmentScan {
  let punctuation = textlex.punctuation_at(source, scan.index);
  let top_level = text_argument_segment_scan_is_top_level(scan);
  let is_separator = match punctuation {
    PunctComma => top_level,
    _ => false,
  };
  let is_argument_token = match is_separator {
    true => false,
    false => match text_param_signature_is_trivia(source, scan.index) {
      true => false,
      false => true,
    },
  };
  let finished = match is_separator {
    true => text_argument_segment_scan_finish_segment(source, scan),
    false => scan,
  };
  TextArgumentSegmentScan {
    index: scan.index + 1,
    close_index: scan.close_index,
    segment_start: match is_separator {
      true => scan.index + 1,
      false => finished.segment_start,
    },
    target_index: finished.target_index,
    current_index: text_argument_segment_scan_next_index(scan, is_separator),
    paren_depth: text_argument_scan_next_paren_depth(
      punctuation,
      scan.paren_depth
    ),
    brace_depth: text_argument_scan_next_brace_depth(
      punctuation,
      scan.brace_depth
    ),
    bracket_depth: text_argument_scan_bracket_delta(
      source,
      scan.index,
      scan.bracket_depth
    ),
    result_start: finished.result_start,
    result_limit: finished.result_limit,
    segment_saw_argument: match is_separator {
      true => false,
      false => match is_argument_token {
        true => true,
        false => scan.segment_saw_argument,
      },
    },
    found: finished.found,
  }
}

fn text_argument_segment_scan_loop(
  source: textlex.TextTokenStream,
  scan: TextArgumentSegmentScan
) -> TextArgumentSegmentScan {
  match scan.found {
    true => scan,
    false => match scan.index >= scan.close_index {
      true => text_argument_segment_scan_finish_segment(source, scan),
      false => text_argument_segment_scan_loop(
        source,
        text_argument_segment_scan_step(source, scan)
      ),
    },
  }
}

fn text_call_argument_segment(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32,
  target_index: i32
) -> TextArgumentSegment {
  let scan = text_argument_segment_scan_loop(
    source,
    TextArgumentSegmentScan {
      index: open_index + 1,
      close_index: close_index,
      segment_start: open_index + 1,
      target_index: target_index,
      current_index: 0,
      paren_depth: 0,
      brace_depth: 0,
      bracket_depth: 0,
      result_start: close_index,
      result_limit: close_index,
      segment_saw_argument: false,
      found: false,
    }
  );
  match scan.found {
    true => text_argument_segment_present(
      source,
      scan.result_start,
      scan.result_limit
    ),
    false => text_argument_segment_none(close_index),
  }
}

fn text_slot_count_scan_step(
  source: textlex.TextTokenStream,
  scan: TextSlotCountScan
) -> TextSlotCountScan {
  let punctuation = textlex.punctuation_at(source, scan.index);
  let top_level = match scan.paren_depth == 0 {
    true => match scan.brace_depth == 0 {
      true => scan.bracket_depth == 0,
      false => false,
    },
    false => false,
  };
  let is_separator = match punctuation {
    PunctComma => top_level,
    _ => false,
  };
  let is_argument_token = match is_separator {
    true => false,
    false => match text_param_signature_is_trivia(source, scan.index) {
      true => false,
      false => true,
    },
  };
  let next_total = match is_separator {
    true => match scan.segment_saw_argument {
      true => scan.total + 1,
      false => scan.total,
    },
    false => scan.total,
  };
  let next_segment_saw_argument = match is_separator {
    true => false,
    false => match is_argument_token {
      true => true,
      false => scan.segment_saw_argument,
    },
  };
  TextSlotCountScan {
    index: scan.index + 1,
    close_index: scan.close_index,
    paren_depth: text_argument_scan_next_paren_depth(
      punctuation,
      scan.paren_depth
    ),
    brace_depth: text_argument_scan_next_brace_depth(
      punctuation,
      scan.brace_depth
    ),
    bracket_depth: text_argument_scan_bracket_delta(
      source,
      scan.index,
      scan.bracket_depth
    ),
    total: next_total,
    segment_saw_argument: next_segment_saw_argument,
  }
}

fn text_slot_count_scan_loop(
  source: textlex.TextTokenStream,
  scan: TextSlotCountScan
) -> TextSlotCountScan {
  match scan.index >= scan.close_index {
    true => scan,
    false => text_slot_count_scan_loop(
      source,
      text_slot_count_scan_step(source, scan)
    ),
  }
}

fn text_slot_count_scan_result(scan: TextSlotCountScan) -> i32 {
  match scan.segment_saw_argument {
    true => scan.total + 1,
    false => scan.total,
  }
}

fn text_slot_count(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32
) -> i32 {
  text_slot_count_scan_result(
    text_slot_count_scan_loop(
      source,
      TextSlotCountScan {
        index: open_index + 1,
        close_index: close_index,
        paren_depth: 0,
        brace_depth: 0,
        bracket_depth: 0,
        total: 0,
        segment_saw_argument: false,
      }
    )
  )
}

fn text_param_signature_next_depth(
  punctuation: textlex.TextPunctuation,
  paren_depth: i32
) -> i32 {
  match punctuation {
    PunctLeftParen => paren_depth + 1,
    PunctRightParen => match paren_depth > 0 {
      true => paren_depth - 1,
      false => 0,
    },
    _ => paren_depth,
  }
}

fn text_param_signature_is_top_comma(
  punctuation: textlex.TextPunctuation,
  paren_depth: i32
) -> bool {
  match punctuation {
    PunctComma => paren_depth == 0,
    _ => false,
  }
}

fn text_param_name_index_at(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let is_const_param = text_token_weight_matches(source, index, 19);
  let has_name = index + 1 < limit;
  match is_const_param {
    true => match has_name {
      true => index + 1,
      false => index,
    },
    false => index,
  }
}

fn text_param_signature_is_trivia(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  let current = textlex.token_at(source, index);
  let is_symbol = token.is_symbol(current.kind);
  let has_no_punctuation = punctuation_score_matches(source, index, 0);
  match is_symbol {
    true => has_no_punctuation,
    false => false,
  }
}

fn text_param_segment_start(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  text_expression_start_skip_trivia(source, index, limit)
}

fn text_param_segment_is_runtime(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> bool {
  let start = text_param_segment_start(source, index, limit);
  match start >= limit {
    true => false,
    false => match textlex.token_at(source, start).kind {
      ConstKw => false,
      _ => true,
    },
  }
}

fn text_function_param_next_comma(
  source: textlex.TextTokenStream,
  index: i32,
  close_index: i32
) -> i32 {
  text_function_param_next_comma_scan(source, index, close_index, 0)
}

fn text_function_param_next_comma_scan(
  source: textlex.TextTokenStream,
  index: i32,
  close_index: i32,
  paren_depth: i32
) -> i32 {
  match index >= close_index {
    true => close_index,
    false => textlex.punctuation_at(source, index) \punctuation -> match text_param_signature_is_top_comma(
      punctuation,
      paren_depth
    ) {
      true => index,
      false => text_function_param_next_comma_scan(
        source,
        index + 1,
        close_index,
        text_param_signature_next_depth(punctuation, paren_depth)
      ),
    },
  }
}

fn text_runtime_param_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  close_index: i32,
  total: i32
) -> i32 {
  match index >= close_index {
    true => total,
    false => text_function_param_next_comma(
      source,
      index,
      close_index
    ) \comma -> text_runtime_param_count_between(
      source,
      match comma < close_index {
        true => comma + 1,
        false => close_index,
      },
      close_index,
      match text_param_segment_is_runtime(source, index, comma) {
        true => total + 1,
        false => total,
      }
    ),
  }
}

fn text_first_runtime_param_type_class_between(
  source: textlex.TextTokenStream,
  index: i32,
  close_index: i32
) -> i32 {
  match index >= close_index {
    true => text_type_class_unknown_tag(),
    false => text_function_param_next_comma(
      source,
      index,
      close_index
    ) \comma -> match text_param_segment_is_runtime(source, index, comma) {
      true => text_param_resolved_type_class_for_segment(
        source,
        index,
        comma
      ),
      false => text_first_runtime_param_type_class_between(
        source,
        match comma < close_index {
          true => comma + 1,
          false => close_index,
        },
        close_index
      ),
    },
  }
}

fn text_function_first_runtime_param_type_class(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  text_first_runtime_param_type_class_between(
    source,
    open_paren + 1,
    close_paren
  )
}

fn text_runtime_param_index_next_index(
  comma: i32,
  close_index: i32
) -> i32 {
  match comma < close_index {
    true => comma + 1,
    false => close_index,
  }
}

fn text_runtime_param_index_next_scan(
  scan: TextRuntimeParamIndexScan,
  comma: i32,
  found_runtime: bool
) -> TextRuntimeParamIndexScan {
  text_runtime_param_index_scan(
    text_runtime_param_index_next_index(comma, scan.close_index),
    scan.close_index,
    scan.target_hash,
    match found_runtime {
      true => scan.runtime_index + 1,
      false => scan.runtime_index,
    }
  )
}

fn text_runtime_param_index_scan_step(
  source: textlex.TextTokenStream,
  scan: TextRuntimeParamIndexScan,
  comma: i32
) -> i32 {
  let is_runtime = text_param_segment_is_runtime(source, scan.index, comma);
  let name_index = text_param_name_index_at(source, scan.index, comma);
  let found = match is_runtime {
    true => textlex.text_hash_at(source, name_index) == scan.target_hash,
    false => false,
  };
  let next_scan = text_runtime_param_index_next_scan(
    scan,
    comma,
    is_runtime
  );
  match found {
    true => scan.runtime_index,
    false => text_runtime_param_index_scan_loop(
      source,
      next_scan
    ),
  }
}

fn text_runtime_param_index_scan_loop(
  source: textlex.TextTokenStream,
  scan: TextRuntimeParamIndexScan
) -> i32 {
  match scan.index >= scan.close_index {
    true => scan.runtime_index,
    false => text_function_param_next_comma(
      source,
      scan.index,
      scan.close_index
    ) \comma -> text_runtime_param_index_scan_step(
      source,
      scan,
      comma
    ),
  }
}

fn text_runtime_param_index_for_name_hash_between(
  source: textlex.TextTokenStream,
  index: i32,
  close_index: i32,
  target_hash: i32
) -> i32 {
  text_runtime_param_index_scan_loop(
    source,
    text_runtime_param_index_scan(index, close_index, target_hash, 0)
  )
}

fn text_function_runtime_param_index_for_name_hash(
  source: textlex.TextTokenStream,
  index: i32,
  target_hash: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  text_runtime_param_index_for_name_hash_between(
    source,
    open_paren + 1,
    close_paren,
    target_hash
  )
}

fn text_function_runtime_param_count(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  text_runtime_param_count_between(
    source,
    open_paren + 1,
    close_paren,
    0
  )
}

fn text_function_body_runtime_param_index(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  let target_hash = text_expression_root_identifier_hash_between(
    source,
    text_function_body_value_start_index(source, index),
    next
  );
  text_runtime_param_index_for_name_hash_between(
    source,
    open_paren + 1,
    close_paren,
    target_hash
  )
}

fn text_hash_scale(width: i32, total: i32) -> i32 {
  match width <= 0 {
    true => total,
    false => text_hash_scale(width - 1, total * 33),
  }
}

fn text_hash_append(
  total: i32,
  value_hash: i32,
  width: i32
) -> i32 {
  text_hash_scale(width, total) + value_hash
}

fn text_hash_append_token(
  source: textlex.TextTokenStream,
  index: i32,
  total: i32
) -> i32 {
  let current = textlex.token_at(source, index);
  text_hash_append(
    total,
    textlex.text_hash_at(source, index),
    span.width(current.span)
  )
}

fn text_annotation_signature_hash_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32
) -> i32 {
  match index >= limit {
    true => total,
    false => match text_param_signature_is_trivia(source, index) {
      true => text_annotation_signature_hash_between(
        source,
        index + 1,
        limit,
        total
      ),
      false => text_annotation_signature_hash_between(
        source,
        index + 1,
        limit,
        text_hash_append_token(source, index, total)
      ),
    },
  }
}

fn text_top_level_punctuation_matches(
  paren_depth: i32,
  punctuation_score: i32,
  expected_score: i32
) -> bool {
  let is_top_level = paren_depth == 0;
  match is_top_level {
    true => punctuation_score == expected_score,
    false => false,
  }
}

fn text_find_top_level_punctuation_score(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  paren_depth: i32,
  expected_score: i32
) -> i32 {
  match index >= limit {
    true => limit,
    false => textlex.punctuation_at(source, index) \punctuation -> text_top_level_punctuation_matches(
      paren_depth,
      textlex.punctuation_score(punctuation),
      expected_score
    ) \is_match -> match is_match {
      true => index,
      false => rec(
        source,
        index + 1,
        limit,
        text_param_signature_next_depth(punctuation, paren_depth),
        expected_score
      ),
    },
  }
}

fn text_param_signature_name_step(
  source: textlex.TextTokenStream,
  scan: TextParamSignatureScan
) -> i32 {
  let name_index = text_param_name_index_at(source, scan.index, scan.close_index);
  let name_hash = textlex.text_hash_at(source, name_index);
  text_param_signature_hash_between(
    source,
    text_param_signature_scan(
      scan.index + 1,
      scan.close_index,
      scan.paren_depth,
      false,
      text_signature_mix(scan.total, name_hash)
    )
  )
}

fn text_param_signature_token_continue(
  source: textlex.TextTokenStream,
  scan: TextParamSignatureScan
) -> i32 {
  let punctuation = textlex.punctuation_at(source, scan.index);
  let next_depth = text_param_signature_next_depth(punctuation, scan.paren_depth);
  let is_top_comma = text_param_signature_is_top_comma(
    punctuation,
    scan.paren_depth
  );
  match is_top_comma {
    true => text_param_signature_hash_between(
      source,
      text_param_signature_scan(
        scan.index + 1,
        scan.close_index,
        next_depth,
        true,
        scan.total
      )
    ),
    false => match scan.need_name {
      true => text_param_signature_name_step(
        source,
        text_param_signature_scan(
          scan.index,
          scan.close_index,
          next_depth,
          scan.need_name,
          scan.total
        )
      ),
      false => text_param_signature_hash_between(
        source,
        text_param_signature_scan(
          scan.index + 1,
          scan.close_index,
          next_depth,
          false,
          scan.total
        )
      ),
    },
  }
}

fn text_param_signature_continue(
  source: textlex.TextTokenStream,
  scan: TextParamSignatureScan
) -> i32 {
  match text_param_signature_is_trivia(source, scan.index) {
    true => text_param_signature_hash_between(
      source,
      text_param_signature_scan(
        scan.index + 1,
        scan.close_index,
        scan.paren_depth,
        scan.need_name,
        scan.total
      )
    ),
    false => text_param_signature_token_continue(
      source,
      scan
    ),
  }
}

fn text_param_signature_hash_between(
  source: textlex.TextTokenStream,
  scan: TextParamSignatureScan
) -> i32 {
  match scan.index >= scan.close_index {
    true => scan.total,
    false => text_param_signature_continue(
      source,
      scan
    ),
  }
}

fn text_param_signature_hash(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32,
  total: i32
) -> i32 {
  text_param_signature_hash_between(
    source,
    text_param_signature_scan(
      open_index + 1,
      close_index,
      0,
      true,
      total
    )
  )
}

fn text_param_type_signature_segment_hash(
  source: textlex.TextTokenStream,
  index: i32,
  segment_end: i32
) -> i32 {
  let colon = text_find_top_level_punctuation_score(
    source,
    index,
    segment_end,
    0,
    8
  );
  match colon < segment_end {
    true => text_annotation_signature_hash_between(
      source,
      colon + 1,
      segment_end,
      0
    ),
    false => 0,
  }
}

fn text_param_type_signature_hash_continue(
  source: textlex.TextTokenStream,
  index: i32,
  close_index: i32,
  total: i32
) -> i32 {
  let comma = text_find_top_level_punctuation_score(
    source,
    index,
    close_index,
    0,
    7
  );
  let type_hash = text_param_type_signature_segment_hash(
    source,
    index,
    comma
  );
  let next_index = match comma < close_index {
    true => comma + 1,
    false => close_index,
  };
  text_param_type_signature_hash_between(
    source,
    next_index,
    close_index,
    text_signature_mix(total, type_hash)
  )
}

fn text_param_type_signature_hash_between(
  source: textlex.TextTokenStream,
  index: i32,
  close_index: i32,
  total: i32
) -> i32 {
  match index >= close_index {
    true => total,
    false => text_param_type_signature_hash_continue(
      source,
      index,
      close_index,
      total
    ),
  }
}

fn text_param_type_signature_hash(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32,
  total: i32
) -> i32 {
  text_param_type_signature_hash_between(
    source,
    open_index + 1,
    close_index,
    total
  )
}

fn type_annotation_from_range(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> ast.TypeAnnotation {
  match start < limit {
    true => ast.named_type(token.token_score(textlex.token_at(source, start))),
    false => ast.missing_type(),
  }
}

fn parse_text_function_body_expr(
  source: textlex.TextTokenStream,
  seed: i32,
  left_brace: i32,
  right_brace: i32
) -> ExprFrame {
  match parse_text_expression(
    combinator.state(left_brace + 1, right_brace),
    source,
    seed
  ) {
    Ok(result) => expression_frame(result.value.expr, right_brace - left_brace - 1),
    Err(_) => expression_frame(ast.Missing, right_brace - left_brace - 1),
  }
}

fn parse_text_function_boundary(
  current: combinator.ParseState,
  source: textlex.TextTokenStream,
  seed: i32
) -> combinator.Parser(DeclFrame) {
  let start = text_declaration_start(source, current.cursor);
  let width = text_declaration_start_width(start, source, current.cursor);
  let next = text_declaration_end_index(
    source,
    current.limit,
    text_token_line(source, current.cursor),
    TextDeclarationScan {
      index: current.cursor + width,
      brace_depth: 0,
      paren_depth: 0,
      entered_brace: false,
      done: false,
      result: current.limit,
    }
  );
  let name = textlex.token_at(source, text_function_name_index(source, current.cursor));
  let open_paren = find_text_punctuation_score(
    source,
    current.cursor + width,
    next,
    2
  );
  let close_paren = find_text_matching_right_paren(
    source,
    open_paren + 1,
    next,
    0
  );
  let arrow = find_text_punctuation_score(
    source,
    close_paren + 1,
    next,
    4
  );
  let left_brace = find_text_punctuation_score(
    source,
    arrow + 1,
    next,
    5
  );
  let right_brace = find_text_expression_limit(
    source,
    left_brace + 1,
    next,
    textlex.PunctRightBrace
  );
  ok_decl(
    combinator.state(next, current.limit),
    function_decl_from_signature(
      name,
      count_text_signature_params(source, open_paren, close_paren),
      type_annotation_from_range(source, arrow + 1, left_brace),
      parse_text_function_body_expr(source, seed, left_brace, right_brace),
      next - current.cursor
    )
  )
}

fn text_function_open_paren_index(
  source: textlex.TextTokenStream,
  index: i32,
  next: i32
) -> i32 {
  let start = text_declaration_start(source, index);
  let width = text_declaration_start_width(start, source, index);
  find_text_punctuation_score(
    source,
    index + width,
    next,
    2
  )
}

fn text_function_close_paren_index(
  source: textlex.TextTokenStream,
  open_paren: i32,
  next: i32
) -> i32 {
  find_text_matching_right_paren(
    source,
    open_paren + 1,
    next,
    0
  )
}

fn text_function_arrow_index(
  source: textlex.TextTokenStream,
  close_paren: i32,
  next: i32
) -> i32 {
  find_text_punctuation_score(
    source,
    close_paren + 1,
    next,
    4
  )
}

fn text_function_left_brace_index(
  source: textlex.TextTokenStream,
  arrow: i32,
  next: i32
) -> i32 {
  find_text_punctuation_score(
    source,
    arrow + 1,
    next,
    5
  )
}

fn text_function_body_start_index(
  source: textlex.TextTokenStream,
  arrow: i32,
  left_brace: i32
) -> i32 {
  let previous = left_brace - 1;
  match text_token_weight_matches(source, previous, 31) {
    true => previous,
    false => left_brace,
  }
}

fn text_function_param_signature_hash(
  source: textlex.TextTokenStream,
  index: i32,
  total: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  text_param_signature_hash(source, open_paren, close_paren, total)
}

fn text_function_param_type_signature_hash(
  source: textlex.TextTokenStream,
  index: i32,
  total: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  text_param_type_signature_hash(source, open_paren, close_paren, total)
}

fn text_function_return_signature_hash(
  source: textlex.TextTokenStream,
  index: i32,
  total: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  let arrow = text_function_arrow_index(source, close_paren, next);
  let left_brace = text_function_left_brace_index(source, arrow, next);
  let body_start = text_function_body_start_index(source, arrow, left_brace);
  let return_hash = text_annotation_signature_hash_between(
    source,
    arrow + 1,
    body_start,
    0
  );
  text_signature_mix(total, return_hash)
}

fn text_function_body_signature_hash(
  source: textlex.TextTokenStream,
  index: i32,
  total: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  let arrow = text_function_arrow_index(source, close_paren, next);
  let left_brace = text_function_left_brace_index(source, arrow, next);
  let body_start = text_function_body_start_index(source, arrow, left_brace);
  let right_brace = find_text_expression_limit(
    source,
    left_brace + 1,
    next,
    textlex.PunctRightBrace
  );
  let body_hash = text_annotation_signature_hash_between(
    source,
    body_start,
    right_brace + 1,
    0
  );
  text_signature_mix(total, body_hash)
}

fn text_function_local_keyword_next_total(
  source: textlex.TextTokenStream,
  index: i32,
  brace_depth: i32,
  paren_depth: i32,
  expected: token.TokenKind,
  total: i32
) -> i32 {
  let is_top_level = text_depth_is_top_level(brace_depth, paren_depth);
  let is_expected = text_token_kind_matches(source, index, expected);
  match is_top_level {
    true => match is_expected {
      true => total + 1,
      false => total,
    },
    false => total,
  }
}

fn text_function_local_keyword_count_between(
  source: textlex.TextTokenStream,
  scan: TextFunctionLocalLetScan,
  expected: token.TokenKind
) -> i32 {
  if scan.index >= scan.limit {
    scan.total
  } else {
    let next_total = text_function_local_keyword_next_total(
      source,
      scan.index,
      scan.brace_depth,
      scan.paren_depth,
      expected,
      scan.total
    );
    let next_brace_depth = brace_depth_after_token(source, scan.index, scan.brace_depth);
    let next_paren_depth = paren_depth_after_token(source, scan.index, scan.paren_depth);
    text_function_local_keyword_count_between(
      source,
      text_function_local_let_scan(
        scan.index + 1,
        scan.limit,
        next_brace_depth,
        next_paren_depth,
        next_total
      ),
      expected
    )
  }
}

fn text_function_local_keyword_count(
  source: textlex.TextTokenStream,
  index: i32,
  expected: token.TokenKind
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  let arrow = text_function_arrow_index(source, close_paren, next);
  let left_brace = text_function_left_brace_index(source, arrow, next);
  let right_brace = find_text_expression_limit(
    source,
    left_brace + 1,
    next,
    textlex.PunctRightBrace
  );
  text_function_local_keyword_count_between(
    source,
    text_function_local_let_scan(
      left_brace + 1,
      right_brace,
      0,
      0,
      0
    ),
    expected
  )
}

fn text_function_local_let_count(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  text_function_local_keyword_count(source, index, token.LetKw)
}

fn text_static_marker_hash() -> i32 {
  textlex.TextCharCode::StaticMarker
}

fn text_require_hash() -> i32 {
  994499709
}

fn text_type_assert_token_matches(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> bool {
  let has_name = index + 1 < limit;
  match has_name {
    false => false,
    true => match punctuation_matches(source, index, textlex.PunctOther) {
      false => false,
      true => match textlex.text_hash_at(source, index) == text_static_marker_hash() {
        false => false,
        true => match text_token_weight_matches(
          source,
          index + 1,
          token.TokenKindWeight::Identifier
        ) {
          false => false,
          true => textlex.text_hash_at(source, index + 1) == text_require_hash(),
        },
      },
    },
  }
}

fn text_function_local_type_assert_next_total(
  source: textlex.TextTokenStream,
  scan: TextFunctionLocalLetScan
) -> i32 {
  let top_level = text_depth_is_top_level(scan.brace_depth, scan.paren_depth);
  match top_level {
    false => scan.total,
    true => match text_type_assert_token_matches(source, scan.index, scan.limit) {
      true => scan.total + 1,
      false => scan.total,
    },
  }
}

fn text_function_local_type_assert_count_between(
  source: textlex.TextTokenStream,
  scan: TextFunctionLocalLetScan
) -> i32 {
  if scan.index >= scan.limit {
    scan.total
  } else {
    let next_total = text_function_local_type_assert_next_total(source, scan);
    let next_brace_depth = brace_depth_after_token(source, scan.index, scan.brace_depth);
    let next_paren_depth = paren_depth_after_token(source, scan.index, scan.paren_depth);
    rec(
      source,
      text_function_local_let_scan(
        scan.index + 1,
        scan.limit,
        next_brace_depth,
        next_paren_depth,
        next_total
      )
    )
  }
}

fn text_function_local_type_assert_count(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  let arrow = text_function_arrow_index(source, close_paren, next);
  let left_brace = text_function_left_brace_index(source, arrow, next);
  let right_brace = find_text_expression_limit(
    source,
    left_brace + 1,
    next,
    textlex.PunctRightBrace
  );
  text_function_local_type_assert_count_between(
    source,
    text_function_local_let_scan(
      left_brace + 1,
      right_brace,
      0,
      0,
      0
    )
  )
}

fn text_local_let_name_hash(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  match textlex.token_at(source, index + 1).kind {
    Identifier => textlex.text_hash_at(source, index + 1),
    _ => 0,
  }
}

fn text_function_local_let_index_found(
  source: textlex.TextTokenStream,
  scan: TextFunctionLocalLetScan,
  target_hash: i32
) -> bool {
  let is_top_level = text_depth_is_top_level(scan.brace_depth, scan.paren_depth);
  let is_let = text_token_kind_matches(source, scan.index, token.LetKw);
  let has_target = target_hash != 0;
  match is_top_level {
    true => match is_let {
      true => match has_target {
        true => text_local_let_name_hash(source, scan.index) == target_hash,
        false => false,
      },
      false => false,
    },
    false => false,
  }
}

fn text_function_local_let_index_next_total(
  source: textlex.TextTokenStream,
  scan: TextFunctionLocalLetScan
) -> i32 {
  let is_top_level = text_depth_is_top_level(scan.brace_depth, scan.paren_depth);
  let is_let = text_token_kind_matches(source, scan.index, token.LetKw);
  match is_top_level {
    true => match is_let {
      true => scan.total + 1,
      false => scan.total,
    },
    false => scan.total,
  }
}

fn text_function_local_let_index_next_scan(
  source: textlex.TextTokenStream,
  scan: TextFunctionLocalLetScan
) -> TextFunctionLocalLetScan {
  text_function_local_let_scan(
    scan.index + 1,
    scan.limit,
    brace_depth_after_token(source, scan.index, scan.brace_depth),
    paren_depth_after_token(source, scan.index, scan.paren_depth),
    text_function_local_let_index_next_total(source, scan)
  )
}

fn text_function_local_let_index_between(
  source: textlex.TextTokenStream,
  scan: TextFunctionLocalLetScan,
  target_hash: i32
) -> i32 {
  match scan.index >= scan.limit {
    true => scan.total,
    false => match text_function_local_let_index_found(
      source,
      scan,
      target_hash
    ) {
      true => scan.total,
      false => rec(
        source,
        text_function_local_let_index_next_scan(source, scan),
        target_hash
      ),
    },
  }
}

fn text_function_local_let_bounds_scan(
  source: textlex.TextTokenStream,
  index: i32
) -> TextFunctionLocalLetScan {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  let arrow = text_function_arrow_index(source, close_paren, next);
  let left_brace = text_function_left_brace_index(source, arrow, next);
  let body_start = text_function_body_value_start_index(source, index);
  text_function_local_let_scan(
    left_brace + 1,
    body_start,
    0,
    0,
    0
  )
}

fn text_function_local_let_index_for_name_hash(
  source: textlex.TextTokenStream,
  index: i32,
  target_hash: i32
) -> i32 {
  text_function_local_let_index_between(
    source,
    text_function_local_let_bounds_scan(source, index),
    target_hash
  )
}

fn text_function_local_let_index_matches(
  source: textlex.TextTokenStream,
  scan: TextFunctionLocalLetScan,
  target_index: i32
) -> bool {
  let is_top_level = text_depth_is_top_level(scan.brace_depth, scan.paren_depth);
  let is_let = text_token_kind_matches(source, scan.index, token.LetKw);
  match is_top_level {
    false => false,
    true => match is_let {
      true => scan.total == target_index,
      false => false,
    },
  }
}

fn text_function_local_let_value_segment_at(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> TextArgumentSegment {
  let statement_end = text_local_let_statement_end(source, index, limit);
  let equal = text_local_let_equal_index(source, index, statement_end);
  match equal < statement_end {
    true => text_argument_segment_present(
      source,
      equal + 1,
      statement_end
    ),
    false => text_argument_segment_none(limit),
  }
}

fn text_function_local_let_value_segment_for_index_between(
  source: textlex.TextTokenStream,
  scan: TextFunctionLocalLetScan,
  target_index: i32
) -> TextArgumentSegment {
  match scan.index >= scan.limit {
    true => text_argument_segment_none(scan.limit),
    false => match text_function_local_let_index_matches(
      source,
      scan,
      target_index
    ) {
      true => text_function_local_let_value_segment_at(
        source,
        scan.index,
        scan.limit
      ),
      false => rec(
        source,
        text_function_local_let_index_next_scan(source, scan),
        target_index
      ),
    },
  }
}

fn text_function_local_let_value_segment_for_index(
  source: textlex.TextTokenStream,
  index: i32,
  target_index: i32
) -> TextArgumentSegment {
  text_function_local_let_value_segment_for_index_between(
    source,
    text_function_local_let_bounds_scan(source, index),
    target_index
  )
}

fn text_function_body_local_let_index(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let target_hash = text_expression_root_identifier_hash_between(
    source,
    text_function_body_value_start_index(source, index),
    next
  );
  text_function_local_let_index_for_name_hash(source, index, target_hash)
}

fn text_local_let_statement_end_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  brace_depth: i32,
  paren_depth: i32
) -> i32 {
  match index >= limit {
    true => limit,
    false => textlex.punctuation_at(source, index) \punctuation -> match text_depth_is_top_level(
      brace_depth,
      paren_depth
    ) {
      true => match punctuation {
        PunctSemicolon => index,
        _ => text_local_let_statement_end_between(
          source,
          index + 1,
          limit,
          brace_depth_after_token(source, index, brace_depth),
          paren_depth_after_token(source, index, paren_depth)
        ),
      },
      false => text_local_let_statement_end_between(
        source,
        index + 1,
        limit,
        brace_depth_after_token(source, index, brace_depth),
        paren_depth_after_token(source, index, paren_depth)
      ),
    },
  }
}

fn text_local_let_statement_end(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  text_local_let_statement_end_between(source, index, limit, 0, 0)
}

fn text_local_let_equal_index(
  source: textlex.TextTokenStream,
  index: i32,
  statement_end: i32
) -> i32 {
  text_find_top_level_punctuation_score(
    source,
    index + 1,
    statement_end,
    0,
    textlex.punctuation_score(textlex.PunctEqual)
  )
}

fn text_local_let_annotation_type_class(
  source: textlex.TextTokenStream,
  index: i32,
  equal: i32
) -> i32 {
  let colon = text_find_top_level_punctuation_score(
    source,
    index + 1,
    equal,
    0,
    textlex.punctuation_score(textlex.PunctColon)
  );
  match colon < equal {
    true => text_annotation_resolved_type_class_tag_between(
      source,
      colon + 1,
      equal
    ),
    false => text_type_class_unknown_tag(),
  }
}

fn text_function_scalar_operator_type_class_between(
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let parts = text_expression_root_single_operator_parts_between(
    source,
    start,
    limit
  );
  match parts.found {
    false => text_type_class_unknown_tag(),
    true => text_scalar_operator_type_class_from_parts(
      parts.operator_hash,
      text_function_scalar_operator_operand_type_class(
        source,
        function_index,
        parts.left_start,
        parts.left_limit
      ),
      text_function_scalar_operator_operand_type_class(
        source,
        function_index,
        parts.right_start,
        parts.right_limit
      )
    ),
  }
}

fn text_function_local_value_resolved_type_class(
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let root_type = text_expression_root_type_class_tag_between(
    source,
    start,
    limit
  );
  match root_type == text_type_class_unknown_tag() {
    false => root_type,
    true => text_expression_root_identifier_hash_between(
      source,
      start,
      limit
    ) \target_hash -> text_function_param_resolved_type_class_for_name_hash(
      source,
      function_index,
      target_hash
    ) \param_type -> match param_type == text_type_class_unknown_tag() {
      false => param_type,
      true => text_function_scalar_operator_type_class_between(
        source,
        function_index,
        start,
        limit
      ) \operator_type -> match operator_type == text_type_class_unknown_tag() {
        false => operator_type,
        true => text_function_scalar_branch_type_class_between(
          source,
          function_index,
          start,
          limit
        ) \branch_type -> match branch_type == text_type_class_unknown_tag() {
          false => branch_type,
          true => text_root_call_return_type_class_for_hash_between(
            source,
            start,
            limit,
            text_expression_root_head_hash_between(source, start, limit)
          ),
        },
      },
    },
  }
}

fn text_function_local_let_resolved_type_class_at(
  source: textlex.TextTokenStream,
  function_index: i32,
  index: i32,
  statement_end: i32
) -> i32 {
  let equal = text_local_let_equal_index(source, index, statement_end);
  match equal < statement_end {
    false => text_type_class_unknown_tag(),
    true => text_local_let_annotation_type_class(
      source,
      index,
      equal
    ) \annotation_type -> match annotation_type == text_type_class_unknown_tag() {
      false => annotation_type,
      true => text_local_let_statement_end(
        source,
        equal + 1,
        statement_end
      ) \value_end -> text_function_local_value_resolved_type_class(
        source,
        function_index,
        equal + 1,
        value_end
      ),
    },
  }
}

fn text_function_local_let_resolved_type_class_for_name_hash_between(
  source: textlex.TextTokenStream,
  function_index: i32,
  scan: TextFunctionLocalLetScan,
  target_hash: i32
) -> i32 {
  match scan.index >= scan.limit {
    true => text_type_class_unknown_tag(),
    false => match text_function_local_let_index_found(
      source,
      scan,
      target_hash
    ) {
      true => text_function_local_let_resolved_type_class_at(
        source,
        function_index,
        scan.index,
        text_local_let_statement_end(source, scan.index, scan.limit)
      ),
      false => rec(
        source,
        function_index,
        text_function_local_let_index_next_scan(source, scan),
        target_hash
      ),
    },
  }
}

fn text_function_local_let_resolved_type_class_for_name_hash(
  source: textlex.TextTokenStream,
  index: i32,
  target_hash: i32
) -> i32 {
  text_function_local_let_resolved_type_class_for_name_hash_between(
    source,
    index,
    text_function_local_let_bounds_scan(source, index),
    target_hash
  )
}

fn text_value_match_token_matches(
  source: textlex.TextTokenStream,
