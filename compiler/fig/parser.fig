fn text_expression_root_child_record_signature_between_state(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  parent_kind_tag: i32,
  parent_name_hash: i32,
  child_index: i32,
  total: i32
) -> TextRootChildRecordState {
  let start = text_expression_start_skip_trivia(source, index, limit);
  match start >= limit {
    true => TextRootChildRecordState {
      child_index: child_index,
      total: total,
    },
    false => text_root_pipe_bind_index_from_start(source, start, limit) \pipe_index -> match pipe_index < limit {
      true => text_expression_root_pipe_child_record_state(
        source,
        start,
        limit,
        pipe_index,
        parent_kind_tag,
        parent_name_hash,
        child_index,
        total
      ),
      false => match textlex.token_at(source, start).kind {
        MatchKw => text_root_match_child_record_state_between(
          source,
          start,
          limit,
          parent_kind_tag,
          parent_name_hash,
          child_index,
          total
        ),
        IfKw => text_root_if_child_record_state_between(
          source,
          start,
          limit,
          parent_kind_tag,
          parent_name_hash,
          child_index,
          total
        ),
        DoKw => text_root_do_child_record_state_between(
          source,
          start,
          limit,
          parent_kind_tag,
          parent_name_hash,
          child_index,
          total
        ),
        _ => match textlex.punctuation_at(source, start) {
          PunctLeftBrace => find_text_right_brace(
            source,
            start + 1,
            limit,
            0
          ) \close_index -> match close_index < limit {
            true => text_root_child_record_state_in_delimiters(
              source,
              start,
              close_index,
              parent_kind_tag,
              parent_name_hash,
              text_root_child_slot_role_tag(),
              child_index,
              total
            ),
            false => TextRootChildRecordState {
              child_index: child_index,
              total: total,
            },
          },
          _ => match text_head_segment_token_matches(source, start) {
            false => TextRootChildRecordState {
              child_index: child_index,
              total: total,
            },
            true => text_root_call_open_after_head(source, start, limit) \open_index -> match open_index < limit {
              true => find_text_matching_right_paren(
                source,
                open_index + 1,
                limit,
                0
              ) \close_index -> match close_index < limit {
                true => text_root_child_record_state_in_delimiters(
                  source,
                  open_index,
                  close_index,
                  parent_kind_tag,
                  parent_name_hash,
                  text_root_child_call_role_tag(),
                  child_index,
                  total
                ),
                false => TextRootChildRecordState {
                  child_index: child_index,
                  total: total,
                },
              },
              false => text_root_slot_open_after_head(source, start, limit) \slot_open -> match slot_open < limit {
                false => TextRootChildRecordState {
                  child_index: child_index,
                  total: total,
                },
                true => find_text_right_brace(
                  source,
                  slot_open + 1,
                  limit,
                  0
                ) \close_index -> match close_index < limit {
                  true => text_root_child_record_state_in_delimiters(
                    source,
                    slot_open,
                    close_index,
                    parent_kind_tag,
                    parent_name_hash,
                    text_root_child_slot_role_tag(),
                    child_index,
                    total
                  ),
                  false => TextRootChildRecordState {
                    child_index: child_index,
                    total: total,
                  },
                },
              },
            },
          },
        },
      },
    },
  }
}

