  )
}

fn text_declaration_shape_name_token_count_reader() -> monad.Reader(
  TextValueBodyContext,
  i32
) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    source <- monad.Reader::asks(text_value_body_context_source);
    window <- text_declaration_shape_name_token_window_reader();
    pure(text_value_name_token_count_between(
      source,
      window.start,
      window.limit,
      0
    ))
  }
}

fn text_declaration_shape_name_token_signature_reader(
  total: i32
) -> monad.Reader(TextValueBodyContext, i32) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    source <- monad.Reader::asks(text_value_body_context_source);
