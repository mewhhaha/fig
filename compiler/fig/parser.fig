}

fn text_value_match_token_matches(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match textlex.token_at(source, index).kind {
    MatchKw => true,
    IfKw => text_value_if_token_matches(source, index),
    _ => false,
  }
}

fn text_value_match_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32
) -> i32 {
  text_value_body_count_scan(source, index, limit, total, TextValueBodyMatchCount)
}

