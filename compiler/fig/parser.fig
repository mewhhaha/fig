fn text_function_local_let_direct_import_type_class_for_name_hash_between(
  context: TextDirectImportContext,
  function_index: i32,
  scan: TextFunctionLocalLetScan,
  target_hash: i32
) -> i32 {
  match scan.index >= scan.limit {
    true => text_type_class_unknown_tag(),
    false => match text_function_local_let_index_found(
      context.source,
      scan,
      target_hash
    ) {
      true => text_function_local_let_direct_import_resolved_type_class_at(
        context,
        function_index,
        scan.index,
        text_local_let_statement_end(context.source, scan.index, scan.limit)
      ),
      false => rec(
        context,
        function_index,
        text_function_local_let_index_next_scan(context.source, scan),
        target_hash
      ),
    },
  }
}

fn text_function_local_let_direct_import_type_class_for_name_hash(
  context: TextDirectImportContext,
  index: i32,
  target_hash: i32
) -> i32 {
  text_function_local_let_direct_import_type_class_for_name_hash_between(
    context,
    index,
