fn text_root_match_descendant_count_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> i32 {
  let open_index = text_root_match_body_open_between(source, start, limit);
  match open_index < limit {
    false => 0,
    true => find_text_right_brace(source, open_index + 1, limit, 0) \close_index -> match close_index < limit {
      true => text_expression_start_skip_trivia(
        source,
        start + 1,
        open_index
      ) \value_start -> match value_start < open_index {
        true => 1
          + text_match_values_descendant_count_between(
            source,
            value_start,
            open_index
          )
          + text_root_match_descendant_count_in_block(
            source,
            open_index,
            close_index
          ),
        false => text_root_match_descendant_count_in_block(
          source,
          open_index,
          close_index
        ),
      },
      false => 0,
    },
  }
}

fn text_root_match_descendant_signature_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  total: i32
) -> i32 {
  let open_index = text_root_match_body_open_between(source, start, limit);
  match open_index < limit {
    false => total,
    true => find_text_right_brace(source, open_index + 1, limit, 0) \close_index -> match close_index < limit {
      true => text_expression_start_skip_trivia(
        source,
        start + 1,
        open_index
      ) \value_start -> text_root_match_descendant_signature_in_block(
        source,
        open_index,
        close_index,
        match value_start < open_index {
          true => text_match_values_descendant_signature_between(
            source,
            value_start,
            open_index,
            text_match_values_segment_signature(
              source,
              value_start,
              open_index,
              total
            )
          ),
          false => total,
        }
      ),
      false => total,
    },
  }
}

fn text_root_match_child_record_state_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  parent_kind_tag: i32,
  parent_name_hash: i32,
  child_index: i32,
  total: i32
) -> TextRootChildRecordState {
  let open_index = text_root_match_body_open_between(source, start, limit);
  match open_index < limit {
    false => TextRootChildRecordState {
      child_index: child_index,
      total: total,
    },
    true => find_text_right_brace(source, open_index + 1, limit, 0) \close_index -> match close_index < limit {
      true => text_expression_start_skip_trivia(
        source,
        start + 1,
        open_index
      ) \value_start -> text_match_values_child_record_state_between(
        source,
        value_start,
        open_index,
        parent_kind_tag,
        parent_name_hash,
        child_index,
        text_root_child_match_scrutinee_role_tag(),
        total
      ) \after_value -> text_root_match_child_record_state_in_block(
        source,
        open_index,
        close_index,
        parent_kind_tag,
        parent_name_hash,
        after_value.child_index,
        after_value.total
      ),
      false => TextRootChildRecordState {
        child_index: child_index,
        total: total,
      },
    },
  }
}

fn text_bool_literal_true_hash() -> i32 {
  4296800
}

fn text_bool_literal_false_hash() -> i32 {
  124571339
}

fn text_wildcard_pattern_hash() -> i32 {
  95
}

fn text_bool_branch_segments_missing(limit: i32) -> TextBoolBranchSegments {
  TextBoolBranchSegments {
    found: false,
    condition_start: limit,
    condition_limit: limit,
    true_value_start: limit,
    true_value_limit: limit,
    false_value_start: limit,
    false_value_limit: limit,
  }
}

fn text_bool_branch_segments_present(
  condition_start: i32,
  condition_limit: i32,
  true_value_start: i32,
  true_value_limit: i32,
  false_value_start: i32,
  false_value_limit: i32
) -> TextBoolBranchSegments {
  TextBoolBranchSegments {
    found: true,
    condition_start: condition_start,
    condition_limit: condition_limit,
    true_value_start: true_value_start,
    true_value_limit: true_value_limit,
    false_value_start: false_value_start,
    false_value_limit: false_value_limit,
  }
}

fn text_bool_match_arm_segment_missing(
  limit: i32
) -> TextBoolMatchArmSegment {
  TextBoolMatchArmSegment {
    found: false,
    pattern_hash: 0,
    value_start: limit,
    value_limit: limit,
    next_index: limit,
  }
}

fn text_bool_match_top_level_arrow(
  source: textlex.TextTokenStream,
  scan: TextBoolMatchTokenScan
) -> i32 {
  match scan.index >= scan.limit {
    true => scan.limit,
    false => text_depth_is_top_level(scan.brace_depth, scan.paren_depth) \top_level -> match top_level {
      true => match scan.bracket_depth == 0 {
        true => match text_value_match_arm_token_matches(source, scan.index) {
          true => scan.index,
          false => text_bool_match_top_level_arrow(
            source,
            TextBoolMatchTokenScan {
              index: scan.index + 1,
              limit: scan.limit,
              paren_depth: paren_depth_after_token(
                source,
                scan.index,
                scan.paren_depth
              ),
              brace_depth: brace_depth_after_token(
                source,
                scan.index,
                scan.brace_depth
              ),
              bracket_depth: text_argument_scan_bracket_delta(
                source,
                scan.index,
                scan.bracket_depth
              ),
            }
          ),
        },
        false => text_bool_match_top_level_arrow(
          source,
          TextBoolMatchTokenScan {
            index: scan.index + 1,
            limit: scan.limit,
            paren_depth: paren_depth_after_token(
              source,
              scan.index,
              scan.paren_depth
            ),
            brace_depth: brace_depth_after_token(
              source,
              scan.index,
              scan.brace_depth
            ),
            bracket_depth: text_argument_scan_bracket_delta(
              source,
              scan.index,
              scan.bracket_depth
            ),
          }
        ),
      },
      false => text_bool_match_top_level_arrow(
        source,
        TextBoolMatchTokenScan {
          index: scan.index + 1,
          limit: scan.limit,
          paren_depth: paren_depth_after_token(
            source,
            scan.index,
            scan.paren_depth
          ),
          brace_depth: brace_depth_after_token(
            source,
            scan.index,
            scan.brace_depth
          ),
          bracket_depth: text_argument_scan_bracket_delta(
            source,
            scan.index,
            scan.bracket_depth
          ),
        }
      ),
    },
  }
}

fn text_bool_match_top_level_comma(
  source: textlex.TextTokenStream,
  scan: TextBoolMatchTokenScan
) -> i32 {
  match scan.index >= scan.limit {
    true => scan.limit,
    false => text_depth_is_top_level(scan.brace_depth, scan.paren_depth) \top_level -> match top_level {
      true => match scan.bracket_depth == 0 {
        true => match textlex.punctuation_at(source, scan.index) {
          PunctComma => scan.index,
          _ => text_bool_match_top_level_comma(
            source,
            TextBoolMatchTokenScan {
              index: scan.index + 1,
              limit: scan.limit,
              paren_depth: paren_depth_after_token(
                source,
                scan.index,
                scan.paren_depth
              ),
              brace_depth: brace_depth_after_token(
                source,
                scan.index,
                scan.brace_depth
              ),
              bracket_depth: text_argument_scan_bracket_delta(
                source,
                scan.index,
                scan.bracket_depth
              ),
            }
          ),
        },
        false => text_bool_match_top_level_comma(
          source,
          TextBoolMatchTokenScan {
            index: scan.index + 1,
            limit: scan.limit,
            paren_depth: paren_depth_after_token(
              source,
              scan.index,
              scan.paren_depth
            ),
            brace_depth: brace_depth_after_token(
              source,
              scan.index,
              scan.brace_depth
            ),
            bracket_depth: text_argument_scan_bracket_delta(
              source,
              scan.index,
              scan.bracket_depth
            ),
          }
        ),
      },
      false => text_bool_match_top_level_comma(
        source,
        TextBoolMatchTokenScan {
          index: scan.index + 1,
          limit: scan.limit,
          paren_depth: paren_depth_after_token(
            source,
            scan.index,
            scan.paren_depth
          ),
          brace_depth: brace_depth_after_token(
            source,
            scan.index,
            scan.brace_depth
          ),
          bracket_depth: text_argument_scan_bracket_delta(
            source,
            scan.index,
            scan.bracket_depth
          ),
        }
      ),
    },
  }
}

fn text_bool_match_arm_segment_present(
  source: textlex.TextTokenStream,
  pattern_start: i32,
  arrow: i32,
  comma: i32,
  limit: i32
) -> TextBoolMatchArmSegment {
  TextBoolMatchArmSegment {
    found: true,
    pattern_hash: textlex.text_hash_at(source, pattern_start),
    value_start: text_expression_start_skip_trivia(
      source,
      arrow + 2,
      comma
    ),
    value_limit: comma,
    next_index: match comma < limit {
      true => comma + 1,
      false => limit,
    },
  }
}

fn text_bool_match_arm_pattern_is_supported(
  source: textlex.TextTokenStream,
  pattern_start: i32
) -> bool {
  let is_bool_literal = text_token_weight_matches(
    source,
    pattern_start,
    token.TokenKindWeight::BoolLiteral
  );
  match is_bool_literal {
    true => true,
    false => textlex.text_hash_at(source, pattern_start) ==
      text_wildcard_pattern_hash(),
  }
}

fn text_bool_match_arm_segment_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> TextBoolMatchArmSegment {
  let arrow = text_bool_match_top_level_arrow(
    source,
    TextBoolMatchTokenScan {
      index: index,
      limit: limit,
      paren_depth: 0,
      brace_depth: 0,
      bracket_depth: 0,
    }
  );
  match arrow >= limit {
    true => text_bool_match_arm_segment_missing(limit),
    false => match text_match_arm_guard_start_between(
      source,
      index,
      arrow
    ) < arrow {
      true => text_bool_match_arm_segment_missing(limit),
      false => text_expression_start_skip_trivia(
        source,
        index,
        arrow
      ) \pattern_start -> match pattern_start >= arrow {
        true => text_bool_match_arm_segment_missing(limit),
        false => match text_bool_match_arm_pattern_is_supported(
          source,
          pattern_start
        ) {
          false => text_bool_match_arm_segment_missing(limit),
          true => match text_scalar_literal_is_standalone(
            source,
            pattern_start,
            arrow
          ) {
            false => text_bool_match_arm_segment_missing(limit),
            true => text_bool_match_top_level_comma(
              source,
              TextBoolMatchTokenScan {
                index: arrow + 2,
                limit: limit,
                paren_depth: 0,
                brace_depth: 0,
                bracket_depth: 0,
              }
            ) \comma -> text_bool_match_arm_segment_present(
              source,
              pattern_start,
              arrow,
              comma,
              limit
            ),
          },
        },
      }
    },
  }
}

fn text_root_literal_type_class(
  root_kind: i32,
  root_type: i32
) -> i32 {
  match root_kind == text_expression_root_number_tag() {
    true => match root_type == text_type_class_i32_tag() {
      true => text_type_class_i32_tag(),
      false => text_type_class_unknown_tag(),
    },
    false => match root_kind == text_expression_root_bool_tag() {
      true => match root_type == text_type_class_bool_tag() {
        true => text_type_class_bool_tag(),
        false => text_type_class_unknown_tag(),
      },
      false => match root_kind == text_expression_root_text_tag() {
        true => match root_type == text_type_class_i32_tag() {
          true => text_type_class_i32_tag(),
          false => text_type_class_unknown_tag(),
        },
        false => match root_kind == text_expression_root_literal_type_tag() {
          true => match root_type == text_type_class_i32_tag() {
            true => text_type_class_i32_tag(),
            false => text_type_class_unknown_tag(),
          },
          false => text_type_class_unknown_tag(),
        },
      },
    },
  }
}

fn text_match_arm_literal_result_type_class_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let root_kind = text_expression_root_head_kind_tag_between(
    source,
    index,
    limit
  );
  let root_type = text_expression_root_type_class_tag_between(
    source,
    index,
    limit
  );
  text_root_literal_type_class(root_kind, root_type)
}

fn text_match_literal_result_scan_fail(
  scan: TextMatchLiteralResultScan
) -> TextMatchLiteralResultScan {
  TextMatchLiteralResultScan {
    index: scan.close_index,
    close_index: scan.close_index,
    result_type: text_type_class_unknown_tag(),
    arm_count: scan.arm_count,
    failed: true,
  }
}

fn text_match_literal_result_next_index(
  close_index: i32,
  comma: i32
) -> i32 {
  match comma < close_index {
    true => comma + 1,
    false => close_index,
  }
}

fn text_match_literal_result_scan_accept(
  scan: TextMatchLiteralResultScan,
  value_type: i32,
  next_index: i32
) -> TextMatchLiteralResultScan {
  match value_type == text_type_class_unknown_tag() {
    true => text_match_literal_result_scan_fail(scan),
    false => match scan.arm_count == 0 {
      true => TextMatchLiteralResultScan {
        index: next_index,
        close_index: scan.close_index,
        result_type: value_type,
        arm_count: 1,
        failed: false,
      },
      false => match scan.result_type == value_type {
        true => TextMatchLiteralResultScan {
          index: next_index,
          close_index: scan.close_index,
          result_type: scan.result_type,
          arm_count: scan.arm_count + 1,
          failed: false,
        },
        false => text_match_literal_result_scan_fail(scan),
      },
    },
  }
}

fn text_match_literal_result_scan_step(
  source: textlex.TextTokenStream,
  scan: TextMatchLiteralResultScan
) -> TextMatchLiteralResultScan {
  let arm_start = text_expression_start_skip_trivia(
    source,
    scan.index,
    scan.close_index
  );
  match arm_start >= scan.close_index {
    true => TextMatchLiteralResultScan {
      index: scan.close_index,
      close_index: scan.close_index,
      result_type: scan.result_type,
      arm_count: scan.arm_count,
      failed: scan.failed,
    },
    false => text_bool_match_top_level_arrow(
      source,
      TextBoolMatchTokenScan {
        index: arm_start,
        limit: scan.close_index,
        paren_depth: 0,
        brace_depth: 0,
        bracket_depth: 0,
      }
    ) \arrow -> match arrow >= scan.close_index {
      true => text_match_literal_result_scan_fail(scan),
      false => text_match_arm_guard_start_between(
        source,
        arm_start,
        arrow
      ) \guard_start -> match guard_start < arrow {
        true => text_match_literal_result_scan_fail(scan),
        false => text_bool_match_top_level_comma(
          source,
          TextBoolMatchTokenScan {
            index: arrow + 2,
            limit: scan.close_index,
            paren_depth: 0,
            brace_depth: 0,
            bracket_depth: 0,
          }
        ) \comma -> text_expression_start_skip_trivia(
          source,
          arrow + 2,
          comma
        ) \value_start -> text_match_literal_result_scan_accept(
          scan,
          text_match_arm_literal_result_type_class_between(
            source,
            value_start,
            comma
          ),
          text_match_literal_result_next_index(scan.close_index, comma)
        ),
      },
    },
  }
}

fn text_match_literal_result_scan_loop(
  source: textlex.TextTokenStream,
  scan: TextMatchLiteralResultScan
) -> TextMatchLiteralResultScan {
  match scan.failed {
    true => scan,
    false => match scan.index >= scan.close_index {
      true => scan,
      false => rec(source, text_match_literal_result_scan_step(source, scan)),
    },
  }
}

fn text_match_literal_result_scan_type_class(
  scan: TextMatchLiteralResultScan
) -> i32 {
  match scan.failed {
    true => text_type_class_unknown_tag(),
    false => match scan.arm_count == 0 {
      true => text_type_class_unknown_tag(),
      false => scan.result_type,
    },
  }
}

fn text_match_body_literal_result_type_class_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> i32 {
  let open_index = text_root_match_body_open_between(source, start, limit);
  match open_index < limit {
    false => text_type_class_unknown_tag(),
    true => find_text_right_brace(
      source,
      open_index + 1,
      limit,
      0
    ) \close_index -> match close_index < limit {
      false => text_type_class_unknown_tag(),
      true => text_match_literal_result_scan_type_class(
        text_match_literal_result_scan_loop(
          source,
          TextMatchLiteralResultScan {
            index: open_index + 1,
            close_index: close_index,
            result_type: text_type_class_unknown_tag(),
            arm_count: 0,
            failed: false,
          }
        )
      ),
    },
  }
}

fn text_function_match_body_scalar_branch_type_class(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let segments = text_function_bool_match_body_segments(source, index);
  match segments.found {
    false => text_type_class_unknown_tag(),
    true => text_scalar_branch_type_class_from_parts(
      text_type_class_bool_tag(),
      text_function_body_scalar_operator_operand_type_class(
        source,
        index,
        segments.true_value_start,
        segments.true_value_limit
      ),
      text_function_body_scalar_operator_operand_type_class(
        source,
        index,
        segments.false_value_start,
        segments.false_value_limit
      )
    ),
  }
}

fn text_function_match_body_result_type_class(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let start = text_function_body_value_start_index(source, index);
  let limit = text_function_body_value_limit_index(source, index);
  let literal_type = text_match_body_literal_result_type_class_between(
    source,
    start,
    limit
  );
  match literal_type == text_type_class_unknown_tag() {
    false => literal_type,
    true => text_function_match_body_scalar_branch_type_class(source, index),
  }
}

fn text_bool_match_after_second_arm_clean(
  source: textlex.TextTokenStream,
  index: i32,
  close_index: i32
) -> bool {
  let next = text_expression_start_skip_trivia(source, index, close_index);
  next >= close_index
}

fn text_bool_match_segments_from_arms(
  source: textlex.TextTokenStream,
  condition_start: i32,
  condition_limit: i32,
  close_index: i32,
  first: TextBoolMatchArmSegment,
  second: TextBoolMatchArmSegment
) -> TextBoolBranchSegments {
  let first_is_true = first.pattern_hash == text_bool_literal_true_hash();
  let first_is_false = first.pattern_hash == text_bool_literal_false_hash();
  let second_is_true = second.pattern_hash == text_bool_literal_true_hash();
  let second_is_false = second.pattern_hash == text_bool_literal_false_hash();
  let second_is_wildcard = second.pattern_hash == text_wildcard_pattern_hash();
  let first_is_bool_literal = match first_is_true {
    true => true,
    false => first_is_false,
  };
  let ordered_exact = match first_is_true {
    true => second_is_false,
    false => match first_is_false {
      true => second_is_true,
      false => false,
    },
  };
  let ordered_fallback = second_is_wildcard && first_is_bool_literal;
  let ordered = ordered_exact || ordered_fallback;
  match ordered {
    false => text_bool_branch_segments_missing(close_index),
    true => match text_bool_match_after_second_arm_clean(
      source,
      second.next_index,
      close_index
    ) {
      false => text_bool_branch_segments_missing(close_index),
      true => match first_is_true {
        true => text_bool_branch_segments_present(
          condition_start,
          condition_limit,
          first.value_start,
          first.value_limit,
          second.value_start,
          second.value_limit
        ),
        false => text_bool_branch_segments_present(
          condition_start,
          condition_limit,
          second.value_start,
          second.value_limit,
          first.value_start,
          first.value_limit
        ),
      },
    },
  }
}

fn text_bool_match_segments_from_match_body(
  source: textlex.TextTokenStream,
  condition_start: i32,
  condition_limit: i32,
  open_index: i32,
  limit: i32,
  missing_limit: i32
) -> TextBoolBranchSegments {
  match open_index < limit {
    false => text_bool_branch_segments_missing(missing_limit),
    true => match condition_start < condition_limit {
      false => text_bool_branch_segments_missing(missing_limit),
      true => find_text_right_brace(
        source,
        open_index + 1,
        limit,
        0
      ) \close_index -> match close_index < limit {
        false => text_bool_branch_segments_missing(missing_limit),
        true => text_bool_match_arm_segment_between(
          source,
          open_index + 1,
          close_index
        ) \first -> match first.found {
          false => text_bool_branch_segments_missing(missing_limit),
          true => text_bool_match_arm_segment_between(
            source,
            first.next_index,
            close_index
          ) \second -> match second.found {
            false => text_bool_branch_segments_missing(missing_limit),
            true => text_bool_match_segments_from_arms(
              source,
              condition_start,
              condition_limit,
              close_index,
              first,
              second
            ),
          },
        },
      },
    },
  }
}

fn text_bool_match_segments_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> TextBoolBranchSegments {
  let open_index = text_root_match_body_open_between(source, start, limit);
  text_bool_match_segments_from_match_body(
    source,
    text_expression_start_skip_trivia(source, start + 1, open_index),
    open_index,
    open_index,
    limit,
    limit
  )
}

fn text_match_first_pattern_is_bool_literal(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> bool {
  let open_index = text_root_match_body_open_between(source, start, limit);
  match open_index >= limit {
    true => false,
    false => text_expression_start_skip_trivia(
      source,
      open_index + 1,
      limit
    ) \pattern_start -> match pattern_start >= limit {
      true => false,
      false => match textlex.token_at(source, pattern_start).kind {
        BoolLiteral => true,
        _ => false,
      },
    },
  }
}

fn text_function_bool_match_body_segments_for_body(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> TextBoolBranchSegments {
  let open_index = text_root_match_body_open_between(source, start, limit);
  text_bool_match_segments_from_match_body(
    source,
    start,
    open_index,
    open_index,
    limit,
    limit
  )
}

fn text_function_bool_match_body_segments(
  source: textlex.TextTokenStream,
  index: i32
) -> TextBoolBranchSegments {
  let runtime_count = text_function_runtime_param_count(source, index);
  let param_type = text_function_first_runtime_param_type_class(source, index);
  let start = text_function_body_value_start_index(source, index);
  let limit = text_function_body_value_limit_index(source, index);
  match runtime_count == 1 {
    false => text_bool_branch_segments_missing(limit),
    true => match param_type == text_type_class_bool_tag() {
      false => text_bool_branch_segments_missing(limit),
      true => text_function_bool_match_body_segments_for_body(
        source,
        start,
        limit
      ),
    },
  }
}

fn text_bool_if_segments_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> TextBoolBranchSegments {
  let blocks = text_if_child_blocks_between(source, start, limit);
  match blocks.false_close < limit {
    false => text_bool_branch_segments_missing(limit),
    true => text_bool_branch_segments_present(
      blocks.condition_start,
      blocks.condition_limit,
      blocks.true_value_start,
      blocks.true_close,
      blocks.false_value_start,
      blocks.false_close
    ),
  }
}

fn text_bool_branch_segments_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> TextBoolBranchSegments {
  let value_start = text_expression_start_skip_trivia(source, start, limit);
  match value_start >= limit {
    true => text_bool_branch_segments_missing(limit),
    false => match text_root_pipe_bind_index_from_start(
      source,
      value_start,
      limit
    ) < limit {
      true => text_bool_branch_segments_missing(limit),
      false => match textlex.token_at(source, value_start).kind {
        IfKw => text_bool_if_segments_between(source, value_start, limit),
        MatchKw => match text_match_first_pattern_is_bool_literal(
          source,
          value_start,
          limit
        ) {
          true => text_bool_match_segments_between(source, value_start, limit),
          false => text_bool_branch_segments_missing(limit),
        },
        _ => text_bool_branch_segments_missing(limit),
      },
    },
  }
}

fn text_parenthesized_expression_segment_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> TextArgumentSegment {
  let value_start = text_expression_start_skip_trivia(source, start, limit);
  match value_start >= limit {
    true => text_argument_segment_none(limit),
    false => match textlex.punctuation_at(source, value_start) {
      PunctLeftParen => find_text_matching_right_paren(
        source,
        value_start + 1,
        limit,
        0
      ) \close_index -> match close_index < limit {
        false => text_argument_segment_none(limit),
        true => match text_expression_start_skip_trivia(
          source,
          close_index + 1,
          limit
        ) >= limit {
          false => text_argument_segment_none(limit),
          true => text_argument_segment_present(
            source,
            value_start + 1,
            close_index
          ),
        },
      },
      _ => text_argument_segment_none(limit),
    },
  }
}

fn text_if_else_index_after_true_close(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let next = text_expression_start_skip_trivia(source, index, limit);
  match next < limit {
    false => limit,
    true => match textlex.token_at(source, next).kind {
      ElseKw => next,
      _ => limit,
    },
  }
}

fn text_if_true_block_open_after_start(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  paren_depth: i32,
  brace_depth: i32,
  bracket_depth: i32
) -> i32 {
  match index >= limit {
    true => limit,
    false => text_depth_is_top_level(brace_depth, paren_depth) \top_level -> match top_level {
      true => match bracket_depth == 0 {
        true => match textlex.punctuation_at(source, index) {
          PunctLeftBrace => find_text_right_brace(
            source,
            index + 1,
            limit,
            0
          ) \close_index -> match close_index < limit {
            true => match text_if_else_index_after_true_close(
              source,
              close_index + 1,
              limit
            ) < limit {
              true => index,
              false => text_if_true_block_open_after_start(
                source,
                close_index + 1,
                limit,
                paren_depth,
                brace_depth,
                bracket_depth
              ),
            },
            false => limit,
          },
          _ => text_if_true_block_open_after_start(
            source,
            index + 1,
            limit,
            paren_depth_after_token(source, index, paren_depth),
            brace_depth_after_token(source, index, brace_depth),
            text_argument_scan_bracket_delta(source, index, bracket_depth)
          ),
        },
        false => text_if_true_block_open_after_start(
          source,
          index + 1,
          limit,
          paren_depth_after_token(source, index, paren_depth),
          brace_depth_after_token(source, index, brace_depth),
          text_argument_scan_bracket_delta(source, index, bracket_depth)
        ),
      },
      false => text_if_true_block_open_after_start(
        source,
        index + 1,
        limit,
        paren_depth_after_token(source, index, paren_depth),
        brace_depth_after_token(source, index, brace_depth),
        text_argument_scan_bracket_delta(source, index, bracket_depth)
      ),
    },
  }
}

fn text_if_false_block_open_after_else(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  paren_depth: i32,
  brace_depth: i32,
  bracket_depth: i32
) -> i32 {
  match index >= limit {
    true => limit,
    false => text_depth_is_top_level(brace_depth, paren_depth) \top_level -> match top_level {
      true => match bracket_depth == 0 {
        true => match textlex.punctuation_at(source, index) {
          PunctLeftBrace => index,
          _ => text_if_false_block_open_after_else(
            source,
            index + 1,
            limit,
            paren_depth_after_token(source, index, paren_depth),
            brace_depth_after_token(source, index, brace_depth),
            text_argument_scan_bracket_delta(source, index, bracket_depth)
          ),
        },
        false => text_if_false_block_open_after_else(
          source,
          index + 1,
          limit,
          paren_depth_after_token(source, index, paren_depth),
          brace_depth_after_token(source, index, brace_depth),
          text_argument_scan_bracket_delta(source, index, bracket_depth)
        ),
      },
      false => text_if_false_block_open_after_else(
        source,
        index + 1,
        limit,
        paren_depth_after_token(source, index, paren_depth),
        brace_depth_after_token(source, index, brace_depth),
        text_argument_scan_bracket_delta(source, index, bracket_depth)
      ),
    },
  }
}

fn text_if_block_value_start(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32
) -> i32 {
  text_block_final_expression_start_between(
    source,
    text_block_final_expression_scan(
      open_index + 1,
      close_index,
      0,
      0,
      0,
      open_index + 1
    )
  )
}

fn text_if_child_blocks_missing(limit: i32) -> TextIfChildBlocks {
  TextIfChildBlocks {
    condition_start: limit,
    condition_limit: limit,
    true_value_start: limit,
    true_close: limit,
    false_value_start: limit,
    false_close: limit,
  }
}

fn text_if_child_blocks_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> TextIfChildBlocks {
  let true_open = text_if_true_block_open_after_start(
    source,
    start + 1,
    limit,
    0,
    0,
    0
  );
  match true_open < limit {
    false => text_if_child_blocks_missing(limit),
    true => find_text_right_brace(source, true_open + 1, limit, 0) \true_close -> match true_close < limit {
      false => text_if_child_blocks_missing(limit),
      true => text_if_else_index_after_true_close(
        source,
        true_close + 1,
        limit
      ) \else_index -> match else_index < limit {
        false => text_if_child_blocks_missing(limit),
        true => text_if_false_block_open_after_else(
          source,
          else_index + 1,
          limit,
          0,
          0,
          0
        ) \false_open -> match false_open < limit {
          false => text_if_child_blocks_missing(limit),
          true => find_text_right_brace(source, false_open + 1, limit, 0) \false_close -> match false_close < limit {
            false => text_if_child_blocks_missing(limit),
            true => TextIfChildBlocks {
              condition_start: text_expression_start_skip_trivia(
                source,
                start + 1,
                true_open
              ),
              condition_limit: true_open,
              true_value_start: text_if_block_value_start(
                source,
                true_open,
                true_close
              ),
              true_close: true_close,
              false_value_start: text_if_block_value_start(
                source,
                false_open,
                false_close
              ),
              false_close: false_close,
            },
          },
        },
      },
    },
  }
}

fn text_root_if_child_count_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> i32 {
  let blocks = text_if_child_blocks_between(source, start, limit);
  match blocks.false_close < limit {
    true => 3,
    false => 0,
  }
}

fn text_root_if_child_signature_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  total: i32
) -> i32 {
  let blocks = text_if_child_blocks_between(source, start, limit);
  match blocks.false_close < limit {
    false => total,
    true => match blocks.condition_start < blocks.condition_limit {
        true => text_child_value_segment_signature(
          source,
          blocks.condition_start,
          blocks.condition_limit,
          total
        ),
        false => total,
      } \with_condition -> text_child_value_segment_signature(
        source,
        blocks.true_value_start,
        blocks.true_close,
        with_condition
      ) \with_true -> text_child_value_segment_signature(
        source,
        blocks.false_value_start,
        blocks.false_close,
        with_true
      ),
  }
}

fn text_root_if_grandchild_count_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> i32 {
  let blocks = text_if_child_blocks_between(source, start, limit);
  match blocks.false_close < limit {
    false => 0,
    true => match blocks.condition_start < blocks.condition_limit {
        true => text_expression_root_child_count_between(
          source,
          blocks.condition_start,
          blocks.condition_limit
        ),
        false => 0,
      } \condition_count -> condition_count
        + text_expression_root_child_count_between(
          source,
          blocks.true_value_start,
          blocks.true_close
        )
        + text_expression_root_child_count_between(
          source,
          blocks.false_value_start,
          blocks.false_close
        ),
  }
}

fn text_root_if_grandchild_signature_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  total: i32
) -> i32 {
  let blocks = text_if_child_blocks_between(source, start, limit);
  match blocks.false_close < limit {
    false => total,
    true => match blocks.condition_start < blocks.condition_limit {
        true => text_expression_root_child_signature_between(
          source,
          blocks.condition_start,
          blocks.condition_limit,
          total
        ),
        false => total,
      } \with_condition -> text_expression_root_child_signature_between(
        source,
        blocks.true_value_start,
        blocks.true_close,
        with_condition
      ) \with_true -> text_expression_root_child_signature_between(
        source,
        blocks.false_value_start,
        blocks.false_close,
        with_true
      ),
  }
}

fn text_root_if_descendant_count_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> i32 {
  let blocks = text_if_child_blocks_between(source, start, limit);
  match blocks.false_close < limit {
    false => 0,
    true => match blocks.condition_start < blocks.condition_limit {
        true => 1
          + text_expression_root_descendant_count_between(
            source,
            blocks.condition_start,
            blocks.condition_limit
          ),
        false => 0,
      } \condition_count -> condition_count
        + 2
        + text_expression_root_descendant_count_between(
          source,
          blocks.true_value_start,
          blocks.true_close
        )
        + text_expression_root_descendant_count_between(
          source,
          blocks.false_value_start,
          blocks.false_close
        ),
  }
}

fn text_root_if_descendant_signature_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  total: i32
) -> i32 {
  let blocks = text_if_child_blocks_between(source, start, limit);
  match blocks.false_close < limit {
    false => total,
    true => match blocks.condition_start < blocks.condition_limit {
        true => text_expression_root_descendant_signature_between(
          source,
          blocks.condition_start,
          blocks.condition_limit,
          text_child_value_segment_signature(
            source,
            blocks.condition_start,
            blocks.condition_limit,
            total
          )
        ),
        false => total,
      } \with_condition -> text_expression_root_descendant_signature_between(
        source,
        blocks.true_value_start,
        blocks.true_close,
        text_child_value_segment_signature(
          source,
          blocks.true_value_start,
          blocks.true_close,
          with_condition
        )
      ) \with_true -> text_expression_root_descendant_signature_between(
        source,
        blocks.false_value_start,
        blocks.false_close,
        text_child_value_segment_signature(
          source,
          blocks.false_value_start,
          blocks.false_close,
          with_true
        )
      ),
  }
}

fn text_root_if_child_record_state_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  parent_kind_tag: i32,
  parent_name_hash: i32,
  child_index: i32,
  total: i32
) -> TextRootChildRecordState {
  let blocks = text_if_child_blocks_between(source, start, limit);
  match blocks.false_close < limit {
    false => TextRootChildRecordState {
      child_index: child_index,
      total: total,
    },
    true => match blocks.condition_start < blocks.condition_limit {
      true => text_root_child_record_value_fact_signature(
        source,
        blocks.condition_start,
        blocks.condition_limit,
        parent_kind_tag,
        parent_name_hash,
        child_index,
        text_root_child_match_scrutinee_role_tag(),
        0
      ) \condition_fact -> text_expression_root_child_record_signature_between_state(
        source,
        blocks.condition_start,
        blocks.condition_limit,
        parent_kind_tag,
        parent_name_hash,
        child_index + 1,
        textmodel.signature_mix(total, condition_fact)
      ),
      false => TextRootChildRecordState {
        child_index: child_index,
        total: total,
      },
    } \after_condition -> text_root_child_record_value_fact_signature(
      source,
      blocks.true_value_start,
      blocks.true_close,
      parent_kind_tag,
      parent_name_hash,
      after_condition.child_index,
      text_root_child_match_arm_role_tag(),
      0
    ) \true_fact -> text_expression_root_child_record_signature_between_state(
      source,
      blocks.true_value_start,
      blocks.true_close,
      parent_kind_tag,
      parent_name_hash,
      after_condition.child_index + 1,
      textmodel.signature_mix(after_condition.total, true_fact)
    ) \after_true -> text_root_child_record_value_fact_signature(
      source,
      blocks.false_value_start,
      blocks.false_close,
      parent_kind_tag,
      parent_name_hash,
      after_true.child_index,
      text_root_child_match_arm_role_tag(),
      0
    ) \false_fact -> text_expression_root_child_record_signature_between_state(
      source,
      blocks.false_value_start,
      blocks.false_close,
      parent_kind_tag,
      parent_name_hash,
      after_true.child_index + 1,
      textmodel.signature_mix(after_true.total, false_fact)
    ),
  }
}

fn text_root_child_scan_finish_present(
  source: textlex.TextTokenStream,
  scan: TextRootChildScan,
  value_start: i32
) -> TextRootChildScan {
  text_root_child_scan_append_value(source, scan, value_start, scan.index)
}

fn text_root_child_scan_finish_segment(
  source: textlex.TextTokenStream,
  scan: TextRootChildScan
) -> TextRootChildScan {
  match scan.segment_saw_argument {
    true => text_root_child_scan_finish_present(
      source,
      scan,
      text_root_child_segment_value_start(
        source,
        scan.segment_start,
        scan.index
      )
    ),
    false => scan,
  }
}

fn text_root_child_scan_step(
  source: textlex.TextTokenStream,
  scan: TextRootChildScan
) -> TextRootChildScan {
  let punctuation = textlex.punctuation_at(source, scan.index);
  let top_level = text_root_child_scan_is_top_level(scan);
  let is_separator = match punctuation {
    PunctComma => top_level,
    _ => false,
  };
  let is_argument_token = match is_separator {
    true => false,
    false => match text_param_signature_is_trivia(source, scan.index) {
      true => false,
      false => true,
    },
  };
  let finished = match is_separator {
    true => text_root_child_scan_finish_segment(source, scan),
    false => scan,
  };
  TextRootChildScan {
    index: scan.index + 1,
    close_index: scan.close_index,
    segment_start: match is_separator {
      true => scan.index + 1,
      false => finished.segment_start,
    },
    paren_depth: text_argument_scan_next_paren_depth(
      punctuation,
      scan.paren_depth
    ),
    brace_depth: text_argument_scan_next_brace_depth(
      punctuation,
      scan.brace_depth
    ),
    bracket_depth: text_argument_scan_bracket_delta(
      source,
      scan.index,
      scan.bracket_depth
    ),
    total_count: finished.total_count,
    total_signature: finished.total_signature,
    total_grandchild_count: finished.total_grandchild_count,
    total_grandchild_signature: finished.total_grandchild_signature,
    total_descendant_count: finished.total_descendant_count,
    total_descendant_signature: finished.total_descendant_signature,
    segment_saw_argument: match is_separator {
      true => false,
      false => match is_argument_token {
        true => true,
        false => scan.segment_saw_argument,
      },
    },
  }
}

fn text_root_child_scan_loop(
  source: textlex.TextTokenStream,
  scan: TextRootChildScan
) -> TextRootChildScan {
  match scan.index >= scan.close_index {
    true => text_root_child_scan_finish_segment(source, scan),
    false => text_root_child_scan_loop(
      source,
      text_root_child_scan_step(source, scan)
    ),
  }
}

fn text_root_child_scan(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32,
  total_signature: i32,
  total_grandchild_signature: i32,
  total_descendant_signature: i32
) -> TextRootChildScan {
  text_root_child_scan_loop(
    source,
    TextRootChildScan {
      index: open_index + 1,
      close_index: close_index,
      segment_start: open_index + 1,
      paren_depth: 0,
      brace_depth: 0,
      bracket_depth: 0,
      total_count: 0,
      total_signature: total_signature,
      total_grandchild_count: 0,
      total_grandchild_signature: total_grandchild_signature,
      total_descendant_count: 0,
      total_descendant_signature: total_descendant_signature,
      segment_saw_argument: false,
    }
  )
}

fn text_root_child_scan_between(
  source: textlex.TextTokenStream,
  index: i32,
  close_index: i32,
  total_signature: i32,
  total_grandchild_signature: i32,
  total_descendant_signature: i32
) -> TextRootChildScan {
  text_root_child_scan_loop(
    source,
    TextRootChildScan {
      index: index,
      close_index: close_index,
      segment_start: index,
      paren_depth: 0,
      brace_depth: 0,
      bracket_depth: 0,
      total_count: 0,
      total_signature: total_signature,
      total_grandchild_count: 0,
      total_grandchild_signature: total_grandchild_signature,
      total_descendant_count: 0,
      total_descendant_signature: total_descendant_signature,
      segment_saw_argument: false,
    }
  )
}

fn text_root_child_count_between_segments(
  source: textlex.TextTokenStream,
  index: i32,
  close_index: i32
) -> i32 {
  text_root_child_scan_between(source, index, close_index, 0, 0, 0).total_count
}

fn text_root_child_signature_between_segments(
  source: textlex.TextTokenStream,
  index: i32,
  close_index: i32,
  total: i32
) -> i32 {
  text_root_child_scan_between(source, index, close_index, total, 0, 0).total_signature
}

fn text_root_grandchild_count_between_segments(
  source: textlex.TextTokenStream,
  index: i32,
  close_index: i32
) -> i32 {
  text_root_child_scan_between(
    source,
    index,
    close_index,
    0,
    0,
    0
  ).total_grandchild_count
}

fn text_root_grandchild_signature_between_segments(
  source: textlex.TextTokenStream,
  index: i32,
  close_index: i32,
  total: i32
) -> i32 {
  text_root_child_scan_between(
    source,
    index,
    close_index,
    0,
    total,
    0
  ).total_grandchild_signature
}

fn text_root_descendant_count_between_segments(
  source: textlex.TextTokenStream,
  index: i32,
