  10
}

fn text_static_builtin_start_matches(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> bool {
  match start + 1 < limit {
    false => false,
    true => match punctuation_matches(source, start, textlex.PunctOther) {
      false => false,
      true => match textlex.text_hash_at(source, start) == text_static_marker_hash() {
        false => false,
        true => text_head_segment_token_matches(source, start + 1),
      },
    },
  }
}

fn text_static_builtin_head_hash(
  source: textlex.TextTokenStream,
  start: i32
) -> i32 {
  text_hash_append_token(
    source,
    start + 1,
    text_hash_append_token(source, start, 0)
  )
}

fn text_signed_number_start_matches(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> bool {
  match start + 1 < limit {
    false => false,
    true => match textlex.punctuation_at(source, start) {
      PunctOther => match textlex.text_hash_at(source, start) ==
        text_operator_hash_minus() {
        false => false,
        true => match textlex.token_at(source, start + 1).kind {
          NumberLiteral => true,
          _ => false,
        },
      },
      _ => false,
    },
  }
}

fn text_signed_number_head_hash(
  source: textlex.TextTokenStream,
  start: i32
) -> i32 {
  text_hash_append_token(source, start + 1, textlex.text_hash_at(source, start))
}

fn text_expression_root_head_kind_tag_from_start(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> i32 {
  match text_static_builtin_start_matches(source, start, limit) {
    true => text_expression_root_identifier_tag(),
    false => match text_signed_number_start_matches(source, start, limit) {
      true => text_expression_root_number_tag(),
      false => match textlex.token_at(source, start).kind {
        BoolLiteral => text_expression_root_bool_tag(),
        NumberLiteral => text_expression_root_number_tag(),
        StringLiteral => text_expression_root_text_tag(),
        CharLiteral => text_expression_root_text_tag(),
        MultilineLiteral => text_expression_root_text_tag(),
        I32Kw => text_expression_root_identifier_tag(),
        I64Kw => text_expression_root_identifier_tag(),
        U32Kw => text_expression_root_identifier_tag(),
        U64Kw => text_expression_root_identifier_tag(),
        F32Kw => text_expression_root_identifier_tag(),
        F64Kw => text_expression_root_identifier_tag(),
        MatchKw => text_expression_root_match_tag(),
        IfKw => text_expression_root_match_tag(),
        DoKw => text_expression_root_do_tag(),
        Identifier if text_product_constructor_start_matches_between(source, start, limit) =>
          text_expression_root_product_constructor_tag(),
        Identifier => text_expression_root_identifier_tag(),
        LiteralType if text_product_constructor_start_matches_between(source, start, limit) =>
          text_expression_root_product_constructor_tag(),
        LiteralType => text_expression_root_literal_type_tag(),
        _ => match textlex.punctuation_at(source, start) {
          PunctLeftBrace => text_expression_root_shape_tag(),
          PunctOther if text_left_bracket_token_matches(source, start) =>
            text_expression_root_shape_tag(),
          PunctOther if text_pipe_bind_token_matches(source, start) =>
            text_expression_root_const_function_tag(),
          _ => text_expression_root_none_tag(),
        },
      },
    },
  }
}

fn text_expression_root_head_kind_tag_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  match start >= limit {
    true => text_expression_root_none_tag(),
    false => text_expression_root_head_kind_tag_from_start(source, start, limit),
  }
}

fn text_expression_root_head_hash_needs_token(kind_tag: i32) -> bool {
  match kind_tag == text_expression_root_number_tag() {
    true => true,
    false => match kind_tag == text_expression_root_bool_tag() {
      true => true,
      false => match kind_tag == text_expression_root_literal_type_tag() {
        true => true,
        false => match kind_tag == text_expression_root_identifier_tag() {
          true => true,
          false => kind_tag == text_expression_root_product_constructor_tag(),
        },
      },
    },
  }
}

fn text_expression_literal_index_head_hash(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  head_hash: i32
) -> i32 {
  let open = start + 1;
  let value = start + 2;
  let close = start + 3;
  match close < limit {
    false => head_hash,
    true => match textlex.punctuation_at(source, open) {
      PunctOther => match textlex.text_hash_at(source, open) == text_left_bracket_hash() {
        false => head_hash,
        true => match textlex.token_at(source, value).kind {
          NumberLiteral => match textlex.punctuation_at(source, close) {
            PunctOther => match textlex.text_hash_at(source, close) ==
              text_right_bracket_hash() {
              true => text_expression_literal_index_head_hash(
                source,
                close,
                limit,
                text_hash_append_token(
                  source,
                  close,
                  text_hash_append_token(
                    source,
                    value,
                    text_hash_append_token(source, open, head_hash)
                  )
                )
              ),
              false => head_hash,
            },
            _ => head_hash,
          },
          _ => head_hash,
        },
      },
      _ => head_hash,
    },
  }
}

fn text_expression_root_head_hash_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  match start >= limit {
    true => 0,
    false => match text_static_builtin_start_matches(source, start, limit) {
      true => text_static_builtin_head_hash(source, start),
      false => match text_signed_number_start_matches(source, start, limit) {
        true => text_signed_number_head_hash(source, start),
        false => match text_expression_root_head_hash_needs_token(
          text_expression_root_head_kind_tag_from_start(source, start, limit)
        ) {
          true => text_expression_literal_index_head_hash(
            source,
            start,
            limit,
            textlex.text_hash_at(source, start)
          ),
          false => 0,
        },
      },
    },
  }
}

fn text_expression_qualified_head_hash_after_segment(
  source: textlex.TextTokenStream,
  segment_index: i32,
  limit: i32,
  total: i32
) -> i32 {
  let next = segment_index + 1;
  let step = text_head_selector_step_after(source, next, limit);
  match step.found {
    true => text_expression_qualified_head_hash_after_segment(
      source,
      step.segment_index,
      limit,
      text_signature_mix(
        text_signature_mix(total, step.selector_score),
        text_expression_head_segment_hash(source, step.segment_index, limit)
      )
    ),
    false => total,
  }
}

fn text_expression_head_segment_hash(
  source: textlex.TextTokenStream,
  segment_index: i32,
  limit: i32
) -> i32 {
  text_expression_literal_index_head_hash(
    source,
    segment_index,
    limit,
    textlex.text_hash_at(source, segment_index)
  )
}

fn text_expression_root_qualified_head_hash_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  let has_head = match start < limit {
    true => match text_static_builtin_start_matches(source, start, limit) {
      true => true,
      false => text_head_segment_token_matches(source, start),
    },
    false => false,
  };
  match has_head {
    true => match text_static_builtin_start_matches(source, start, limit) {
      true => text_expression_qualified_head_hash_after_segment(
        source,
        start + 1,
        limit,
        text_static_builtin_head_hash(source, start)
      ),
      false => text_expression_qualified_head_hash_after_segment(
        source,
        start,
        limit,
        text_expression_head_segment_hash(source, start, limit)
      ),
    },
    false => 0,
  }
}

fn text_head_selector_is_dot(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match textlex.punctuation_at(source, index) {
    PunctOther => textlex.text_hash_at(source, index) == text_dot_hash(),
    _ => false,
  }
}

fn text_head_selector_is_colon_colon(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match punctuation_matches(source, index, textlex.PunctColon) {
    true => punctuation_matches(source, index + 1, textlex.PunctColon),
    false => false,
  }
}

fn text_head_segment_token_matches(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match textlex.token_at(source, index).kind {
    Identifier => true,
    LiteralType => true,
    I32Kw => true,
    I64Kw => true,
    U32Kw => true,
    U64Kw => true,
    F32Kw => true,
    F64Kw => true,
    _ => false,
  }
}

fn text_head_selector_step(
  selector_score: i32,
  segment_index: i32
) -> TextHeadSelectorStep {
  TextHeadSelectorStep {
    found: true,
    selector_score: selector_score,
    segment_index: segment_index,
  }
}

fn text_missing_head_selector_step(segment_index: i32) -> TextHeadSelectorStep {
  TextHeadSelectorStep {
    found: false,
    selector_score: 0,
    segment_index: segment_index,
  }
}

fn text_dot_head_selector_step(
  source: textlex.TextTokenStream,
  next: i32,
  limit: i32
) -> TextHeadSelectorStep {
  let segment_index = next + 1;
  match segment_index < limit {
    true => match text_head_segment_token_matches(source, segment_index) {
      true => text_head_selector_step(1, segment_index),
      false => text_missing_head_selector_step(next),
    },
    false => text_missing_head_selector_step(next),
  }
}

fn text_qualified_head_selector_step(
  source: textlex.TextTokenStream,
  next: i32,
  limit: i32
) -> TextHeadSelectorStep {
  let segment_index = next + 2;
  match segment_index < limit {
    true => match text_head_segment_token_matches(source, segment_index) {
      true => text_head_selector_step(2, segment_index),
      false => text_missing_head_selector_step(next),
    },
    false => text_missing_head_selector_step(next),
  }
}

fn text_head_selector_step_after(
  source: textlex.TextTokenStream,
  next: i32,
  limit: i32
) -> TextHeadSelectorStep {
  match next >= limit {
    true => text_missing_head_selector_step(next),
    false => match text_head_selector_is_dot(source, next) {
      true => text_dot_head_selector_step(source, next, limit),
      false => match text_head_selector_is_colon_colon(source, next) {
        true => text_qualified_head_selector_step(source, next, limit),
        false => text_missing_head_selector_step(next),
      },
    },
  }
}

fn text_root_selector_count_after_head(
  source: textlex.TextTokenStream,
  head_index: i32,
  limit: i32,
  total: i32
) -> i32 {
  let next = head_index + 1;
  let step = text_head_selector_step_after(source, next, limit);
  match step.found {
    true => text_root_selector_count_after_head(
      source,
      step.segment_index,
      limit,
      total + 1
    ),
    false => total,
  }
}

fn text_expression_root_head_selector_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  let has_head = match start < limit {
    true => match text_static_builtin_start_matches(source, start, limit) {
      true => true,
      false => text_head_segment_token_matches(source, start),
    },
    false => false,
  };
  match has_head {
    true => match text_static_builtin_start_matches(source, start, limit) {
      true => text_root_selector_count_after_head(source, start + 1, limit, 0),
      false => text_root_selector_count_after_head(source, start, limit, 0),
    },
    false => 0,
  }
}

fn text_root_callable_head_index(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> i32 {
  match text_static_builtin_start_matches(source, start, limit) {
    true => start + 1,
    false => match text_head_segment_token_matches(source, start) {
      true => start,
      false => limit,
    },
  }
}

fn text_root_slot_open_after_head(
  source: textlex.TextTokenStream,
  head_index: i32,
  limit: i32
) -> i32 {
  let next = head_index + 1;
  match next >= limit {
    true => limit,
    false => match textlex.punctuation_at(source, next) {
      PunctLeftBrace => next,
      PunctLeftParen => limit,
      _ => text_head_selector_step_after(source, next, limit) \step -> match step.found {
        true => rec(source, step.segment_index, limit),
        false => limit,
      },
    },
  }
}

fn text_find_top_level_value_punctuation_score(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  paren_depth: i32,
  brace_depth: i32,
  bracket_depth: i32,
  expected_score: i32
) -> i32 {
  match index >= limit {
    true => limit,
    false => textlex.punctuation_at(source, index) \punctuation -> match
      paren_depth == 0 && brace_depth == 0 && bracket_depth == 0 &&
        textlex.punctuation_score(punctuation) == expected_score {
      true => index,
      false => rec(
        source,
        index + 1,
        limit,
        text_argument_scan_next_paren_depth(punctuation, paren_depth),
        text_argument_scan_next_brace_depth(punctuation, brace_depth),
        text_argument_scan_bracket_delta(source, index, bracket_depth),
        expected_score
      ),
    },
  }
}

fn text_bracket_root_is_repeat(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32
) -> bool {
  text_bracket_root_repeat_semicolon(source, open_index, close_index) <
    close_index
}

fn text_bracket_root_repeat_semicolon(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32
) -> i32 {
  text_find_top_level_value_punctuation_score(
    source,
    open_index + 1,
    close_index,
    0,
    0,
    0,
    textlex.punctuation_score(textlex.PunctSemicolon)
  )
}

fn text_bracket_root_repeat_count(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32
) -> i32 {
  let semicolon = text_bracket_root_repeat_semicolon(source, open_index, close_index);
  match semicolon < close_index {
    false => 0,
    true => text_expression_start_skip_trivia(
      source,
      semicolon + 1,
      close_index
    ) \count_index -> match count_index < close_index {
      false => 1,
      true => match textlex.token_at(source, count_index).kind {
        NumberLiteral => textlex.decimal_token_value(source, count_index),
        _ => 1,
      },
    },
  }
}

fn text_bracket_root_repeat_slot_count(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32
) -> i32 {
  match text_bracket_root_is_repeat(source, open_index, close_index) {
    true => text_bracket_root_repeat_count(source, open_index, close_index),
    false => text_slot_count(source, open_index, close_index),
  }
}

fn text_expression_root_slot_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  match start >= limit {
    true => 0,
    false => text_root_pipe_bind_index_from_start(source, start, limit) \pipe_index -> match pipe_index < limit {
      true => text_expression_root_slot_count_between(source, start, pipe_index),
      false => match textlex.punctuation_at(source, start) {
      PunctLeftBrace => find_text_right_brace(
        source,
        start + 1,
        limit,
        0
      ) \close_index -> match close_index < limit {
        true => text_slot_count(source, start, close_index),
        false => 0,
      },
      PunctOther if text_left_bracket_token_matches(source, start) =>
        find_text_right_bracket(
          source,
          start + 1,
          limit,
          0
        ) \close_index -> match close_index < limit {
          true => match text_bracket_root_is_repeat(source, start, close_index) {
            true => text_bracket_root_repeat_slot_count(source, start, close_index),
            false => text_slot_count(source, start, close_index),
          },
          false => 0,
        },
      _ => match text_head_segment_token_matches(source, start) {
        false => 0,
        true => text_root_slot_open_after_head(source, start, limit) \open_index -> match open_index < limit {
          false => 0,
          true => find_text_right_brace(
            source,
            open_index + 1,
            limit,
            0
          ) \close_index -> match close_index < limit {
            true => text_slot_count(source, open_index, close_index),
            false => 0,
          },
        },
      },
    },
    },
  }
}

fn text_root_call_open_after_head(
  source: textlex.TextTokenStream,
  head_index: i32,
  limit: i32
) -> i32 {
  let next = head_index + 1;
  match next >= limit {
    true => limit,
    false => match textlex.punctuation_at(source, next) {
      PunctLeftParen => next,
      PunctLeftBrace => limit,
      _ => text_head_selector_step_after(source, next, limit) \step -> match step.found {
        true => rec(source, step.segment_index, limit),
        false => limit,
      },
    },
  }
}

fn text_expression_root_call_open_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  match start < limit {
    false => limit,
    true => text_root_callable_head_index(source, start, limit) \head_index ->
      match head_index < limit {
        true => text_root_call_open_after_head(source, head_index, limit),
        false => limit,
      },
  }
}

fn text_expression_root_call_close_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let open_index = text_expression_root_call_open_between(source, index, limit);
  match open_index < limit {
    false => limit,
    true => find_text_matching_right_paren(
      source,
      open_index + 1,
      limit,
      0
    ),
  }
}

fn text_expression_root_call_tail_field_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let close_index = text_expression_root_call_close_between(source, index, limit);
  match close_index < limit {
    false => 0,
    true => text_root_field_count_after_postfix(
      source,
      close_index + 1,
      limit,
      0
    ),
  }
}

fn text_expression_root_call_tail_operator_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let close_index = text_expression_root_call_close_between(source, index, limit);
  match close_index < limit {
    false => 0,
    true => text_expression_start_skip_trivia(
      source,
      close_index + 1,
      limit
    ) \tail_start -> match tail_start >= limit {
      true => 0,
      false => match textlex.punctuation_at(source, tail_start) {
        PunctSemicolon => 0,
        PunctRightBrace => 0,
        _ => match text_root_operator_token_matches(source, tail_start) {
          true => 1,
          false => text_expression_root_operator_count_between(
            source,
            tail_start,
            limit
          ),
        },
      },
    },
  }
}

fn text_expression_root_call_consumes_segment(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> bool {
  let close_index = text_expression_root_call_close_between(source, index, limit);
  match close_index < limit {
    false => false,
    true => text_expression_start_skip_trivia(
      source,
      close_index + 1,
      limit
    ) >= limit,
  }
}

fn text_expression_root_call_arg_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let open_index = text_expression_root_call_open_between(source, index, limit);
  match open_index < limit {
    false => text_no_root_call_arg_count(),
    true => text_expression_root_call_close_between(
      source,
      index,
      limit
    ) \close_index -> match close_index < limit {
      true => text_call_argument_count(source, open_index, close_index) + 1,
      false => text_no_root_call_arg_count(),
    },
  }
}

fn text_expression_root_call_arg_segment_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  target_index: i32
) -> TextArgumentSegment {
  let start = text_expression_start_skip_trivia(source, index, limit);
  let has_head = match start < limit {
    true => text_head_segment_token_matches(source, start),
    false => false,
  };
  match has_head {
    false => text_argument_segment_none(limit),
    true => text_root_call_open_after_head(source, start, limit) \open_index -> match open_index < limit {
      false => text_argument_segment_none(limit),
      true => find_text_matching_right_paren(
        source,
        open_index + 1,
        limit,
        0
      ) \close_index -> match close_index < limit {
        true => text_call_argument_segment(
          source,
          open_index,
          close_index,
          target_index
        ),
        false => text_argument_segment_none(limit),
      },
    },
  }
}

fn text_root_child_scan_is_top_level(scan: TextRootChildScan) -> bool {
  match scan.paren_depth == 0 {
    true => match scan.brace_depth == 0 {
      true => scan.bracket_depth == 0,
      false => false,
    },
    false => false,
  }
}

fn text_root_child_segment_colon_continue(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  paren_depth: i32,
  brace_depth: i32,
  bracket_depth: i32
) -> i32 {
  let punctuation = textlex.punctuation_at(source, index);
  let top_level = match paren_depth == 0 {
    true => match brace_depth == 0 {
      true => bracket_depth == 0,
      false => false,
    },
    false => false,
  };
  let colon_matches = match top_level {
    true => match punctuation {
      PunctColon => match punctuation_matches(source, index + 1, textlex.PunctColon) {
        true => false,
        false => match index > 0 {
          true => match punctuation_matches(source, index - 1, textlex.PunctColon) {
            true => false,
            false => true,
          },
          false => true,
        },
      },
      _ => false,
    },
    false => false,
  };
  match colon_matches {
    true => index,
    false => text_root_child_segment_colon(
      source,
      index + 1,
      limit,
      text_argument_scan_next_paren_depth(punctuation, paren_depth),
      text_argument_scan_next_brace_depth(punctuation, brace_depth),
      text_argument_scan_bracket_delta(source, index, bracket_depth)
    ),
  }
}

fn text_root_child_segment_colon(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  paren_depth: i32,
  brace_depth: i32,
  bracket_depth: i32
) -> i32 {
  match index >= limit {
    true => limit,
    false => text_root_child_segment_colon_continue(
      source,
      index,
      limit,
      paren_depth,
      brace_depth,
      bracket_depth
    ),
  }
}

fn text_root_child_segment_value_start(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  let spread_value_start = match text_spread_start_matches(source, start, limit) {
    true => text_expression_start_skip_trivia(source, start + 3, limit),
    false => start,
  };
  let colon = text_root_child_segment_colon(
    source,
    start,
    limit,
    0,
    0,
    0
  );
  match colon < limit {
    true => colon + 1,
    false => spread_value_start,
  }
}

fn text_root_child_call_role_tag() -> i32 {
  1
}

fn text_root_child_slot_role_tag() -> i32 {
  2
}

fn text_root_child_pipe_body_role_tag() -> i32 {
  3
}

fn text_root_child_do_bind_role_tag() -> i32 {
  4
}

fn text_root_child_do_expr_role_tag() -> i32 {
  5
}

fn text_root_child_do_final_role_tag() -> i32 {
  6
}

fn text_root_child_match_arm_role_tag() -> i32 {
  7
}

fn text_root_child_match_scrutinee_role_tag() -> i32 {
  8
}

fn text_root_child_match_guard_role_tag() -> i32 {
  9
}

fn text_root_child_segment_label_hash(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  child_role_tag: i32
) -> i32 {
  let is_slot = child_role_tag == text_root_child_slot_role_tag();
  match is_slot {
    false => 0,
    true => text_expression_start_skip_trivia(source, index, limit) \start -> match start >= limit {
      true => 0,
      false => match text_token_weight_matches(
        source,
        start,
        token.TokenKindWeight::Identifier
      ) {
        true => textlex.text_hash_at(source, start),
        false => 0,
      },
    },
  }
}

fn text_root_child_segment_signature(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32
) -> i32 {
  let value_start = text_root_child_segment_value_start(source, index, limit);
  text_child_value_segment_signature(source, value_start, limit, total)
}

fn text_child_value_segment_signature(
  source: textlex.TextTokenStream,
  value_start: i32,
  limit: i32,
  total: i32
) -> i32 {
  let with_kind = textmodel.signature_mix(
    total,
    text_expression_root_head_kind_tag_between(source, value_start, limit)
  );
  let with_hash = textmodel.signature_mix(
    with_kind,
    text_expression_root_head_hash_between(source, value_start, limit)
  );
  textmodel.signature_mix(
    with_hash,
    text_expression_root_type_class_tag_between(source, value_start, limit)
  )
}

fn text_root_child_record_value_fact_signature(
  source: textlex.TextTokenStream,
  value_start: i32,
  limit: i32,
  parent_kind_tag: i32,
  parent_name_hash: i32,
  child_index: i32,
  child_role_tag: i32,
  child_label_hash: i32
) -> i32 {
  let with_parent_kind = textmodel.signature_mix(67, parent_kind_tag);
  let with_parent_name = textmodel.signature_mix(
    with_parent_kind,
    parent_name_hash
  );
  let with_child_index = textmodel.signature_mix(
    with_parent_name,
    child_index
  );
  let with_child_role = textmodel.signature_mix(
    with_child_index,
    child_role_tag
  );
  let with_child_label = textmodel.signature_mix(
    with_child_role,
    child_label_hash
  );
  let with_child_kind = textmodel.signature_mix(
    with_child_label,
    text_expression_root_head_kind_tag_between(source, value_start, limit)
  );
  let with_child_hash = textmodel.signature_mix(
    with_child_kind,
    text_expression_root_head_hash_between(source, value_start, limit)
  );
  let with_child_type = textmodel.signature_mix(
    with_child_hash,
    text_expression_root_type_class_tag_between(source, value_start, limit)
  );
  let with_child_count = textmodel.signature_mix(
    with_child_type,
    text_expression_root_child_count_between(source, value_start, limit)
  );
  textmodel.signature_mix(
    with_child_count,
    text_expression_root_descendant_count_between(source, value_start, limit)
  )
}

fn text_root_child_record_fact_signature(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  parent_kind_tag: i32,
  parent_name_hash: i32,
  child_index: i32,
  child_role_tag: i32
) -> i32 {
  text_root_child_record_value_fact_signature(
    source,
    text_root_child_segment_value_start(source, index, limit),
    limit,
    parent_kind_tag,
    parent_name_hash,
    child_index,
    child_role_tag,
    text_root_child_segment_label_hash(source, index, limit, child_role_tag)
  )
}

fn text_root_child_record_scan_is_top_level(
  scan: TextRootChildRecordScan
) -> bool {
  match scan.paren_depth == 0 {
    true => match scan.brace_depth == 0 {
      true => scan.bracket_depth == 0,
      false => false,
    },
    false => false,
  }
}

fn text_root_child_record_scan_finish_present(
  source: textlex.TextTokenStream,
  scan: TextRootChildRecordScan
) -> TextRootChildRecordScan {
  let value_start = text_root_child_segment_value_start(
    source,
    scan.segment_start,
    scan.index
  );
  let fact_signature = text_root_child_record_fact_signature(
    source,
    scan.segment_start,
    scan.index,
    scan.parent_kind_tag,
    scan.parent_name_hash,
    scan.child_index,
    scan.child_role_tag
  );
  let with_fact = textmodel.signature_mix(scan.total, fact_signature);
  let nested = text_expression_root_child_record_signature_between_state(
    source,
    value_start,
    scan.index,
    scan.parent_kind_tag,
    scan.parent_name_hash,
    scan.child_index + 1,
    with_fact
  );
  TextRootChildRecordScan {
    index: scan.index,
    close_index: scan.close_index,
    segment_start: scan.segment_start,
    paren_depth: scan.paren_depth,
    brace_depth: scan.brace_depth,
    bracket_depth: scan.bracket_depth,
    child_index: nested.child_index,
    parent_kind_tag: scan.parent_kind_tag,
    parent_name_hash: scan.parent_name_hash,
    child_role_tag: scan.child_role_tag,
    total: nested.total,
    segment_saw_argument: false,
  }
}

fn text_root_child_record_scan_finish_segment(
  source: textlex.TextTokenStream,
  scan: TextRootChildRecordScan
) -> TextRootChildRecordScan {
  match scan.segment_saw_argument {
    true => text_root_child_record_scan_finish_present(source, scan),
    false => scan,
  }
}

fn text_root_child_record_scan_step(
  source: textlex.TextTokenStream,
  scan: TextRootChildRecordScan
) -> TextRootChildRecordScan {
  let punctuation = textlex.punctuation_at(source, scan.index);
  let top_level = text_root_child_record_scan_is_top_level(scan);
  let is_separator = match punctuation {
    PunctComma => top_level,
    _ => false,
  };
  let is_argument_token = match is_separator {
    true => false,
    false => match text_param_signature_is_trivia(source, scan.index) {
      true => false,
      false => true,
    },
  };
  let finished = match is_separator {
    true => text_root_child_record_scan_finish_segment(source, scan),
    false => scan,
  };
  TextRootChildRecordScan {
    index: scan.index + 1,
    close_index: scan.close_index,
    segment_start: match is_separator {
      true => scan.index + 1,
      false => finished.segment_start,
    },
    paren_depth: text_argument_scan_next_paren_depth(
      punctuation,
      scan.paren_depth
    ),
    brace_depth: text_argument_scan_next_brace_depth(
      punctuation,
      scan.brace_depth
    ),
    bracket_depth: text_argument_scan_bracket_delta(
      source,
      scan.index,
      scan.bracket_depth
    ),
    child_index: finished.child_index,
    parent_kind_tag: finished.parent_kind_tag,
    parent_name_hash: finished.parent_name_hash,
    child_role_tag: finished.child_role_tag,
    total: finished.total,
    segment_saw_argument: match is_separator {
      true => false,
      false => match is_argument_token {
        true => true,
        false => scan.segment_saw_argument,
      },
    },
  }
}

fn text_root_child_record_scan_loop(
  source: textlex.TextTokenStream,
  scan: TextRootChildRecordScan
) -> TextRootChildRecordScan {
  match scan.index >= scan.close_index {
    true => text_root_child_record_scan_finish_segment(source, scan),
    false => text_root_child_record_scan_loop(
      source,
      text_root_child_record_scan_step(source, scan)
    ),
  }
}

fn text_root_child_record_signature_in_delimiters(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32,
  parent_kind_tag: i32,
  parent_name_hash: i32,
  child_role_tag: i32,
  total: i32
) -> i32 {
  text_root_child_record_state_in_delimiters(
    source,
    open_index,
    close_index,
    parent_kind_tag,
    parent_name_hash,
    child_role_tag,
    0,
    total
  ).total
}

fn text_root_child_record_state_in_delimiters(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32,
  parent_kind_tag: i32,
  parent_name_hash: i32,
  child_role_tag: i32,
  child_index: i32,
  total: i32
) -> TextRootChildRecordState {
  let scan = text_root_child_record_scan_loop(
    source,
    TextRootChildRecordScan {
      index: open_index + 1,
      close_index: close_index,
      segment_start: open_index + 1,
      paren_depth: 0,
      brace_depth: 0,
      bracket_depth: 0,
      child_index: child_index,
      parent_kind_tag: parent_kind_tag,
      parent_name_hash: parent_name_hash,
      child_role_tag: child_role_tag,
      total: total,
      segment_saw_argument: false,
    }
  );
  TextRootChildRecordState {
    child_index: scan.child_index,
    total: scan.total,
  }
}

fn text_root_positional_child_record_scan_finish_present(
  source: textlex.TextTokenStream,
  scan: TextRootChildRecordScan
) -> TextRootChildRecordScan {
  let value_start = text_expression_start_skip_trivia(
    source,
    scan.segment_start,
    scan.index
  );
  let fact_signature = text_root_child_record_value_fact_signature(
    source,
    value_start,
    scan.index,
    scan.parent_kind_tag,
    scan.parent_name_hash,
    scan.child_index,
    scan.child_role_tag,
    0
  );
  let with_fact = textmodel.signature_mix(scan.total, fact_signature);
  let nested = text_expression_root_child_record_signature_between_state(
    source,
    value_start,
    scan.index,
    scan.parent_kind_tag,
    scan.parent_name_hash,
    scan.child_index + 1,
    with_fact
  );
  TextRootChildRecordScan {
    index: scan.index,
    close_index: scan.close_index,
    segment_start: scan.segment_start,
    paren_depth: scan.paren_depth,
    brace_depth: scan.brace_depth,
    bracket_depth: scan.bracket_depth,
    child_index: nested.child_index,
    parent_kind_tag: scan.parent_kind_tag,
    parent_name_hash: scan.parent_name_hash,
    child_role_tag: scan.child_role_tag,
    total: nested.total,
    segment_saw_argument: false,
  }
}

fn text_root_positional_child_record_scan_finish_segment(
  source: textlex.TextTokenStream,
  scan: TextRootChildRecordScan
) -> TextRootChildRecordScan {
  match scan.segment_saw_argument {
    true => text_root_positional_child_record_scan_finish_present(source, scan),
    false => scan,
  }
}

fn text_root_positional_child_record_scan_step(
  source: textlex.TextTokenStream,
  scan: TextRootChildRecordScan
) -> TextRootChildRecordScan {
  let punctuation = textlex.punctuation_at(source, scan.index);
  let top_level = text_root_child_record_scan_is_top_level(scan);
  let is_separator = match punctuation {
    PunctComma => top_level,
    _ => false,
  };
  let is_argument_token = match is_separator {
    true => false,
    false => match text_param_signature_is_trivia(source, scan.index) {
      true => false,
      false => true,
    },
  };
  let finished = match is_separator {
    true => text_root_positional_child_record_scan_finish_segment(source, scan),
    false => scan,
  };
  TextRootChildRecordScan {
    index: scan.index + 1,
    close_index: scan.close_index,
    segment_start: match is_separator {
      true => scan.index + 1,
      false => finished.segment_start,
    },
    paren_depth: text_argument_scan_next_paren_depth(
      punctuation,
      scan.paren_depth
    ),
    brace_depth: text_argument_scan_next_brace_depth(
      punctuation,
      scan.brace_depth
    ),
    bracket_depth: text_argument_scan_bracket_delta(
      source,
      scan.index,
      scan.bracket_depth
    ),
    child_index: finished.child_index,
    parent_kind_tag: finished.parent_kind_tag,
    parent_name_hash: finished.parent_name_hash,
    child_role_tag: finished.child_role_tag,
    total: finished.total,
    segment_saw_argument: match is_separator {
      true => false,
      false => match is_argument_token {
        true => true,
        false => scan.segment_saw_argument,
      },
    },
  }
}

fn text_root_positional_child_record_scan_loop(
  source: textlex.TextTokenStream,
  scan: TextRootChildRecordScan
) -> TextRootChildRecordScan {
  match scan.index >= scan.close_index {
    true => text_root_positional_child_record_scan_finish_segment(
      source,
      scan
    ),
    false => text_root_positional_child_record_scan_loop(
      source,
      text_root_positional_child_record_scan_step(source, scan)
    ),
  }
}

fn text_root_positional_child_record_state_between_segments(
  source: textlex.TextTokenStream,
  index: i32,
  close_index: i32,
  parent_kind_tag: i32,
  parent_name_hash: i32,
  child_role_tag: i32,
  child_index: i32,
  total: i32
) -> TextRootChildRecordState {
  let scan = text_root_positional_child_record_scan_loop(
    source,
    TextRootChildRecordScan {
      index: index,
      close_index: close_index,
      segment_start: index,
      paren_depth: 0,
      brace_depth: 0,
      bracket_depth: 0,
      child_index: child_index,
      parent_kind_tag: parent_kind_tag,
      parent_name_hash: parent_name_hash,
      child_role_tag: child_role_tag,
      total: total,
      segment_saw_argument: false,
    }
  );
  TextRootChildRecordState {
    child_index: scan.child_index,
    total: scan.total,
  }
}

fn text_root_do_open_after_start(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  paren_depth: i32
) -> i32 {
  match index >= limit {
    true => limit,
    false => match textlex.punctuation_at(source, index) {
      PunctLeftBrace => match paren_depth == 0 {
        true => index,
        false => text_root_do_open_after_start(
          source,
          index + 1,
          limit,
          paren_depth
        ),
      },
      _ => text_root_do_open_after_start(
        source,
        index + 1,
        limit,
        paren_depth_after_token(source, index, paren_depth)
      ),
    },
  }
}

fn text_do_bind_arrow_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  paren_depth: i32,
  brace_depth: i32,
  bracket_depth: i32
) -> i32 {
  match index >= limit {
    true => limit,
    false => text_depth_is_top_level(brace_depth, paren_depth) \top_level -> match top_level {
      true => match bracket_depth == 0 {
        true => match text_value_do_bind_token_matches(source, index) {
          true => index,
          false => text_do_bind_arrow_between(
            source,
            index + 1,
            limit,
            paren_depth_after_token(source, index, paren_depth),
            brace_depth_after_token(source, index, brace_depth),
            text_argument_scan_bracket_delta(source, index, bracket_depth)
          ),
        },
        false => text_do_bind_arrow_between(
          source,
          index + 1,
          limit,
          paren_depth_after_token(source, index, paren_depth),
          brace_depth_after_token(source, index, brace_depth),
          text_argument_scan_bracket_delta(source, index, bracket_depth)
        ),
      },
      false => text_do_bind_arrow_between(
        source,
        index + 1,
        limit,
        paren_depth_after_token(source, index, paren_depth),
        brace_depth_after_token(source, index, brace_depth),
        text_argument_scan_bracket_delta(source, index, bracket_depth)
      ),
    },
  }
}

fn text_do_segment_start_is_statement(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> bool {
  match start >= limit {
    true => true,
    false => match textlex.token_at(source, start).kind {
      LetKw => true,
      ConstKw => true,
      _ => false,
    },
  }
}

fn text_do_segment_role_tag(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  is_final: bool
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  match text_do_segment_start_is_statement(source, start, limit) {
    true => 0,
    false => text_do_bind_arrow_between(source, start, limit, 0, 0, 0) \bind_arrow -> match bind_arrow < limit {
      true => text_root_child_do_bind_role_tag(),
      false => match is_final {
        true => text_root_child_do_final_role_tag(),
        false => text_root_child_do_expr_role_tag(),
      },
    },
  }
}

fn text_do_segment_value_start(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  let bind_arrow = text_do_bind_arrow_between(source, start, limit, 0, 0, 0);
  match bind_arrow < limit {
    true => text_expression_start_skip_trivia(source, bind_arrow + 2, limit),
    false => start,
  }
}

fn text_root_do_child_scan_is_top_level(scan: TextRootDoChildScan) -> bool {
  match scan.paren_depth == 0 {
    true => match scan.brace_depth == 0 {
      true => scan.bracket_depth == 0,
      false => false,
    },
    false => false,
  }
}

fn text_root_do_child_scan_finish_present(
  source: textlex.TextTokenStream,
  scan: TextRootDoChildScan,
  is_final: bool
) -> TextRootDoChildScan {
  let role_tag = text_do_segment_role_tag(
    source,
    scan.segment_start,
    scan.index,
    is_final
  );
  match role_tag == 0 {
    true => TextRootDoChildScan {
      index: scan.index,
      close_index: scan.close_index,
      segment_start: scan.segment_start,
      paren_depth: scan.paren_depth,
      brace_depth: scan.brace_depth,
      bracket_depth: scan.bracket_depth,
      total_count: scan.total_count,
      total_signature: scan.total_signature,
      total_grandchild_count: scan.total_grandchild_count,
      total_grandchild_signature: scan.total_grandchild_signature,
      total_descendant_count: scan.total_descendant_count,
      total_descendant_signature: scan.total_descendant_signature,
      segment_saw_argument: false,
    },
    false => text_do_segment_value_start(
      source,
      scan.segment_start,
      scan.index
    ) \value_start -> text_root_child_scan_append_value(
      source,
      TextRootChildScan {
        index: scan.index,
        close_index: scan.close_index,
        segment_start: scan.segment_start,
        paren_depth: scan.paren_depth,
        brace_depth: scan.brace_depth,
        bracket_depth: scan.bracket_depth,
        total_count: scan.total_count,
        total_signature: scan.total_signature,
        total_grandchild_count: scan.total_grandchild_count,
        total_grandchild_signature: scan.total_grandchild_signature,
        total_descendant_count: scan.total_descendant_count,
        total_descendant_signature: scan.total_descendant_signature,
        segment_saw_argument: scan.segment_saw_argument,
      },
      value_start,
      scan.index
    ) \next -> TextRootDoChildScan {
      index: next.index,
      close_index: next.close_index,
      segment_start: next.segment_start,
      paren_depth: next.paren_depth,
      brace_depth: next.brace_depth,
      bracket_depth: next.bracket_depth,
      total_count: next.total_count,
      total_signature: next.total_signature,
      total_grandchild_count: next.total_grandchild_count,
      total_grandchild_signature: next.total_grandchild_signature,
      total_descendant_count: next.total_descendant_count,
      total_descendant_signature: next.total_descendant_signature,
      segment_saw_argument: next.segment_saw_argument,
    },
  }
}

fn text_root_do_child_scan_finish_segment(
  source: textlex.TextTokenStream,
  scan: TextRootDoChildScan,
  is_final: bool
) -> TextRootDoChildScan {
  match scan.segment_saw_argument {
    true => text_root_do_child_scan_finish_present(source, scan, is_final),
    false => scan,
  }
}

fn text_root_do_child_scan_step(
  source: textlex.TextTokenStream,
  scan: TextRootDoChildScan
) -> TextRootDoChildScan {
  let punctuation = textlex.punctuation_at(source, scan.index);
  let top_level = text_root_do_child_scan_is_top_level(scan);
  let is_separator = match punctuation {
    PunctSemicolon => top_level,
    _ => false,
  };
  let is_argument_token = match is_separator {
    true => false,
    false => match text_param_signature_is_trivia(source, scan.index) {
      true => false,
      false => true,
    },
  };
  let finished = match is_separator {
    true => text_root_do_child_scan_finish_segment(source, scan, false),
    false => scan,
  };
  TextRootDoChildScan {
    index: scan.index + 1,
    close_index: scan.close_index,
    segment_start: match is_separator {
      true => scan.index + 1,
      false => finished.segment_start,
    },
    paren_depth: paren_depth_after_token(source, scan.index, scan.paren_depth),
    brace_depth: brace_depth_after_token(source, scan.index, scan.brace_depth),
    bracket_depth: text_argument_scan_bracket_delta(
      source,
      scan.index,
      scan.bracket_depth
    ),
    total_count: finished.total_count,
    total_signature: finished.total_signature,
    total_grandchild_count: finished.total_grandchild_count,
    total_grandchild_signature: finished.total_grandchild_signature,
    total_descendant_count: finished.total_descendant_count,
    total_descendant_signature: finished.total_descendant_signature,
    segment_saw_argument: match is_separator {
      true => false,
      false => match is_argument_token {
        true => true,
        false => scan.segment_saw_argument,
      },
    },
  }
}

fn text_root_do_child_scan_loop(
  source: textlex.TextTokenStream,
  scan: TextRootDoChildScan
) -> TextRootDoChildScan {
  match scan.index >= scan.close_index {
    true => text_root_do_child_scan_finish_segment(source, scan, true),
    false => text_root_do_child_scan_loop(
      source,
      text_root_do_child_scan_step(source, scan)
    ),
  }
}

fn text_root_do_child_scan(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32,
  total_signature: i32,
  total_grandchild_signature: i32,
  total_descendant_signature: i32
) -> TextRootDoChildScan {
  text_root_do_child_scan_loop(
    source,
    TextRootDoChildScan {
      index: open_index + 1,
      close_index: close_index,
      segment_start: open_index + 1,
      paren_depth: 0,
      brace_depth: 0,
      bracket_depth: 0,
      total_count: 0,
      total_signature: total_signature,
      total_grandchild_count: 0,
      total_grandchild_signature: total_grandchild_signature,
      total_descendant_count: 0,
      total_descendant_signature: total_descendant_signature,
      segment_saw_argument: false,
    }
  )
}

