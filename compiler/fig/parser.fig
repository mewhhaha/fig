        source,
        index,
        text_declaration_end_from_index(source, index),
        depth
      ),
    },
  }
}

fn text_named_type_class_for_hash_scan(
  source: textlex.TextTokenStream,
  scan: TextNamedTypeLookupScan
) -> i32 {
  if scan.index >= scan.limit {
    text_type_class_unknown_tag()
  } else {
    match scan.depth <= 0 {
      true => text_type_class_unknown_tag(),
      false => match text_named_type_hash_found_at(
        source,
        scan.index,
        scan.brace_depth,
        scan.paren_depth,
        scan.target_hash
      ) {
        true => text_named_type_class_result(
          text_type_declaration_environment_type_class_tag(
            source,
            scan.index,
            scan.depth - 1
          )
        ),
        false => text_named_type_class_for_hash_scan(
          source,
          TextNamedTypeLookupScan {
            index: scan.index + 1,
            limit: scan.limit,
            brace_depth: brace_depth_after_token(source, scan.index, scan.brace_depth),
            paren_depth: paren_depth_after_token(source, scan.index, scan.paren_depth),
            target_hash: scan.target_hash,
            depth: scan.depth,
          }
        ),
      },
    }
  }
}

fn text_named_type_hash_found_at(
  source: textlex.TextTokenStream,
  index: i32,
  brace_depth: i32,
  paren_depth: i32,
  target_hash: i32
) -> bool {
  let is_top_declaration = is_text_top_level_declaration_start(
    source,
    index,
    brace_depth,
    paren_depth
  );
  let found = match is_top_declaration {
    true => match text_token_weight_matches(source, index, 17) {
      true => textlex.text_hash_at(
        source,
        text_type_name_index(source, index)
      ) == target_hash,
      false => false,
    },
    false => false,
  };
  found
}

fn text_named_type_class_for_hash_with_depth(
  source: textlex.TextTokenStream,
  target_hash: i32,
  depth: i32
) -> i32 {
  text_named_type_class_for_hash_scan(
    source,
    TextNamedTypeLookupScan {
      index: 0,
      limit: textlex.length(source),
      brace_depth: 0,
      paren_depth: 0,
      target_hash: target_hash,
      depth: depth,
    }
  )
}

fn text_named_type_class_for_hash(
  source: textlex.TextTokenStream,
  target_hash: i32
) -> i32 {
  text_named_type_class_for_hash_with_depth(
    source,
    target_hash,
    4
  )
}

fn text_annotation_resolved_type_class_tag_from_hash(
  source: textlex.TextTokenStream,
  value_hash: i32
) -> i32 {
  let primitive = text_annotation_type_class_tag_from_hash(value_hash);
  match primitive == text_type_class_unknown_tag() {
    true => text_named_type_class_for_hash(source, value_hash),
    false => primitive,
  }
}

fn text_annotation_resolved_type_class_tag_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  match index >= limit {
    true => text_type_class_unknown_tag(),
    false => match text_param_signature_is_trivia(source, index) {
      true => text_annotation_resolved_type_class_tag_between(
        source,
        index + 1,
        limit
      ),
      false => text_annotation_resolved_type_class_tag_from_hash(
        source,
        textlex.text_hash_at(source, index)
      ),
    },
  }
}

fn text_function_return_resolved_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  let arrow = text_function_arrow_index(source, close_paren, next);
  let left_brace = text_function_left_brace_index(source, arrow, next);
  let body_start = text_function_body_start_index(source, arrow, left_brace);
  text_annotation_resolved_type_class_tag_between(source, arrow + 1, body_start)
}

fn text_value_annotation_resolved_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let equal = text_find_top_level_punctuation_score(
    source,
    index + 2,
    next,
    0,
    1
  );
  let colon = text_find_top_level_punctuation_score(
    source,
    index + 2,
    equal,
    0,
    8
  );
  match colon < equal {
    true => text_annotation_resolved_type_class_tag_between(source, colon + 1, equal),
    false => text_type_class_unknown_tag(),
  }
}

fn text_declaration_resolved_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  match text_declaration_kind_tag(source, index, decl) {
    1 => text_type_class_function_tag(),
    2 => text_value_annotation_resolved_type_class_tag(source, index),
    3 => text_value_annotation_resolved_type_class_tag(source, index),
    4 => text_type_declaration_environment_type_class_tag(
      source,
      index,
      4
    ),
    _ => text_type_class_unknown_tag(),
  }
}

fn text_declaration_resolved_type_class_payload(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  match text_declaration_kind_tag(source, index, decl) {
    1 => ast.decl_param_count(decl) * 31
      + text_function_return_resolved_type_class_tag(source, index),
    _ => 0,
  }
}

fn text_declaration_resolved_declared_type_class_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  text_signature_mix(
    total,
    text_declared_type_class_hash(
      kind_tag,
      text_declaration_resolved_type_class_tag(source, index, decl),
      text_declaration_resolved_type_class_payload(source, index, decl)
    )
  )
}

fn text_declaration_resolved_abi_class_tag(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  match text_declaration_kind_tag(source, index, decl) {
    1 => text_abi_class_function_tag(),
    2 => text_abi_class_tag_for_type_class(
      text_value_annotation_resolved_type_class_tag(source, index)
    ),
    3 => text_abi_class_tag_for_type_class(
      text_value_annotation_resolved_type_class_tag(source, index)
    ),
    4 => text_abi_class_tag_for_type_class(
      text_type_declaration_environment_type_class_tag(
        source,
        index,
        4
      )
    ),
    _ => text_abi_class_void_tag(),
  }
}

fn text_declaration_resolved_declared_abi_class_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  text_signature_mix(
    total,
    text_declared_abi_class_hash(
      kind_tag,
      text_declaration_resolved_abi_class_tag(source, index, decl)
    )
  )
}

fn text_declaration_resolved_symbol_environment_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  let name_index = text_declaration_name_index(source, index, decl);
  text_signature_mix(
    total,
    text_symbol_environment_hash(
      kind_tag,
      textlex.text_hash_at(source, name_index),
      text_declaration_resolved_type_class_tag(source, index, decl),
      text_declaration_resolved_type_class_payload(source, index, decl),
      text_declaration_resolved_abi_class_tag(source, index, decl)
    )
  )
}

fn text_declaration_resolved_export_abi_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  match text_declaration_start(source, index) {
    TextPubFunctionDeclaration => text_signature_mix(
      total,
      text_export_abi_hash(
        textlex.text_hash_at(source, text_function_name_index(source, index)),
        ast.decl_param_count(decl),
        text_abi_class_tag_for_type_class(
          text_function_return_resolved_type_class_tag(source, index)
        )
      )
    ),
    _ => total,
  }
}

fn text_declaration_resolved_expected_body_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  match text_declaration_kind_tag(source, index, decl) {
    1 => text_function_return_resolved_type_class_tag(source, index),
    2 => text_value_annotation_resolved_type_class_tag(source, index),
    3 => text_value_annotation_resolved_type_class_tag(source, index),
    _ => text_type_class_unknown_tag(),
  }
}

fn text_declaration_resolved_simple_body_type_check_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  let expected = text_declaration_resolved_expected_body_type_class_tag(source, index, decl);
  let actual = text_declaration_resolved_value_body_type_class_tag(source, index, decl);
  text_signature_mix(
    total,
    text_simple_body_type_check_hash(
      kind_tag,
      expected,
      actual,
      text_simple_body_type_check_status(expected, actual)
    )
  )
}

fn text_direct_import_resolved_declared_signature_total(
  context: TextDirectImportContext,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  match textmodel.import_resolution_mode_is_abi(context.mode) {
    true => text_declaration_direct_import_resolved_declared_abi_class_total(
      context,
      index,
      decl,
      total
    ),
    false => text_declaration_direct_import_resolved_declared_type_class_total(
      context,
      index,
      decl,
      total
    ),
  }
}

fn text_direct_import_resolved_scan_advance(
  context: TextDirectImportContext,
  current: combinator.ParseState,
  total: i32,
  result: combinator.Reply(DeclFrame)
) -> i32 {
  let current_index = current.cursor;
  let decl = result.value.decl;
  let next_total = text_direct_import_resolved_declared_signature_total(
    context,
    current_index,
    decl,
    total
  );
  let next = next_text_declaration_state(result.state, context.source);
  text_direct_import_resolved_scan_loop(context, next, next_total)
}

fn text_direct_import_resolved_scan_loop(
  context: TextDirectImportContext,
  current: combinator.ParseState,
  total: i32
) -> i32 {
  match current.cursor < textlex.length(context.source) {
    false => total,
    true => match parse_text_declaration_stream(
      current,
      context.source,
      total
    ) {
      Err(_) => total,
      Ok(result) => text_direct_import_resolved_scan_advance(
        context,
        current,
        total,
        result
      ),
    },
  }
}

