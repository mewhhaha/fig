fn push_param_frame(
  value: ParamListFrame,
  param: ParamFrame,
  separator_width: i32
) -> ParamListFrame {
  param_list_frame(
    vec.Vec::push(value.params, param),
    value.count + 1,
    value.consumed + param.consumed + separator_width
  )
}

