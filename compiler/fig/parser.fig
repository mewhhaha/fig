      window.limit,
      total
    ))
  }
}

fn text_value_body_count_between(
  source: textlex.TextTokenStream,
  window: TextValueBodyWindow,
  kind: TextValueBodyCount
) -> i32 {
  match window.found {
    false => 0,
    true => text_value_body_count_scan(
      source,
      window.start,
      window.limit,
      0,
      kind
    ),
  }
}

fn text_declaration_value_body_count_reader(
  kind: TextValueBodyCount
) -> monad.Reader(TextValueBodyContext, i32) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    source <- monad.Reader::asks(text_value_body_context_source);
    window <- text_declaration_value_body_window_reader();
    pure(text_value_body_count_between(source, window, kind))
  }
}

fn text_declaration_value_body_count_delta(
