fn text_pipe_bind_token_matches(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match punctuation_matches(source, index, textlex.PunctOther) {
    false => false,
    true => textlex.text_hash_at(source, index) == 92,
  }
}

fn text_token_can_end_value_expr(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match textlex.punctuation_at(source, index) {
    PunctRightParen => true,
    PunctRightBrace => true,
    _ => match text_token_weight_matches(source, index, token.TokenKindWeight::BoolLiteral) {
      true => true,
      false => match textlex.token_at(source, index).kind {
        Identifier => true,
        LiteralType => true,
        NumberLiteral => true,
        StringLiteral => true,
        CharLiteral => true,
        MultilineLiteral => true,
        _ => false,
      },
    },
  }
}

fn text_value_pipe_bind_token_matches(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match text_pipe_bind_token_matches(source, index) {
    false => false,
    true => text_token_can_end_value_expr(source, index - 1),
  }
}

fn text_root_pipe_bind_scan_is_top_level(scan: TextRootPipeBindScan) -> bool {
  match scan.paren_depth == 0 {
    true => match scan.brace_depth == 0 {
      true => scan.bracket_depth == 0,
      false => false,
    },
    false => false,
  }
}

fn text_root_pipe_bind_scan_step(
  source: textlex.TextTokenStream,
  scan: TextRootPipeBindScan
) -> TextRootPipeBindScan {
  let is_top_level = text_root_pipe_bind_scan_is_top_level(scan);
  let current_matches = match is_top_level {
    true => match scan.index > scan.start {
      true => text_value_pipe_bind_token_matches(source, scan.index),
      false => false,
    },
    false => false,
  };
  TextRootPipeBindScan {
    index: scan.index + 1,
    start: scan.start,
    limit: scan.limit,
    paren_depth: paren_depth_after_token(source, scan.index, scan.paren_depth),
    brace_depth: brace_depth_after_token(source, scan.index, scan.brace_depth),
    bracket_depth: text_argument_scan_bracket_delta(
      source,
      scan.index,
      scan.bracket_depth
    ),
    result: match current_matches {
      true => scan.index,
      false => scan.result,
    },
    done: current_matches,
  }
}

fn text_root_pipe_bind_scan_loop(
  source: textlex.TextTokenStream,
  scan: TextRootPipeBindScan
) -> TextRootPipeBindScan {
  match scan.done {
    true => scan,
    false => match scan.index >= scan.limit {
      true => scan,
      false => text_root_pipe_bind_scan_loop(
        source,
        text_root_pipe_bind_scan_step(source, scan)
      ),
    },
  }
}

fn text_root_pipe_bind_index_from_start(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> i32 {
  text_root_pipe_bind_scan_loop(
    source,
    TextRootPipeBindScan {
      index: start,
      start: start,
      limit: limit,
      paren_depth: 0,
      brace_depth: 0,
      bracket_depth: 0,
      result: limit,
      done: false,
    }
  ).result
}

fn text_pipe_bind_arrow_index(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  match index >= limit {
    true => limit,
    false => match punctuation_matches(source, index, textlex.PunctArrow) {
      true => index,
      false => text_pipe_bind_arrow_index(source, index + 1, limit),
    },
