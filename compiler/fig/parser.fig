fn text_declaration_function_local_type_assert_delta(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  monad.Reader::run(
    text_declaration_function_local_type_assert_count_reader(),
    text_value_body_context(source, index, decl)
  )
}

