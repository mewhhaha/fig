fn text_declaration_resolved_abi_class_tag(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  match text_declaration_kind_is_function(kind_tag) {
    true => text_abi_class_function_tag(),
    false => match text_declaration_kind_is_value_binding(kind_tag) {
      true => text_abi_class_tag_for_type_class(
        text_value_annotation_resolved_type_class_tag(source, index)
      ),
      false => match text_declaration_kind_is_type(kind_tag) {
        true => text_abi_class_tag_for_type_class(
          text_type_declaration_environment_type_class_tag(
            source,
            index,
            kind_tag
          )
        ),
        false => text_abi_class_void_tag(),
      },
    },
  }
}

fn text_declaration_resolved_declared_abi_class_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  monad.Reader::run(
    text_declaration_resolved_declared_abi_class_signature_total_reader(total),
    text_value_body_context(source, index, decl)
  )
}

fn text_declaration_resolved_symbol_environment_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  monad.Reader::run(
    text_declaration_resolved_symbol_environment_signature_total_reader(total),
    text_value_body_context(source, index, decl)
  )
}

fn text_declaration_resolved_export_abi_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  monad.Reader::run(
    text_declaration_resolved_export_abi_signature_total_reader(total),
    text_value_body_context(source, index, decl)
  )
}

fn text_declaration_resolved_expected_body_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  match is_text_non_value_declaration_start(source, index) {
    true => text_type_class_unknown_tag(),
    false => match text_declaration_kind_is_function(kind_tag) {
      true => text_function_return_resolved_type_class_tag(source, index),
      false => match text_declaration_kind_is_value_binding(kind_tag) {
        true => text_value_annotation_resolved_type_class_tag(source, index),
        false => text_type_class_unknown_tag(),
      },
    },
  }
}

fn text_declaration_resolved_simple_body_type_check_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  monad.Reader::run(
    text_declaration_resolved_simple_body_type_check_signature_total_reader(total),
    text_value_body_context(source, index, decl)
  )
}

fn text_direct_import_resolved_declared_signature_total(
  context: TextDirectImportContext,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  match textmodel.import_resolution_mode_is_abi(context.mode) {
    true => text_declaration_direct_import_resolved_declared_abi_class_total(
      context,
      index,
      decl,
      total
    ),
    false => text_declaration_direct_import_resolved_declared_type_class_total(
      context,
      index,
      decl,
      total
    ),
  }
}

fn text_direct_import_resolved_fold_total(
  fold: TextDirectImportFold,
  context: TextDirectImportContext,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  match is_text_external_import_start(context.source, index) {
    true => total,
    false => match fold {
      DirectImportDeclaredSignature => text_direct_import_resolved_declared_signature_total(
        context,
        index,
        decl,
        total
      ),
      DirectImportSymbolEnvironment =>
        text_declaration_direct_import_resolved_symbol_environment_total(
          context,
          index,
          decl,
          total
        ),
      DirectImportExportAbi => text_declaration_direct_import_resolved_export_abi_total(
        context,
        index,
        decl,
        total
      ),
      DirectImportValueBody =>
        text_declaration_direct_import_resolved_value_body_signature_total(
          context,
          index,
          decl,
          total
        ),
      DirectImportSimpleBodyTypeCheck =>
        text_declaration_direct_import_resolved_simple_body_type_check_total(
          context,
          index,
          decl,
          total
        ),
    },
  }
}

fn text_direct_import_resolved_fold_advance(
  fold: TextDirectImportFold,
  context: TextDirectImportContext,
  current: combinator.ParseState,
  total: i32,
  result: combinator.Reply(DeclFrame)
) -> i32 {
  let next_total = text_direct_import_resolved_fold_total(
    fold,
    context,
    current.cursor,
    result.value.decl,
    total
  );
  text_direct_import_resolved_fold_loop(
    fold,
    context,
    next_text_declaration_state(result.state, context.source),
    next_total
  )
}

fn text_direct_import_resolved_fold_loop(
  fold: TextDirectImportFold,
  context: TextDirectImportContext,
  current: combinator.ParseState,
  total: i32
) -> i32 {
  match current.cursor < textlex.length(context.source) {
    false => total,
    true => match parse_text_declaration_stream(
      current,
      context.source,
      total
    ) {
      Err(_) => total,
      Ok(result) => text_direct_import_resolved_fold_advance(
        fold,
        context,
        current,
        total,
        result
      ),
    },
  }
}

fn text_direct_import_resolved_signature_for_alias(
  fold: TextDirectImportFold,
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  alias_hash: i32,
  mode: textmodel.ImportResolutionMode
) -> i32 {
  let context = match fold {
    DirectImportValueBody => text_direct_import_context_with_resolution(
      source,
      import_source,
      mode,
      alias_hash
    ),
    DirectImportSimpleBodyTypeCheck => text_direct_import_context_with_resolution(
      source,
      import_source,
      mode,
      alias_hash
    ),
    _ => text_direct_import_context(source, import_source, mode, alias_hash),
  };
  text_direct_import_resolved_fold_loop(
    fold,
    context,
    combinator.state(0, textlex.length(source)),
    0
  )
}

fn text_direct_import_resolved_declared_signature(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  module_hash: i32,
  mode: textmodel.ImportResolutionMode
) -> i32 {
  let alias_hash = text_direct_import_alias_hash(source, module_hash);
  match alias_hash == 0 {
    true => 0,
    false => text_direct_import_resolved_signature_for_alias(
      DirectImportDeclaredSignature,
      source,
      import_source,
      alias_hash,
      mode
    ),
  }
}

