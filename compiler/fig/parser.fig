const textlex = @import("./textlex.fig");
const textmodel = @import("./textmodel.fig");
const textparser = @import("./textparser.fig");
const token = @import("./token.fig");

type TokenView = struct {
  kind: token.TokenKind,
  span: span.Span,
}

type DeclFrame = struct {
  decl: ast.Decl,
  consumed: i32,
}

type ExprFrame = struct {
  expr: ast.Expr,
  consumed: i32,
}

type ParamFrame = struct {
  param: ast.Param,
  consumed: i32,
}

type ParamListFrame = struct {
  params: vec.Vec(ParamFrame),
  count: i32,
  consumed: i32,
}

type TypeAnnotationFrame = struct {
  annotation: ast.TypeAnnotation,
  consumed: i32,
}

type TextDeclarationStart = union {
  TextNoDeclaration, TextRegularDeclaration(kind: token.DeclarationKind),
  TextPubFunctionDeclaration, TextSourceImportDeclaration
}

