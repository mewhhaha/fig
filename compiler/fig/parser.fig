    decl <- monad.Reader::asks(text_direct_import_decl_decl);
    kind_tag <- text_direct_import_decl_kind_tag_reader();
    pure(text_signature_mix(
      total,
      text_declared_type_class_hash(
        kind_tag,
        text_declaration_direct_import_resolved_type_class_tag(
          import_context.source,
          import_context.import_source,
          index,
          decl,
          import_context.alias_hash
        ),
        text_declaration_direct_import_resolved_type_class_payload(
          import_context.source,
          import_context.import_source,
          index,
          decl,
          import_context.alias_hash
        )
      )
    ))
