  monad.Reader::run(
    text_declaration_value_root_int_reader(metric, missing),
    text_value_body_context(source, index, decl)
  )
}

fn text_value_root_signature_between(
  source: textlex.TextTokenStream,
  window: TextValueBodyWindow,
  metric: TextValueRootSignature,
  total: i32
) -> i32 {
  match window.found {
    false => total,
    true => match metric {
      TextValueRootChildSignature => text_expression_root_child_signature_between(
        source,
        window.start,
        window.limit,
        total
      ),
      TextValueRootGrandchildSignature =>
        text_expression_root_grandchild_signature_between(
          source,
          window.start,
          window.limit,
          total
        ),
      TextValueRootDescendantSignature =>
        text_expression_root_descendant_signature_between(
          source,
          window.start,
          window.limit,
          total
        ),
    },
  }
}

fn text_declaration_value_root_signature_reader(
