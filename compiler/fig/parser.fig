fn text_value_call_token_matches(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match punctuation_matches(source, index, textlex.PunctLeftParen) {
    false => false,
    true => match index > 0 {
      false => false,
      true => match text_token_can_end_value_expr(source, index - 1) {
        false => false,
        true => match text_value_call_is_do_strategy_annotation(source, index - 1) {
          true => false,
          false => match text_value_call_is_match_pattern_constructor(source, index) {
            true => false,
            false => true,
          },
        },
      },
    },
  }
}

fn text_value_call_is_do_strategy_annotation(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match index < 0 {
    true => false,
    false => match text_token_kind_matches(source, index, token.DoKw) {
      true => true,
      false => match textlex.punctuation_at(source, index) {
        PunctSemicolon => false,
        PunctLeftBrace => false,
        PunctRightBrace => false,
        _ => text_value_call_is_do_strategy_annotation(source, index - 1),
      },
    },
  }
}

fn text_value_call_is_match_pattern_constructor(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  let previous_is_constructor = match textlex.token_at(source, index - 1).kind {
    LiteralType => true,
    _ => false,
  };
  match previous_is_constructor {
    false => false,
    true => match text_value_call_previous_is_match_arm_arrow(source, index) {
      true => false,
      false => match text_value_call_is_qualified_name(source, index) {
        true => false,
        false => find_text_matching_right_paren(
          source,
          index + 1,
          textlex.length(source),
          0
        ) \close -> text_value_call_has_match_arm_arrow_after(
          source,
          close + 1,
          textlex.length(source),
          0,
          0
        ),
      },
    },
  }
}

fn text_value_call_is_qualified_name(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match index > 1 {
    false => false,
    true => match textlex.punctuation_at(source, index - 2) {
      PunctOther => textlex.text_hash_at(source, index - 2) == text_dot_hash(),
      _ => false,
    },
  }
}

fn text_value_call_previous_is_match_arm_arrow(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match index > 2 {
    false => false,
    true => text_value_match_arm_token_matches(source, index - 3),
  }
}

fn text_value_call_has_match_arm_arrow_after(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  brace_depth: i32,
  paren_depth: i32
) -> bool {
  match index >= limit {
    true => false,
    false => text_depth_is_top_level(brace_depth, paren_depth) \top_level -> match top_level {
      true => match text_value_match_arm_token_matches(source, index) {
        true => true,
        false => match textlex.punctuation_at(source, index) {
          PunctSemicolon => false,
          PunctRightParen => false,
          PunctRightBrace => false,
          _ => text_value_call_has_match_arm_arrow_after(
            source,
            index + 1,
            limit,
            brace_depth_after_token(source, index, brace_depth),
            paren_depth_after_token(source, index, paren_depth)
          ),
        },
      },
      false => text_value_call_has_match_arm_arrow_after(
        source,
        index + 1,
        limit,
        brace_depth_after_token(source, index, brace_depth),
        paren_depth_after_token(source, index, paren_depth)
      ),
    },
  }
}

fn text_value_call_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32
) -> i32 {
  if index >= limit {
    total
  } else {
    let current_matches = text_value_call_token_matches(source, index);
    let next_total = match current_matches {
      true => total + 1,
      false => total,
    };
    text_value_call_count_between(
      source,
      index + 1,
      limit,
      next_total
    )
  }
}

