    0,
    0,
    total
  ).total_descendant_signature
}

fn text_root_match_child_record_scan_is_top_level(
  scan: TextRootMatchChildRecordScan
) -> bool {
  match scan.paren_depth == 0 {
    true => match scan.brace_depth == 0 {
      true => scan.bracket_depth == 0,
      false => false,
    },
    false => false,
  }
}

fn text_root_match_child_record_scan_has_value(
  scan: TextRootMatchChildRecordScan
) -> bool {
  scan.segment_start < scan.close_index
}

fn text_root_match_child_record_scan_finish_present(
  source: textlex.TextTokenStream,
  scan: TextRootMatchChildRecordScan
) -> TextRootMatchChildRecordScan {
  let value_start = text_expression_start_skip_trivia(
    source,
    scan.segment_start,
    scan.index
  );
  match value_start >= scan.index {
    true => TextRootMatchChildRecordScan {
      index: scan.index,
      close_index: scan.close_index,
      segment_start: scan.close_index,
      arm_start: scan.arm_start,
      paren_depth: scan.paren_depth,
      brace_depth: scan.brace_depth,
      bracket_depth: scan.bracket_depth,
      child_index: scan.child_index,
      parent_kind_tag: scan.parent_kind_tag,
      parent_name_hash: scan.parent_name_hash,
      total: scan.total,
      segment_saw_argument: false,
    },
    false => text_root_match_child_record_scan_append_value(
      source,
      scan,
      value_start,
      scan.index,
      text_root_child_match_arm_role_tag()
    ) \next -> TextRootMatchChildRecordScan {
      index: next.index,
      close_index: next.close_index,
      segment_start: scan.close_index,
      arm_start: next.arm_start,
      paren_depth: next.paren_depth,
      brace_depth: next.brace_depth,
      bracket_depth: next.bracket_depth,
      child_index: next.child_index,
      parent_kind_tag: next.parent_kind_tag,
      parent_name_hash: next.parent_name_hash,
      total: next.total,
      segment_saw_argument: false,
    },
  }
}

fn text_root_match_child_record_scan_append_value(
  source: textlex.TextTokenStream,
  scan: TextRootMatchChildRecordScan,
  value_start: i32,
  value_limit: i32,
  child_role_tag: i32
) -> TextRootMatchChildRecordScan {
  text_root_child_record_value_fact_signature(
      source,
      value_start,
    value_limit,
      scan.parent_kind_tag,
      scan.parent_name_hash,
      scan.child_index,
    child_role_tag,
      0
    ) \fact_signature -> text_expression_root_child_record_signature_between_state(
      source,
      value_start,
    value_limit,
      scan.parent_kind_tag,
      scan.parent_name_hash,
      scan.child_index + 1,
      textmodel.signature_mix(scan.total, fact_signature)
    ) \nested -> TextRootMatchChildRecordScan {
      index: scan.index,
      close_index: scan.close_index,
    segment_start: scan.segment_start,
    arm_start: scan.arm_start,
      paren_depth: scan.paren_depth,
      brace_depth: scan.brace_depth,
      bracket_depth: scan.bracket_depth,
      child_index: nested.child_index,
      parent_kind_tag: scan.parent_kind_tag,
      parent_name_hash: scan.parent_name_hash,
      total: nested.total,
      segment_saw_argument: false,
  }
}

fn text_root_match_child_record_scan_append_guard(
  source: textlex.TextTokenStream,
  scan: TextRootMatchChildRecordScan
) -> TextRootMatchChildRecordScan {
  let guard_start = text_match_arm_guard_start_between(
    source,
    scan.arm_start,
    scan.index
  );
  match guard_start < scan.index {
    true => text_root_match_child_record_scan_append_value(
      source,
      scan,
      guard_start,
      scan.index,
      text_root_child_match_guard_role_tag()
    ),
    false => scan,
  }
}

fn text_root_match_child_record_scan_finish_segment(
  source: textlex.TextTokenStream,
  scan: TextRootMatchChildRecordScan
) -> TextRootMatchChildRecordScan {
  match scan.segment_saw_argument {
    true => text_root_match_child_record_scan_finish_present(source, scan),
    false => scan,
  }
}

fn text_root_match_child_record_scan_step(
  source: textlex.TextTokenStream,
  scan: TextRootMatchChildRecordScan
) -> TextRootMatchChildRecordScan {
  let punctuation = textlex.punctuation_at(source, scan.index);
  let top_level = text_root_match_child_record_scan_is_top_level(scan);
  let has_value = text_root_match_child_record_scan_has_value(scan);
  let is_arrow = match top_level {
    true => match has_value {
      true => false,
      false => text_value_match_arm_token_matches(source, scan.index),
    },
    false => false,
  };
  let is_separator = match top_level {
    true => match has_value {
      true => match punctuation {
        PunctComma => true,
        _ => false,
      },
      false => false,
    },
    false => false,
  };
  let is_argument_token = match is_arrow {
    true => false,
    false => match is_separator {
      true => false,
      false => match has_value {
        false => false,
        true => match scan.index < scan.segment_start {
          true => false,
          false => match text_param_signature_is_trivia(source, scan.index) {
            true => false,
            false => true,
          },
        },
      },
    },
  };
  let finished = match is_separator {
    true => text_root_match_child_record_scan_finish_segment(source, scan),
    false => scan,
  };
  let with_guard = match is_arrow {
    true => text_root_match_child_record_scan_append_guard(source, finished),
    false => finished,
  };
  TextRootMatchChildRecordScan {
    index: match is_arrow {
      true => scan.index + 2,
      false => scan.index + 1,
    },
    close_index: scan.close_index,
    segment_start: match is_arrow {
      true => scan.index + 2,
      false => match is_separator {
        true => scan.close_index,
        false => with_guard.segment_start,
      },
    },
    arm_start: match is_separator {
      true => scan.index + 1,
      false => with_guard.arm_start,
    },
    paren_depth: match is_arrow {
      true => scan.paren_depth,
      false => paren_depth_after_token(source, scan.index, scan.paren_depth),
    },
    brace_depth: match is_arrow {
      true => scan.brace_depth,
      false => brace_depth_after_token(source, scan.index, scan.brace_depth),
    },
    bracket_depth: match is_arrow {
      true => scan.bracket_depth,
      false => text_argument_scan_bracket_delta(
        source,
        scan.index,
        scan.bracket_depth
      ),
    },
    child_index: with_guard.child_index,
    parent_kind_tag: with_guard.parent_kind_tag,
    parent_name_hash: with_guard.parent_name_hash,
    total: with_guard.total,
    segment_saw_argument: match is_arrow {
      true => false,
      false => match is_separator {
        true => false,
        false => match is_argument_token {
          true => true,
          false => scan.segment_saw_argument,
        },
      },
    },
  }
}

fn text_root_match_child_record_scan_loop(
  source: textlex.TextTokenStream,
  scan: TextRootMatchChildRecordScan
) -> TextRootMatchChildRecordScan {
  match scan.index >= scan.close_index {
    true => text_root_match_child_record_scan_finish_segment(source, scan),
    false => text_root_match_child_record_scan_loop(
      source,
      text_root_match_child_record_scan_step(source, scan)
    ),
  }
}

fn text_root_match_child_record_state_in_block(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32,
  parent_kind_tag: i32,
  parent_name_hash: i32,
  child_index: i32,
  total: i32
) -> TextRootChildRecordState {
  let scan = text_root_match_child_record_scan_loop(
    source,
    TextRootMatchChildRecordScan {
      index: open_index + 1,
      close_index: close_index,
      segment_start: close_index,
      arm_start: open_index + 1,
      paren_depth: 0,
      brace_depth: 0,
      bracket_depth: 0,
      child_index: child_index,
      parent_kind_tag: parent_kind_tag,
      parent_name_hash: parent_name_hash,
      total: total,
      segment_saw_argument: false,
    }
  );
  TextRootChildRecordState {
    child_index: scan.child_index,
    total: scan.total,
  }
}

fn text_root_match_body_open_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> i32 {
  text_match_body_open_after_start(source, start + 1, limit, 0, 0, 0)
}

fn text_root_match_child_count_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> i32 {
  let open_index = text_root_match_body_open_between(source, start, limit);
  match open_index < limit {
    false => 0,
    true => find_text_right_brace(source, open_index + 1, limit, 0) \close_index -> match close_index < limit {
      true => text_expression_start_skip_trivia(
        source,
        start + 1,
        open_index
      ) \value_start -> match value_start < open_index {
        true => 1 + text_root_match_child_count_in_block(
          source,
          open_index,
          close_index
        ),
        false => text_root_match_child_count_in_block(
          source,
          open_index,
          close_index
        ),
      },
      false => 0,
    },
  }
}

fn text_root_match_child_signature_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  total: i32
) -> i32 {
  let open_index = text_root_match_body_open_between(source, start, limit);
  match open_index < limit {
    false => total,
    true => find_text_right_brace(source, open_index + 1, limit, 0) \close_index -> match close_index < limit {
      true => text_expression_start_skip_trivia(
        source,
        start + 1,
        open_index
      ) \value_start -> text_root_match_child_signature_in_block(
        source,
        open_index,
        close_index,
        match value_start < open_index {
          true => text_match_values_segment_signature(
            source,
            value_start,
            open_index,
            total
          ),
          false => total,
        }
      ),
      false => total,
    },
  }
}

fn text_root_match_grandchild_count_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> i32 {
  let open_index = text_root_match_body_open_between(source, start, limit);
  match open_index < limit {
    false => 0,
    true => find_text_right_brace(source, open_index + 1, limit, 0) \close_index -> match close_index < limit {
      true => text_expression_start_skip_trivia(
        source,
        start + 1,
        open_index
      ) \value_start -> match value_start < open_index {
        true => text_match_values_child_count_between(
          source,
          value_start,
          open_index
        ) + text_root_match_grandchild_count_in_block(
          source,
          open_index,
          close_index
        ),
        false => text_root_match_grandchild_count_in_block(
          source,
          open_index,
          close_index
        ),
      },
      false => 0,
    },
  }
}

fn text_root_match_grandchild_signature_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  total: i32
) -> i32 {
  let open_index = text_root_match_body_open_between(source, start, limit);
  match open_index < limit {
    false => total,
    true => find_text_right_brace(source, open_index + 1, limit, 0) \close_index -> match close_index < limit {
      true => text_expression_start_skip_trivia(
        source,
        start + 1,
        open_index
      ) \value_start -> text_root_match_grandchild_signature_in_block(
        source,
        open_index,
        close_index,
        match value_start < open_index {
          true => text_match_values_child_signature_between(
            source,
            value_start,
