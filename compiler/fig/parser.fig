    total
  ).total_descendant_signature
}

fn text_root_child_count_in_delimiters(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32
) -> i32 {
  text_root_child_scan(source, open_index, close_index, 0, 0, 0).total_count
}

fn text_root_child_signature_in_delimiters(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32,
  total: i32
) -> i32 {
  text_root_child_scan(source, open_index, close_index, total, 0, 0).total_signature
}

fn text_root_grandchild_count_in_delimiters(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32
) -> i32 {
  text_root_child_scan(
    source,
    open_index,
    close_index,
    0,
    0,
    0
  ).total_grandchild_count
}

fn text_root_grandchild_signature_in_delimiters(
  source: textlex.TextTokenStream,
  open_index: i32,
