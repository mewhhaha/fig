fn text_root_postfix_start_after_qualified_head(
  source: textlex.TextTokenStream,
  head_index: i32,
  limit: i32
) -> i32 {
  let next = head_index + 1;
  match next >= limit {
    true => next,
    false => match text_head_selector_is_dot(source, next) {
      true => match next + 1 < limit {
        true => match text_head_segment_token_matches(source, next + 1) {
          true => text_root_postfix_start_after_qualified_head(
            source,
            next + 1,
            limit
          ),
          false => next,
        },
        false => next,
      },
      false => match text_head_selector_is_colon_colon(source, next) {
        true => match next + 2 < limit {
          true => match text_head_segment_token_matches(source, next + 2) {
            true => text_root_postfix_start_after_qualified_head(
              source,
              next + 2,
              limit
            ),
            false => next,
          },
          false => next,
        },
        false => next,
      },
    },
  }
}

fn text_root_field_count_after_postfix(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32
) -> i32 {
  match index >= limit {
    true => total,
    false => match textlex.punctuation_at(source, index) {
      PunctLeftParen => find_text_matching_right_paren(
        source,
        index + 1,
        limit,
        0
      ) \close_index -> match close_index < limit {
        true => text_root_field_count_after_postfix(
          source,
          close_index + 1,
          limit,
          total
        ),
        false => total,
      },
      _ => match text_head_selector_is_dot(source, index) {
        true => match index + 1 < limit {
          true => match text_head_segment_token_matches(source, index + 1) {
            true => text_root_field_count_after_postfix(
              source,
              index + 2,
              limit,
              total + 1
            ),
            false => total,
          },
          false => total,
        },
        false => total,
      },
    },
  }
}

fn text_expression_root_field_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  let has_head = match start < limit {
    true => text_head_segment_token_matches(source, start),
    false => false,
  };
  match has_head {
    false => 0,
    true => text_root_postfix_start_after_qualified_head(
      source,
      start,
      limit
    ) \postfix_start -> text_root_field_count_after_postfix(
      source,
      postfix_start,
      limit,
      0
    ),
  }
}

fn text_operator_symbol_char_matches(code: i32) -> bool {
  match code {
    33 => true,
    36 => true,
    37 => true,
    38 => true,
    42 => true,
    43 => true,
    45 => true,
    47 => true,
    60 => true,
    61 => true,
    62 => true,
    94 => true,
    124 => true,
    _ => false,
  }
}

fn text_operator_symbol_token_matches(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  let punctuation = textlex.punctuation_at(source, index);
  match punctuation {
    PunctEqual => true,
    PunctSlash => true,
    PunctOther => text_operator_symbol_char_matches(
      textlex.text_hash_at(source, index)
    ),
    _ => false,
  }
}

fn text_root_operator_is_sequence_start(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match text_operator_symbol_token_matches(source, index) {
    false => false,
    true => match index > 0 {
      false => true,
      true => match text_operator_symbol_token_matches(source, index - 1) {
        true => false,
        false => true,
      },
    },
  }
}

fn text_root_operator_is_reserved(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match textlex.punctuation_at(source, index) {
    PunctEqual => match text_operator_symbol_token_matches(source, index + 1) {
      true => match textlex.text_hash_at(source, index + 1) == textlex.TextCharCode::Equal {
        true => false,
        false => true,
      },
      false => true,
    },
    PunctOther => match textlex.text_hash_at(source, index) == textlex.TextCharCode::Less {
      true => match textlex.text_hash_at(source, index + 1) == textlex.TextCharCode::Minus {
        true => true,
        false => false,
      },
      false => false,
    },
    _ => false,
  }
}

fn text_root_operator_token_matches(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match text_root_operator_is_sequence_start(source, index) {
    false => false,
    true => match text_root_operator_is_reserved(source, index) {
      true => false,
      false => true,
    },
  }
}

fn text_root_operator_scan_is_top_level(scan: TextRootOperatorCountScan) -> bool {
  match scan.paren_depth == 0 {
    true => match scan.brace_depth == 0 {
      true => scan.bracket_depth == 0,
      false => false,
    },
    false => false,
  }
}

fn text_root_operator_count_scan_step(
  source: textlex.TextTokenStream,
  scan: TextRootOperatorCountScan
) -> TextRootOperatorCountScan {
  let is_top_level = text_root_operator_scan_is_top_level(scan);
  let current_matches = match is_top_level {
    true => match scan.index > scan.start {
      true => text_root_operator_token_matches(source, scan.index),
      false => false,
    },
    false => false,
  };
  TextRootOperatorCountScan {
    index: scan.index + 1,
    start: scan.start,
    limit: scan.limit,
    paren_depth: paren_depth_after_token(
      source,
      scan.index,
      scan.paren_depth
    ),
    brace_depth: brace_depth_after_token(
      source,
      scan.index,
      scan.brace_depth
    ),
    bracket_depth: text_argument_scan_bracket_delta(
      source,
      scan.index,
      scan.bracket_depth
    ),
    total: match current_matches {
      true => scan.total + 1,
      false => scan.total,
    },
  }
}

fn text_root_operator_count_scan_loop(
  source: textlex.TextTokenStream,
  scan: TextRootOperatorCountScan
) -> TextRootOperatorCountScan {
  match scan.index >= scan.limit {
    true => scan,
    false => text_root_operator_count_scan_loop(
      source,
      text_root_operator_count_scan_step(source, scan)
    ),
  }
}

fn text_root_operator_index_scan_is_top_level(
  scan: TextRootOperatorIndexScan
) -> bool {
  match scan.paren_depth == 0 {
    true => match scan.brace_depth == 0 {
      true => scan.bracket_depth == 0,
      false => false,
    },
    false => false,
  }
}

fn text_root_operator_index_scan_step(
  source: textlex.TextTokenStream,
  scan: TextRootOperatorIndexScan
) -> TextRootOperatorIndexScan {
  let is_top_level = text_root_operator_index_scan_is_top_level(scan);
  let current_matches = match is_top_level {
    true => match scan.index > scan.start {
      true => text_root_operator_token_matches(source, scan.index),
      false => false,
    },
    false => false,
  };
  TextRootOperatorIndexScan {
    index: scan.index + 1,
    start: scan.start,
    limit: scan.limit,
    paren_depth: paren_depth_after_token(
      source,
      scan.index,
      scan.paren_depth
    ),
    brace_depth: brace_depth_after_token(
      source,
      scan.index,
      scan.brace_depth
    ),
    bracket_depth: text_argument_scan_bracket_delta(
      source,
      scan.index,
      scan.bracket_depth
    ),
    result: match current_matches {
      true => scan.index,
      false => scan.result,
    },
    found: match current_matches {
      true => true,
      false => scan.found,
    },
  }
}

fn text_root_operator_index_scan_loop(
  source: textlex.TextTokenStream,
  scan: TextRootOperatorIndexScan
) -> TextRootOperatorIndexScan {
  match scan.found {
    true => scan,
    false => match scan.index >= scan.limit {
      true => scan,
      false => text_root_operator_index_scan_loop(
        source,
        text_root_operator_index_scan_step(source, scan)
      ),
    },
  }
}

fn text_operator_sequence_end(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  match index >= limit {
    true => limit,
    false => match text_operator_symbol_token_matches(source, index) {
      true => text_operator_sequence_end(source, index + 1, limit),
      false => index,
    },
  }
}

fn text_root_operator_parts_none(limit: i32) -> TextRootOperatorParts {
  TextRootOperatorParts {
    left_start: limit,
    left_limit: limit,
    right_start: limit,
    right_limit: limit,
    operator_index: limit,
    operator_hash: 0,
    found: false,
  }
}

fn text_root_operator_parts_present(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  operator_index: i32
) -> TextRootOperatorParts {
  let operator_end = text_operator_sequence_end(
    source,
    operator_index,
    limit
  );
  TextRootOperatorParts {
    left_start: start,
    left_limit: operator_index,
    right_start: text_expression_start_skip_trivia(
      source,
      operator_end,
      limit
    ),
    right_limit: limit,
    operator_index: operator_index,
    operator_hash: text_operator_sequence_hash(source, operator_index),
    found: true,
  }
}

fn text_expression_root_operator_can_have_links(
  source: textlex.TextTokenStream,
  start: i32
) -> bool {
  match textlex.token_at(source, start).kind {
    MatchKw => false,
    IfKw => false,
    DoKw => false,
    _ => match textlex.punctuation_at(source, start) {
      PunctOther => match text_pipe_bind_token_matches(source, start) {
        true => false,
        false => true,
      },
      _ => true,
    },
  }
}

fn text_expression_root_operator_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  match start >= limit {
    true => 0,
    false => match text_expression_root_operator_can_have_links(source, start) {
      false => 0,
      true => text_root_operator_count_scan_loop(
      source,
      TextRootOperatorCountScan {
        index: start,
        start: start,
        limit: limit,
          paren_depth: 0,
          brace_depth: 0,
          bracket_depth: 0,
          total: 0,
        }
      ).total,
    },
  }
}

fn text_expression_root_single_operator_parts_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> TextRootOperatorParts {
  let start = text_expression_start_skip_trivia(source, index, limit);
  match start >= limit {
    true => text_root_operator_parts_none(limit),
    false => match text_expression_root_operator_can_have_links(source, start) {
      false => text_root_operator_parts_none(limit),
      true => match text_expression_root_operator_count_between(
        source,
        start,
        limit
      ) == 1 {
        false => text_root_operator_parts_none(limit),
        true => text_root_operator_index_scan_loop(
          source,
          TextRootOperatorIndexScan {
            index: start,
            start: start,
            limit: limit,
            paren_depth: 0,
            brace_depth: 0,
            bracket_depth: 0,
            result: limit,
            found: false,
          }
        ) \scan -> match scan.found {
          true => text_root_operator_parts_present(
            source,
            start,
            limit,
            scan.result
          ),
          false => text_root_operator_parts_none(limit),
        },
      },
    },
  }
}

fn text_expression_root_type_class_tag_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  match start >= limit {
    true => text_type_class_unknown_tag(),
    false => match text_token_weight_matches(source, start, token.TokenKindWeight::BoolLiteral) {
      true => match text_scalar_literal_is_standalone(source, start, limit) {
        true => text_type_class_bool_tag(),
        false => text_type_class_unknown_tag(),
      },
      false => match textlex.token_at(source, start).kind {
        NumberLiteral => match text_scalar_literal_is_standalone(source, start, limit) {
          true => text_type_class_i32_tag(),
          false => text_type_class_unknown_tag(),
        },
        _ => match textlex.punctuation_at(source, start) {
          PunctLeftBrace => text_type_class_product_tag(),
          PunctOther => match text_pipe_bind_token_matches(source, start) {
            true => text_type_class_function_tag(),
            false => text_type_class_unknown_tag(),
          },
          _ => match text_product_constructor_start_matches_between(source, start, limit) {
            true => text_type_class_product_tag(),
            false => text_type_class_unknown_tag(),
          },
        },
      },
    },
  }
}

fn text_expression_root_identifier_hash_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  match start >= limit {
    true => 0,
    false => match textlex.token_at(source, start).kind {
      Identifier => match text_scalar_literal_is_standalone(source, start, limit) {
        true => textlex.text_hash_at(source, start),
        false => 0,
      },
      _ => 0,
    },
  }
}

fn text_param_resolved_type_class_for_name_hash_between(
  source: textlex.TextTokenStream,
  index: i32,
  close_index: i32,
  target_hash: i32
) -> i32 {
  match index >= close_index {
    true => text_type_class_unknown_tag(),
    false => text_param_resolved_type_class_for_name_hash_continue(
      source,
      index,
      close_index,
      target_hash
    ),
  }
}

fn text_param_resolved_type_class_for_name_hash_continue(
  source: textlex.TextTokenStream,
  index: i32,
  close_index: i32,
  target_hash: i32
) -> i32 {
  let comma = text_find_top_level_punctuation_score(
    source,
    index,
    close_index,
    0,
    7
  );
  let name_index = text_param_name_index_at(source, index, comma);
  let found = textlex.text_hash_at(source, name_index) == target_hash;
  match found {
    true => text_param_resolved_type_class_for_segment(
      source,
      index,
      comma
    ),
    false => text_param_resolved_type_class_for_name_hash_between(
      source,
      match comma < close_index {
        true => comma + 1,
        false => close_index,
      },
      close_index,
      target_hash
    ),
  }
}

fn text_param_resolved_type_class_for_segment(
  source: textlex.TextTokenStream,
  index: i32,
  segment_end: i32
) -> i32 {
  let colon = text_find_top_level_punctuation_score(
    source,
    index,
    segment_end,
    0,
    8
  );
  match colon < segment_end {
    true => text_annotation_resolved_type_class_tag_between(
      source,
      colon + 1,
      segment_end
    ),
    false => text_type_class_unknown_tag(),
  }
}

fn text_function_param_resolved_type_class_for_name_hash(
  source: textlex.TextTokenStream,
  index: i32,
  target_hash: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  text_param_resolved_type_class_for_name_hash_between(
    source,
    open_paren + 1,
    close_paren,
    target_hash
  )
}

fn text_function_scalar_operator_operand_type_class(
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let parenthesized = text_parenthesized_expression_segment_between(
    source,
    start,
    limit
  );
  match parenthesized.found {
    true => text_function_scalar_operator_operand_type_class(
      source,
      function_index,
      parenthesized.start,
      parenthesized.limit
    ),
    false => text_function_scalar_operator_operand_type_class_unwrapped(
      source,
      function_index,
      start,
      limit
    ),
  }
}

fn text_function_scalar_operator_operand_type_class_unwrapped(
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let root_kind = text_expression_root_head_kind_tag_between(
    source,
    start,
    limit
  );
  let root_type = text_expression_root_type_class_tag_between(
    source,
    start,
    limit
  );
  let operator_type = text_function_scalar_operator_type_class_between(
    source,
    function_index,
    start,
    limit
  );
  match operator_type == text_type_class_unknown_tag() {
    false => operator_type,
    true => text_function_scalar_branch_type_class_between(
      source,
      function_index,
      start,
      limit
    ) \branch_type -> match branch_type == text_type_class_unknown_tag() {
      false => branch_type,
      true => match root_kind == text_expression_root_number_tag() {
        true => match root_type == text_type_class_i32_tag() {
          true => text_type_class_i32_tag(),
          false => text_type_class_unknown_tag(),
        },
        false => match root_kind == text_expression_root_bool_tag() {
          true => match root_type == text_type_class_bool_tag() {
            true => text_type_class_bool_tag(),
            false => text_type_class_unknown_tag(),
          },
          false => match root_kind == text_expression_root_identifier_tag() {
            true => text_expression_root_head_hash_between(
              source,
              start,
              limit
            ) \target_hash -> text_expression_root_call_arg_count_between(
              source,
              start,
              limit
            ) \call_arg_count -> match call_arg_count == text_no_root_call_arg_count() {
              true => text_function_param_resolved_type_class_for_name_hash(
                source,
                function_index,
                target_hash
              ),
              false => text_root_call_return_type_class_for_hash_between(
                source,
                start,
                limit,
                target_hash
              ),
            },
            false => text_type_class_unknown_tag(),
          },
        },
      },
    },
  }
}

fn text_function_body_scalar_operator_operand_type_class(
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let parenthesized = text_parenthesized_expression_segment_between(
    source,
    start,
    limit
  );
  match parenthesized.found {
    true => text_function_body_scalar_operator_operand_type_class(
      source,
      function_index,
      parenthesized.start,
      parenthesized.limit
    ),
    false => text_function_body_scalar_operator_operand_type_class_unwrapped(
      source,
      function_index,
      start,
      limit
    ),
  }
}

fn text_function_body_scalar_operator_operand_type_class_unwrapped(
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let root_kind = text_expression_root_head_kind_tag_between(
    source,
    start,
    limit
  );
  let operator_type = text_function_body_scalar_operator_type_class_between(
    source,
    function_index,
    start,
    limit
  );
  let type_class = match operator_type == text_type_class_unknown_tag() {
    false => operator_type,
    true => text_function_scalar_operator_operand_type_class(
      source,
      function_index,
      start,
      limit
    ),
  };
  match type_class == text_type_class_unknown_tag() {
    false => type_class,
    true => text_function_body_scalar_branch_type_class_between(
      source,
      function_index,
      start,
      limit
    ) \branch_type -> match branch_type == text_type_class_unknown_tag() {
      false => branch_type,
      true => match root_kind == text_expression_root_identifier_tag() {
        false => text_type_class_unknown_tag(),
        true => text_expression_root_identifier_hash_between(
          source,
          start,
          limit
        ) \target_hash -> text_function_local_let_resolved_type_class_for_name_hash(
          source,
          function_index,
          target_hash
        ),
      },
    },
  }
}

fn text_function_body_scalar_operator_type_class_between(
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let parts = text_expression_root_single_operator_parts_between(
    source,
    start,
    limit
  );
  match parts.found {
    false => text_type_class_unknown_tag(),
    true => text_scalar_operator_type_class_from_parts(
      parts.operator_hash,
      text_function_body_scalar_operator_operand_type_class(
        source,
        function_index,
        parts.left_start,
        parts.left_limit
      ),
      text_function_body_scalar_operator_operand_type_class(
        source,
        function_index,
        parts.right_start,
        parts.right_limit
      )
    ),
  }
}

fn text_scalar_arithmetic_operator_type_class(
  operator_hash: i32,
  left: i32,
  right: i32
) -> i32 {
  let is_add = operator_hash == text_operator_hash_plus();
  let is_sub = operator_hash == text_operator_hash_minus();
  let is_mul = operator_hash == text_operator_hash_asterisk();
  let is_div = operator_hash == text_operator_hash_slash();
  let is_rem = operator_hash == text_operator_hash_percent();
  let is_arithmetic = match is_add {
    true => true,
    false => match is_sub {
      true => true,
      false => match is_mul {
        true => true,
        false => match is_div {
          true => true,
          false => is_rem,
        },
      },
    },
  };
  match is_arithmetic {
    false => text_type_class_unknown_tag(),
    true => match left == text_type_class_i32_tag() {
      true => match right == text_type_class_i32_tag() {
        true => text_type_class_i32_tag(),
        false => text_type_class_unknown_tag(),
      },
      false => text_type_class_unknown_tag(),
    },
  }
}

fn text_scalar_comparison_operator_matches(operator_hash: i32) -> bool {
  match operator_hash == text_operator_hash_less() {
    true => true,
    false => match operator_hash == text_operator_hash_greater() {
      true => true,
      false => match operator_hash == text_operator_hash_less_equal() {
        true => true,
        false => operator_hash == text_operator_hash_greater_equal(),
      },
    },
  }
}

fn text_scalar_comparison_operator_type_class(
  operator_hash: i32,
  left: i32,
  right: i32
) -> i32 {
  match text_scalar_comparison_operator_matches(operator_hash) {
    false => text_type_class_unknown_tag(),
    true => match left == text_type_class_i32_tag() {
      true => match right == text_type_class_i32_tag() {
        true => text_type_class_bool_tag(),
        false => text_type_class_unknown_tag(),
      },
      false => text_type_class_unknown_tag(),
    },
  }
}

fn text_scalar_equality_operator_matches(operator_hash: i32) -> bool {
  match operator_hash == text_operator_hash_equal_equal() {
    true => true,
    false => operator_hash == text_operator_hash_not_equal(),
  }
}

fn text_scalar_equality_operator_type_class(
  operator_hash: i32,
  left: i32,
  right: i32
) -> i32 {
  match text_scalar_equality_operator_matches(operator_hash) {
    false => text_type_class_unknown_tag(),
    true => match text_type_class_is_scalar(left) {
      false => text_type_class_unknown_tag(),
      true => match left == right {
        true => text_type_class_bool_tag(),
        false => text_type_class_unknown_tag(),
      },
    },
  }
}

fn text_scalar_operator_type_class_from_parts(
  operator_hash: i32,
  left: i32,
  right: i32
) -> i32 {
  let arithmetic = text_scalar_arithmetic_operator_type_class(
    operator_hash,
    left,
    right
  );
  match arithmetic == text_type_class_unknown_tag() {
    false => arithmetic,
    true => text_scalar_comparison_operator_type_class(
      operator_hash,
      left,
      right
    ) \comparison -> match comparison == text_type_class_unknown_tag() {
      false => comparison,
      true => text_scalar_equality_operator_type_class(
        operator_hash,
        left,
        right
      ),
    },
  }
}

fn text_scalar_branch_type_class_from_parts(
  condition: i32,
  true_type: i32,
  false_type: i32
) -> i32 {
  match condition == text_type_class_bool_tag() {
    false => text_type_class_unknown_tag(),
    true => match text_type_class_is_scalar(true_type) {
      false => text_type_class_unknown_tag(),
      true => match true_type == false_type {
        true => true_type,
        false => text_type_class_unknown_tag(),
      },
    },
  }
}

fn text_function_scalar_branch_type_class_between(
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let segments = text_bool_branch_segments_between(source, start, limit);
  match segments.found {
    false => text_type_class_unknown_tag(),
    true => text_scalar_branch_type_class_from_parts(
      text_function_scalar_operator_operand_type_class(
        source,
        function_index,
        segments.condition_start,
        segments.condition_limit
      ),
      text_function_scalar_operator_operand_type_class(
        source,
        function_index,
        segments.true_value_start,
        segments.true_value_limit
      ),
      text_function_scalar_operator_operand_type_class(
        source,
        function_index,
        segments.false_value_start,
        segments.false_value_limit
      )
    ),
  }
}

fn text_function_body_scalar_branch_type_class_between(
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let segments = text_bool_branch_segments_between(source, start, limit);
  match segments.found {
    false => text_type_class_unknown_tag(),
    true => text_scalar_branch_type_class_from_parts(
      text_function_body_scalar_operator_operand_type_class(
        source,
        function_index,
        segments.condition_start,
        segments.condition_limit
      ),
      text_function_body_scalar_operator_operand_type_class(
        source,
        function_index,
        segments.true_value_start,
        segments.true_value_limit
      ),
      text_function_body_scalar_operator_operand_type_class(
        source,
        function_index,
        segments.false_value_start,
        segments.false_value_limit
      )
    ),
  }
}

fn text_function_body_simple_scalar_operator_type_class(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_function_body_value_limit_index(source, index);
  let start = text_function_body_value_start_index(source, index);
  text_function_body_scalar_operator_type_class_between(source, index, start, next)
}

fn text_block_final_expression_start_between(
  source: textlex.TextTokenStream,
  scan: TextBlockFinalExpressionScan
) -> i32 {
  if scan.index >= scan.limit {
    scan.candidate
  } else {
    let is_top_level = text_depth_is_top_level(scan.brace_depth, scan.paren_depth);
    let is_statement_end = match textlex.punctuation_at(source, scan.index) {
      PunctSemicolon => is_top_level,
      _ => false,
    };
    let next_candidate = match is_statement_end {
      true => scan.index + 1,
      false => scan.candidate,
    };
    text_block_final_expression_start_between(
      source,
      text_block_final_expression_scan(
        scan.index + 1,
        scan.limit,
        brace_depth_after_token(source, scan.index, scan.brace_depth),
        paren_depth_after_token(source, scan.index, scan.paren_depth),
        next_candidate
      )
    )
  }
}

fn text_function_body_value_start_index(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  let arrow = text_function_arrow_index(source, close_paren, next);
  let left_brace = text_function_left_brace_index(source, arrow, next);
  let previous = left_brace - 1;
  match text_token_weight_matches(source, previous, 31) {
    true => previous,
    false => text_block_final_expression_start_between(
      source,
      text_block_final_expression_scan(
        left_brace + 1,
        find_text_expression_limit(
          source,
          left_brace + 1,
          next,
          textlex.PunctRightBrace
        ),
        0,
        0,
        left_brace + 1
      )
    ),
  }
}

fn text_function_body_value_limit_index(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  let arrow = text_function_arrow_index(source, close_paren, next);
  let left_brace = text_function_left_brace_index(source, arrow, next);
  let previous = left_brace - 1;
  match text_token_weight_matches(source, previous, 31) {
    true => next,
    false => find_text_expression_limit(
      source,
      left_brace + 1,
      next,
      textlex.PunctRightBrace
    ),
  }
}

fn text_function_body_is_match_body(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  let arrow = text_function_arrow_index(source, close_paren, next);
  let left_brace = text_function_left_brace_index(source, arrow, next);
  text_token_weight_matches(source, left_brace - 1, 31)
}

