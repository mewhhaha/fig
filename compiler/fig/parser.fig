fn token_view(first: token.Token) -> TokenView {
  TokenView {kind: first.kind, span: first.span}
}

fn declaration_from_kind(
  value: token.DeclarationKind,
  seed: i32
) -> ast.Decl match {
  FunctionDeclaration, seed => ast.fn_decl(
    seed,
    1,
    ast.named_type(seed + 1),
    ast.block(ast.int_expr(seed + 2))
  ),
  LetDeclaration, seed => ast.let_decl(seed, ast.named_type(seed + 1), ast.var_expr(seed + 2)),
  ConstDeclaration, seed => ast.const_decl(seed, ast.named_type(seed + 1), ast.bool_expr(true)),
  TypeDeclaration, seed => ast.type_decl(seed, 1),
  NoDeclaration, seed => ast.source_import_decl(seed, seed + 1),
}

fn declaration_frame(decl: ast.Decl, consumed: i32) -> DeclFrame {
  DeclFrame {decl: decl, consumed: consumed}
}

fn expression_frame(expr: ast.Expr, consumed: i32) -> ExprFrame {
  ExprFrame {expr: expr, consumed: consumed}
}

fn param_frame(param: ast.Param, consumed: i32) -> ParamFrame {
  ParamFrame {param: param, consumed: consumed}
}

fn param_list_frame(
  params: vec.Vec(ParamFrame),
  count: i32,
  consumed: i32
) -> ParamListFrame {
  ParamListFrame {
    params: params,
    count: count,
    consumed: consumed,
  }
}

fn empty_param_list() -> ParamListFrame {
  param_list_frame(vec.Vec::new(ParamFrame, 0), 0, 0)
}

fn text_param_signature_scan(
  index: i32,
  close_index: i32,
  paren_depth: i32,
  need_name: bool,
  total: i32
) -> TextParamSignatureScan {
  TextParamSignatureScan {
    index: index,
    close_index: close_index,
    paren_depth: paren_depth,
    need_name: need_name,
    total: total,
  }
}

fn text_runtime_param_index_scan(
  index: i32,
  close_index: i32,
