fn text_expression_root_pipe_child_record_state(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  pipe_index: i32,
  parent_kind_tag: i32,
  parent_name_hash: i32,
  child_index: i32,
  total: i32
) -> TextRootChildRecordState {
  let left = text_expression_root_child_record_signature_between_state(
    source,
    start,
    pipe_index,
    parent_kind_tag,
    parent_name_hash,
    child_index,
    total
  );
  let body_start = text_pipe_bind_body_start_index(source, pipe_index, limit);
  match body_start < limit {
    false => left,
    true => text_root_child_record_fact_signature(
      source,
      body_start,
      limit,
      parent_kind_tag,
      parent_name_hash,
      left.child_index,
      text_root_child_pipe_body_role_tag()
    ) \fact_signature -> text_expression_root_child_record_signature_between_state(
      source,
      body_start,
      limit,
      parent_kind_tag,
      parent_name_hash,
      left.child_index + 1,
      textmodel.signature_mix(left.total, fact_signature)
    ),
  }
}

fn text_expression_root_child_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  match start >= limit {
    true => 0,
    false => text_root_pipe_bind_index_from_start(source, start, limit) \pipe_index -> match pipe_index < limit {
      true => text_pipe_bind_body_start_index(source, pipe_index, limit) \body_start -> match body_start < limit {
        true => text_expression_root_child_count_between(
          source,
          start,
          pipe_index
        ) + 1,
        false => text_expression_root_child_count_between(
          source,
          start,
          pipe_index
        ),
      },
      false => match textlex.token_at(source, start).kind {
        MatchKw => text_root_match_child_count_between(source, start, limit),
        IfKw => text_root_if_child_count_between(source, start, limit),
        DoKw => text_root_do_child_count_between(source, start, limit),
        _ => match textlex.punctuation_at(source, start) {
          PunctLeftBrace => find_text_right_brace(
            source,
            start + 1,
            limit,
            0
          ) \close_index -> match close_index < limit {
            true => text_root_child_count_in_delimiters(source, start, close_index),
            false => 0,
          },
          _ => match text_head_segment_token_matches(source, start) {
            false => 0,
            true => text_root_call_open_after_head(source, start, limit) \open_index -> match open_index < limit {
              true => find_text_matching_right_paren(
                source,
                open_index + 1,
                limit,
                0
              ) \close_index -> match close_index < limit {
                true => text_root_child_count_in_delimiters(source, open_index, close_index),
                false => 0,
              },
              false => text_root_slot_open_after_head(source, start, limit) \slot_open -> match slot_open < limit {
                false => 0,
                true => find_text_right_brace(
