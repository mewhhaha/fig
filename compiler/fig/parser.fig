) -> bool {
  token.is_match_like_expression_keyword(textlex.token_at(source, index).kind)
}

fn text_value_match_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32
) -> i32 {
  if index >= limit {
    total
  } else {
    let current_matches = text_value_match_token_matches(source, index);
    let next_total = match current_matches {
      true => total + 1,
      false => total,
    };
    text_value_match_count_between(
      source,
      index + 1,
      limit,
      next_total
    )
  }
}

fn text_function_value_match_count(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  let arrow = text_function_arrow_index(source, close_paren, next);
  let left_brace = text_function_left_brace_index(source, arrow, next);
  let body_start = text_function_body_start_index(source, arrow, left_brace);
  let right_brace = find_text_expression_limit(
    source,
    left_brace + 1,
    next,
    textlex.PunctRightBrace
  );
  text_value_match_count_between(
    source,
    body_start,
    right_brace,
    0
  )
}

fn text_value_declaration_match_count(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let equal = text_find_top_level_punctuation_score(
    source,
    index + 2,
    next,
    0,
    1
  );
  match equal < next {
    true => text_value_match_count_between(
      source,
      equal + 1,
      next,
      0
    ),
    false => 0,
  }
}

fn text_declaration_value_match_count_delta(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  match text_declaration_kind_tag(source, index, decl) {
    1 => text_function_value_match_count(source, index),
    2 => text_value_declaration_match_count(source, index),
    3 => text_value_declaration_match_count(source, index),
    _ => 0,
