    0
  ).total_grandchild_signature
}

fn text_root_descendant_count_in_delimiters(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32
) -> i32 {
  text_root_child_scan(
    source,
    open_index,
    close_index,
    0,
