fn text_type_builder_enum_hash() -> i32 {
  3753397
}

fn text_enum_backing_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  depth: i32
) -> i32 {
  let open_paren = find_text_punctuation_score(
    source,
    index + 1,
    limit,
    2
  );
  match open_paren < limit {
    false => text_type_class_unknown_tag(),
    true => text_type_alias_expression_type_class_tag_between(
      source,
      open_paren + 1,
      find_text_matching_right_paren(
        source,
        open_paren + 1,
        limit,
        0
      ),
      depth
    ),
  }
}

fn text_type_alias_expression_type_class_tag_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  depth: i32
) -> i32 {
  match index >= limit {
    true => text_type_class_unknown_tag(),
    false => match text_param_signature_is_trivia(source, index) {
      true => text_type_alias_expression_type_class_tag_between(
        source,
        index + 1,
        limit,
        depth
      ),
      false => match textlex.text_hash_at(source, index) == text_type_builder_enum_hash() {
        true => text_enum_backing_type_class_tag(source, index, limit, depth),
        false => text_type_alias_expression_start_type_class_tag(
          source,
          index,
          depth
        ),
      },
    },
  }
}

fn text_type_alias_expression_start_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32,
  depth: i32
) -> i32 {
  let primitive = text_annotation_type_class_tag_from_hash(
    textlex.text_hash_at(source, index)
  );
  match primitive == text_type_class_unknown_tag() {
    false => primitive,
    true => match textlex.punctuation_at(source, index) {
      PunctLeftBrace => text_type_class_product_tag(),
      _ => text_named_type_class_for_hash_with_depth(
        source,
        textlex.text_hash_at(source, index),
        depth - 1
      ),
    },
  }
}

fn text_type_function_body_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32,
  next: i32,
