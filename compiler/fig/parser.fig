fn text_declaration_kind_count_delta(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  kind_tag: i32
) -> i32 {
  monad.Reader::run(
    text_declaration_kind_count_reader(kind_tag),
    text_value_body_context(source, index, decl)
  )
}

fn text_declaration_kind_function_tag() -> i32 {
  1
}

fn text_declaration_kind_let_tag() -> i32 {
  2
}

fn text_declaration_kind_const_tag() -> i32 {
  3
}

fn text_declaration_kind_type_tag() -> i32 {
  4
}

fn text_declaration_kind_source_import_tag() -> i32 {
  5
}

fn text_declaration_kind_external_import_tag() -> i32 {
  6
}

fn text_declaration_kind_is_function(kind_tag: i32) -> bool {
  kind_tag == text_declaration_kind_function_tag()
}

fn text_declaration_kind_is_let(kind_tag: i32) -> bool {
  kind_tag == text_declaration_kind_let_tag()
}

fn text_declaration_kind_is_const(kind_tag: i32) -> bool {
  kind_tag == text_declaration_kind_const_tag()
}

fn text_declaration_kind_is_type(kind_tag: i32) -> bool {
  kind_tag == text_declaration_kind_type_tag()
}

fn text_declaration_kind_is_source_import(kind_tag: i32) -> bool {
  kind_tag == text_declaration_kind_source_import_tag()
}

fn text_declaration_kind_is_value_binding(kind_tag: i32) -> bool {
  match text_declaration_kind_is_let(kind_tag) {
    true => true,
    false => text_declaration_kind_is_const(kind_tag),
  }
}

fn text_declaration_kind_has_value_body(kind_tag: i32) -> bool {
  match text_declaration_kind_is_function(kind_tag) {
    true => true,
    false => text_declaration_kind_is_value_binding(kind_tag),
  }
}

fn text_declaration_type_sugar_statement_count(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  match text_token_weight_matches(source, index, 17) {
    true => match is_text_type_function_start(source, index) {
      true => 0,
      false => text_type_sugar_statement_count(source, index),
    },
    false => 0,
  }
}

fn text_declaration_type_result_kind_count_delta(
  source: textlex.TextTokenStream,
  index: i32,
  expected_tag: i32
) -> i32 {
  match text_token_weight_matches(source, index, 17) {
    true => match text_type_result_kind_tag(source, index) == expected_tag {
      true => 1,
      false => 0,
    },
    false => 0,
  }
}

fn text_declaration_kind_tag(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  match is_text_external_import_start(source, index) {
    true => text_declaration_kind_external_import_tag(),
    false => match is_text_type_assert_declaration_start(source, index) {
      true => text_declaration_kind_const_tag(),
      false => match is_text_operator_declaration_start(source, index) {
        true => text_declaration_kind_const_tag(),
        false => match is_text_source_import_start(source, index) {
          true => text_declaration_kind_source_import_tag(),
          false => text_regular_declaration_kind_tag(source, index, decl),
        },
      },
    },
  }
}

fn text_regular_declaration_kind_tag(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  let is_function = is_text_function_declaration_start(source, index);
  let is_let = text_token_weight_matches(source, index, 29);
  let is_const = text_token_weight_matches(source, index, 19);
  let is_type = text_token_weight_matches(source, index, 17);
  match is_function {
    true => text_declaration_kind_function_tag(),
    false => match is_let {
      true => text_declaration_kind_let_tag(),
      false => match is_const {
        true => text_declaration_kind_const_tag(),
        false => match is_type {
          true => text_declaration_kind_type_tag(),
          false => ast.decl_tag(decl),
        },
      },
    },
  }
}

fn text_declaration_name_index(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  match text_declaration_kind_is_function(kind_tag) {
    true => text_function_name_index(source, index),
    false => match text_declaration_kind_is_type(kind_tag) {
      true => text_type_name_index(source, index),
      false => index + 1,
    },
  }
}

fn text_declaration_name_hash(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  match is_text_type_assert_declaration_start(source, index) {
    true => 0,
    false => match is_text_operator_declaration_start(source, index) {
      true => text_operator_declaration_name_hash(source, index),
      false => text_declaration_kind_tag(source, index, decl) \kind_tag -> match
        text_declaration_kind_is_source_import(kind_tag) {
        true => text_source_import_alias_hash(source, index),
        false => match text_declaration_kind_is_function(kind_tag) {
          true => text_function_primary_name_hash(source, index),
          false => textlex.text_hash_at(
            source,
            text_declaration_name_index(source, index, decl)
          ),
        },
      },
    },
  }
}

fn text_source_import_module_hash(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  textlex.text_hash_at(source, text_source_import_module_index(source, index))
}

fn text_declaration_aux_signature_hash(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  kind_tag: i32
) -> i32 {
  match text_declaration_kind_is_source_import(kind_tag) {
    true => text_source_import_module_hash(source, index),
    false => ast.decl_param_count(decl),
  }
}

fn text_declaration_signature_hash(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  let name_hash = text_declaration_name_hash(source, index, decl);
  let aux_hash = text_declaration_aux_signature_hash(
    source,
    index,
    decl,
    kind_tag
  );
  17
    \total -> text_signature_mix(total, kind_tag)
    \total -> text_signature_mix(total, name_hash)
    \total -> text_signature_mix(total, aux_hash)
}

fn text_declaration_function_param_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  total: i32
) -> i32 {
  monad.Reader::run(
    text_declaration_function_param_signature_total_reader(total),
    text_value_body_context(source, index, ast.empty_decl())
  )
}

