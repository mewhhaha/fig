fn text_function_body_direct_import_scalar_operator_operand_type_class_unwrapped(
  context: TextDirectImportContext,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let root_kind = text_expression_root_head_kind_tag_between(
    context.source,
    start,
    limit
  );
  let operator_type = text_function_body_direct_import_scalar_operator_type_class_between(
    context,
    function_index,
    start,
    limit
  );
  let type_class = match operator_type == text_type_class_unknown_tag() {
    false => operator_type,
    true => text_function_direct_import_scalar_operator_operand_type_class(
      context,
      function_index,
      start,
      limit
    ),
  };
  match type_class == text_type_class_unknown_tag() {
    false => type_class,
    true => text_function_body_direct_import_scalar_branch_type_class_between(
      context,
      function_index,
      start,
      limit
      ) \branch_type -> match branch_type == text_type_class_unknown_tag() {
      false => branch_type,
      true => match text_expression_root_is_bare_identifier_between(
        context.source,
        start,
        limit
      ) {
        false => text_type_class_unknown_tag(),
        true => match root_kind == text_expression_root_identifier_tag() {
          false => text_type_class_unknown_tag(),
          true => text_expression_root_identifier_hash_between(
            context.source,
            start,
            limit
          ) \target_hash -> text_function_local_let_direct_import_type_class_for_name_hash(
            context,
            function_index,
            target_hash
          ),
        },
      },
    },
  }
}

