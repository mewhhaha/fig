                  slot_open + 1,
                  limit,
                  0
                ) \close_index -> match close_index < limit {
                  true => text_root_child_count_in_delimiters(source, slot_open, close_index),
                  false => 0,
                },
              },
            },
          },
        },
      },
    },
  }
}

