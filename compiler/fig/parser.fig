fn text_value_body_signature_total_at(
  source: textlex.TextTokenStream,
  index: i32,
  total: i32,
  kind: TextValueBodySignature
) -> i32 {
  match kind {
    TextValueBodyOperatorSignature => match text_root_operator_token_matches(source, index) {
      true => textmodel.signature_mix(
        total,
        text_operator_sequence_hash(source, index)
      ),
      false => total,
    },
    TextValueBodyNameTokenSignature => match text_value_name_token_matches(source, index) {
      true => textmodel.signature_mix(total, textlex.text_hash_at(source, index)),
      false => total,
    },
    TextValueBodyLiteralTokenSignature => match text_value_literal_token_matches(source, index) {
      true => textmodel.signature_mix(total, textlex.text_hash_at(source, index)),
      false => total,
    },
  }
}

fn text_value_body_signature_skips_type_assert(kind: TextValueBodySignature) -> bool {
  match kind {
    TextValueBodyOperatorSignature => true,
    _ => false,
  }
}

fn text_value_body_signature_skips_local_let_annotation(
  kind: TextValueBodySignature
