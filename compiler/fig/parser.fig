    false => match text_declaration_kind_is_function(kind_tag) {
      true => text_function_return_direct_import_resolved_type_class_tag(
        context.source,
        context.import_source,
        index,
        context.alias_hash
      ),
      false => match text_declaration_kind_is_value_binding(kind_tag) {
        true => text_value_annotation_direct_import_resolved_type_class_tag(
          context.source,
          context.import_source,
          index,
          context.alias_hash
        ),
        false => text_type_class_unknown_tag(),
