}

fn TextResolutionEnv::declaration_resolved_simple_body_type_check_signature_total(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  match is_text_external_import_start(source, index) {
    true => total,
    false => text_declaration_kind_tag(source, index, decl) \kind_tag ->
      text_declaration_resolved_expected_body_type_class_tag(
        source,
        index,
        decl
      ) \expected -> TextResolutionEnv::declaration_resolved_value_body_type_class_tag(
        env,
        source,
        index,
        decl
      ) \actual -> text_signature_mix(
        total,
        text_simple_body_type_check_hash(
          kind_tag,
          expected,
          actual,
          text_simple_body_type_check_status(expected, actual)
        )
      ),
  }
}

fn TextResolutionEnv::resolved_value_body_signature_loop(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  current: combinator.ParseState,
  total: i32,
  mode: textmodel.ImportResolutionMode
) -> i32 {
  match current.cursor < textlex.length(source) {
    false => total,
    true => match parse_text_declaration_stream(current, source, total) {
      Err(_) => total,
      Ok(result) => rec(
        env,
        source,
        next_text_declaration_state(result.state, source),
        match mode {
          textmodel.ImportResolutionMode::AbiClass =>
            TextResolutionEnv::declaration_resolved_value_body_abi_signature_total(
              env,
              source,
              current.cursor,
              result.value.decl,
              total
            ),
          textmodel.ImportResolutionMode::TypeClass =>
            TextResolutionEnv::declaration_resolved_value_body_type_signature_total(
              env,
              source,
              current.cursor,
              result.value.decl,
              total
            ),
        },
        mode
      ),
    },
  }
}

fn TextResolutionEnv::resolved_value_body_signature(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  mode: textmodel.ImportResolutionMode
) -> i32 {
  TextResolutionEnv::resolved_value_body_signature_loop(
    env,
    source,
    textmodel.full_window_state(source),
    0,
    mode
  )
}

fn text_resolved_value_body_type_class_signature_for_source(
  source: textlex.TextTokenStream
) -> i32 {
  TextResolutionEnv::resolved_value_body_signature(
    TextResolutionEnv::from_source(source),
    source,
    textmodel.ImportResolutionMode::TypeClass
