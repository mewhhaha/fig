fn text_do_bind_left_hash() -> i32 {
  textlex.TextCharCode::Less
}

fn text_do_bind_minus_hash() -> i32 {
  textlex.TextCharCode::Minus
}

fn text_value_do_bind_token_matches(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match punctuation_matches(source, index, textlex.PunctOther) {
    false => false,
    true => match textlex.text_hash_at(source, index) == text_do_bind_left_hash() {
      false => false,
      true => match punctuation_matches(source, index + 1, textlex.PunctOther) {
        false => false,
        true => textlex.text_hash_at(source, index + 1) == text_do_bind_minus_hash(),
      },
    },
  }
}

