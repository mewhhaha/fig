fn text_function_direct_import_scalar_operator_operand_type_class_unwrapped(
  context: TextDirectImportContext,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let root_kind = text_expression_root_head_kind_tag_between(
    context.source,
    start,
    limit
  );
  let root_type = text_expression_root_type_class_tag_between(
    context.source,
    start,
    limit
  );
  let operator_type = text_function_direct_import_scalar_operator_type_class_between(
    context,
    function_index,
    start,
    limit
  );
  match operator_type == text_type_class_unknown_tag() {
    false => operator_type,
    true => text_function_direct_import_scalar_branch_type_class_between(
      context,
      function_index,
      start,
      limit
    ) \branch_type -> match branch_type == text_type_class_unknown_tag() {
      false => branch_type,
      true => match root_kind == text_expression_root_number_tag() {
        true => match root_type == text_type_class_i32_tag() {
          true => text_type_class_i32_tag(),
          false => text_type_class_unknown_tag(),
        },
        false => match root_kind == text_expression_root_bool_tag() {
          true => match root_type == text_type_class_bool_tag() {
            true => text_type_class_bool_tag(),
            false => text_type_class_unknown_tag(),
          },
          false => match root_kind == text_expression_root_identifier_tag() {
            true => text_expression_root_head_hash_between(
              context.source,
              start,
              limit
            ) \target_hash -> text_expression_root_call_arg_count_between(
              context.source,
              start,
              limit
            ) \call_arg_count -> match call_arg_count == text_no_root_call_arg_count() {
              true => text_function_param_direct_import_resolved_type_class_for_name_hash(
                context,
                function_index,
                target_hash
              ),
              false => text_root_call_direct_import_return_type_class_for_hash_between(
                context,
                start,
                limit,
                target_hash
              ),
            },
            false => text_type_class_unknown_tag(),
          },
        },
      },
    },
  }
}

