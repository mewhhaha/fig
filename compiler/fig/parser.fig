fn text_scalar_literal_is_standalone_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  brace_depth: i32,
  paren_depth: i32
) -> bool {
  match index >= limit {
    true => true,
    false => match text_param_signature_is_trivia(source, index) {
      true => text_scalar_literal_is_standalone_between(
        source,
        index + 1,
        limit,
        brace_depth,
        paren_depth
      ),
      false => match text_depth_is_top_level(brace_depth, paren_depth) {
        true => match textlex.punctuation_at(source, index) {
          PunctSemicolon => true,
          PunctRightBrace => true,
          _ => false,
        },
        false => text_scalar_literal_is_standalone_between(
          source,
          index + 1,
          limit,
          brace_depth_after_token(source, index, brace_depth),
          paren_depth_after_token(source, index, paren_depth)
        ),
      },
    },
  }
}

fn text_scalar_literal_is_standalone(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> bool {
  text_scalar_literal_is_standalone_between(
    source,
    index + 1,
    limit,
    0,
    0
  )
}

fn text_product_constructor_head_kind_matches(
  kind: token.TokenKind
) -> bool match {
  Identifier => true,
  LiteralType => true,
  _ => false,
}

fn text_product_constructor_start_matches_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> bool {
  let brace_index = index + 1;
  let has_constructor_head = text_product_constructor_head_kind_matches(
    textlex.token_at(source, index).kind
  );
  let has_brace_token = brace_index < limit;
  match has_constructor_head {
    true => match has_brace_token {
      true => punctuation_matches(
        source,
        brace_index,
        textlex.PunctLeftBrace
      ),
      false => false,
    },
    _ => false,
  }
}

fn text_expression_start_skip_trivia(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  match index >= limit {
    true => index,
    false => match text_param_signature_is_trivia(source, index) {
      true => text_expression_start_skip_trivia(source, index + 1, limit),
      false => index,
    },
  }
}

