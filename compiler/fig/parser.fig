}

fn text_named_type_class_for_hash_scan(
  source: textlex.TextTokenStream,
  scan: TextNamedTypeLookupScan
) -> i32 {
  text_named_type_class_for_hash_scan_result(
    source,
    scan,
    text_type_class_unknown_tag()
  )
}

fn text_named_type_class_for_hash_scan_result(
  source: textlex.TextTokenStream,
  scan: TextNamedTypeLookupScan,
  result: i32
) -> i32 {
  if scan.index >= scan.limit {
    result
  } else {
    match scan.depth <= 0 {
      true => text_type_class_unknown_tag(),
      false => match text_named_lookup_scan_type_matches(source, scan) {
        true => text_named_type_class_for_hash_scan_result(
          source,
          text_named_lookup_scan_next(source, scan),
          text_named_type_class_result(
            text_type_declaration_environment_type_class_tag(
              source,
              scan.index,
              scan.depth - 1
            )
          )
        ),
        false => text_named_type_class_for_hash_scan_result(
          source,
          text_named_lookup_scan_next(source, scan),
          result
        ),
      },
    }
  }
}

fn text_named_type_class_for_hash_with_depth(
  source: textlex.TextTokenStream,
