fn text_summary_scan_loop(
  source: textlex.TextTokenStream,
  context: TextSummaryContext,
  current: combinator.ParseState,
  total: i32
) -> i32 {
  match current.cursor < textlex.length(source) {
    false => total,
    true => match parse_text_declaration_stream(
      current,
      source,
      context.seed + total
    ) {
      Err(_) => total,
      Ok(result) => rec(
        source,
        context,
        next_text_declaration_state(result.state, source),
        text_declaration_summary_total(
          source,
          current.cursor,
          result.value.decl,
          context,
          total
        )
      ),
    },
  }
}

fn text_top_level_declaration_summary(
  source: textlex.TextTokenStream,
  summary_kind: textmodel.SummaryKind,
  summary_arg: i32
) -> i32 {
  text_summary_scan_loop(
    source,
    text_summary_context(0, summary_kind, summary_arg),
    textmodel.full_window_state(source),
    0
  )
}

