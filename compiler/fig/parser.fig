fn text_function_body_resolved_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let fallback = text_function_body_type_class_tag(source, index);
  match fallback == text_type_class_unknown_tag() {
    false => fallback,
    true => text_function_body_resolved_unknown_type_class_tag(source, index),
  }
}

fn text_function_body_resolved_unknown_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let body_start = text_function_body_value_start_index(source, index);
  let body_end = text_function_body_value_limit_index(source, index);
  match text_function_body_is_match_body(source, index) {
    false => text_type_class_unknown_tag(),
    true => text_function_match_body_result_type_class(source, index),
  } \match_body_type -> match match_body_type == text_type_class_unknown_tag() {
    false => match_body_type,
    true => text_function_body_simple_scalar_operator_type_class(
      source,
      index
    ) \operator_type -> match operator_type == text_type_class_unknown_tag() {
      false => operator_type,
      true => text_function_body_scalar_branch_type_class_between(
        source,
        index,
        body_start,
        body_end
      ) \branch_type -> match branch_type == text_type_class_unknown_tag() {
        false => branch_type,
        true => text_root_call_return_type_class_for_hash_between(
          source,
          body_start,
          body_end,
          text_expression_root_head_hash_between(source, body_start, body_end)
        ) \call_type -> match call_type == text_type_class_unknown_tag() {
          false => call_type,
          true => match text_expression_root_is_bare_identifier_between(
            source,
            body_start,
            body_end
          ) {
            false => text_type_class_unknown_tag(),
            true => text_expression_root_identifier_hash_between(
              source,
              body_start,
              body_end
            ) \identifier_hash -> text_function_param_resolved_type_class_for_name_hash(
              source,
              index,
              identifier_hash
            ) \param_type -> match param_type == text_type_class_unknown_tag() {
              false => param_type,
              true => text_function_local_let_resolved_type_class_for_name_hash(
                source,
                index,
                identifier_hash
              ),
            },
          },
        },
      },
    },
  }
}

fn text_root_call_head_limit(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let call_open = text_expression_root_call_open_between(source, index, limit);
  match call_open < limit {
    true => call_open,
    false => limit,
  }
}

fn text_root_call_has_no_return_target_blockers(
  operator_count: i32,
  field_count: i32,
  pipe_bind_count: i32
) -> bool {
  let no_operator = operator_count == 0;
  let no_field = field_count == 0;
  let no_pipe_bind = pipe_bind_count == 0;
  no_operator && no_field && no_pipe_bind
}

fn text_root_call_has_return_target(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> bool {
  let head_limit = text_root_call_head_limit(source, index, limit);
  let operator_count = text_expression_root_operator_count_between(
    source,
    index,
    head_limit
  ) + text_expression_root_call_tail_operator_count_between(
    source,
    index,
    limit
  );
  let selector_count = text_expression_root_head_selector_count_between(
    source,
    index,
    head_limit
  );
  let field_count = text_expression_root_call_tail_field_count_between(
    source,
    index,
    limit
  );
  let pipe_bind_count = text_value_pipe_bind_count_between(
    source,
    index,
    limit,
    0
  );
  let call_arg_count = text_expression_root_call_arg_count_between(
    source,
    index,
    limit
  );
  let has_no_blockers = text_root_call_has_no_return_target_blockers(
    operator_count,
    field_count,
    pipe_bind_count
  );
  match has_no_blockers {
    true => call_arg_count != text_no_root_call_arg_count(),
    false => false,
  }
}

fn text_root_call_return_target_hash_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  fallback_hash: i32
) -> i32 {
  let head_limit = text_root_call_head_limit(source, index, limit);
  match text_expression_root_head_selector_count_between(
    source,
    index,
    head_limit
  ) == 0 {
    true => fallback_hash,
    false => text_token_text_hash_between(
      source,
      index,
      head_limit,
      0
    ),
  }
}

fn text_root_call_return_type_class_for_hash_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  target_hash: i32
) -> i32 {
  match text_root_call_has_return_target(source, index, limit) {
    true => text_function_return_type_class_for_hash(
      source,
      text_root_call_return_target_hash_between(
        source,
        index,
        limit,
        target_hash
      )
    ),
    false => text_type_class_unknown_tag(),
  }
}

fn text_named_lookup_scan_is_top_level_declaration(
  source: textlex.TextTokenStream,
  scan: TextNamedTypeLookupScan
) -> bool {
  is_text_top_level_declaration_start(
    source,
    scan.index,
    scan.brace_depth,
    scan.paren_depth
  )
}

fn text_named_lookup_scan_is_function_declaration(
  source: textlex.TextTokenStream,
  scan: TextNamedTypeLookupScan
) -> bool {
  match text_named_lookup_scan_is_top_level_declaration(source, scan) {
    true => text_declaration_kind_is_function(
      text_declaration_kind_tag(source, scan.index, ast.empty_decl())
    ),
    false => false,
  }
}

fn text_named_lookup_scan_name_matches(
  source: textlex.TextTokenStream,
  scan: TextNamedTypeLookupScan
) -> bool {
  text_declaration_name_hash(source, scan.index, ast.empty_decl()) == scan.target_hash
}

fn text_named_lookup_scan_function_matches(
  source: textlex.TextTokenStream,
  scan: TextNamedTypeLookupScan
) -> bool {
  match text_named_lookup_scan_is_function_declaration(source, scan) {
    true => text_named_lookup_scan_name_matches(source, scan),
    false => false,
  }
}

fn text_named_lookup_scan_declaration_matches(
  source: textlex.TextTokenStream,
  scan: TextNamedTypeLookupScan
) -> bool {
  match text_named_lookup_scan_is_top_level_declaration(source, scan) {
    true => text_named_lookup_scan_name_matches(source, scan),
    false => false,
  }
}

fn text_named_lookup_scan_type_matches(
  source: textlex.TextTokenStream,
  scan: TextNamedTypeLookupScan
) -> bool {
  match text_named_lookup_scan_is_top_level_declaration(source, scan) {
    true => match text_token_weight_matches(source, scan.index, 17) {
      true => textlex.text_hash_at(
        source,
        text_type_name_index(source, scan.index)
      ) == scan.target_hash,
      false => false,
    },
    false => false,
  }
}

fn text_named_lookup_scan_start(
  source: textlex.TextTokenStream,
  target_hash: i32,
  depth: i32
) -> TextNamedTypeLookupScan {
  TextNamedTypeLookupScan {
    index: 0,
    limit: textlex.length(source),
    brace_depth: 0,
    paren_depth: 0,
    target_hash: target_hash,
    depth: depth,
  }
}

fn text_named_lookup_scan_next(
  source: textlex.TextTokenStream,
  scan: TextNamedTypeLookupScan
) -> TextNamedTypeLookupScan {
  TextNamedTypeLookupScan {
    index: scan.index + 1,
    limit: scan.limit,
    brace_depth: brace_depth_after_token(source, scan.index, scan.brace_depth),
    paren_depth: paren_depth_after_token(source, scan.index, scan.paren_depth),
    target_hash: scan.target_hash,
    depth: scan.depth,
  }
}

fn text_function_return_type_class_for_hash_scan(
  source: textlex.TextTokenStream,
  scan: TextNamedTypeLookupScan
) -> i32 {
  if scan.index >= scan.limit {
    text_type_class_unknown_tag()
  } else {
    let found = text_named_lookup_scan_function_matches(source, scan);
    match found {
      true => text_function_return_resolved_type_class_tag(source, scan.index),
      false => text_function_return_type_class_for_hash_scan(
        source,
        text_named_lookup_scan_next(source, scan)
      ),
    }
  }
}

fn text_function_return_type_class_for_hash(
  source: textlex.TextTokenStream,
  target_hash: i32
) -> i32 {
  match target_hash == 0 {
    true => text_type_class_unknown_tag(),
    false => text_function_return_type_class_for_hash_scan(
      source,
      text_named_lookup_scan_start(source, target_hash, 0)
    ),
  }
}

fn text_named_symbol_type_class_for_hash_scan(
  source: textlex.TextTokenStream,
  scan: TextNamedTypeLookupScan
) -> i32 {
  if scan.index >= scan.limit {
    text_type_class_unknown_tag()
  } else {
    let found = text_named_lookup_scan_declaration_matches(source, scan);
    match found {
      true => text_declaration_resolved_type_class_tag(
        source,
        scan.index,
        ast.empty_decl()
      ),
      false => text_named_symbol_type_class_for_hash_scan(
        source,
        text_named_lookup_scan_next(source, scan)
      ),
    }
  }
}

fn text_named_symbol_type_class_for_hash(
  source: textlex.TextTokenStream,
  target_hash: i32
) -> i32 {
  match target_hash == 0 {
    true => text_type_class_unknown_tag(),
    false => text_named_symbol_type_class_for_hash_scan(
      source,
      text_named_lookup_scan_start(source, target_hash, 0)
    ),
  }
}

fn text_value_declaration_body_resolved_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let fallback = text_value_declaration_body_type_class_tag(source, index);
  match fallback == text_type_class_unknown_tag() {
    false => fallback,
    true => text_value_declaration_body_resolved_unknown_type_class_tag(
      source,
      index
    ),
  }
}

fn text_value_declaration_body_resolved_unknown_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let body_start = text_value_declaration_body_start_index(source, index);
  let body_end = text_declaration_end_from_index(source, index);
  let identifier_hash = text_expression_root_identifier_hash_between(
    source,
    body_start,
    body_end
  );
  let symbol_type = text_named_symbol_type_class_for_hash(
    source,
    identifier_hash
  );
  match symbol_type == text_type_class_unknown_tag() {
    false => symbol_type,
    true => text_root_call_return_type_class_for_hash_between(
      source,
      body_start,
      body_end,
      text_expression_root_head_hash_between(source, body_start, body_end)
    ),
  }
}

fn text_declaration_resolved_value_body_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  match is_text_non_value_declaration_start(source, index) {
    true => text_type_class_unknown_tag(),
    false => match text_declaration_kind_is_function(kind_tag) {
      true => text_function_body_resolved_type_class_tag(source, index),
      false => match text_declaration_kind_is_value_binding(kind_tag) {
        true => text_value_declaration_body_resolved_type_class_tag(source, index),
        false => text_type_class_unknown_tag(),
      },
    },
  }
}

fn text_type_class_binding(
  name_hash: i32,
  type_class: i32
) -> TextTypeClassBinding {
  TextTypeClassBinding {
    name_hash: name_hash,
    type_class: type_class,
  }
}

fn TextResolutionEnv::empty() -> TextResolutionEnv {
  TextResolutionEnv {
    symbols: layout.HeapArray::empty(TextTypeClassBinding),
    returns: layout.HeapArray::empty(TextTypeClassBinding),
  }
}

fn TextResolutionEnv::add_symbol(
  env: TextResolutionEnv,
  name_hash: i32,
  type_class: i32
) -> TextResolutionEnv {
  TextResolutionEnv {
    symbols: layout.HeapArray::push(
      TextTypeClassBinding,
      env.symbols,
      text_type_class_binding(name_hash, type_class)
    ),
    returns: env.returns,
  }
}

fn TextResolutionEnv::add_return(
  env: TextResolutionEnv,
  name_hash: i32,
  type_class: i32
) -> TextResolutionEnv {
  TextResolutionEnv {
    symbols: env.symbols,
    returns: layout.HeapArray::push(
      TextTypeClassBinding,
      env.returns,
      text_type_class_binding(name_hash, type_class)
    ),
  }
}

fn TextResolutionEnv::add_symbol_decl(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  kind_tag: i32
) -> TextResolutionEnv {
  match text_declaration_kind_is_source_import(kind_tag) {
    true => env,
    false => TextResolutionEnv::add_symbol(
      env,
      text_declaration_name_hash(source, index, decl),
      text_declaration_resolved_type_class_tag(source, index, decl)
    ),
  }
}

fn TextResolutionEnv::add_return_decl(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  kind_tag: i32
) -> TextResolutionEnv {
  match text_declaration_kind_is_function(kind_tag) {
    false => env,
    true => TextResolutionEnv::add_return(
      env,
      text_declaration_name_hash(source, index, decl),
      text_function_return_resolved_type_class_tag(source, index)
    ),
  }
}

fn TextResolutionEnv::add_decl(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> TextResolutionEnv {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  TextResolutionEnv::add_return_decl(env, source, index, decl, kind_tag)
}

fn TextResolutionEnv::from_source_loop(
  source: textlex.TextTokenStream,
  current: combinator.ParseState,
  env: TextResolutionEnv
) -> TextResolutionEnv {
  match current.cursor < textlex.length(source) {
    false => env,
    true => match parse_text_declaration_stream(
      current,
      source,
      layout.HeapArray::len(TextTypeClassBinding, env.symbols)
    ) {
      Err(_) => env,
      Ok(result) => rec(
        source,
        next_text_declaration_state(result.state, source),
        TextResolutionEnv::add_decl(
          env,
          source,
          current.cursor,
          result.value.decl
        )
      ),
    },
  }
}

fn TextResolutionEnv::from_source(
  source: textlex.TextTokenStream
) -> TextResolutionEnv {
  TextResolutionEnv::from_source_loop(
    source,
    textmodel.full_window_state(source),
    TextResolutionEnv::empty()
  )
}

fn TextResolutionEnv::add_direct_import_symbol_decl(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  alias_hash: i32,
  index: i32,
  decl: ast.Decl,
  kind_tag: i32
) -> TextResolutionEnv {
  match text_declaration_kind_is_source_import(kind_tag) {
    true => env,
    false => TextResolutionEnv::add_symbol(
      env,
      text_declaration_name_hash(source, index, decl),
      text_declaration_direct_import_resolved_type_class_tag(
        source,
        import_source,
        index,
        decl,
        alias_hash
      )
    ),
  }
}

fn TextResolutionEnv::add_direct_import_return_decl(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  alias_hash: i32,
  index: i32,
  decl: ast.Decl,
  kind_tag: i32
) -> TextResolutionEnv {
  match text_declaration_kind_is_function(kind_tag) {
    false => env,
    true => TextResolutionEnv::add_return(
      env,
      text_declaration_name_hash(source, index, decl),
      text_function_return_direct_import_resolved_type_class_tag(
        source,
        import_source,
        index,
        alias_hash
      )
    ),
  }
}

fn TextResolutionEnv::add_direct_import_decl(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  alias_hash: i32,
  index: i32,
  decl: ast.Decl
) -> TextResolutionEnv {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  TextResolutionEnv::add_direct_import_symbol_decl(
    env,
    source,
    import_source,
    alias_hash,
    index,
    decl,
    kind_tag
  ) \with_symbol -> TextResolutionEnv::add_direct_import_return_decl(
    with_symbol,
    source,
    import_source,
    alias_hash,
    index,
    decl,
    kind_tag
  )
}

fn TextResolutionEnv::from_direct_import_loop(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  alias_hash: i32,
  current: combinator.ParseState,
  env: TextResolutionEnv
) -> TextResolutionEnv {
  match current.cursor < textlex.length(source) {
    false => env,
    true => match parse_text_declaration_stream(
      current,
      source,
      layout.HeapArray::len(TextTypeClassBinding, env.symbols)
    ) {
      Err(_) => env,
      Ok(result) => rec(
        source,
        import_source,
        alias_hash,
        next_text_declaration_state(result.state, source),
        TextResolutionEnv::add_direct_import_decl(
          env,
          source,
          import_source,
          alias_hash,
          current.cursor,
          result.value.decl
        )
      ),
    },
  }
}

fn TextResolutionEnv::from_direct_import(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  alias_hash: i32
) -> TextResolutionEnv {
  TextResolutionEnv::from_direct_import_loop(
    source,
    import_source,
    alias_hash,
    textmodel.full_window_state(source),
    TextResolutionEnv::empty()
  )
}

fn TextResolutionEnv::lookup_bindings(
  bindings: layout.HeapArray(TextTypeClassBinding),
  target_hash: i32,
  index: i32
) -> i32 {
  match index < 0 {
    true => text_type_class_unknown_tag(),
    false => match layout.HeapArray::get(
      TextTypeClassBinding,
      bindings,
      index
    ).name_hash == target_hash {
      true => layout.HeapArray::get(
        TextTypeClassBinding,
        bindings,
        index
      ).type_class,
      false => rec(bindings, target_hash, index - 1),
    },
  }
}

fn TextResolutionEnv::lookup_symbol(
  env: TextResolutionEnv,
  target_hash: i32
) -> i32 {
  match target_hash == 0 {
    true => text_type_class_unknown_tag(),
    false => TextResolutionEnv::lookup_bindings(
      env.symbols,
      target_hash,
      layout.HeapArray::len(TextTypeClassBinding, env.symbols) - 1
    ),
  }
}

fn TextResolutionEnv::lookup_return(
  env: TextResolutionEnv,
  target_hash: i32
) -> i32 {
  match target_hash == 0 {
    true => text_type_class_unknown_tag(),
    false => TextResolutionEnv::lookup_bindings(
      env.returns,
      target_hash,
      layout.HeapArray::len(TextTypeClassBinding, env.returns) - 1
    ),
  }
}

fn TextResolutionEnv::root_call_return_type_class_for_hash_between(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  target_hash: i32
) -> i32 {
  match text_root_call_has_return_target(source, index, limit) {
    true => TextResolutionEnv::lookup_return(
      env,
      text_root_call_return_target_hash_between(
        source,
        index,
        limit,
        target_hash
      )
    ),
    false => text_type_class_unknown_tag(),
  }
}

fn TextResolutionEnv::function_scalar_operator_operand_type_class(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let parenthesized = text_parenthesized_expression_segment_between(
    source,
    start,
    limit
  );
  match parenthesized.found {
    true => rec(env, source, function_index, parenthesized.start, parenthesized.limit),
    false => TextResolutionEnv::function_scalar_operator_operand_type_class_unwrapped(
      env,
      source,
      function_index,
      start,
      limit
    ),
  }
}

fn TextResolutionEnv::function_scalar_operator_operand_type_class_unwrapped(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let root_kind = text_expression_root_head_kind_tag_between(
    source,
    start,
    limit
  );
  let root_type = text_expression_root_type_class_tag_between(
    source,
    start,
    limit
  );
  let operator_type = TextResolutionEnv::function_scalar_operator_type_class_between(
    env,
    source,
    function_index,
    start,
    limit
  );
  match operator_type == text_type_class_unknown_tag() {
    false => operator_type,
    true => TextResolutionEnv::function_scalar_branch_type_class_between(
      env,
      source,
      function_index,
      start,
      limit
    ) \branch_type -> match branch_type == text_type_class_unknown_tag() {
      false => branch_type,
      true => text_root_literal_type_class(
        root_kind,
        root_type
      ) \literal_type -> match literal_type == text_type_class_unknown_tag() {
        false => literal_type,
        true => match root_kind == text_expression_root_identifier_tag() {
          true => text_expression_root_head_hash_between(
            source,
            start,
            limit
          ) \target_hash -> text_expression_root_call_arg_count_between(
            source,
            start,
            limit
          ) \call_arg_count -> match call_arg_count == text_no_root_call_arg_count() {
            true => match text_expression_root_is_bare_identifier_between(
              source,
              start,
              limit
            ) {
              true => text_function_param_resolved_type_class_for_name_hash(
                source,
                function_index,
                target_hash
              ),
              false => text_type_class_unknown_tag(),
            },
            false => TextResolutionEnv::root_call_return_type_class_for_hash_between(
              env,
              source,
              start,
              limit,
              target_hash
            ),
          },
          false => text_type_class_unknown_tag(),
        },
      },
    },
  }
}

fn TextResolutionEnv::function_scalar_operator_type_class_between(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let parts = text_expression_root_single_operator_parts_between(
    source,
    start,
    limit
  );
  match parts.found {
    false => text_type_class_unknown_tag(),
    true => text_scalar_operator_type_class_from_parts(
      parts.operator_hash,
      TextResolutionEnv::function_scalar_operator_operand_type_class(
        env,
        source,
        function_index,
        parts.left_start,
        parts.left_limit
      ),
      TextResolutionEnv::function_scalar_operator_operand_type_class(
        env,
        source,
        function_index,
        parts.right_start,
        parts.right_limit
      )
    ),
  }
}

fn TextResolutionEnv::function_scalar_branch_type_class_between(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let segments = text_bool_branch_segments_between(source, start, limit);
  match segments.found {
    false => text_type_class_unknown_tag(),
    true => text_scalar_branch_type_class_from_parts(
      TextResolutionEnv::function_scalar_operator_operand_type_class(
        env,
        source,
        function_index,
        segments.condition_start,
        segments.condition_limit
      ),
      TextResolutionEnv::function_scalar_operator_operand_type_class(
        env,
        source,
        function_index,
        segments.true_value_start,
        segments.true_value_limit
      ),
      TextResolutionEnv::function_scalar_operator_operand_type_class(
        env,
        source,
        function_index,
        segments.false_value_start,
        segments.false_value_limit
      )
    ),
  }
}

fn TextResolutionEnv::function_body_scalar_operator_operand_type_class(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let parenthesized = text_parenthesized_expression_segment_between(
    source,
    start,
    limit
  );
  match parenthesized.found {
    true => rec(env, source, function_index, parenthesized.start, parenthesized.limit),
    false => TextResolutionEnv::function_body_scalar_operator_operand_type_class_unwrapped(
      env,
      source,
      function_index,
      start,
      limit
    ),
  }
}

fn TextResolutionEnv::function_body_scalar_operator_operand_type_class_unwrapped(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let root_kind = text_expression_root_head_kind_tag_between(
    source,
    start,
    limit
  );
  let operator_type = TextResolutionEnv::function_body_scalar_operator_type_class_between(
    env,
    source,
    function_index,
    start,
    limit
  );
  let type_class = match operator_type == text_type_class_unknown_tag() {
    false => operator_type,
    true => TextResolutionEnv::function_scalar_operator_operand_type_class(
      env,
      source,
      function_index,
      start,
      limit
    ),
  };
  match type_class == text_type_class_unknown_tag() {
    false => type_class,
    true => TextResolutionEnv::function_body_scalar_branch_type_class_between(
      env,
      source,
      function_index,
      start,
      limit
      ) \branch_type -> match branch_type == text_type_class_unknown_tag() {
      false => branch_type,
      true => match text_expression_root_is_bare_identifier_between(
        source,
        start,
        limit
      ) {
        false => text_type_class_unknown_tag(),
        true => match root_kind == text_expression_root_identifier_tag() {
          false => text_type_class_unknown_tag(),
          true => text_expression_root_identifier_hash_between(
            source,
            start,
            limit
          ) \target_hash -> TextResolutionEnv::function_local_let_resolved_type_class_for_name_hash(
            env,
            source,
            function_index,
            target_hash
          ),
        },
      },
    },
  }
}

fn TextResolutionEnv::function_body_scalar_operator_type_class_between(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let parts = text_expression_root_single_operator_parts_between(
    source,
    start,
    limit
  );
  match parts.found {
    false => text_type_class_unknown_tag(),
    true => text_scalar_operator_type_class_from_parts(
      parts.operator_hash,
      TextResolutionEnv::function_body_scalar_operator_operand_type_class(
        env,
        source,
        function_index,
        parts.left_start,
        parts.left_limit
      ),
      TextResolutionEnv::function_body_scalar_operator_operand_type_class(
        env,
        source,
        function_index,
        parts.right_start,
        parts.right_limit
      )
    ),
  }
}

fn TextResolutionEnv::function_body_scalar_branch_type_class_between(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let segments = text_bool_branch_segments_between(source, start, limit);
  match segments.found {
    false => text_type_class_unknown_tag(),
    true => text_scalar_branch_type_class_from_parts(
      TextResolutionEnv::function_body_scalar_operator_operand_type_class(
        env,
        source,
        function_index,
        segments.condition_start,
        segments.condition_limit
      ),
      TextResolutionEnv::function_body_scalar_operator_operand_type_class(
        env,
        source,
        function_index,
        segments.true_value_start,
        segments.true_value_limit
      ),
      TextResolutionEnv::function_body_scalar_operator_operand_type_class(
        env,
        source,
        function_index,
        segments.false_value_start,
        segments.false_value_limit
      )
    ),
  }
}

fn TextResolutionEnv::function_body_simple_scalar_operator_type_class(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_function_body_value_limit_index(source, index);
  let start = text_function_body_value_start_index(source, index);
  TextResolutionEnv::function_body_scalar_operator_type_class_between(
    env,
    source,
    index,
    start,
    next
  )
}

fn TextResolutionEnv::function_match_body_scalar_branch_type_class(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let segments = text_function_bool_match_body_segments(source, index);
  match segments.found {
    false => text_type_class_unknown_tag(),
    true => text_scalar_branch_type_class_from_parts(
      text_type_class_bool_tag(),
      TextResolutionEnv::function_body_scalar_operator_operand_type_class(
        env,
        source,
        index,
        segments.true_value_start,
        segments.true_value_limit
      ),
      TextResolutionEnv::function_body_scalar_operator_operand_type_class(
        env,
        source,
        index,
        segments.false_value_start,
        segments.false_value_limit
      )
    ),
  }
}

fn TextResolutionEnv::function_match_body_result_type_class(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let start = text_function_body_value_start_index(source, index);
  let limit = text_function_body_value_limit_index(source, index);
  let literal_type = text_match_body_literal_result_type_class_between(
    source,
    start,
    limit
  );
  match literal_type == text_type_class_unknown_tag() {
    false => literal_type,
    true => TextResolutionEnv::function_match_body_scalar_branch_type_class(
      env,
      source,
      index
    ),
  }
}

fn TextResolutionEnv::function_local_value_resolved_type_class(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let root_type = text_expression_root_type_class_tag_between(
    source,
    start,
    limit
  );
  match root_type == text_type_class_unknown_tag() {
    false => root_type,
    true => text_expression_root_identifier_hash_between(
      source,
      start,
      limit
    ) \target_hash -> text_function_param_resolved_type_class_for_name_hash(
      source,
      function_index,
      target_hash
    ) \param_type -> match param_type == text_type_class_unknown_tag() {
      false => param_type,
      true => TextResolutionEnv::function_scalar_operator_type_class_between(
        env,
        source,
        function_index,
        start,
        limit
      ) \operator_type -> match operator_type == text_type_class_unknown_tag() {
        false => operator_type,
        true => TextResolutionEnv::function_scalar_branch_type_class_between(
          env,
          source,
          function_index,
          start,
          limit
        ) \branch_type -> match branch_type == text_type_class_unknown_tag() {
          false => branch_type,
          true => TextResolutionEnv::root_call_return_type_class_for_hash_between(
            env,
            source,
            start,
            limit,
            text_expression_root_head_hash_between(source, start, limit)
          ),
        },
      },
    },
  }
}

fn TextResolutionEnv::function_local_let_resolved_type_class_at(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  function_index: i32,
  index: i32,
  statement_end: i32
) -> i32 {
  let equal = text_local_let_equal_index(source, index, statement_end);
  match equal < statement_end {
    false => text_type_class_unknown_tag(),
    true => text_local_let_annotation_type_class(
      source,
      index,
      equal
    ) \annotation_type -> match annotation_type == text_type_class_unknown_tag() {
      false => annotation_type,
      true => text_local_let_statement_end(
        source,
        equal + 1,
        statement_end
      ) \value_end -> TextResolutionEnv::function_local_value_resolved_type_class(
        env,
        source,
        function_index,
        equal + 1,
        value_end
      ),
    },
  }
}

fn TextResolutionEnv::function_local_let_resolved_type_class_for_name_hash_between(
  env: TextResolutionEnv,
  source: textlex.TextTokenStream,
  function_index: i32,
  scan: TextFunctionLocalLetScan,
  target_hash: i32
) -> i32 {
  match scan.index >= scan.limit {
    true => text_type_class_unknown_tag(),
    false => match text_function_local_let_index_found(
      source,
      scan,
      target_hash
    ) {
      true => TextResolutionEnv::function_local_let_resolved_type_class_at(
        env,
        source,
        function_index,
        scan.index,
        text_local_let_statement_end(source, scan.index, scan.limit)
      ),
      false => rec(
        env,
        source,
        function_index,
        text_function_local_let_index_next_scan(source, scan),
        target_hash
      ),
    },
  }
}

fn TextResolutionEnv::function_local_let_resolved_type_class_for_name_hash(
  env: TextResolutionEnv,
