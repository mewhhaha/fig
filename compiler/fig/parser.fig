fn text_root_child_record_input(
  parent_kind_tag: i32,
  parent_name_hash: i32,
  total: i32
) -> TextRootChildRecordInput {
  TextRootChildRecordInput {
    parent_kind_tag: parent_kind_tag,
    parent_name_hash: parent_name_hash,
    total: total,
  }
}

fn text_value_root_child_record_signature_between(
  source: textlex.TextTokenStream,
  window: TextValueBodyWindow,
  input: TextRootChildRecordInput
) -> i32 {
  match window.found {
    false => input.total,
    true => text_expression_root_child_record_signature_between(
      source,
      window.start,
      window.limit,
      input.parent_kind_tag,
      input.parent_name_hash,
      input.total
    ),
  }
}

fn text_declaration_root_child_record_signature_reader(
  total: i32
) -> monad.Reader(TextValueBodyContext, i32) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    source <- monad.Reader::asks(text_value_body_context_source);
    index <- monad.Reader::asks(text_value_body_context_index);
    decl <- monad.Reader::asks(text_value_body_context_decl);
    window <- text_declaration_root_expression_window_reader();
    let kind_tag = text_declaration_kind_tag(source, index, decl);
    let parent_name_hash = text_declaration_name_hash(source, index, decl);
    pure(text_value_root_child_record_signature_between(
      source,
      window,
      text_root_child_record_input(kind_tag, parent_name_hash, total)
    ))
  }
}

