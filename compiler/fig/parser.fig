fn text_annotation_resolved_type_class_tag_from_hash(
  source: textlex.TextTokenStream,
  value_hash: i32
) -> i32 {
  let primitive = text_annotation_type_class_tag_from_hash(value_hash);
  match primitive == text_type_class_unknown_tag() {
    true => text_named_type_class_for_hash(source, value_hash),
    false => primitive,
  }
}

fn text_annotation_resolved_type_class_tag_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  match index >= limit {
    true => text_type_class_unknown_tag(),
    false => match text_param_signature_is_trivia(source, index) {
      true => text_annotation_resolved_type_class_tag_between(
        source,
        index + 1,
        limit
      ),
      false => text_annotation_literal_type_class_tag_for_token(
        source,
        index,
        limit
      ) \literal_type -> match literal_type == text_type_class_unknown_tag() {
        false => literal_type,
        true => text_annotation_resolved_type_class_tag_from_hash(
          source,
          textlex.text_hash_at(source, index)
        ),
      },
    },
  }
}

fn text_function_return_resolved_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  let arrow = text_function_arrow_index(source, close_paren, next);
  let left_brace = text_function_left_brace_index(source, arrow, next);
  let body_start = text_function_body_start_index(source, arrow, left_brace);
  text_annotation_resolved_type_class_tag_between(source, arrow + 1, body_start)
}

fn text_value_annotation_resolved_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let equal = text_find_top_level_punctuation_score(
    source,
    index + 2,
    next,
    0,
    1
  );
  let colon = text_find_top_level_punctuation_score(
    source,
    index + 2,
    equal,
    0,
    8
  );
  match colon < equal {
    true => text_annotation_resolved_type_class_tag_between(source, colon + 1, equal),
    false => text_type_class_unknown_tag(),
  }
}

fn text_declaration_resolved_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  match text_declaration_kind_is_function(kind_tag) {
    true => text_type_class_function_tag(),
    false => match text_declaration_kind_is_value_binding(kind_tag) {
      true => text_value_annotation_resolved_type_class_tag(source, index),
      false => match text_declaration_kind_is_type(kind_tag) {
        true => text_named_type_class_for_hash(
          source,
          text_declaration_name_hash(source, index, decl)
        ),
        false => text_type_class_unknown_tag(),
      },
    },
  }
}

fn text_declaration_resolved_type_class_payload(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  match text_declaration_kind_is_function(kind_tag) {
    true => ast.decl_param_count(decl) * 31
      + text_function_return_resolved_type_class_tag(source, index),
    false => 0,
  }
}

