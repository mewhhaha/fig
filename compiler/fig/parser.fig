fn text_match_values_segment_signature(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32
) -> i32 {
  let with_kind = textmodel.signature_mix(
    total,
    text_match_values_root_head_kind_tag_between(source, index, limit)
  );
  let with_hash = textmodel.signature_mix(
    with_kind,
    text_match_values_root_head_hash_between(source, index, limit)
  );
  textmodel.signature_mix(
    with_hash,
    text_match_values_root_type_class_tag_between(source, index, limit)
  )
}

fn text_match_values_child_record_fact_signature(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  parent_kind_tag: i32,
  parent_name_hash: i32,
  child_index: i32,
  child_role_tag: i32
) -> i32 {
  let with_parent_kind = textmodel.signature_mix(67, parent_kind_tag);
  let with_parent_name = textmodel.signature_mix(
    with_parent_kind,
    parent_name_hash
  );
  let with_child_index = textmodel.signature_mix(
    with_parent_name,
    child_index
  );
  let with_child_role = textmodel.signature_mix(
    with_child_index,
    child_role_tag
  );
  let with_child_label = textmodel.signature_mix(with_child_role, 0);
  let with_child_kind = textmodel.signature_mix(
    with_child_label,
    text_match_values_root_head_kind_tag_between(source, index, limit)
  );
  let with_child_hash = textmodel.signature_mix(
    with_child_kind,
    text_match_values_root_head_hash_between(source, index, limit)
  );
  let with_child_type = textmodel.signature_mix(
    with_child_hash,
    text_match_values_root_type_class_tag_between(source, index, limit)
  );
  let with_child_count = textmodel.signature_mix(
    with_child_type,
    text_match_values_child_count_between(source, index, limit)
  );
  textmodel.signature_mix(
    with_child_count,
    text_match_values_descendant_count_between(source, index, limit)
  )
}

fn text_match_values_child_record_state_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  parent_kind_tag: i32,
  parent_name_hash: i32,
  child_index: i32,
  child_role_tag: i32,
  total: i32
) -> TextRootChildRecordState {
  let segments = text_match_values_segments_between(source, index, limit);
  match segments.count == 0 {
    true => TextRootChildRecordState {
      child_index: child_index,
      total: total,
    },
    false => text_match_values_child_record_fact_signature(
      source,
      index,
      limit,
      parent_kind_tag,
      parent_name_hash,
      child_index,
      child_role_tag
    ) \fact_signature -> textmodel.signature_mix(total, fact_signature) \with_fact -> match text_match_values_is_synthetic_shape(segments) {
      true => text_root_positional_child_record_state_between_segments(
        source,
        segments.start,
        segments.limit,
        parent_kind_tag,
        parent_name_hash,
        text_root_child_slot_role_tag(),
        child_index + 1,
        with_fact
      ),
      false => text_expression_root_child_record_signature_between_state(
        source,
        segments.start,
        segments.limit,
        parent_kind_tag,
        parent_name_hash,
        child_index + 1,
        with_fact
      ),
    },
  }
}

fn text_match_arm_guard_start_between_depth(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  paren_depth: i32,
  brace_depth: i32,
  bracket_depth: i32
) -> i32 {
  match index >= limit {
    true => limit,
    false => text_depth_is_top_level(brace_depth, paren_depth) \top_level -> match top_level {
      true => match bracket_depth == 0 {
        true => match textlex.token_at(source, index).kind {
          IfKw => index + 1,
          _ => text_match_arm_guard_start_between_depth(
            source,
            index + 1,
            limit,
            paren_depth_after_token(source, index, paren_depth),
            brace_depth_after_token(source, index, brace_depth),
            text_argument_scan_bracket_delta(source, index, bracket_depth)
          ),
        },
        false => text_match_arm_guard_start_between_depth(
          source,
          index + 1,
          limit,
          paren_depth_after_token(source, index, paren_depth),
          brace_depth_after_token(source, index, brace_depth),
          text_argument_scan_bracket_delta(source, index, bracket_depth)
        ),
      },
      false => text_match_arm_guard_start_between_depth(
        source,
        index + 1,
        limit,
        paren_depth_after_token(source, index, paren_depth),
        brace_depth_after_token(source, index, brace_depth),
        text_argument_scan_bracket_delta(source, index, bracket_depth)
      ),
    },
  }
}

fn text_match_arm_guard_start_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  text_match_arm_guard_start_between_depth(source, index, limit, 0, 0, 0)
}

fn text_root_match_child_scan_is_top_level(
  scan: TextRootMatchChildScan
) -> bool {
  match scan.paren_depth == 0 {
    true => match scan.brace_depth == 0 {
      true => scan.bracket_depth == 0,
      false => false,
    },
    false => false,
  }
}

fn text_root_match_child_scan_has_value(
  scan: TextRootMatchChildScan
) -> bool {
  scan.segment_start < scan.close_index
}

fn text_root_match_child_scan_finish_present(
  source: textlex.TextTokenStream,
  scan: TextRootMatchChildScan
) -> TextRootMatchChildScan {
  let value_start = text_expression_start_skip_trivia(
    source,
    scan.segment_start,
    scan.index
  );
  match value_start >= scan.index {
    true => TextRootMatchChildScan {
      index: scan.index,
      close_index: scan.close_index,
      segment_start: scan.close_index,
      arm_start: scan.arm_start,
      paren_depth: scan.paren_depth,
      brace_depth: scan.brace_depth,
      bracket_depth: scan.bracket_depth,
      total_count: scan.total_count,
      total_signature: scan.total_signature,
      total_grandchild_count: scan.total_grandchild_count,
      total_grandchild_signature: scan.total_grandchild_signature,
      total_descendant_count: scan.total_descendant_count,
      total_descendant_signature: scan.total_descendant_signature,
      segment_saw_argument: false,
    },
    false => text_root_match_child_scan_append_value(
      source,
      scan,
      value_start,
      scan.index
    ) \next -> TextRootMatchChildScan {
      index: next.index,
      close_index: next.close_index,
      segment_start: scan.close_index,
      arm_start: next.arm_start,
      paren_depth: next.paren_depth,
      brace_depth: next.brace_depth,
      bracket_depth: next.bracket_depth,
      total_count: next.total_count,
      total_signature: next.total_signature,
      total_grandchild_count: next.total_grandchild_count,
      total_grandchild_signature: next.total_grandchild_signature,
      total_descendant_count: next.total_descendant_count,
      total_descendant_signature: next.total_descendant_signature,
      segment_saw_argument: false,
    },
  }
}

fn text_root_match_child_scan_append_value(
  source: textlex.TextTokenStream,
  scan: TextRootMatchChildScan,
  value_start: i32,
  value_limit: i32
) -> TextRootMatchChildScan {
  text_expression_root_child_count_between(
      source,
      value_start,
    value_limit
    ) \child_count -> text_expression_root_child_signature_between(
      source,
      value_start,
    value_limit,
      scan.total_grandchild_signature
    ) \child_signature -> text_expression_root_descendant_count_between(
      source,
      value_start,
    value_limit
    ) \descendant_count -> text_child_value_segment_signature(
      source,
      value_start,
    value_limit,
      scan.total_descendant_signature
    ) \with_descendant_child -> text_expression_root_descendant_signature_between(
      source,
      value_start,
    value_limit,
      with_descendant_child
    ) \descendant_signature -> TextRootMatchChildScan {
      index: scan.index,
      close_index: scan.close_index,
    segment_start: scan.segment_start,
    arm_start: scan.arm_start,
      paren_depth: scan.paren_depth,
      brace_depth: scan.brace_depth,
      bracket_depth: scan.bracket_depth,
      total_count: scan.total_count + 1,
      total_signature: text_child_value_segment_signature(
        source,
        value_start,
      value_limit,
        scan.total_signature
      ),
      total_grandchild_count: scan.total_grandchild_count + child_count,
      total_grandchild_signature: child_signature,
      total_descendant_count: scan.total_descendant_count + 1 + descendant_count,
      total_descendant_signature: descendant_signature,
      segment_saw_argument: false,
  }
}

fn text_root_match_child_scan_append_guard(
  source: textlex.TextTokenStream,
  scan: TextRootMatchChildScan
) -> TextRootMatchChildScan {
  let guard_start = text_match_arm_guard_start_between(
    source,
    scan.arm_start,
    scan.index
  );
  match guard_start < scan.index {
    true => text_root_match_child_scan_append_value(
      source,
      scan,
      guard_start,
      scan.index
    ),
    false => scan,
  }
}

fn text_root_match_child_scan_finish_segment(
  source: textlex.TextTokenStream,
  scan: TextRootMatchChildScan
) -> TextRootMatchChildScan {
  match scan.segment_saw_argument {
    true => text_root_match_child_scan_finish_present(source, scan),
    false => scan,
  }
}

fn text_root_match_child_scan_step(
  source: textlex.TextTokenStream,
  scan: TextRootMatchChildScan
) -> TextRootMatchChildScan {
  let punctuation = textlex.punctuation_at(source, scan.index);
  let top_level = text_root_match_child_scan_is_top_level(scan);
  let has_value = text_root_match_child_scan_has_value(scan);
  let is_arrow = match top_level {
    true => match has_value {
      true => false,
      false => text_value_match_arm_token_matches(source, scan.index),
    },
    false => false,
  };
  let is_separator = match top_level {
    true => match has_value {
      true => match punctuation {
        PunctComma => true,
        _ => false,
      },
      false => false,
    },
    false => false,
  };
  let is_argument_token = match is_arrow {
    true => false,
    false => match is_separator {
      true => false,
      false => match has_value {
        false => false,
        true => match scan.index < scan.segment_start {
          true => false,
          false => match text_param_signature_is_trivia(source, scan.index) {
            true => false,
            false => true,
          },
        },
      },
    },
  };
  let finished = match is_separator {
    true => text_root_match_child_scan_finish_segment(source, scan),
    false => scan,
  };
  let with_guard = match is_arrow {
    true => text_root_match_child_scan_append_guard(source, finished),
    false => finished,
  };
  TextRootMatchChildScan {
    index: match is_arrow {
      true => scan.index + 2,
      false => scan.index + 1,
    },
    close_index: scan.close_index,
    segment_start: match is_arrow {
      true => scan.index + 2,
      false => match is_separator {
        true => scan.close_index,
        false => with_guard.segment_start,
      },
    },
    arm_start: match is_separator {
      true => scan.index + 1,
      false => with_guard.arm_start,
    },
    paren_depth: match is_arrow {
      true => scan.paren_depth,
      false => paren_depth_after_token(source, scan.index, scan.paren_depth),
    },
    brace_depth: match is_arrow {
      true => scan.brace_depth,
      false => brace_depth_after_token(source, scan.index, scan.brace_depth),
    },
    bracket_depth: match is_arrow {
      true => scan.bracket_depth,
      false => text_argument_scan_bracket_delta(
        source,
        scan.index,
        scan.bracket_depth
      ),
    },
    total_count: with_guard.total_count,
    total_signature: with_guard.total_signature,
    total_grandchild_count: with_guard.total_grandchild_count,
    total_grandchild_signature: with_guard.total_grandchild_signature,
    total_descendant_count: with_guard.total_descendant_count,
    total_descendant_signature: with_guard.total_descendant_signature,
    segment_saw_argument: match is_arrow {
      true => false,
      false => match is_separator {
        true => false,
        false => match is_argument_token {
          true => true,
          false => scan.segment_saw_argument,
        },
      },
    },
  }
}

fn text_root_match_child_scan_loop(
  source: textlex.TextTokenStream,
  scan: TextRootMatchChildScan
) -> TextRootMatchChildScan {
  match scan.index >= scan.close_index {
    true => text_root_match_child_scan_finish_segment(source, scan),
    false => text_root_match_child_scan_loop(
      source,
      text_root_match_child_scan_step(source, scan)
    ),
  }
}

fn text_root_match_child_scan(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32,
  total_signature: i32,
  total_grandchild_signature: i32,
  total_descendant_signature: i32
) -> TextRootMatchChildScan {
  text_root_match_child_scan_loop(
    source,
    TextRootMatchChildScan {
      index: open_index + 1,
      close_index: close_index,
      segment_start: close_index,
      arm_start: open_index + 1,
      paren_depth: 0,
      brace_depth: 0,
      bracket_depth: 0,
      total_count: 0,
      total_signature: total_signature,
      total_grandchild_count: 0,
      total_grandchild_signature: total_grandchild_signature,
      total_descendant_count: 0,
      total_descendant_signature: total_descendant_signature,
      segment_saw_argument: false,
    }
  )
}

fn text_root_match_child_count_in_block(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32
) -> i32 {
  text_root_match_child_scan(source, open_index, close_index, 0, 0, 0).total_count
}

fn text_root_match_child_signature_in_block(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32,
  total: i32
) -> i32 {
  text_root_match_child_scan(source, open_index, close_index, total, 0, 0).total_signature
}

fn text_root_match_grandchild_count_in_block(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32
) -> i32 {
  text_root_match_child_scan(
    source,
    open_index,
    close_index,
    0,
    0,
    0
  ).total_grandchild_count
}

fn text_root_match_grandchild_signature_in_block(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32,
  total: i32
) -> i32 {
  text_root_match_child_scan(
    source,
    open_index,
    close_index,
    0,
    total,
    0
  ).total_grandchild_signature
}

fn text_root_match_descendant_count_in_block(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32
) -> i32 {
  text_root_match_child_scan(
    source,
    open_index,
    close_index,
    0,
    0,
    0
  ).total_descendant_count
}

fn text_root_match_descendant_signature_in_block(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32,
  total: i32
) -> i32 {
  text_root_match_child_scan(
    source,
    open_index,
    close_index,
    0,
    0,
    total
  ).total_descendant_signature
}

fn text_root_match_child_record_scan_is_top_level(
  scan: TextRootMatchChildRecordScan
) -> bool {
  match scan.paren_depth == 0 {
    true => match scan.brace_depth == 0 {
      true => scan.bracket_depth == 0,
      false => false,
    },
    false => false,
  }
}

fn text_root_match_child_record_scan_has_value(
  scan: TextRootMatchChildRecordScan
) -> bool {
  scan.segment_start < scan.close_index
}

fn text_root_match_child_record_scan_finish_present(
  source: textlex.TextTokenStream,
  scan: TextRootMatchChildRecordScan
) -> TextRootMatchChildRecordScan {
  let value_start = text_expression_start_skip_trivia(
    source,
    scan.segment_start,
    scan.index
  );
  match value_start >= scan.index {
    true => TextRootMatchChildRecordScan {
      index: scan.index,
      close_index: scan.close_index,
      segment_start: scan.close_index,
      arm_start: scan.arm_start,
      paren_depth: scan.paren_depth,
      brace_depth: scan.brace_depth,
      bracket_depth: scan.bracket_depth,
      child_index: scan.child_index,
      parent_kind_tag: scan.parent_kind_tag,
      parent_name_hash: scan.parent_name_hash,
      total: scan.total,
      segment_saw_argument: false,
    },
    false => text_root_match_child_record_scan_append_value(
      source,
      scan,
      value_start,
      scan.index,
      text_root_child_match_arm_role_tag()
    ) \next -> TextRootMatchChildRecordScan {
      index: next.index,
      close_index: next.close_index,
      segment_start: scan.close_index,
      arm_start: next.arm_start,
      paren_depth: next.paren_depth,
      brace_depth: next.brace_depth,
      bracket_depth: next.bracket_depth,
      child_index: next.child_index,
      parent_kind_tag: next.parent_kind_tag,
      parent_name_hash: next.parent_name_hash,
      total: next.total,
      segment_saw_argument: false,
    },
  }
}

fn text_root_match_child_record_scan_append_value(
  source: textlex.TextTokenStream,
  scan: TextRootMatchChildRecordScan,
  value_start: i32,
  value_limit: i32,
  child_role_tag: i32
) -> TextRootMatchChildRecordScan {
  text_root_child_record_value_fact_signature(
      source,
      value_start,
    value_limit,
      scan.parent_kind_tag,
      scan.parent_name_hash,
      scan.child_index,
    child_role_tag,
      0
    ) \fact_signature -> text_expression_root_child_record_signature_between_state(
      source,
      value_start,
    value_limit,
      scan.parent_kind_tag,
      scan.parent_name_hash,
      scan.child_index + 1,
      textmodel.signature_mix(scan.total, fact_signature)
    ) \nested -> TextRootMatchChildRecordScan {
      index: scan.index,
      close_index: scan.close_index,
    segment_start: scan.segment_start,
    arm_start: scan.arm_start,
      paren_depth: scan.paren_depth,
      brace_depth: scan.brace_depth,
      bracket_depth: scan.bracket_depth,
      child_index: nested.child_index,
      parent_kind_tag: scan.parent_kind_tag,
      parent_name_hash: scan.parent_name_hash,
      total: nested.total,
      segment_saw_argument: false,
  }
}

fn text_root_match_child_record_scan_append_guard(
  source: textlex.TextTokenStream,
  scan: TextRootMatchChildRecordScan
) -> TextRootMatchChildRecordScan {
  let guard_start = text_match_arm_guard_start_between(
    source,
    scan.arm_start,
    scan.index
  );
  match guard_start < scan.index {
    true => text_root_match_child_record_scan_append_value(
      source,
      scan,
      guard_start,
      scan.index,
      text_root_child_match_guard_role_tag()
    ),
    false => scan,
  }
}

fn text_root_match_child_record_scan_finish_segment(
  source: textlex.TextTokenStream,
  scan: TextRootMatchChildRecordScan
) -> TextRootMatchChildRecordScan {
  match scan.segment_saw_argument {
    true => text_root_match_child_record_scan_finish_present(source, scan),
    false => scan,
  }
}

fn text_root_match_child_record_scan_step(
  source: textlex.TextTokenStream,
  scan: TextRootMatchChildRecordScan
) -> TextRootMatchChildRecordScan {
  let punctuation = textlex.punctuation_at(source, scan.index);
  let top_level = text_root_match_child_record_scan_is_top_level(scan);
  let has_value = text_root_match_child_record_scan_has_value(scan);
  let is_arrow = match top_level {
    true => match has_value {
      true => false,
      false => text_value_match_arm_token_matches(source, scan.index),
    },
    false => false,
  };
  let is_separator = match top_level {
    true => match has_value {
      true => match punctuation {
        PunctComma => true,
        _ => false,
      },
      false => false,
    },
    false => false,
  };
  let is_argument_token = match is_arrow {
    true => false,
    false => match is_separator {
      true => false,
      false => match has_value {
        false => false,
        true => match scan.index < scan.segment_start {
          true => false,
          false => match text_param_signature_is_trivia(source, scan.index) {
            true => false,
            false => true,
          },
        },
      },
    },
  };
  let finished = match is_separator {
    true => text_root_match_child_record_scan_finish_segment(source, scan),
    false => scan,
  };
  let with_guard = match is_arrow {
    true => text_root_match_child_record_scan_append_guard(source, finished),
    false => finished,
  };
  TextRootMatchChildRecordScan {
    index: match is_arrow {
      true => scan.index + 2,
      false => scan.index + 1,
    },
    close_index: scan.close_index,
    segment_start: match is_arrow {
      true => scan.index + 2,
      false => match is_separator {
        true => scan.close_index,
        false => with_guard.segment_start,
      },
    },
    arm_start: match is_separator {
      true => scan.index + 1,
      false => with_guard.arm_start,
    },
    paren_depth: match is_arrow {
      true => scan.paren_depth,
      false => paren_depth_after_token(source, scan.index, scan.paren_depth),
    },
    brace_depth: match is_arrow {
      true => scan.brace_depth,
      false => brace_depth_after_token(source, scan.index, scan.brace_depth),
    },
    bracket_depth: match is_arrow {
      true => scan.bracket_depth,
      false => text_argument_scan_bracket_delta(
        source,
        scan.index,
        scan.bracket_depth
      ),
    },
    child_index: with_guard.child_index,
    parent_kind_tag: with_guard.parent_kind_tag,
    parent_name_hash: with_guard.parent_name_hash,
    total: with_guard.total,
    segment_saw_argument: match is_arrow {
      true => false,
      false => match is_separator {
        true => false,
        false => match is_argument_token {
          true => true,
          false => scan.segment_saw_argument,
        },
      },
    },
  }
}

fn text_root_match_child_record_scan_loop(
  source: textlex.TextTokenStream,
  scan: TextRootMatchChildRecordScan
) -> TextRootMatchChildRecordScan {
  match scan.index >= scan.close_index {
    true => text_root_match_child_record_scan_finish_segment(source, scan),
    false => text_root_match_child_record_scan_loop(
      source,
      text_root_match_child_record_scan_step(source, scan)
    ),
  }
}

fn text_root_match_child_record_state_in_block(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32,
  parent_kind_tag: i32,
  parent_name_hash: i32,
  child_index: i32,
  total: i32
) -> TextRootChildRecordState {
  let scan = text_root_match_child_record_scan_loop(
    source,
    TextRootMatchChildRecordScan {
      index: open_index + 1,
      close_index: close_index,
      segment_start: close_index,
      arm_start: open_index + 1,
      paren_depth: 0,
      brace_depth: 0,
      bracket_depth: 0,
      child_index: child_index,
      parent_kind_tag: parent_kind_tag,
      parent_name_hash: parent_name_hash,
      total: total,
      segment_saw_argument: false,
    }
  );
  TextRootChildRecordState {
    child_index: scan.child_index,
    total: scan.total,
  }
}

fn text_root_match_body_open_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> i32 {
  text_match_body_open_after_start(source, start + 1, limit, 0, 0, 0)
}

fn text_root_match_child_count_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> i32 {
  let open_index = text_root_match_body_open_between(source, start, limit);
  match open_index < limit {
    false => 0,
    true => find_text_right_brace(source, open_index + 1, limit, 0) \close_index -> match close_index < limit {
      true => text_expression_start_skip_trivia(
        source,
        start + 1,
        open_index
      ) \value_start -> match value_start < open_index {
        true => 1 + text_root_match_child_count_in_block(
          source,
          open_index,
          close_index
        ),
        false => text_root_match_child_count_in_block(
          source,
          open_index,
          close_index
        ),
      },
      false => 0,
    },
  }
}

fn text_root_match_child_signature_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  total: i32
) -> i32 {
  let open_index = text_root_match_body_open_between(source, start, limit);
  match open_index < limit {
    false => total,
    true => find_text_right_brace(source, open_index + 1, limit, 0) \close_index -> match close_index < limit {
      true => text_expression_start_skip_trivia(
        source,
        start + 1,
        open_index
      ) \value_start -> text_root_match_child_signature_in_block(
        source,
        open_index,
        close_index,
        match value_start < open_index {
          true => text_match_values_segment_signature(
            source,
            value_start,
            open_index,
            total
          ),
          false => total,
        }
      ),
      false => total,
    },
  }
}

fn text_root_match_grandchild_count_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> i32 {
  let open_index = text_root_match_body_open_between(source, start, limit);
  match open_index < limit {
    false => 0,
    true => find_text_right_brace(source, open_index + 1, limit, 0) \close_index -> match close_index < limit {
      true => text_expression_start_skip_trivia(
        source,
        start + 1,
        open_index
      ) \value_start -> match value_start < open_index {
        true => text_match_values_child_count_between(
          source,
          value_start,
          open_index
        ) + text_root_match_grandchild_count_in_block(
          source,
          open_index,
          close_index
        ),
        false => text_root_match_grandchild_count_in_block(
          source,
          open_index,
          close_index
        ),
      },
      false => 0,
    },
  }
}

fn text_root_match_grandchild_signature_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  total: i32
) -> i32 {
  let open_index = text_root_match_body_open_between(source, start, limit);
  match open_index < limit {
    false => total,
    true => find_text_right_brace(source, open_index + 1, limit, 0) \close_index -> match close_index < limit {
      true => text_expression_start_skip_trivia(
        source,
        start + 1,
        open_index
      ) \value_start -> text_root_match_grandchild_signature_in_block(
        source,
        open_index,
        close_index,
        match value_start < open_index {
          true => text_match_values_child_signature_between(
            source,
            value_start,
            open_index,
            total
          ),
          false => total,
        }
      ),
      false => total,
    },
  }
}

fn text_root_match_descendant_count_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> i32 {
  let open_index = text_root_match_body_open_between(source, start, limit);
  match open_index < limit {
    false => 0,
    true => find_text_right_brace(source, open_index + 1, limit, 0) \close_index -> match close_index < limit {
      true => text_expression_start_skip_trivia(
        source,
        start + 1,
        open_index
      ) \value_start -> match value_start < open_index {
        true => 1
          + text_match_values_descendant_count_between(
            source,
            value_start,
            open_index
          )
          + text_root_match_descendant_count_in_block(
            source,
            open_index,
            close_index
          ),
        false => text_root_match_descendant_count_in_block(
          source,
          open_index,
          close_index
        ),
      },
      false => 0,
    },
  }
}

fn text_root_match_descendant_signature_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  total: i32
) -> i32 {
  let open_index = text_root_match_body_open_between(source, start, limit);
  match open_index < limit {
    false => total,
    true => find_text_right_brace(source, open_index + 1, limit, 0) \close_index -> match close_index < limit {
      true => text_expression_start_skip_trivia(
        source,
        start + 1,
        open_index
      ) \value_start -> text_root_match_descendant_signature_in_block(
        source,
        open_index,
        close_index,
        match value_start < open_index {
          true => text_match_values_descendant_signature_between(
            source,
            value_start,
            open_index,
            text_match_values_segment_signature(
              source,
              value_start,
              open_index,
              total
            )
          ),
          false => total,
        }
      ),
      false => total,
    },
  }
}

fn text_root_match_child_record_state_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  parent_kind_tag: i32,
  parent_name_hash: i32,
  child_index: i32,
  total: i32
) -> TextRootChildRecordState {
  let open_index = text_root_match_body_open_between(source, start, limit);
  match open_index < limit {
    false => TextRootChildRecordState {
      child_index: child_index,
      total: total,
    },
    true => find_text_right_brace(source, open_index + 1, limit, 0) \close_index -> match close_index < limit {
      true => text_expression_start_skip_trivia(
        source,
        start + 1,
        open_index
      ) \value_start -> text_match_values_child_record_state_between(
        source,
        value_start,
        open_index,
        parent_kind_tag,
        parent_name_hash,
        child_index,
        text_root_child_match_scrutinee_role_tag(),
        total
      ) \after_value -> text_root_match_child_record_state_in_block(
        source,
        open_index,
        close_index,
        parent_kind_tag,
        parent_name_hash,
        after_value.child_index,
        after_value.total
      ),
      false => TextRootChildRecordState {
        child_index: child_index,
        total: total,
      },
    },
  }
}

fn text_bool_literal_true_hash() -> i32 {
  4296800
}

fn text_bool_literal_false_hash() -> i32 {
  124571339
}

fn text_bool_branch_segments_missing(limit: i32) -> TextBoolBranchSegments {
  TextBoolBranchSegments {
    found: false,
    condition_start: limit,
    condition_limit: limit,
    true_value_start: limit,
    true_value_limit: limit,
    false_value_start: limit,
    false_value_limit: limit,
  }
}

fn text_bool_branch_segments_present(
  condition_start: i32,
  condition_limit: i32,
  true_value_start: i32,
  true_value_limit: i32,
  false_value_start: i32,
  false_value_limit: i32
) -> TextBoolBranchSegments {
  TextBoolBranchSegments {
    found: true,
    condition_start: condition_start,
    condition_limit: condition_limit,
    true_value_start: true_value_start,
    true_value_limit: true_value_limit,
    false_value_start: false_value_start,
    false_value_limit: false_value_limit,
  }
}

fn text_bool_match_arm_segment_missing(
  limit: i32
) -> TextBoolMatchArmSegment {
  TextBoolMatchArmSegment {
    found: false,
    pattern_hash: 0,
    value_start: limit,
    value_limit: limit,
    next_index: limit,
  }
}

fn text_bool_match_top_level_arrow(
  source: textlex.TextTokenStream,
  scan: TextBoolMatchTokenScan
) -> i32 {
  match scan.index >= scan.limit {
    true => scan.limit,
    false => text_depth_is_top_level(scan.brace_depth, scan.paren_depth) \top_level -> match top_level {
      true => match scan.bracket_depth == 0 {
        true => match text_value_match_arm_token_matches(source, scan.index) {
          true => scan.index,
          false => text_bool_match_top_level_arrow(
            source,
            TextBoolMatchTokenScan {
              index: scan.index + 1,
              limit: scan.limit,
              paren_depth: paren_depth_after_token(
                source,
                scan.index,
                scan.paren_depth
              ),
              brace_depth: brace_depth_after_token(
                source,
                scan.index,
                scan.brace_depth
              ),
              bracket_depth: text_argument_scan_bracket_delta(
                source,
                scan.index,
                scan.bracket_depth
              ),
            }
          ),
        },
        false => text_bool_match_top_level_arrow(
          source,
          TextBoolMatchTokenScan {
            index: scan.index + 1,
            limit: scan.limit,
            paren_depth: paren_depth_after_token(
              source,
              scan.index,
              scan.paren_depth
            ),
            brace_depth: brace_depth_after_token(
              source,
              scan.index,
              scan.brace_depth
            ),
            bracket_depth: text_argument_scan_bracket_delta(
              source,
              scan.index,
              scan.bracket_depth
            ),
          }
        ),
      },
      false => text_bool_match_top_level_arrow(
        source,
        TextBoolMatchTokenScan {
          index: scan.index + 1,
          limit: scan.limit,
          paren_depth: paren_depth_after_token(
            source,
            scan.index,
            scan.paren_depth
          ),
          brace_depth: brace_depth_after_token(
            source,
            scan.index,
            scan.brace_depth
          ),
          bracket_depth: text_argument_scan_bracket_delta(
            source,
            scan.index,
            scan.bracket_depth
          ),
        }
      ),
    },
  }
}

fn text_bool_match_top_level_comma(
  source: textlex.TextTokenStream,
  scan: TextBoolMatchTokenScan
) -> i32 {
  match scan.index >= scan.limit {
    true => scan.limit,
    false => text_depth_is_top_level(scan.brace_depth, scan.paren_depth) \top_level -> match top_level {
      true => match scan.bracket_depth == 0 {
        true => match textlex.punctuation_at(source, scan.index) {
          PunctComma => scan.index,
          _ => text_bool_match_top_level_comma(
            source,
            TextBoolMatchTokenScan {
              index: scan.index + 1,
              limit: scan.limit,
              paren_depth: paren_depth_after_token(
                source,
                scan.index,
                scan.paren_depth
              ),
              brace_depth: brace_depth_after_token(
                source,
                scan.index,
                scan.brace_depth
              ),
              bracket_depth: text_argument_scan_bracket_delta(
                source,
                scan.index,
                scan.bracket_depth
              ),
            }
          ),
        },
        false => text_bool_match_top_level_comma(
          source,
          TextBoolMatchTokenScan {
            index: scan.index + 1,
            limit: scan.limit,
            paren_depth: paren_depth_after_token(
              source,
              scan.index,
              scan.paren_depth
            ),
            brace_depth: brace_depth_after_token(
              source,
              scan.index,
              scan.brace_depth
            ),
            bracket_depth: text_argument_scan_bracket_delta(
              source,
              scan.index,
              scan.bracket_depth
            ),
          }
        ),
      },
      false => text_bool_match_top_level_comma(
        source,
        TextBoolMatchTokenScan {
          index: scan.index + 1,
          limit: scan.limit,
          paren_depth: paren_depth_after_token(
            source,
            scan.index,
            scan.paren_depth
          ),
          brace_depth: brace_depth_after_token(
            source,
            scan.index,
            scan.brace_depth
          ),
          bracket_depth: text_argument_scan_bracket_delta(
            source,
            scan.index,
            scan.bracket_depth
          ),
        }
      ),
    },
  }
}

fn text_bool_match_arm_segment_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> TextBoolMatchArmSegment {
  let arrow = text_bool_match_top_level_arrow(
    source,
    TextBoolMatchTokenScan {
      index: index,
      limit: limit,
      paren_depth: 0,
      brace_depth: 0,
      bracket_depth: 0,
    }
  );
  match arrow >= limit {
    true => text_bool_match_arm_segment_missing(limit),
    false => text_match_arm_guard_start_between(
      source,
      index,
      arrow
    ) \guard_start -> match guard_start < arrow {
      true => text_bool_match_arm_segment_missing(limit),
      false => text_expression_start_skip_trivia(
        source,
        index,
        arrow
      ) \pattern_start -> match pattern_start >= arrow {
        true => text_bool_match_arm_segment_missing(limit),
        false => match text_token_weight_matches(
          source,
          pattern_start,
          token.TokenKindWeight::BoolLiteral
        ) {
          false => text_bool_match_arm_segment_missing(limit),
          true => match text_scalar_literal_is_standalone(
            source,
            pattern_start,
            arrow
          ) {
            false => text_bool_match_arm_segment_missing(limit),
            true => text_bool_match_top_level_comma(
              source,
              TextBoolMatchTokenScan {
                index: arrow + 2,
                limit: limit,
                paren_depth: 0,
                brace_depth: 0,
                bracket_depth: 0,
              }
            ) \comma -> TextBoolMatchArmSegment {
              found: true,
              pattern_hash: textlex.text_hash_at(source, pattern_start),
              value_start: text_expression_start_skip_trivia(
                source,
                arrow + 2,
                comma
              ),
              value_limit: comma,
              next_index: match comma < limit {
                true => comma + 1,
                false => limit,
              },
            },
          },
        },
      },
    },
  }
}

fn text_match_arm_literal_result_type_class_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let root_kind = text_expression_root_head_kind_tag_between(
    source,
    index,
    limit
  );
  let root_type = text_expression_root_type_class_tag_between(
    source,
    index,
    limit
  );
  match root_kind == text_expression_root_number_tag() {
    true => match root_type == text_type_class_i32_tag() {
      true => text_type_class_i32_tag(),
      false => text_type_class_unknown_tag(),
    },
    false => match root_kind == text_expression_root_bool_tag() {
      true => match root_type == text_type_class_bool_tag() {
        true => text_type_class_bool_tag(),
        false => text_type_class_unknown_tag(),
      },
      false => text_type_class_unknown_tag(),
    },
  }
}

fn text_match_literal_result_scan_fail(
  scan: TextMatchLiteralResultScan
) -> TextMatchLiteralResultScan {
  TextMatchLiteralResultScan {
    index: scan.close_index,
    close_index: scan.close_index,
    result_type: text_type_class_unknown_tag(),
    arm_count: scan.arm_count,
    failed: true,
  }
}

fn text_match_literal_result_next_index(
  close_index: i32,
  comma: i32
) -> i32 {
  match comma < close_index {
    true => comma + 1,
    false => close_index,
  }
}

fn text_match_literal_result_scan_accept(
  scan: TextMatchLiteralResultScan,
  value_type: i32,
  next_index: i32
) -> TextMatchLiteralResultScan {
  match value_type == text_type_class_unknown_tag() {
    true => text_match_literal_result_scan_fail(scan),
    false => match scan.arm_count == 0 {
      true => TextMatchLiteralResultScan {
        index: next_index,
        close_index: scan.close_index,
        result_type: value_type,
        arm_count: 1,
        failed: false,
      },
      false => match scan.result_type == value_type {
        true => TextMatchLiteralResultScan {
          index: next_index,
          close_index: scan.close_index,
          result_type: scan.result_type,
          arm_count: scan.arm_count + 1,
          failed: false,
        },
        false => text_match_literal_result_scan_fail(scan),
      },
    },
  }
}

fn text_match_literal_result_scan_step(
  source: textlex.TextTokenStream,
  scan: TextMatchLiteralResultScan
) -> TextMatchLiteralResultScan {
  let arm_start = text_expression_start_skip_trivia(
    source,
    scan.index,
    scan.close_index
  );
  match arm_start >= scan.close_index {
    true => TextMatchLiteralResultScan {
      index: scan.close_index,
      close_index: scan.close_index,
      result_type: scan.result_type,
      arm_count: scan.arm_count,
      failed: scan.failed,
    },
    false => text_bool_match_top_level_arrow(
      source,
      TextBoolMatchTokenScan {
        index: arm_start,
        limit: scan.close_index,
        paren_depth: 0,
        brace_depth: 0,
        bracket_depth: 0,
      }
    ) \arrow -> match arrow >= scan.close_index {
      true => text_match_literal_result_scan_fail(scan),
      false => text_match_arm_guard_start_between(
        source,
        arm_start,
        arrow
      ) \guard_start -> match guard_start < arrow {
        true => text_match_literal_result_scan_fail(scan),
        false => text_bool_match_top_level_comma(
          source,
          TextBoolMatchTokenScan {
            index: arrow + 2,
            limit: scan.close_index,
            paren_depth: 0,
            brace_depth: 0,
            bracket_depth: 0,
          }
        ) \comma -> text_expression_start_skip_trivia(
          source,
          arrow + 2,
          comma
        ) \value_start -> text_match_literal_result_scan_accept(
          scan,
          text_match_arm_literal_result_type_class_between(
            source,
            value_start,
            comma
          ),
          text_match_literal_result_next_index(scan.close_index, comma)
        ),
      },
    },
  }
}

fn text_match_literal_result_scan_loop(
  source: textlex.TextTokenStream,
  scan: TextMatchLiteralResultScan
) -> TextMatchLiteralResultScan {
  match scan.failed {
    true => scan,
    false => match scan.index >= scan.close_index {
      true => scan,
      false => rec(source, text_match_literal_result_scan_step(source, scan)),
    },
  }
}

fn text_match_literal_result_scan_type_class(
  scan: TextMatchLiteralResultScan
) -> i32 {
  match scan.failed {
    true => text_type_class_unknown_tag(),
    false => match scan.arm_count == 0 {
      true => text_type_class_unknown_tag(),
      false => scan.result_type,
    },
  }
}

fn text_match_body_literal_result_type_class_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> i32 {
  let open_index = text_root_match_body_open_between(source, start, limit);
  match open_index < limit {
    false => text_type_class_unknown_tag(),
    true => find_text_right_brace(
      source,
      open_index + 1,
      limit,
      0
    ) \close_index -> match close_index < limit {
      false => text_type_class_unknown_tag(),
      true => text_match_literal_result_scan_type_class(
        text_match_literal_result_scan_loop(
          source,
          TextMatchLiteralResultScan {
            index: open_index + 1,
            close_index: close_index,
            result_type: text_type_class_unknown_tag(),
            arm_count: 0,
            failed: false,
          }
        )
      ),
    },
  }
}

fn text_bool_match_after_second_arm_clean(
  source: textlex.TextTokenStream,
  index: i32,
  close_index: i32
) -> bool {
  let next = text_expression_start_skip_trivia(source, index, close_index);
  next >= close_index
}

fn text_bool_match_segments_from_arms(
  source: textlex.TextTokenStream,
  condition_start: i32,
  condition_limit: i32,
  close_index: i32,
  first: TextBoolMatchArmSegment,
  second: TextBoolMatchArmSegment
) -> TextBoolBranchSegments {
  let first_is_true = first.pattern_hash == text_bool_literal_true_hash();
  let first_is_false = first.pattern_hash == text_bool_literal_false_hash();
  let second_is_true = second.pattern_hash == text_bool_literal_true_hash();
  let second_is_false = second.pattern_hash == text_bool_literal_false_hash();
  let ordered = match first_is_true {
    true => second_is_false,
    false => match first_is_false {
      true => second_is_true,
      false => false,
    },
  };
  match ordered {
    false => text_bool_branch_segments_missing(close_index),
    true => match text_bool_match_after_second_arm_clean(
      source,
      second.next_index,
      close_index
    ) {
      false => text_bool_branch_segments_missing(close_index),
      true => match first_is_true {
        true => text_bool_branch_segments_present(
          condition_start,
          condition_limit,
          first.value_start,
          first.value_limit,
          second.value_start,
          second.value_limit
        ),
        false => text_bool_branch_segments_present(
          condition_start,
          condition_limit,
          second.value_start,
          second.value_limit,
          first.value_start,
          first.value_limit
        ),
      },
    },
  }
}

fn text_bool_match_segments_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> TextBoolBranchSegments {
  let open_index = text_root_match_body_open_between(source, start, limit);
  match open_index < limit {
    false => text_bool_branch_segments_missing(limit),
    true => find_text_right_brace(source, open_index + 1, limit, 0) \close_index -> match close_index < limit {
      false => text_bool_branch_segments_missing(limit),
      true => text_expression_start_skip_trivia(
        source,
        start + 1,
        open_index
      ) \condition_start -> match condition_start < open_index {
        false => text_bool_branch_segments_missing(limit),
        true => text_bool_match_arm_segment_between(
          source,
          open_index + 1,
          close_index
        ) \first -> match first.found {
          false => text_bool_branch_segments_missing(limit),
          true => text_bool_match_arm_segment_between(
            source,
            first.next_index,
            close_index
          ) \second -> match second.found {
            false => text_bool_branch_segments_missing(limit),
            true => text_bool_match_segments_from_arms(
              source,
              condition_start,
              open_index,
              close_index,
              first,
              second
            ),
          },
        },
      },
    },
  }
}

fn text_function_bool_match_body_segments(
  source: textlex.TextTokenStream,
  index: i32
) -> TextBoolBranchSegments {
  let runtime_count = text_function_runtime_param_count(source, index);
  let param_type = text_function_first_runtime_param_type_class(source, index);
  let start = text_function_body_value_start_index(source, index);
  let limit = text_function_body_value_limit_index(source, index);
  let open_index = text_root_match_body_open_between(source, start, limit);
  match runtime_count == 1 {
    false => text_bool_branch_segments_missing(limit),
    true => match param_type == text_type_class_bool_tag() {
      false => text_bool_branch_segments_missing(limit),
      true => match open_index < limit {
        false => text_bool_branch_segments_missing(limit),
        true => find_text_right_brace(
          source,
          open_index + 1,
          limit,
          0
        ) \close_index -> match close_index < limit {
          false => text_bool_branch_segments_missing(limit),
          true => text_bool_match_arm_segment_between(
            source,
            open_index + 1,
            close_index
          ) \first -> match first.found {
            false => text_bool_branch_segments_missing(limit),
            true => text_bool_match_arm_segment_between(
              source,
              first.next_index,
              close_index
            ) \second -> match second.found {
              false => text_bool_branch_segments_missing(limit),
              true => text_bool_match_segments_from_arms(
                source,
                start,
                open_index,
                close_index,
                first,
                second
              ),
            },
          },
        },
      },
    },
  }
}

fn text_bool_if_segments_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> TextBoolBranchSegments {
  let blocks = text_if_child_blocks_between(source, start, limit);
  match blocks.false_close < limit {
    false => text_bool_branch_segments_missing(limit),
    true => text_bool_branch_segments_present(
      blocks.condition_start,
      blocks.condition_limit,
      blocks.true_value_start,
      blocks.true_close,
      blocks.false_value_start,
      blocks.false_close
    ),
  }
}

fn text_bool_branch_segments_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> TextBoolBranchSegments {
  let value_start = text_expression_start_skip_trivia(source, start, limit);
  match value_start >= limit {
    true => text_bool_branch_segments_missing(limit),
    false => match textlex.token_at(source, value_start).kind {
      IfKw => text_bool_if_segments_between(source, value_start, limit),
      MatchKw => text_bool_match_segments_between(source, value_start, limit),
      _ => text_bool_branch_segments_missing(limit),
    },
  }
}

fn text_parenthesized_expression_segment_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> TextArgumentSegment {
  let value_start = text_expression_start_skip_trivia(source, start, limit);
  match value_start >= limit {
    true => text_argument_segment_none(limit),
    false => match textlex.punctuation_at(source, value_start) {
      PunctLeftParen => find_text_matching_right_paren(
        source,
        value_start + 1,
        limit,
        0
      ) \close_index -> match close_index < limit {
        false => text_argument_segment_none(limit),
        true => match text_expression_start_skip_trivia(
          source,
          close_index + 1,
          limit
        ) >= limit {
          false => text_argument_segment_none(limit),
          true => text_argument_segment_present(
            source,
            value_start + 1,
            close_index
          ),
        },
      },
      _ => text_argument_segment_none(limit),
    },
  }
}

fn text_if_else_index_after_true_close(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let next = text_expression_start_skip_trivia(source, index, limit);
  match next < limit {
    false => limit,
    true => match textlex.token_at(source, next).kind {
      ElseKw => next,
      _ => limit,
    },
  }
}

fn text_if_true_block_open_after_start(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  paren_depth: i32,
  brace_depth: i32,
  bracket_depth: i32
) -> i32 {
  match index >= limit {
    true => limit,
    false => text_depth_is_top_level(brace_depth, paren_depth) \top_level -> match top_level {
      true => match bracket_depth == 0 {
        true => match textlex.punctuation_at(source, index) {
          PunctLeftBrace => find_text_right_brace(
            source,
            index + 1,
            limit,
            0
          ) \close_index -> match close_index < limit {
            true => match text_if_else_index_after_true_close(
              source,
              close_index + 1,
              limit
            ) < limit {
              true => index,
              false => text_if_true_block_open_after_start(
                source,
                close_index + 1,
                limit,
                paren_depth,
                brace_depth,
                bracket_depth
              ),
            },
            false => limit,
          },
          _ => text_if_true_block_open_after_start(
            source,
            index + 1,
            limit,
            paren_depth_after_token(source, index, paren_depth),
            brace_depth_after_token(source, index, brace_depth),
            text_argument_scan_bracket_delta(source, index, bracket_depth)
          ),
        },
        false => text_if_true_block_open_after_start(
          source,
          index + 1,
          limit,
          paren_depth_after_token(source, index, paren_depth),
          brace_depth_after_token(source, index, brace_depth),
          text_argument_scan_bracket_delta(source, index, bracket_depth)
        ),
      },
      false => text_if_true_block_open_after_start(
        source,
        index + 1,
        limit,
        paren_depth_after_token(source, index, paren_depth),
        brace_depth_after_token(source, index, brace_depth),
        text_argument_scan_bracket_delta(source, index, bracket_depth)
      ),
    },
  }
}

fn text_if_false_block_open_after_else(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  paren_depth: i32,
  brace_depth: i32,
  bracket_depth: i32
) -> i32 {
  match index >= limit {
    true => limit,
    false => text_depth_is_top_level(brace_depth, paren_depth) \top_level -> match top_level {
      true => match bracket_depth == 0 {
        true => match textlex.punctuation_at(source, index) {
          PunctLeftBrace => index,
          _ => text_if_false_block_open_after_else(
            source,
            index + 1,
            limit,
            paren_depth_after_token(source, index, paren_depth),
            brace_depth_after_token(source, index, brace_depth),
            text_argument_scan_bracket_delta(source, index, bracket_depth)
          ),
        },
        false => text_if_false_block_open_after_else(
          source,
          index + 1,
          limit,
          paren_depth_after_token(source, index, paren_depth),
          brace_depth_after_token(source, index, brace_depth),
          text_argument_scan_bracket_delta(source, index, bracket_depth)
        ),
      },
      false => text_if_false_block_open_after_else(
        source,
        index + 1,
        limit,
        paren_depth_after_token(source, index, paren_depth),
        brace_depth_after_token(source, index, brace_depth),
        text_argument_scan_bracket_delta(source, index, bracket_depth)
      ),
    },
  }
}

fn text_if_block_value_start(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32
) -> i32 {
  text_block_final_expression_start_between(
    source,
    text_block_final_expression_scan(
      open_index + 1,
      close_index,
      0,
      0,
      open_index + 1
    )
  )
}

fn text_if_child_blocks_missing(limit: i32) -> TextIfChildBlocks {
  TextIfChildBlocks {
    condition_start: limit,
    condition_limit: limit,
    true_value_start: limit,
    true_close: limit,
    false_value_start: limit,
    false_close: limit,
  }
}

fn text_if_child_blocks_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> TextIfChildBlocks {
  let true_open = text_if_true_block_open_after_start(
    source,
    start + 1,
    limit,
    0,
    0,
    0
  );
  match true_open < limit {
    false => text_if_child_blocks_missing(limit),
    true => find_text_right_brace(source, true_open + 1, limit, 0) \true_close -> match true_close < limit {
      false => text_if_child_blocks_missing(limit),
      true => text_if_else_index_after_true_close(
        source,
        true_close + 1,
        limit
      ) \else_index -> match else_index < limit {
        false => text_if_child_blocks_missing(limit),
        true => text_if_false_block_open_after_else(
          source,
          else_index + 1,
          limit,
          0,
          0,
          0
        ) \false_open -> match false_open < limit {
          false => text_if_child_blocks_missing(limit),
          true => find_text_right_brace(source, false_open + 1, limit, 0) \false_close -> match false_close < limit {
            false => text_if_child_blocks_missing(limit),
            true => TextIfChildBlocks {
              condition_start: text_expression_start_skip_trivia(
                source,
                start + 1,
                true_open
              ),
              condition_limit: true_open,
              true_value_start: text_if_block_value_start(
                source,
                true_open,
                true_close
              ),
              true_close: true_close,
              false_value_start: text_if_block_value_start(
                source,
                false_open,
                false_close
              ),
              false_close: false_close,
            },
          },
        },
      },
    },
  }
}

fn text_root_if_child_count_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> i32 {
  let blocks = text_if_child_blocks_between(source, start, limit);
  match blocks.false_close < limit {
    true => 3,
    false => 0,
  }
}

fn text_root_if_child_signature_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  total: i32
) -> i32 {
  let blocks = text_if_child_blocks_between(source, start, limit);
  match blocks.false_close < limit {
    false => total,
    true => match blocks.condition_start < blocks.condition_limit {
        true => text_child_value_segment_signature(
          source,
          blocks.condition_start,
          blocks.condition_limit,
          total
        ),
        false => total,
      } \with_condition -> text_child_value_segment_signature(
        source,
        blocks.true_value_start,
        blocks.true_close,
        with_condition
      ) \with_true -> text_child_value_segment_signature(
        source,
        blocks.false_value_start,
        blocks.false_close,
        with_true
      ),
  }
}

fn text_root_if_grandchild_count_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> i32 {
  let blocks = text_if_child_blocks_between(source, start, limit);
  match blocks.false_close < limit {
    false => 0,
    true => match blocks.condition_start < blocks.condition_limit {
        true => text_expression_root_child_count_between(
          source,
          blocks.condition_start,
          blocks.condition_limit
        ),
        false => 0,
      } \condition_count -> condition_count
        + text_expression_root_child_count_between(
          source,
          blocks.true_value_start,
          blocks.true_close
        )
        + text_expression_root_child_count_between(
          source,
          blocks.false_value_start,
          blocks.false_close
        ),
  }
}

fn text_root_if_grandchild_signature_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  total: i32
) -> i32 {
  let blocks = text_if_child_blocks_between(source, start, limit);
  match blocks.false_close < limit {
    false => total,
    true => match blocks.condition_start < blocks.condition_limit {
        true => text_expression_root_child_signature_between(
          source,
          blocks.condition_start,
          blocks.condition_limit,
          total
        ),
        false => total,
      } \with_condition -> text_expression_root_child_signature_between(
        source,
        blocks.true_value_start,
        blocks.true_close,
        with_condition
      ) \with_true -> text_expression_root_child_signature_between(
        source,
        blocks.false_value_start,
        blocks.false_close,
        with_true
      ),
  }
}

fn text_root_if_descendant_count_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> i32 {
  let blocks = text_if_child_blocks_between(source, start, limit);
  match blocks.false_close < limit {
    false => 0,
    true => match blocks.condition_start < blocks.condition_limit {
        true => 1
          + text_expression_root_descendant_count_between(
            source,
            blocks.condition_start,
            blocks.condition_limit
          ),
        false => 0,
      } \condition_count -> condition_count
        + 2
        + text_expression_root_descendant_count_between(
          source,
          blocks.true_value_start,
          blocks.true_close
        )
        + text_expression_root_descendant_count_between(
          source,
          blocks.false_value_start,
          blocks.false_close
        ),
  }
}

fn text_root_if_descendant_signature_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  total: i32
) -> i32 {
  let blocks = text_if_child_blocks_between(source, start, limit);
  match blocks.false_close < limit {
    false => total,
    true => match blocks.condition_start < blocks.condition_limit {
        true => text_expression_root_descendant_signature_between(
          source,
          blocks.condition_start,
          blocks.condition_limit,
          text_child_value_segment_signature(
            source,
            blocks.condition_start,
            blocks.condition_limit,
            total
          )
        ),
        false => total,
      } \with_condition -> text_expression_root_descendant_signature_between(
        source,
        blocks.true_value_start,
        blocks.true_close,
        text_child_value_segment_signature(
          source,
          blocks.true_value_start,
          blocks.true_close,
          with_condition
        )
      ) \with_true -> text_expression_root_descendant_signature_between(
        source,
        blocks.false_value_start,
        blocks.false_close,
        text_child_value_segment_signature(
          source,
          blocks.false_value_start,
          blocks.false_close,
          with_true
        )
      ),
  }
}

fn text_root_if_child_record_state_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  parent_kind_tag: i32,
  parent_name_hash: i32,
  child_index: i32,
  total: i32
) -> TextRootChildRecordState {
  let blocks = text_if_child_blocks_between(source, start, limit);
  match blocks.false_close < limit {
    false => TextRootChildRecordState {
      child_index: child_index,
      total: total,
    },
    true => match blocks.condition_start < blocks.condition_limit {
      true => text_root_child_record_value_fact_signature(
        source,
        blocks.condition_start,
        blocks.condition_limit,
        parent_kind_tag,
        parent_name_hash,
        child_index,
        text_root_child_match_scrutinee_role_tag(),
        0
      ) \condition_fact -> text_expression_root_child_record_signature_between_state(
        source,
        blocks.condition_start,
        blocks.condition_limit,
        parent_kind_tag,
        parent_name_hash,
        child_index + 1,
        textmodel.signature_mix(total, condition_fact)
      ),
      false => TextRootChildRecordState {
        child_index: child_index,
        total: total,
      },
    } \after_condition -> text_root_child_record_value_fact_signature(
      source,
      blocks.true_value_start,
      blocks.true_close,
      parent_kind_tag,
      parent_name_hash,
      after_condition.child_index,
      text_root_child_match_arm_role_tag(),
      0
    ) \true_fact -> text_expression_root_child_record_signature_between_state(
      source,
      blocks.true_value_start,
      blocks.true_close,
      parent_kind_tag,
      parent_name_hash,
      after_condition.child_index + 1,
      textmodel.signature_mix(after_condition.total, true_fact)
    ) \after_true -> text_root_child_record_value_fact_signature(
      source,
      blocks.false_value_start,
      blocks.false_close,
      parent_kind_tag,
      parent_name_hash,
      after_true.child_index,
      text_root_child_match_arm_role_tag(),
      0
    ) \false_fact -> text_expression_root_child_record_signature_between_state(
      source,
      blocks.false_value_start,
      blocks.false_close,
      parent_kind_tag,
      parent_name_hash,
      after_true.child_index + 1,
      textmodel.signature_mix(after_true.total, false_fact)
    ),
  }
}

fn text_root_child_scan_finish_present(
  source: textlex.TextTokenStream,
  scan: TextRootChildScan,
  value_start: i32
) -> TextRootChildScan {
  let child_count = text_expression_root_child_count_between(
    source,
    value_start,
    scan.index
  );
  let child_signature = text_expression_root_child_signature_between(
    source,
    value_start,
    scan.index,
    scan.total_grandchild_signature
  );
  let descendant_count = text_expression_root_descendant_count_between(
    source,
    value_start,
    scan.index
  );
  let with_descendant_child = text_root_child_segment_signature(
    source,
    scan.segment_start,
    scan.index,
    scan.total_descendant_signature
  );
  let descendant_signature = text_expression_root_descendant_signature_between(
    source,
    value_start,
    scan.index,
    with_descendant_child
  );
  TextRootChildScan {
    index: scan.index,
    close_index: scan.close_index,
    segment_start: scan.segment_start,
    paren_depth: scan.paren_depth,
    brace_depth: scan.brace_depth,
    bracket_depth: scan.bracket_depth,
    total_count: scan.total_count + 1,
    total_signature: text_root_child_segment_signature(
      source,
      scan.segment_start,
      scan.index,
      scan.total_signature
    ),
    total_grandchild_count: scan.total_grandchild_count + child_count,
    total_grandchild_signature: child_signature,
    total_descendant_count: scan.total_descendant_count + 1 + descendant_count,
    total_descendant_signature: descendant_signature,
    segment_saw_argument: false,
  }
}

fn text_root_child_scan_finish_segment(
  source: textlex.TextTokenStream,
  scan: TextRootChildScan
) -> TextRootChildScan {
  match scan.segment_saw_argument {
    true => text_root_child_scan_finish_present(
      source,
      scan,
      text_root_child_segment_value_start(
        source,
        scan.segment_start,
        scan.index
      )
    ),
    false => scan,
  }
}

fn text_root_child_scan_step(
  source: textlex.TextTokenStream,
  scan: TextRootChildScan
) -> TextRootChildScan {
  let punctuation = textlex.punctuation_at(source, scan.index);
  let top_level = text_root_child_scan_is_top_level(scan);
  let is_separator = match punctuation {
    PunctComma => top_level,
    _ => false,
  };
  let is_argument_token = match is_separator {
    true => false,
    false => match text_param_signature_is_trivia(source, scan.index) {
      true => false,
      false => true,
    },
  };
  let finished = match is_separator {
    true => text_root_child_scan_finish_segment(source, scan),
    false => scan,
  };
  TextRootChildScan {
    index: scan.index + 1,
    close_index: scan.close_index,
    segment_start: match is_separator {
      true => scan.index + 1,
      false => finished.segment_start,
    },
    paren_depth: text_argument_scan_next_paren_depth(
      punctuation,
      scan.paren_depth
    ),
    brace_depth: text_argument_scan_next_brace_depth(
      punctuation,
      scan.brace_depth
    ),
    bracket_depth: text_argument_scan_bracket_delta(
      source,
      scan.index,
      scan.bracket_depth
    ),
    total_count: finished.total_count,
    total_signature: finished.total_signature,
    total_grandchild_count: finished.total_grandchild_count,
    total_grandchild_signature: finished.total_grandchild_signature,
    total_descendant_count: finished.total_descendant_count,
    total_descendant_signature: finished.total_descendant_signature,
    segment_saw_argument: match is_separator {
      true => false,
      false => match is_argument_token {
        true => true,
        false => scan.segment_saw_argument,
      },
    },
  }
}

fn text_root_child_scan_loop(
  source: textlex.TextTokenStream,
  scan: TextRootChildScan
) -> TextRootChildScan {
  match scan.index >= scan.close_index {
    true => text_root_child_scan_finish_segment(source, scan),
    false => text_root_child_scan_loop(
      source,
      text_root_child_scan_step(source, scan)
    ),
  }
}

fn text_root_child_scan(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32,
  total_signature: i32,
  total_grandchild_signature: i32,
  total_descendant_signature: i32
) -> TextRootChildScan {
  text_root_child_scan_loop(
    source,
    TextRootChildScan {
      index: open_index + 1,
      close_index: close_index,
      segment_start: open_index + 1,
      paren_depth: 0,
      brace_depth: 0,
      bracket_depth: 0,
      total_count: 0,
      total_signature: total_signature,
      total_grandchild_count: 0,
      total_grandchild_signature: total_grandchild_signature,
      total_descendant_count: 0,
      total_descendant_signature: total_descendant_signature,
      segment_saw_argument: false,
    }
  )
}

fn text_root_child_scan_between(
  source: textlex.TextTokenStream,
  index: i32,
  close_index: i32,
  total_signature: i32,
  total_grandchild_signature: i32,
  total_descendant_signature: i32
) -> TextRootChildScan {
  text_root_child_scan_loop(
    source,
    TextRootChildScan {
      index: index,
      close_index: close_index,
      segment_start: index,
      paren_depth: 0,
      brace_depth: 0,
      bracket_depth: 0,
      total_count: 0,
      total_signature: total_signature,
      total_grandchild_count: 0,
      total_grandchild_signature: total_grandchild_signature,
      total_descendant_count: 0,
      total_descendant_signature: total_descendant_signature,
      segment_saw_argument: false,
    }
  )
}

fn text_root_child_count_between_segments(
  source: textlex.TextTokenStream,
  index: i32,
  close_index: i32
) -> i32 {
  text_root_child_scan_between(source, index, close_index, 0, 0, 0).total_count
}

fn text_root_child_signature_between_segments(
  source: textlex.TextTokenStream,
  index: i32,
  close_index: i32,
  total: i32
) -> i32 {
  text_root_child_scan_between(source, index, close_index, total, 0, 0).total_signature
}

fn text_root_grandchild_count_between_segments(
  source: textlex.TextTokenStream,
  index: i32,
  close_index: i32
) -> i32 {
  text_root_child_scan_between(
    source,
    index,
    close_index,
    0,
    0,
    0
  ).total_grandchild_count
}

fn text_root_grandchild_signature_between_segments(
  source: textlex.TextTokenStream,
  index: i32,
  close_index: i32,
  total: i32
) -> i32 {
  text_root_child_scan_between(
    source,
    index,
    close_index,
