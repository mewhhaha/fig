fn parse_text_declaration_start(
  start: TextDeclarationStart,
  current: combinator.ParseState,
  source: textlex.TextTokenStream,
  seed: i32
) -> combinator.Parser(DeclFrame) {
  match start {
    TextSourceImportDeclaration => parse_text_source_import_tail(current, source, seed),
    TextExternalImportDeclaration => parse_text_external_import_tail(current, source),
    TextPubFunctionDeclaration => parse_text_pub_function_tail(current, source, seed),
    TextOperatorDeclaration => parse_text_operator_tail(current, source),
    TextTypeAssertDeclaration => parse_text_type_assert_tail(current, source),
    TextRegularDeclaration(kind) => parse_text_declaration_for_kind(
      kind,
      current,
      source,
      seed
    ),
    TextNoDeclaration => parse_text_no_declaration(current, source),
  }
}

fn parse_text_declaration_stream(
  current: combinator.ParseState,
  source: textlex.TextTokenStream,
  seed: i32
) -> combinator.Parser(DeclFrame) {
  parse_text_declaration_start(
    text_declaration_start(source, current.cursor),
    current,
    source,
    seed
  )
}

fn complete_text_program(
  module_name: ast.SymbolId,
  source: textlex.TextTokenStream,
  first: combinator.Reply(DeclFrame),
  fourth: combinator.Parser(DeclFrame)
) -> combinator.Parser(ProgramFrame) match {
  module_name, source, first, Ok(second) => ok_program(
    second.state,
    program_frame(
      ast.program(
        module_name,
        2,
        first.value.decl,
        second.value.decl,
        textlex.source_span(source)
      ),
      diagnostic.empty(),
      first.value.consumed + second.value.consumed
    )
  ),
  module_name, source, first, Err(error) => ok_program(
    first.state,
    program_frame(
      ast.program(
        module_name,
        1,
        first.value.decl,
        ast.empty_decl(),
        textlex.source_span(source)
      ),
      diagnostic.push(
        diagnostic.empty(),
        diagnostic.from_parse_error(error)
      ),
      first.value.consumed
    )
  ),
}

fn text_program_from_first(
  module_name: ast.SymbolId,
  source: textlex.TextTokenStream,
  seed: i32,
  fourth: combinator.Parser(DeclFrame)
) -> combinator.Parser(ProgramFrame) match {
  module_name, source, seed, Ok(first) => match is_text_declaration_start(source, first.state.cursor) {
    true => complete_text_program(
      module_name,
      source,
      first,
      parse_text_declaration_stream(
        first.state,
        source,
        seed + 1
      )
    ),
    false => ok_program(
      first.state,
      program_frame(
        ast.program(
          module_name,
          1,
          first.value.decl,
          ast.empty_decl(),
          textlex.source_span(source)
        ),
        diagnostic.empty(),
        first.value.consumed
      )
    ),
  },
  _module_name, _source, _seed, Err(error) => err_program(error),
}

fn parse_text_program(
  current: combinator.ParseState,
  source: textlex.TextTokenStream,
  module_name: ast.SymbolId,
  seed: i32
) -> combinator.Parser(ProgramFrame) {
  text_program_from_first(
    module_name,
    source,
    seed,
    parse_text_declaration_stream(current, source, seed)
  )
}

fn frame_score(frame: DeclFrame) -> i32 {
  frame.consumed + ast.decl_score(frame.decl)
}

fn program_frame_score(frame: ProgramFrame) -> i32 {
  frame.consumed
    + ast.program_score(frame.program)
    + diagnostic.bag_score(frame.diagnostics)
}

fn expr_frame_score(frame: ExprFrame) -> i32 {
  frame.consumed + ast.expr_score(frame.expr)
}

fn parsed_frame_score(value: combinator.Parser(DeclFrame)) -> i32 match {
  Ok(result) => result.state.cursor + frame_score(result.value),
  Err(error) => combinator.error_score(error),
}

fn parsed_decl_or_fallback(
  value: combinator.Parser(DeclFrame),
  _fallback: ast.Decl
) -> ast.Decl match {
  Ok(result), _fallback => result.value.decl,
  Err(_), fallback => fallback,
}

fn parsed_expr_score(value: combinator.Parser(ExprFrame)) -> i32 match {
  Ok(result) => result.state.cursor + expr_frame_score(result.value),
  Err(error) => combinator.error_score(error),
}

fn parsed_program_score(value: combinator.Parser(ProgramFrame)) -> i32 match {
  Ok(result) => result.state.cursor + program_frame_score(result.value),
  Err(error) => combinator.error_score(error),
}

fn parsed_program_or_fallback(
  value: combinator.Parser(ProgramFrame),
  _fallback: ast.Program
) -> ast.Program match {
  Ok(result), _fallback => result.value.program,
  Err(_), fallback => fallback,
}

fn parsed_diagnostic_score(value: combinator.Parser(DeclFrame)) -> i32 match {
  Ok(_) => diagnostic.bag_score(diagnostic.empty()),
  Err(error) => diagnostic.bag_score(diagnostic.push(
    diagnostic.empty(),
    diagnostic.from_parse_error(error)
  )),
}

fn entry(seed: i32) -> i32 {
  let source = stream.from_seed(seed);
  let text = textlex.stream_from_buffer(textlex.from_seed(seed));
  let function_text = textlex.stream_from_buffer(
    textlex.function_from_seed(seed + 1)
  );
  let multi_function_text = textlex.stream_from_buffer(
    textlex.multi_function_from_seed(seed + 2)
  );
  let zero_function_text = textlex.stream_from_buffer(
    textlex.zero_function_from_seed(seed + 3)
  );
  let three_function_text = textlex.stream_from_buffer(
    textlex.three_function_from_seed(seed + 4)
  );
  let pub_function_text = textlex.stream_from_buffer(
    textlex.pub_function_from_seed(seed + 5)
  );
  let parsed = parse_declaration_stream(
    combinator.state(0, stream.length(source)),
    source,
    seed
  );
  let text_parsed = parse_text_declaration_stream(
    combinator.state(0, textlex.length(text)),
    text,
    seed + 2
  );
  let text_program = parse_text_program(
    combinator.state(0, textlex.length(text)),
    text,
    seed,
    seed + 3
  );
  let function_parsed = parse_text_declaration_stream(
    combinator.state(0, textlex.length(function_text)),
    function_text,
    seed + 4
  );
  let function_program = parse_text_program(
    combinator.state(0, textlex.length(function_text)),
    function_text,
    seed,
    seed + 5
  );
  let multi_function_parsed = parse_text_declaration_stream(
    combinator.state(0, textlex.length(multi_function_text)),
    multi_function_text,
    seed + 6
  );
  let multi_function_program = parse_text_program(
    combinator.state(0, textlex.length(multi_function_text)),
    multi_function_text,
    seed,
    seed + 7
  );
  let zero_function_parsed = parse_text_declaration_stream(
    combinator.state(0, textlex.length(zero_function_text)),
    zero_function_text,
    seed + 8
  );
  let zero_function_program = parse_text_program(
    combinator.state(0, textlex.length(zero_function_text)),
    zero_function_text,
    seed,
    seed + 9
  );
  let three_function_parsed = parse_text_declaration_stream(
    combinator.state(0, textlex.length(three_function_text)),
    three_function_text,
    seed + 10
  );
  let three_function_program = parse_text_program(
    combinator.state(0, textlex.length(three_function_text)),
    three_function_text,
    seed,
    seed + 11
  );
  let pub_function_parsed = parse_text_declaration_stream(
    combinator.state(0, textlex.length(pub_function_text)),
    pub_function_text,
    seed + 12
  );
  let pub_function_program = parse_text_program(
    combinator.state(0, textlex.length(pub_function_text)),
    pub_function_text,
    seed,
    seed + 13
  );
  parsed_frame_score(parsed)
    + parsed_diagnostic_score(parsed)
    + parsed_frame_score(text_parsed)
    + parsed_diagnostic_score(text_parsed)
    + parsed_program_score(text_program)
    + parsed_frame_score(function_parsed)
    + parsed_diagnostic_score(function_parsed)
    + parsed_program_score(function_program)
    + parsed_frame_score(multi_function_parsed)
    + parsed_diagnostic_score(multi_function_parsed)
    + parsed_program_score(multi_function_program)
    + parsed_frame_score(zero_function_parsed)
    + parsed_diagnostic_score(zero_function_parsed)
    + parsed_program_score(zero_function_program)
    + parsed_frame_score(three_function_parsed)
    + parsed_diagnostic_score(three_function_parsed)
    + parsed_program_score(three_function_program)
    + parsed_frame_score(pub_function_parsed)
    + parsed_diagnostic_score(pub_function_parsed)
    + parsed_program_score(pub_function_program)
    + parsed_expr_score(parse_expression(
    combinator.state(2, stream.length(source)),
    source,
    seed + 1
  ))
}
