}

fn text_function_attached_signature_fact(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  let arrow = text_function_arrow_index(source, close_paren, next);
  let left_brace = text_function_left_brace_index(source, arrow, next);
  let body_start = text_function_body_start_index(source, arrow, left_brace);
  let owner_hash = text_function_attached_owner_hash(source, index);
  let member_hash = textlex.text_hash_at(
    source,
    text_function_attached_member_index(source, index)
  );
  let return_hash = text_annotation_signature_hash_between(
    source,
    arrow + 1,
    body_start,
    0
  );
  text_function_attached_signature_seed()
    \total -> text_signature_mix(total, text_function_public_tag(source, index))
    \total -> text_signature_mix(total, owner_hash)
    \total -> text_signature_mix(total, member_hash)
    \total -> text_signature_mix(
      total,
      count_text_signature_params(source, open_paren, close_paren)
    )
    \total -> text_signature_mix(total, return_hash)
}

fn text_function_attached_signature_hash(
  source: textlex.TextTokenStream,
