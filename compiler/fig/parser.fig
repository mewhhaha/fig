      TextResolutionEnv::declaration_resolved_value_body_type_class_tag(
        env,
        source,
        index,
        decl
      ) \type_class -> text_signature_mix(
        total,
        text_value_body_abi_class_hash(
          kind_tag,
          text_abi_class_tag_for_type_class(type_class)
