  ).total_descendant_signature
}

fn text_expression_root_pipe_child_record_state(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  pipe_index: i32,
  parent_kind_tag: i32,
  parent_name_hash: i32,
  child_index: i32,
  total: i32
) -> TextRootChildRecordState {
  let left = text_expression_root_child_record_signature_between_state(
    source,
    start,
    pipe_index,
    parent_kind_tag,
    parent_name_hash,
    child_index,
    total
  );
  let body_start = text_pipe_bind_body_start_index(source, pipe_index, limit);
  match body_start < limit {
    false => left,
    true => text_root_child_record_fact_signature(
      source,
      body_start,
      limit,
      parent_kind_tag,
      parent_name_hash,
      left.child_index,
      text_root_child_pipe_body_role_tag()
    ) \fact_signature -> text_expression_root_child_record_signature_between_state(
      source,
      body_start,
      limit,
      parent_kind_tag,
      parent_name_hash,
      left.child_index + 1,
      textmodel.signature_mix(left.total, fact_signature)
    ),
  }
}

fn text_root_child_scan_empty(
  source: textlex.TextTokenStream,
  index: i32,
  total_signature: i32,
  total_grandchild_signature: i32,
  total_descendant_signature: i32
) -> TextRootChildScan {
  text_root_child_scan_between(
    source,
    index,
    index,
    total_signature,
    total_grandchild_signature,
    total_descendant_signature
  )
}

fn text_root_child_scan_with_appended_value(
  scan: TextRootChildScan,
  value_signature: i32,
  value_child_scan: TextRootChildScan
) -> TextRootChildScan {
  TextRootChildScan {
    index: scan.index,
    close_index: scan.close_index,
    segment_start: scan.segment_start,
    paren_depth: scan.paren_depth,
    brace_depth: scan.brace_depth,
    bracket_depth: scan.bracket_depth,
    total_count: scan.total_count + 1,
    total_signature: value_signature,
    total_grandchild_count: scan.total_grandchild_count
      + value_child_scan.total_count,
    total_grandchild_signature: value_child_scan.total_signature,
    total_descendant_count: scan.total_descendant_count
      + 1
      + value_child_scan.total_descendant_count,
    total_descendant_signature: value_child_scan.total_descendant_signature,
    segment_saw_argument: false,
  }
}

fn text_root_child_scan_append_value(
  source: textlex.TextTokenStream,
  scan: TextRootChildScan,
  value_start: i32,
  value_limit: i32
) -> TextRootChildScan {
  let value_signature = text_child_value_segment_signature(
    source,
    value_start,
    value_limit,
    scan.total_signature
  );
  let descendant_signature = text_child_value_segment_signature(
    source,
    value_start,
    value_limit,
    scan.total_descendant_signature
  );
  let value_child_scan = text_expression_root_child_scan_between(
    source,
    value_start,
    value_limit,
    scan.total_grandchild_signature,
    0,
    descendant_signature
  );
  text_root_child_scan_with_appended_value(
    scan,
    value_signature,
    value_child_scan
  )
}

fn text_root_child_scan_append_repeat_value(
  source: textlex.TextTokenStream,
  scan: TextRootChildScan,
  value_start: i32,
  value_limit: i32,
  remaining: i32
) -> TextRootChildScan {
  match remaining <= 0 {
    true => scan,
    false => rec(
      source,
      text_root_child_scan_append_value(source, scan, value_start, value_limit),
      value_start,
      value_limit,
      remaining - 1
    ),
  }
}

fn text_bracket_root_repeat_child_scan(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32,
  scan: TextRootChildScan
) -> TextRootChildScan {
  let semicolon = text_bracket_root_repeat_semicolon(
    source,
    open_index,
    close_index
  );
  match semicolon < close_index {
    false => scan,
    true => text_root_child_scan_append_repeat_value(
      source,
      scan,
      open_index + 1,
      semicolon,
      text_bracket_root_repeat_count(source, open_index, close_index)
    ),
  }
}

fn text_match_values_child_scan_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total_signature: i32,
  total_grandchild_signature: i32,
  total_descendant_signature: i32
) -> TextRootChildScan {
  let segments = text_match_values_segments_between(source, index, limit);
  match segments.count == 0 {
    true => text_root_child_scan_empty(
      source,
      limit,
      total_signature,
      total_grandchild_signature,
      total_descendant_signature
    ),
    false => match text_match_values_is_synthetic_shape(segments) {
      true => text_root_child_scan_between(
        source,
        segments.start,
        segments.limit,
        total_signature,
        total_grandchild_signature,
        total_descendant_signature
      ),
      false => text_expression_root_child_scan_between(
        source,
        segments.start,
        segments.limit,
        total_signature,
        total_grandchild_signature,
        total_descendant_signature
      ),
    },
  }
}

fn text_root_child_scan_append_match_values(
  source: textlex.TextTokenStream,
  scan: TextRootChildScan,
  value_start: i32,
  value_limit: i32
) -> TextRootChildScan {
  let value_signature = text_match_values_segment_signature(
    source,
    value_start,
    value_limit,
    scan.total_signature
  );
  let descendant_signature = text_match_values_segment_signature(
    source,
    value_start,
    value_limit,
    scan.total_descendant_signature
  );
  let value_child_scan = text_match_values_child_scan_between(
    source,
    value_start,
    value_limit,
    scan.total_grandchild_signature,
    0,
    descendant_signature
  );
  text_root_child_scan_with_appended_value(
    scan,
    value_signature,
    value_child_scan
  )
}

fn text_root_do_child_scan_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  total_signature: i32,
  total_grandchild_signature: i32,
  total_descendant_signature: i32
) -> TextRootDoChildScan {
  let open_index = text_root_do_open_after_start(source, start + 1, limit, 0);
  match open_index < limit {
    false => TextRootDoChildScan {
      index: limit,
      close_index: limit,
      segment_start: limit,
      paren_depth: 0,
      brace_depth: 0,
      bracket_depth: 0,
      total_count: 0,
      total_signature: total_signature,
      total_grandchild_count: 0,
      total_grandchild_signature: total_grandchild_signature,
      total_descendant_count: 0,
      total_descendant_signature: total_descendant_signature,
      segment_saw_argument: false,
    },
    true => find_text_right_brace(source, open_index + 1, limit, 0) \close_index -> match close_index < limit {
      true => text_root_do_child_scan(
        source,
        open_index,
        close_index,
        total_signature,
        total_grandchild_signature,
        total_descendant_signature
      ),
      false => TextRootDoChildScan {
        index: limit,
        close_index: limit,
        segment_start: limit,
        paren_depth: 0,
        brace_depth: 0,
        bracket_depth: 0,
        total_count: 0,
        total_signature: total_signature,
        total_grandchild_count: 0,
        total_grandchild_signature: total_grandchild_signature,
        total_descendant_count: 0,
        total_descendant_signature: total_descendant_signature,
        segment_saw_argument: false,
      },
    },
  }
}

fn text_root_match_child_scan_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  total_signature: i32,
  total_grandchild_signature: i32,
  total_descendant_signature: i32
) -> TextRootChildScan {
  let open_index = text_root_match_body_open_between(source, start, limit);
  let empty = text_root_child_scan_empty(
    source,
    limit,
    total_signature,
    total_grandchild_signature,
    total_descendant_signature
  );
  match open_index < limit {
    false => empty,
    true => find_text_right_brace(source, open_index + 1, limit, 0) \close_index -> match close_index < limit {
      false => empty,
      true => text_expression_start_skip_trivia(
        source,
        start + 1,
        open_index
      ) \value_start -> match value_start < open_index {
        true => text_root_child_scan_append_match_values(
          source,
          empty,
          value_start,
          open_index
        ),
        false => empty,
      } \with_value -> text_root_match_child_scan(
        source,
        open_index,
        close_index,
        with_value.total_signature,
        with_value.total_grandchild_signature,
        with_value.total_descendant_signature
      ) \block -> TextRootChildScan {
        index: block.index,
        close_index: block.close_index,
        segment_start: block.segment_start,
        paren_depth: block.paren_depth,
        brace_depth: block.brace_depth,
        bracket_depth: block.bracket_depth,
        total_count: with_value.total_count + block.total_count,
        total_signature: block.total_signature,
        total_grandchild_count: with_value.total_grandchild_count
          + block.total_grandchild_count,
        total_grandchild_signature: block.total_grandchild_signature,
        total_descendant_count: with_value.total_descendant_count
          + block.total_descendant_count,
        total_descendant_signature: block.total_descendant_signature,
        segment_saw_argument: false,
      },
    },
  }
}

fn text_root_if_child_scan_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  total_signature: i32,
  total_grandchild_signature: i32,
  total_descendant_signature: i32
) -> TextRootChildScan {
  let blocks = text_if_child_blocks_between(source, start, limit);
  let empty = text_root_child_scan_empty(
    source,
    limit,
    total_signature,
    total_grandchild_signature,
    total_descendant_signature
  );
  match blocks.false_close < limit {
    false => empty,
    true => match blocks.condition_start < blocks.condition_limit {
      true => text_root_child_scan_append_value(
        source,
        empty,
        blocks.condition_start,
        blocks.condition_limit
      ),
      false => empty,
    } \with_condition -> text_root_child_scan_append_value(
      source,
      with_condition,
      blocks.true_value_start,
      blocks.true_close
    ) \with_true -> text_root_child_scan_append_value(
      source,
      with_true,
      blocks.false_value_start,
      blocks.false_close
    ),
  }
}

fn text_expression_root_child_scan_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total_signature: i32,
  total_grandchild_signature: i32,
  total_descendant_signature: i32
) -> TextRootChildScan {
  let start = text_expression_start_skip_trivia(source, index, limit);
  let empty = text_root_child_scan_empty(
    source,
    limit,
    total_signature,
    total_grandchild_signature,
    total_descendant_signature
  );
  match start >= limit {
    true => empty,
    false => text_root_pipe_bind_index_from_start(source, start, limit) \pipe_index -> match pipe_index < limit {
      true => text_expression_root_child_scan_between(
        source,
        start,
        pipe_index,
        total_signature,
        total_grandchild_signature,
        total_descendant_signature
      ) \left -> text_pipe_bind_body_start_index(source, pipe_index, limit) \body_start -> match body_start < limit {
        true => text_root_child_scan_append_value(source, left, body_start, limit),
        false => left,
      },
      false => match textlex.token_at(source, start).kind {
        MatchKw => text_root_match_child_scan_between(
          source,
          start,
          limit,
          total_signature,
          total_grandchild_signature,
          total_descendant_signature
        ),
        IfKw => text_root_if_child_scan_between(
          source,
          start,
          limit,
          total_signature,
          total_grandchild_signature,
          total_descendant_signature
        ),
        DoKw => text_root_do_child_scan_between(
          source,
          start,
          limit,
          total_signature,
          total_grandchild_signature,
          total_descendant_signature
        ) \do_scan -> TextRootChildScan {
          index: do_scan.index,
          close_index: do_scan.close_index,
          segment_start: do_scan.segment_start,
          paren_depth: do_scan.paren_depth,
          brace_depth: do_scan.brace_depth,
          bracket_depth: do_scan.bracket_depth,
          total_count: do_scan.total_count,
          total_signature: do_scan.total_signature,
          total_grandchild_count: do_scan.total_grandchild_count,
          total_grandchild_signature: do_scan.total_grandchild_signature,
          total_descendant_count: do_scan.total_descendant_count,
          total_descendant_signature: do_scan.total_descendant_signature,
          segment_saw_argument: false,
        },
        _ => match textlex.punctuation_at(source, start) {
          PunctLeftBrace => find_text_right_brace(
            source,
            start + 1,
            limit,
            0
          ) \close_index -> match close_index < limit {
            true => text_root_child_scan(
              source,
              start,
              close_index,
              total_signature,
              total_grandchild_signature,
              total_descendant_signature
            ),
            false => empty,
          },
          PunctOther if text_left_bracket_token_matches(source, start) =>
            find_text_right_bracket(
              source,
              start + 1,
              limit,
              0
            ) \close_index -> match close_index < limit {
              false => empty,
              true => match text_bracket_root_is_repeat(
                source,
                start,
                close_index
              ) {
                true => text_bracket_root_repeat_child_scan(
                  source,
                  start,
                  close_index,
                  empty
                ),
                false => text_root_child_scan(
                  source,
                  start,
                  close_index,
                  total_signature,
                  total_grandchild_signature,
                  total_descendant_signature
                ),
              },
            },
          _ => text_root_callable_head_index(source, start, limit) \head_index -> match head_index >= limit {
            true => empty,
            false => text_root_call_open_after_head(source, head_index, limit) \open_index -> match open_index < limit {
              true => find_text_matching_right_paren(
                source,
                open_index + 1,
                limit,
                0
              ) \close_index -> match close_index < limit {
                true => text_root_child_scan(
                  source,
                  open_index,
                  close_index,
                  total_signature,
                  total_grandchild_signature,
                  total_descendant_signature
                ),
                false => empty,
              },
              false => text_root_slot_open_after_head(source, head_index, limit) \slot_open -> match slot_open < limit {
                false => empty,
                true => find_text_right_brace(
                  source,
                  slot_open + 1,
                  limit,
                  0
                ) \close_index -> match close_index < limit {
                  true => text_root_child_scan(
                    source,
                    slot_open,
                    close_index,
                    total_signature,
                    total_grandchild_signature,
                    total_descendant_signature
                  ),
                  false => empty,
                },
              },
            },
          },
        },
      },
    },
  }
}

fn text_expression_root_child_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  text_expression_root_child_scan_between(source, index, limit, 0, 0, 0).total_count
}

fn text_expression_root_grandchild_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  text_expression_root_child_scan_between(source, index, limit, 0, 0, 0)
    .total_grandchild_count
}

fn text_expression_root_grandchild_signature_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32
) -> i32 {
  text_expression_root_child_scan_between(source, index, limit, 0, total, 0)
    .total_grandchild_signature
}

fn text_expression_root_descendant_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  text_expression_root_child_scan_between(source, index, limit, 0, 0, 0)
    .total_descendant_count
}

fn text_expression_root_descendant_signature_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32
) -> i32 {
  text_expression_root_child_scan_between(source, index, limit, 0, 0, total)
    .total_descendant_signature
}

fn text_root_child_record_append_repeat_value(
  source: textlex.TextTokenStream,
  value_start: i32,
  value_limit: i32,
  parent_kind_tag: i32,
  parent_name_hash: i32,
  child_index: i32,
  total: i32,
  remaining: i32
) -> TextRootChildRecordState {
  match remaining <= 0 {
    true => TextRootChildRecordState {
      child_index: child_index,
      total: total,
    },
    false => text_root_child_record_fact_signature(
      source,
      value_start,
      value_limit,
      parent_kind_tag,
      parent_name_hash,
      child_index,
      text_root_child_slot_role_tag()
    ) \fact_signature -> rec(
      source,
      value_start,
      value_limit,
      parent_kind_tag,
      parent_name_hash,
      child_index + 1,
      textmodel.signature_mix(total, fact_signature),
      remaining - 1
    ),
  }
}

fn text_bracket_root_repeat_child_record_state(
  source: textlex.TextTokenStream,
  open_index: i32,
  close_index: i32,
  parent_kind_tag: i32,
  parent_name_hash: i32,
  child_index: i32,
  total: i32
) -> TextRootChildRecordState {
  let semicolon = text_bracket_root_repeat_semicolon(
    source,
    open_index,
    close_index
  );
  match semicolon < close_index {
    false => TextRootChildRecordState {
      child_index: child_index,
      total: total,
    },
    true => text_root_child_record_append_repeat_value(
      source,
      open_index + 1,
      semicolon,
      parent_kind_tag,
      parent_name_hash,
      child_index,
      total,
      text_bracket_root_repeat_count(source, open_index, close_index)
    ),
  }
}

fn text_expression_root_child_record_signature_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  parent_kind_tag: i32,
  parent_name_hash: i32,
  total: i32
) -> i32 {
  text_expression_root_child_record_signature_between_state(
    source,
    index,
    limit,
    parent_kind_tag,
    parent_name_hash,
    0,
    total
  ).total
}

fn text_expression_root_child_record_signature_between_state(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  parent_kind_tag: i32,
  parent_name_hash: i32,
  child_index: i32,
  total: i32
) -> TextRootChildRecordState {
  let start = text_expression_start_skip_trivia(source, index, limit);
  match start >= limit {
    true => TextRootChildRecordState {
      child_index: child_index,
      total: total,
    },
    false => text_root_pipe_bind_index_from_start(source, start, limit) \pipe_index -> match pipe_index < limit {
      true => text_expression_root_pipe_child_record_state(
        source,
        start,
        limit,
        pipe_index,
        parent_kind_tag,
        parent_name_hash,
        child_index,
        total
      ),
      false => match textlex.token_at(source, start).kind {
        MatchKw => text_root_match_child_record_state_between(
          source,
          start,
          limit,
          parent_kind_tag,
          parent_name_hash,
          child_index,
          total
        ),
        IfKw => text_root_if_child_record_state_between(
          source,
          start,
          limit,
          parent_kind_tag,
          parent_name_hash,
          child_index,
          total
        ),
        DoKw => text_root_do_child_record_state_between(
          source,
          start,
          limit,
          parent_kind_tag,
          parent_name_hash,
          child_index,
          total
        ),
        _ => match textlex.punctuation_at(source, start) {
          PunctLeftBrace => find_text_right_brace(
            source,
            start + 1,
            limit,
            0
          ) \close_index -> match close_index < limit {
            true => text_root_child_record_state_in_delimiters(
              source,
              start,
              close_index,
              parent_kind_tag,
              parent_name_hash,
              text_root_child_slot_role_tag(),
              child_index,
              total
            ),
            false => TextRootChildRecordState {
              child_index: child_index,
              total: total,
            },
          },
          PunctOther if text_left_bracket_token_matches(source, start) =>
            find_text_right_bracket(
              source,
              start + 1,
              limit,
              0
            ) \close_index -> match close_index < limit {
              false => TextRootChildRecordState {
                child_index: child_index,
                total: total,
              },
              true => match text_bracket_root_is_repeat(
                source,
                start,
                close_index
              ) {
                true => text_bracket_root_repeat_child_record_state(
                  source,
                  start,
                  close_index,
                  parent_kind_tag,
                  parent_name_hash,
                  child_index,
                  total
                ),
                false => text_root_child_record_state_in_delimiters(
                  source,
                  start,
                  close_index,
                  parent_kind_tag,
                  parent_name_hash,
                  text_root_child_slot_role_tag(),
                  child_index,
                  total
                ),
              },
            },
          _ => text_root_callable_head_index(source, start, limit) \head_index -> match head_index >= limit {
            true => TextRootChildRecordState {
              child_index: child_index,
              total: total,
            },
            false => text_root_call_open_after_head(source, head_index, limit) \open_index -> match open_index < limit {
              true => find_text_matching_right_paren(
                source,
                open_index + 1,
                limit,
                0
              ) \close_index -> match close_index < limit {
                true => text_root_child_record_state_in_delimiters(
                  source,
                  open_index,
                  close_index,
                  parent_kind_tag,
                  parent_name_hash,
                  text_root_child_call_role_tag(),
                  child_index,
                  total
                ),
                false => TextRootChildRecordState {
                  child_index: child_index,
                  total: total,
                },
              },
              false => text_root_slot_open_after_head(source, head_index, limit) \slot_open -> match slot_open < limit {
                false => TextRootChildRecordState {
                  child_index: child_index,
                  total: total,
                },
                true => find_text_right_brace(
                  source,
                  slot_open + 1,
                  limit,
                  0
                ) \close_index -> match close_index < limit {
                  true => text_root_child_record_state_in_delimiters(
                    source,
                    slot_open,
                    close_index,
                    parent_kind_tag,
                    parent_name_hash,
                    text_root_child_slot_role_tag(),
                    child_index,
                    total
                  ),
                  false => TextRootChildRecordState {
                    child_index: child_index,
                    total: total,
                  },
                },
              },
            },
          },
        },
      },
    },
  }
}

fn text_expression_root_child_signature_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32
) -> i32 {
  text_expression_root_child_scan_between(source, index, limit, total, 0, 0)
    .total_signature
}

fn text_root_postfix_start_after_qualified_head(
  source: textlex.TextTokenStream,
  head_index: i32,
  limit: i32
) -> i32 {
  let next = head_index + 1;
  match next >= limit {
    true => next,
    false => match text_head_selector_is_dot(source, next) {
      true => match next + 1 < limit {
        true => match text_head_segment_token_matches(source, next + 1) {
          true => text_root_postfix_start_after_qualified_head(
            source,
            next + 1,
            limit
          ),
          false => next,
        },
        false => next,
      },
      false => match text_head_selector_is_colon_colon(source, next) {
        true => match next + 2 < limit {
          true => match text_head_segment_token_matches(source, next + 2) {
            true => text_root_postfix_start_after_qualified_head(
              source,
              next + 2,
              limit
            ),
            false => next,
          },
          false => next,
        },
        false => next,
      },
    },
  }
}

fn text_root_field_count_after_postfix(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32
) -> i32 {
  match index >= limit {
    true => total,
    false => match textlex.punctuation_at(source, index) {
      PunctLeftParen => find_text_matching_right_paren(
        source,
        index + 1,
        limit,
        0
      ) \close_index -> match close_index < limit {
        true => text_root_field_count_after_postfix(
          source,
          close_index + 1,
          limit,
          total
        ),
        false => total,
      },
      _ => match text_head_selector_is_dot(source, index) {
        true => match index + 1 < limit {
          true => match text_head_segment_token_matches(source, index + 1) {
            true => text_root_field_count_after_postfix(
              source,
              index + 2,
              limit,
              total + 1
            ),
            false => total,
          },
          false => total,
        },
        false => total,
      },
    },
  }
}

fn text_expression_root_field_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  let has_head = match start < limit {
    true => text_head_segment_token_matches(source, start),
    false => false,
  };
  match has_head {
    false => 0,
    true => text_root_postfix_start_after_qualified_head(
      source,
      start,
      limit
    ) \postfix_start -> text_root_field_count_after_postfix(
      source,
      postfix_start,
      limit,
      0
    ),
  }
}

fn text_operator_symbol_char_matches(code: i32) -> bool {
  match code {
    33 => true,
    36 => true,
    37 => true,
    38 => true,
    42 => true,
    43 => true,
    45 => true,
    47 => true,
    60 => true,
    61 => true,
    62 => true,
    94 => true,
    124 => true,
    _ => false,
  }
}

fn text_operator_symbol_token_matches(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  let punctuation = textlex.punctuation_at(source, index);
  match punctuation {
    PunctEqual => true,
    PunctSlash => true,
    PunctOther => text_operator_symbol_char_matches(
      textlex.text_hash_at(source, index)
    ),
    _ => false,
  }
}

fn text_root_operator_is_sequence_start(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match text_operator_symbol_token_matches(source, index) {
    false => false,
    true => match index > 0 {
      false => true,
      true => match text_operator_symbol_token_matches(source, index - 1) {
        true => false,
        false => true,
      },
    },
  }
}

fn text_root_operator_is_reserved(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match textlex.punctuation_at(source, index) {
    PunctEqual => match text_operator_symbol_token_matches(source, index + 1) {
      true => match textlex.text_hash_at(source, index + 1) == textlex.TextCharCode::Equal {
        true => false,
        false => true,
      },
      false => true,
    },
    PunctOther => match textlex.text_hash_at(source, index) == textlex.TextCharCode::Less {
      true => match textlex.text_hash_at(source, index + 1) == textlex.TextCharCode::Minus {
        true => true,
        false => false,
      },
      false => false,
    },
    _ => false,
  }
}

fn text_root_operator_has_left_value(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match index > 0 {
    true => text_token_can_end_value_expr(source, index - 1),
    false => false,
  }
}

fn text_root_operator_token_matches(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match text_root_operator_is_sequence_start(source, index) {
    false => false,
    true => match text_root_operator_has_left_value(source, index) {
      false => false,
      true => match text_root_operator_is_reserved(source, index) {
        true => false,
        false => true,
      },
    },
  }
}

fn text_root_operator_scan_is_top_level(scan: TextRootOperatorCountScan) -> bool {
  match scan.paren_depth == 0 {
    true => match scan.brace_depth == 0 {
      true => scan.bracket_depth == 0,
      false => false,
    },
    false => false,
  }
}

fn text_root_operator_count_scan_step(
  source: textlex.TextTokenStream,
  scan: TextRootOperatorCountScan
) -> TextRootOperatorCountScan {
  let is_top_level = text_root_operator_scan_is_top_level(scan);
  let current_matches = match is_top_level {
    true => match scan.index > scan.start {
      true => text_root_operator_token_matches(source, scan.index),
      false => false,
    },
    false => false,
  };
  TextRootOperatorCountScan {
    index: scan.index + 1,
    start: scan.start,
    limit: scan.limit,
    paren_depth: paren_depth_after_token(
      source,
      scan.index,
      scan.paren_depth
    ),
    brace_depth: brace_depth_after_token(
      source,
      scan.index,
      scan.brace_depth
    ),
    bracket_depth: text_argument_scan_bracket_delta(
      source,
      scan.index,
      scan.bracket_depth
    ),
    total: match current_matches {
      true => scan.total + 1,
      false => scan.total,
    },
  }
}

fn text_root_operator_count_scan_loop(
  source: textlex.TextTokenStream,
  scan: TextRootOperatorCountScan
) -> TextRootOperatorCountScan {
  match scan.index >= scan.limit {
    true => scan,
    false => text_root_operator_count_scan_loop(
      source,
      text_root_operator_count_scan_step(source, scan)
    ),
  }
}

fn text_root_operator_index_scan_is_top_level(
  scan: TextRootOperatorIndexScan
) -> bool {
  match scan.paren_depth == 0 {
    true => match scan.brace_depth == 0 {
      true => scan.bracket_depth == 0,
      false => false,
    },
    false => false,
  }
}

fn text_root_operator_index_scan_step(
  source: textlex.TextTokenStream,
  scan: TextRootOperatorIndexScan
) -> TextRootOperatorIndexScan {
  let is_top_level = text_root_operator_index_scan_is_top_level(scan);
  let current_matches = match is_top_level {
    true => match scan.index > scan.start {
      true => text_root_operator_token_matches(source, scan.index),
      false => false,
    },
    false => false,
  };
  TextRootOperatorIndexScan {
    index: scan.index + 1,
    start: scan.start,
    limit: scan.limit,
    paren_depth: paren_depth_after_token(
      source,
      scan.index,
      scan.paren_depth
    ),
    brace_depth: brace_depth_after_token(
      source,
      scan.index,
      scan.brace_depth
    ),
    bracket_depth: text_argument_scan_bracket_delta(
      source,
      scan.index,
      scan.bracket_depth
    ),
    result: match current_matches {
      true => scan.index,
      false => scan.result,
    },
    found: match current_matches {
      true => true,
      false => scan.found,
    },
  }
}

fn text_root_operator_index_scan_loop(
  source: textlex.TextTokenStream,
  scan: TextRootOperatorIndexScan
) -> TextRootOperatorIndexScan {
  match scan.found {
    true => scan,
    false => match scan.index >= scan.limit {
      true => scan,
      false => text_root_operator_index_scan_loop(
        source,
        text_root_operator_index_scan_step(source, scan)
      ),
    },
  }
}

fn text_operator_sequence_end(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  match index >= limit {
    true => limit,
    false => match text_operator_symbol_token_matches(source, index) {
      true => text_operator_sequence_end(source, index + 1, limit),
      false => index,
    },
  }
}

fn text_root_operator_parts_none(limit: i32) -> TextRootOperatorParts {
  TextRootOperatorParts {
    left_start: limit,
    left_limit: limit,
    right_start: limit,
    right_limit: limit,
    operator_index: limit,
    operator_hash: 0,
    found: false,
  }
}

fn text_root_operator_parts_present(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  operator_index: i32
) -> TextRootOperatorParts {
  let operator_end = text_operator_sequence_end(
    source,
    operator_index,
    limit
  );
  TextRootOperatorParts {
    left_start: start,
    left_limit: operator_index,
    right_start: text_expression_start_skip_trivia(
      source,
      operator_end,
      limit
    ),
    right_limit: limit,
    operator_index: operator_index,
    operator_hash: text_operator_sequence_hash(source, operator_index),
    found: true,
  }
}

fn text_expression_root_operator_can_have_links(
  source: textlex.TextTokenStream,
  start: i32
) -> bool {
  match textlex.token_at(source, start).kind {
    MatchKw => false,
    IfKw => false,
    DoKw => false,
    _ => match textlex.punctuation_at(source, start) {
      PunctOther => match text_pipe_bind_token_matches(source, start) {
        true => false,
        false => true,
      },
      _ => true,
    },
  }
}

fn text_expression_root_operator_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  match start >= limit {
    true => 0,
    false => match text_expression_root_operator_can_have_links(source, start) {
      false => 0,
      true => text_root_operator_count_scan_loop(
      source,
      TextRootOperatorCountScan {
        index: start,
        start: start,
        limit: limit,
          paren_depth: 0,
          brace_depth: 0,
          bracket_depth: 0,
          total: 0,
        }
      ).total,
    },
  }
}

fn text_expression_root_single_operator_parts_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> TextRootOperatorParts {
  let start = text_expression_start_skip_trivia(source, index, limit);
  match start >= limit {
    true => text_root_operator_parts_none(limit),
    false => match text_expression_root_operator_can_have_links(source, start) {
      false => text_root_operator_parts_none(limit),
      true => match text_expression_root_operator_count_between(
        source,
        start,
        limit
      ) == 1 {
        false => text_root_operator_parts_none(limit),
        true => text_root_operator_index_scan_loop(
          source,
          TextRootOperatorIndexScan {
            index: start,
            start: start,
            limit: limit,
            paren_depth: 0,
            brace_depth: 0,
            bracket_depth: 0,
            result: limit,
            found: false,
          }
        ) \scan -> match scan.found {
          true => text_root_operator_parts_present(
            source,
            start,
            limit,
            scan.result
          ),
          false => text_root_operator_parts_none(limit),
        },
      },
    },
  }
}

fn text_expression_root_type_class_tag_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  match start >= limit {
    true => text_type_class_unknown_tag(),
    false => match textlex.token_at(source, start).kind {
      BoolLiteral if text_scalar_literal_is_standalone(source, start, limit) =>
        text_type_class_bool_tag(),
      NumberLiteral if text_scalar_literal_is_standalone(source, start, limit) =>
        text_type_class_i32_tag(),
      StringLiteral if text_scalar_literal_is_standalone(source, start, limit) =>
        text_type_class_i32_tag(),
      CharLiteral if text_scalar_literal_is_standalone(source, start, limit) =>
        text_type_class_i32_tag(),
      MultilineLiteral if text_scalar_literal_is_standalone(source, start, limit) =>
        text_type_class_i32_tag(),
      LiteralType
        if text_literal_type_token_has_marker(source, start)
          && text_scalar_literal_is_standalone(source, start, limit) =>
        text_type_class_i32_tag(),
      _ => match textlex.punctuation_at(source, start) {
        PunctOther if text_signed_number_start_matches(source, start, limit) =>
          match text_scalar_literal_is_standalone(source, start + 1, limit) {
            true => text_type_class_i32_tag(),
            false => text_type_class_unknown_tag(),
          },
        PunctLeftBrace => text_type_class_product_tag(),
        PunctOther if text_left_bracket_token_matches(source, start) =>
          text_type_class_product_tag(),
        PunctOther if text_pipe_bind_token_matches(source, start) =>
          text_type_class_function_tag(),
        _ if text_product_constructor_start_matches_between(source, start, limit) =>
          text_type_class_product_tag(),
        _ => text_type_class_unknown_tag(),
      },
    },
  }
}

fn text_expression_root_is_bare_identifier_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> bool {
  let start = text_expression_start_skip_trivia(source, index, limit);
  let starts_with_identifier = match start < limit {
    true => text_token_weight_matches(
      source,
      start,
      token.TokenKindWeight::Identifier
    ),
    false => false,
  };
  let no_call = text_expression_root_call_arg_count_between(
    source,
    index,
    limit
  ) == text_no_root_call_arg_count();
  let no_operator = text_expression_root_operator_count_between(
    source,
    index,
    limit
  ) == 0;
  let no_selector = text_expression_root_head_selector_count_between(
    source,
    index,
    limit
  ) == 0;
  let no_field = text_expression_root_field_count_between(
    source,
    index,
    limit
  ) == 0;
  let no_pipe_bind = text_value_pipe_bind_count_between(
    source,
    index,
    limit,
    0
  ) == 0;
  starts_with_identifier
    && no_call
    && no_operator
    && no_selector
    && no_field
    && no_pipe_bind
}

fn text_expression_root_identifier_hash_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  match start >= limit {
    true => 0,
    false => match textlex.token_at(source, start).kind {
      Identifier if text_scalar_literal_is_standalone(source, start, limit) =>
        textlex.text_hash_at(source, start),
      _ => 0,
    },
  }
}

fn text_param_resolved_type_class_for_name_hash_between(
  source: textlex.TextTokenStream,
  index: i32,
  close_index: i32,
  target_hash: i32
) -> i32 {
  match index >= close_index {
    true => text_type_class_unknown_tag(),
    false => text_param_resolved_type_class_for_name_hash_continue(
      source,
      index,
      close_index,
      target_hash
    ),
  }
}

fn text_param_resolved_type_class_for_name_hash_continue(
  source: textlex.TextTokenStream,
  index: i32,
  close_index: i32,
  target_hash: i32
) -> i32 {
  let comma = text_find_top_level_punctuation_score(
    source,
    index,
    close_index,
    0,
    7
  );
  let name_index = text_param_name_index_at(source, index, comma);
  let found = textlex.text_hash_at(source, name_index) == target_hash;
  match found {
    true => text_param_resolved_type_class_for_segment(
      source,
      index,
      comma
    ),
    false => text_param_resolved_type_class_for_name_hash_between(
      source,
      match comma < close_index {
        true => comma + 1,
        false => close_index,
      },
      close_index,
      target_hash
    ),
  }
}

fn text_param_resolved_type_class_for_segment(
  source: textlex.TextTokenStream,
  index: i32,
  segment_end: i32
) -> i32 {
  let colon = text_find_top_level_punctuation_score(
    source,
    index,
    segment_end,
    0,
    8
  );
  match colon < segment_end {
    true => text_annotation_resolved_type_class_tag_between(
      source,
      colon + 1,
      segment_end
    ),
    false => text_type_class_unknown_tag(),
  }
}

fn text_function_param_resolved_type_class_for_name_hash(
  source: textlex.TextTokenStream,
  index: i32,
  target_hash: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  text_param_resolved_type_class_for_name_hash_between(
    source,
    open_paren + 1,
    close_paren,
    target_hash
  )
}

fn text_function_scalar_operator_operand_type_class(
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let parenthesized = text_parenthesized_expression_segment_between(
    source,
    start,
    limit
  );
  match parenthesized.found {
    true => text_function_scalar_operator_operand_type_class(
      source,
      function_index,
      parenthesized.start,
      parenthesized.limit
    ),
    false => text_function_scalar_operator_operand_type_class_unwrapped(
      source,
      function_index,
      start,
      limit
    ),
  }
}

fn text_function_scalar_operator_operand_type_class_unwrapped(
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let root_kind = text_expression_root_head_kind_tag_between(
    source,
    start,
    limit
  );
  let root_type = text_expression_root_type_class_tag_between(
    source,
    start,
    limit
  );
  let operator_type = text_function_scalar_operator_type_class_between(
    source,
    function_index,
    start,
    limit
  );
  match operator_type == text_type_class_unknown_tag() {
    false => operator_type,
    true => text_function_scalar_branch_type_class_between(
      source,
      function_index,
      start,
      limit
    ) \branch_type -> match branch_type == text_type_class_unknown_tag() {
      false => branch_type,
      true => text_root_literal_type_class(
        root_kind,
        root_type
      ) \literal_type -> match literal_type == text_type_class_unknown_tag() {
        false => literal_type,
        true => match root_kind == text_expression_root_identifier_tag() {
          true => text_expression_root_head_hash_between(
            source,
            start,
            limit
          ) \target_hash -> text_expression_root_call_arg_count_between(
            source,
            start,
            limit
          ) \call_arg_count -> match call_arg_count == text_no_root_call_arg_count() {
            true => match text_expression_root_is_bare_identifier_between(
              source,
              start,
              limit
            ) {
              true => text_function_param_resolved_type_class_for_name_hash(
                source,
                function_index,
                target_hash
              ),
              false => text_type_class_unknown_tag(),
            },
            false => text_root_call_return_type_class_for_hash_between(
              source,
              start,
              limit,
              target_hash
            ),
          },
          false => text_type_class_unknown_tag(),
        },
      },
    },
  }
}

fn text_function_body_scalar_operator_operand_type_class(
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let parenthesized = text_parenthesized_expression_segment_between(
    source,
    start,
    limit
  );
  match parenthesized.found {
    true => text_function_body_scalar_operator_operand_type_class(
      source,
      function_index,
      parenthesized.start,
      parenthesized.limit
    ),
    false => text_function_body_scalar_operator_operand_type_class_unwrapped(
      source,
      function_index,
      start,
      limit
    ),
  }
}

fn text_function_body_scalar_operator_operand_type_class_unwrapped(
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let root_kind = text_expression_root_head_kind_tag_between(
    source,
    start,
    limit
  );
  let operator_type = text_function_body_scalar_operator_type_class_between(
    source,
    function_index,
    start,
    limit
  );
  let type_class = match operator_type == text_type_class_unknown_tag() {
    false => operator_type,
    true => text_function_scalar_operator_operand_type_class(
      source,
      function_index,
      start,
      limit
    ),
  };
  match type_class == text_type_class_unknown_tag() {
    false => type_class,
    true => text_function_body_scalar_branch_type_class_between(
      source,
      function_index,
      start,
      limit
      ) \branch_type -> match branch_type == text_type_class_unknown_tag() {
        false => branch_type,
        true => match text_expression_root_is_bare_identifier_between(
          source,
          start,
          limit
        ) {
          false => text_type_class_unknown_tag(),
          true => match root_kind == text_expression_root_identifier_tag() {
            false => text_type_class_unknown_tag(),
            true => text_expression_root_identifier_hash_between(
              source,
              start,
              limit
            ) \target_hash -> text_function_local_let_resolved_type_class_for_name_hash(
              source,
              function_index,
              target_hash
            ),
          },
        },
      },
  }
}

fn text_function_body_scalar_operator_type_class_between(
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let parts = text_expression_root_single_operator_parts_between(
    source,
    start,
    limit
  );
  match parts.found {
    false => text_type_class_unknown_tag(),
    true => text_scalar_operator_type_class_from_parts(
      parts.operator_hash,
      text_function_body_scalar_operator_operand_type_class(
        source,
        function_index,
        parts.left_start,
        parts.left_limit
      ),
      text_function_body_scalar_operator_operand_type_class(
        source,
        function_index,
        parts.right_start,
        parts.right_limit
      )
    ),
  }
}

fn text_scalar_arithmetic_operator_type_class(
  operator_hash: i32,
  left: i32,
  right: i32
) -> i32 {
  match text_scalar_arithmetic_operator_matches(operator_hash) {
    false => text_type_class_unknown_tag(),
    true => text_i32_binary_operator_type_class(left, right, text_type_class_i32_tag()),
  }
}

fn text_scalar_arithmetic_operator_matches(operator_hash: i32) -> bool {
  let is_add = operator_hash == text_operator_hash_plus();
  let is_sub = operator_hash == text_operator_hash_minus();
  let is_mul = operator_hash == text_operator_hash_asterisk();
  let is_div = operator_hash == text_operator_hash_slash();
  let is_rem = operator_hash == text_operator_hash_percent();
  is_add || is_sub || is_mul || is_div || is_rem
}

fn text_i32_binary_operator_type_class(
  left: i32,
  right: i32,
  result_type: i32
) -> i32 {
  let left_is_i32 = left == text_type_class_i32_tag();
  let right_is_i32 = right == text_type_class_i32_tag();
  match left_is_i32 && right_is_i32 {
    false => text_type_class_unknown_tag(),
    true => result_type,
  }
}

fn text_scalar_comparison_operator_matches(operator_hash: i32) -> bool {
  let is_less = operator_hash == text_operator_hash_less();
  let is_greater = operator_hash == text_operator_hash_greater();
  let is_less_equal = operator_hash == text_operator_hash_less_equal();
  let is_greater_equal = operator_hash == text_operator_hash_greater_equal();
  is_less || is_greater || is_less_equal || is_greater_equal
}

fn text_scalar_comparison_operator_type_class(
  operator_hash: i32,
  left: i32,
  right: i32
) -> i32 {
  match text_scalar_comparison_operator_matches(operator_hash) {
    false => text_type_class_unknown_tag(),
    true => text_i32_binary_operator_type_class(left, right, text_type_class_bool_tag()),
  }
}

fn text_scalar_equality_operator_matches(operator_hash: i32) -> bool {
  match operator_hash == text_operator_hash_equal_equal() {
    true => true,
    false => operator_hash == text_operator_hash_not_equal(),
  }
}

fn text_scalar_equality_operator_type_class(
  operator_hash: i32,
  left: i32,
  right: i32
) -> i32 {
  match text_scalar_equality_operator_matches(operator_hash) {
    false => text_type_class_unknown_tag(),
    true => text_matching_scalar_type_class(left, right, text_type_class_bool_tag()),
  }
}

fn text_matching_scalar_type_class(
  left: i32,
  right: i32,
  result_type: i32
) -> i32 {
  let left_is_scalar = text_type_class_is_scalar(left);
  let types_match = left == right;
  match left_is_scalar && types_match {
    true => result_type,
    false => text_type_class_unknown_tag(),
  }
}

fn text_scalar_operator_type_class_from_parts(
  operator_hash: i32,
  left: i32,
  right: i32
) -> i32 {
  let arithmetic = text_scalar_arithmetic_operator_type_class(
    operator_hash,
    left,
    right
  );
  match arithmetic == text_type_class_unknown_tag() {
    false => arithmetic,
    true => text_scalar_comparison_operator_type_class(
      operator_hash,
      left,
      right
    ) \comparison -> match comparison == text_type_class_unknown_tag() {
      false => comparison,
      true => text_scalar_equality_operator_type_class(
        operator_hash,
        left,
        right
      ),
    },
  }
}

fn text_scalar_branch_type_class_from_parts(
  condition: i32,
  true_type: i32,
  false_type: i32
) -> i32 {
  match condition == text_type_class_bool_tag() {
    false => text_type_class_unknown_tag(),
    true => text_matching_scalar_type_class(true_type, false_type, true_type),
  }
}

fn text_function_scalar_branch_type_class_between(
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let segments = text_bool_branch_segments_between(source, start, limit);
  match segments.found {
    false => text_type_class_unknown_tag(),
    true => text_scalar_branch_type_class_from_parts(
      text_function_scalar_operator_operand_type_class(
        source,
        function_index,
        segments.condition_start,
        segments.condition_limit
      ),
      text_function_scalar_operator_operand_type_class(
        source,
        function_index,
        segments.true_value_start,
        segments.true_value_limit
      ),
      text_function_scalar_operator_operand_type_class(
        source,
        function_index,
        segments.false_value_start,
        segments.false_value_limit
      )
    ),
  }
}

fn text_function_body_scalar_branch_type_class_between(
  source: textlex.TextTokenStream,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let segments = text_bool_branch_segments_between(source, start, limit);
  match segments.found {
    false => text_type_class_unknown_tag(),
    true => text_scalar_branch_type_class_from_parts(
      text_function_body_scalar_operator_operand_type_class(
        source,
        function_index,
        segments.condition_start,
        segments.condition_limit
      ),
      text_function_body_scalar_operator_operand_type_class(
        source,
        function_index,
        segments.true_value_start,
        segments.true_value_limit
      ),
      text_function_body_scalar_operator_operand_type_class(
        source,
        function_index,
        segments.false_value_start,
        segments.false_value_limit
      )
    ),
  }
}

fn text_function_body_simple_scalar_operator_type_class(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_function_body_value_limit_index(source, index);
  let start = text_function_body_value_start_index(source, index);
  text_function_body_scalar_operator_type_class_between(source, index, start, next)
}

fn text_block_final_expression_start_between(
  source: textlex.TextTokenStream,
  scan: TextBlockFinalExpressionScan
) -> i32 {
  if scan.index >= scan.limit {
    scan.candidate
  } else {
    let is_top_level = match text_depth_is_top_level(
      scan.brace_depth,
      scan.paren_depth
    ) {
      true => scan.bracket_depth == 0,
      false => false,
    };
    let is_statement_end = match textlex.punctuation_at(source, scan.index) {
      PunctSemicolon => is_top_level,
      _ => false,
    };
    let next_candidate = match is_statement_end {
      true => scan.index + 1,
      false => scan.candidate,
    };
    text_block_final_expression_start_between(
      source,
      text_block_final_expression_scan(
        scan.index + 1,
        scan.limit,
        brace_depth_after_token(source, scan.index, scan.brace_depth),
        paren_depth_after_token(source, scan.index, scan.paren_depth),
        text_argument_scan_bracket_delta(
          source,
          scan.index,
          scan.bracket_depth
        ),
        next_candidate
      )
    )
  }
}

fn text_function_body_value_start_index(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  let arrow = text_function_arrow_index(source, close_paren, next);
  let left_brace = text_function_left_brace_index(source, arrow, next);
  let previous = left_brace - 1;
  match text_token_weight_matches(source, previous, 31) {
    true => previous,
    false => text_block_final_expression_start_between(
      source,
      text_block_final_expression_scan(
        left_brace + 1,
        find_text_expression_limit(
          source,
          left_brace + 1,
          next,
          textlex.PunctRightBrace
        ),
        0,
        0,
        0,
        left_brace + 1
      )
    ),
  }
}

fn text_function_body_value_limit_index(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  let arrow = text_function_arrow_index(source, close_paren, next);
  let left_brace = text_function_left_brace_index(source, arrow, next);
  let previous = left_brace - 1;
  match text_token_weight_matches(source, previous, 31) {
    true => next,
    false => find_text_expression_limit(
      source,
      left_brace + 1,
      next,
      textlex.PunctRightBrace
    ),
  }
}

fn text_function_body_is_match_body(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  let arrow = text_function_arrow_index(source, close_paren, next);
  let left_brace = text_function_left_brace_index(source, arrow, next);
  text_token_weight_matches(source, left_brace - 1, 31)
}

fn text_function_body_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let start = text_function_body_value_start_index(source, index);
  text_expression_root_type_class_tag_between(source, start, next)
}

fn text_value_declaration_body_start_index(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let equal = text_find_top_level_punctuation_score(
    source,
    index + 2,
    next,
    0,
    1
  );
  match equal < next {
    true => equal + 1,
    false => next,
  }
}

fn text_function_root_expression_window_reader() -> monad.Reader(
  TextValueBodyContext,
  TextValueBodyWindow
) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    source <- monad.Reader::asks(text_value_body_context_source);
    index <- monad.Reader::asks(text_value_body_context_index);
    pure(text_value_body_window(
      text_function_body_value_start_index(source, index),
      text_declaration_end_from_index(source, index)
    ))
  }
}

fn text_value_declaration_root_expression_window_reader() -> monad.Reader(
  TextValueBodyContext,
  TextValueBodyWindow
) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    source <- monad.Reader::asks(text_value_body_context_source);
    index <- monad.Reader::asks(text_value_body_context_index);
    pure(text_value_body_window(
      text_value_declaration_body_start_index(source, index),
      text_declaration_end_from_index(source, index)
    ))
  }
}

fn text_declaration_root_expression_window_reader() -> monad.Reader(
  TextValueBodyContext,
  TextValueBodyWindow
) {
  text_declaration_window_reader(TextDeclarationRootExpressionWindow)
}

fn text_function_declaration_window_reader(
  kind: TextDeclarationWindowKind
) -> monad.Reader(TextValueBodyContext, TextValueBodyWindow) {
  match kind {
    TextDeclarationValueBodyWindow => text_function_value_body_window_reader(),
    TextDeclarationShapeNameTokenWindow => text_function_value_body_window_reader(),
    TextDeclarationRootExpressionWindow =>
      text_function_root_expression_window_reader(),
  }
}

fn text_value_binding_declaration_window_reader(
  kind: TextDeclarationWindowKind
) -> monad.Reader(TextValueBodyContext, TextValueBodyWindow) {
  match kind {
    TextDeclarationValueBodyWindow => text_value_declaration_body_window_reader(),
    TextDeclarationShapeNameTokenWindow =>
      text_value_declaration_shape_name_token_window_reader(),
    TextDeclarationRootExpressionWindow =>
      text_value_declaration_root_expression_window_reader(),
  }
}

fn text_declaration_window_reader(
  kind: TextDeclarationWindowKind
) -> monad.Reader(TextValueBodyContext, TextValueBodyWindow) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    source <- monad.Reader::asks(text_value_body_context_source);
    index <- monad.Reader::asks(text_value_body_context_index);
    kind_tag <- text_value_body_kind_tag_reader();
    match is_text_non_value_declaration_start(source, index) {
      true => pure(text_missing_value_body_window()),
      false => match text_declaration_kind_is_function(kind_tag) {
        true => text_function_declaration_window_reader(kind),
        false => match text_declaration_kind_is_value_binding(kind_tag) {
          true => text_value_binding_declaration_window_reader(kind),
          false => pure(text_missing_value_body_window()),
        },
      },
    }
  }
}

fn text_declaration_root_expression_window(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> TextValueBodyWindow {
  monad.Reader::run(
    text_declaration_root_expression_window_reader(),
    text_value_body_context(source, index, decl)
  )
}

fn text_value_root_int_between(
  source: textlex.TextTokenStream,
  window: TextValueBodyWindow,
  metric: TextValueRootInt,
  missing: i32
) -> i32 {
  match window.found {
    false => missing,
    true => match metric {
      TextValueRootTypeClassTag => text_expression_root_type_class_tag_between(
        source,
        window.start,
        window.limit
      ),
      TextValueRootHeadKindTag => text_expression_root_head_kind_tag_between(
        source,
        window.start,
        window.limit
      ),
      TextValueRootHeadHash => text_expression_root_head_hash_between(
        source,
        window.start,
        window.limit
      ),
      TextValueRootQualifiedHeadHash =>
        text_expression_root_qualified_head_hash_between(
          source,
          window.start,
          window.limit
        ),
      TextValueRootHeadSelectorCount =>
        text_expression_root_head_selector_count_between(
          source,
          window.start,
          window.limit
        ),
      TextValueRootSlotCount => text_expression_root_slot_count_between(
        source,
        window.start,
        window.limit
      ),
      TextValueRootChildCount => text_expression_root_child_count_between(
        source,
        window.start,
        window.limit
      ),
      TextValueRootGrandchildCount =>
        text_expression_root_grandchild_count_between(
          source,
          window.start,
          window.limit
        ),
      TextValueRootDescendantCount =>
        text_expression_root_descendant_count_between(
          source,
          window.start,
          window.limit
        ),
      TextValueRootCallArgCount => text_expression_root_call_arg_count_between(
        source,
        window.start,
        window.limit
      ),
      TextValueRootFieldCount => text_expression_root_field_count_between(
        source,
        window.start,
        window.limit
      ),
      TextValueRootOperatorCount => text_expression_root_operator_count_between(
        source,
        window.start,
        window.limit
      ),
    },
  }
}

fn text_declaration_value_root_int_reader(
  metric: TextValueRootInt,
  missing: i32
) -> monad.Reader(TextValueBodyContext, i32) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    source <- monad.Reader::asks(text_value_body_context_source);
    window <- text_declaration_root_expression_window_reader();
    pure(text_value_root_int_between(source, window, metric, missing))
  }
}

fn text_declaration_value_root_int(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
