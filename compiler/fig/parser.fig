) -> i32 {
  match text_declaration_kind_tag(source, index, decl) {
    1 => text_function_value_operator_count(source, index),
    2 => text_value_declaration_operator_count(source, index),
    3 => text_value_declaration_operator_count(source, index),
    _ => 0,
  }
}

