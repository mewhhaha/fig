}

fn text_declaration_no_dependency_target() -> TextDeclarationDependencyTarget {
  TextDeclarationDependencyTarget {
    found: false,
    hash: 0,
    edge_tag: 0,
  }
}

fn text_declaration_dependency_target(
  hash: i32,
  edge_tag: i32
) -> TextDeclarationDependencyTarget {
  TextDeclarationDependencyTarget {
    found: true,
    hash: hash,
    edge_tag: edge_tag,
  }
}

fn text_declaration_simple_dependency_target(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> TextDeclarationDependencyTarget {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  match is_text_non_value_declaration_start(source, index) {
    true => text_declaration_no_dependency_target(),
    false => match is_text_function_declaration_start(source, index) {
      true => match text_function_body_is_match_body(source, index) {
        true => text_declaration_no_dependency_target(),
        false => text_declaration_simple_dependency_target_for_value_body(
          source,
          index,
          decl,
          kind_tag
        ),
      },
      false => text_declaration_simple_dependency_target_for_value_body(
        source,
        index,
        decl,
        kind_tag
      ),
    },
  }
}

fn text_declaration_simple_dependency_target_for_value_body(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  kind_tag: i32
) -> TextDeclarationDependencyTarget {
  match text_declaration_has_dependency_body_kind_tag(kind_tag) {
    false => text_declaration_no_dependency_target(),
    true => match text_declaration_root_head_kind_tag(source, index, decl) ==
      text_expression_root_identifier_tag() {
      false => text_declaration_no_dependency_target(),
      true => match text_declaration_root_head_selector_count(source, index, decl) == 0 {
        true => text_declaration_dependency_target(
          text_declaration_root_head_hash(source, index, decl),
          text_declaration_dependency_value_edge_tag()
        ),
        false => text_declaration_root_qualified_head_hash(source, index, decl)
          \qualified_hash -> match qualified_hash == 0 {
          true => text_declaration_no_dependency_target(),
          false => text_declaration_dependency_target(
            qualified_hash,
            text_declaration_dependency_qualified_value_edge_tag()
          ),
        },
      },
    },
  }
}

fn text_declaration_count_scan(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  brace_depth: i32,
  paren_depth: i32,
  total: i32
) -> i32 {
  match index >= limit {
    true => total,
    false => rec(
      source,
      index + 1,
      limit,
      brace_depth_after_token(source, index, brace_depth),
      paren_depth_after_token(source, index, paren_depth),
      match is_text_top_level_declaration_start(
        source,
        index,
        brace_depth,
        paren_depth
      ) {
        true => total + 1,
        false => total,
      }
    ),
  }
}

fn text_declaration_dependency_reach_budget(
  source: textlex.TextTokenStream
) -> i32 {
  text_declaration_count_scan(
    source,
    0,
    textlex.length(source),
    0,
    0,
    0
  )
}

fn text_declaration_dependency_reaches(
  source: textlex.TextTokenStream,
  current_hash: i32,
  target_hash: i32,
  budget: i32
) -> bool {
  match current_hash == target_hash {
    true => true,
    false => match budget <= 0 {
      true => false,
      false => text_declaration_dependency_reach_scan(
        source,
        TextDependencyReachScan {
          index: 0,
          limit: textlex.length(source),
          brace_depth: 0,
          paren_depth: 0,
          current_hash: current_hash,
          target_hash: target_hash,
          budget: budget,
        }
      ),
    },
  }
}

fn text_declaration_dependency_reach_scan_next(
  source: textlex.TextTokenStream,
  scan: TextDependencyReachScan
) -> TextDependencyReachScan {
  TextDependencyReachScan {
    index: scan.index + 1,
    limit: scan.limit,
    brace_depth: brace_depth_after_token(source, scan.index, scan.brace_depth),
    paren_depth: paren_depth_after_token(source, scan.index, scan.paren_depth),
    current_hash: scan.current_hash,
    target_hash: scan.target_hash,
    budget: scan.budget,
  }
}

fn text_declaration_dependency_reach_candidate(
  source: textlex.TextTokenStream,
  scan: TextDependencyReachScan
) -> bool {
  let next_target = text_declaration_simple_dependency_target(
    source,
    scan.index,
    ast.empty_decl()
  );
  match next_target.found {
    true => text_declaration_dependency_reach_found_candidate(source, scan, next_target),
    false => false,
  }
}

fn text_declaration_dependency_reach_found_candidate(
  source: textlex.TextTokenStream,
  scan: TextDependencyReachScan,
  target: TextDeclarationDependencyTarget
) -> bool {
  match target.edge_tag == text_declaration_dependency_value_edge_tag() {
    false => false,
    true => text_declaration_dependency_reaches(
      source,
      target.hash,
      scan.target_hash,
      scan.budget - 1
    ),
  }
}

fn text_declaration_dependency_reach_scan(
  source: textlex.TextTokenStream,
  scan: TextDependencyReachScan
) -> bool {
  match scan.index >= scan.limit {
    true => false,
    false => match is_text_top_level_declaration_start(
      source,
      scan.index,
      scan.brace_depth,
      scan.paren_depth
    ) {
      true => match text_declaration_name_hash(
        source,
        scan.index,
        ast.empty_decl()
      ) == scan.current_hash {
        true => match text_declaration_dependency_reach_candidate(source, scan) {
          true => true,
          false => text_declaration_dependency_reach_scan(
            source,
            text_declaration_dependency_reach_scan_next(source, scan)
          ),
        },
        false => text_declaration_dependency_reach_scan(
          source,
          text_declaration_dependency_reach_scan_next(source, scan)
        ),
      },
      false => text_declaration_dependency_reach_scan(
        source,
        text_declaration_dependency_reach_scan_next(source, scan)
      ),
    },
  }
}

fn text_declaration_dependency_diagnostic_code(
  source: textlex.TextTokenStream,
  from_hash: i32,
  to_hash: i32
) -> i32 {
  match text_declaration_dependency_reaches(
    source,
    to_hash,
    from_hash,
    text_declaration_dependency_reach_budget(source)
  ) {
    true => diagnostic.DiagnosticCodeScore::DependencyCycle,
    false => text_declaration_dependency_no_diagnostic_code(),
  }
}

fn text_declaration_dependency_diagnostic_hash(
  kind_tag: i32,
  from_hash: i32,
  to_hash: i32,
  edge_tag: i32,
  span_width: i32,
  diagnostic_code: i32
) -> i32 {
  107
    \total -> text_signature_mix(total, kind_tag)
    \total -> text_signature_mix(total, from_hash)
    \total -> text_signature_mix(total, to_hash)
    \total -> text_signature_mix(total, edge_tag)
    \total -> text_signature_mix(total, span_width)
    \total -> text_signature_mix(total, diagnostic_code)
}

fn text_declaration_dependency_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  monad.Reader::run(
    text_declaration_dependency_signature_total_reader(total),
    text_value_body_context(source, index, decl)
  )
}

fn text_declaration_dependency_diagnostic_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  monad.Reader::run(
    text_declaration_dependency_diagnostic_signature_total_reader(total),
    text_value_body_context(source, index, decl)
  )
}

fn text_declaration_dependency_diagnostic_signature_for_value_body(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  kind_tag: i32,
  total: i32
) -> i32 {
  let target = text_declaration_simple_dependency_target(source, index, decl);
  match target.found {
    false => total,
    true => text_declaration_name_hash(source, index, decl)
      \from_hash -> text_signature_mix(
      total,
      text_declaration_dependency_diagnostic_hash(
        kind_tag,
        from_hash,
        target.hash,
        target.edge_tag,
        text_declaration_span_width(source, index),
        match target.edge_tag == text_declaration_dependency_value_edge_tag() {
          true => text_declaration_dependency_diagnostic_code(
            source,
            from_hash,
            target.hash
          ),
          false => text_declaration_dependency_no_diagnostic_code(),
        }
      )
    ),
  }
}

fn text_declaration_dependency_signature_for_value_body(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  kind_tag: i32,
  total: i32
) -> i32 {
  let target = text_declaration_simple_dependency_target(source, index, decl);
  match target.found {
    false => total,
    true => text_signature_mix(
      total,
      text_declaration_dependency_hash(
        kind_tag,
        text_declaration_name_hash(source, index, decl),
        target.hash,
        target.edge_tag,
        text_declaration_span_width(source, index)
      )
    ),
  }
}

fn text_dependency_edge(
  kind_tag: i32,
  from_hash: i32,
  to_hash: i32,
  edge_tag: i32,
  span_width: i32
) -> TextDependencyEdge {
  TextDependencyEdge {
    kind_tag: kind_tag,
    from_hash: from_hash,
    to_hash: to_hash,
    edge_tag: edge_tag,
    span_width: span_width,
  }
}

fn TextDependencyGraph::empty() -> TextDependencyGraph {
  TextDependencyGraph {
    edges: layout.HeapArray::empty(TextDependencyEdge),
  }
}

fn TextDependencyGraph::push(
  graph: TextDependencyGraph,
  edge: TextDependencyEdge
) -> TextDependencyGraph {
  TextDependencyGraph {
    edges: layout.HeapArray::push(TextDependencyEdge, graph.edges, edge),
  }
}

fn TextDependencyGraph::add_decl(
  graph: TextDependencyGraph,
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> TextDependencyGraph {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  let target = text_declaration_simple_dependency_target(source, index, decl);
  match target.found {
    false => graph,
    true => TextDependencyGraph::push(
      graph,
      text_dependency_edge(
        kind_tag,
        text_declaration_name_hash(source, index, decl),
        target.hash,
        target.edge_tag,
        text_declaration_span_width(source, index)
      )
    ),
  }
}

fn TextDependencyGraph::from_source_loop(
  source: textlex.TextTokenStream,
  current: combinator.ParseState,
  graph: TextDependencyGraph
) -> TextDependencyGraph {
  match current.cursor < textlex.length(source) {
    false => graph,
    true => match parse_text_declaration_stream(
      current,
      source,
      layout.HeapArray::len(TextDependencyEdge, graph.edges)
    ) {
      Err(_) => graph,
      Ok(result) => rec(
        source,
        next_text_declaration_state(result.state, source),
        TextDependencyGraph::add_decl(
          graph,
          source,
          current.cursor,
          result.value.decl
        )
      ),
    },
  }
}

fn TextDependencyGraph::from_source(
  source: textlex.TextTokenStream
) -> TextDependencyGraph {
  TextDependencyGraph::from_source_loop(
    source,
    textmodel.full_window_state(source),
    TextDependencyGraph::empty()
  )
}

fn TextDependencyGraph::edge_count(graph: TextDependencyGraph) -> i32 {
  layout.HeapArray::len(TextDependencyEdge, graph.edges)
}

fn TextDependencyGraph::edge_at(
  graph: TextDependencyGraph,
  index: i32
) -> TextDependencyEdge {
  layout.HeapArray::get(TextDependencyEdge, graph.edges, index)
}

fn TextDependencyGraph::reaches(
  graph: TextDependencyGraph,
  current_hash: i32,
  target_hash: i32,
  budget: i32
) -> bool {
  match current_hash == target_hash {
    true => true,
    false => match budget <= 0 {
      true => false,
      false => TextDependencyGraph::reach_scan(
        graph,
        current_hash,
        target_hash,
        budget,
        0
      ),
    },
  }
}

fn TextDependencyGraph::reach_scan(
  graph: TextDependencyGraph,
  current_hash: i32,
  target_hash: i32,
  budget: i32,
  index: i32
) -> bool {
  match index >= TextDependencyGraph::edge_count(graph) {
    true => false,
    false => TextDependencyGraph::edge_at(graph, index) \edge -> match
      edge.from_hash == current_hash {
      false => rec(graph, current_hash, target_hash, budget, index + 1),
      true => match edge.edge_tag == text_declaration_dependency_value_edge_tag() {
        false => rec(graph, current_hash, target_hash, budget, index + 1),
        true => match TextDependencyGraph::reaches(
          graph,
          edge.to_hash,
          target_hash,
          budget - 1
        ) {
          true => true,
          false => rec(graph, current_hash, target_hash, budget, index + 1),
        },
      },
    },
  }
}

fn TextDependencyGraph::diagnostic_code(
  graph: TextDependencyGraph,
  from_hash: i32,
  to_hash: i32
) -> i32 {
  match TextDependencyGraph::reaches(
    graph,
    to_hash,
    from_hash,
    TextDependencyGraph::edge_count(graph)
  ) {
    true => diagnostic.DiagnosticCodeScore::DependencyCycle,
    false => text_declaration_dependency_no_diagnostic_code(),
  }
}

fn TextDependencyGraph::edge_diagnostic_code(
  graph: TextDependencyGraph,
  edge: TextDependencyEdge
) -> i32 {
  match edge.edge_tag == text_declaration_dependency_value_edge_tag() {
    true => TextDependencyGraph::diagnostic_code(
      graph,
      edge.from_hash,
      edge.to_hash
    ),
    false => text_declaration_dependency_no_diagnostic_code(),
  }
}

fn TextDependencyGraph::diagnostic_signature_loop(
  graph: TextDependencyGraph,
  index: i32,
  total: i32
) -> i32 {
  match index >= TextDependencyGraph::edge_count(graph) {
    true => total,
    false => TextDependencyGraph::edge_at(graph, index) \edge -> rec(
      graph,
      index + 1,
      text_signature_mix(
        total,
        text_declaration_dependency_diagnostic_hash(
          edge.kind_tag,
          edge.from_hash,
          edge.to_hash,
          edge.edge_tag,
          edge.span_width,
          TextDependencyGraph::edge_diagnostic_code(graph, edge)
        )
      )
    ),
  }
}

fn TextDependencyGraph::diagnostic_signature(
  graph: TextDependencyGraph
) -> i32 {
  TextDependencyGraph::diagnostic_signature_loop(graph, 0, 0)
}

fn text_declaration_dependency_diagnostic_signature_for_source(
  source: textlex.TextTokenStream
) -> i32 {
  TextDependencyGraph::diagnostic_signature(
    TextDependencyGraph::from_source(source)
  )
}

fn text_declaration_named_type_environment_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  monad.Reader::run(
    text_declaration_named_type_environment_signature_total_reader(total),
    text_value_body_context(source, index, decl)
  )
}

fn text_declaration_direct_import_type_environment_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32,
  alias_hash: i32
) -> i32 {
  monad.Reader::run(
    text_declaration_direct_import_type_environment_signature_total_reader(
      total,
      alias_hash
    ),
    text_value_body_context(source, index, decl)
  )
}

fn text_direct_import_alias_hash_scan(
  source: textlex.TextTokenStream,
  scan: TextImportAliasScan
) -> i32 {
  if scan.index >= scan.limit {
    0
  } else {
    let is_import = match is_text_top_level_declaration_start(
      source,
      scan.index,
      scan.brace_depth,
      scan.paren_depth
    ) {
      true => is_text_source_import_start(source, scan.index),
      false => false,
    };
    let is_target = match is_import {
      true => text_source_import_module_hash(source, scan.index) == scan.module_hash,
      false => false,
    };
    match is_target {
      true => text_source_import_alias_hash(source, scan.index),
      false => text_direct_import_alias_hash_scan(
        source,
        text_import_alias_scan(
          scan.index + 1,
          scan.limit,
          brace_depth_after_token(source, scan.index, scan.brace_depth),
          paren_depth_after_token(source, scan.index, scan.paren_depth),
          scan.module_hash
        )
      ),
    }
  }
}

fn text_direct_import_alias_hash(
  source: textlex.TextTokenStream,
  module_hash: i32
) -> i32 {
  text_direct_import_alias_hash_scan(
    source,
    text_import_alias_scan(
      0,
      textlex.length(source),
      0,
      0,
      module_hash
    )
  )
}

fn text_direct_import_type_environment_signature(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  module_hash: i32
) -> i32 {
  let alias_hash = text_direct_import_alias_hash(source, module_hash);
  match alias_hash == 0 {
    true => 0,
    false => text_top_level_declaration_summary(
      import_source,
      text_summary_direct_import_type_environment_signature(),
      alias_hash
    ),
  }
}

fn text_dot_hash() -> i32 {
  textlex.TextCharCode::Dot
}

fn text_left_bracket_hash() -> i32 {
  textlex.TextCharCode::LeftBracket
}

fn text_right_bracket_hash() -> i32 {
  textlex.TextCharCode::RightBracket
}

fn text_imported_qualified_type_class_tag_at(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  alias_hash: i32
) -> i32 {
  let has_qualified_name = index + 2 < limit;
  let alias_matches = match has_qualified_name {
    true => textlex.text_hash_at(source, index) == alias_hash,
    false => false,
  };
  let dot_matches = match alias_matches {
    true => match textlex.punctuation_at(source, index + 1) {
      PunctOther => textlex.text_hash_at(source, index + 1) == text_dot_hash(),
      _ => false,
    },
    false => false,
  };
  match dot_matches {
    true => text_named_type_class_for_hash(
      import_source,
      textlex.text_hash_at(source, index + 2)
    ),
    false => text_type_class_unknown_tag(),
  }
}

fn text_direct_import_annotation_resolved_type_class_tag_from_index(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  alias_hash: i32
) -> i32 {
  let literal_type = text_annotation_literal_type_class_tag_for_token(
    source,
    index,
    limit
  );
  match literal_type == text_type_class_unknown_tag() {
    false => literal_type,
    true => text_imported_qualified_type_class_tag_at(
      source,
      import_source,
      index,
      limit,
      alias_hash
    ) \imported -> match imported == text_type_class_unknown_tag() {
      false => imported,
      true => text_annotation_resolved_type_class_tag_from_hash(
        source,
        textlex.text_hash_at(source, index)
      ),
    },
  }
}

fn text_direct_import_annotation_resolved_type_class_tag_between(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  alias_hash: i32
) -> i32 {
  match index >= limit {
    true => text_type_class_unknown_tag(),
    false => match text_param_signature_is_trivia(source, index) {
      true => text_direct_import_annotation_resolved_type_class_tag_between(
        source,
        import_source,
        index + 1,
        limit,
        alias_hash
      ),
      false => text_direct_import_annotation_resolved_type_class_tag_from_index(
        source,
        import_source,
        index,
        limit,
        alias_hash
      ),
    },
  }
}

fn text_function_return_direct_import_resolved_type_class_tag(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  index: i32,
  alias_hash: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  let arrow = text_function_arrow_index(source, close_paren, next);
  let left_brace = text_function_left_brace_index(source, arrow, next);
  let body_start = text_function_body_start_index(source, arrow, left_brace);
  text_direct_import_annotation_resolved_type_class_tag_between(
    source,
    import_source,
    arrow + 1,
    body_start,
    alias_hash
  )
}

fn text_value_annotation_direct_import_resolved_type_class_tag(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  index: i32,
  alias_hash: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let equal = text_find_top_level_punctuation_score(
    source,
    index + 2,
    next,
    0,
    1
  );
  let colon = text_find_top_level_punctuation_score(
    source,
    index + 2,
    equal,
    0,
    8
  );
  match colon < equal {
    true => text_direct_import_annotation_resolved_type_class_tag_between(
      source,
      import_source,
      colon + 1,
      equal,
      alias_hash
    ),
    false => text_type_class_unknown_tag(),
  }
}

fn text_declaration_direct_import_resolved_type_class_tag(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  alias_hash: i32
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  match text_declaration_kind_is_function(kind_tag) {
    true => text_type_class_function_tag(),
    false => match text_declaration_kind_is_value_binding(kind_tag) {
      true => text_value_annotation_direct_import_resolved_type_class_tag(
        source,
        import_source,
        index,
        alias_hash
      ),
      false => match text_declaration_kind_is_type(kind_tag) {
        true => text_type_declaration_environment_type_class_tag(
          source,
          index,
          kind_tag
        ),
        false => text_type_class_unknown_tag(),
      },
    },
  }
}

fn text_declaration_direct_import_resolved_type_class_payload(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  alias_hash: i32
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  match text_declaration_kind_is_function(kind_tag) {
    true => ast.decl_param_count(decl) * 31
      + text_function_return_direct_import_resolved_type_class_tag(
        source,
        import_source,
        index,
        alias_hash
      ),
    false => 0,
  }
}

fn text_declaration_direct_import_resolved_abi_class_tag(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  alias_hash: i32
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  match text_declaration_kind_is_function(kind_tag) {
    true => text_abi_class_function_tag(),
    false => match text_declaration_kind_is_value_binding(kind_tag) {
      true => text_abi_class_tag_for_type_class(
        text_value_annotation_direct_import_resolved_type_class_tag(
          source,
          import_source,
          index,
          alias_hash
        )
      ),
      false => match text_declaration_kind_is_type(kind_tag) {
        true => text_abi_class_tag_for_type_class(
          text_type_declaration_environment_type_class_tag(
            source,
            index,
            kind_tag
          )
        ),
        false => text_abi_class_void_tag(),
      },
    },
  }
}

fn text_direct_import_decl_kind_tag_reader() -> monad.Reader(
  TextDirectImportDeclarationContext,
  i32
) {
  do @monad(monad.Reader(TextDirectImportDeclarationContext, _)) {
    import_context <- monad.Reader::asks(text_direct_import_decl_import_context);
    index <- monad.Reader::asks(text_direct_import_decl_index);
    decl <- monad.Reader::asks(text_direct_import_decl_decl);
    pure(text_declaration_kind_tag(import_context.source, index, decl))
  }
}

