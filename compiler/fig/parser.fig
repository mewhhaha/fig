fn text_function_body_resolved_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let fallback = text_function_body_type_class_tag(source, index);
  match fallback == text_type_class_unknown_tag() {
    false => fallback,
    true => text_function_body_resolved_unknown_type_class_tag(source, index),
  }
}

fn text_function_body_resolved_unknown_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let body_start = text_function_body_value_start_index(source, index);
  let body_end = text_function_body_value_limit_index(source, index);
  let identifier_hash = text_expression_root_identifier_hash_between(
    source,
    body_start,
    body_end
  );
  let param_type = text_function_param_resolved_type_class_for_name_hash(
    source,
    index,
    identifier_hash
  );
  match param_type == text_type_class_unknown_tag() {
    false => param_type,
    true => text_function_local_let_resolved_type_class_for_name_hash(
      source,
      index,
      identifier_hash
    ) \local_type -> match local_type == text_type_class_unknown_tag() {
      false => local_type,
      true => match text_function_body_is_match_body(source, index) {
        false => text_type_class_unknown_tag(),
        true => text_match_body_literal_result_type_class_between(
          source,
          body_start,
          body_end
        ),
      } \match_body_type -> match match_body_type == text_type_class_unknown_tag() {
        false => match_body_type,
        true => text_function_body_simple_scalar_operator_type_class(
          source,
          index
        ) \operator_type -> match operator_type == text_type_class_unknown_tag() {
          false => operator_type,
          true => text_function_body_scalar_branch_type_class_between(
            source,
            index,
            body_start,
            body_end
          ) \branch_type -> match branch_type == text_type_class_unknown_tag() {
            false => branch_type,
            true => text_root_call_return_type_class_for_hash_between(
              source,
              body_start,
              body_end,
              text_expression_root_head_hash_between(source, body_start, body_end)
            ),
          },
        },
      },
    },
  }
}

fn text_root_call_return_type_class_for_hash_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  target_hash: i32
) -> i32 {
  let call_open = text_expression_root_call_open_between(source, index, limit);
  let head_limit = match call_open < limit {
    true => call_open,
    false => limit,
  };
  let operator_count = text_expression_root_operator_count_between(
    source,
    index,
    head_limit
  ) + text_expression_root_call_tail_operator_count_between(
    source,
    index,
    limit
  );
  let selector_count = text_expression_root_head_selector_count_between(
    source,
    index,
    head_limit
  );
  let field_count = text_expression_root_call_tail_field_count_between(
    source,
    index,
    limit
  );
  let pipe_bind_count = text_value_pipe_bind_count_between(
    source,
    index,
    limit,
    0
  );
  let call_arg_count = text_expression_root_call_arg_count_between(
    source,
    index,
    limit
  );
  match operator_count > 0 {
    true => text_type_class_unknown_tag(),
    false => match selector_count > 0 {
      true => text_type_class_unknown_tag(),
      false => match field_count > 0 {
        true => text_type_class_unknown_tag(),
        false => match pipe_bind_count > 0 {
          true => text_type_class_unknown_tag(),
          false => match call_arg_count == text_no_root_call_arg_count() {
            true => text_type_class_unknown_tag(),
            false => text_function_return_type_class_for_hash(source, target_hash),
          },
        },
      },
    },
  }
}

fn text_function_return_type_class_for_hash_scan(
  source: textlex.TextTokenStream,
  scan: TextNamedTypeLookupScan
) -> i32 {
  if scan.index >= scan.limit {
    text_type_class_unknown_tag()
  } else {
    let is_top_declaration = is_text_top_level_declaration_start(
      source,
      scan.index,
      scan.brace_depth,
      scan.paren_depth
    );
    let is_function = match is_top_declaration {
      true => text_declaration_kind_tag(source, scan.index, ast.empty_decl()) == 1,
      false => false,
    };
    let found = match is_function {
      true => textlex.text_hash_at(
        source,
        text_declaration_name_index(source, scan.index, ast.empty_decl())
      ) == scan.target_hash,
      false => false,
    };
    match found {
      true => text_function_return_resolved_type_class_tag(source, scan.index),
      false => text_function_return_type_class_for_hash_scan(
        source,
        TextNamedTypeLookupScan {
          index: scan.index + 1,
          limit: scan.limit,
          brace_depth: brace_depth_after_token(source, scan.index, scan.brace_depth),
          paren_depth: paren_depth_after_token(source, scan.index, scan.paren_depth),
          target_hash: scan.target_hash,
          depth: scan.depth,
        }
      ),
    }
  }
}

fn text_function_return_type_class_for_hash(
  source: textlex.TextTokenStream,
  target_hash: i32
) -> i32 {
  match target_hash == 0 {
    true => text_type_class_unknown_tag(),
    false => text_function_return_type_class_for_hash_scan(
      source,
      TextNamedTypeLookupScan {
        index: 0,
        limit: textlex.length(source),
        brace_depth: 0,
        paren_depth: 0,
        target_hash: target_hash,
        depth: 0,
      }
    ),
  }
}

fn text_named_symbol_type_class_for_hash_scan(
  source: textlex.TextTokenStream,
  scan: TextNamedTypeLookupScan
) -> i32 {
  if scan.index >= scan.limit {
    text_type_class_unknown_tag()
  } else {
    let is_top_declaration = is_text_top_level_declaration_start(
      source,
      scan.index,
      scan.brace_depth,
      scan.paren_depth
    );
    let found = match is_top_declaration {
      true => textlex.text_hash_at(
        source,
        text_declaration_name_index(source, scan.index, ast.empty_decl())
      ) == scan.target_hash,
      false => false,
    };
    match found {
      true => text_declaration_resolved_type_class_tag(
        source,
        scan.index,
        ast.empty_decl()
      ),
      false => text_named_symbol_type_class_for_hash_scan(
        source,
        TextNamedTypeLookupScan {
          index: scan.index + 1,
          limit: scan.limit,
          brace_depth: brace_depth_after_token(source, scan.index, scan.brace_depth),
          paren_depth: paren_depth_after_token(source, scan.index, scan.paren_depth),
          target_hash: scan.target_hash,
          depth: scan.depth,
        }
      ),
    }
  }
}

fn text_named_symbol_type_class_for_hash(
  source: textlex.TextTokenStream,
  target_hash: i32
) -> i32 {
  match target_hash == 0 {
    true => text_type_class_unknown_tag(),
    false => text_named_symbol_type_class_for_hash_scan(
      source,
      TextNamedTypeLookupScan {
        index: 0,
        limit: textlex.length(source),
        brace_depth: 0,
        paren_depth: 0,
        target_hash: target_hash,
        depth: 0,
      }
    ),
  }
}

fn text_value_declaration_body_resolved_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let fallback = text_value_declaration_body_type_class_tag(source, index);
  match fallback == text_type_class_unknown_tag() {
    false => fallback,
    true => text_value_declaration_body_resolved_unknown_type_class_tag(
      source,
      index
    ),
  }
}

fn text_value_declaration_body_resolved_unknown_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let body_start = text_value_declaration_body_start_index(source, index);
  let body_end = text_declaration_end_from_index(source, index);
  let identifier_hash = text_expression_root_identifier_hash_between(
    source,
    body_start,
    body_end
  );
  let symbol_type = text_named_symbol_type_class_for_hash(
    source,
    identifier_hash
  );
  match symbol_type == text_type_class_unknown_tag() {
    false => symbol_type,
    true => text_root_call_return_type_class_for_hash_between(
      source,
      body_start,
      body_end,
      text_expression_root_head_hash_between(source, body_start, body_end)
    ),
  }
}

fn text_declaration_resolved_value_body_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  match text_declaration_kind_tag(source, index, decl) {
    1 => text_function_body_resolved_type_class_tag(source, index),
    2 => text_value_declaration_body_resolved_type_class_tag(source, index),
    3 => text_value_declaration_body_resolved_type_class_tag(source, index),
    _ => text_type_class_unknown_tag(),
  }
}

fn text_value_body_type_class_hash(kind_tag: i32, type_class: i32) -> i32 {
  text_signature_mix(
    text_signature_mix(31, kind_tag),
    type_class
  )
}

fn text_value_body_abi_class_hash(kind_tag: i32, abi_class: i32) -> i32 {
  text_signature_mix(
    text_signature_mix(37, kind_tag),
    abi_class
  )
}

fn text_declaration_value_body_type_class_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  text_signature_mix(
    total,
    text_value_body_type_class_hash(
      kind_tag,
      text_declaration_value_body_type_class_tag(source, index, decl)
    )
  )
}

fn text_declaration_value_body_abi_class_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  let type_class = text_declaration_value_body_type_class_tag(source, index, decl);
  text_signature_mix(
    total,
    text_value_body_abi_class_hash(
      kind_tag,
      text_abi_class_tag_for_type_class(type_class)
    )
  )
}

fn text_declaration_resolved_value_body_type_class_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  text_signature_mix(
    total,
    text_value_body_type_class_hash(
      kind_tag,
      text_declaration_resolved_value_body_type_class_tag(source, index, decl)
    )
  )
}

fn text_declaration_resolved_value_body_abi_class_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  let type_class = text_declaration_resolved_value_body_type_class_tag(
    source,
    index,
    decl
  );
  text_signature_mix(
    total,
    text_value_body_abi_class_hash(
      kind_tag,
      text_abi_class_tag_for_type_class(type_class)
    )
  )
}

fn text_declaration_expected_body_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  match text_declaration_kind_tag(source, index, decl) {
    1 => text_function_return_type_class_tag(source, index),
    2 => text_value_annotation_type_class_tag(source, index),
    3 => text_value_annotation_type_class_tag(source, index),
    _ => text_type_class_unknown_tag(),
  }
}

fn text_type_check_unknown_tag() -> i32 {
  0
}

fn text_type_check_match_tag() -> i32 {
  1
}

fn text_type_check_mismatch_tag() -> i32 {
  2
}

fn text_simple_body_type_check_status(
  expected: i32,
  actual: i32
) -> i32 {
  match expected == text_type_class_unknown_tag() {
    true => text_type_check_unknown_tag(),
    false => match actual == text_type_class_unknown_tag() {
      true => text_type_check_unknown_tag(),
      false => match expected == actual {
        true => text_type_check_match_tag(),
        false => text_type_check_mismatch_tag(),
      },
    },
  }
}

fn text_simple_body_type_check_hash(
  kind_tag: i32,
  expected: i32,
  actual: i32,
  status: i32
) -> i32 {
  text_signature_mix(
    text_signature_mix(
      text_signature_mix(
        text_signature_mix(41, kind_tag),
        expected
      ),
      actual
    ),
    status
  )
}

fn text_declaration_simple_body_type_check_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  let expected = text_declaration_expected_body_type_class_tag(source, index, decl);
  let actual = text_declaration_value_body_type_class_tag(source, index, decl);
  text_signature_mix(
    total,
    text_simple_body_type_check_hash(
      kind_tag,
      expected,
      actual,
      text_simple_body_type_check_status(expected, actual)
    )
  )
}

fn text_named_type_environment_hash(name_hash: i32, type_class: i32) -> i32 {
  text_signature_mix(
    text_signature_mix(43, name_hash),
    type_class
  )
}

fn text_direct_import_type_environment_hash(
  alias_hash: i32,
  name_hash: i32,
  type_class: i32
) -> i32 {
  text_signature_mix(
    text_signature_mix(
      text_signature_mix(47, alias_hash),
      name_hash
    ),
    type_class
  )
}

fn text_source_import_edge_hash(alias_hash: i32, module_hash: i32) -> i32 {
  text_signature_mix(
    text_signature_mix(89, alias_hash),
    module_hash
  )
}

fn text_source_import_graph_no_diagnostic_code() -> i32 {
  0
}

fn text_source_import_declaration_span_width(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let start = textlex.token_at(source, index).span;
  let end_index = text_declaration_end_from_index(source, index) - 1;
  let finish = textlex.token_at(source, end_index).span;
  finish.end - start.start
}

fn text_source_import_graph_diagnostic_hash(
  alias_hash: i32,
  module_hash: i32,
  span_width: i32,
  diagnostic_code: i32
) -> i32 {
  text_signature_mix(
    text_signature_mix(
      text_signature_mix(
        text_signature_mix(97, alias_hash),
        module_hash
      ),
      span_width
    ),
    diagnostic_code
  )
}

fn text_declaration_source_import_edge_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  match text_declaration_kind_tag(source, index, decl) {
    5 => text_signature_mix(
      total,
      text_source_import_edge_hash(
        textlex.text_hash_at(source, index + 1),
        text_source_import_module_hash(source, index)
      )
    ),
    _ => total,
  }
}

fn text_declaration_source_import_graph_diagnostic_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  match text_declaration_kind_tag(source, index, decl) {
    5 => text_signature_mix(
      total,
      text_source_import_graph_diagnostic_hash(
        textlex.text_hash_at(source, index + 1),
        text_source_import_module_hash(source, index),
        text_source_import_declaration_span_width(source, index),
        text_source_import_graph_no_diagnostic_code()
      )
    ),
    _ => total,
  }
}

fn text_declaration_dependency_value_edge_tag() -> i32 {
  11
}

fn text_declaration_dependency_qualified_value_edge_tag() -> i32 {
  12
}

fn text_declaration_span_width(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let start = textlex.token_at(source, index).span;
  let end_index = text_declaration_end_from_index(source, index) - 1;
  let finish = textlex.token_at(source, end_index).span;
  finish.end - start.start
}

fn text_declaration_dependency_hash(
  kind_tag: i32,
  from_hash: i32,
  to_hash: i32,
  edge_tag: i32,
  span_width: i32
) -> i32 {
  text_signature_mix(
    text_signature_mix(
      text_signature_mix(
        text_signature_mix(
          text_signature_mix(103, kind_tag),
          from_hash
        ),
        to_hash
      ),
      edge_tag
    ),
    span_width
  )
}

fn text_declaration_dependency_no_diagnostic_code() -> i32 {
  0
}

fn text_declaration_has_dependency_body_kind_tag(kind_tag: i32) -> bool {
  match kind_tag == 1 {
    true => true,
    false => match kind_tag == 2 {
      true => true,
      false => kind_tag == 3,
    },
  }
}

fn text_declaration_no_dependency_target() -> TextDeclarationDependencyTarget {
  TextDeclarationDependencyTarget {
    found: false,
    hash: 0,
    edge_tag: 0,
  }
}

fn text_declaration_dependency_target(
  hash: i32,
  edge_tag: i32
) -> TextDeclarationDependencyTarget {
  TextDeclarationDependencyTarget {
    found: true,
    hash: hash,
    edge_tag: edge_tag,
  }
}

fn text_declaration_simple_dependency_target(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> TextDeclarationDependencyTarget {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  match text_declaration_has_dependency_body_kind_tag(kind_tag) {
    false => text_declaration_no_dependency_target(),
    true => match text_declaration_root_head_kind_tag(source, index, decl) ==
      text_expression_root_identifier_tag() {
      false => text_declaration_no_dependency_target(),
      true => match text_declaration_root_head_selector_count(source, index, decl) == 0 {
        true => text_declaration_dependency_target(
          text_declaration_root_head_hash(source, index, decl),
          text_declaration_dependency_value_edge_tag()
        ),
        false => text_declaration_root_qualified_head_hash(source, index, decl)
          \qualified_hash -> match qualified_hash == 0 {
          true => text_declaration_no_dependency_target(),
          false => text_declaration_dependency_target(
            qualified_hash,
            text_declaration_dependency_qualified_value_edge_tag()
          ),
        },
      },
    },
  }
}

fn text_declaration_count_scan(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  brace_depth: i32,
  paren_depth: i32,
  total: i32
) -> i32 {
  match index >= limit {
    true => total,
    false => rec(
      source,
      index + 1,
      limit,
      brace_depth_after_token(source, index, brace_depth),
      paren_depth_after_token(source, index, paren_depth),
      match is_text_top_level_declaration_start(
        source,
        index,
        brace_depth,
        paren_depth
      ) {
        true => total + 1,
        false => total,
      }
    ),
  }
}

fn text_declaration_dependency_reach_budget(
  source: textlex.TextTokenStream
) -> i32 {
  text_declaration_count_scan(
    source,
    0,
    textlex.length(source),
    0,
    0,
    0
  )
}

fn text_declaration_dependency_reaches(
  source: textlex.TextTokenStream,
  current_hash: i32,
  target_hash: i32,
  budget: i32
) -> bool {
  match current_hash == target_hash {
    true => true,
    false => match budget <= 0 {
      true => false,
      false => text_declaration_dependency_reach_scan(
        source,
        TextDependencyReachScan {
          index: 0,
          limit: textlex.length(source),
          brace_depth: 0,
          paren_depth: 0,
          current_hash: current_hash,
          target_hash: target_hash,
          budget: budget,
        }
      ),
    },
  }
}

fn text_declaration_dependency_reach_scan_next(
  source: textlex.TextTokenStream,
  scan: TextDependencyReachScan
) -> TextDependencyReachScan {
  TextDependencyReachScan {
    index: scan.index + 1,
    limit: scan.limit,
    brace_depth: brace_depth_after_token(source, scan.index, scan.brace_depth),
    paren_depth: paren_depth_after_token(source, scan.index, scan.paren_depth),
    current_hash: scan.current_hash,
    target_hash: scan.target_hash,
    budget: scan.budget,
  }
}

fn text_declaration_dependency_reach_candidate(
  source: textlex.TextTokenStream,
  scan: TextDependencyReachScan
) -> bool {
  let next_target = text_declaration_simple_dependency_target(
    source,
    scan.index,
    ast.empty_decl()
  );
  match next_target.found {
    true => text_declaration_dependency_reach_found_candidate(source, scan, next_target),
    false => false,
  }
}

fn text_declaration_dependency_reach_found_candidate(
  source: textlex.TextTokenStream,
  scan: TextDependencyReachScan,
  target: TextDeclarationDependencyTarget
) -> bool {
  match target.edge_tag == text_declaration_dependency_value_edge_tag() {
    false => false,
    true => text_declaration_dependency_reaches(
      source,
      target.hash,
      scan.target_hash,
      scan.budget - 1
    ),
  }
}

fn text_declaration_dependency_reach_scan(
  source: textlex.TextTokenStream,
  scan: TextDependencyReachScan
) -> bool {
  match scan.index >= scan.limit {
    true => false,
    false => match is_text_top_level_declaration_start(
      source,
      scan.index,
      scan.brace_depth,
      scan.paren_depth
    ) {
      true => match textlex.text_hash_at(
        source,
        text_declaration_name_index(source, scan.index, ast.empty_decl())
      ) == scan.current_hash {
        true => match text_declaration_dependency_reach_candidate(source, scan) {
          true => true,
          false => text_declaration_dependency_reach_scan(
            source,
            text_declaration_dependency_reach_scan_next(source, scan)
          ),
        },
        false => text_declaration_dependency_reach_scan(
          source,
          text_declaration_dependency_reach_scan_next(source, scan)
        ),
      },
      false => text_declaration_dependency_reach_scan(
        source,
        text_declaration_dependency_reach_scan_next(source, scan)
      ),
    },
  }
}

fn text_declaration_dependency_diagnostic_code(
  source: textlex.TextTokenStream,
  from_hash: i32,
  to_hash: i32
) -> i32 {
  match text_declaration_dependency_reaches(
    source,
    to_hash,
    from_hash,
    text_declaration_dependency_reach_budget(source)
  ) {
    true => diagnostic.DiagnosticCodeScore::DependencyCycle,
    false => text_declaration_dependency_no_diagnostic_code(),
  }
}

fn text_declaration_dependency_diagnostic_hash(
  kind_tag: i32,
  from_hash: i32,
  to_hash: i32,
  edge_tag: i32,
  span_width: i32,
  diagnostic_code: i32
) -> i32 {
  text_signature_mix(
    text_signature_mix(
      text_signature_mix(
        text_signature_mix(
          text_signature_mix(
            text_signature_mix(107, kind_tag),
            from_hash
          ),
          to_hash
        ),
        edge_tag
      ),
      span_width
    ),
    diagnostic_code
  )
}

fn text_declaration_dependency_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  match kind_tag == 1 {
    true => text_declaration_dependency_signature_for_value_body(
      source,
      index,
      decl,
      kind_tag,
      total
    ),
    false => match kind_tag == 2 {
      true => text_declaration_dependency_signature_for_value_body(
        source,
        index,
        decl,
        kind_tag,
        total
      ),
      false => match kind_tag == 3 {
        true => text_declaration_dependency_signature_for_value_body(
          source,
          index,
          decl,
          kind_tag,
          total
        ),
        false => total,
      },
    },
  }
}

fn text_declaration_dependency_diagnostic_signature_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  match kind_tag == 1 {
    true => text_declaration_dependency_diagnostic_signature_for_value_body(
      source,
      index,
      decl,
      kind_tag,
      total
    ),
    false => match kind_tag == 2 {
      true => text_declaration_dependency_diagnostic_signature_for_value_body(
        source,
        index,
        decl,
        kind_tag,
        total
      ),
      false => match kind_tag == 3 {
        true => text_declaration_dependency_diagnostic_signature_for_value_body(
          source,
          index,
          decl,
          kind_tag,
          total
        ),
        false => total,
      },
    },
  }
}

fn text_declaration_dependency_diagnostic_signature_for_value_body(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  kind_tag: i32,
  total: i32
) -> i32 {
  let target = text_declaration_simple_dependency_target(source, index, decl);
  match target.found {
    false => total,
    true => textlex.text_hash_at(source, text_declaration_name_index(source, index, decl))
      \from_hash -> text_signature_mix(
      total,
      text_declaration_dependency_diagnostic_hash(
        kind_tag,
        from_hash,
        target.hash,
        target.edge_tag,
        text_declaration_span_width(source, index),
        match target.edge_tag == text_declaration_dependency_value_edge_tag() {
          true => text_declaration_dependency_diagnostic_code(
            source,
            from_hash,
            target.hash
          ),
          false => text_declaration_dependency_no_diagnostic_code(),
        }
      )
    ),
  }
}

fn text_declaration_dependency_signature_for_value_body(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  kind_tag: i32,
  total: i32
) -> i32 {
  let target = text_declaration_simple_dependency_target(source, index, decl);
  match target.found {
    false => total,
    true => text_signature_mix(
      total,
      text_declaration_dependency_hash(
        kind_tag,
        textlex.text_hash_at(source, text_declaration_name_index(source, index, decl)),
        target.hash,
        target.edge_tag,
        text_declaration_span_width(source, index)
      )
    ),
  }
}

