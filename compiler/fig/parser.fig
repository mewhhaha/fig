) -> i32 {
  text_declaration_value_body_count_delta(
    source,
    index,
    decl,
    TextValueBodyDoCount
  )
}

fn text_do_bind_left_hash() -> i32 {
  textlex.TextCharCode::Less
}

fn text_do_bind_minus_hash() -> i32 {
  textlex.TextCharCode::Minus
}

fn text_value_do_bind_token_matches(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match punctuation_matches(source, index, textlex.PunctOther) {
    false => false,
    true => match textlex.text_hash_at(source, index) == text_do_bind_left_hash() {
      false => false,
      true => match punctuation_matches(source, index + 1, textlex.PunctOther) {
        false => false,
        true => textlex.text_hash_at(source, index + 1) == text_do_bind_minus_hash(),
      },
    },
  }
}

fn text_value_do_bind_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32
) -> i32 {
  text_value_body_count_scan(source, index, limit, total, TextValueBodyDoBindCount)
}

fn text_declaration_value_do_bind_count_delta(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  text_declaration_value_body_count_delta(
    source,
    index,
    decl,
    TextValueBodyDoBindCount
  )
}

fn text_value_match_arm_token_matches(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  let is_equal = punctuation_matches(source, index, textlex.PunctEqual);
  let is_arrow_tail = punctuation_matches(source, index + 1, textlex.PunctOther);
  let has_arrow_hash = textlex.text_hash_at(source, index + 1) == 62;
  is_equal && is_arrow_tail && has_arrow_hash
}

fn text_value_if_token_matches(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match text_token_weight_matches(source, index, 89) {
    false => false,
    true => text_bool_not(text_value_if_token_is_match_guard(source, index)),
  }
}

fn text_value_if_token_is_match_guard(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  text_value_if_token_has_guard_arrow(
    source,
    TextBoolMatchTokenScan {
      index: index + 1,
      limit: textlex.length(source),
      paren_depth: 0,
      brace_depth: 0,
      bracket_depth: 0,
    }
  )
}

fn text_bool_match_token_scan_advance(
  source: textlex.TextTokenStream,
  scan: TextBoolMatchTokenScan
) -> TextBoolMatchTokenScan {
  TextBoolMatchTokenScan {
    index: scan.index + 1,
    limit: scan.limit,
    paren_depth: paren_depth_after_token(
      source,
      scan.index,
      scan.paren_depth
    ),
    brace_depth: brace_depth_after_token(
      source,
      scan.index,
      scan.brace_depth
    ),
    bracket_depth: text_argument_scan_bracket_delta(
      source,
      scan.index,
      scan.bracket_depth
    ),
  }
}

fn text_value_if_guard_scan_is_top_level(scan: TextBoolMatchTokenScan) -> bool {
  let depth_top = text_depth_is_top_level(scan.brace_depth, scan.paren_depth);
  let bracket_top = scan.bracket_depth == 0;
  depth_top && bracket_top
}

fn text_value_if_guard_scan_should_stop(
  source: textlex.TextTokenStream,
  scan: TextBoolMatchTokenScan
) -> bool {
  match textlex.punctuation_at(source, scan.index) {
    PunctSemicolon => true,
    PunctRightBrace => true,
    _ => false,
  }
}

fn text_value_if_token_has_guard_arrow(
  source: textlex.TextTokenStream,
  scan: TextBoolMatchTokenScan
) -> bool {
  match scan.index >= scan.limit {
    true => false,
    false => match text_value_if_guard_scan_is_top_level(scan) {
      false => rec(source, text_bool_match_token_scan_advance(source, scan)),
      true => match text_value_match_arm_token_matches(source, scan.index) {
        true => true,
        false => match text_value_if_guard_scan_should_stop(source, scan) {
          true => false,
          false => rec(source, text_bool_match_token_scan_advance(source, scan)),
        },
      },
    },
  }
}

fn text_value_match_arm_delta(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  match text_value_match_arm_token_matches(source, index) {
    true => 1,
    false => match text_value_if_token_matches(source, index) {
      true => 2,
      false => 0,
    },
  }
}

fn text_value_match_arm_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32
) -> i32 {
  text_value_body_count_scan(source, index, limit, total, TextValueBodyMatchArmCount)
}

fn text_declaration_value_match_arm_count_delta(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  text_declaration_value_body_count_delta(
    source,
    index,
    decl,
    TextValueBodyMatchArmCount
  )
}

fn text_pipe_bind_token_matches(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match punctuation_matches(source, index, textlex.PunctOther) {
    false => false,
    true => textlex.text_hash_at(source, index) == 92,
  }
}

fn text_token_can_end_value_expr(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match textlex.punctuation_at(source, index) {
    PunctRightParen => true,
    PunctRightBrace => true,
    PunctOther => match textlex.text_hash_at(source, index) == text_right_bracket_hash() {
      true => true,
      false => false,
    },
    _ => match text_token_weight_matches(
      source,
      index,
      token.TokenKindWeight::BoolLiteral
    ) {
      true => true,
      false => match textlex.token_at(source, index).kind {
        Identifier => true,
        LiteralType => true,
        NumberLiteral => true,
        StringLiteral => true,
        CharLiteral => true,
        MultilineLiteral => true,
        _ => false,
      },
    },
  }
}

fn text_value_pipe_bind_token_matches(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match text_pipe_bind_token_matches(source, index) {
    false => false,
    true => text_token_can_end_value_expr(source, index - 1),
  }
}

fn text_root_pipe_bind_scan_is_top_level(scan: TextRootPipeBindScan) -> bool {
  match scan.paren_depth == 0 {
    true => match scan.brace_depth == 0 {
      true => scan.bracket_depth == 0,
      false => false,
    },
    false => false,
  }
}

fn text_root_pipe_bind_scan_step(
  source: textlex.TextTokenStream,
  scan: TextRootPipeBindScan
) -> TextRootPipeBindScan {
  let is_top_level = text_root_pipe_bind_scan_is_top_level(scan);
  let current_matches = match is_top_level {
    true => match scan.index > scan.start {
      true => text_value_pipe_bind_token_matches(source, scan.index),
      false => false,
    },
    false => false,
  };
  TextRootPipeBindScan {
    index: scan.index + 1,
    start: scan.start,
    limit: scan.limit,
    paren_depth: paren_depth_after_token(source, scan.index, scan.paren_depth),
    brace_depth: brace_depth_after_token(source, scan.index, scan.brace_depth),
    bracket_depth: text_argument_scan_bracket_delta(
      source,
      scan.index,
      scan.bracket_depth
    ),
    result: match current_matches {
      true => scan.index,
      false => scan.result,
    },
    done: current_matches,
  }
}

fn text_root_pipe_bind_scan_loop(
  source: textlex.TextTokenStream,
  scan: TextRootPipeBindScan
) -> TextRootPipeBindScan {
  match scan.done {
    true => scan,
    false => match scan.index >= scan.limit {
      true => scan,
      false => text_root_pipe_bind_scan_loop(
        source,
        text_root_pipe_bind_scan_step(source, scan)
      ),
    },
  }
}

fn text_root_pipe_bind_index_from_start(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> i32 {
  text_root_pipe_bind_scan_loop(
    source,
    TextRootPipeBindScan {
      index: start,
      start: start,
      limit: limit,
      paren_depth: 0,
      brace_depth: 0,
      bracket_depth: 0,
      result: limit,
      done: false,
    }
  ).result
}

fn text_pipe_bind_arrow_index(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  match index >= limit {
    true => limit,
    false => match punctuation_matches(source, index, textlex.PunctArrow) {
      true => index,
      false => text_pipe_bind_arrow_index(source, index + 1, limit),
    },
  }
}

fn text_pipe_bind_body_start_index(
  source: textlex.TextTokenStream,
  pipe_index: i32,
  limit: i32
) -> i32 {
  let arrow = text_pipe_bind_arrow_index(source, pipe_index + 1, limit);
  match arrow < limit {
    true => arrow + 1,
    false => limit,
  }
}

fn text_value_pipe_bind_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32
) -> i32 {
  text_value_body_count_scan(source, index, limit, total, TextValueBodyPipeBindCount)
}

