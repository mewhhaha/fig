  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  monad.Reader::run(
    text_declaration_function_match_body_count_reader(),
    text_value_body_context(source, index, decl)
  )
}

fn text_pub_function_decl_parser(seed: i32) -> textparser.TextParser(DeclFrame) {
  do @applicative(textparser.TextParser(_)) {
    textparser.expect_kind(token.PubKw, 1);
    fn_decl <- text_function_decl_parser(seed);
    pure(pub_function_decl_from_frame(fn_decl))
  }
}

fn parse_text_function_tail(
  current: combinator.ParseState,
  source: textlex.TextTokenStream,
  seed: i32
) -> combinator.Parser(DeclFrame) {
  parse_text_function_boundary(current, source, seed)
}

fn parse_text_pub_function_tail(
  current: combinator.ParseState,
  source: textlex.TextTokenStream,
  seed: i32
) -> combinator.Parser(DeclFrame) {
  parse_text_function_boundary(current, source, seed)
}

fn parse_text_value_tail(
  kind: token.DeclarationKind,
  current: combinator.ParseState,
  source: textlex.TextTokenStream,
  seed: i32
) -> combinator.Parser(DeclFrame) {
  let name = textlex.token_at(source, current.cursor + 1);
  let context = text_value_decl_context(
    kind,
    name,
    current.cursor,
    current.limit,
    source,
    seed
  );
  match punctuation_matches(source, current.cursor + 2, textlex.PunctColon) {
    true => value_tail_from_annotation(
      context,
      parse_text_type_annotation(
        combinator.state(current.cursor + 3, current.limit),
        source
      )
    ),
    false => parse_text_value_body(
      context,
      ast.missing_type(),
      current.cursor + 2
    ),
  }
}

fn text_value_annotation_signature_hash(
  source: textlex.TextTokenStream,
  index: i32,
  total: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let equal = text_find_top_level_punctuation_score(
    source,
    index + 2,
    next,
    0,
    1
  );
  let colon = text_find_top_level_punctuation_score(
    source,
    index + 2,
    equal,
    0,
    8
  );
  match colon < equal {
    true => text_signature_mix(
      total,
      text_annotation_signature_hash_between(
        source,
        colon + 1,
        equal,
        0
      )
    ),
    false => total,
  }
}

fn text_type_result_kind_struct_hash() -> i32 {
  347397349
}

fn text_type_result_kind_union_hash() -> i32 {
  142823945
}

fn text_type_result_kind_members_hash() -> i32 {
  0 - 1173303669
}

fn text_type_result_kind_type_tag() -> i32 {
  1
}

fn text_type_result_kind_struct_tag() -> i32 {
  2
}

fn text_type_result_kind_union_tag() -> i32 {
  3
}

fn text_type_result_kind_members_tag() -> i32 {
  4
}

fn text_type_result_kind_tag_from_hash(value_hash: i32) -> i32 {
  match value_hash == text_type_result_kind_struct_hash() {
    true => text_type_result_kind_struct_tag(),
    false => match value_hash == text_type_result_kind_union_hash() {
      true => text_type_result_kind_union_tag(),
      false => match value_hash == text_type_result_kind_members_hash() {
        true => text_type_result_kind_members_tag(),
        false => text_type_result_kind_type_tag(),
      },
    },
  }
}

fn text_type_name_index(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  match is_text_type_function_start(source, index) {
    true => index + 2,
    false => index + 1,
  }
}

fn text_type_function_result_kind_tag(
  source: textlex.TextTokenStream,
  index: i32,
  next: i32
) -> i32 {
  let name_index = text_type_name_index(source, index);
  let open_paren = find_text_punctuation_score(
    source,
    name_index + 1,
    next,
    2
  );
  let close_paren = find_text_matching_right_paren(
    source,
    open_paren + 1,
    next,
    0
  );
  match punctuation_score_matches(source, close_paren + 1, 4) {
    true => text_type_result_kind_tag_from_hash(
      textlex.text_hash_at(source, close_paren + 2)
    ),
    false => text_type_result_kind_type_tag(),
  }
}

fn text_type_sugar_result_kind_tag(
  source: textlex.TextTokenStream,
  index: i32,
  next: i32
) -> i32 {
  let equal = text_find_top_level_punctuation_score(
    source,
    index + 2,
    next,
    0,
    1
  );
  match equal < next {
    true => text_type_result_kind_tag_from_hash(
      textlex.text_hash_at(source, equal + 1)
    ),
    false => text_type_result_kind_type_tag(),
  }
}

fn text_type_sugar_equal_index(
  source: textlex.TextTokenStream,
  index: i32,
  next: i32
) -> i32 {
  text_find_top_level_punctuation_score(
    source,
    index + 2,
    next,
    0,
    1
  )
}

fn text_type_result_kind_tag(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  match is_text_type_function_start(source, index) {
    true => text_type_function_result_kind_tag(source, index, next),
    false => text_type_sugar_result_kind_tag(source, index, next),
  }
}

fn text_type_sugar_union_statement_count(
  source: textlex.TextTokenStream,
  equal: i32,
  next: i32
) -> i32 {
  let left_brace = find_text_punctuation_score(
    source,
    equal + 1,
    next,
    5
  );
  let right_brace = find_text_expression_limit(
    source,
    left_brace + 1,
    next,
    textlex.PunctRightBrace
  );
  count_text_signature_params(source, left_brace, right_brace)
}

fn text_type_sugar_statement_count_from_kind(
  source: textlex.TextTokenStream,
  kind_tag: i32,
  equal: i32,
  next: i32
) -> i32 {
  match kind_tag == text_type_result_kind_struct_tag() {
    true => 1,
    false => match kind_tag == text_type_result_kind_union_tag() {
      true => text_type_sugar_union_statement_count(source, equal, next),
      false => 0,
    },
  }
}

fn text_type_sugar_statement_count(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let equal = text_type_sugar_equal_index(source, index, next);
  let kind_tag = match equal < next {
    true => text_type_result_kind_tag_from_hash(
      textlex.text_hash_at(source, equal + 1)
    ),
    false => text_type_result_kind_type_tag(),
  };
  text_type_sugar_statement_count_from_kind(source, kind_tag, equal, next)
}

fn text_type_param_count(
  source: textlex.TextTokenStream,
  index: i32,
  next: i32
) -> i32 {
  let name_index = text_type_name_index(source, index);
  match punctuation_score_matches(source, name_index + 1, 2) {
    false => 0,
    true => count_text_signature_params(
      source,
      name_index + 1,
      find_text_matching_right_paren(
        source,
        name_index + 2,
        next,
        0
      )
    ),
  }
}

fn text_type_param_signature_hash(
  source: textlex.TextTokenStream,
  index: i32,
  next: i32,
  total: i32
) -> i32 {
  let name_index = text_type_name_index(source, index);
  match punctuation_score_matches(source, name_index + 1, 2) {
    false => total,
    true => text_type_param_list_signature_hash(
      source,
      name_index + 1,
      find_text_matching_right_paren(
        source,
        name_index + 2,
        next,
        0
      ),
      total
    ),
  }
}

fn parse_text_type_tail(
  current: combinator.ParseState,
  source: textlex.TextTokenStream
) -> combinator.Parser(DeclFrame) {
  let next = text_declaration_end_from_index(source, current.cursor);
  let name = textlex.token_at(source, text_type_name_index(source, current.cursor));
  ok_decl(
    combinator.state(next, current.limit),
    declaration_frame(
      ast.type_decl(
        token.token_score(name),
        text_type_param_count(source, current.cursor, next)
      ),
      next - current.cursor
    )
  )
}

fn text_type_sugar_body_signature_hash(
  source: textlex.TextTokenStream,
  index: i32,
  total: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let equal = text_find_top_level_punctuation_score(
    source,
    index + 2,
    next,
    0,
    1
  );
  let body_hash = match equal < next {
    true => text_annotation_signature_hash_between(
      source,
      equal + 1,
      next,
      0
    ),
    false => 0,
  };
  text_signature_mix(total, body_hash)
}

fn text_type_sugar_equal_starts_enum(
  source: textlex.TextTokenStream,
  equal: i32,
  next: i32
) -> bool {
  let start = text_expression_start_skip_trivia(source, equal + 1, next);
  match start < next {
    true => text_token_weight_matches(source, start, token.TokenKindWeight::EnumKw),
    false => false,
  }
}

fn text_type_sugar_is_enum_declaration(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  let next = text_declaration_end_from_index(source, index);
  let equal = text_type_sugar_equal_index(source, index, next);
  match text_token_weight_matches(source, index, token.TokenKindWeight::TypeKw) {
    false => false,
    true => match is_text_type_function_start(source, index) {
      true => false,
      false => match equal < next {
        true => text_type_sugar_equal_starts_enum(source, equal, next),
        false => false,
      },
    },
  }
}

fn text_type_sugar_enum_backing_hash(
  source: textlex.TextTokenStream,
  equal: i32,
  next: i32
) -> i32 {
  let open_paren = find_text_punctuation_score(
    source,
    equal + 1,
    next,
    textlex.punctuation_score(textlex.PunctLeftParen)
  );
  match open_paren < next {
    false => 0,
    true => text_annotation_signature_hash_between(
      source,
      open_paren + 1,
      find_text_matching_right_paren(source, open_paren + 1, next, 0),
      0
    ),
  }
}

fn text_type_sugar_enum_left_brace(
  source: textlex.TextTokenStream,
  equal: i32,
  next: i32
) -> i32 {
  find_text_punctuation_score(
    source,
    equal + 1,
    next,
    textlex.punctuation_score(textlex.PunctLeftBrace)
  )
}

fn text_type_sugar_enum_right_brace(
  source: textlex.TextTokenStream,
  left_brace: i32,
  next: i32
) -> i32 {
  match left_brace < next {
    true => find_text_expression_limit(
      source,
      left_brace + 1,
      next,
      textlex.PunctRightBrace
    ),
    false => next,
  }
}

fn text_enum_variant_value_limit(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let comma = text_find_top_level_punctuation_score(
    source,
    index,
    limit,
    0,
    textlex.punctuation_score(textlex.PunctComma)
  );
  match comma < limit {
    true => comma,
    false => limit,
  }
}

fn text_enum_variant_next_index(value_limit: i32, limit: i32) -> i32 {
  match value_limit < limit {
    true => value_limit + 1,
    false => limit,
  }
}

fn text_enum_signature_seed() -> i32 {
  149
}

fn text_enum_variant_signature_seed() -> i32 {
  151
}

fn text_enum_variant_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  match start >= limit {
    true => total,
    false => match text_token_weight_matches(source, start, token.TokenKindWeight::LiteralType) {
      false => rec(source, start + 1, limit, total),
      true => text_find_top_level_punctuation_score(
        source,
        start + 1,
        limit,
        0,
        textlex.punctuation_score(textlex.PunctEqual)
      ) \equal -> match equal < limit {
        true => text_enum_variant_value_limit(
          source,
          equal + 1,
          limit
        ) \value_limit -> rec(
          source,
          text_enum_variant_next_index(value_limit, limit),
          limit,
          total + 1
        ),
        false => rec(source, start + 1, limit, total),
      },
    },
  }
}

fn text_enum_variant_signature_fact(
  source: textlex.TextTokenStream,
  start: i32,
  equal: i32,
  value_limit: i32
) -> i32 {
  text_enum_variant_signature_seed()
    \total -> text_signature_mix(total, textlex.text_hash_at(source, start))
    \total -> text_signature_mix(
      total,
      text_annotation_signature_hash_between(source, equal + 1, value_limit, 0)
    )
}

fn text_enum_variant_signature_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32
) -> i32 {
  let start = text_expression_start_skip_trivia(source, index, limit);
  match start >= limit {
    true => total,
    false => match text_token_weight_matches(source, start, token.TokenKindWeight::LiteralType) {
      false => rec(source, start + 1, limit, total),
      true => text_find_top_level_punctuation_score(
        source,
        start + 1,
        limit,
        0,
        textlex.punctuation_score(textlex.PunctEqual)
      ) \equal -> match equal < limit {
        true => text_enum_variant_value_limit(
          source,
          equal + 1,
          limit
        ) \value_limit -> rec(
          source,
          text_enum_variant_next_index(value_limit, limit),
          limit,
          text_signature_mix(
            total,
            text_enum_variant_signature_fact(source, start, equal, value_limit)
          )
        ),
        false => rec(source, start + 1, limit, total),
      },
    },
  }
}

fn text_type_sugar_enum_variant_count(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let equal = text_type_sugar_equal_index(source, index, next);
  match text_type_sugar_equal_starts_enum(source, equal, next) {
    false => 0,
    true => text_type_sugar_enum_left_brace(
      source,
      equal,
      next
    ) \left_brace -> text_enum_variant_count_between(
      source,
      left_brace + 1,
      text_type_sugar_enum_right_brace(source, left_brace, next),
      0
    ),
  }
}

fn text_type_sugar_enum_variant_signature(
  source: textlex.TextTokenStream,
  equal: i32,
  next: i32
) -> i32 {
  let left_brace = text_type_sugar_enum_left_brace(source, equal, next);
  text_enum_variant_signature_between(
    source,
    left_brace + 1,
    text_type_sugar_enum_right_brace(source, left_brace, next),
    0
  )
}

fn text_type_sugar_enum_signature_fact(
  source: textlex.TextTokenStream,
  index: i32,
  next: i32,
  equal: i32
) -> i32 {
  text_enum_signature_seed()
    \total -> text_signature_mix(
      total,
      textlex.text_hash_at(source, text_type_name_index(source, index))
    )
    \total -> text_signature_mix(
      total,
      text_type_sugar_enum_backing_hash(source, equal, next)
    )
    \total -> text_signature_mix(
      total,
      text_type_sugar_enum_variant_signature(source, equal, next)
    )
}

fn text_type_sugar_enum_signature_hash(
  source: textlex.TextTokenStream,
  index: i32,
  total: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let equal = text_type_sugar_equal_index(source, index, next);
  match text_type_sugar_equal_starts_enum(source, equal, next) {
    true => text_signature_mix(
      total,
      text_type_sugar_enum_signature_fact(source, index, next, equal)
    ),
    false => total,
  }
}

fn text_type_body_signature_hash(
  source: textlex.TextTokenStream,
  index: i32,
  total: i32
) -> i32 {
  match is_text_type_function_start(source, index) {
    true => total,
    false => text_type_sugar_body_signature_hash(source, index, total),
  }
}

fn value_tail_from_annotation(
  context: TextValueDeclContext,
  result: combinator.Parser(TypeAnnotationFrame)
) -> combinator.Parser(DeclFrame) match {
  context, Ok(annotation) => parse_text_value_body(
    context,
    annotation.value.annotation,
    annotation.state.cursor
  ),
  _context, Err(error) => err_decl(error),
}

fn value_expression_limit_before_end(
  source: textlex.TextTokenStream,
  next: i32
) -> i32 {
  match punctuation_matches(source, next - 1, textlex.PunctSemicolon) {
    true => next - 1,
    false => next,
  }
}

fn value_initializer_should_parse(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> bool {
  match index >= limit {
    true => false,
    false => match textlex.punctuation_at(source, index) {
      PunctLeftBrace => false,
      PunctOther => match textlex.token_is_collection_open(source, index) {
        true => false,
        false => match text_left_bracket_token_matches(source, index) {
          true => false,
          false => true,
        },
      },
      _ => true,
    },
  }
}

fn declaration_from_named_annotated_expr_result(
  context: TextNamedAnnotatedDeclContext,
  next: i32,
  result: combinator.Parser(ExprFrame)
) -> combinator.Parser(DeclFrame) {
  ok_decl(
    combinator.state(next, context.limit),
    declaration_frame(
      declaration_from_named_annotated_expr(
        context.kind,
        context.name,
        context.annotation,
        context.seed,
        match result {
          Ok(reply) => reply.value.expr,
          Err(_) => ast.Missing,
        }
      ),
      next - context.start
    )
  )
}

fn declaration_from_named_annotated_missing_expr(
  context: TextNamedAnnotatedDeclContext,
  next: i32
) -> combinator.Parser(DeclFrame) {
  ok_decl(
    combinator.state(next, context.limit),
    declaration_frame(
      declaration_from_named_annotated_expr(
        context.kind,
        context.name,
        context.annotation,
        context.seed,
        ast.Missing
      ),
      next - context.start
    )
  )
}

fn decl_keyword(kind: token.DeclarationKind) -> token.TokenKind {
  match kind {
    LetDeclaration => token.LetKw,
    ConstDeclaration => token.ConstKw,
    TypeDeclaration => token.TypeKw,
    FunctionDeclaration => token.FnKw,
    NoDeclaration => token.Symbol,
  }
}

fn text_optional_annotation_parser() -> textparser.TextParser(TypeAnnotationFrame) {
  \input_value -> match punctuation_matches(
    input_value.source,
    input_value.state.cursor,
    textlex.PunctColon
  ) {
    true => textparser.run(text_required_annotation_parser(), input_value),
    false => ok_type_annotation(
      input_value.state,
      type_annotation_frame(ast.missing_type(), 0)
    ),
  }
}

fn text_required_annotation_parser() -> textparser.TextParser(TypeAnnotationFrame) {
  do @applicative(textparser.TextParser(_)) {
    textparser.expect_punctuation(textlex.PunctColon);
    annotation <- text_type_annotation_parser();
    pure(type_annotation_frame(
      annotation.annotation,
      annotation.consumed + 1
    ))
  }
}

fn text_value_expr_parser(seed: i32) -> textparser.TextParser(ExprFrame) {
  \input_value -> parse_text_expression(
    combinator.state(
      input_value.state.cursor,
      input_value.state.cursor + 1
    ),
    input_value.source,
    seed
  )
}

fn text_value_decl_frame(
  kind: token.DeclarationKind,
  name: token.Token,
  annotation: TypeAnnotationFrame,
  expr: ExprFrame
) -> DeclFrame {
  declaration_frame(
    declaration_from_named_annotated_expr(
      kind,
      name,
      annotation.annotation,
      0,
      expr.expr
    ),
    annotation.consumed + expr.consumed + 4
  )
}

fn text_value_decl_parser(
  kind: token.DeclarationKind,
  seed: i32
) -> textparser.TextParser(DeclFrame) {
  do @applicative(textparser.TextParser(_)) {
    textparser.expect_kind(decl_keyword(kind), 1);
    name <- textparser.any_token();
    annotation <- text_optional_annotation_parser();
    textparser.expect_punctuation(textlex.PunctEqual);
    expr <- text_value_expr_parser(seed);
    textparser.any_token();
    pure(text_value_decl_frame(kind, name, annotation, expr))
  }
}

fn text_source_import_decl_frame(
  alias: token.Token,
  module_name: token.Token
) -> DeclFrame {
  declaration_frame(
    ast.source_import_decl(
      token.token_score(module_name),
      token.token_score(alias)
    ),
    9
  )
}

fn text_source_import_decl_frame_from_source(
  source: textlex.TextTokenStream,
  index: i32
) -> DeclFrame {
  let next = text_declaration_end_from_index(source, index);
  declaration_frame(
    ast.source_import_decl(
      text_source_import_module_score(source, index),
      text_source_import_alias_score(source, index)
    ),
    next - index
  )
}

fn text_source_import_decl_parser() -> textparser.TextParser(DeclFrame) {
  do @applicative(textparser.TextParser(_)) {
    textparser.expect_kind(token.ConstKw, 1);
    alias <- textparser.any_token();
    textparser.expect_punctuation(textlex.PunctEqual);
    textparser.any_token();
    textparser.expect_kind(token.Import, 1);
    textparser.expect_punctuation(textlex.PunctLeftParen);
    module_name <- textparser.expect_kind(token.StringLiteral, 1);
    textparser.expect_punctuation(textlex.PunctRightParen);
    textparser.any_token();
    pure(text_source_import_decl_frame(alias, module_name))
  }
}

fn parse_text_source_import_tail(
  current: combinator.ParseState,
  source: textlex.TextTokenStream,
  _seed: i32
) -> combinator.Parser(DeclFrame) {
  let next = text_declaration_end_from_index(source, current.cursor);
  ok_decl(
    combinator.state(next, current.limit),
    text_source_import_decl_frame_from_source(source, current.cursor)
  )
}

fn parse_text_external_import_tail(
  current: combinator.ParseState,
  source: textlex.TextTokenStream
) -> combinator.Parser(DeclFrame) {
  let next = text_declaration_end_from_index(source, current.cursor);
  ok_decl(
    combinator.state(next, current.limit),
    declaration_frame(
      ast.empty_decl(),
      next - current.cursor
    )
  )
}

fn parse_text_operator_tail(
  current: combinator.ParseState,
  source: textlex.TextTokenStream
) -> combinator.Parser(DeclFrame) {
  let next = text_declaration_end_from_index(source, current.cursor);
  ok_decl(
    combinator.state(next, current.limit),
    declaration_frame(
      ast.const_decl(
        text_operator_declaration_name_hash(source, current.cursor),
        ast.missing_type(),
        ast.missing_expr()
      ),
      next - current.cursor
    )
  )
}

fn parse_text_type_assert_tail(
  current: combinator.ParseState,
  source: textlex.TextTokenStream
) -> combinator.Parser(DeclFrame) {
  let next = text_declaration_end_from_index(source, current.cursor);
  ok_decl(
    combinator.state(next, current.limit),
    declaration_frame(
      ast.const_decl(
        0,
        ast.missing_type(),
        ast.missing_expr()
      ),
      next - current.cursor
    )
  )
}

fn parse_text_value_body(
  context: TextValueDeclContext,
  annotation: ast.TypeAnnotation,
  equal_index: i32
) -> combinator.Parser(DeclFrame) {
  match punctuation_matches(context.source, equal_index, textlex.PunctEqual) {
    false => punctuation_error(
      context.source,
      equal_index,
      textlex.PunctEqual
    ),
    true => text_declaration_end_from_index(
      context.source,
      context.start
    ) \next -> text_named_annotated_decl_context(
      context.kind,
      context.name,
      context.start,
      context.limit,
      annotation,
      context.seed
    ) \decl_context -> value_expression_limit_before_end(
      context.source,
      next
    ) \expr_limit -> match value_initializer_should_parse(
      context.source,
      equal_index + 1,
      expr_limit
    ) {
      false => declaration_from_named_annotated_missing_expr(
        decl_context,
        next
      ),
      true => declaration_from_named_annotated_expr_result(
        decl_context,
        next,
        parse_text_expression(
          combinator.state(
            equal_index + 1,
            expr_limit
          ),
          context.source,
          context.seed
        )
      ),
    },
  }
}

fn parse_text_no_declaration(
  current: combinator.ParseState,
  source: textlex.TextTokenStream
) -> combinator.Parser(DeclFrame) {
  let first = textlex.token_at(source, current.cursor);
  err_decl(combinator.UnexpectedToken(
    1,
    0,
    first.span
  ))
}

fn parse_text_declaration_for_kind(
  kind: token.DeclarationKind,
  current: combinator.ParseState,
  source: textlex.TextTokenStream,
  seed: i32
) -> combinator.Parser(DeclFrame) {
  match kind {
    FunctionDeclaration => parse_text_function_tail(current, source, seed),
    LetDeclaration => parse_text_value_tail(LetDeclaration, current, source, seed),
    ConstDeclaration => parse_text_value_tail(ConstDeclaration, current, source, seed),
    TypeDeclaration => parse_text_type_tail(current, source),
    NoDeclaration => parse_text_no_declaration(current, source),
  }
}

fn parse_declaration_stream(
  current: combinator.ParseState,
  source: stream.TokenStream,
  seed: i32
) -> combinator.Parser(DeclFrame) {
  let first = stream.token_at(source, current.cursor);
  let kind = token.declaration_kind(first.kind);
  match token.is_declaration_kind(kind) {
    false => err_decl(combinator.UnexpectedToken(
      1,
      0,
      first.span
    )),
    true => declaration_from_expr_result(
      kind,
      current.cursor,
      seed,
      parse_expression(
        combinator.state(
          current.cursor + 2,
          stream.length(source)
        ),
        source,
        seed
      )
    ),
  }
}

fn is_text_source_import_start(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match is_text_source_import_alias_start(source, index) {
    true => true,
    false => is_text_source_import_destructured_start(source, index),
  }
}

fn is_text_source_import_alias_start(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  let starts_with_const = text_token_weight_matches(source, index, 19);
  let has_equal = punctuation_matches(source, index + 2, textlex.PunctEqual);
  let has_import = text_token_weight_matches(source, index + 4, 11);
  let has_open = punctuation_matches(source, index + 5, textlex.PunctLeftParen);
  let has_string = text_token_weight_matches(source, index + 6, 53);
  let has_close = punctuation_matches(source, index + 7, textlex.PunctRightParen);
  starts_with_const && has_equal && has_import && has_open && has_string && has_close
}

fn text_source_import_destructured_close_index(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  find_text_right_brace(
    source,
    index + 2,
    textlex.length(source),
    0
  )
}

fn is_text_source_import_destructured_start(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  let starts_with_const = text_token_weight_matches(source, index, 19);
  let has_open_list = punctuation_matches(source, index + 1, textlex.PunctLeftBrace);
  let close_list = text_source_import_destructured_close_index(source, index);
  let has_close_list = close_list < textlex.length(source);
  let equal_index = close_list + 1;
  let has_equal = punctuation_matches(source, equal_index, textlex.PunctEqual);
  let has_import = text_token_weight_matches(source, equal_index + 2, 11);
  let has_open = punctuation_matches(source, equal_index + 3, textlex.PunctLeftParen);
  let has_string = text_token_weight_matches(source, equal_index + 4, 53);
  let has_close = punctuation_matches(source, equal_index + 5, textlex.PunctRightParen);
  let has_import_call = has_import && has_open && has_string && has_close;
  starts_with_const && has_open_list && has_close_list && has_equal && has_import_call
}

fn text_external_import_equal_index(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  text_find_top_level_punctuation_score(
    source,
    index + 2,
    textlex.length(source),
    0,
    1
  )
}

fn is_text_external_import_start(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  let starts_with_const = text_token_weight_matches(source, index, 19);
  match starts_with_const {
    false => false,
    true => text_external_import_equal_index(source, index) \equal -> match
      equal < textlex.length(source) {
      false => false,
      true => match punctuation_matches(source, equal + 1, textlex.PunctOther) {
        false => false,
        true => match textlex.text_hash_at(source, equal + 1) ==
          text_static_marker_hash() {
          false => false,
          true => text_token_weight_matches(
            source,
            equal + 2,
            token.TokenKindWeight::External
          ),
        },
      },
    },
  }
}

fn text_source_import_equal_index(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  match is_text_source_import_alias_start(source, index) {
    true => index + 2,
    false => text_source_import_destructured_close_index(source, index) + 1,
  }
}

fn text_source_import_module_index(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  text_source_import_equal_index(source, index) + 4
}

fn text_source_import_alias_score(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  match is_text_source_import_alias_start(source, index) {
    true => textlex.text_token_score(textlex.text_token_at(source, index + 1)),
    false => 0,
  }
}

fn text_source_import_module_score(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  textlex.text_token_score(
    textlex.text_token_at(source, text_source_import_module_index(source, index))
  )
}

fn text_source_import_alias_hash(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  match is_text_source_import_alias_start(source, index) {
    true => textlex.text_hash_at(source, index + 1),
    false => 0,
  }
}

fn text_operator_fixity_infix_hash() -> i32 {
  128589438
}

fn text_operator_fixity_infixl_hash() -> i32 {
  0 - 51515734
}

fn text_operator_fixity_infixr_hash() -> i32 {
  0 - 51515728
}

fn text_operator_declaration_prefix_hash() -> i32 {
  1317338534
}

fn text_operator_fixity_hash_matches(value_hash: i32) -> bool {
  let is_infix = value_hash == text_operator_fixity_infix_hash();
  let is_infixl = value_hash == text_operator_fixity_infixl_hash();
  let is_infixr = value_hash == text_operator_fixity_infixr_hash();
  is_infix || is_infixl || is_infixr
}

fn is_text_operator_declaration_start(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match textlex.token_at(source, index).kind {
    InfixKw => true,
    InfixlKw => true,
    InfixrKw => true,
    Identifier => text_operator_fixity_hash_matches(textlex.text_hash_at(source, index)),
    _ => false,
  }
}

fn text_operator_declaration_symbol_width(
  source: textlex.TextTokenStream,
  start: i32,
  end: i32
) -> i32 {
  match end <= start {
    true => 0,
    false => span.width(textlex.token_at(source, start).span)
      + text_operator_declaration_symbol_width(source, start + 1, end),
  }
}

fn text_operator_declaration_name_hash(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let operator_start = index + 3;
  let operator_end = text_operator_sequence_end(
    source,
    operator_start,
    text_declaration_end_from_index(source, index)
  );
  text_hash_append(
    text_operator_declaration_prefix_hash(),
    text_operator_sequence_hash(source, operator_start),
    text_operator_declaration_symbol_width(source, operator_start, operator_end)
  )
}

fn text_operator_declaration_signature_seed() -> i32 {
  163
}

fn text_operator_fixity_infix_tag() -> i32 {
  1
}

fn text_operator_fixity_infixl_tag() -> i32 {
  2
}

fn text_operator_fixity_infixr_tag() -> i32 {
  3
}

fn text_operator_declaration_fixity_tag(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let fixity_hash = textlex.text_hash_at(source, index);
  match fixity_hash == text_operator_fixity_infix_hash() {
    true => text_operator_fixity_infix_tag(),
    false => match fixity_hash == text_operator_fixity_infixl_hash() {
      true => text_operator_fixity_infixl_tag(),
      false => match fixity_hash == text_operator_fixity_infixr_hash() {
        true => text_operator_fixity_infixr_tag(),
        false => 0,
      },
    },
  }
}

fn text_operator_declaration_symbol_hash(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  text_operator_sequence_hash(source, index + 3)
}

fn text_token_text_hash_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32
) -> i32 {
  match index >= limit {
    true => total,
    false => rec(
      source,
      index + 1,
      limit,
      text_hash_append_token(source, index, total)
    ),
  }
}

fn text_operator_declaration_target_start(
  source: textlex.TextTokenStream,
  index: i32,
  next: i32
) -> i32 {
  text_find_top_level_punctuation_score(
    source,
    index + 1,
    next,
    0,
    textlex.punctuation_score(textlex.PunctEqual)
  ) + 1
}

fn text_operator_declaration_target_end(
  source: textlex.TextTokenStream,
  next: i32
) -> i32 {
  match punctuation_matches(source, next - 1, textlex.PunctSemicolon) {
    true => next - 1,
    false => next,
  }
}

fn text_operator_declaration_target_hash(
  source: textlex.TextTokenStream,
  index: i32,
  next: i32
) -> i32 {
  text_token_text_hash_between(
    source,
    text_operator_declaration_target_start(source, index, next),
    text_operator_declaration_target_end(source, next),
    0
  )
}

fn text_operator_declaration_signature_fact(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  text_operator_declaration_signature_seed()
    \total -> text_signature_mix(
      total,
      text_operator_declaration_symbol_hash(source, index)
    )
    \total -> text_signature_mix(
      total,
      text_operator_declaration_fixity_tag(source, index)
    )
    \total -> text_signature_mix(total, textlex.decimal_token_value(source, index + 1))
    \total -> text_signature_mix(
      total,
      text_operator_declaration_target_hash(source, index, next)
    )
}

fn text_declaration_start(
  source: textlex.TextTokenStream,
  index: i32
) -> TextDeclarationStart {
  match text_pub_function_declaration_start_matches(source, index) {
    true => TextPubFunctionDeclaration,
    false => match is_text_external_import_start(source, index) {
      true => TextExternalImportDeclaration,
      false => match is_text_type_assert_declaration_start(source, index) {
        true => TextTypeAssertDeclaration,
        false => match is_text_operator_declaration_start(source, index) {
          true => TextOperatorDeclaration,
          false => text_regular_declaration_start(source, index),
        },
      },
    },
  }
}

fn text_pub_function_declaration_start_matches(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  let is_pub = text_token_weight_matches(source, index, 37);
  let is_function = text_token_weight_matches(source, index + 1, 23);
  is_pub && is_function
}

fn text_regular_declaration_start(
  source: textlex.TextTokenStream,
  index: i32
) -> TextDeclarationStart {
  text_regular_declaration_start_for_kind(
    token.declaration_kind(textlex.token_at(source, index).kind),
    source,
    index
  )
}

fn text_regular_declaration_start_for_kind(
  kind: token.DeclarationKind,
  source: textlex.TextTokenStream,
  index: i32
) -> TextDeclarationStart {
  match kind {
    ConstDeclaration => match is_text_source_import_start(source, index) {
      true => TextSourceImportDeclaration,
      false => TextRegularDeclaration(ConstDeclaration),
    },
    NoDeclaration => TextNoDeclaration,
    _ => TextRegularDeclaration(kind),
  }
}

fn is_text_declaration_start(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match text_declaration_start(source, index) {
    TextNoDeclaration => false,
    _ => true,
  }
}

fn is_text_function_declaration_start(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match text_token_weight_matches(source, index, 37) {
    true => text_token_weight_matches(source, index + 1, 23),
    false => text_token_weight_matches(source, index, 23),
  }
}

fn is_text_type_function_start(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match text_token_weight_matches(source, index, 17) {
    true => text_token_weight_matches(source, index + 1, 23),
    false => false,
  }
}

fn text_declaration_start_width(
  start: TextDeclarationStart,
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  match start {
    TextPubFunctionDeclaration => 2,
    TextRegularDeclaration(kind) => regular_text_declaration_start_width(kind, source, index),
    TextExternalImportDeclaration => 1,
    TextOperatorDeclaration => 1,
    TextTypeAssertDeclaration => text_type_assert_declaration_start_width(source, index),
    _ => 1,
  }
}

fn regular_text_declaration_start_width(
  kind: token.DeclarationKind,
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  match kind {
    TypeDeclaration => match is_text_type_function_start(source, index) {
      true => 2,
      false => 1,
    },
    _ => 1,
  }
}

fn brace_depth_after_token(
  source: textlex.TextTokenStream,
  index: i32,
  depth: i32
) -> i32 {
  match textlex.punctuation_at(source, index) {
    PunctLeftBrace => depth + 1,
    PunctRightBrace => match depth > 0 {
      true => depth - 1,
      false => 0,
    },
    _ => depth,
  }
}

fn paren_depth_after_token(
  source: textlex.TextTokenStream,
  index: i32,
  depth: i32
) -> i32 {
  match textlex.punctuation_at(source, index) {
    PunctLeftParen => depth + 1,
    PunctRightParen => match depth > 0 {
      true => depth - 1,
      false => 0,
    },
    _ => depth,
  }
}

fn is_text_top_level_declaration_start(
  source: textlex.TextTokenStream,
  index: i32,
  brace_depth: i32,
  paren_depth: i32
) -> bool {
  match brace_depth == 0 {
    true => match paren_depth == 0 {
      true => is_text_declaration_start(source, index),
      false => false,
    },
    false => false,
  }
}

fn text_token_line(source: textlex.TextTokenStream, index: i32) -> i32 {
  let value = textlex.token_at(source, index);
  value.span.line
}

fn text_depth_is_top_level(brace_depth: i32, paren_depth: i32) -> bool {
  match brace_depth == 0 {
    true => paren_depth == 0,
    false => false,
  }
}

fn text_declaration_line_start(
  source: textlex.TextTokenStream,
  index: i32,
  declaration_line: i32,
  entered_brace: bool
) -> bool {
  match entered_brace {
    true => false,
    false => match text_token_line(source, index) > declaration_line {
      true => is_text_declaration_start(source, index),
      false => false,
    },
  }
}

fn text_semicolon_boundary(
  source: textlex.TextTokenStream,
  index: i32,
  brace_depth: i32,
  paren_depth: i32
) -> bool {
  match text_depth_is_top_level(brace_depth, paren_depth) {
    true => punctuation_matches(source, index, textlex.PunctSemicolon),
    false => false,
  }
}

fn text_brace_boundary(
  source: textlex.TextTokenStream,
  next_brace_depth: i32,
  scan: TextDeclarationScan
) -> bool {
  match scan.entered_brace {
    false => false,
    true => match scan.paren_depth == 0 {
      false => false,
      true => match scan.brace_depth == 1 {
        true => match next_brace_depth == 0 {
          true => punctuation_matches(source, scan.index, textlex.PunctRightBrace),
          false => false,
        },
        false => false,
      },
    },
  }
}

fn text_declaration_boundary(
  source: textlex.TextTokenStream,
  next_brace_depth: i32,
  scan: TextDeclarationScan
) -> bool {
  match text_semicolon_boundary(source, scan.index, scan.brace_depth, scan.paren_depth) {
    true => true,
    false => text_brace_boundary(
      source,
      next_brace_depth,
      scan
    ),
  }
}

fn next_text_declaration_index(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  match index < limit {
    false => limit,
    true => match is_text_declaration_start(source, index) {
      true => index,
      false => next_text_declaration_index(
        source,
        index + 1,
        limit
      ),
    },
  }
}

fn next_text_declaration_state_loop(
  source: textlex.TextTokenStream,
  current: combinator.ParseState
) -> combinator.ParseState {
  match current.cursor < current.limit {
    false => current,
    true => match is_text_declaration_start(source, current.cursor) {
      true => current,
      false => rec(
        source,
        combinator.state(current.cursor + 1, current.limit)
      ),
    },
  }
}

fn text_declaration_scan_step(
  source: textlex.TextTokenStream,
  limit: i32,
  declaration_line: i32,
  scan: TextDeclarationScan
) -> TextDeclarationScan {
  match scan.done {
    true => scan,
    false => match scan.index < limit {
      false => TextDeclarationScan {
        index: scan.index,
        brace_depth: scan.brace_depth,
        paren_depth: scan.paren_depth,
        entered_brace: scan.entered_brace,
        done: true,
        result: limit,
      },
      true => match text_depth_is_top_level(scan.brace_depth, scan.paren_depth) {
        true => match text_declaration_line_start(
          source,
          scan.index,
          declaration_line,
          scan.entered_brace
        ) {
          true => TextDeclarationScan {
            index: scan.index,
            brace_depth: scan.brace_depth,
            paren_depth: scan.paren_depth,
            entered_brace: scan.entered_brace,
            done: true,
            result: scan.index,
          },
          false => text_declaration_scan_advance(
            source,
            declaration_line,
            scan
          ),
        },
        false => text_declaration_scan_advance(
          source,
          declaration_line,
          scan
        ),
      },
    },
  }
}

fn text_declaration_scan_advance(
  source: textlex.TextTokenStream,
  _declaration_line: i32,
  scan: TextDeclarationScan
) -> TextDeclarationScan {
  let next_brace_depth = brace_depth_after_token(source, scan.index, scan.brace_depth);
  let next_paren_depth = paren_depth_after_token(source, scan.index, scan.paren_depth);
  match text_declaration_boundary(
    source,
    next_brace_depth,
    scan
  ) {
    true => TextDeclarationScan {
      index: scan.index + 1,
      brace_depth: next_brace_depth,
      paren_depth: next_paren_depth,
      entered_brace: scan.entered_brace,
      done: true,
      result: scan.index + 1,
    },
    false => TextDeclarationScan {
      index: scan.index + 1,
      brace_depth: next_brace_depth,
      paren_depth: next_paren_depth,
      entered_brace: match scan.entered_brace {
        true => true,
        false => next_brace_depth > 0,
      },
      done: false,
      result: 0,
    },
  }
}

fn text_declaration_end_index_loop(
  source: textlex.TextTokenStream,
  limit: i32,
  declaration_line: i32,
  scan: TextDeclarationScan
) -> i32 {
  match scan.done {
    true => scan.result,
    false => rec(
      source,
      limit,
      declaration_line,
      text_declaration_scan_step(source, limit, declaration_line, scan)
    ),
  }
}

fn text_declaration_end_index(
  source: textlex.TextTokenStream,
  limit: i32,
  declaration_line: i32,
  scan: TextDeclarationScan
) -> i32 {
  text_declaration_end_index_loop(
    source,
    limit,
    declaration_line,
    scan
  )
}

fn next_text_declaration_state(
  current: combinator.ParseState,
  source: textlex.TextTokenStream
) -> combinator.ParseState {
  next_text_declaration_state_loop(source, current)
}

fn next_text_declaration_state_after_start(
  current: combinator.ParseState,
  source: textlex.TextTokenStream
) -> combinator.ParseState {
  let next = text_declaration_end_from_index(source, current.cursor);
  combinator.state(next, current.limit)
}

fn text_braced_declaration_end_from_index(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let limit = textlex.length(source);
  let left_brace = find_text_punctuation_score(
    source,
    index,
    limit,
    5
  );
  match left_brace < limit {
    false => limit,
    true => find_text_expression_limit(
      source,
      left_brace + 1,
      limit,
      textlex.PunctRightBrace
    ) \right_brace -> match right_brace < limit {
      true => right_brace + 1,
      false => limit,
    },
  }
}

fn text_function_declaration_end_from_index(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let limit = textlex.length(source);
  let open_paren = text_function_open_paren_index(source, index, limit);
  let close_paren = text_function_close_paren_index(source, open_paren, limit);
  let arrow = text_function_arrow_index(source, close_paren, limit);
  let left_brace = match arrow < limit {
    true => text_function_left_brace_index(source, arrow, limit),
    false => find_text_punctuation_score(source, close_paren + 1, limit, 5),
  };
  match left_brace < limit {
    false => limit,
    true => find_text_expression_limit(
      source,
      left_brace + 1,
      limit,
      textlex.PunctRightBrace
    ) \right_brace -> match right_brace < limit {
      true => right_brace + 1,
      false => limit,
    },
  }
}

fn text_source_import_declaration_end_from_index(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let module_index = text_source_import_module_index(source, index);
  text_declaration_end_index(
    source,
    textlex.length(source),
    text_token_line(source, index),
    TextDeclarationScan {
      index: module_index + 2,
      brace_depth: 0,
      paren_depth: 0,
      entered_brace: false,
      done: false,
      result: textlex.length(source),
    }
  )
}

fn text_external_import_declaration_end_from_index(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  text_declaration_end_index(
    source,
    textlex.length(source),
    text_token_line(source, index),
    TextDeclarationScan {
      index: index + 1,
      brace_depth: 0,
      paren_depth: 0,
      entered_brace: false,
      done: false,
      result: textlex.length(source),
    }
  )
}

fn text_declaration_uses_braced_end(
  start: TextDeclarationStart,
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match start {
    TextPubFunctionDeclaration => true,
    TextRegularDeclaration(kind) => match kind {
      FunctionDeclaration => true,
      TypeDeclaration => is_text_type_function_start(source, index),
      _ => false,
    },
    _ => false,
  }
}

fn text_declaration_end_from_index(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let start = text_declaration_start(source, index);
  let width = text_declaration_start_width(start, source, index);
  match start {
    TextSourceImportDeclaration => text_source_import_declaration_end_from_index(
      source,
      index
    ),
    TextExternalImportDeclaration => text_external_import_declaration_end_from_index(
      source,
      index
    ),
    _ => match text_declaration_uses_braced_end(start, source, index) {
      true => match start {
        TextPubFunctionDeclaration => text_function_declaration_end_from_index(
          source,
          index
        ),
        TextRegularDeclaration(kind) => match kind {
          FunctionDeclaration => text_function_declaration_end_from_index(
            source,
            index
          ),
          _ => text_braced_declaration_end_from_index(source, index + width),
        },
        _ => text_braced_declaration_end_from_index(source, index + width),
      },
      false => text_declaration_end_index(
        source,
        textlex.length(source),
        text_token_line(source, index),
        TextDeclarationScan {
          index: index + width,
          brace_depth: 0,
          paren_depth: 0,
          entered_brace: false,
          done: false,
          result: textlex.length(source),
        }
      ),
    },
  }
}

fn text_declaration_summary_delta(
  summary_kind: textmodel.SummaryKind,
  summary_arg: i32,
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  monad.Reader::run(
    text_declaration_summary_delta_reader(summary_kind, summary_arg),
    text_value_body_context(source, index, decl)
  )
}

fn text_signature_mix(total: i32, value: i32) -> i32 {
  textmodel.signature_mix(total, value)
}

fn is_text_non_value_declaration_start(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match is_text_external_import_start(source, index) {
    true => true,
    false => match is_text_type_assert_declaration_start(source, index) {
      true => true,
      false => is_text_operator_declaration_start(source, index),
    },
  }
}

fn text_declaration_kind_count_reader(
  kind_tag: i32
) -> monad.Reader(TextValueBodyContext, i32) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    source <- monad.Reader::asks(text_value_body_context_source);
    index <- monad.Reader::asks(text_value_body_context_index);
    decl <- monad.Reader::asks(text_value_body_context_decl);
    let actual_tag = text_declaration_kind_tag(source, index, decl);
    pure(match is_text_non_value_declaration_start(source, index) {
      true => 0,
      false => match actual_tag == kind_tag {
        true => 1,
        false => 0,
      },
    })
  }
}

fn text_declaration_function_param_count_reader() -> monad.Reader(
  TextValueBodyContext,
  i32
) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    source <- monad.Reader::asks(text_value_body_context_source);
    index <- monad.Reader::asks(text_value_body_context_index);
    decl <- monad.Reader::asks(text_value_body_context_decl);
    pure(match is_text_function_declaration_start(source, index) {
      true => ast.decl_param_count(decl),
      false => 0,
    })
  }
}

fn text_declaration_type_param_count_reader() -> monad.Reader(
  TextValueBodyContext,
  i32
) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    source <- monad.Reader::asks(text_value_body_context_source);
    index <- monad.Reader::asks(text_value_body_context_index);
    pure(match text_token_weight_matches(source, index, 17) {
      true => text_type_param_count(
        source,
        index,
        text_declaration_end_from_index(source, index)
      ),
      false => 0,
    })
  }
}

fn text_declaration_type_result_kind_count_reader(
  expected_tag: i32
) -> monad.Reader(TextValueBodyContext, i32) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    source <- monad.Reader::asks(text_value_body_context_source);
    index <- monad.Reader::asks(text_value_body_context_index);
    pure(match text_token_weight_matches(source, index, 17) {
      true => match text_type_result_kind_tag(source, index) == expected_tag {
        true => 1,
        false => 0,
      },
      false => 0,
    })
  }
}

