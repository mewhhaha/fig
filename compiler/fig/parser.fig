fn text_root_do_child_record_state_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  parent_kind_tag: i32,
  parent_name_hash: i32,
  child_index: i32,
  total: i32
) -> TextRootChildRecordState {
  let open_index = text_root_do_open_after_start(source, start + 1, limit, 0);
  match open_index < limit {
    false => TextRootChildRecordState {
      child_index: child_index,
      total: total,
    },
    true => find_text_right_brace(source, open_index + 1, limit, 0) \close_index -> match close_index < limit {
      true => text_root_do_child_record_state_in_block(
        source,
        open_index,
        close_index,
        parent_kind_tag,
        parent_name_hash,
        child_index,
        total
      ),
      false => TextRootChildRecordState {
        child_index: child_index,
        total: total,
      },
    },
  }
}

fn text_match_block_has_top_level_arrow(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  paren_depth: i32,
  brace_depth: i32,
  bracket_depth: i32
) -> bool {
  match index >= limit {
    true => false,
    false => text_depth_is_top_level(brace_depth, paren_depth) \top_level -> match top_level {
      true => match bracket_depth == 0 {
        true => match text_value_match_arm_token_matches(source, index) {
          true => true,
          false => text_match_block_has_top_level_arrow(
            source,
            index + 1,
            limit,
            paren_depth_after_token(source, index, paren_depth),
            brace_depth_after_token(source, index, brace_depth),
            text_argument_scan_bracket_delta(source, index, bracket_depth)
          ),
        },
        false => text_match_block_has_top_level_arrow(
          source,
          index + 1,
          limit,
          paren_depth_after_token(source, index, paren_depth),
          brace_depth_after_token(source, index, brace_depth),
          text_argument_scan_bracket_delta(source, index, bracket_depth)
        ),
      },
      false => text_match_block_has_top_level_arrow(
        source,
        index + 1,
        limit,
        paren_depth_after_token(source, index, paren_depth),
        brace_depth_after_token(source, index, brace_depth),
        text_argument_scan_bracket_delta(source, index, bracket_depth)
      ),
    },
  }
}

fn text_match_body_open_after_start(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  paren_depth: i32,
  brace_depth: i32,
  bracket_depth: i32
) -> i32 {
  match index >= limit {
    true => limit,
    false => text_depth_is_top_level(brace_depth, paren_depth) \top_level -> match top_level {
      true => match bracket_depth == 0 {
        true => match textlex.punctuation_at(source, index) {
          PunctLeftBrace => find_text_right_brace(
            source,
            index + 1,
            limit,
            0
          ) \close_index -> match close_index < limit {
            true => match text_match_block_has_top_level_arrow(
              source,
              index + 1,
              close_index,
              0,
              0,
              0
            ) {
              true => index,
              false => text_match_body_open_after_start(
                source,
                close_index + 1,
                limit,
                paren_depth,
                brace_depth,
                bracket_depth
              ),
            },
            false => limit,
          },
          _ => text_match_body_open_after_start(
            source,
            index + 1,
            limit,
            paren_depth_after_token(source, index, paren_depth),
            brace_depth_after_token(source, index, brace_depth),
            text_argument_scan_bracket_delta(source, index, bracket_depth)
          ),
        },
        false => text_match_body_open_after_start(
          source,
          index + 1,
          limit,
          paren_depth_after_token(source, index, paren_depth),
          brace_depth_after_token(source, index, brace_depth),
          text_argument_scan_bracket_delta(source, index, bracket_depth)
        ),
      },
      false => text_match_body_open_after_start(
        source,
        index + 1,
        limit,
        paren_depth_after_token(source, index, paren_depth),
        brace_depth_after_token(source, index, brace_depth),
        text_argument_scan_bracket_delta(source, index, bracket_depth)
      ),
    },
  }
}

fn text_match_values_plain_segments(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> TextMatchValuesSegments {
  TextMatchValuesSegments {
    start: start,
    limit: limit,
    count: text_root_child_count_between_segments(source, start, limit),
  }
}

fn text_match_values_segments_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> TextMatchValuesSegments {
  let start = text_expression_start_skip_trivia(source, index, limit);
  match start >= limit {
    true => TextMatchValuesSegments {
      start: limit,
      limit: limit,
      count: 0,
    },
    false => match textlex.punctuation_at(source, start) {
      PunctLeftParen => find_text_matching_right_paren(
        source,
        start + 1,
        limit,
        0
      ) \close_index -> match close_index < limit {
        false => text_match_values_plain_segments(source, start, limit),
        true => text_expression_start_skip_trivia(
          source,
          close_index + 1,
          limit
        ) \after_close -> match after_close >= limit {
          true => text_match_values_plain_segments(
            source,
            start + 1,
            close_index
          ),
          false => text_match_values_plain_segments(source, start, limit),
        },
      },
      _ => text_match_values_plain_segments(source, start, limit),
    },
  }
}

fn text_match_values_is_synthetic_shape(
  segments: TextMatchValuesSegments
) -> bool {
  segments.count > 1
}

fn text_match_values_root_head_kind_tag_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let segments = text_match_values_segments_between(source, index, limit);
  match text_match_values_is_synthetic_shape(segments) {
    true => text_expression_root_shape_tag(),
    false => text_expression_root_head_kind_tag_between(
      source,
      segments.start,
      segments.limit
    ),
  }
}

fn text_match_values_root_head_hash_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let segments = text_match_values_segments_between(source, index, limit);
  match text_match_values_is_synthetic_shape(segments) {
    true => 0,
    false => text_expression_root_head_hash_between(
      source,
      segments.start,
      segments.limit
    ),
  }
}

fn text_match_values_root_type_class_tag_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  let segments = text_match_values_segments_between(source, index, limit);
  match text_match_values_is_synthetic_shape(segments) {
