fn text_root_do_child_count_between(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> i32 {
  let open_index = text_root_do_open_after_start(source, start + 1, limit, 0);
  match open_index < limit {
    false => 0,
    true => find_text_right_brace(source, open_index + 1, limit, 0) \close_index -> match close_index < limit {
      true => text_root_do_child_count_in_block(source, open_index, close_index),
      false => 0,
    },
  }
}

