) -> monad.Reader(TextValueBodyContext, i32) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    source <- monad.Reader::asks(text_value_body_context_source);
    index <- monad.Reader::asks(text_value_body_context_index);
    decl <- monad.Reader::asks(text_value_body_context_decl);
    pure(match text_declaration_start(source, index) {
      TextPubFunctionDeclaration => text_signature_mix(
        total,
        text_export_abi_hash(
          textlex.text_hash_at(source, text_function_name_index(source, index)),
          ast.decl_param_count(decl),
          text_abi_class_tag_for_type_class(
            text_function_return_resolved_type_class_tag(source, index)
          )
        )
      ),
      _ => total,
    })
  }
}

fn text_declaration_source_import_edge_signature_total_reader(
  total: i32
) -> monad.Reader(TextValueBodyContext, i32) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    source <- monad.Reader::asks(text_value_body_context_source);
    index <- monad.Reader::asks(text_value_body_context_index);
    decl <- monad.Reader::asks(text_value_body_context_decl);
    let kind_tag = text_declaration_kind_tag(source, index, decl);
    match text_declaration_kind_is_source_import(kind_tag) {
      true => pure(text_signature_mix(
        total,
        text_source_import_edge_hash(
          text_source_import_alias_hash(source, index),
          text_source_import_module_hash(source, index)
        )
      )),
      false => pure(total),
    }
  }
}

fn text_declaration_source_import_graph_diagnostic_signature_total_reader(
  total: i32
) -> monad.Reader(TextValueBodyContext, i32) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    source <- monad.Reader::asks(text_value_body_context_source);
    index <- monad.Reader::asks(text_value_body_context_index);
    decl <- monad.Reader::asks(text_value_body_context_decl);
    let kind_tag = text_declaration_kind_tag(source, index, decl);
    match text_declaration_kind_is_source_import(kind_tag) {
      true => pure(text_signature_mix(
        total,
        text_source_import_graph_diagnostic_hash(
          text_source_import_alias_hash(source, index),
          text_source_import_module_hash(source, index),
          text_source_import_declaration_span_width(source, index),
          text_source_import_graph_no_diagnostic_code()
        )
      )),
      false => pure(total),
    }
  }
}

fn text_declaration_dependency_signature_total_reader(
  total: i32
) -> monad.Reader(TextValueBodyContext, i32) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    source <- monad.Reader::asks(text_value_body_context_source);
    index <- monad.Reader::asks(text_value_body_context_index);
    decl <- monad.Reader::asks(text_value_body_context_decl);
    let kind_tag = text_declaration_kind_tag(source, index, decl);
    match text_declaration_kind_has_value_body(kind_tag) {
      true => pure(text_declaration_dependency_signature_for_value_body(
        source,
        index,
        decl,
        kind_tag,
        total
      )),
      false => pure(total),
    }
  }
}

fn text_declaration_dependency_diagnostic_signature_total_reader(
  total: i32
) -> monad.Reader(TextValueBodyContext, i32) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    source <- monad.Reader::asks(text_value_body_context_source);
    index <- monad.Reader::asks(text_value_body_context_index);
    decl <- monad.Reader::asks(text_value_body_context_decl);
    let kind_tag = text_declaration_kind_tag(source, index, decl);
    match text_declaration_kind_has_value_body(kind_tag) {
      true => pure(text_declaration_dependency_diagnostic_signature_for_value_body(
        source,
        index,
        decl,
        kind_tag,
        total
      )),
      false => pure(total),
    }
  }
}

fn text_declaration_value_operator_signature_total_reader(
  total: i32
) -> monad.Reader(TextValueBodyContext, i32) {
  text_declaration_value_body_signature_reader(TextValueBodyOperatorSignature, total)
}

fn text_declaration_resolved_simple_body_type_check_signature_total_reader(
  total: i32
) -> monad.Reader(TextValueBodyContext, i32) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    source <- monad.Reader::asks(text_value_body_context_source);
    index <- monad.Reader::asks(text_value_body_context_index);
    decl <- monad.Reader::asks(text_value_body_context_decl);
    let kind_tag = text_declaration_kind_tag(source, index, decl);
    let expected = text_declaration_resolved_expected_body_type_class_tag(
      source,
      index,
      decl
    );
    let actual = text_declaration_resolved_value_body_type_class_tag(
      source,
      index,
      decl
    );
    pure(text_signature_mix(
      total,
      text_simple_body_type_check_hash(
        kind_tag,
        expected,
        actual,
        text_simple_body_type_check_status(expected, actual)
      )
    ))
  }
}

fn text_declaration_summary_delta_total_reader(
  summary_kind: textmodel.SummaryKind,
  summary_arg: i32,
  total: i32
) -> monad.Reader(TextValueBodyContext, i32) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    delta <- text_declaration_summary_delta_reader(summary_kind, summary_arg);
    pure(total + delta)
  }
}

fn text_declaration_summary_total_reader(
  context: TextSummaryContext,
  total: i32
) -> monad.Reader(TextValueBodyContext, i32) {
  match context.summary_kind {
    textmodel.SummaryKind::DeclarationSignature =>
      text_declaration_signature_total_reader(total),
    textmodel.SummaryKind::FunctionParamSignature =>
      text_declaration_function_param_signature_total_reader(total),
    textmodel.SummaryKind::TypeParamSignature =>
      text_declaration_type_param_signature_total_reader(total),
    textmodel.SummaryKind::FunctionParamTypeSignature =>
      text_declaration_function_param_type_signature_total_reader(total),
    textmodel.SummaryKind::FunctionReturnSignature =>
      text_declaration_function_return_signature_total_reader(total),
    textmodel.SummaryKind::FunctionAttachedSignature =>
      text_declaration_function_attached_signature_total_reader(total),
    textmodel.SummaryKind::OperatorSignature =>
      text_declaration_operator_signature_total_reader(total),
    textmodel.SummaryKind::ValueAnnotationSignature =>
      text_declaration_value_annotation_signature_total_reader(total),
    textmodel.SummaryKind::FunctionBodySignature =>
      text_declaration_function_body_signature_total_reader(total),
    textmodel.SummaryKind::TypeBodySignature =>
      text_declaration_type_body_signature_total_reader(total),
    textmodel.SummaryKind::TypeEnumSignature =>
      text_declaration_type_enum_signature_total_reader(total),
    textmodel.SummaryKind::FunctionLocalLets =>
      text_declaration_function_local_let_total_reader(total),
    textmodel.SummaryKind::DeclaredTypeClassSignature =>
      text_declaration_declared_type_class_signature_total_reader(total),
    textmodel.SummaryKind::DeclaredAbiClassSignature =>
      text_declaration_declared_abi_class_signature_total_reader(total),
    textmodel.SummaryKind::SymbolEnvironmentSignature =>
      text_declaration_symbol_environment_signature_total_reader(total),
    textmodel.SummaryKind::ExportAbiSignature =>
      text_declaration_export_abi_signature_total_reader(total),
    textmodel.SummaryKind::ValueBodyTypeClassSignature =>
      text_declaration_value_body_type_class_signature_total_reader(total),
    textmodel.SummaryKind::ValueBodyAbiClassSignature =>
      text_declaration_value_body_abi_class_signature_total_reader(total),
    textmodel.SummaryKind::ResolvedValueBodyTypeClassSignature =>
      text_declaration_resolved_value_body_type_class_signature_total_reader(total),
    textmodel.SummaryKind::ResolvedValueBodyAbiClassSignature =>
      text_declaration_resolved_value_body_abi_class_signature_total_reader(total),
    textmodel.SummaryKind::SimpleBodyTypeCheckSignature =>
      text_declaration_simple_body_type_check_signature_total_reader(total),
    textmodel.SummaryKind::NamedTypeEnvironmentSignature =>
      text_declaration_named_type_environment_signature_total_reader(total),
    textmodel.SummaryKind::ResolvedDeclaredTypeClassSignature =>
      text_declaration_resolved_declared_type_class_signature_total_reader(total),
    textmodel.SummaryKind::ResolvedDeclaredAbiClassSignature =>
      text_declaration_resolved_declared_abi_class_signature_total_reader(total),
    textmodel.SummaryKind::ResolvedSymbolEnvironmentSignature =>
      text_declaration_resolved_symbol_environment_signature_total_reader(total),
    textmodel.SummaryKind::ResolvedExportAbiSignature =>
      text_declaration_resolved_export_abi_signature_total_reader(total),
    textmodel.SummaryKind::DirectImportTypeEnvironmentSignature =>
      text_declaration_direct_import_type_environment_signature_total_reader(
        total,
        context.summary_arg
      ),
    textmodel.SummaryKind::SourceImportEdgeSignature =>
      text_declaration_source_import_edge_signature_total_reader(total),
    textmodel.SummaryKind::SourceImportGraphDiagnosticSignature =>
      text_declaration_source_import_graph_diagnostic_signature_total_reader(total),
    textmodel.SummaryKind::DeclarationDependencySignature =>
      text_declaration_dependency_signature_total_reader(total),
    textmodel.SummaryKind::DeclarationDependencyDiagnosticSignature =>
      text_declaration_dependency_diagnostic_signature_total_reader(total),
    textmodel.SummaryKind::ResolvedSimpleBodyTypeCheckSignature =>
      text_declaration_resolved_simple_body_type_check_signature_total_reader(total),
    textmodel.SummaryKind::ValueOperatorSignature =>
      text_declaration_value_operator_signature_total_reader(total),
    _ => text_declaration_summary_delta_total_reader(
      context.summary_kind,
      context.summary_arg,
      total
    ),
  }
}

fn text_declaration_summary_total(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  context: TextSummaryContext,
  total: i32
) -> i32 {
  match is_text_external_import_start(source, index) {
    true => match context.summary_kind {
      textmodel.SummaryKind::Declarations => total + 1,
      _ => total,
    },
    false => monad.Reader::run(
      text_declaration_summary_total_reader(context, total),
      text_value_body_context(source, index, decl)
    ),
  }
}

fn text_declaration_summary_total_for_slice(
  slice: textmodel.DeclSlice,
  context: TextSummaryContext,
  total: i32
) -> i32 {
  text_declaration_summary_total(
    slice.source,
    slice.start,
    slice.decl,
    context,
    total
  )
}

