fn text_declaration_summary_delta_reader(
  summary_kind: textmodel.SummaryKind,
  summary_arg: i32
) -> monad.Reader(TextValueBodyContext, i32) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    match summary_kind {
      textmodel.SummaryKind::Declarations => pure(1),
      textmodel.SummaryKind::KindCount => text_declaration_kind_count_reader(
        summary_arg
      ),
      textmodel.SummaryKind::FunctionParams =>
      text_declaration_function_param_count_reader(),
      textmodel.SummaryKind::TypeParams =>
        text_declaration_type_param_count_reader(),
      textmodel.SummaryKind::TypeResultKind =>
      text_declaration_type_result_kind_count_reader(summary_arg),
      textmodel.SummaryKind::TypeSugarStatements =>
        text_declaration_type_sugar_statement_count_reader(),
      textmodel.SummaryKind::TypeEnumDeclarations =>
        text_declaration_type_enum_count_reader(),
      textmodel.SummaryKind::TypeEnumVariants =>
        text_declaration_type_enum_variant_count_reader(),
      textmodel.SummaryKind::ValueMatchExpressions =>
        text_declaration_value_body_count_reader(TextValueBodyMatchCount),
      textmodel.SummaryKind::FunctionMatchBodies =>
        text_declaration_function_match_body_count_reader(),
      textmodel.SummaryKind::ValueDoExpressions =>
        text_declaration_value_body_count_reader(TextValueBodyDoCount),
      textmodel.SummaryKind::ValueDoBinds =>
        text_declaration_value_body_count_reader(TextValueBodyDoBindCount),
      textmodel.SummaryKind::ValueMatchArms =>
        text_declaration_value_body_count_reader(TextValueBodyMatchArmCount),
      textmodel.SummaryKind::ValuePipeBinds =>
        text_declaration_value_body_count_reader(TextValueBodyPipeBindCount),
      textmodel.SummaryKind::ValueOperators =>
        text_declaration_value_body_count_reader(TextValueBodyOperatorCount),
      textmodel.SummaryKind::ValueCallExpressions =>
        text_declaration_value_body_count_reader(TextValueBodyCallCount),
      textmodel.SummaryKind::FunctionLocalTypeAsserts =>
        text_declaration_function_local_type_assert_count_reader(),
      textmodel.SummaryKind::FunctionAttachedDeclarations =>
        text_declaration_function_attached_count_reader(),
      textmodel.SummaryKind::OperatorDeclarations =>
        text_declaration_operator_count_reader(),
      _ => pure(0),
    }
  }
}

