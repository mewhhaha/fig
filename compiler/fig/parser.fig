  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  text_declaration_value_body_count_delta(
    source,
    index,
    decl,
    TextValueBodyPipeBindCount
  )
}

fn text_value_operator_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32
) -> i32 {
  text_value_body_count_scan(source, index, limit, total, TextValueBodyOperatorCount)
}

fn text_operator_sequence_hash_loop(
  source: textlex.TextTokenStream,
  index: i32,
  total: i32
) -> i32 {
  match text_operator_symbol_token_matches(source, index) {
    true => text_operator_sequence_hash_loop(
      source,
      index + 1,
      total * 33 + textlex.text_hash_at(source, index)
    ),
    false => total,
  }
}

fn text_operator_sequence_hash(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  text_operator_sequence_hash_loop(source, index, 0)
}

fn text_value_operator_signature_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32
) -> i32 {
  text_value_body_signature_scan(
    source,
    index,
    limit,
    total,
    TextValueBodyOperatorSignature
  )
}

fn text_declaration_value_operator_count_delta(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  text_declaration_value_body_count_delta(
    source,
    index,
    decl,
    TextValueBodyOperatorCount
  )
}

fn text_declaration_value_operator_signature_delta(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  monad.Reader::run(
    text_declaration_value_operator_signature_total_reader(total),
    text_value_body_context(source, index, decl)
  )
}

fn text_value_call_token_matches(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  let is_call_open = punctuation_matches(source, index, textlex.PunctLeftParen);
  let has_callable_head = text_value_call_has_callable_head(source, index);
  match is_call_open && has_callable_head {
    false => false,
    true => text_value_call_has_no_token_blockers(source, index),
  }
}

fn text_value_call_has_callable_head(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match index > 0 {
    false => false,
    true => text_token_can_end_value_expr(source, index - 1),
  }
}

fn text_value_call_has_no_token_blockers(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  let is_do_strategy = text_value_call_is_do_strategy_annotation(source, index - 1);
  let is_pattern_constructor = text_value_call_is_match_pattern_constructor(
    source,
    index
  );
  text_bool_not(is_do_strategy || is_pattern_constructor)
}

fn text_value_call_is_do_strategy_annotation(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match index < 0 {
    true => false,
    false => match text_token_kind_matches(source, index, token.DoKw) {
      true => true,
      false => match textlex.punctuation_at(source, index) {
        PunctSemicolon => false,
        PunctLeftBrace => false,
        PunctRightBrace => false,
        _ => text_value_call_is_do_strategy_annotation(source, index - 1),
      },
    },
  }
}

fn text_value_call_is_match_pattern_constructor(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match text_value_call_previous_is_literal_type(source, index) {
    false => false,
    true => match text_value_call_has_no_pattern_constructor_blockers(source, index) {
      false => false,
      true => find_text_matching_right_paren(
        source,
        index + 1,
        textlex.length(source),
        0
      ) \close -> text_value_call_has_match_arm_arrow_after(
        source,
        text_value_call_arrow_scan(close + 1, textlex.length(source), 0, 0)
      ),
    },
  }
}

fn text_value_call_previous_is_literal_type(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match textlex.token_at(source, index - 1).kind {
    LiteralType => true,
    _ => false,
  }
}

fn text_value_call_has_no_pattern_constructor_blockers(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  let previous_is_arm_arrow = text_value_call_previous_is_match_arm_arrow(
    source,
    index
  );
  let is_qualified_name = text_value_call_is_qualified_name(source, index);
  text_bool_not(previous_is_arm_arrow || is_qualified_name)
}

fn text_value_call_is_qualified_name(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match index > 1 {
    false => false,
    true => match textlex.punctuation_at(source, index - 2) {
      PunctOther => textlex.text_hash_at(source, index - 2) == text_dot_hash(),
      _ => false,
    },
  }
}

fn text_value_call_previous_is_match_arm_arrow(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  match index > 2 {
    false => false,
    true => text_value_match_arm_token_matches(source, index - 3),
  }
}

fn text_value_call_arrow_scan(
  index: i32,
  limit: i32,
  brace_depth: i32,
  paren_depth: i32
) -> TextValueCallArrowScan {
  TextValueCallArrowScan {
    index: index,
    limit: limit,
    brace_depth: brace_depth,
    paren_depth: paren_depth,
  }
}

fn text_value_call_arrow_scan_advance(
  source: textlex.TextTokenStream,
  scan: TextValueCallArrowScan
) -> TextValueCallArrowScan {
  text_value_call_arrow_scan(
    scan.index + 1,
    scan.limit,
    brace_depth_after_token(source, scan.index, scan.brace_depth),
    paren_depth_after_token(source, scan.index, scan.paren_depth)
  )
}

fn text_value_call_arrow_scan_is_top_level(
  scan: TextValueCallArrowScan
) -> bool {
  text_depth_is_top_level(scan.brace_depth, scan.paren_depth)
}

fn text_value_call_arrow_scan_should_stop(
  source: textlex.TextTokenStream,
  scan: TextValueCallArrowScan
) -> bool {
  match textlex.punctuation_at(source, scan.index) {
    PunctSemicolon => true,
    PunctRightParen => true,
    PunctRightBrace => true,
    _ => false,
  }
}

fn text_value_call_arrow_scan_step(
  source: textlex.TextTokenStream,
  scan: TextValueCallArrowScan
) -> TextValueCallArrowStep {
  match scan.index >= scan.limit {
    true => TextValueCallArrowStopped,
    false => match text_value_call_arrow_scan_is_top_level(scan) {
      false => TextValueCallArrowContinue(
        text_value_call_arrow_scan_advance(source, scan)
      ),
      true => match text_value_match_arm_token_matches(source, scan.index) {
        true => TextValueCallArrowFound,
        false => match text_value_call_arrow_scan_should_stop(source, scan) {
          true => TextValueCallArrowStopped,
          false => TextValueCallArrowContinue(
            text_value_call_arrow_scan_advance(source, scan)
          ),
        },
      },
    },
  }
}

fn text_value_call_has_match_arm_arrow_after(
  source: textlex.TextTokenStream,
  scan: TextValueCallArrowScan
) -> bool {
  match text_value_call_arrow_scan_step(source, scan) {
    TextValueCallArrowFound => true,
    TextValueCallArrowStopped => false,
    TextValueCallArrowContinue(next) => rec(source, next),
  }
}

fn text_value_call_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32
) -> i32 {
  text_value_body_count_scan(source, index, limit, total, TextValueBodyCallCount)
}

