fn text_declaration_root_child_record_signature(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl,
  total: i32
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  let parent_name_hash = textlex.text_hash_at(
    source,
    text_declaration_name_index(source, index, decl)
  );
  match kind_tag {
    1 => text_function_body_root_child_record_signature(
      source,
      index,
      kind_tag,
      parent_name_hash,
      total
    ),
    2 => text_value_declaration_body_root_child_record_signature(
      source,
      index,
      kind_tag,
      parent_name_hash,
      total
    ),
    3 => text_value_declaration_body_root_child_record_signature(
      source,
      index,
      kind_tag,
      parent_name_hash,
      total
    ),
    _ => total,
  }
}

