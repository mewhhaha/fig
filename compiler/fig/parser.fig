fn text_param_direct_import_resolved_type_class_for_name_hash_between(
  context: TextDirectImportContext,
  index: i32,
  close_index: i32,
  target_hash: i32
) -> i32 {
  match index >= close_index {
    true => text_type_class_unknown_tag(),
    false => text_param_direct_import_resolved_type_class_for_name_hash_continue(
      context,
      index,
      close_index,
      target_hash
    ),
  }
}

fn text_param_direct_import_resolved_type_class_for_name_hash_continue(
  context: TextDirectImportContext,
  index: i32,
  close_index: i32,
  target_hash: i32
) -> i32 {
  let comma = text_find_top_level_punctuation_score(
    context.source,
    index,
    close_index,
    0,
    7
  );
  let name_index = text_param_name_index_at(context.source, index, comma);
  let found = textlex.text_hash_at(context.source, name_index) == target_hash;
  match found {
    true => text_param_direct_import_resolved_type_class_for_segment(
      context,
      index,
      comma
    ),
    false => text_param_direct_import_resolved_type_class_for_name_hash_between(
      context,
      match comma < close_index {
        true => comma + 1,
        false => close_index,
      },
      close_index,
      target_hash
    ),
  }
}

fn text_param_direct_import_resolved_type_class_for_segment(
  context: TextDirectImportContext,
  index: i32,
  segment_end: i32
) -> i32 {
  let colon = text_find_top_level_punctuation_score(
    context.source,
    index,
    segment_end,
    0,
    8
  );
  match colon < segment_end {
    true => text_direct_import_annotation_resolved_type_class_tag_between(
      context.source,
      context.import_source,
      colon + 1,
      segment_end,
      context.alias_hash
    ),
    false => text_type_class_unknown_tag(),
  }
}

fn text_function_param_direct_import_resolved_type_class_for_name_hash(
  context: TextDirectImportContext,
  index: i32,
  target_hash: i32
) -> i32 {
  let next = text_declaration_end_from_index(context.source, index);
  let open_paren = text_function_open_paren_index(context.source, index, next);
  let close_paren = text_function_close_paren_index(
    context.source,
    open_paren,
    next
  );
  text_param_direct_import_resolved_type_class_for_name_hash_between(
    context,
    open_paren + 1,
    close_paren,
    target_hash
  )
}

fn text_function_body_direct_import_resolved_type_class_tag(
  context: TextDirectImportContext,
  index: i32
) -> i32 {
  let fallback = text_function_body_type_class_tag(context.source, index);
  match fallback == text_type_class_unknown_tag() {
    false => fallback,
    true => text_function_body_direct_import_resolved_unknown_type_class_tag(
      context,
      index
    ),
  }
}

fn text_function_direct_import_scalar_operator_operand_type_class(
  context: TextDirectImportContext,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let parenthesized = text_parenthesized_expression_segment_between(
    context.source,
    start,
    limit
  );
  match parenthesized.found {
    true => text_function_direct_import_scalar_operator_operand_type_class(
      context,
      function_index,
      parenthesized.start,
      parenthesized.limit
    ),
    false => text_function_direct_import_scalar_operator_operand_type_class_unwrapped(
      context,
      function_index,
      start,
      limit
    ),
  }
}

fn text_function_direct_import_scalar_operator_operand_type_class_unwrapped(
  context: TextDirectImportContext,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let root_kind = text_expression_root_head_kind_tag_between(
    context.source,
    start,
    limit
  );
  let root_type = text_expression_root_type_class_tag_between(
    context.source,
    start,
    limit
  );
  let operator_type = text_function_direct_import_scalar_operator_type_class_between(
    context,
    function_index,
    start,
    limit
  );
  match operator_type == text_type_class_unknown_tag() {
    false => operator_type,
    true => text_function_direct_import_scalar_branch_type_class_between(
      context,
      function_index,
      start,
      limit
    ) \branch_type -> match branch_type == text_type_class_unknown_tag() {
      false => branch_type,
      true => text_root_literal_type_class(
        root_kind,
        root_type
      ) \literal_type -> match literal_type == text_type_class_unknown_tag() {
        false => literal_type,
        true => match root_kind == text_expression_root_identifier_tag() {
          true => text_expression_root_head_hash_between(
            context.source,
            start,
            limit
          ) \target_hash -> text_expression_root_call_arg_count_between(
            context.source,
            start,
            limit
          ) \call_arg_count -> match call_arg_count == text_no_root_call_arg_count() {
            true => match text_expression_root_is_bare_identifier_between(
              context.source,
              start,
              limit
            ) {
              true => text_function_param_direct_import_resolved_type_class_for_name_hash(
                context,
                function_index,
                target_hash
              ),
              false => text_type_class_unknown_tag(),
            },
            false => text_root_call_direct_import_return_type_class_for_hash_between(
              context,
              start,
              limit,
              target_hash
            ),
          },
          false => text_type_class_unknown_tag(),
        },
      },
    },
  }
}

fn text_function_body_direct_import_scalar_operator_operand_type_class(
  context: TextDirectImportContext,
  function_index: i32,
  start: i32,
  limit: i32
) -> i32 {
  let parenthesized = text_parenthesized_expression_segment_between(
    context.source,
