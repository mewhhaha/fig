) -> i32 {
  let type_class = text_type_result_kind_type_class_tag(
    text_type_result_kind_tag(source, index)
  );
  match type_class == text_type_class_type_value_tag() {
    false => type_class,
    true => match is_text_type_function_start(source, index) {
      true => text_type_function_body_type_class_tag(
        source,
        index,
        text_declaration_end_from_index(source, index),
        depth
      ),
      false => text_type_sugar_alias_type_class_tag(
        source,
