fn text_annotation_type_class_tag_from_hash(value_hash: i32) -> i32 {
  match value_hash == 116078 {
    true => text_type_class_i32_tag(),
    false => match value_hash == 3646476 {
      true => text_type_class_bool_tag(),
      false => match value_hash == 3476 {
        true => text_type_class_function_tag(),
        false => text_type_class_unknown_tag(),
      },
    },
  }
}

fn text_literal_type_token_has_marker(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  let token_span = textlex.token_at(source, index).span;
  textlex.source_code_at(source, token_span.start) == textlex.TextCharCode::Hash
}

fn text_annotation_literal_type_class_tag_for_token(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  match textlex.token_at(source, index).kind {
    BoolLiteral => text_type_class_bool_tag(),
    NumberLiteral => text_type_class_i32_tag(),
    StringLiteral => text_type_class_i32_tag(),
    CharLiteral => text_type_class_i32_tag(),
    MultilineLiteral => text_type_class_i32_tag(),
    LiteralType if text_literal_type_token_has_marker(source, index) =>
      text_type_class_i32_tag(),
    _ => match textlex.punctuation_at(source, index) {
      PunctOther if text_signed_number_start_matches(source, index, limit) =>
        text_type_class_i32_tag(),
      _ => text_type_class_unknown_tag(),
    },
  }
}

fn text_annotation_type_class_tag_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32
) -> i32 {
  match index >= limit {
    true => text_type_class_unknown_tag(),
    false => match text_param_signature_is_trivia(source, index) {
      true => text_annotation_type_class_tag_between(
        source,
        index + 1,
        limit
      ),
      false => text_annotation_literal_type_class_tag_for_token(
        source,
        index,
        limit
      ) \literal_type -> match literal_type == text_type_class_unknown_tag() {
        false => literal_type,
        true => text_annotation_type_class_tag_from_hash(
          textlex.text_hash_at(source, index)
        ),
      },
    },
  }
}

fn text_function_return_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let open_paren = text_function_open_paren_index(source, index, next);
  let close_paren = text_function_close_paren_index(source, open_paren, next);
  let arrow = text_function_arrow_index(source, close_paren, next);
  let left_brace = text_function_left_brace_index(source, arrow, next);
  let body_start = text_function_body_start_index(source, arrow, left_brace);
  text_annotation_type_class_tag_between(source, arrow + 1, body_start)
}

fn text_value_annotation_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32
) -> i32 {
  let next = text_declaration_end_from_index(source, index);
  let equal = text_find_top_level_punctuation_score(
    source,
    index + 2,
    next,
    0,
    1
  );
  let colon = text_find_top_level_punctuation_score(
    source,
    index + 2,
    equal,
    0,
    8
  );
  match colon < equal {
    true => text_annotation_type_class_tag_between(source, colon + 1, equal),
    false => text_type_class_unknown_tag(),
  }
}

fn text_type_result_kind_type_class_tag(kind_tag: i32) -> i32 {
  match kind_tag == text_type_result_kind_struct_tag() {
    true => text_type_class_product_tag(),
    false => match kind_tag == text_type_result_kind_union_tag() {
      true => text_type_class_union_tag(),
      false => text_type_class_type_value_tag(),
    },
  }
}

fn text_declaration_type_class_tag(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  match text_declaration_kind_is_function(kind_tag) {
    true => text_type_class_function_tag(),
    false => match text_declaration_kind_is_value_binding(kind_tag) {
      true => text_value_annotation_type_class_tag(source, index),
      false => match text_declaration_kind_is_type(kind_tag) {
        true => text_type_result_kind_type_class_tag(
          text_type_result_kind_tag(source, index)
        ),
        false => text_type_class_unknown_tag(),
      },
    },
  }
}

fn text_declaration_type_class_payload(
  source: textlex.TextTokenStream,
  index: i32,
  decl: ast.Decl
) -> i32 {
  let kind_tag = text_declaration_kind_tag(source, index, decl);
  match text_declaration_kind_is_function(kind_tag) {
    true => ast.decl_param_count(decl) * 31
      + text_function_return_type_class_tag(source, index),
    false => 0,
  }
}

