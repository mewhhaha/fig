) -> TextRuntimeParamIndexScan {
  TextRuntimeParamIndexScan {
    index: index,
    close_index: close_index,
    target_hash: target_hash,
    runtime_index: runtime_index,
  }
}

fn text_function_local_let_scan(
  index: i32,
