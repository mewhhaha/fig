    index <- monad.Reader::asks(text_direct_import_decl_index);
    decl <- monad.Reader::asks(text_direct_import_decl_decl);
    pure(match is_text_external_import_start(import_context.source, index) {
      true => total,
      false => text_declaration_kind_tag(
        import_context.source,
