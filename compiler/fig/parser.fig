fn text_named_type_environment_has_later_duplicate_scan(
  source: textlex.TextTokenStream,
  scan: TextNamedTypeLookupScan
) -> bool {
  match scan.index >= scan.limit {
    true => false,
    false => match text_named_lookup_scan_type_matches(source, scan) {
      true => true,
      false => text_named_type_environment_has_later_duplicate_scan(
        source,
        text_named_lookup_scan_next(source, scan)
      ),
    },
  }
}

fn text_named_type_environment_has_later_duplicate(
  source: textlex.TextTokenStream,
  index: i32,
  name_hash: i32
) -> bool {
  text_named_type_environment_has_later_duplicate_scan(
    source,
    TextNamedTypeLookupScan {
      index: index + 1,
      limit: textlex.length(source),
      brace_depth: 0,
      paren_depth: 0,
      target_hash: name_hash,
      depth: 0,
    }
  )
}

fn text_declaration_named_type_environment_signature_total_reader(
  total: i32
) -> monad.Reader(TextValueBodyContext, i32) {
  do @monad(monad.Reader(TextValueBodyContext, _)) {
    source <- monad.Reader::asks(text_value_body_context_source);
    index <- monad.Reader::asks(text_value_body_context_index);
    decl <- monad.Reader::asks(text_value_body_context_decl);
    let kind_tag = text_declaration_kind_tag(source, index, decl);
    match text_declaration_kind_is_type(kind_tag) {
      true => text_declaration_name_hash(source, index, decl) \name_hash ->
        match text_named_type_environment_has_later_duplicate(
          source,
          index,
          name_hash
        ) {
          true => pure(total),
          false => pure(text_signature_mix(
            total,
            text_named_type_environment_hash(
              name_hash,
              text_type_declaration_environment_type_class_tag(
                source,
                index,
                kind_tag
              )
            )
          )),
        },
      false => pure(total),
    }
  }
}

