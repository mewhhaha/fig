) -> i32 {
  text_declaration_value_body_count_delta(
    source,
    index,
    decl,
    TextValueBodyMatchCount
  )
}

fn text_value_do_token_matches(
  source: textlex.TextTokenStream,
  index: i32
) -> bool {
  text_token_weight_matches(source, index, 79)
}

fn text_value_do_count_between(
  source: textlex.TextTokenStream,
  index: i32,
  limit: i32,
  total: i32
) -> i32 {
  text_value_body_count_scan(source, index, limit, total, TextValueBodyDoCount)
}

fn text_declaration_value_do_count_delta(
