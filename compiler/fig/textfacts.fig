fn wasm_record_signature_reader(
  codes: layout.HeapArray(i32),
  kind: WasmRecordScanKind
) -> monad.Reader(WasmByteContext, i32) {
  do @monad(monad.Reader(WasmByteContext, _)) {
    context_value <- monad.Reader::ask();
    current <- monad.Reader::asks(wasm_byte_context_window_state);
    monad.Reader::pure(match kind {
      WasmRecordScanKind::ScanWasmFunctionRecord =>
        WasmByteContext::wasm_function_record_signature_from_env(
          context_value,
          codes
        ),
      WasmRecordScanKind::ScanWasmSectionRecord =>
        wasm_section_record_final_signature(
          WasmByteContext::wasm_section_record_scan(
            context_value,
            codes,
            current,
            wasm_initial_section_scan()
          )
        ),
      WasmRecordScanKind::ScanWasmByteRecord =>
        wasm_byte_record_final_signature(
          WasmByteContext::wasm_section_record_scan(
            context_value,
            codes,
            current,
            wasm_initial_section_scan()
          )
        ),
    })
  }
}

fn WasmByteContext::wasm_record_signature(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  kind: WasmRecordScanKind
) -> i32 {
  monad.Reader::run(
    wasm_record_signature_reader(codes, kind),
    context_value
  )
}

fn WasmByteContext::wasm_function_record_signature(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32)
) -> i32 {
  WasmByteContext::wasm_record_signature(
    context_value,
    codes,
    WasmRecordScanKind::ScanWasmFunctionRecord
  )
}

fn WasmByteContext::wasm_section_record_signature(
