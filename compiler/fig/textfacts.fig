fn wasm_byte_buffer(
  source: textlex.TextTokenStream,
  codes: layout.HeapArray(i32),
  base_offset: i32
) -> layout.HeapArray(i32) {
  let byte_context = wasm_byte_context(source, base_offset);
  wasm_byte_buffer_from_counts(
    byte_context,
    codes,
    wasm_function_count(source),
    wasm_export_count(byte_context)
  )
}

fn entry(seed: i32) -> i32 {
  seed
    + CheckedFactKind::CheckedDeclarationType
    + CheckedFactKind::CheckedDiagnostic
    + CheckedFactKind::LoweredDeclaration
    + CheckedFactKind::CheckedDeclarationRecord
    + CheckedFactKind::CheckedExpressionRecord
    + CheckedFactKind::CheckedExpressionChildRecord
    + CheckedFactKind::CheckedLocalEnvironment
    + CheckedFactKind::CheckedExpressionShape
    + CheckedFactKind::LoweredExportRecord
    + CheckedFactKind::WasmFunctionRecord
    + CheckedFactKind::WasmSectionRecord
    + CheckedFactKind::WasmByteRecord
}
