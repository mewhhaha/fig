  );
  let with_operator = textmodel.signature_mix(
    with_root_operator,
    fact.operator_count
  );
  let with_operator_signature = textmodel.signature_mix(
    with_operator,
    fact.operator_signature_hash
  );
  let with_match = textmodel.signature_mix(
    with_operator_signature,
    fact.match_count
