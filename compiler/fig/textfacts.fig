fn wasm_function_record_signature(
  source: textlex.TextTokenStream,
  codes: layout.HeapArray(i32),
  base_offset: i32
) -> i32 {
  WasmByteContext::wasm_function_record_signature(
    wasm_byte_context(source, base_offset),
    codes
  )
}

