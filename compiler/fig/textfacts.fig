fn wasm_scalar_body_immediate_from_binding(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  binding: WasmFunctionBinding
) -> core.Option(i32) {
  let start = parser.text_expression_start_skip_trivia(
    context_value.source,
    binding.body_start,
    binding.declaration_limit
  );
  let token_span = textlex.token_at(context_value.source, start).span;
  let root_kind = parser.text_expression_root_head_kind_tag_between(
    context_value.source,
    binding.body_start,
    binding.declaration_limit
  );
  let is_standalone = parser.text_scalar_literal_is_standalone(
    context_value.source,
    start,
    binding.declaration_limit
  );
  match is_standalone {
    false => option.none(),
    true => match root_kind == parser.text_expression_root_number_tag() {
      true => wasm_small_u7_decimal_literal(
        codes,
        context_value.base_offset,
        token_span
      ),
      false => match root_kind == parser.text_expression_root_bool_tag() {
        true => wasm_bool_literal_immediate(
          codes,
          context_value.base_offset,
          token_span
        ),
        false => option.none(),
      },
    },
  }
}

fn wasm_byte_body_instruction_from_binding(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  binding: WasmFunctionBinding
) -> WasmBodyInstruction {
  let root_kind = parser.text_expression_root_head_kind_tag_between(
    context_value.source,
    binding.body_start,
    binding.declaration_limit
  );
  let semantic: core.Option(WasmBodyInstruction) = match abi_class_is_scalar(
    binding.body_abi_class
  ) {
    false => option.none(),
    true => match root_kind == parser.text_expression_root_identifier_tag() {
      true => wasm_scalar_identifier_body_instruction_from_binding(
        context_value,
        binding
      ),
      false => do @monad(core.Option(_)) {
        value <- wasm_scalar_body_immediate_from_binding(
          context_value,
          codes,
          binding
        );
        pure(wasm_body_instruction(wasm_const_opcode(), value))
      },
    },
  };
  match semantic {
    Some(value) => value,
    None => wasm_body_instruction(
      wasm_body_opcode_for_abi(binding.body_abi_class),
      match binding.body_abi_class == parser.text_abi_class_void_tag() {
        true => 0,
        false => parser.text_expression_root_head_hash_between(
          context_value.source,
          binding.body_start,
          binding.declaration_limit
        ),
      }
    ),
  }
}

fn wasm_function_match_body_plan_from_binding(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  binding: WasmFunctionBinding
) -> core.Option(WasmBodyPlan) {
  let segments = parser.text_function_bool_match_body_segments(
    context_value.source,
    binding.cursor
  );
  let lowering = wasm_call_lowering_for_binding(context_value, codes, binding);
  do @monad(core.Option(_)) {
    option.guard(abi_class_is_scalar(binding.body_abi_class));
    option.guard(wasm_type_class_is_scalar(binding.actual_type_class));
    option.guard(segments.found);
    true_plan <- WasmCallLowering::segment_plan(
      lowering,
      segments.true_value_start,
      segments.true_value_limit,
      true
    );
    false_plan <- WasmCallLowering::segment_plan(
      lowering,
      segments.false_value_start,
      segments.false_value_limit,
      true
    );
    pure(wasm_body_plan_push_instruction(
      wasm_body_plan_empty(6),
      wasm_body_instruction(wasm_local_get_opcode(), 0)
    ) \with_condition -> wasm_body_plan_push_instruction(
      with_condition,
      wasm_body_instruction(wasm_if_opcode(), wasm_i32_val_type())
    ) \with_if -> wasm_body_plan_append_plan(
      with_if,
      true_plan
    ) \with_true -> wasm_body_plan_push_instruction(
      with_true,
      wasm_body_instruction(wasm_else_opcode(), 0)
    ) \with_else -> wasm_body_plan_append_plan(
      with_else,
      false_plan
    ) \with_false -> wasm_body_plan_push_instruction(
      with_false,
      wasm_body_instruction(wasm_end_opcode(), 0)
    ))
  }
}

fn wasm_scalar_expression_body_plan_from_binding(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  binding: WasmFunctionBinding
) -> core.Option(WasmBodyPlan) {
  do @monad(core.Option(_)) {
    option.guard(abi_class_is_scalar(binding.body_abi_class));
    WasmCallLowering::segment_plan(
      wasm_call_lowering_for_binding(context_value, codes, binding),
      binding.body_start,
      binding.declaration_limit,
      true
    )
  }
}

fn wasm_scalar_call_body_plan_from_binding(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  binding: WasmFunctionBinding
) -> core.Option(WasmBodyPlan) {
  do @monad(core.Option(_)) {
    option.guard(abi_class_is_scalar(binding.body_abi_class));
    WasmCallLowering::call_segment_plan(
      wasm_call_lowering_for_binding(context_value, codes, binding),
      binding.body_start,
      binding.declaration_limit
    )
  }
}

fn wasm_scalar_operator_body_plan_from_binding(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  binding: WasmFunctionBinding
) -> core.Option(WasmBodyPlan) {
  let parts = parser.text_expression_root_single_operator_parts_between(
    context_value.source,
    binding.body_start,
    binding.declaration_limit
  );
  do @monad(core.Option(_)) {
    option.guard(abi_class_is_scalar(binding.body_abi_class));
    option.guard(parts.found);
    opcode <- wasm_scalar_operator_opcode(parts.operator_hash);
    wasm_scalar_operator_body_plan_from_parts(
      wasm_call_lowering_for_binding(context_value, codes, binding),
      parts,
      opcode
    )
  }
}

fn wasm_scalar_base_body_plan_from_binding(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  binding: WasmFunctionBinding
) -> core.Option(WasmBodyPlan) {
  match wasm_scalar_expression_body_plan_from_binding(context_value, codes, binding) {
    Some(plan) => option.some(plan),
    None => match wasm_scalar_call_body_plan_from_binding(
      context_value,
      codes,
      binding
    ) {
      Some(plan) => option.some(plan),
      None => wasm_scalar_operator_body_plan_from_binding(
        context_value,
        codes,
        binding
      ),
    },
  }
}

fn wasm_byte_base_body_plan_from_binding(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  binding: WasmFunctionBinding
) -> WasmBodyPlan {
  match wasm_function_match_body_plan_from_binding(context_value, codes, binding) {
    Some(plan) => plan,
    None => match wasm_scalar_base_body_plan_from_binding(
      context_value,
      codes,
      binding
    ) {
      Some(plan) => plan,
      None => wasm_single_instruction_body_plan(
        wasm_byte_body_instruction_from_binding(context_value, codes, binding)
      ),
    },
  }
}

fn wasm_scalar_local_let_prefixed_body_plan_from_binding(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  binding: WasmFunctionBinding,
  body_plan: WasmBodyPlan
) -> core.Option(WasmBodyPlan) {
  do @monad(core.Option(_)) {
    option.guard(abi_class_is_scalar(binding.body_abi_class));
    match binding.local_count <= 0 {
      true => option.some(body_plan),
      false => do @monad(core.Option(_)) {
        local_plan <- wasm_scalar_local_let_initializer_plans(
          wasm_call_lowering_for_binding(context_value, codes, binding),
          wasm_body_plan_empty(binding.local_count + 1),
          0,
          binding.local_count
        );
        pure(wasm_body_plan_append_plan(local_plan, body_plan))
      },
    }
  }
}

fn wasm_byte_body_plan_from_binding(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  binding: WasmFunctionBinding
) -> WasmBodyPlan {
  let base_plan = wasm_byte_base_body_plan_from_binding(
    context_value,
    codes,
    binding
  );
  match wasm_scalar_local_let_prefixed_body_plan_from_binding(
    context_value,
    codes,
    binding,
    base_plan
  ) {
    Some(plan) => plan,
    None => base_plan,
  }
}

fn wasm_function_match_body_summary_from_binding(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  binding: WasmFunctionBinding
) -> core.Option(WasmBodySummary) {
  let segments = parser.text_function_bool_match_body_segments(
    context_value.source,
    binding.cursor
  );
  let lowering = wasm_call_lowering_for_binding(context_value, codes, binding);
  do @monad(core.Option(_)) {
    option.guard(abi_class_is_scalar(binding.body_abi_class));
    option.guard(wasm_type_class_is_scalar(binding.actual_type_class));
    option.guard(segments.found);
    true_summary <- WasmCallLowering::segment_summary(
      lowering,
      segments.true_value_start,
      segments.true_value_limit,
      true
    );
    false_summary <- WasmCallLowering::segment_summary(
      lowering,
      segments.false_value_start,
      segments.false_value_limit,
      true
    );
    pure(wasm_body_summary_push_instruction(
      wasm_body_summary_empty(),
      wasm_body_instruction(wasm_local_get_opcode(), 0)
    ) \with_condition -> wasm_body_summary_push_instruction(
      with_condition,
      wasm_body_instruction(wasm_if_opcode(), wasm_i32_val_type())
    ) \with_if -> wasm_body_summary_append(
      with_if,
      true_summary
    ) \with_true -> wasm_body_summary_push_instruction(
      with_true,
      wasm_body_instruction(wasm_else_opcode(), 0)
    ) \with_else -> wasm_body_summary_append(
      with_else,
      false_summary
    ) \with_false -> wasm_body_summary_push_instruction(
      with_false,
      wasm_body_instruction(wasm_end_opcode(), 0)
    ))
  }
}

fn wasm_scalar_expression_body_summary_from_binding(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  binding: WasmFunctionBinding
) -> core.Option(WasmBodySummary) {
  let lowering = wasm_call_lowering_for_binding(context_value, codes, binding);
  let root_kind = parser.text_expression_root_head_kind_tag_between(
    context_value.source,
    binding.body_start,
    binding.declaration_limit
  );
  do @monad(core.Option(_)) {
    option.guard(abi_class_is_scalar(binding.body_abi_class));
    match root_kind == parser.text_expression_root_match_tag() {
      true => WasmCallLowering::branch_segment_summary_if_possible(
        lowering,
        binding.body_start,
        binding.declaration_limit
      ),
      false => match wasm_simple_root_summary_candidate(
        context_value.source,
        binding.body_start,
        binding.declaration_limit,
        root_kind
      ) {
        true => WasmCallLowering::simple_segment_summary(
          lowering,
          binding.body_start,
          binding.declaration_limit
        ),
        false => option.none(),
      },
    }
  }
}

fn wasm_scalar_call_body_summary_from_binding(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  binding: WasmFunctionBinding
) -> core.Option(WasmBodySummary) {
  do @monad(core.Option(_)) {
    option.guard(abi_class_is_scalar(binding.body_abi_class));
    WasmCallLowering::call_segment_summary(
      wasm_call_lowering_for_binding(context_value, codes, binding),
      binding.body_start,
      binding.declaration_limit
    )
  }
}

fn wasm_scalar_operator_body_summary_from_binding(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  binding: WasmFunctionBinding
) -> core.Option(WasmBodySummary) {
  let parts = parser.text_expression_root_single_operator_parts_between(
    context_value.source,
    binding.body_start,
    binding.declaration_limit
  );
  do @monad(core.Option(_)) {
    option.guard(abi_class_is_scalar(binding.body_abi_class));
    option.guard(parts.found);
    opcode <- wasm_scalar_operator_opcode(parts.operator_hash);
    wasm_scalar_operator_body_summary_from_parts(
      wasm_call_lowering_for_binding(context_value, codes, binding),
      parts,
      opcode
    )
  }
}

fn wasm_scalar_base_body_summary_from_binding(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  binding: WasmFunctionBinding
) -> core.Option(WasmBodySummary) {
  match wasm_scalar_expression_body_summary_from_binding(context_value, codes, binding) {
    Some(summary) => option.some(summary),
    None => match wasm_scalar_call_body_summary_from_binding(
      context_value,
      codes,
      binding
    ) {
      Some(summary) => option.some(summary),
      None => wasm_scalar_operator_body_summary_from_binding(
        context_value,
        codes,
        binding
      ),
    },
  }
}

fn wasm_simple_root_kind_can_summarize(root_kind: i32) -> bool {
  match root_kind == parser.text_expression_root_number_tag() {
    true => true,
    false => match root_kind == parser.text_expression_root_bool_tag() {
      true => true,
      false => root_kind == parser.text_expression_root_identifier_tag(),
    },
  }
}

fn wasm_simple_root_summary_candidate(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32,
  root_kind: i32
) -> bool {
  match wasm_simple_root_kind_can_summarize(root_kind) {
    false => false,
    true => match parser.text_expression_root_call_arg_count_between(
      source,
      start,
      limit
    ) == parser.text_no_root_call_arg_count() {
      false => false,
      true => match parser.text_expression_root_head_selector_count_between(
        source,
        start,
        limit
      ) == 0 {
        false => false,
        true => match parser.text_expression_root_field_count_between(
          source,
          start,
          limit
        ) == 0 {
          false => false,
          true => match parser.text_expression_root_operator_count_between(
            source,
            start,
            limit
          ) == 0 {
            false => false,
            true => parser.text_value_pipe_bind_count_between(
              source,
              start,
              limit,
              0
            ) == 0,
          },
        },
      },
    },
  }
}

fn wasm_byte_base_body_summary_from_binding(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  binding: WasmFunctionBinding
) -> WasmBodySummary {
  match wasm_function_match_body_summary_from_binding(context_value, codes, binding) {
    Some(summary) => summary,
    None => match wasm_scalar_base_body_summary_from_binding(
      context_value,
      codes,
      binding
    ) {
      Some(summary) => summary,
      None => wasm_instruction_summary(
        wasm_byte_body_instruction_from_binding(context_value, codes, binding)
      ),
    },
  }
}

fn wasm_scalar_local_let_initializer_summary(
  lowering: WasmCallLowering,
  local_index: i32
) -> core.Option(WasmBodySummary) {
  let segment = parser.text_function_local_let_value_segment_for_index(
    lowering.context_value.source,
    lowering.current.cursor,
    local_index
  );
  let wasm_index = lowering.runtime_param_count + local_index;
  match wasm_index < wasm_small_immediate_limit() {
    false => option.none(),
    true => match WasmCallLowering::arg_summary(lowering, segment) {
      None => option.none(),
      Some(summary) => option.some(wasm_body_summary_push_instruction(
        summary,
        wasm_body_instruction(wasm_local_set_opcode(), wasm_index)
      )),
    },
  }
}

fn wasm_scalar_local_let_initializer_summaries(
  lowering: WasmCallLowering,
  summary: WasmBodySummary,
  local_index: i32,
  local_count: i32
) -> core.Option(WasmBodySummary) {
  match local_index >= local_count {
    true => option.some(summary),
    false => do @monad(core.Option(_)) {
      local_summary <- wasm_scalar_local_let_initializer_summary(
        lowering,
        local_index
      );
      wasm_scalar_local_let_initializer_summaries(
        lowering,
        wasm_body_summary_append(summary, local_summary),
        local_index + 1,
        local_count
      )
    },
  }
}

fn wasm_local_let_summary_is_current(
  lowering: WasmCallLowering,
  scan: WasmLocalLetSummaryScan
) -> bool {
  match parser.text_depth_is_top_level(scan.brace_depth, scan.paren_depth) {
    false => false,
    true => match textlex.token_at(lowering.context_value.source, scan.index).kind {
      LetKw => true,
      _ => false,
    },
  }
}

fn wasm_local_let_summary_scan_from_parser(
  scan: parser.TextFunctionLocalLetScan
) -> WasmLocalLetSummaryScan {
  WasmLocalLetSummaryScan {
    index: scan.index,
    limit: scan.limit,
    brace_depth: scan.brace_depth,
    paren_depth: scan.paren_depth,
    total: scan.total,
  }
}

fn wasm_local_let_summary_advance(
  lowering: WasmCallLowering,
  scan: WasmLocalLetSummaryScan
) -> WasmLocalLetSummaryScan {
  WasmLocalLetSummaryScan {
    index: scan.index + 1,
    limit: scan.limit,
    brace_depth: parser.brace_depth_after_token(
      lowering.context_value.source,
      scan.index,
      scan.brace_depth
    ),
    paren_depth: parser.paren_depth_after_token(
      lowering.context_value.source,
      scan.index,
      scan.paren_depth
    ),
    total: scan.total,
  }
}

fn wasm_local_let_summary_after_statement(
  scan: WasmLocalLetSummaryScan,
  statement_end: i32
) -> WasmLocalLetSummaryScan {
  WasmLocalLetSummaryScan {
    index: statement_end + 1,
    limit: scan.limit,
    brace_depth: scan.brace_depth,
    paren_depth: scan.paren_depth,
    total: scan.total + 1,
  }
}

fn wasm_local_let_summary_value_segment(
  lowering: WasmCallLowering,
  scan: WasmLocalLetSummaryScan,
  statement_end: i32
) -> parser.TextArgumentSegment {
  let equal = parser.text_local_let_equal_index(
    lowering.context_value.source,
    scan.index,
    statement_end
  );
  match equal < statement_end {
    true => parser.text_argument_segment_present(
      lowering.context_value.source,
      equal + 1,
      statement_end
    ),
    false => parser.text_argument_segment_none(statement_end),
  }
}

fn wasm_local_let_initializer_summary_at_scan(
  lowering: WasmCallLowering,
  scan: WasmLocalLetSummaryScan
) -> core.Option(WasmBodySummary) {
  let statement_end = parser.text_local_let_statement_end(
    lowering.context_value.source,
    scan.index,
    scan.limit
  );
  let segment = wasm_local_let_summary_value_segment(
    lowering,
    scan,
    statement_end
  );
  let wasm_index = lowering.runtime_param_count + scan.total;
  match wasm_index < wasm_small_immediate_limit() {
    false => option.none(),
    true => match WasmCallLowering::arg_summary(lowering, segment) {
      None => option.none(),
      Some(summary) => option.some(wasm_body_summary_push_instruction(
        summary,
        wasm_body_instruction(wasm_local_set_opcode(), wasm_index)
      )),
    },
  }
}

fn wasm_local_let_initializer_summary_scan(
  lowering: WasmCallLowering,
  summary: WasmBodySummary,
  scan: WasmLocalLetSummaryScan,
  local_count: i32
) -> core.Option(WasmBodySummary) {
  match scan.total >= local_count {
    true => option.some(summary),
    false => match scan.index >= scan.limit {
      true => option.some(summary),
      false => match wasm_local_let_summary_is_current(lowering, scan) {
        false => rec(
          lowering,
          summary,
          wasm_local_let_summary_advance(lowering, scan),
          local_count
        ),
        true => parser.text_local_let_statement_end(
          lowering.context_value.source,
          scan.index,
          scan.limit
        ) \statement_end -> do @monad(core.Option(_)) {
          local_summary <- wasm_local_let_initializer_summary_at_scan(
            lowering,
            scan
          );
          wasm_local_let_initializer_summary_scan(
            lowering,
            wasm_body_summary_append(summary, local_summary),
            wasm_local_let_summary_after_statement(scan, statement_end),
            local_count
          )
        },
      },
    },
  }
}

fn wasm_scalar_local_let_prefixed_body_summary_from_binding(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  binding: WasmFunctionBinding,
  body_summary: WasmBodySummary
) -> core.Option(WasmBodySummary) {
  do @monad(core.Option(_)) {
    option.guard(abi_class_is_scalar(binding.body_abi_class));
    match binding.local_count <= 0 {
      true => option.some(body_summary),
      false => do @monad(core.Option(_)) {
        lowering <- pure(wasm_call_lowering_for_binding(
          context_value,
          codes,
          binding
        ));
        local_summary <- wasm_local_let_initializer_summary_scan(
          lowering,
          wasm_body_summary_empty(),
          wasm_local_let_summary_scan_from_parser(
            parser.text_function_local_let_bounds_scan(
              context_value.source,
              binding.cursor
            )
          ),
          binding.local_count
        );
        pure(wasm_body_summary_append(local_summary, body_summary))
      },
    }
  }
}

fn wasm_byte_body_summary_from_binding(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  binding: WasmFunctionBinding
) -> WasmBodySummary {
  let base_summary = wasm_byte_base_body_summary_from_binding(
    context_value,
    codes,
    binding
  );
  match wasm_scalar_local_let_prefixed_body_summary_from_binding(
    context_value,
    codes,
    binding,
    base_summary
  ) {
    Some(summary) => summary,
    None => base_summary,
  }
}

fn wasm_byte_function_fact_from_binding(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  binding: WasmFunctionBinding
) -> WasmFunctionFact {
  let body_plan = wasm_byte_body_plan_from_binding(
    context_value,
    codes,
    binding
  );
  WasmFunctionFact {
    name_hash: binding.name_hash,
    export_tag: binding.export_tag,
    runtime_param_count: binding.runtime_param_count,
    local_count: binding.local_count,
    result_val_type: binding.result_val_type,
    body_opcode: body_plan.first_opcode,
    body_immediate: body_plan.first_immediate,
    terminator_opcode: binding.terminator_opcode,
    body_size: wasm_function_body_size(
      binding.local_count,
      body_plan.byte_size,
      binding.terminator_opcode
    ),
    diagnostic_code: binding.diagnostic_code,
  }
}

fn wasm_function_fact_signature(fact: WasmFunctionFact) -> i32 {
  let with_name = textmodel.signature_mix(73, fact.name_hash);
  let with_export = textmodel.signature_mix(with_name, fact.export_tag);
  let with_params = textmodel.signature_mix(
    with_export,
    fact.runtime_param_count
  );
  let with_locals = textmodel.signature_mix(with_params, fact.local_count);
  let with_result = textmodel.signature_mix(with_locals, fact.result_val_type);
  let with_opcode = textmodel.signature_mix(with_result, fact.body_opcode);
  let with_immediate = textmodel.signature_mix(
    with_opcode,
    fact.body_immediate
  );
  let with_terminator = textmodel.signature_mix(
    with_immediate,
    fact.terminator_opcode
  );
  let with_size = textmodel.signature_mix(with_terminator, fact.body_size);
  textmodel.signature_mix(with_size, fact.diagnostic_code)
}

fn text_token_width(source: textlex.TextTokenStream, index: i32) -> i32 {
  span.width(textlex.token_at(source, index).span)
}

fn wasm_section_fact_signature(fact: WasmSectionFact) -> i32 {
  let with_section = textmodel.signature_mix(79, fact.section_id);
  let with_items = textmodel.signature_mix(with_section, fact.item_count);
  let with_size = textmodel.signature_mix(with_items, fact.payload_size);
  let with_signature = textmodel.signature_mix(
    with_size,
    fact.payload_signature
  );
  textmodel.signature_mix(with_signature, fact.diagnostic_signature)
}

fn wasm_byte_section_fact(
  section_id: i32,
  payload_size: i32,
  payload_signature: i32,
  diagnostic_signature: i32
) -> WasmByteSectionFact {
  WasmByteSectionFact {
    section_id: section_id,
    payload_size: payload_size,
    payload_leb_size: wasm_u32_leb_size(payload_size),
    section_size: wasm_section_total_size(payload_size),
    header_signature: wasm_section_header_signature(section_id, payload_size),
    payload_signature: payload_signature,
    diagnostic_signature: diagnostic_signature,
  }
}

fn wasm_byte_section_fact_signature(fact: WasmByteSectionFact) -> i32 {
  let with_section = textmodel.signature_mix(109, fact.section_id);
  let with_payload = textmodel.signature_mix(with_section, fact.payload_size);
  let with_leb = textmodel.signature_mix(with_payload, fact.payload_leb_size);
  let with_size = textmodel.signature_mix(with_leb, fact.section_size);
  let with_header = textmodel.signature_mix(with_size, fact.header_signature);
  let with_signature = textmodel.signature_mix(
    with_header,
    fact.payload_signature
  );
  textmodel.signature_mix(with_signature, fact.diagnostic_signature)
}

fn wasm_byte_module_fact_signature(fact: WasmByteModuleFact) -> i32 {
  let with_magic = textmodel.signature_mix(113, fact.magic_signature);
  let with_version = textmodel.signature_mix(with_magic, fact.version_signature);
  let with_count = textmodel.signature_mix(with_version, fact.section_count);
  let with_size = textmodel.signature_mix(with_count, fact.byte_size);
  let with_sections = textmodel.signature_mix(
    with_size,
    fact.section_signature
  );
  textmodel.signature_mix(with_sections, fact.diagnostic_signature)
}

fn wasm_initial_section_scan() -> WasmSectionScan {
  WasmSectionScan {
    function_count: 0,
    export_count: 0,
    type_payload_size: 1,
    type_payload_signature: 0,
    function_payload_size: 1,
    function_payload_signature: 0,
    export_payload_size: 1,
    export_payload_signature: 0,
    code_payload_size: 1,
    code_payload_signature: 0,
    diagnostic_signature: 0,
  }
}

fn wasm_section_export_count(scan: WasmSectionScan, fact: WasmFunctionFact) -> i32 {
  scan.export_count + fact.export_tag
}

fn wasm_section_export_payload_size(
  source: textlex.TextTokenStream,
  current: combinator.ParseState,
  decl: ast.Decl,
  scan: WasmSectionScan,
  fact: WasmFunctionFact
) -> i32 {
  match fact.export_tag == 1 {
    true => scan.export_payload_size
      + wasm_export_entry_size(
        text_token_width(
          source,
          parser.text_declaration_name_index(source, current.cursor, decl)
        )
      ),
    false => scan.export_payload_size,
  }
}

fn wasm_section_export_payload_signature(
  scan: WasmSectionScan,
  fact: WasmFunctionFact,
  function_index: i32
) -> i32 {
  match fact.export_tag == 1 {
    true => textmodel.signature_mix(
      scan.export_payload_signature,
      wasm_export_entry_signature(fact.name_hash, function_index)
    ),
    false => scan.export_payload_signature,
  }
}

fn wasm_section_scan_function(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  result: combinator.Reply(parser.DeclFrame),
  scan: WasmSectionScan
) -> WasmSectionScan {
  let decl = result.value.decl;
  let fact = wasm_byte_function_fact(context_value, codes, current, result);
  let function_index = scan.function_count;
  WasmSectionScan {
    function_count: scan.function_count + 1,
    export_count: wasm_section_export_count(scan, fact),
    type_payload_size: scan.type_payload_size
      + wasm_type_entry_size(fact.runtime_param_count, fact.result_val_type),
    type_payload_signature: textmodel.signature_mix(
      scan.type_payload_signature,
      wasm_type_entry_signature(fact.runtime_param_count, fact.result_val_type)
    ),
    function_payload_size: scan.function_payload_size + 1,
    function_payload_signature: textmodel.signature_mix(
      scan.function_payload_signature,
      function_index
    ),
    export_payload_size: wasm_section_export_payload_size(
      context_value.source,
      current,
      decl,
      scan,
      fact
    ),
    export_payload_signature: wasm_section_export_payload_signature(
      scan,
      fact,
      function_index
    ),
    code_payload_size: scan.code_payload_size + wasm_code_entry_size(fact.body_size),
    code_payload_signature: textmodel.signature_mix(
      scan.code_payload_signature,
      wasm_code_entry_signature(
        fact.local_count,
        fact.body_opcode,
        fact.body_immediate,
        fact.terminator_opcode,
        fact.body_size
      )
    ),
    diagnostic_signature: textmodel.signature_mix(
      scan.diagnostic_signature,
      fact.diagnostic_code
    ),
  }
}

fn wasm_section_record_final_signature(scan: WasmSectionScan) -> i32 {
  let type_total = textmodel.signature_mix(
    0,
    wasm_section_fact_signature(
      WasmSectionFact {
        section_id: wasm_type_section_id(),
        item_count: scan.function_count,
        payload_size: scan.type_payload_size,
        payload_signature: scan.type_payload_signature,
        diagnostic_signature: scan.diagnostic_signature,
      }
    )
  );
  let function_total = textmodel.signature_mix(
    type_total,
    wasm_section_fact_signature(
      WasmSectionFact {
        section_id: wasm_function_section_id(),
        item_count: scan.function_count,
        payload_size: scan.function_payload_size,
        payload_signature: scan.function_payload_signature,
        diagnostic_signature: scan.diagnostic_signature,
      }
    )
  );
  let export_total = textmodel.signature_mix(
    function_total,
    wasm_section_fact_signature(
      WasmSectionFact {
        section_id: wasm_export_section_id(),
        item_count: scan.export_count,
        payload_size: scan.export_payload_size,
        payload_signature: scan.export_payload_signature,
        diagnostic_signature: scan.diagnostic_signature,
      }
    )
  );
  textmodel.signature_mix(
    export_total,
    wasm_section_fact_signature(
      WasmSectionFact {
        section_id: wasm_code_section_id(),
        item_count: scan.function_count,
        payload_size: scan.code_payload_size,
        payload_signature: scan.code_payload_signature,
        diagnostic_signature: scan.diagnostic_signature,
      }
    )
  )
}

fn wasm_byte_record_final_signature(scan: WasmSectionScan) -> i32 {
  let type_section_size = wasm_section_total_size(scan.type_payload_size);
  let function_section_size = wasm_section_total_size(scan.function_payload_size);
  let export_section_size = wasm_section_total_size(scan.export_payload_size);
  let code_section_size = wasm_section_total_size(scan.code_payload_size);
  let byte_size = wasm_module_header_size()
    + type_section_size
    + function_section_size
    + export_section_size
    + code_section_size;
  let type_total = textmodel.signature_mix(
    0,
    wasm_byte_section_fact_signature(
      wasm_byte_section_fact(
        wasm_type_section_id(),
        scan.type_payload_size,
        scan.type_payload_signature,
        scan.diagnostic_signature
      )
    )
  );
  let function_total = textmodel.signature_mix(
    type_total,
    wasm_byte_section_fact_signature(
      wasm_byte_section_fact(
        wasm_function_section_id(),
        scan.function_payload_size,
        scan.function_payload_signature,
        scan.diagnostic_signature
      )
    )
  );
  let export_total = textmodel.signature_mix(
    function_total,
    wasm_byte_section_fact_signature(
      wasm_byte_section_fact(
        wasm_export_section_id(),
        scan.export_payload_size,
        scan.export_payload_signature,
        scan.diagnostic_signature
      )
    )
  );
  let section_total = textmodel.signature_mix(
    export_total,
    wasm_byte_section_fact_signature(
      wasm_byte_section_fact(
        wasm_code_section_id(),
        scan.code_payload_size,
        scan.code_payload_signature,
        scan.diagnostic_signature
      )
    )
  );
  wasm_byte_module_fact_signature(
    WasmByteModuleFact {
      magic_signature: wasm_magic_signature(),
      version_signature: wasm_version_signature(),
      section_count: wasm_emitted_section_count(),
      byte_size: byte_size,
      section_signature: section_total,
      diagnostic_signature: scan.diagnostic_signature,
    }
  )
}

fn is_function(
  source: textlex.TextTokenStream,
  current: combinator.ParseState,
  result: combinator.Reply(parser.DeclFrame)
) -> bool {
  parser.text_declaration_kind_is_function(
    parser.text_declaration_kind_tag(
      source,
      current.cursor,
      result.value.decl
    )
  )
}

fn wasm_function_lookup_not_found(function_index: i32) -> WasmFunctionLookup {
  WasmFunctionLookup {
    index: function_index,
    runtime_param_count: 0,
    found: false,
  }
}

fn wasm_function_lookup_found(
  function_index: i32,
  runtime_param_count: i32
) -> WasmFunctionLookup {
  WasmFunctionLookup {
    index: function_index,
    runtime_param_count: runtime_param_count,
    found: true,
  }
}

fn wasm_function_lookup_next_index(
  function_index: i32,
  is_decl_function: bool
) -> i32 {
  match is_decl_function {
    true => function_index + 1,
    false => function_index,
  }
}

fn wasm_function_lookup_for_hash_at(
  source: textlex.TextTokenStream,
  current: combinator.ParseState,
  target_hash: i32,
  function_index: i32
) -> WasmFunctionLookup {
  match current.cursor < textlex.length(source) {
    false => wasm_function_lookup_not_found(function_index),
    true => match parser.parse_text_declaration_stream(
      current,
      source,
      function_index
    ) {
      Err(_) => wasm_function_lookup_not_found(function_index),
      Ok(result) => match is_function(source, current, result) {
        false => wasm_function_lookup_for_hash_at(
          source,
          parser.next_text_declaration_state(result.state, source),
          target_hash,
          function_index
        ),
        true => parser.text_declaration_name_hash(
          source,
          current.cursor,
          result.value.decl
        ) \name_hash -> match name_hash == target_hash {
          true => wasm_function_lookup_found(
            function_index,
            parser.text_function_runtime_param_count(source, current.cursor)
          ),
          false => wasm_function_lookup_for_hash_at(
            source,
            parser.next_text_declaration_state(result.state, source),
            target_hash,
            wasm_function_lookup_next_index(function_index, true)
          ),
        },
      },
    },
  }
}

fn wasm_function_lookup_for_hash(
  source: textlex.TextTokenStream,
  target_hash: i32
) -> WasmFunctionLookup {
  wasm_function_lookup_for_hash_at(
    source,
    textmodel.full_window_state(source),
    target_hash,
    0
  )
}

fn is_pub_function(
  source: textlex.TextTokenStream,
  current: combinator.ParseState,
  result: combinator.Reply(parser.DeclFrame)
) -> bool {
  let is_function = parser.text_declaration_kind_is_function(
    parser.text_declaration_kind_tag(
      source,
      current.cursor,
      result.value.decl
    )
  );
  match is_function {
    true => match textlex.token_at(source, current.cursor).kind {
      PubKw => true,
      _ => false,
    },
    false => false,
  }
}

fn checked_local_fact_signature(fact: CheckedLocalFact) -> i32 {
  let with_function = textmodel.signature_mix(61, fact.function_name_hash);
  let with_kind = textmodel.signature_mix(with_function, fact.local_kind_tag);
  let with_name = textmodel.signature_mix(with_kind, fact.local_name_hash);
  let with_root_kind = textmodel.signature_mix(with_name, fact.value_root_kind);
  let with_root_hash = textmodel.signature_mix(
    with_root_kind,
    fact.value_root_hash
  );
  let with_expected = textmodel.signature_mix(
    with_root_hash,
    fact.expected_type_class
  );
  let with_actual = textmodel.signature_mix(
    with_expected,
    fact.actual_type_class
  );
  let with_status = textmodel.signature_mix(with_actual, fact.check_status);
  textmodel.signature_mix(with_status, fact.diagnostic_code)
}

fn checked_local_identifier_hash(
  context_value: FactContext,
  index: i32
) -> i32 {
  match textlex.token_at(context_value.source, index).kind {
    Identifier => textlex.text_hash_at(context_value.source, index),
    _ => 0,
  }
}

fn checked_local_equal_index(
  context_value: FactContext,
  index: i32,
  statement_end: i32
) -> i32 {
  parser.text_find_top_level_punctuation_score(
    context_value.source,
    index + 1,
    statement_end,
    0,
    textlex.punctuation_score(textlex.PunctEqual)
  )
}

fn checked_local_value_root_kind(
  context_value: FactContext,
  index: i32,
  statement_end: i32
) -> i32 {
  let equal = checked_local_equal_index(context_value, index, statement_end);
  match equal < statement_end {
    true => parser.text_expression_root_head_kind_tag_between(
      context_value.source,
      equal + 1,
      statement_end
    ),
    false => parser.text_expression_root_none_tag(),
  }
}

fn checked_local_value_root_hash(
  context_value: FactContext,
  index: i32,
  statement_end: i32
) -> i32 {
  let equal = checked_local_equal_index(context_value, index, statement_end);
  match equal < statement_end {
    true => parser.text_expression_root_head_hash_between(
      context_value.source,
      equal + 1,
      statement_end
    ),
    false => 0,
  }
}

fn checked_local_expected_type_class(
  context_value: FactContext,
  index: i32,
  statement_end: i32
) -> i32 {
  let equal = checked_local_equal_index(context_value, index, statement_end);
  let colon = parser.text_find_top_level_punctuation_score(
    context_value.source,
    index + 1,
    equal,
    0,
    textlex.punctuation_score(textlex.PunctColon)
  );
  match colon < equal {
    true => parser.text_annotation_resolved_type_class_tag_between(
      context_value.source,
      colon + 1,
      equal
    ),
    false => parser.text_type_class_unknown_tag(),
  }
}

fn checked_local_actual_type_class(
  context_value: FactContext,
  index: i32,
  statement_end: i32
) -> i32 {
  let equal = checked_local_equal_index(context_value, index, statement_end);
  match equal < statement_end {
    true => parser.text_expression_root_type_class_tag_between(
      context_value.source,
      equal + 1,
      statement_end
    ),
    false => parser.text_type_class_unknown_tag(),
  }
}

fn checked_local_let_fact(
  context_value: FactContext,
  function_name_hash: i32,
  index: i32,
  statement_end: i32
) -> CheckedLocalFact {
  let expected = checked_local_expected_type_class(
    context_value,
    index,
    statement_end
  );
  let actual = checked_local_actual_type_class(
    context_value,
    index,
    statement_end
  );
  let check_status = parser.text_simple_body_type_check_status(expected, actual);
  CheckedLocalFact {
    function_name_hash: function_name_hash,
    local_kind_tag: CheckedLocalFactKind::LocalLet,
    local_name_hash: checked_local_identifier_hash(context_value, index + 1),
    value_root_kind: checked_local_value_root_kind(
      context_value,
      index,
      statement_end
    ),
    value_root_hash: checked_local_value_root_hash(
      context_value,
      index,
      statement_end
    ),
    expected_type_class: expected,
    actual_type_class: actual,
    check_status: check_status,
    diagnostic_code: checked_type_status_diagnostic_code(check_status),
  }
}

fn checked_local_type_assert_fact(
  context_value: FactContext,
  function_name_hash: i32,
  index: i32
) -> CheckedLocalFact {
  let type_value = parser.text_type_class_type_value_tag();
  let check_status = parser.text_simple_body_type_check_status(type_value, type_value);
  CheckedLocalFact {
    function_name_hash: function_name_hash,
    local_kind_tag: CheckedLocalFactKind::LocalTypeAssert,
    local_name_hash: 0,
    value_root_kind: parser.text_expression_root_none_tag(),
    value_root_hash: 0,
    expected_type_class: type_value,
    actual_type_class: type_value,
    check_status: check_status,
    diagnostic_code: checked_type_status_diagnostic_code(check_status),
  }
}

fn checked_local_statement_end(
  context_value: FactContext,
  scan: CheckedLocalScan
) -> i32 {
  match scan.index >= scan.limit {
    true => scan.limit,
    false => match parser.text_semicolon_boundary(
      context_value.source,
      scan.index,
      scan.brace_depth,
      scan.paren_depth
    ) {
      true => scan.index,
      false => checked_local_statement_end(
        context_value,
        CheckedLocalScan {
          index: scan.index + 1,
          limit: scan.limit,
          brace_depth: parser.brace_depth_after_token(
            context_value.source,
            scan.index,
            scan.brace_depth
          ),
          paren_depth: parser.paren_depth_after_token(
            context_value.source,
            scan.index,
            scan.paren_depth
          ),
          total: scan.total,
          function_name_hash: scan.function_name_hash,
        }
      ),
    },
  }
}

fn checked_local_top_level_next_total(
  context_value: FactContext,
  scan: CheckedLocalScan
) -> i32 {
  match textlex.token_at(context_value.source, scan.index).kind {
    LetKw => textmodel.signature_mix(
      scan.total,
      checked_local_fact_signature(
        checked_local_let_fact(
          context_value,
          scan.function_name_hash,
          scan.index,
          checked_local_statement_end(context_value, scan)
        )
      )
    ),
    Symbol => match parser.text_type_assert_token_matches(
      context_value.source,
      scan.index,
      scan.limit
    ) {
      true => textmodel.signature_mix(
        scan.total,
        checked_local_fact_signature(
          checked_local_type_assert_fact(
            context_value,
            scan.function_name_hash,
            scan.index
          )
        )
      ),
      false => scan.total,
    },
    _ => scan.total,
  }
}

fn checked_local_next_total(
  context_value: FactContext,
  scan: CheckedLocalScan
) -> i32 {
  match parser.text_depth_is_top_level(scan.brace_depth, scan.paren_depth) {
    true => checked_local_top_level_next_total(context_value, scan),
    false => scan.total,
  }
}

fn checked_local_next_scan(
  context_value: FactContext,
  scan: CheckedLocalScan,
  next_total: i32
) -> CheckedLocalScan {
  CheckedLocalScan {
    index: scan.index + 1,
    limit: scan.limit,
    brace_depth: parser.brace_depth_after_token(
      context_value.source,
      scan.index,
      scan.brace_depth
    ),
    paren_depth: parser.paren_depth_after_token(
      context_value.source,
      scan.index,
      scan.paren_depth
    ),
    total: next_total,
    function_name_hash: scan.function_name_hash,
  }
}

fn checked_local_record_scan(
  context_value: FactContext,
  scan: CheckedLocalScan
) -> i32 {
  match scan.index >= scan.limit {
    true => scan.total,
    false => rec(
      context_value,
      checked_local_next_scan(
        context_value,
        scan,
        checked_local_next_total(context_value, scan)
      )
    ),
  }
}

fn checked_local_function_signature(
  context_value: FactContext,
  current: combinator.ParseState,
  total: i32,
  result: combinator.Reply(parser.DeclFrame)
) -> i32 {
  let source = context_value.source;
  let next = parser.text_declaration_end_from_index(source, current.cursor);
  let open_paren = parser.text_function_open_paren_index(
    source,
    current.cursor,
    next
  );
  let close_paren = parser.text_function_close_paren_index(
    source,
    open_paren,
    next
  );
  let arrow = parser.text_function_arrow_index(source, close_paren, next);
  let left_brace = parser.text_function_left_brace_index(source, arrow, next);
  let right_brace = parser.find_text_expression_limit(
    source,
    left_brace + 1,
    next,
    textlex.PunctRightBrace
  );
  let function_name_hash = parser.text_declaration_name_hash(
    source,
    current.cursor,
    result.value.decl
  );
  checked_local_record_scan(
    context_value,
    CheckedLocalScan {
      index: left_brace + 1,
      limit: right_brace,
      brace_depth: 0,
      paren_depth: 0,
      total: total,
      function_name_hash: function_name_hash,
    }
  )
}

fn fact_record_scan_next_total(
  kind: FactRecordScanKind,
  context_value: FactContext,
  current: combinator.ParseState,
  total: i32,
  result: combinator.Reply(parser.DeclFrame)
) -> i32 {
  match kind {
    FactRecordScanKind::ScanCheckedDeclaration => textmodel.signature_mix(
      total,
      checked_decl_fact_signature(
        checked_decl_fact(context_value.source, current, result)
      )
    ),
    FactRecordScanKind::ScanCheckedExpression => textmodel.signature_mix(
      total,
      checked_expr_fact_signature(
        checked_expr_fact(context_value.source, current, result)
      )
    ),
    FactRecordScanKind::ScanCheckedExpressionChild =>
      parser.text_declaration_root_child_record_signature(
        context_value.source,
        current.cursor,
        result.value.decl,
        total
      ),
    FactRecordScanKind::ScanCheckedExpressionShape => textmodel.signature_mix(
      total,
      checked_expr_shape_fact_signature(
        checked_expr_shape_fact(context_value.source, current, result)
      )
    ),
    FactRecordScanKind::ScanCheckedLocal => match is_function(
      context_value.source,
      current,
      result
    ) {
      true => checked_local_function_signature(
        context_value,
        current,
        total,
        result
      ),
      false => total,
    },
    FactRecordScanKind::ScanLoweredExport => match is_pub_function(
      context_value.source,
      current,
      result
    ) {
      true => textmodel.signature_mix(
        total,
        lowered_export_fact_signature(
          lowered_export_fact(context_value.source, current, result)
        )
      ),
      false => total,
    },
  }
}

fn FactContext::fact_record_scan(
  context_value: FactContext,
  kind: FactRecordScanKind,
  current: combinator.ParseState,
  total: i32
) -> i32 {
  match current.cursor < textlex.length(context_value.source) {
    false => total,
    true => match parser.parse_text_declaration_stream(
      current,
      context_value.source,
      total
    ) {
      Err(_) => total,
      Ok(result) => rec(
        context_value,
        kind,
        parser.next_text_declaration_state(result.state, context_value.source),
        fact_record_scan_next_total(kind, context_value, current, total, result)
      ),
    },
  }
}

fn FactContext::checked_declaration_record_scan(
  context_value: FactContext,
  env: parser.TextResolutionEnv,
  current: combinator.ParseState,
  total: i32
) -> i32 {
  match current.cursor < textlex.length(context_value.source) {
    false => total,
    true => match parser.parse_text_declaration_stream(
      current,
      context_value.source,
      total
    ) {
      Err(_) => total,
      Ok(result) => rec(
        context_value,
        env,
        parser.next_text_declaration_state(result.state, context_value.source),
        textmodel.signature_mix(
          total,
          checked_decl_fact_signature(
            checked_decl_fact_with_env(
              context_value.source,
              current,
              result,
              env
            )
          )
        )
      ),
    },
  }
}

fn FactContext::checked_expression_record_scan(
  context_value: FactContext,
  env: parser.TextResolutionEnv,
  current: combinator.ParseState,
  total: i32
) -> i32 {
  match current.cursor < textlex.length(context_value.source) {
    false => total,
    true => match parser.parse_text_declaration_stream(
      current,
      context_value.source,
      total
    ) {
      Err(_) => total,
      Ok(result) => rec(
        context_value,
        env,
        parser.next_text_declaration_state(result.state, context_value.source),
        textmodel.signature_mix(
          total,
          checked_expr_fact_signature(
            checked_expr_fact_with_env(
              context_value.source,
              current,
              result,
              env
            )
          )
        )
      ),
    },
  }
}

fn FactContext::checked_expression_shape_scan(
  context_value: FactContext,
  env: parser.TextResolutionEnv,
  current: combinator.ParseState,
  total: i32
) -> i32 {
  match current.cursor < textlex.length(context_value.source) {
    false => total,
    true => match parser.parse_text_declaration_stream(
      current,
      context_value.source,
      total
    ) {
      Err(_) => total,
      Ok(result) => rec(
        context_value,
        env,
        parser.next_text_declaration_state(result.state, context_value.source),
        textmodel.signature_mix(
          total,
          checked_expr_shape_fact_signature(
            checked_expr_shape_fact_with_env(
              context_value.source,
              current,
              result,
              env
            )
          )
        )
      ),
    },
  }
}

fn WasmByteContext::wasm_function_record_scan(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  total: i32
) -> i32 {
  match current.cursor < textlex.length(context_value.source) {
    false => total,
    true => match parser.parse_text_declaration_stream(
      current,
      context_value.source,
      total
    ) {
      Err(_) => total,
      Ok(result) => rec(
        context_value,
        codes,
        parser.next_text_declaration_state(result.state, context_value.source),
        match is_function(
          context_value.source,
          current,
          result
        ) {
          true => textmodel.signature_mix(
            total,
            wasm_function_fact_signature(
              wasm_byte_function_fact(context_value, codes, current, result)
            )
          ),
          false => total,
        }
      ),
    },
  }
}

fn WasmByteContext::wasm_function_record_scan_with_env(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  total: i32,
  env: parser.TextResolutionEnv
) -> i32 {
  match current.cursor < textlex.length(context_value.source) {
    false => total,
    true => match parser.parse_text_declaration_stream(
      current,
      context_value.source,
      total
    ) {
      Err(_) => total,
      Ok(result) => rec(
        context_value,
        codes,
        parser.next_text_declaration_state(result.state, context_value.source),
        match is_function(
          context_value.source,
          current,
          result
        ) {
          true => textmodel.signature_mix(
            total,
            wasm_function_fact_signature(
              wasm_byte_function_fact_with_env(
                context_value,
                codes,
                current,
                result,
                env
              )
            )
          ),
          false => total,
        },
        env
      ),
    },
  }
}

fn WasmSourceEnv::wasm_function_record_signature_loop(
  env: WasmSourceEnv,
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  index: i32,
  total: i32
) -> i32 {
  match index < layout.HeapArray::len(WasmFunctionBinding, env.functions) {
    false => total,
    true => layout.HeapArray::get(
      WasmFunctionBinding,
      env.functions,
      index
    ) \binding -> rec(
      env,
      context_value,
      codes,
      index + 1,
      textmodel.signature_mix(
        total,
        wasm_function_fact_signature(
          wasm_byte_function_fact_from_binding(
            context_value,
            codes,
            wasm_function_binding_with_details(context_value, binding)
          )
        )
      )
    ),
  }
}

fn WasmByteContext::wasm_function_record_signature_from_env(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32)
) -> i32 {
  WasmSourceEnv::wasm_function_record_signature_loop(
    context_value.env,
    context_value,
    codes,
    0,
    0
  )
}

fn WasmByteContext::wasm_section_record_scan(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  scan: WasmSectionScan
) -> WasmSectionScan {
  match current.cursor < textlex.length(context_value.source) {
    false => scan,
    true => match parser.parse_text_declaration_stream(
      current,
      context_value.source,
      scan.function_count
    ) {
      Err(_) => scan,
      Ok(result) => rec(
        context_value,
        codes,
        parser.next_text_declaration_state(result.state, context_value.source),
        match is_function(context_value.source, current, result) {
          true => wasm_section_scan_function(
            context_value,
            codes,
            current,
            result,
            scan
          ),
          false => scan,
        }
      ),
    },
  }
}

fn FactContext::checked_declaration_type_signature(
  context_value: FactContext
) -> i32 {
  monad.Reader::run(
    checked_declaration_type_signature_reader(),
    context_value
  )
}

fn FactContext::checked_diagnostic_signature(context_value: FactContext) -> i32 {
  monad.Reader::run(
    checked_diagnostic_signature_reader(),
    context_value
  )
}

fn FactContext::lowered_declaration_signature(
  context_value: FactContext
) -> i32 {
  monad.Reader::run(
    lowered_declaration_signature_reader(),
    context_value
  )
}

fn FactContext::fact_record_signature(
  context_value: FactContext,
  kind: FactRecordScanKind
) -> i32 {
  monad.Reader::run(
    fact_record_signature_reader(kind),
    context_value
  )
}

fn FactContext::checked_declaration_record_signature(
  context_value: FactContext
) -> i32 {
  FactContext::checked_declaration_record_scan(
    context_value,
    parser.TextResolutionEnv::from_source(context_value.source),
    textmodel.full_window_state(context_value.source),
    0
  )
}

