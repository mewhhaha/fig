  64
}

fn wasm_i32_val_type() -> i32 {
  127
}

fn wasm_externref_val_type() -> i32 {
  111
}

fn wasm_const_opcode() -> i32 {
  65
}

fn wasm_local_get_opcode() -> i32 {
  32
}

fn wasm_local_set_opcode() -> i32 {
  33
}

fn wasm_call_opcode() -> i32 {
  16
}

fn wasm_if_opcode() -> i32 {
  4
}

fn wasm_else_opcode() -> i32 {
  5
}

fn wasm_end_opcode() -> i32 {
  11
}

fn wasm_i32_eq_opcode() -> i32 {
  70
}

fn wasm_i32_ne_opcode() -> i32 {
  71
}

fn wasm_i32_lt_s_opcode() -> i32 {
  72
}

fn wasm_i32_gt_s_opcode() -> i32 {
  74
}

fn wasm_i32_le_s_opcode() -> i32 {
  76
}

fn wasm_i32_ge_s_opcode() -> i32 {
  78
}

fn wasm_i32_add_opcode() -> i32 {
  106
}

fn wasm_i32_sub_opcode() -> i32 {
  107
}

fn wasm_i32_mul_opcode() -> i32 {
  108
}

fn wasm_i32_div_s_opcode() -> i32 {
  109
}

fn wasm_i32_rem_s_opcode() -> i32 {
  111
}

fn wasm_return_opcode() -> i32 {
  15
}

fn wasm_drop_opcode() -> i32 {
  26
}

fn wasm_type_section_id() -> i32 {
  1
}

fn wasm_function_section_id() -> i32 {
  3
}

fn wasm_export_section_id() -> i32 {
  7
}

fn wasm_code_section_id() -> i32 {
  10
}

fn wasm_module_header_size() -> i32 {
  8
}

fn wasm_emitted_section_count() -> i32 {
  4
}

fn wasm_u32_leb_byte(value: i32) -> i32 {
  let payload = value % 128;
  let remaining = value / 128;
  match remaining > 0 {
    true => payload + 128,
    false => payload,
  }
}

fn wasm_byte_value(value: i32) -> i32 {
  let reduced = value % 256;
  match reduced < 0 {
    true => reduced + 256,
    false => reduced,
  }
}

fn wasm_byte_buffer_empty(capacity: i32) -> layout.HeapArray(i32) {
  layout.HeapArray::new(i32, capacity)
}

fn wasm_push_byte(
  bytes: layout.HeapArray(i32),
  value: i32
) -> layout.HeapArray(i32) {
  layout.HeapArray::push(i32, bytes, wasm_byte_value(value))
}

fn wasm_push_u32_leb(
  bytes: layout.HeapArray(i32),
  value: i32
) -> layout.HeapArray(i32) {
  let byte_value = wasm_u32_leb_byte(value);
  let remaining = value / 128;
  let next = wasm_push_byte(bytes, byte_value);
  match remaining > 0 {
    true => rec(next, remaining),
    false => next,
  }
}

fn wasm_push_repeated_byte(
  bytes: layout.HeapArray(i32),
  count: i32,
  value: i32
) -> layout.HeapArray(i32) {
  match count > 0 {
    true => rec(
      wasm_push_byte(bytes, value),
      count - 1,
      value
    ),
    false => bytes,
  }
}

fn wasm_push_nonempty_local_decls(
  bytes: layout.HeapArray(i32),
  local_count: i32
) -> layout.HeapArray(i32) {
  let with_group_count = wasm_push_u32_leb(bytes, 1);
  let with_local_count = wasm_push_u32_leb(with_group_count, local_count);
  wasm_push_byte(with_local_count, wasm_i32_val_type())
}

fn wasm_push_local_decls(
  bytes: layout.HeapArray(i32),
  local_count: i32
) -> layout.HeapArray(i32) {
  match local_count <= 0 {
    true => wasm_push_u32_leb(bytes, 0),
    false => wasm_push_nonempty_local_decls(bytes, local_count),
  }
}

fn wasm_source_code_at(
  codes: layout.HeapArray(i32),
  base_offset: i32,
  offset: i32
) -> i32 {
  let index = offset - base_offset;
  let in_bounds = match index >= 0 {
    true => index < layout.HeapArray::len(i32, codes),
    false => false,
  };
  match in_bounds {
    true => layout.HeapArray::get(i32, codes, index),
    false => 0,
  }
}

fn wasm_small_immediate_limit() -> i32 {
  128
}

fn wasm_source_digit_value(code: i32) -> core.Option(i32) {
  match code {
    _ if code >= textlex.TextCharCode::Digit0 && code <= textlex.TextCharCode::Digit9 =>
      option.some(code - textlex.TextCharCode::Digit0),
    _ => option.none(),
  }
}

fn wasm_next_small_u7_decimal_total(
  total: i32,
  digit: i32
) -> core.Option(i32) {
  let next_total = total * 10 + digit;
  match next_total < wasm_small_immediate_limit() {
    true => option.some(next_total),
    false => option.none(),
  }
}

fn wasm_small_u7_decimal_scan(
  codes: layout.HeapArray(i32),
  base_offset: i32,
  offset: i32,
  limit: i32,
  total: i32
) -> core.Option(i32) {
  match offset >= limit {
    true => option.some(total),
    false => match wasm_source_digit_value(
      wasm_source_code_at(codes, base_offset, offset)
    ) {
      Some(digit) => match wasm_next_small_u7_decimal_total(total, digit) {
        Some(next_total) => rec(codes, base_offset, offset + 1, limit, next_total),
        None => option.none(),
      },
      None => option.none(),
    },
  }
}

fn wasm_small_u7_decimal_literal(
  codes: layout.HeapArray(i32),
  base_offset: i32,
  token_span: span.Span
) -> core.Option(i32) {
  match span.width(token_span) > 0 {
    true => wasm_small_u7_decimal_scan(
      codes,
      base_offset,
      token_span.start,
      token_span.end,
      0
    ),
    false => option.none(),
  }
}

fn wasm_bool_literal_immediate(
  codes: layout.HeapArray(i32),
  base_offset: i32,
  token_span: span.Span
) -> core.Option(i32) {
  let first_code = wasm_source_code_at(codes, base_offset, token_span.start);
  match first_code {
    textlex.TextCharCode::LowerT => option.some(1),
    textlex.TextCharCode::LowerF => option.some(0),
    _ => option.none(),
  }
}

fn wasm_scalar_body_immediate_from_root(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  decl: ast.Decl
) -> core.Option(i32) {
  let raw_start = parser.text_function_body_value_start_index(
    context_value.source,
    current.cursor
  );
  let limit = parser.text_declaration_end_from_index(
    context_value.source,
    current.cursor
  );
  let start = parser.text_expression_start_skip_trivia(
    context_value.source,
    raw_start,
    limit
  );
  let token_span = textlex.token_at(context_value.source, start).span;
  let root_kind = parser.text_declaration_root_head_kind_tag(
    context_value.source,
    current.cursor,
    decl
  );
  let is_standalone = parser.text_scalar_literal_is_standalone(
    context_value.source,
    start,
    limit
  );
  match is_standalone {
    false => option.none(),
    true => match root_kind == parser.text_expression_root_number_tag() {
      true => wasm_small_u7_decimal_literal(
        codes,
        context_value.base_offset,
        token_span
      ),
      false => match root_kind == parser.text_expression_root_bool_tag() {
        true => wasm_bool_literal_immediate(
          codes,
          context_value.base_offset,
          token_span
        ),
        false => option.none(),
      },
    },
  }
}

fn wasm_push_source_bytes(
  codes: layout.HeapArray(i32),
  base_offset: i32,
  offset: i32,
  limit: i32,
  bytes: layout.HeapArray(i32)
) -> layout.HeapArray(i32) {
  match offset < limit {
    true => rec(
      codes,
      base_offset,
      offset + 1,
      limit,
      wasm_push_byte(bytes, wasm_source_code_at(codes, base_offset, offset))
    ),
    false => bytes,
  }
}

fn wasm_u32_leb_size_scan(value: i32, size: i32) -> i32 {
  let remaining = value / 128;
  match remaining > 0 {
    true => rec(remaining, size + 1),
    false => size,
  }
}

fn wasm_u32_leb_size(value: i32) -> i32 {
  wasm_u32_leb_size_scan(value, 1)
}

fn wasm_u32_leb_signature_scan(value: i32, total: i32) -> i32 {
  let byte_value = wasm_u32_leb_byte(value);
  let next_total = textmodel.signature_mix(total, byte_value);
  let remaining = value / 128;
  match remaining > 0 {
    true => rec(remaining, next_total),
    false => next_total,
  }
}

fn wasm_u32_leb_signature(value: i32) -> i32 {
  wasm_u32_leb_signature_scan(value, 0)
}

fn wasm_fixed_byte4_signature(
  seed: i32,
  first: i32,
  second: i32,
  third: i32,
  fourth: i32
) -> i32 {
  let with_first = textmodel.signature_mix(seed, first);
  let with_second = textmodel.signature_mix(with_first, second);
  let with_third = textmodel.signature_mix(with_second, third);
  textmodel.signature_mix(with_third, fourth)
}

fn wasm_magic_signature() -> i32 {
  wasm_fixed_byte4_signature(101, 0, 97, 115, 109)
}

fn wasm_version_signature() -> i32 {
  wasm_fixed_byte4_signature(103, 1, 0, 0, 0)
}

fn wasm_section_header_signature(section_id: i32, payload_size: i32) -> i32 {
  let with_id = textmodel.signature_mix(107, section_id);
  textmodel.signature_mix(with_id, wasm_u32_leb_signature(payload_size))
}

fn wasm_section_total_size(payload_size: i32) -> i32 {
  1 + wasm_u32_leb_size(payload_size) + payload_size
}

fn wasm_val_type_for_abi(abi_class: i32) -> i32 {
  match abi_class_is_handle(abi_class) {
    true => wasm_externref_val_type(),
    false => match abi_class_is_scalar_or_function(abi_class) {
      true => wasm_i32_val_type(),
      false => wasm_no_val_type(),
    },
  }
}

fn wasm_body_opcode_for_abi(abi_class: i32) -> i32 {
  match abi_class_is_scalar(abi_class) {
    true => wasm_const_opcode(),
    false => match abi_class_is_handle(abi_class) {
      true => wasm_const_opcode(),
      false => match abi_class_is_function(abi_class) {
        true => wasm_call_opcode(),
        false => wasm_drop_opcode(),
      },
    },
  }
}

fn wasm_body_immediate(
  source: textlex.TextTokenStream,
  current: combinator.ParseState,
  decl: ast.Decl,
  body_abi: i32
) -> i32 {
  match body_abi == parser.text_abi_class_void_tag() {
    true => 0,
    false => parser.text_declaration_root_head_hash(
      source,
      current.cursor,
      decl
    ),
  }
}

fn wasm_body_instruction(opcode: i32, immediate: i32) -> WasmBodyInstruction {
  WasmBodyInstruction {opcode: opcode, immediate: immediate}
}

fn wasm_body_summary_empty() -> WasmBodySummary {
  WasmBodySummary {
    first_opcode: wasm_drop_opcode(),
    first_immediate: 0,
    byte_size: 0,
  }
}

fn wasm_body_summary_push_instruction(
  summary: WasmBodySummary,
  instruction: WasmBodyInstruction
) -> WasmBodySummary {
  let is_first = summary.byte_size == 0;
  WasmBodySummary {
    first_opcode: match is_first {
      true => instruction.opcode,
      false => summary.first_opcode,
    },
    first_immediate: match is_first {
      true => instruction.immediate,
      false => summary.first_immediate,
    },
    byte_size: summary.byte_size + wasm_instruction_size(instruction.opcode),
  }
}

fn wasm_body_summary_append(
  target: WasmBodySummary,
  source: WasmBodySummary
) -> WasmBodySummary {
  match source.byte_size == 0 {
    true => target,
    false => match target.byte_size == 0 {
      true => source,
      false => WasmBodySummary {
        first_opcode: target.first_opcode,
        first_immediate: target.first_immediate,
        byte_size: target.byte_size + source.byte_size,
      },
    },
  }
}

fn wasm_instruction_summary(
  instruction: WasmBodyInstruction
) -> WasmBodySummary {
  wasm_body_summary_push_instruction(
    wasm_body_summary_empty(),
    instruction
  )
}

fn wasm_const_instruction_summary(value: i32) -> WasmBodySummary {
  wasm_instruction_summary(
    wasm_body_instruction(
      wasm_const_opcode(),
      value
    )
  )
}

fn wasm_local_get_instruction_summary(index: i32) -> WasmBodySummary {
  wasm_instruction_summary(
    wasm_body_instruction(
      wasm_local_get_opcode(),
      index
    )
  )
}

fn wasm_single_instruction_body_plan(
  instruction: WasmBodyInstruction
) -> WasmBodyPlan {
  wasm_body_plan_push_instruction(
    wasm_body_plan_empty(1),
    instruction
  )
}

fn wasm_body_plan_empty(capacity: i32) -> WasmBodyPlan {
  WasmBodyPlan {
    first_opcode: wasm_drop_opcode(),
    first_immediate: 0,
    byte_size: 0,
    instructions: vec.Vec::new(WasmBodyInstruction, capacity),
  }
}

fn wasm_body_plan_push_instruction(
  plan: WasmBodyPlan,
  instruction: WasmBodyInstruction
) -> WasmBodyPlan {
  let is_first = vec.Vec::len(plan.instructions) == 0;
  WasmBodyPlan {
    first_opcode: match is_first {
      true => instruction.opcode,
      false => plan.first_opcode,
    },
    first_immediate: match is_first {
      true => instruction.immediate,
      false => plan.first_immediate,
    },
    byte_size: plan.byte_size + wasm_instruction_size(instruction.opcode),
    instructions: vec.Vec::push(
      plan.instructions,
      instruction
    ),
  }
}

fn wasm_body_plan_append_plan_at(
  target: WasmBodyPlan,
  source: WasmBodyPlan,
  index: i32
) -> WasmBodyPlan {
  match index < vec.Vec::len(source.instructions) {
    true => rec(
      wasm_body_plan_push_instruction(
        target,
        vec.Vec::get_t(WasmBodyInstruction, source.instructions, index)
      ),
      source,
      index + 1
    ),
    false => target,
  }
}

fn wasm_body_plan_append_plan(
  target: WasmBodyPlan,
  source: WasmBodyPlan
) -> WasmBodyPlan {
  wasm_body_plan_append_plan_at(target, source, 0)
}

fn wasm_scalar_runtime_param_body_instruction(
  source: textlex.TextTokenStream,
  current: combinator.ParseState
) -> core.Option(WasmBodyInstruction) {
  let param_count = parser.text_function_runtime_param_count(
    source,
    current.cursor
  );
  let param_index = parser.text_function_body_runtime_param_index(
    source,
    current.cursor
  );
  match param_index < param_count {
    true => option.some(wasm_body_instruction(
      wasm_local_get_opcode(),
      param_index
    )),
    false => option.none(),
  }
}

fn wasm_scalar_local_let_body_instruction(
  source: textlex.TextTokenStream,
  current: combinator.ParseState
) -> core.Option(WasmBodyInstruction) {
  let param_count = parser.text_function_runtime_param_count(
    source,
    current.cursor
  );
  let local_count = parser.text_function_local_let_count(
    source,
    current.cursor
  );
  let local_index = parser.text_function_body_local_let_index(
    source,
    current.cursor
  );
  let wasm_index = param_count + local_index;
  match local_index < local_count {
    true => match wasm_index < wasm_small_immediate_limit() {
      true => option.some(wasm_body_instruction(
        wasm_local_get_opcode(),
        wasm_index
      )),
      false => option.none(),
    },
    false => option.none(),
  }
}

fn wasm_scalar_identifier_body_instruction(
  source: textlex.TextTokenStream,
  current: combinator.ParseState
) -> core.Option(WasmBodyInstruction) {
  match wasm_scalar_runtime_param_body_instruction(source, current) {
    Some(value) => option.some(value),
    None => wasm_scalar_local_let_body_instruction(source, current),
  }
}

fn wasm_scalar_identifier_body_instruction_from_binding(
  context_value: WasmByteContext,
  binding: WasmFunctionBinding
) -> core.Option(WasmBodyInstruction) {
  let source = context_value.source;
  let target_hash = parser.text_expression_root_identifier_hash_between(
    source,
    binding.body_start,
    binding.declaration_limit
  );
  let param_index = parser.text_function_runtime_param_index_for_name_hash(
    source,
    binding.cursor,
    target_hash
  );
  match param_index < binding.runtime_param_count {
    true => match param_index < wasm_small_immediate_limit() {
      true => option.some(wasm_body_instruction(
        wasm_local_get_opcode(),
        param_index
      )),
      false => option.none(),
    },
    false => parser.text_function_local_let_index_for_name_hash(
      source,
      binding.cursor,
      target_hash
    ) \local_index -> match local_index < binding.local_count {
      false => option.none(),
      true => binding.runtime_param_count + local_index \wasm_index ->
        match wasm_index < wasm_small_immediate_limit() {
          true => option.some(wasm_body_instruction(
            wasm_local_get_opcode(),
            wasm_index
          )),
          false => option.none(),
        },
    },
  }
}

fn wasm_type_class_is_scalar(type_class: i32) -> bool {
  match type_class == parser.text_type_class_i32_tag() {
    true => true,
    false => type_class == parser.text_type_class_bool_tag(),
  }
}

fn wasm_call_lowering(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState
) -> WasmCallLowering {
  WasmCallLowering {
    context_value: context_value,
    codes: codes,
    current: current,
    runtime_param_count: parser.text_function_runtime_param_count(
      context_value.source,
      current.cursor
    ),
    local_count: parser.text_function_local_let_count(
      context_value.source,
      current.cursor
    ),
  }
}

fn wasm_call_lowering_for_binding(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  binding: WasmFunctionBinding
) -> WasmCallLowering {
  WasmCallLowering {
    context_value: context_value,
    codes: codes,
    current: combinator.state(binding.cursor, textlex.length(context_value.source)),
    runtime_param_count: binding.runtime_param_count,
    local_count: binding.local_count,
  }
}

fn WasmCallLowering::segment_arg_segment(
  lowering: WasmCallLowering,
  start: i32,
  limit: i32,
  arg_index: i32
) -> parser.TextArgumentSegment {
  parser.text_expression_root_call_arg_segment_between(
    lowering.context_value.source,
    start,
    limit,
    arg_index
  )
}

fn wasm_instruction_plan(
  instruction: WasmBodyInstruction
) -> WasmBodyPlan {
  wasm_single_instruction_body_plan(instruction)
}

fn wasm_const_instruction_plan(value: i32) -> WasmBodyPlan {
  wasm_instruction_plan(
    wasm_body_instruction(
      wasm_const_opcode(),
      value
    )
  )
}

fn wasm_local_get_instruction_plan(index: i32) -> WasmBodyPlan {
  wasm_instruction_plan(
    wasm_body_instruction(
      wasm_local_get_opcode(),
      index
    )
  )
}

fn wasm_small_scalar_local_get_plan(
  index: i32,
  type_class: i32
) -> core.Option(WasmBodyPlan) {
  do @monad(core.Option(_)) {
    option.guard(wasm_type_class_is_scalar(type_class));
    option.guard(index < wasm_small_immediate_limit());
    pure(wasm_local_get_instruction_plan(index))
  }
}

fn WasmCallLowering::number_segment_plan(
  lowering: WasmCallLowering,
  start: i32
) -> core.Option(WasmBodyPlan) {
  let token_span = textlex.token_at(
    lowering.context_value.source,
    start
  ).span;
  core.Option::map(
    wasm_const_instruction_plan,
    wasm_small_u7_decimal_literal(
      lowering.codes,
      lowering.context_value.base_offset,
      token_span
    )
  )
}

fn WasmCallLowering::bool_segment_plan(
  lowering: WasmCallLowering,
  start: i32
) -> core.Option(WasmBodyPlan) {
  let token_span = textlex.token_at(
    lowering.context_value.source,
    start
  ).span;
  core.Option::map(
    wasm_const_instruction_plan,
    wasm_bool_literal_immediate(
      lowering.codes,
      lowering.context_value.base_offset,
      token_span
    )
  )
}

fn WasmCallLowering::identifier_segment_plan(
  lowering: WasmCallLowering,
  start: i32,
  limit: i32
) -> core.Option(WasmBodyPlan) {
  let target_hash = parser.text_expression_root_identifier_hash_between(
    lowering.context_value.source,
    start,
    limit
  );
  let param_index = parser.text_function_runtime_param_index_for_name_hash(
    lowering.context_value.source,
    lowering.current.cursor,
    target_hash
  );
  let param_type = parser.text_function_param_resolved_type_class_for_name_hash(
    lowering.context_value.source,
    lowering.current.cursor,
    target_hash
  );
  let is_param = param_index < lowering.runtime_param_count;
  match target_hash == 0 {
    true => option.none(),
    false => match is_param {
      false => WasmCallLowering::local_segment_plan(
        lowering,
        target_hash
      ),
      true => wasm_small_scalar_local_get_plan(param_index, param_type),
    },
  }
}

fn WasmCallLowering::local_segment_plan(
  lowering: WasmCallLowering,
  target_hash: i32
) -> core.Option(WasmBodyPlan) {
  let local_index = parser.text_function_local_let_index_for_name_hash(
    lowering.context_value.source,
    lowering.current.cursor,
    target_hash
  );
  let local_type = parser.TextResolutionEnv::function_local_let_resolved_type_class_for_name_hash(
    lowering.context_value.env.resolution,
    lowering.context_value.source,
    lowering.current.cursor,
    target_hash
  );
  let wasm_index = lowering.runtime_param_count + local_index;
  let is_local = local_index < lowering.local_count;
  do @monad(core.Option(_)) {
    option.guard(is_local);
    wasm_small_scalar_local_get_plan(wasm_index, local_type)
  }
}

fn WasmCallLowering::operator_segment_plan(
  lowering: WasmCallLowering,
  parts: parser.TextRootOperatorParts
) -> core.Option(WasmBodyPlan) {
  match wasm_scalar_operator_opcode(parts.operator_hash) {
    None => option.none(),
    Some(opcode) => wasm_scalar_operator_body_plan_from_parts(
      lowering,
      parts,
      opcode
    ),
  }
}

fn WasmCallLowering::simple_segment_plan(
  lowering: WasmCallLowering,
  start: i32,
  limit: i32
) -> core.Option(WasmBodyPlan) {
  let root_kind = parser.text_expression_root_head_kind_tag_between(
    lowering.context_value.source,
    start,
    limit
  );
  let root_type = parser.text_expression_root_type_class_tag_between(
    lowering.context_value.source,
    start,
    limit
  );
  match root_kind == parser.text_expression_root_number_tag() {
    true => match root_type == parser.text_type_class_i32_tag() {
      true => WasmCallLowering::number_segment_plan(lowering, start),
      false => option.none(),
    },
    false => match root_kind == parser.text_expression_root_bool_tag() {
      true => match root_type == parser.text_type_class_bool_tag() {
        true => WasmCallLowering::bool_segment_plan(lowering, start),
        false => option.none(),
      },
      false => match root_kind == parser.text_expression_root_identifier_tag() {
        true => WasmCallLowering::identifier_segment_plan(
          lowering,
          start,
          limit
        ),
        false => option.none(),
      },
    },
  }
}

fn WasmCallLowering::segment_has_bare_call(
  lowering: WasmCallLowering,
  start: i32,
  limit: i32
) -> bool {
  let root_kind = parser.text_expression_root_head_kind_tag_between(
    lowering.context_value.source,
    start,
    limit
  );
  let call_arg_count = parser.text_expression_root_call_arg_count_between(
    lowering.context_value.source,
    start,
    limit
  );
  let selector_count = parser.text_expression_root_head_selector_count_between(
    lowering.context_value.source,
    start,
    limit
  );
  let field_count = parser.text_expression_root_field_count_between(
    lowering.context_value.source,
    start,
    limit
  );
  let operator_count = parser.text_expression_root_operator_count_between(
    lowering.context_value.source,
    start,
    limit
  );
  let pipe_bind_count = parser.text_value_pipe_bind_count_between(
    lowering.context_value.source,
    start,
    limit,
    0
  );
  let has_identifier_root = root_kind == parser.text_expression_root_identifier_tag();
  let has_runtime_call = call_arg_count != parser.text_no_root_call_arg_count();
  let has_no_selector = selector_count == 0;
  let has_no_field = field_count == 0;
  let has_no_operator = operator_count == 0;
  let has_no_pipe_bind = pipe_bind_count == 0;
  has_identifier_root
    && has_runtime_call
    && has_no_selector
    && has_no_field
    && has_no_operator
    && has_no_pipe_bind
}

fn WasmCallLowering::append_segment_arg(
  lowering: WasmCallLowering,
  plan: WasmBodyPlan,
  start: i32,
  limit: i32,
  arg_index: i32
) -> core.Option(WasmBodyPlan) {
  let segment = WasmCallLowering::segment_arg_segment(
    lowering,
    start,
    limit,
    arg_index
  );
  match WasmCallLowering::arg_plan(lowering, segment) {
    Some(arg_plan) => option.some(wasm_body_plan_append_plan(plan, arg_plan)),
    None => option.none(),
  }
}

fn WasmCallLowering::append_segment_args(
  lowering: WasmCallLowering,
  plan: WasmBodyPlan,
  start: i32,
  limit: i32,
  arg_index: i32,
  arg_count: i32
) -> core.Option(WasmBodyPlan) {
  match arg_index >= arg_count {
    true => option.some(plan),
    false => do @monad(core.Option(_)) {
      next_plan <- WasmCallLowering::append_segment_arg(
        lowering,
        plan,
        start,
        limit,
        arg_index
      );
      WasmCallLowering::append_segment_args(
        lowering,
        next_plan,
        start,
        limit,
        arg_index + 1,
        arg_count
      )
    },
  }
}

fn WasmCallLowering::call_segment_plan(
  lowering: WasmCallLowering,
  start: i32,
  limit: i32
) -> core.Option(WasmBodyPlan) {
  let encoded_arg_count = parser.text_expression_root_call_arg_count_between(
    lowering.context_value.source,
    start,
    limit
  );
  let arg_count = wasm_root_call_runtime_arg_count(encoded_arg_count);
  let target_hash = parser.text_expression_root_head_hash_between(
    lowering.context_value.source,
    start,
    limit
  );
  let lookup = WasmSourceEnv::lookup_function(
    lowering.context_value.env,
    target_hash
  );
  let return_type = parser.TextResolutionEnv::lookup_return(
    lowering.context_value.env.resolution,
    target_hash
  );
  do @monad(core.Option(_)) {
    option.guard(WasmCallLowering::segment_has_bare_call(lowering, start, limit));
    option.guard(lookup.found);
    option.guard(lookup.index < wasm_small_immediate_limit());
    option.guard(lookup.runtime_param_count == arg_count);
    option.guard(wasm_type_class_is_scalar(return_type));
    option.guard(arg_count <= 5);
    args_plan <- WasmCallLowering::append_segment_args(
      lowering,
      wasm_body_plan_empty(arg_count + 1),
      start,
      limit,
      0,
      arg_count
    );
    pure(wasm_body_plan_push_instruction(
      args_plan,
      wasm_body_instruction(wasm_call_opcode(), lookup.index)
    ))
  }
}

fn wasm_match_first_pattern_is_bool_literal(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> bool {
  let open_index = parser.text_root_match_body_open_between(
    source,
    start,
    limit
  );
  match open_index >= limit {
    true => false,
    false => parser.text_expression_start_skip_trivia(
      source,
      open_index + 1,
      limit
    ) \pattern_start -> match pattern_start >= limit {
      true => false,
      false => match textlex.token_at(source, pattern_start).kind {
        BoolLiteral => true,
        _ => false,
      },
    },
  }
}

fn wasm_segment_can_be_bool_branch(
  source: textlex.TextTokenStream,
  start: i32,
  limit: i32
) -> bool {
  let value_start = parser.text_expression_start_skip_trivia(
    source,
    start,
    limit
  );
  match value_start >= limit {
    true => false,
    false => match textlex.token_at(source, value_start).kind {
      IfKw => true,
      MatchKw => wasm_match_first_pattern_is_bool_literal(
        source,
        value_start,
        limit
      ),
      _ => false,
    },
  }
}

fn WasmCallLowering::branch_type_from_segments(
  lowering: WasmCallLowering,
  segments: parser.TextBoolBranchSegments
) -> i32 {
  parser.text_scalar_branch_type_class_from_parts(
    parser.TextResolutionEnv::function_body_scalar_operator_operand_type_class(
      lowering.context_value.env.resolution,
      lowering.context_value.source,
      lowering.current.cursor,
      segments.condition_start,
      segments.condition_limit
    ),
    parser.TextResolutionEnv::function_body_scalar_operator_operand_type_class(
      lowering.context_value.env.resolution,
      lowering.context_value.source,
      lowering.current.cursor,
      segments.true_value_start,
      segments.true_value_limit
    ),
    parser.TextResolutionEnv::function_body_scalar_operator_operand_type_class(
      lowering.context_value.env.resolution,
      lowering.context_value.source,
      lowering.current.cursor,
      segments.false_value_start,
      segments.false_value_limit
    )
  )
}

fn WasmCallLowering::branch_segment_plan(
  lowering: WasmCallLowering,
  start: i32,
  limit: i32
) -> core.Option(WasmBodyPlan) {
  let segments = parser.text_bool_branch_segments_between(
    lowering.context_value.source,
    start,
    limit
  );
  do @monad(core.Option(_)) {
    option.guard(segments.found);
    let branch_type = WasmCallLowering::branch_type_from_segments(
      lowering,
      segments
    );
    option.guard(wasm_type_class_is_scalar(branch_type));
    condition_plan <- WasmCallLowering::segment_plan(
      lowering,
      segments.condition_start,
      segments.condition_limit,
      true
    );
    true_plan <- WasmCallLowering::segment_plan(
      lowering,
      segments.true_value_start,
      segments.true_value_limit,
      true
    );
    false_plan <- WasmCallLowering::segment_plan(
      lowering,
      segments.false_value_start,
      segments.false_value_limit,
      true
    );
    pure(wasm_body_plan_append_plan(
      wasm_body_plan_empty(6),
      condition_plan
    ) \with_condition -> wasm_body_plan_push_instruction(
      with_condition,
      wasm_body_instruction(wasm_if_opcode(), wasm_i32_val_type())
    ) \with_if -> wasm_body_plan_append_plan(
      with_if,
      true_plan
    ) \with_true -> wasm_body_plan_push_instruction(
      with_true,
      wasm_body_instruction(wasm_else_opcode(), 0)
    ) \with_else -> wasm_body_plan_append_plan(
      with_else,
      false_plan
    ) \with_false -> wasm_body_plan_push_instruction(
      with_false,
      wasm_body_instruction(wasm_end_opcode(), 0)
    ))
  }
}

fn WasmCallLowering::branch_segment_plan_if_possible(
  lowering: WasmCallLowering,
  start: i32,
  limit: i32
) -> core.Option(WasmBodyPlan) {
  match wasm_segment_can_be_bool_branch(
    lowering.context_value.source,
    start,
    limit
  ) {
    true => WasmCallLowering::branch_segment_plan(lowering, start, limit),
    false => option.none(),
  }
}

fn wasm_function_match_body_plan(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  body_abi: i32
) -> core.Option(WasmBodyPlan) {
  let source = context_value.source;
  let result_type = parser.text_function_match_body_result_type_class(
    source,
    current.cursor
  );
  let segments = parser.text_function_bool_match_body_segments(
    source,
    current.cursor
  );
  let lowering = wasm_call_lowering(context_value, codes, current);
  do @monad(core.Option(_)) {
    option.guard(abi_class_is_scalar(body_abi));
    option.guard(wasm_type_class_is_scalar(result_type));
    option.guard(segments.found);
    true_plan <- WasmCallLowering::segment_plan(
      lowering,
      segments.true_value_start,
      segments.true_value_limit,
      true
    );
    false_plan <- WasmCallLowering::segment_plan(
      lowering,
      segments.false_value_start,
      segments.false_value_limit,
      true
    );
    pure(wasm_body_plan_push_instruction(
      wasm_body_plan_empty(6),
      wasm_body_instruction(wasm_local_get_opcode(), 0)
    ) \with_condition -> wasm_body_plan_push_instruction(
      with_condition,
      wasm_body_instruction(wasm_if_opcode(), wasm_i32_val_type())
    ) \with_if -> wasm_body_plan_append_plan(
      with_if,
      true_plan
    ) \with_true -> wasm_body_plan_push_instruction(
      with_true,
      wasm_body_instruction(wasm_else_opcode(), 0)
    ) \with_else -> wasm_body_plan_append_plan(
      with_else,
      false_plan
    ) \with_false -> wasm_body_plan_push_instruction(
      with_false,
      wasm_body_instruction(wasm_end_opcode(), 0)
    ))
  }
}

fn WasmCallLowering::non_branch_segment_plan(
  lowering: WasmCallLowering,
  start: i32,
  limit: i32,
  parts: parser.TextRootOperatorParts
) -> core.Option(WasmBodyPlan) {
  match parts.found {
    true => WasmCallLowering::operator_segment_plan(lowering, parts),
    false => match WasmCallLowering::segment_has_bare_call(
      lowering,
      start,
      limit
    ) {
      true => WasmCallLowering::call_segment_plan(lowering, start, limit),
      false => WasmCallLowering::simple_segment_plan(
        lowering,
        start,
        limit
      ),
    },
  }
}

fn WasmCallLowering::segment_plan(
  lowering: WasmCallLowering,
  start: i32,
  limit: i32,
  found: bool
) -> core.Option(WasmBodyPlan) {
  let parts = parser.text_expression_root_single_operator_parts_between(
    lowering.context_value.source,
    start,
    limit
  );
  match found {
    false => option.none(),
    true => match WasmCallLowering::branch_segment_plan_if_possible(
      lowering,
      start,
      limit
    ) {
      Some(plan) => option.some(plan),
      None => WasmCallLowering::non_branch_segment_plan(
        lowering,
        start,
        limit,
        parts
      ),
    },
  }
}

fn wasm_scalar_expression_body_plan(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  body_abi: i32
) -> core.Option(WasmBodyPlan) {
  let source = context_value.source;
  let start = parser.text_function_body_value_start_index(source, current.cursor);
  let limit = parser.text_declaration_end_from_index(source, current.cursor);
  do @monad(core.Option(_)) {
    option.guard(abi_class_is_scalar(body_abi));
    WasmCallLowering::segment_plan(
      wasm_call_lowering(context_value, codes, current),
      start,
      limit,
      true
    )
  }
}

fn WasmCallLowering::arg_plan(
  lowering: WasmCallLowering,
  segment: parser.TextArgumentSegment
) -> core.Option(WasmBodyPlan) {
  WasmCallLowering::segment_plan(
    lowering,
    segment.start,
    segment.limit,
    segment.found
  )
}

fn wasm_small_scalar_local_get_summary(
  index: i32,
  type_class: i32
) -> core.Option(WasmBodySummary) {
  do @monad(core.Option(_)) {
    option.guard(wasm_type_class_is_scalar(type_class));
    option.guard(index < wasm_small_immediate_limit());
    pure(wasm_local_get_instruction_summary(index))
  }
}

fn WasmCallLowering::number_segment_summary(
  lowering: WasmCallLowering,
  start: i32
) -> core.Option(WasmBodySummary) {
  let token_span = textlex.token_at(
    lowering.context_value.source,
    start
  ).span;
  core.Option::map(
    wasm_const_instruction_summary,
    wasm_small_u7_decimal_literal(
      lowering.codes,
      lowering.context_value.base_offset,
      token_span
    )
  )
}

fn WasmCallLowering::bool_segment_summary(
  lowering: WasmCallLowering,
  start: i32
) -> core.Option(WasmBodySummary) {
  let token_span = textlex.token_at(
    lowering.context_value.source,
    start
  ).span;
  core.Option::map(
    wasm_const_instruction_summary,
    wasm_bool_literal_immediate(
      lowering.codes,
      lowering.context_value.base_offset,
      token_span
    )
  )
}

fn WasmCallLowering::local_segment_summary(
  lowering: WasmCallLowering,
  target_hash: i32
) -> core.Option(WasmBodySummary) {
  let local_index = parser.text_function_local_let_index_for_name_hash(
    lowering.context_value.source,
    lowering.current.cursor,
    target_hash
  );
  let local_type = parser.TextResolutionEnv::function_local_let_resolved_type_class_for_name_hash(
    lowering.context_value.env.resolution,
    lowering.context_value.source,
    lowering.current.cursor,
    target_hash
  );
  let wasm_index = lowering.runtime_param_count + local_index;
  let is_local = local_index < lowering.local_count;
  do @monad(core.Option(_)) {
    option.guard(is_local);
    wasm_small_scalar_local_get_summary(wasm_index, local_type)
  }
}

fn WasmCallLowering::identifier_segment_summary(
  lowering: WasmCallLowering,
  start: i32,
  limit: i32
) -> core.Option(WasmBodySummary) {
  let target_hash = parser.text_expression_root_identifier_hash_between(
    lowering.context_value.source,
    start,
    limit
  );
  let param_index = parser.text_function_runtime_param_index_for_name_hash(
    lowering.context_value.source,
    lowering.current.cursor,
    target_hash
  );
  let param_type = parser.text_function_param_resolved_type_class_for_name_hash(
    lowering.context_value.source,
    lowering.current.cursor,
    target_hash
  );
  let is_param = param_index < lowering.runtime_param_count;
  match target_hash == 0 {
    true => option.none(),
    false => match is_param {
      false => WasmCallLowering::local_segment_summary(lowering, target_hash),
      true => wasm_small_scalar_local_get_summary(param_index, param_type),
    },
  }
}

fn WasmCallLowering::simple_segment_summary(
  lowering: WasmCallLowering,
  start: i32,
  limit: i32
) -> core.Option(WasmBodySummary) {
  let root_kind = parser.text_expression_root_head_kind_tag_between(
    lowering.context_value.source,
    start,
    limit
  );
  let root_type = parser.text_expression_root_type_class_tag_between(
    lowering.context_value.source,
    start,
    limit
  );
  match root_kind == parser.text_expression_root_number_tag() {
    true => match root_type == parser.text_type_class_i32_tag() {
      true => WasmCallLowering::number_segment_summary(lowering, start),
      false => option.none(),
    },
    false => match root_kind == parser.text_expression_root_bool_tag() {
      true => match root_type == parser.text_type_class_bool_tag() {
        true => WasmCallLowering::bool_segment_summary(lowering, start),
        false => option.none(),
      },
      false => match root_kind == parser.text_expression_root_identifier_tag() {
        true => WasmCallLowering::identifier_segment_summary(
          lowering,
          start,
          limit
        ),
        false => option.none(),
      },
    },
  }
}

fn WasmCallLowering::append_segment_arg_summary(
  lowering: WasmCallLowering,
  summary: WasmBodySummary,
  start: i32,
  limit: i32,
  arg_index: i32
) -> core.Option(WasmBodySummary) {
  let segment = WasmCallLowering::segment_arg_segment(
    lowering,
    start,
    limit,
    arg_index
  );
  match WasmCallLowering::arg_summary(lowering, segment) {
    Some(arg_summary) => option.some(
      wasm_body_summary_append(summary, arg_summary)
    ),
    None => option.none(),
  }
}

fn WasmCallLowering::append_segment_args_summary(
  lowering: WasmCallLowering,
  summary: WasmBodySummary,
  start: i32,
  limit: i32,
  arg_index: i32,
  arg_count: i32
) -> core.Option(WasmBodySummary) {
  match arg_index >= arg_count {
    true => option.some(summary),
    false => do @monad(core.Option(_)) {
      next_summary <- WasmCallLowering::append_segment_arg_summary(
        lowering,
        summary,
        start,
        limit,
        arg_index
      );
      WasmCallLowering::append_segment_args_summary(
        lowering,
        next_summary,
        start,
        limit,
        arg_index + 1,
        arg_count
      )
    },
  }
}

fn WasmCallLowering::call_segment_summary(
  lowering: WasmCallLowering,
  start: i32,
  limit: i32
) -> core.Option(WasmBodySummary) {
  let encoded_arg_count = parser.text_expression_root_call_arg_count_between(
    lowering.context_value.source,
    start,
    limit
  );
  let arg_count = wasm_root_call_runtime_arg_count(encoded_arg_count);
  let target_hash = parser.text_expression_root_head_hash_between(
    lowering.context_value.source,
    start,
    limit
  );
  let lookup = WasmSourceEnv::lookup_function(
    lowering.context_value.env,
    target_hash
  );
  let return_type = parser.TextResolutionEnv::lookup_return(
    lowering.context_value.env.resolution,
    target_hash
  );
  do @monad(core.Option(_)) {
    option.guard(WasmCallLowering::segment_has_bare_call(lowering, start, limit));
    option.guard(lookup.found);
    option.guard(lookup.index < wasm_small_immediate_limit());
    option.guard(lookup.runtime_param_count == arg_count);
    option.guard(wasm_type_class_is_scalar(return_type));
    option.guard(arg_count <= 5);
    args_summary <- WasmCallLowering::append_segment_args_summary(
      lowering,
      wasm_body_summary_empty(),
      start,
      limit,
      0,
      arg_count
    );
    pure(wasm_body_summary_push_instruction(
      args_summary,
      wasm_body_instruction(wasm_call_opcode(), lookup.index)
    ))
  }
}

fn WasmCallLowering::branch_segment_summary(
  lowering: WasmCallLowering,
  start: i32,
  limit: i32
) -> core.Option(WasmBodySummary) {
  let segments = parser.text_bool_branch_segments_between(
    lowering.context_value.source,
    start,
    limit
  );
  do @monad(core.Option(_)) {
    option.guard(segments.found);
    let branch_type = WasmCallLowering::branch_type_from_segments(
      lowering,
      segments
    );
    option.guard(wasm_type_class_is_scalar(branch_type));
    condition_summary <- WasmCallLowering::segment_summary(
      lowering,
      segments.condition_start,
      segments.condition_limit,
      true
    );
    true_summary <- WasmCallLowering::segment_summary(
      lowering,
      segments.true_value_start,
      segments.true_value_limit,
      true
    );
    false_summary <- WasmCallLowering::segment_summary(
      lowering,
      segments.false_value_start,
      segments.false_value_limit,
      true
    );
    pure(wasm_body_summary_append(
      wasm_body_summary_empty(),
      condition_summary
    ) \with_condition -> wasm_body_summary_push_instruction(
      with_condition,
      wasm_body_instruction(wasm_if_opcode(), wasm_i32_val_type())
    ) \with_if -> wasm_body_summary_append(
      with_if,
      true_summary
    ) \with_true -> wasm_body_summary_push_instruction(
      with_true,
      wasm_body_instruction(wasm_else_opcode(), 0)
    ) \with_else -> wasm_body_summary_append(
      with_else,
      false_summary
    ) \with_false -> wasm_body_summary_push_instruction(
      with_false,
      wasm_body_instruction(wasm_end_opcode(), 0)
    ))
  }
}

fn WasmCallLowering::branch_segment_summary_if_possible(
  lowering: WasmCallLowering,
  start: i32,
  limit: i32
) -> core.Option(WasmBodySummary) {
  match wasm_segment_can_be_bool_branch(
    lowering.context_value.source,
    start,
    limit
  ) {
    true => WasmCallLowering::branch_segment_summary(lowering, start, limit),
    false => option.none(),
  }
}

fn WasmCallLowering::operator_segment_summary(
  lowering: WasmCallLowering,
  parts: parser.TextRootOperatorParts
) -> core.Option(WasmBodySummary) {
  match wasm_scalar_operator_opcode(parts.operator_hash) {
    None => option.none(),
    Some(opcode) => wasm_scalar_operator_body_summary_from_parts(
      lowering,
      parts,
      opcode
    ),
  }
}

fn WasmCallLowering::non_branch_segment_summary(
  lowering: WasmCallLowering,
  start: i32,
  limit: i32,
  parts: parser.TextRootOperatorParts
) -> core.Option(WasmBodySummary) {
  match parts.found {
    true => WasmCallLowering::operator_segment_summary(lowering, parts),
    false => match WasmCallLowering::segment_has_bare_call(
      lowering,
      start,
      limit
    ) {
      true => WasmCallLowering::call_segment_summary(lowering, start, limit),
      false => WasmCallLowering::simple_segment_summary(
        lowering,
        start,
        limit
      ),
    },
  }
}

fn WasmCallLowering::segment_summary(
  lowering: WasmCallLowering,
  start: i32,
  limit: i32,
  found: bool
) -> core.Option(WasmBodySummary) {
  let parts = parser.text_expression_root_single_operator_parts_between(
    lowering.context_value.source,
    start,
    limit
  );
  match found {
    false => option.none(),
    true => match WasmCallLowering::branch_segment_summary_if_possible(
      lowering,
      start,
      limit
    ) {
      Some(summary) => option.some(summary),
      None => WasmCallLowering::non_branch_segment_summary(
        lowering,
        start,
        limit,
        parts
      ),
    },
  }
}

fn WasmCallLowering::arg_summary(
  lowering: WasmCallLowering,
  segment: parser.TextArgumentSegment
) -> core.Option(WasmBodySummary) {
  WasmCallLowering::segment_summary(
    lowering,
    segment.start,
    segment.limit,
    segment.found
  )
}

fn wasm_scalar_operator_body_summary_from_parts(
  lowering: WasmCallLowering,
  parts: parser.TextRootOperatorParts,
  opcode: i32
) -> core.Option(WasmBodySummary) {
  do @monad(core.Option(_)) {
    left <- WasmCallLowering::segment_summary(
      lowering,
      parts.left_start,
      parts.left_limit,
      parts.found
    );
    right <- WasmCallLowering::segment_summary(
      lowering,
      parts.right_start,
      parts.right_limit,
      parts.found
    );
    pure(wasm_body_summary_append(
      wasm_body_summary_empty(),
      left
    ) \with_left -> wasm_body_summary_append(
      with_left,
      right
    ) \with_right -> wasm_body_summary_push_instruction(
      with_right,
      wasm_body_instruction(opcode, 0)
    ))
  }
}

fn wasm_scalar_operator_opcode_case(
  operator_hash: i32,
  target_hash: i32,
  opcode: i32
) -> core.Option(i32) {
  match operator_hash == target_hash {
    true => option.some(opcode),
    false => option.none(),
  }
}

fn wasm_scalar_operator_opcode(operator_hash: i32) -> core.Option(i32) {
  let plus = wasm_scalar_operator_opcode_case(
    operator_hash,
    parser.text_operator_hash_plus(),
    wasm_i32_add_opcode()
  );
  let minus = core.Option::append(plus, wasm_scalar_operator_opcode_case(
    operator_hash,
    parser.text_operator_hash_minus(),
    wasm_i32_sub_opcode()
  ));
  let multiply = core.Option::append(minus, wasm_scalar_operator_opcode_case(
    operator_hash,
    parser.text_operator_hash_asterisk(),
    wasm_i32_mul_opcode()
  ));
  let divide = core.Option::append(multiply, wasm_scalar_operator_opcode_case(
    operator_hash,
    parser.text_operator_hash_slash(),
    wasm_i32_div_s_opcode()
  ));
  let remainder = core.Option::append(divide, wasm_scalar_operator_opcode_case(
    operator_hash,
    parser.text_operator_hash_percent(),
    wasm_i32_rem_s_opcode()
  ));
  let equal = core.Option::append(remainder, wasm_scalar_operator_opcode_case(
    operator_hash,
    parser.text_operator_hash_equal_equal(),
    wasm_i32_eq_opcode()
  ));
  let not_equal = core.Option::append(equal, wasm_scalar_operator_opcode_case(
    operator_hash,
    parser.text_operator_hash_not_equal(),
    wasm_i32_ne_opcode()
  ));
  let less = core.Option::append(not_equal, wasm_scalar_operator_opcode_case(
    operator_hash,
    parser.text_operator_hash_less(),
    wasm_i32_lt_s_opcode()
  ));
  let greater = core.Option::append(less, wasm_scalar_operator_opcode_case(
    operator_hash,
    parser.text_operator_hash_greater(),
    wasm_i32_gt_s_opcode()
  ));
  let less_equal = core.Option::append(greater, wasm_scalar_operator_opcode_case(
    operator_hash,
    parser.text_operator_hash_less_equal(),
    wasm_i32_le_s_opcode()
  ));
  core.Option::append(less_equal, wasm_scalar_operator_opcode_case(
    operator_hash,
    parser.text_operator_hash_greater_equal(),
    wasm_i32_ge_s_opcode()
  ))
}

fn wasm_scalar_operator_body_plan_from_parts(
  lowering: WasmCallLowering,
  parts: parser.TextRootOperatorParts,
  opcode: i32
) -> core.Option(WasmBodyPlan) {
  do @monad(core.Option(_)) {
    left <- WasmCallLowering::segment_plan(
      lowering,
      parts.left_start,
      parts.left_limit,
      parts.found
    );
    right <- WasmCallLowering::segment_plan(
      lowering,
      parts.right_start,
      parts.right_limit,
      parts.found
    );
    pure(wasm_body_plan_append_plan(
      wasm_body_plan_empty(3),
      left
    ) \with_left -> wasm_body_plan_append_plan(
      with_left,
      right
    ) \with_right -> wasm_body_plan_push_instruction(
      with_right,
      wasm_body_instruction(opcode, 0)
    ))
  }
}

fn wasm_semantic_scalar_body_immediate(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  decl: ast.Decl,
  body_abi: i32
) -> core.Option(i32) {
  do @monad(core.Option(_)) {
    option.guard(abi_class_is_scalar(body_abi));
    wasm_scalar_body_immediate_from_root(
      context_value,
      codes,
      current,
      decl
    )
  }
}

fn wasm_semantic_scalar_body_instruction(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  decl: ast.Decl,
  body_abi: i32
) -> core.Option(WasmBodyInstruction) {
  let root_kind = parser.text_declaration_root_head_kind_tag(
    context_value.source,
    current.cursor,
    decl
  );
  let is_scalar_abi = abi_class_is_scalar(body_abi);
  do @monad(core.Option(_)) {
    option.guard(is_scalar_abi);
    match root_kind == parser.text_expression_root_identifier_tag() {
      true => wasm_scalar_identifier_body_instruction(context_value.source, current),
      false => do @monad(core.Option(_)) {
        value <- wasm_semantic_scalar_body_immediate(
          context_value,
          codes,
          current,
          decl,
          body_abi
        );
        pure(wasm_body_instruction(wasm_const_opcode(), value))
      },
    }
  }
}

fn wasm_byte_body_instruction(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  decl: ast.Decl,
  body_abi: i32
) -> WasmBodyInstruction {
  match wasm_semantic_scalar_body_instruction(
    context_value,
    codes,
    current,
    decl,
    body_abi
  ) {
    Some(value) => value,
    None => wasm_body_instruction(
      wasm_body_opcode_for_abi(body_abi),
      wasm_body_immediate(
        context_value.source,
        current,
        decl,
        body_abi
      )
    ),
  }
}

fn wasm_root_call_runtime_arg_count(encoded_arg_count: i32) -> i32 {
  encoded_arg_count - 1
}

fn wasm_scalar_call_body_plan(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  body_abi: i32
) -> core.Option(WasmBodyPlan) {
  let source = context_value.source;
  let start = parser.text_function_body_value_start_index(
    source,
    current.cursor
  );
  let limit = parser.text_declaration_end_from_index(source, current.cursor);
  do @monad(core.Option(_)) {
    option.guard(abi_class_is_scalar(body_abi));
    WasmCallLowering::call_segment_plan(
      wasm_call_lowering(context_value, codes, current),
      start,
      limit
    )
  }
}

fn wasm_scalar_operator_body_plan(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  body_abi: i32
) -> core.Option(WasmBodyPlan) {
  let parts = parser.text_function_body_root_operator_parts(
    context_value.source,
    current.cursor
  );
  let is_scalar_body = abi_class_is_scalar(body_abi);
  do @monad(core.Option(_)) {
    option.guard(is_scalar_body);
    option.guard(parts.found);
    opcode <- wasm_scalar_operator_opcode(parts.operator_hash);
    wasm_scalar_operator_body_plan_from_parts(
      wasm_call_lowering(context_value, codes, current),
      parts,
      opcode
    )
  }
}

fn wasm_scalar_local_let_initializer_plan(
  lowering: WasmCallLowering,
  local_index: i32
) -> core.Option(WasmBodyPlan) {
  let segment = parser.text_function_local_let_value_segment_for_index(
    lowering.context_value.source,
    lowering.current.cursor,
    local_index
  );
  let wasm_index = lowering.runtime_param_count + local_index;
  match wasm_index < wasm_small_immediate_limit() {
    false => option.none(),
    true => match WasmCallLowering::arg_plan(lowering, segment) {
      None => option.none(),
      Some(plan) => option.some(wasm_body_plan_push_instruction(
        plan,
        wasm_body_instruction(wasm_local_set_opcode(), wasm_index)
      )),
    },
  }
}

fn wasm_scalar_local_let_initializer_plans(
  lowering: WasmCallLowering,
  plan: WasmBodyPlan,
  local_index: i32,
  local_count: i32
) -> core.Option(WasmBodyPlan) {
  match local_index >= local_count {
    true => option.some(plan),
    false => do @monad(core.Option(_)) {
      local_plan <- wasm_scalar_local_let_initializer_plan(
        lowering,
        local_index
      );
      wasm_scalar_local_let_initializer_plans(
        lowering,
        wasm_body_plan_append_plan(plan, local_plan),
        local_index + 1,
        local_count
      )
    },
  }
}

fn wasm_scalar_local_let_prefixed_body_plan(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  body_abi: i32,
  body_plan: WasmBodyPlan
) -> core.Option(WasmBodyPlan) {
  let local_count = parser.text_function_local_let_count(
    context_value.source,
    current.cursor
  );
  do @monad(core.Option(_)) {
    option.guard(abi_class_is_scalar(body_abi));
    match local_count <= 0 {
      true => option.some(body_plan),
      false => do @monad(core.Option(_)) {
        local_plan <- wasm_scalar_local_let_initializer_plans(
          wasm_call_lowering(context_value, codes, current),
          wasm_body_plan_empty(local_count + 1),
          0,
          local_count
        );
        pure(wasm_body_plan_append_plan(
          local_plan,
          body_plan
        ))
      },
    }
  }
}

fn wasm_scalar_base_body_plan(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  body_abi: i32
) -> core.Option(WasmBodyPlan) {
  match wasm_scalar_expression_body_plan(
    context_value,
    codes,
    current,
    body_abi
  ) {
    Some(plan) => option.some(plan),
    None => match wasm_scalar_call_body_plan(
      context_value,
      codes,
      current,
      body_abi
    ) {
      Some(plan) => option.some(plan),
      None => wasm_scalar_operator_body_plan(
        context_value,
        codes,
        current,
        body_abi
      ),
    },
  }
}

fn wasm_byte_base_body_plan(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  decl: ast.Decl,
  body_abi: i32
) -> WasmBodyPlan {
  match wasm_function_match_body_plan(
    context_value,
    codes,
    current,
    body_abi
  ) {
    Some(plan) => plan,
    None => match wasm_scalar_base_body_plan(
      context_value,
      codes,
      current,
      body_abi
    ) {
      Some(plan) => plan,
      None => wasm_single_instruction_body_plan(
        wasm_byte_body_instruction(
          context_value,
          codes,
          current,
          decl,
          body_abi
        )
      ),
    },
  }
}

fn wasm_byte_body_plan(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  decl: ast.Decl,
  body_abi: i32
) -> WasmBodyPlan {
  let base_plan = wasm_byte_base_body_plan(
    context_value,
    codes,
    current,
    decl,
    body_abi
  );
  match wasm_scalar_local_let_prefixed_body_plan(
    context_value,
    codes,
    current,
    body_abi,
    base_plan
  ) {
    Some(plan) => plan,
    None => base_plan,
  }
}

fn wasm_byte_body_immediate(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  decl: ast.Decl,
  body_abi: i32
) -> i32 {
  wasm_byte_body_instruction(
    context_value,
    codes,
    current,
    decl,
    body_abi
  ).immediate
}

fn wasm_terminator_opcode(result_val_type: i32) -> i32 {
  match result_val_type == wasm_no_val_type() {
    true => wasm_drop_opcode(),
    false => wasm_return_opcode(),
  }
}

fn wasm_opcode_matches_any4(
  opcode: i32,
  first: i32,
  second: i32,
  third: i32,
  fourth: i32
) -> bool {
  match opcode == first {
    true => true,
    false => match opcode == second {
      true => true,
      false => match opcode == third {
        true => true,
        false => opcode == fourth,
      },
    },
  }
}

fn wasm_instruction_has_immediate(opcode: i32) -> bool {
  match wasm_opcode_matches_any4(
    opcode,
    wasm_const_opcode(),
    wasm_local_get_opcode(),
    wasm_local_set_opcode(),
    wasm_call_opcode()
  ) {
    true => true,
    false => opcode == wasm_if_opcode(),
  }
}

fn wasm_instruction_size(opcode: i32) -> i32 {
  match wasm_instruction_has_immediate(opcode) {
    true => 2,
    false => 1,
  }
}

fn wasm_function_body_size(
  local_count: i32,
  body_byte_size: i32,
  terminator_opcode: i32
) -> i32 {
  wasm_local_decl_vector_size(local_count)
    + body_byte_size
    + wasm_instruction_size(terminator_opcode)
    + 1
}

fn wasm_local_decl_vector_size(local_count: i32) -> i32 {
  match local_count <= 0 {
    true => 1,
    false => 1 + wasm_u32_leb_size(local_count) + 1,
  }
}

fn wasm_result_arity(result_val_type: i32) -> i32 {
  match result_val_type == wasm_no_val_type() {
    true => 0,
    false => 1,
  }
}

fn wasm_type_entry_size(runtime_param_count: i32, result_val_type: i32) -> i32 {
  1 + 1 + runtime_param_count + 1 + wasm_result_arity(result_val_type)
}

fn wasm_type_entry_signature(
  runtime_param_count: i32,
  result_val_type: i32
) -> i32 {
  let with_params = textmodel.signature_mix(83, runtime_param_count);
  let with_result = textmodel.signature_mix(with_params, result_val_type);
  textmodel.signature_mix(with_result, wasm_result_arity(result_val_type))
}

fn wasm_export_entry_size(name_width: i32) -> i32 {
  1 + name_width + 1 + 1
}

fn wasm_export_entry_signature(name_hash: i32, function_index: i32) -> i32 {
  let with_name = textmodel.signature_mix(89, name_hash);
  textmodel.signature_mix(with_name, function_index)
}

fn wasm_code_entry_size(body_size: i32) -> i32 {
  wasm_u32_leb_size(body_size) + body_size
}

fn wasm_code_entry_signature(
  local_count: i32,
  body_opcode: i32,
  body_immediate: i32,
  terminator_opcode: i32,
  body_size: i32
) -> i32 {
  let with_locals = textmodel.signature_mix(97, local_count);
  let with_opcode = textmodel.signature_mix(with_locals, body_opcode);
  let with_immediate = textmodel.signature_mix(with_opcode, body_immediate);
  let with_terminator = textmodel.signature_mix(
    with_immediate,
    terminator_opcode
  );
  textmodel.signature_mix(with_terminator, body_size)
}

fn wasm_push_instruction(
  bytes: layout.HeapArray(i32),
  opcode: i32,
  immediate: i32
) -> layout.HeapArray(i32) {
  let with_opcode = wasm_push_byte(bytes, opcode);
  match wasm_instruction_size(opcode) > 1 {
    true => wasm_push_byte(with_opcode, immediate),
    false => with_opcode,
  }
}

fn wasm_push_module_header(bytes: layout.HeapArray(i32)) -> layout.HeapArray(i32) {
  let magic0 = wasm_push_byte(bytes, 0);
  let magic1 = wasm_push_byte(magic0, 97);
  let magic2 = wasm_push_byte(magic1, 115);
  let magic3 = wasm_push_byte(magic2, 109);
  let version0 = wasm_push_byte(magic3, 1);
  let version1 = wasm_push_byte(version0, 0);
  let version2 = wasm_push_byte(version1, 0);
  wasm_push_byte(version2, 0)
}

fn wasm_append_bytes(
  target: layout.HeapArray(i32),
  source: layout.HeapArray(i32),
  index: i32
) -> layout.HeapArray(i32) {
  match index < layout.HeapArray::len(i32, source) {
    true => rec(
      wasm_push_byte(target, layout.HeapArray::get(i32, source, index)),
      source,
      index + 1
    ),
    false => target,
  }
}

fn wasm_push_section(
  bytes: layout.HeapArray(i32),
  section_id: i32,
  payload: layout.HeapArray(i32)
) -> layout.HeapArray(i32) {
  let with_id = wasm_push_byte(bytes, section_id);
  let with_size = wasm_push_u32_leb(
    with_id,
    layout.HeapArray::len(i32, payload)
  );
  wasm_append_bytes(with_size, payload, 0)
}

fn wasm_payload_count(kind: WasmBytePayloadKind, scan: WasmSectionScan) -> i32 {
  match kind {
    WasmBytePayloadKind::ExportPayload => scan.export_count,
    _ => scan.function_count,
  }
}

fn wasm_payload_capacity(kind: WasmBytePayloadKind, scan: WasmSectionScan) -> i32 {
  match kind {
    WasmBytePayloadKind::TypePayload => scan.type_payload_size
      + scan.function_count
      + 8,
    WasmBytePayloadKind::FunctionPayload => scan.function_payload_size
      + scan.function_count
      + 8,
    WasmBytePayloadKind::ExportPayload => scan.export_payload_size
      + scan.export_count
      + 8,
    WasmBytePayloadKind::CodePayload => scan.code_payload_size
      + scan.function_count
      + 8,
  }
}

fn wasm_push_type_payload_function(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  result: combinator.Reply(parser.DeclFrame),
  bytes: layout.HeapArray(i32)
) -> layout.HeapArray(i32) {
  let fact = wasm_byte_function_fact(context_value, codes, current, result);
  let with_form = wasm_push_byte(bytes, 96);
  let with_param_count = wasm_push_u32_leb(
    with_form,
    fact.runtime_param_count
  );
  let with_params = wasm_push_repeated_byte(
    with_param_count,
    fact.runtime_param_count,
    wasm_i32_val_type()
  );
  let arity = wasm_result_arity(fact.result_val_type);
  let with_result_count = wasm_push_u32_leb(with_params, arity);
  match arity > 0 {
    true => wasm_push_byte(with_result_count, fact.result_val_type),
    false => with_result_count,
  }
}

fn wasm_push_function_payload_function(
  function_index: i32,
  bytes: layout.HeapArray(i32)
) -> layout.HeapArray(i32) {
  wasm_push_u32_leb(bytes, function_index)
}

fn wasm_push_export_payload_function(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  state: WasmBytePayloadState,
  result: combinator.Reply(parser.DeclFrame),
  bytes: layout.HeapArray(i32)
) -> layout.HeapArray(i32) {
  match is_pub_function(context_value.source, state.current, result) {
    false => bytes,
    true => wasm_push_export_payload_bytes(
      context_value,
      codes,
      state,
      result,
      bytes
    ),
  }
}

fn wasm_push_export_payload_bytes(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  state: WasmBytePayloadState,
  result: combinator.Reply(parser.DeclFrame),
  bytes: layout.HeapArray(i32)
) -> layout.HeapArray(i32) {
  let decl = result.value.decl;
  let name_index = parser.text_declaration_name_index(
    context_value.source,
    state.current.cursor,
    decl
  );
  let name_span = textlex.token_at(context_value.source, name_index).span;
  let with_name_size = wasm_push_u32_leb(bytes, span.width(name_span));
  let with_name = wasm_push_source_bytes(
    codes,
    context_value.base_offset,
    name_span.start,
    name_span.end,
    with_name_size
  );
  let with_kind = wasm_push_byte(with_name, 0);
  wasm_push_u32_leb(with_kind, state.function_index)
}

fn wasm_push_body_plan_at(
  bytes: layout.HeapArray(i32),
  plan: WasmBodyPlan,
  index: i32
) -> layout.HeapArray(i32) {
  match index < vec.Vec::len(plan.instructions) {
    true => vec.Vec::get_t(
      WasmBodyInstruction,
      plan.instructions,
      index
    ) \instruction -> rec(
      wasm_push_instruction(
        bytes,
        instruction.opcode,
        instruction.immediate
      ),
      plan,
      index + 1
    ),
    false => bytes,
  }
}

fn wasm_push_body_plan(
  bytes: layout.HeapArray(i32),
  plan: WasmBodyPlan
) -> layout.HeapArray(i32) {
  wasm_push_body_plan_at(bytes, plan, 0)
}

fn wasm_push_code_payload_function(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  result: combinator.Reply(parser.DeclFrame),
  bytes: layout.HeapArray(i32)
) -> layout.HeapArray(i32) {
  let fact = wasm_byte_function_fact(
    context_value,
    codes,
    current,
    result
  );
  let body_plan = wasm_byte_function_body_plan(
    context_value,
    codes,
    current,
    result
  );
  let with_body_size = wasm_push_u32_leb(bytes, fact.body_size);
  let with_local_decls = wasm_push_local_decls(with_body_size, fact.local_count);
  let with_body = wasm_push_body_plan(with_local_decls, body_plan);
  let with_terminator = wasm_push_instruction(
    with_body,
    fact.terminator_opcode,
    0
  );
  wasm_push_byte(with_terminator, 11)
}

fn wasm_push_payload_bytes(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  state: WasmBytePayloadState,
  result: combinator.Reply(parser.DeclFrame),
  bytes: layout.HeapArray(i32)
) -> layout.HeapArray(i32) {
  match state.kind {
    WasmBytePayloadKind::TypePayload => wasm_push_type_payload_function(
      context_value,
      codes,
      state.current,
      result,
      bytes
    ),
    WasmBytePayloadKind::FunctionPayload => wasm_push_function_payload_function(
      state.function_index,
      bytes
    ),
    WasmBytePayloadKind::ExportPayload => wasm_push_export_payload_function(
      context_value,
      codes,
      state,
      result,
      bytes
    ),
    WasmBytePayloadKind::CodePayload => wasm_push_code_payload_function(
      context_value,
      codes,
      state.current,
      result,
      bytes
    ),
  }
}

fn wasm_payload_scan(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  state: WasmBytePayloadState,
  bytes: layout.HeapArray(i32)
) -> layout.HeapArray(i32) {
  match state.current.cursor < textlex.length(context_value.source) {
    false => bytes,
    true => match parser.parse_text_declaration_stream(
      state.current,
      context_value.source,
      state.function_index
    ) {
      Err(_) => bytes,
      Ok(result) => rec(
        context_value,
        codes,
        wasm_payload_next_state(context_value, state, result),
        wasm_payload_next_bytes(context_value, codes, state, bytes, result)
      ),
    },
  }
}

fn wasm_payload_next_bytes(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  state: WasmBytePayloadState,
  bytes: layout.HeapArray(i32),
  result: combinator.Reply(parser.DeclFrame)
) -> layout.HeapArray(i32) {
  let is_decl_function = is_function(context_value.source, state.current, result);
  let next_bytes = match is_decl_function {
    true => wasm_push_payload_bytes(
      context_value,
      codes,
      state,
      result,
      bytes
    ),
    false => bytes,
  };
  next_bytes
}

fn wasm_payload_next_state(
  context_value: WasmByteContext,
  state: WasmBytePayloadState,
  result: combinator.Reply(parser.DeclFrame)
) -> WasmBytePayloadState {
  let is_decl_function = is_function(context_value.source, state.current, result);
  let next_index = match is_decl_function {
    true => state.function_index + 1,
    false => state.function_index,
  };
  WasmBytePayloadState {
    kind: state.kind,
    current: parser.next_text_declaration_state(
      result.state,
      context_value.source
    ),
    function_index: next_index,
  }
}

fn wasm_next_declaration_state(
  context_value: WasmByteContext,
  result: combinator.Reply(parser.DeclFrame)
) -> combinator.ParseState {
  parser.next_text_declaration_state(result.state, context_value.source)
}

fn wasm_export_count_scan(
  context_value: WasmByteContext,
  current: combinator.ParseState,
  total: i32
) -> i32 {
  match current.cursor < textlex.length(context_value.source) {
    false => total,
    true => match parser.parse_text_declaration_stream(
      current,
      context_value.source,
      total
    ) {
      Err(_) => total,
      Ok(result) => rec(
        context_value,
        wasm_next_declaration_state(context_value, result),
        match is_pub_function(context_value.source, current, result) {
          true => total + 1,
          false => total,
        }
      ),
    },
  }
}

fn wasm_export_count(context_value: WasmByteContext) -> i32 {
  wasm_export_count_scan(
    context_value,
    wasm_byte_context_window_state(context_value),
    0
  )
}

fn wasm_function_count(source: textlex.TextTokenStream) -> i32 {
  textsummary.run(source, textmodel.SummaryKind::KindCount, 1)
}

fn wasm_payload_buffer(
  codes: layout.HeapArray(i32),
  item_count: i32
) -> layout.HeapArray(i32) {
  layout.HeapArray::new(
    i32,
    layout.HeapArray::len(i32, codes) + item_count * 16 + 64
  )
}

fn wasm_section_payload_with_count(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  kind: WasmBytePayloadKind,
  count: i32
) -> layout.HeapArray(i32) {
  let with_count = wasm_push_u32_leb(wasm_payload_buffer(codes, count), count);
  wasm_payload_scan(
    context_value,
    codes,
    WasmByteContext::payload_state(context_value, kind),
    with_count
  )
}

fn wasm_byte_buffer_from_counts(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  function_count: i32,
  export_count: i32
) -> layout.HeapArray(i32) {
  let header = wasm_push_module_header(wasm_byte_buffer_empty(
    layout.HeapArray::len(i32, codes) * 2 + function_count * 16 + 128
  ));
  let type_payload = wasm_section_payload_with_count(
    context_value,
    codes,
    WasmBytePayloadKind::TypePayload,
    function_count
  );
  let with_type = wasm_push_section(
    header,
    wasm_type_section_id(),
    type_payload
  );
  let function_payload = wasm_section_payload_with_count(
    context_value,
    codes,
    WasmBytePayloadKind::FunctionPayload,
    function_count
  );
  let with_function = wasm_push_section(
    with_type,
    wasm_function_section_id(),
    function_payload
  );
  let export_payload = wasm_section_payload_with_count(
    context_value,
    codes,
    WasmBytePayloadKind::ExportPayload,
    export_count
  );
  let with_export = wasm_push_section(
    with_function,
    wasm_export_section_id(),
    export_payload
  );
  let code_payload = wasm_section_payload_with_count(
    context_value,
    codes,
    WasmBytePayloadKind::CodePayload,
    function_count
  );
  wasm_push_section(
    with_export,
    wasm_code_section_id(),
    code_payload
  )
}

fn wasm_section_payload(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  kind: WasmBytePayloadKind,
  scan: WasmSectionScan
) -> layout.HeapArray(i32) {
  let count = wasm_payload_count(kind, scan);
  let with_count = wasm_push_u32_leb(
    wasm_byte_buffer_empty(wasm_payload_capacity(kind, scan)),
    count
  );
  wasm_payload_scan(
    context_value,
    codes,
    WasmByteContext::payload_state(context_value, kind),
    with_count
  )
}

fn wasm_byte_buffer_capacity(scan: WasmSectionScan) -> i32 {
  wasm_module_header_size()
    + scan.type_payload_size
    + scan.function_payload_size
    + scan.export_payload_size
    + scan.code_payload_size
    + scan.function_count * 4
    + scan.export_count * 2
    + 32
}

fn wasm_byte_buffer_from_scan(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  scan: WasmSectionScan
) -> layout.HeapArray(i32) {
  let header = wasm_push_module_header(wasm_byte_buffer_empty(
    wasm_byte_buffer_capacity(scan)
  ));
  let type_payload = wasm_section_payload(
    context_value,
    codes,
    WasmBytePayloadKind::TypePayload,
    scan
  );
  let with_type = wasm_push_section(
    header,
    wasm_type_section_id(),
    type_payload
  );
  let function_payload = wasm_section_payload(
    context_value,
    codes,
    WasmBytePayloadKind::FunctionPayload,
    scan
  );
  let with_function = wasm_push_section(
    with_type,
    wasm_function_section_id(),
    function_payload
  );
  let export_payload = wasm_section_payload(
    context_value,
    codes,
    WasmBytePayloadKind::ExportPayload,
    scan
  );
  let with_export = wasm_push_section(
    with_function,
    wasm_export_section_id(),
    export_payload
  );
  let code_payload = wasm_section_payload(
    context_value,
    codes,
    WasmBytePayloadKind::CodePayload,
    scan
  );
  wasm_push_section(
    with_export,
    wasm_code_section_id(),
    code_payload
  )
}

fn wasm_export_tag(
  source: textlex.TextTokenStream,
  current: combinator.ParseState,
  result: combinator.Reply(parser.DeclFrame)
) -> i32 {
  match is_pub_function(source, current, result) {
    true => 1,
    false => 0,
  }
}

fn wasm_function_fact(
  source: textlex.TextTokenStream,
  current: combinator.ParseState,
  result: combinator.Reply(parser.DeclFrame)
) -> WasmFunctionFact {
  let decl = result.value.decl;
  let expected = parser.text_declaration_resolved_expected_body_type_class_tag(
    source,
    current.cursor,
    decl
  );
  let actual = parser.text_declaration_resolved_value_body_type_class_tag(
    source,
    current.cursor,
    decl
  );
  let body_abi = parser.text_abi_class_tag_for_type_class(actual);
  let body_opcode = wasm_body_opcode_for_abi(body_abi);
  let result_val_type = wasm_val_type_for_abi(
    parser.text_abi_class_tag_for_type_class(expected)
  );
  let terminator_opcode = wasm_terminator_opcode(result_val_type);
  let check_status = parser.text_simple_body_type_check_status(expected, actual);
  let local_count = parser.text_function_local_let_count(source, current.cursor);
  WasmFunctionFact {
    name_hash: textlex.text_hash_at(
      source,
      parser.text_declaration_name_index(source, current.cursor, decl)
    ),
    export_tag: wasm_export_tag(source, current, result),
    runtime_param_count: parser.text_function_runtime_param_count(
      source,
      current.cursor
    ),
    local_count: local_count,
    result_val_type: result_val_type,
    body_opcode: body_opcode,
    body_immediate: wasm_body_immediate(source, current, decl, body_abi),
    terminator_opcode: terminator_opcode,
    body_size: wasm_function_body_size(
      local_count,
      wasm_instruction_size(body_opcode),
      terminator_opcode
    ),
    diagnostic_code: checked_type_status_diagnostic_code(check_status),
  }
}

fn wasm_byte_function_body_plan(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  result: combinator.Reply(parser.DeclFrame)
) -> WasmBodyPlan {
  let decl = result.value.decl;
  let actual = parser.TextResolutionEnv::declaration_resolved_value_body_type_class_tag(
    context_value.env.resolution,
    context_value.source,
    current.cursor,
    decl
  );
  let body_abi = parser.text_abi_class_tag_for_type_class(actual);
  wasm_byte_body_plan(
    context_value,
    codes,
    current,
    decl,
    body_abi
  )
}

fn wasm_byte_function_body_plan_with_env(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  result: combinator.Reply(parser.DeclFrame),
  env: parser.TextResolutionEnv
) -> WasmBodyPlan {
  let decl = result.value.decl;
  let actual = parser.TextResolutionEnv::declaration_resolved_value_body_type_class_tag(
    env,
    context_value.source,
    current.cursor,
    decl
  );
  let body_abi = parser.text_abi_class_tag_for_type_class(actual);
  wasm_byte_body_plan(
    context_value,
    codes,
    current,
    decl,
    body_abi
  )
}

fn wasm_byte_function_fact(
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
  result: combinator.Reply(parser.DeclFrame)
) -> WasmFunctionFact {
  let decl = result.value.decl;
  let expected = parser.text_declaration_resolved_expected_body_type_class_tag(
    context_value.source,
    current.cursor,
    decl
  );
  let actual = parser.TextResolutionEnv::declaration_resolved_value_body_type_class_tag(
    context_value.env.resolution,
    context_value.source,
    current.cursor,
    decl
  );
  let body_plan = wasm_byte_function_body_plan(
    context_value,
    codes,
    current,
    result
  );
  let result_val_type = wasm_val_type_for_abi(
    parser.text_abi_class_tag_for_type_class(expected)
  );
  let terminator_opcode = wasm_terminator_opcode(result_val_type);
  let check_status = parser.text_simple_body_type_check_status(expected, actual);
  let local_count = parser.text_function_local_let_count(
    context_value.source,
    current.cursor
  );
  WasmFunctionFact {
    name_hash: parser.text_declaration_name_hash(
      context_value.source,
      current.cursor,
      decl
    ),
    export_tag: wasm_export_tag(context_value.source, current, result),
    runtime_param_count: parser.text_function_runtime_param_count(
      context_value.source,
      current.cursor
    ),
    local_count: local_count,
    result_val_type: result_val_type,
    body_opcode: body_plan.first_opcode,
    body_immediate: body_plan.first_immediate,
    terminator_opcode: terminator_opcode,
    body_size: wasm_function_body_size(
      local_count,
      body_plan.byte_size,
      terminator_opcode
    ),
    diagnostic_code: checked_type_status_diagnostic_code(check_status),
  }
}

fn wasm_byte_function_fact_with_env(
