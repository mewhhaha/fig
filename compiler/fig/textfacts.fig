      textmodel.token_window_state(window),
      wasm_initial_section_scan()
    )
  )
}

fn checked_declaration_type_signature(source: textlex.TextTokenStream) -> i32 {
  FactContext::checked_declaration_type_signature(context(source))
}

fn checked_diagnostic_signature(source: textlex.TextTokenStream) -> i32 {
  FactContext::checked_diagnostic_signature(context(source))
}

fn lowered_declaration_signature(source: textlex.TextTokenStream) -> i32 {
  FactContext::lowered_declaration_signature(context(source))
}

fn checked_declaration_record_signature(source: textlex.TextTokenStream) -> i32 {
  FactContext::checked_declaration_record_signature(context(source))
}

fn checked_expression_record_signature(source: textlex.TextTokenStream) -> i32 {
  FactContext::checked_expression_record_signature(context(source))
}

fn checked_expression_child_record_signature(source: textlex.TextTokenStream) -> i32 {
  FactContext::checked_expression_child_record_signature(context(source))
}

fn checked_local_environment_signature(source: textlex.TextTokenStream) -> i32 {
  FactContext::checked_local_environment_signature(context(source))
}

fn checked_expression_shape_signature(source: textlex.TextTokenStream) -> i32 {
  FactContext::checked_expression_shape_signature(context(source))
}

fn lowered_export_record_signature(source: textlex.TextTokenStream) -> i32 {
  FactContext::lowered_export_record_signature(context(source))
}

fn wasm_function_record_signature(
  source: textlex.TextTokenStream,
  codes: layout.HeapArray(i32),
  base_offset: i32
) -> i32 {
  WasmByteContext::wasm_function_record_signature(
    wasm_byte_context(source, base_offset),
    codes
  )
}

fn wasm_section_record_signature(
  source: textlex.TextTokenStream,
  codes: layout.HeapArray(i32),
  base_offset: i32
) -> i32 {
  WasmByteContext::wasm_section_record_signature(
    wasm_byte_context(source, base_offset),
    codes
  )
}

fn wasm_byte_record_signature(
  source: textlex.TextTokenStream,
  codes: layout.HeapArray(i32),
  base_offset: i32
) -> i32 {
  WasmByteContext::wasm_byte_record_signature(
    wasm_byte_context(source, base_offset),
    codes
  )
}

fn wasm_byte_buffer(
  source: textlex.TextTokenStream,
  codes: layout.HeapArray(i32),
  base_offset: i32
) -> layout.HeapArray(i32) {
  let byte_context = wasm_byte_context(source, base_offset);
  wasm_byte_buffer_from_counts(
    byte_context,
    codes,
    wasm_function_count(source),
    wasm_export_count(byte_context)
  )
}

fn entry(seed: i32) -> i32 {
  seed
    + CheckedFactKind::CheckedDeclarationType
    + CheckedFactKind::CheckedDiagnostic
    + CheckedFactKind::LoweredDeclaration
    + CheckedFactKind::CheckedDeclarationRecord
    + CheckedFactKind::CheckedExpressionRecord
    + CheckedFactKind::CheckedExpressionChildRecord
    + CheckedFactKind::CheckedLocalEnvironment
    + CheckedFactKind::CheckedExpressionShape
    + CheckedFactKind::LoweredExportRecord
    + CheckedFactKind::WasmFunctionRecord
    + CheckedFactKind::WasmSectionRecord
    + CheckedFactKind::WasmByteRecord
}
