  textmodel.signature_mix(with_diagnostic, fact.lowered_abi_class)
}

fn lowered_value_tag_for_abi(abi_class: i32) -> i32 {
  abi_class
}

fn abi_class_is_scalar(abi_class: i32) -> bool {
  abi_class == parser.text_abi_class_scalar_tag()
}

fn abi_class_is_handle(abi_class: i32) -> bool {
  abi_class == parser.text_abi_class_handle_tag()
}

fn abi_class_is_function(abi_class: i32) -> bool {
  abi_class == parser.text_abi_class_function_tag()
}

fn abi_class_is_scalar_or_function(abi_class: i32) -> bool {
  match abi_class_is_scalar(abi_class) {
    true => true,
    false => abi_class_is_function(abi_class),
  }
}

fn abi_class_is_runtime_value(abi_class: i32) -> bool {
  match abi_class_is_scalar(abi_class) {
    true => true,
    false => match abi_class_is_handle(abi_class) {
      true => true,
      false => abi_class_is_function(abi_class),
    },
  }
}

fn lowered_value_has_primary(abi_class: i32) -> bool {
  abi_class_is_runtime_value(abi_class)
}

fn lowered_value_primary(
  abi_class: i32,
  resolved_type_class: i32
) -> i32 {
  match lowered_value_has_primary(abi_class) {
    true => resolved_type_class,
    _ => 0,
  }
}

fn lowered_value_secondary() -> i32 {
  0
}

fn checked_expr_fact(
  source: textlex.TextTokenStream,
  current: combinator.ParseState,
  result: combinator.Reply(parser.DeclFrame)
) -> CheckedExprFact {
  let decl = result.value.decl;
  let kind_tag = parser.text_declaration_kind_tag(
