fn checked_expr_shape_fact_signature(fact: CheckedExprShapeFact) -> i32 {
  let with_kind = textmodel.signature_mix(67, fact.kind_tag);
  let with_name = textmodel.signature_mix(with_kind, fact.name_hash);
  let with_root_kind = textmodel.signature_mix(with_name, fact.root_kind);
  let with_root_hash = textmodel.signature_mix(
    with_root_kind,
    fact.root_hash
  );
  let with_root_selector = textmodel.signature_mix(
    with_root_hash,
    fact.root_selector_count
  );
  let with_root_slot = textmodel.signature_mix(
    with_root_selector,
    fact.root_slot_count
  );
  let with_root_call = textmodel.signature_mix(
    with_root_slot,
    fact.root_call_arg_count
  );
  let with_root_field = textmodel.signature_mix(
    with_root_call,
    fact.root_field_count
  );
  let with_root_operator = textmodel.signature_mix(
    with_root_field,
    fact.root_operator_count
  );
  let with_operator = textmodel.signature_mix(
    with_root_operator,
    fact.operator_count
  );
  let with_operator_signature = textmodel.signature_mix(
    with_operator,
    fact.operator_signature_hash
  );
  let with_match = textmodel.signature_mix(
    with_operator_signature,
    fact.match_count
  );
  let with_arms = textmodel.signature_mix(with_match, fact.match_arm_count);
  let with_do = textmodel.signature_mix(with_arms, fact.do_count);
  let with_do_bind = textmodel.signature_mix(
    with_do,
    fact.do_bind_count
  );
  let with_pipe = textmodel.signature_mix(
    with_do_bind,
    fact.pipe_bind_count
  );
  let with_call = textmodel.signature_mix(with_pipe, fact.call_count);
  let with_function_match = textmodel.signature_mix(
    with_call,
    fact.function_match_body_count
  );
  let with_name_count = textmodel.signature_mix(
    with_function_match,
    fact.name_token_count
  );
  let with_name_signature = textmodel.signature_mix(
    with_name_count,
    fact.name_token_signature_hash
  );
  let with_literal_count = textmodel.signature_mix(
    with_name_signature,
    fact.literal_token_count
  );
  let with_literal_signature = textmodel.signature_mix(
    with_literal_count,
    fact.literal_token_signature_hash
  );
  textmodel.signature_mix(with_literal_signature, fact.diagnostic_code)
}

fn lowered_export_fact(
  source: textlex.TextTokenStream,
  current: combinator.ParseState,
  result: combinator.Reply(parser.DeclFrame)
) -> LoweredExportFact {
  let return_type = parser.text_function_return_resolved_type_class_tag(
    source,
    current.cursor
  );
  LoweredExportFact {
    name_hash: textlex.text_hash_at(
      source,
      parser.text_declaration_name_index(source, current.cursor, result.value.decl)
    ),
    param_count: ast.decl_param_count(result.value.decl),
    return_abi_class: parser.text_abi_class_tag_for_type_class(return_type),
  }
}

fn lowered_export_fact_signature(fact: LoweredExportFact) -> i32 {
  let with_name = textmodel.signature_mix(71, fact.name_hash);
  let with_params = textmodel.signature_mix(with_name, fact.param_count);
  textmodel.signature_mix(with_params, fact.return_abi_class)
}

