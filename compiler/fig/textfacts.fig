const ast = @import("./ast.fig");
const combinator = @import("./combinator.fig");
const core = @import("prelude.core");
const diagnostic = @import("./diagnostic.fig");
const layout = @import("prelude.layout");
const option = @import("prelude.option");
const parser = @import("./parser.fig");
const span = @import("./span.fig");
const textlex = @import("./textlex.fig");
const textmodel = @import("./textmodel.fig");
const textsummary = @import("./textsummary.fig");

type CheckedFactKind = enum(i32) {
  CheckedDeclarationType = 1,
  CheckedDiagnostic = 2,
  LoweredDeclaration = 3,
  CheckedDeclarationRecord = 4,
  CheckedExpressionRecord = 5,
  CheckedLocalEnvironment = 6,
  CheckedExpressionShape = 7,
  CheckedExpressionChildRecord = 8,
  LoweredExportRecord = 9,
  WasmFunctionRecord = 10,
  WasmSectionRecord = 11,
  WasmByteRecord = 12
}

type CheckedLocalFactKind = enum(i32) {
  LocalLet = 1,
  LocalProofConst = 2
}

type FactContext = struct {
  source: textlex.TextTokenStream,
}

type CheckedLocalScan = struct {
  index: i32,
  limit: i32,
  brace_depth: i32,
  paren_depth: i32,
  total: i32,
  function_name_hash: i32,
}

type CheckedDeclFact = struct {
  kind_tag: i32,
  name_hash: i32,
  symbol_type_class: i32,
  symbol_payload: i32,
  expected_type_class: i32,
  actual_type_class: i32,
  check_status: i32,
  diagnostic_code: i32,
  lowered_abi_class: i32,
}

type CheckedExprFact = struct {
  kind_tag: i32,
  name_hash: i32,
  root_kind: i32,
  root_hash: i32,
  root_child_count: i32,
  root_child_signature_hash: i32,
  root_grandchild_count: i32,
  root_grandchild_signature_hash: i32,
  root_descendant_count: i32,
  root_descendant_signature_hash: i32,
  root_type_class: i32,
  resolved_type_class: i32,
  expected_type_class: i32,
  check_status: i32,
  diagnostic_code: i32,
  lowered_value_tag: i32,
  lowered_value_primary: i32,
  lowered_value_secondary: i32,
}

type CheckedLocalFact = struct {
  function_name_hash: i32,
  local_kind_tag: i32,
  local_name_hash: i32,
  value_root_kind: i32,
  value_root_hash: i32,
  expected_type_class: i32,
  actual_type_class: i32,
  check_status: i32,
  diagnostic_code: i32,
}

type CheckedExprShapeFact = struct {
  kind_tag: i32,
  name_hash: i32,
  root_kind: i32,
  root_hash: i32,
  root_selector_count: i32,
  root_slot_count: i32,
  root_call_arg_count: i32,
  root_field_count: i32,
  root_operator_count: i32,
  operator_count: i32,
  operator_signature_hash: i32,
  match_count: i32,
  match_arm_count: i32,
  do_count: i32,
  do_bind_count: i32,
  pipe_bind_count: i32,
  call_count: i32,
  function_match_body_count: i32,
  name_token_count: i32,
  name_token_signature_hash: i32,
  literal_token_count: i32,
  literal_token_signature_hash: i32,
  diagnostic_code: i32,
}

type LoweredExportFact = struct {
  name_hash: i32,
  param_count: i32,
  return_abi_class: i32,
}

type WasmFunctionFact = struct {
  name_hash: i32,
  export_tag: i32,
  runtime_param_count: i32,
  local_count: i32,
  result_val_type: i32,
  body_opcode: i32,
  body_immediate: i32,
  terminator_opcode: i32,
  body_size: i32,
  diagnostic_code: i32,
}

type WasmBodyInstruction = struct {
  opcode: i32,
  immediate: i32,
}

type WasmBodyPlan = struct {
  first_opcode: i32,
  first_immediate: i32,
  byte_size: i32,
  instructions: layout.HeapArray(WasmBodyInstruction),
}

type WasmFunctionLookup = struct {
  index: i32,
  runtime_param_count: i32,
  found: bool,
}

type WasmSectionFact = struct {
  section_id: i32,
  item_count: i32,
  payload_size: i32,
  payload_signature: i32,
  diagnostic_signature: i32,
}

type WasmByteSectionFact = struct {
  section_id: i32,
  payload_size: i32,
  payload_leb_size: i32,
  section_size: i32,
  header_signature: i32,
  payload_signature: i32,
  diagnostic_signature: i32,
}

type WasmByteModuleFact = struct {
  magic_signature: i32,
  version_signature: i32,
  section_count: i32,
  byte_size: i32,
  section_signature: i32,
  diagnostic_signature: i32,
}

type WasmSectionScan = struct {
  function_count: i32,
  export_count: i32,
  type_payload_size: i32,
  type_payload_signature: i32,
  function_payload_size: i32,
  function_payload_signature: i32,
  export_payload_size: i32,
  export_payload_signature: i32,
  code_payload_size: i32,
  code_payload_signature: i32,
  diagnostic_signature: i32,
}

type WasmByteContext = struct {
  source: textlex.TextTokenStream,
  base_offset: i32,
}

fn wasm_byte_context(
  source: textlex.TextTokenStream,
  base_offset: i32
) -> WasmByteContext {
  WasmByteContext {
    source: source,
    base_offset: base_offset,
  }
}

type WasmCallLowering = struct {
  context_value: WasmByteContext,
  codes: layout.HeapArray(i32),
  current: combinator.ParseState,
}

type WasmBytePayloadKind = enum(i32) {
  TypePayload = 1,
  FunctionPayload = 2,
  ExportPayload = 3,
  CodePayload = 4
}

type WasmBytePayloadState = struct {
  kind: WasmBytePayloadKind,
  current: combinator.ParseState,
  function_index: i32,
}

type WasmByteCursor = struct {
  current: combinator.ParseState,
  function_index: i32,
}

fn context(source: textlex.TextTokenStream) -> FactContext {
  FactContext {source: source}
}

fn FactContext::summary(
  context_value: FactContext,
  kind: textmodel.SummaryKind
) -> i32 {
  textsummary.run(context_value.source, kind, 0)
}

fn fact_pair_signature(
  kind: CheckedFactKind,
  first: i32,
  second: i32
) -> i32 {
  let with_kind = textmodel.signature_mix(kind, first);
  textmodel.signature_mix(with_kind, second)
}

fn fact_triple_signature(
  kind: CheckedFactKind,
  first: i32,
  second: i32,
  third: i32
) -> i32 {
  let with_pair = fact_pair_signature(kind, first, second);
  textmodel.signature_mix(with_pair, third)
}

fn checked_type_status_diagnostic_code(status: i32) -> i32 {
  match status == parser.text_type_check_mismatch_tag() {
    true => diagnostic.code_score(diagnostic.CodeTypeMismatch),
    false => 0,
  }
}

fn checked_decl_fact(
  source: textlex.TextTokenStream,
  current: combinator.ParseState,
  result: combinator.Reply(parser.DeclFrame)
) -> CheckedDeclFact {
  let decl = result.value.decl;
  let kind_tag = parser.text_declaration_kind_tag(
    source,
    current.cursor,
    decl
  );
  let name_hash = textlex.text_hash_at(
    source,
    parser.text_declaration_name_index(source, current.cursor, decl)
  );
  let expected = parser.text_declaration_resolved_expected_body_type_class_tag(
    source,
    current.cursor,
    decl
  );
  let actual = parser.text_declaration_resolved_value_body_type_class_tag(
    source,
    current.cursor,
    decl
  );
  let check_status = parser.text_simple_body_type_check_status(expected, actual);
  CheckedDeclFact {
    kind_tag: kind_tag,
    name_hash: name_hash,
    symbol_type_class: parser.text_declaration_resolved_type_class_tag(
      source,
      current.cursor,
      decl
    ),
    symbol_payload: parser.text_declaration_resolved_type_class_payload(
      source,
      current.cursor,
      decl
    ),
    expected_type_class: expected,
    actual_type_class: actual,
    check_status: check_status,
    diagnostic_code: checked_type_status_diagnostic_code(check_status),
    lowered_abi_class: parser.text_declaration_resolved_abi_class_tag(
      source,
      current.cursor,
      decl
    ),
  }
}

fn checked_decl_fact_signature(fact: CheckedDeclFact) -> i32 {
  let with_kind = textmodel.signature_mix(
    53,
    fact.kind_tag
  );
  let with_name = textmodel.signature_mix(with_kind, fact.name_hash);
  let with_symbol = textmodel.signature_mix(
    with_name,
    fact.symbol_type_class
  );
  let with_payload = textmodel.signature_mix(
    with_symbol,
    fact.symbol_payload
  );
  let with_expected = textmodel.signature_mix(
    with_payload,
    fact.expected_type_class
  );
  let with_actual = textmodel.signature_mix(
    with_expected,
    fact.actual_type_class
  );
  let with_status = textmodel.signature_mix(with_actual, fact.check_status);
  let with_diagnostic = textmodel.signature_mix(
    with_status,
    fact.diagnostic_code
  );
  textmodel.signature_mix(with_diagnostic, fact.lowered_abi_class)
}

fn lowered_value_tag_for_abi(abi_class: i32) -> i32 {
  abi_class
}

fn lowered_value_has_primary(abi_class: i32) -> bool {
  let is_scalar = abi_class == parser.text_abi_class_scalar_tag();
  match is_scalar {
    true => true,
    false => match abi_class == parser.text_abi_class_handle_tag() {
      true => true,
      false => abi_class == parser.text_abi_class_function_tag(),
    },
  }
}

fn lowered_value_primary(
  abi_class: i32,
  resolved_type_class: i32
) -> i32 {
  match lowered_value_has_primary(abi_class) {
    true => resolved_type_class,
    _ => 0,
  }
}

fn lowered_value_secondary() -> i32 {
  0
}

fn checked_expr_fact(
  source: textlex.TextTokenStream,
  current: combinator.ParseState,
  result: combinator.Reply(parser.DeclFrame)
) -> CheckedExprFact {
  let decl = result.value.decl;
  let kind_tag = parser.text_declaration_kind_tag(
    source,
    current.cursor,
    decl
  );
  let name_hash = textlex.text_hash_at(
    source,
    parser.text_declaration_name_index(source, current.cursor, decl)
  );
  let root_type = parser.text_declaration_value_body_type_class_tag(
    source,
    current.cursor,
    decl
  );
  let resolved = parser.text_declaration_resolved_value_body_type_class_tag(
    source,
    current.cursor,
    decl
  );
  let expected = parser.text_declaration_resolved_expected_body_type_class_tag(
    source,
    current.cursor,
    decl
  );
  let abi = parser.text_abi_class_tag_for_type_class(resolved);
  let check_status = parser.text_simple_body_type_check_status(expected, resolved);
  CheckedExprFact {
    kind_tag: kind_tag,
    name_hash: name_hash,
    root_kind: parser.text_declaration_root_head_kind_tag(
      source,
      current.cursor,
      decl
    ),
    root_hash: parser.text_declaration_root_head_hash(
      source,
      current.cursor,
      decl
    ),
    root_child_count: parser.text_declaration_root_child_count(
      source,
      current.cursor,
      decl
    ),
    root_child_signature_hash: parser.text_declaration_root_child_signature(
      source,
      current.cursor,
      decl,
      0
    ),
    root_grandchild_count: parser.text_declaration_root_grandchild_count(
      source,
      current.cursor,
      decl
    ),
    root_grandchild_signature_hash: parser.text_declaration_root_grandchild_signature(
      source,
      current.cursor,
      decl,
      0
    ),
    root_descendant_count: parser.text_declaration_root_descendant_count(
      source,
      current.cursor,
      decl
    ),
    root_descendant_signature_hash: parser.text_declaration_root_descendant_signature(
      source,
      current.cursor,
      decl,
      0
    ),
    root_type_class: root_type,
    resolved_type_class: resolved,
    expected_type_class: expected,
    check_status: check_status,
    diagnostic_code: checked_type_status_diagnostic_code(check_status),
    lowered_value_tag: lowered_value_tag_for_abi(abi),
    lowered_value_primary: lowered_value_primary(abi, resolved),
    lowered_value_secondary: lowered_value_secondary(),
  }
}

fn checked_expr_fact_signature(fact: CheckedExprFact) -> i32 {
  let with_kind = textmodel.signature_mix(59, fact.kind_tag);
  let with_name = textmodel.signature_mix(with_kind, fact.name_hash);
  let with_root_kind = textmodel.signature_mix(with_name, fact.root_kind);
  let with_root_hash = textmodel.signature_mix(with_root_kind, fact.root_hash);
  let with_child_count = textmodel.signature_mix(
    with_root_hash,
    fact.root_child_count
  );
  let with_child_signature = textmodel.signature_mix(
    with_child_count,
    fact.root_child_signature_hash
  );
  let with_grandchild_count = textmodel.signature_mix(
    with_child_signature,
    fact.root_grandchild_count
  );
  let with_grandchild_signature = textmodel.signature_mix(
    with_grandchild_count,
    fact.root_grandchild_signature_hash
  );
  let with_descendant_count = textmodel.signature_mix(
    with_grandchild_signature,
    fact.root_descendant_count
  );
  let with_descendant_signature = textmodel.signature_mix(
    with_descendant_count,
    fact.root_descendant_signature_hash
  );
  let with_root_type = textmodel.signature_mix(
    with_descendant_signature,
    fact.root_type_class
  );
  let with_resolved = textmodel.signature_mix(
    with_root_type,
    fact.resolved_type_class
  );
  let with_expected = textmodel.signature_mix(
    with_resolved,
    fact.expected_type_class
  );
  let with_status = textmodel.signature_mix(with_expected, fact.check_status);
  let with_diagnostic = textmodel.signature_mix(
    with_status,
    fact.diagnostic_code
  );
  let with_value_tag = textmodel.signature_mix(
    with_diagnostic,
    fact.lowered_value_tag
  );
  let with_primary = textmodel.signature_mix(
    with_value_tag,
    fact.lowered_value_primary
  );
  textmodel.signature_mix(with_primary, fact.lowered_value_secondary)
}

