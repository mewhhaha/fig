const ast = @import("./ast.fig");
const artifact = @import("./artifact.fig");
const checker = @import("./checker.fig");
const combinator = @import("./combinator.fig");
const declgraph = @import("./declgraph.fig");
const diagnostic = @import("./diagnostic.fig");
const frontend = @import("./frontend.fig");
const incremental = @import("./incremental.fig");
const lexer = @import("./lexer.fig");
const layout = @import("prelude.layout");
const lowering = @import("./lowering.fig");
const modgraph = @import("./modgraph.fig");
const operators = @import("prelude.operators");
const parser = @import("./parser.fig");
const resolver = @import("./resolver.fig");
const source = @import("./source.fig");
const span = @import("./span.fig");
const stream = @import("./stream.fig");
const textfacts = @import("./textfacts.fig");
const textgrammar = @import("./textgrammar.fig");
const textimportsummary = @import("./textimportsummary.fig");
const textlex = @import("./textlex.fig");
const textmodel = @import("./textmodel.fig");
const textparser = @import("./textparser.fig");
const textsummary = @import("./textsummary.fig");
const token = @import("./token.fig");
const wasm = @import("./wasm.fig");

pub fn main(seed: i32) -> i32 {
  span.entry(seed)
    + token.entry(seed
    + 1)
    + ast.entry(seed
    + 2)
    + artifact.entry(seed
    + 3)
    + checker.entry(seed
    + 4)
    + combinator.entry(seed
    + 5)
    + declgraph.entry(seed
    + 6)
    + diagnostic.entry(seed
    + 7)
    + lexer.entry(seed
    + 8)
    + lowering.entry(seed
    + 9)
    + modgraph.entry(seed
    + 10)
    + resolver.entry(seed
    + 11)
    + source.entry(seed
    + 12)
    + stream.entry(seed
    + 13)
    + parser.entry(seed
    + 14)
    + incremental.entry(seed
    + 15)
    + textlex.entry(seed
    + 16)
    + textparser.entry(seed
    + 17)
    + frontend.entry(seed
    + 18)
    + wasm.entry(seed
    + 19)
    + textsummary.entry(seed
    + 20)
    + textimportsummary.entry(seed
    + 21)
    + textgrammar.entry(seed
    + 22)
    + textmodel.entry(seed
    + 23)
    + textfacts.entry(seed
    + 24)
}

pub fn compile_codes(codes: layout.HeapArray(i32)) -> i32 {
  frontend.compile_code_array(codes, 0)
}

pub fn compile_code_count(codes: layout.HeapArray(i32)) -> i32 {
  frontend.compile_code_summary(codes, 0, textmodel.SummaryKind::Declarations, 0)
}

pub fn compile_text_token_signature_hash(codes: layout.HeapArray(i32)) -> i32 {
  frontend.compile_text_token_signature(codes, 0)
}

pub fn compile_parse_status(codes: layout.HeapArray(i32)) -> i32 {
  frontend.compile_parse_status(codes, 0)
}

