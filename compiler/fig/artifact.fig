const ast = @import("./ast.fig");
const checker = @import("./checker.fig");
const combinator = @import("./combinator.fig");
const diagnostic = @import("./diagnostic.fig");
const lowering = @import("./lowering.fig");
const modgraph = @import("./modgraph.fig");
const parser = @import("./parser.fig");
const resolver = @import("./resolver.fig");
const source = @import("./source.fig");
const span = @import("./span.fig");
const stream = @import("./stream.fig");
const token = @import("./token.fig");
const map = @import("prelude.map");
const vec = @import("prelude.vec");

type CompilePhase = union {
  PhaseSource, PhaseParsed, PhaseChecked, PhaseLowered
}

type ModuleArtifact = struct {
  module_id: i32,
  source: source.SourceText,
  decl: ast.Decl,
  checked: checker.CheckedDecl,
  lowered: lowering.LoweredDecl,
  diagnostics: diagnostic.DiagnosticBag,
  phase: CompilePhase,
}

type ArtifactSummary = struct {
  module_id: i32,
  source_checksum: i32,
  decl_checksum: i32,
  checked_checksum: i32,
  lowered_checksum: i32,
  diagnostic_count: i32,
  phase: CompilePhase,
  checksum: i32,
}

type ArtifactTable = struct {
  artifacts: vec.Vec(ModuleArtifact),
  artifact_index: map.Map(i32, i32),
  diagnostics: diagnostic.DiagnosticBag,
}

type CompileStep = struct {
  resolve: resolver.ResolveStep,
  artifact: ModuleArtifact,
}

fn phase_score(value: CompilePhase) -> i32 match {
  PhaseSource => 1,
  PhaseParsed => 2,
  PhaseChecked => 3,
  PhaseLowered => 4,
}

fn fallback_decl(first: token.Token, seed: i32) -> ast.Decl {
  parser.declaration_from_kind(
    token.declaration_kind(first.kind),
    seed
  )
}

fn artifact(
  module_id: i32,
  text: source.SourceText,
  decl: ast.Decl,
  checked: checker.CheckedDecl,
  lowered: lowering.LoweredDecl,
  diagnostics: diagnostic.DiagnosticBag,
  phase: CompilePhase
) -> ModuleArtifact {
  ModuleArtifact {
    module_id: module_id,
    source: text,
    decl: decl,
    checked: checked,
    lowered: lowered,
    diagnostics: diagnostics,
    phase: phase,
  }
}

fn placeholder_artifact() -> ModuleArtifact {
  let source_span = span.make(0, 0, 0, 0);
  let text = source.from_seed(0);
  let decl = ast.source_import_decl(0, 0);
  let checked = checker.check_declaration(
    checker.empty_env(),
    decl,
    source_span
  );
  let lowered = lowering.lower_declaration(
    checked,
    source_span
  );
  artifact(
    0,
    text,
    decl,
    checked,
    lowered,
    diagnostic.empty(),
    PhaseSource
  )
}

fn empty_table() -> ArtifactTable {
  ArtifactTable {
    artifacts: vec.Vec::new(ModuleArtifact, 0),
    artifact_index: map.Map::empty(i32, i32),
    diagnostics: diagnostic.empty(),
  }
}

fn compile_source(
  module_id: i32,
  text: source.SourceText,
  incoming: diagnostic.DiagnosticBag,
  seed: i32
) -> ModuleArtifact {
  let tokens = stream.from_source(text);
  let first = stream.token_at(tokens, 0);
  let parsed = parser.parse_declaration_stream(
    combinator.state(0, stream.length(tokens)),
    tokens,
    seed
  );
  let decl = parser.parsed_decl_or_fallback(
    parsed,
    fallback_decl(first, seed)
  );
  let checked = checker.check_declaration(
    checker.seed_env(seed),
    decl,
    tokens.source_span
  );
  let lowered = lowering.lower_declaration(
    checked,
    tokens.source_span
  );
  artifact(
    module_id,
    text,
    decl,
    checked,
    lowered,
    diagnostic.merge(incoming, lowered.diagnostics),
    PhaseLowered
  )
}

fn insert(table: ArtifactTable, value: ModuleArtifact) -> ArtifactTable {
  let artifact_index = vec.Vec::len(table.artifacts);
  ArtifactTable {
    artifacts: vec.Vec::push(table.artifacts, value),
    artifact_index: map.Map::insert(
      i32,
      i32,
      table.artifact_index,
      value.module_id,
      artifact_index,
      map.compare_i32
    ),
    diagnostics: diagnostic.merge(
      table.diagnostics,
      value.diagnostics
    ),
  }
}

fn compile_request(
  current: resolver.ResolveState,
  request: resolver.ResolveRequest,
  seed: i32
) -> CompileStep {
  let resolved = resolver.resolve(current, request);
  let text = resolver.step_source(resolved);
  CompileStep {
    resolve: resolved,
    artifact: compile_source(
      source.module_seed(text),
      text,
      resolved.state.diagnostics,
      seed
    ),
  }
}

fn compile_graph(seed: i32) -> ArtifactTable {
  let graph = modgraph.from_seed(seed);
  let source_span = span.make(seed, seed + 1, 1, 1);
  let root = compile_request(
    resolver.state(graph),
    resolver.request(
      modgraph.root_id(graph),
      modgraph.root_id(graph),
      source_span
    ),
    seed
  );
  let dependency = compile_request(
    root.resolve.state,
    resolver.request(
      modgraph.root_id(graph),
      modgraph.root_import_id(graph),
      source_span
    ),
    seed + 1
  );
  insert(
    insert(empty_table(), root.artifact),
    dependency.artifact
  )
}

fn artifact_score(value: ModuleArtifact) -> i32 {
  value.module_id
    + source.source_score(value.source)
    + ast.decl_score(value.decl)
    + checker.checked_decl_score(value.checked)
    + lowering.lowered_decl_score(value.lowered)
    + diagnostic.bag_score(value.diagnostics)
    + phase_score(value.phase)
}

fn summarize(value: ModuleArtifact) -> ArtifactSummary {
  let source_checksum = source.source_score(value.source);
  let decl_checksum = ast.decl_score(value.decl);
  let checked_checksum = checker.checked_decl_score(value.checked);
  let lowered_checksum = lowering.lowered_decl_score(value.lowered);
  let diagnostic_count = diagnostic.count(value.diagnostics);
  let phase_value = phase_score(value.phase);
  ArtifactSummary {
    module_id: value.module_id,
    source_checksum: source_checksum,
    decl_checksum: decl_checksum,
    checked_checksum: checked_checksum,
    lowered_checksum: lowered_checksum,
    diagnostic_count: diagnostic_count,
    phase: value.phase,
    checksum: value.module_id
      + source_checksum
      + decl_checksum
      + checked_checksum
      + lowered_checksum
      + diagnostic_count
      + phase_value,
  }
}

fn summary_score(value: ArtifactSummary) -> i32 {
  value.module_id
    + value.source_checksum
    + value.decl_checksum
    + value.checked_checksum
    + value.lowered_checksum
    + value.diagnostic_count
    + phase_score(value.phase)
    + value.checksum
}

fn add_artifact_score(acc: i32, value: ModuleArtifact) -> i32 {
  acc + artifact_score(value)
}

fn table_score(table: ArtifactTable) -> i32 {
  vec.Vec::fold(table.artifacts, 0, add_artifact_score)
    + vec.Vec::len(table.artifacts)
    + map.Map::len(i32, i32, table.artifact_index)
    + diagnostic.bag_score(table.diagnostics)
}

fn entry(seed: i32) -> i32 {
  table_score(compile_graph(seed))
}
