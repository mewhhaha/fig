const ast = @import("./ast.fig");
const checker = @import("./checker.fig");
const diagnostic = @import("./diagnostic.fig");
const graph_data = @import("prelude.graph");
const list = @import("prelude.list");
const map = @import("prelude.map");
const nonempty = @import("prelude.nonempty");
const span = @import("./span.fig");
const vec = @import("prelude.vec");
const operators = @import("prelude.operators");

type NodeKind = union {
  NodeFunction, NodeValue, NodeType, NodeImport
}

type EdgeKind = union {
  ValueDependency, TypeDependency, ImportDependency
}

type ResolutionState = union {
  Pending, Resolved, Failed(diagnostics: diagnostic.DiagnosticBag)
}

type DeclNode = struct {
  node_id: i32,
  name: ast.SymbolId,
  decl: ast.Decl,
  kind: NodeKind,
  declared_type: checker.Type,
  inferred_type: checker.Type,
  state: ResolutionState,
  span: span.Span,
}

type DeclEdge = struct {
  from_id: i32,
  to_id: i32,
  kind: EdgeKind,
  weight: i32,
}

type SymbolGraph = struct {
  nodes: vec.Vec(DeclNode),
  node_index: map.Map(i32, i32),
  edges: vec.Vec(DeclEdge),
  topology: graph_data.Graph,
  diagnostics: diagnostic.DiagnosticBag,
}

type CycleCountScan = struct {
  graph: SymbolGraph,
  total: i32,
}

type CycleDiagnosticScan = struct {
  graph: SymbolGraph,
  diagnostics: diagnostic.DiagnosticBag,
}

type ResolutionOrder = struct {
  ids: nonempty.NonEmpty(i32),
  cycle_count: i32,
}

type ResolveGraphScan = struct {
  env: checker.CheckEnv,
  nodes: vec.Vec(DeclNode),
  diagnostics: diagnostic.DiagnosticBag,
}

type GraphSeed = struct {
  first: DeclNode,
  second: DeclNode,
  third: DeclNode,
  fourth: DeclNode,
  first_edge: DeclEdge,
  second_edge: DeclEdge,
  third_edge: DeclEdge,
}

fn node_kind(value: NodeKind) -> i32 match {
  NodeFunction => 1,
  NodeValue => 2,
  NodeType => 3,
  NodeImport => 4,
}

fn edge_kind(value: EdgeKind) -> i32 match {
  ValueDependency => 11,
  TypeDependency => 13,
  ImportDependency => 17,
}

fn state_score(value: ResolutionState) -> i32 match {
  Pending => 0,
  Resolved => 1,
  Failed(diagnostics) => 2 + diagnostic.bag_score(diagnostics),
}

fn state_diagnostics(value: ResolutionState) -> diagnostic.DiagnosticBag match {
  Pending => diagnostic.empty(),
  Resolved => diagnostic.empty(),
  Failed(diagnostics) => diagnostics,
}

fn kind_from_decl(decl: ast.Decl) -> NodeKind {
  match ast.decl_tag(decl) {
    1 => NodeFunction,
    2 => NodeValue,
    3 => NodeValue,
    4 => NodeType,
    _ => NodeImport,
  }
}

fn declared_type(decl: ast.Decl) -> checker.Type {
  match ast.decl_tag(decl) {
    1 => checker.function_type(
      ast.decl_param_count(decl),
      checker.type_from_symbol(ast.decl_type_name(decl))
    ),
    2 => checker.type_from_symbol(ast.decl_type_name(decl)),
    3 => checker.type_from_symbol(ast.decl_type_name(decl)),
    4 => checker.product_type(ast.decl_param_count(decl)),
    _ => checker.unknown_type(),
  }
}

fn node(
  node_id: i32,
  decl: ast.Decl,
  source_span: span.Span
) -> DeclNode {
  DeclNode {
    node_id: node_id,
    name: ast.decl_name(decl),
    decl: decl,
    kind: kind_from_decl(decl),
    declared_type: declared_type(decl),
    inferred_type: checker.unknown_type(),
    state: Pending,
    span: source_span,
  }
}

fn placeholder_node() -> DeclNode {
  node(
    0,
    ast.source_import_decl(0, 0),
    span.make(0, 0, 0, 0)
  )
}

fn edge(from_id: i32, to_id: i32, kind: EdgeKind) -> DeclEdge {
  DeclEdge {
    from_id: from_id,
    to_id: to_id,
    kind: kind,
    weight: from_id + to_id + edge_kind(kind),
  }
}

fn placeholder_edge() -> DeclEdge {
  edge(0, 0, ImportDependency)
}

fn push_node(nodes: vec.Vec(DeclNode), value: DeclNode) -> vec.Vec(DeclNode) {
  vec.Vec::push(nodes, value)
}

fn push_edge(
  edges: vec.Vec(DeclEdge),
  value: DeclEdge
) -> vec.Vec(DeclEdge) {
  vec.Vec::push(edges, value)
}

fn node_at(nodes: vec.Vec(DeclNode), index: i32) -> DeclNode {
  vec.Vec::get_t(DeclNode, nodes, index)
}

fn empty_node_index() -> map.Map(i32, i32) {
  map.Map::empty(i32, i32)
}

fn index_node(
  index: map.Map(i32, i32),
  node_index: i32,
  value: DeclNode
) -> map.Map(i32, i32) {
  map.Map::insert(
    i32,
    i32,
    index,
    value.node_id,
    node_index,
    map.compare_i32
  )
}

fn graph_with_cycle_diagnostics(graph_value: SymbolGraph) -> SymbolGraph {
  SymbolGraph {
    nodes: graph_value.nodes,
    node_index: graph_value.node_index,
    edges: graph_value.edges,
    topology: graph_value.topology,
    diagnostics: cycle_diagnostics(graph_value),
  }
}

fn graph(seed: GraphSeed) -> SymbolGraph {
  let empty_nodes = vec.Vec::new(DeclNode, 0);
  let nodes = push_node(
    push_node(
      push_node(
        push_node(empty_nodes, seed.first),
        seed.second
      ),
      seed.third
    ),
    seed.fourth
  );
  let node_index = index_node(
    index_node(
      index_node(
        index_node(empty_node_index(), 0, seed.first),
        1,
        seed.second
      ),
      2,
      seed.third
    ),
    3,
    seed.fourth
  );
  let empty_edges = vec.Vec::new(DeclEdge, 0);
  let edges = push_edge(
    push_edge(
      push_edge(empty_edges, seed.first_edge),
      seed.second_edge
    ),
    seed.third_edge
  );
  let topology = graph_data.Graph::add_edge(
    graph_data.Graph::add_edge(
      graph_data.Graph::add_edge(
        graph_data.Graph::empty(vec.Vec::len(nodes)),
        seed.first_edge.from_id,
        seed.first_edge.to_id
      ),
      seed.second_edge.from_id,
      seed.second_edge.to_id
    ),
    seed.third_edge.from_id,
    seed.third_edge.to_id
  );
  graph_with_cycle_diagnostics(SymbolGraph {
    nodes: nodes,
    node_index: node_index,
    edges: edges,
    topology: topology,
    diagnostics: diagnostic.empty(),
  })
}

fn from_seed(seed: i32) -> SymbolGraph {
  let type_decl = ast.type_decl(seed, 2);
  let value_decl = ast.let_decl(
    seed + 1,
    ast.named_type(seed),
    ast.int_expr(seed + 10)
  );
  let const_decl = ast.const_decl(
    seed + 2,
    ast.named_type(seed + 1),
    ast.var_expr(seed + 1)
  );
  let fn_decl = ast.fn_decl(
    seed + 3,
    1,
    ast.named_type(seed + 2),
    ast.block(ast.var_expr(seed + 2))
  );
  graph(GraphSeed {
    first: node(
      1,
      type_decl,
      span.make(seed, seed + 2, 1, 1)
    ),
    second: node(
      2,
      value_decl,
      span.make(seed + 2, seed + 4, 2, 1)
    ),
    third: node(
      3,
      const_decl,
      span.make(seed + 4, seed + 6, 3, 1)
    ),
    fourth: node(
      4,
      fn_decl,
      span.make(seed + 6, seed + 8, 4, 1)
    ),
    first_edge: edge(2, 1, TypeDependency),
    second_edge: edge(3, 2, ValueDependency),
    third_edge: edge(4, 3, ValueDependency),
  })
}

fn cycle_graph_from_seed(seed: i32) -> SymbolGraph {
  let base = from_seed(seed);
  graph(GraphSeed {
    first: node_at(base.nodes, 0),
    second: node_at(base.nodes, 1),
    third: node_at(base.nodes, 2),
    fourth: node_at(base.nodes, 3),
    first_edge: edge(2, 1, TypeDependency),
    second_edge: edge(3, 2, ValueDependency),
    third_edge: edge(1, 3, ValueDependency),
  })
}

fn edge_forms_cycle(graph: SymbolGraph, edge: DeclEdge) -> bool {
  graph_data.Graph::reachable_bounded(
    graph.topology,
    edge.to_id,
    edge.from_id,
    graph_data.Graph::edge_count(graph.topology)
  )
}

fn cycle_count_scan(graph: SymbolGraph) -> CycleCountScan {
  CycleCountScan {
    graph: graph,
    total: 0,
  }
}

fn cycle_count_step(scan: CycleCountScan, edge: DeclEdge) -> CycleCountScan {
  let next_total = match edge_forms_cycle(scan.graph, edge) {
    true => scan.total + 1,
    false => scan.total,
  };
  CycleCountScan {
    graph: scan.graph,
    total: next_total,
  }
}

fn cycle_count(graph: SymbolGraph) -> i32 {
  vec.Vec::fold(
    graph.edges,
    cycle_count_scan(graph),
    cycle_count_step
  ).total
}

fn span_for_node_id(
  graph: SymbolGraph,
  node_id: i32
) -> span.Span {
  match map.Map::get(
    i32,
    i32,
    graph.node_index,
    node_id,
    map.compare_i32
  ) {
    Some(index) => node_at(graph.nodes, index).span,
    None => span.make(0, 0, 0, 0),
  }
}

fn cycle_diagnostic(graph: SymbolGraph, edge: DeclEdge) -> diagnostic.Diagnostic {
  diagnostic.make(
    diagnostic.CodeDependencyCycle,
    diagnostic.Error,
    span_for_node_id(graph, edge.from_id),
    edge.from_id,
    edge.to_id
  )
}

fn cycle_diagnostic_scan(graph: SymbolGraph) -> CycleDiagnosticScan {
  CycleDiagnosticScan {
    graph: graph,
    diagnostics: diagnostic.empty(),
  }
}

fn cycle_diagnostic_step(
  scan: CycleDiagnosticScan,
  edge: DeclEdge
) -> CycleDiagnosticScan {
  let next_diagnostics = match edge_forms_cycle(scan.graph, edge) {
    true => diagnostic.push(
      scan.diagnostics,
      cycle_diagnostic(scan.graph, edge)
    ),
    false => scan.diagnostics,
  };
  CycleDiagnosticScan {
    graph: scan.graph,
    diagnostics: next_diagnostics,
  }
}

fn cycle_diagnostics(graph: SymbolGraph) -> diagnostic.DiagnosticBag {
  vec.Vec::fold(
    graph.edges,
    cycle_diagnostic_scan(graph),
    cycle_diagnostic_step
  ).diagnostics
}

fn bind_node(env: checker.CheckEnv, node: DeclNode) -> checker.CheckEnv {
  checker.define_symbol(
    env,
    node.name,
    node.declared_type
  )
}

fn resolve_node(env: checker.CheckEnv, node: DeclNode) -> DeclNode {
  let checked = checker.check_declaration(
    env,
    node.decl,
    node.span
  );
  let next_state: ResolutionState = match diagnostic.count(checked.env.diagnostics)
    == 0 {
    true => Resolved,
    false => Failed(checked.env.diagnostics),
  };
  DeclNode {
    node_id: node.node_id,
    name: node.name,
    decl: node.decl,
    kind: node.kind,
    declared_type: node.declared_type,
    inferred_type: checked.value_type,
    state: next_state,
    span: node.span,
  }
}

fn resolve_scan_initial() -> ResolveGraphScan {
  let nodes = vec.Vec::new(DeclNode, 0);
  ResolveGraphScan {
    env: checker.empty_env(),
    nodes: nodes,
    diagnostics: diagnostic.empty(),
  }
}

fn resolve_scan_push(
  scan: ResolveGraphScan,
  resolved: DeclNode
) -> ResolveGraphScan {
  ResolveGraphScan {
    env: bind_node(scan.env, resolved),
    nodes: push_node(scan.nodes, resolved),
    diagnostics: diagnostic.merge(
      scan.diagnostics,
      state_diagnostics(resolved.state)
    ),
  }
}

fn resolve_scan_step(
  scan: ResolveGraphScan,
  current: DeclNode
) -> ResolveGraphScan {
  let resolved = resolve_node(scan.env, current);
  resolve_scan_push(scan, resolved)
}

fn resolve(graph: SymbolGraph) -> SymbolGraph {
  let resolved = vec.Vec::fold(
    graph.nodes,
    resolve_scan_initial(),
    resolve_scan_step
  );
  SymbolGraph {
    nodes: resolved.nodes,
    node_index: graph.node_index,
    edges: graph.edges,
    topology: graph.topology,
    diagnostics: diagnostic.merge(graph.diagnostics, resolved.diagnostics),
  }
}

fn node_score(node: DeclNode) -> i32 {
  node.node_id
    + node.name
    + ast.decl_score(node.decl)
    + node_kind(node.kind)
    + checker.type_score(node.declared_type)
    + checker.type_score(node.inferred_type)
    + state_score(node.state)
    + span.width(node.span)
}

fn edge_score(edge: DeclEdge) -> i32 {
  edge.from_id
    + edge.to_id
    + edge_kind(edge.kind)
    + edge.weight
}

fn add_node_score(acc: i32, node: DeclNode) -> i32 {
  acc + node_score(node)
}

fn add_edge_score(acc: i32, edge: DeclEdge) -> i32 {
  acc + edge_score(edge)
}

fn add_order_id_score(acc: i32, node_id: i32) -> i32 {
  acc + node_id
}

fn resolution_order_cons_node_id(
  out: list.List(i32),
  node: DeclNode
) -> list.List(i32) {
  list.List::cons(node.node_id, out)
}

fn resolution_order_id_list(nodes: vec.Vec(DeclNode)) -> list.List(i32) {
  list.List::reverse(
    vec.Vec::fold(
      nodes,
      list.List::empty(i32),
      resolution_order_cons_node_id
    )
  )
}

fn resolution_order(graph: SymbolGraph) -> ResolutionOrder {
  ResolutionOrder {
    ids: nonempty.NonEmpty::from_list_or(
      0,
      resolution_order_id_list(graph.nodes)
    ),
    cycle_count: cycle_count(graph),
  }
}

fn node_score_total(nodes: vec.Vec(DeclNode)) -> i32 {
  vec.Vec::fold(nodes, 0, add_node_score)
}

fn edge_score_total(edges: vec.Vec(DeclEdge)) -> i32 {
  vec.Vec::fold(edges, 0, add_edge_score)
}

fn order_id_score(
  ids: nonempty.NonEmpty(i32)
) -> i32 {
  list.List::fold(
    nonempty.NonEmpty::to_list(ids),
    0,
    add_order_id_score
  )
}

fn order_score(order: ResolutionOrder) -> i32 {
  order_id_score(order.ids)
    + nonempty.NonEmpty::len(order.ids)
    + order.cycle_count
}

fn graph_score(graph: SymbolGraph) -> i32 {
  node_score_total(graph.nodes)
    + edge_score_total(graph.edges)
    + vec.Vec::len(graph.nodes)
    + map.Map::len(i32, i32, graph.node_index)
    + graph_data.Graph::edge_count(graph.topology)
    + diagnostic.bag_score(graph.diagnostics)
    + order_score(resolution_order(graph))
}

fn entry(seed: i32) -> i32 {
  let resolved = resolve(from_seed(seed));
  let cyclic = cycle_graph_from_seed(seed + 100);
  graph_score(resolved)
    + cycle_count(cyclic)
    + diagnostic.bag_score(cyclic.diagnostics)
}
