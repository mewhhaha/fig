type FrontendSummary = struct {
  token_score: i32,
  declaration_score: i32,
  diagnostic_score: i32,
  check_score: i32,
  lower_score: i32,
  wasm_score: i32,
  module_score: i32,
  resolver_score: i32,
  artifact_score: i32,
  declgraph_score: i32,
  textlex_score: i32,
  textparse_score: i32,
  program_score: i32,
  program_check_score: i32,
  program_lower_score: i32,
  function_program_score: i32,
  function_check_score: i32,
  function_lower_score: i32,
  program_wasm_score: i32,
  function_wasm_score: i32,
  multi_function_score: i32,
  multi_function_check_score: i32,
  multi_function_lower_score: i32,
  multi_function_wasm_score: i32,
  zero_function_score: i32,
  zero_function_check_score: i32,
  zero_function_lower_score: i32,
  zero_function_wasm_score: i32,
  three_function_score: i32,
  three_function_check_score: i32,
  three_function_lower_score: i32,
  three_function_wasm_score: i32,
  pub_function_score: i32,
  pub_function_check_score: i32,
  pub_function_lower_score: i32,
  pub_function_wasm_score: i32,
  source_width: i32,
}

type TextCompileState = struct {
  current: combinator.ParseState,
  env: checker.CheckEnv,
  score: i32,
  count: i32,
}

type TextSource = struct {
  stream: textlex.TextTokenStream,
  codes: layout.HeapArray(i32),
  seed: i32,
}

fn TextSource::from_codes(
  codes: layout.HeapArray(i32),
  seed: i32
) -> TextSource {
  TextSource {
    stream: textlex.stream_from_buffer(
      textlex.buffer_from_codes(seed, seed * 16, codes)
    ),
    codes: codes,
    seed: seed,
  }
}

fn TextSource::compile(input: TextSource) -> i32 {
  let source_span = textlex.source_span(input.stream);
  textlex.stream_score(input.stream)
    + compile_text_declaration_loop(
    input.stream,
    source_span,
    input.seed,
    initial_text_compile_state(input.stream)
  )
}

fn TextSource::summary(
  input: TextSource,
  summary_kind: textmodel.SummaryKind,
  summary_arg: i32
) -> i32 {
  textsummary.run(
    input.stream,
    summary_kind,
    summary_arg
  )
}

fn TextSource::text_token_signature(input: TextSource) -> i32 {
  textlex.stream_token_signature_hash(input.stream)
}

fn TextSource::checked_declaration_type_signature(input: TextSource) -> i32 {
  textfacts.checked_declaration_type_signature(input.stream)
}

fn TextSource::checked_diagnostic_signature(input: TextSource) -> i32 {
  textfacts.checked_diagnostic_signature(input.stream)
}

fn TextSource::lowered_declaration_signature(input: TextSource) -> i32 {
  textfacts.lowered_declaration_signature(input.stream)
}

fn TextSource::checked_declaration_record_signature(input: TextSource) -> i32 {
  textfacts.checked_declaration_record_signature(input.stream)
}

fn TextSource::checked_expression_record_signature(input: TextSource) -> i32 {
