fn TextSource::wasm_byte_record_signature(input: TextSource) -> i32 {
  textfacts.wasm_byte_record_signature(input.stream, input.codes, input.seed)
}

fn summarize(
  first: token.Token,
  decl: ast.Decl,
  source_span: span.Span
) -> FrontendSummary {
  FrontendSummary {
    token_score: token.token_score(first),
    declaration_score: ast.decl_score(decl),
    diagnostic_score: diagnostic.bag_score(diagnostic.empty()),
    check_score: 0,
    lower_score: 0,
    wasm_score: 0,
    module_score: 0,
    resolver_score: 0,
    artifact_score: 0,
    declgraph_score: 0,
    textlex_score: 0,
    textparse_score: 0,
    program_score: 0,
    program_check_score: 0,
    program_lower_score: 0,
    function_program_score: 0,
    function_check_score: 0,
    function_lower_score: 0,
    program_wasm_score: 0,
    function_wasm_score: 0,
    multi_function_score: 0,
    multi_function_check_score: 0,
    multi_function_lower_score: 0,
    multi_function_wasm_score: 0,
    zero_function_score: 0,
    zero_function_check_score: 0,
    zero_function_lower_score: 0,
    zero_function_wasm_score: 0,
    three_function_score: 0,
    three_function_check_score: 0,
    three_function_lower_score: 0,
    three_function_wasm_score: 0,
    pub_function_score: 0,
    pub_function_check_score: 0,
    pub_function_lower_score: 0,
    pub_function_wasm_score: 0,
    source_width: span.width(source_span),
  }
}

fn summary_score(summary: FrontendSummary) -> i32 {
  summary.token_score
    + summary.declaration_score
    + summary.diagnostic_score
    + summary.check_score
    + summary.lower_score
    + summary.wasm_score
    + summary.module_score
    + summary.resolver_score
    + summary.artifact_score
    + summary.declgraph_score
    + summary.textlex_score
    + summary.textparse_score
    + summary.program_score
    + summary.program_check_score
    + summary.program_lower_score
    + summary.function_program_score
    + summary.function_check_score
    + summary.function_lower_score
    + summary.program_wasm_score
    + summary.function_wasm_score
    + summary.multi_function_score
    + summary.multi_function_check_score
    + summary.multi_function_lower_score
    + summary.multi_function_wasm_score
    + summary.zero_function_score
    + summary.zero_function_check_score
    + summary.zero_function_lower_score
    + summary.zero_function_wasm_score
    + summary.three_function_score
    + summary.three_function_check_score
    + summary.three_function_lower_score
    + summary.three_function_wasm_score
    + summary.pub_function_score
    + summary.pub_function_check_score
    + summary.pub_function_lower_score
    + summary.pub_function_wasm_score
    + summary.source_width
}

fn declaration_from_token(
  kind: token.TokenKind,
  seed: i32
) -> ast.Decl {
  parser.declaration_from_kind(
    token.declaration_kind(kind),
    seed
  )
}

fn text_compile_state(
  current: combinator.ParseState,
  env: checker.CheckEnv,
  score: i32,
  count: i32
) -> TextCompileState {
  TextCompileState {
    current: current,
    env: env,
    score: score,
    count: count,
  }
}

fn initial_text_compile_state(source: textlex.TextTokenStream) -> TextCompileState {
  text_compile_state(
    combinator.state(0, textlex.length(source)),
    checker.empty_env(),
    0,
    0
  )
}

fn finish_text_compile_state(state: TextCompileState) -> i32 {
  state.score + state.count
}

fn text_compile_declaration_score(
  frame: parser.DeclFrame,
  checked: checker.CheckedDecl,
  lowered: lowering.LoweredDecl,
  emitted: wasm.WasmModule
) -> i32 {
  parser.frame_score(frame)
    + checker.checked_decl_score(checked)
    + lowering.lowered_decl_score(lowered)
    + wasm.module_score(emitted)
    + wasm.binary_score(wasm.encode_binary(emitted))
}

fn stop_text_compile_state(
  source: textlex.TextTokenStream,
  state: TextCompileState,
  error: combinator.ParseError
) -> TextCompileState {
  text_compile_state(
    combinator.state(textlex.length(source), textlex.length(source)),
    state.env,
    state.score + combinator.error_score(error),
    state.count
  )
}

fn advance_text_compile_state(
  state: TextCompileState,
  next: combinator.ParseState,
  env: checker.CheckEnv,
  score: i32
) -> TextCompileState {
  text_compile_state(
    next,
    env,
    state.score + score,
    state.count + 1
  )
}

fn compile_text_declaration_step(
  source: textlex.TextTokenStream,
  source_span: span.Span,
  seed: i32,
  state: TextCompileState
) -> TextCompileState {
  compile_text_declaration_step_result(
    source,
    source_span,
    state,
    parser.parse_text_declaration_stream(
      state.current,
      source,
      seed + state.count
    )
  )
}

fn compile_text_declaration_step_result(
  source: textlex.TextTokenStream,
  source_span: span.Span,
  state: TextCompileState,
  fourth: combinator.Parser(parser.DeclFrame)
) -> TextCompileState match {
  source, source_span, state, Ok(result) => checker.check_declaration(
    state.env,
    result.value.decl,
    source_span
  ) \checked -> lowering.lower_declaration(
    checked,
    source_span
  ) \lowered -> wasm.emit_module(lowered, source_span) \emitted -> advance_text_compile_state(
    state,
    parser.next_text_declaration_state(result.state, source),
    checked.env,
    text_compile_declaration_score(
      result.value,
      checked,
      lowered,
      emitted
    )
  ),
  source, _source_span, state, Err(error) => stop_text_compile_state(source, state, error),
}

fn compile_text_declaration_loop(
  source: textlex.TextTokenStream,
  source_span: span.Span,
  seed: i32,
  state: TextCompileState
) -> i32 {
  finish_text_compile_state(
    compile_text_declaration_state_loop(
      source,
      source_span,
      seed,
      state
    )
  )
}

fn compile_text_declaration_state_loop(
  source: textlex.TextTokenStream,
  source_span: span.Span,
  seed: i32,
  state: TextCompileState
) -> TextCompileState {
  match state.current.cursor < textlex.length(source) {
    false => state,
    true => compile_text_declaration_state_loop(
      source,
      source_span,
      seed,
      compile_text_declaration_step(
        source,
        source_span,
        seed,
        state
      )
    ),
  }
}

fn compile_text_declaration_count_loop(
  source: textlex.TextTokenStream,
  source_span: span.Span,
  seed: i32,
  state: TextCompileState
) -> i32 {
  let done = compile_text_declaration_state_loop(
    source,
    source_span,
    seed,
    state
  );
  done.count
}

fn compile_code_array(
  codes: layout.HeapArray(i32),
  seed: i32
) -> i32 {
  TextSource::compile(TextSource::from_codes(codes, seed))
}

fn compile_code_summary(
  codes: layout.HeapArray(i32),
  seed: i32,
  summary_kind: textmodel.SummaryKind,
  summary_arg: i32
) -> i32 {
  TextSource::summary(
    TextSource::from_codes(codes, seed),
    summary_kind,
    summary_arg
