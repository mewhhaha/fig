  codes: layout.HeapArray(i32),
  import_codes: layout.HeapArray(i32),
  module_hash: i32
) -> i32 {
  let source = TextSource::from_codes(codes, 0);
  let import_source = TextSource::from_codes(import_codes, 0);
  textimportsummary.type_environment_signature(
    source.stream,
    import_source.stream,
    module_hash
  )
}

