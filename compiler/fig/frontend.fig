fn compile_frontend_slice(seed: i32) -> FrontendSummary {
  let module_graph = modgraph.from_seed(seed);
  let resolve_step = resolver.resolve(
    resolver.state(module_graph),
    resolver.request(
      modgraph.root_id(module_graph),
      modgraph.root_import_id(module_graph),
      span.make(seed, seed + 1, 1, 1)
    )
  );
  let module_source = resolver.step_source(resolve_step);
  let source = stream.from_source(module_source);
  let first = stream.token_at(source, 0);
  let kind = first.kind;
  let source_span = source.source_span;
  let parsed = parser.parse_declaration_stream(
    combinator.state(0, stream.length(source)),
    source,
    seed
  );
  let fallback = declaration_from_token(kind, seed);
  let decl = parser.parsed_decl_or_fallback(
    parsed,
    fallback
  );
  let summary = summarize(first, decl, source_span);
  let checked = checker.check_declaration(
    checker.seed_env(seed),
    decl,
    source_span
  );
  let lowered = lowering.lower_declaration(
    checked,
    source_span
  );
  let emitted = wasm.emit_module(lowered, source_span);
  let artifacts = artifact.compile_graph(seed);
  let symbol_graph = declgraph.resolve(declgraph.from_seed(seed));
  let text_tokens = textlex.stream_from_buffer(textlex.from_seed(seed));
  let function_tokens = textlex.stream_from_buffer(
    textlex.function_from_seed(seed + 1)
  );
  let multi_function_tokens = textlex.stream_from_buffer(
    textlex.multi_function_from_seed(seed + 2)
  );
  let zero_function_tokens = textlex.stream_from_buffer(
    textlex.zero_function_from_seed(seed + 3)
  );
  let three_function_tokens = textlex.stream_from_buffer(
    textlex.three_function_from_seed(seed + 4)
  );
  let pub_function_tokens = textlex.stream_from_buffer(
    textlex.pub_function_from_seed(seed + 5)
  );
  let text_parsed = textgrammar.parse_declaration(
    combinator.state(0, textlex.length(text_tokens)),
    text_tokens,
    seed + 1
  );
  let text_program = textgrammar.parse_program(
    combinator.state(0, textlex.length(text_tokens)),
    text_tokens,
    seed,
    seed + 2
  );
  let text_program_value = textgrammar.program_or_fallback(
    text_program,
    ast.program(
      seed,
      0,
      ast.empty_decl(),
      ast.empty_decl(),
      textlex.source_span(text_tokens)
    )
  );
  let checked_text_program = checker.check_program(
    checker.empty_env(),
    text_program_value,
    text_program_value.span
  );
  let lowered_text_program = lowering.lower_program(
    checked_text_program,
    text_program_value.span
  );
  let emitted_text_program = wasm.emit_program(
    lowered_text_program,
    text_program_value.span
  );
  let function_program = textgrammar.parse_program(
    combinator.state(0, textlex.length(function_tokens)),
    function_tokens,
    seed + 1,
    seed + 3
  );
  let function_program_value = textgrammar.program_or_fallback(
    function_program,
    ast.program(
      seed + 1,
      0,
      ast.empty_decl(),
      ast.empty_decl(),
      textlex.source_span(function_tokens)
    )
  );
  let checked_function_program = checker.check_program(
    checker.empty_env(),
    function_program_value,
    function_program_value.span
  );
  let lowered_function_program = lowering.lower_program(
    checked_function_program,
    function_program_value.span
  );
  let emitted_function_program = wasm.emit_program(
    lowered_function_program,
    function_program_value.span
  );
  let multi_function_program = textgrammar.parse_program(
    combinator.state(0, textlex.length(multi_function_tokens)),
    multi_function_tokens,
    seed + 2,
    seed + 4
  );
  let multi_function_program_value = textgrammar.program_or_fallback(
    multi_function_program,
    ast.program(
      seed + 2,
      0,
      ast.empty_decl(),
      ast.empty_decl(),
      textlex.source_span(multi_function_tokens)
    )
  );
  let checked_multi_function_program = checker.check_program(
    checker.empty_env(),
    multi_function_program_value,
    multi_function_program_value.span
  );
  let lowered_multi_function_program = lowering.lower_program(
    checked_multi_function_program,
    multi_function_program_value.span
  );
  let emitted_multi_function_program = wasm.emit_program(
    lowered_multi_function_program,
    multi_function_program_value.span
  );
  let zero_function_program = textgrammar.parse_program(
    combinator.state(0, textlex.length(zero_function_tokens)),
    zero_function_tokens,
    seed + 3,
    seed + 5
  );
  let zero_function_program_value = textgrammar.program_or_fallback(
    zero_function_program,
    ast.program(
      seed + 3,
      0,
      ast.empty_decl(),
      ast.empty_decl(),
      textlex.source_span(zero_function_tokens)
    )
  );
  let checked_zero_function_program = checker.check_program(
    checker.empty_env(),
    zero_function_program_value,
    zero_function_program_value.span
  );
  let lowered_zero_function_program = lowering.lower_program(
    checked_zero_function_program,
    zero_function_program_value.span
  );
  let emitted_zero_function_program = wasm.emit_program(
    lowered_zero_function_program,
    zero_function_program_value.span
  );
  let three_function_program = textgrammar.parse_program(
    combinator.state(0, textlex.length(three_function_tokens)),
    three_function_tokens,
    seed + 4,
    seed + 6
  );
  let three_function_program_value = textgrammar.program_or_fallback(
    three_function_program,
    ast.program(
      seed + 4,
      0,
      ast.empty_decl(),
      ast.empty_decl(),
      textlex.source_span(three_function_tokens)
    )
  );
  let checked_three_function_program = checker.check_program(
    checker.empty_env(),
    three_function_program_value,
    three_function_program_value.span
  );
  let lowered_three_function_program = lowering.lower_program(
    checked_three_function_program,
    three_function_program_value.span
  );
  let emitted_three_function_program = wasm.emit_program(
    lowered_three_function_program,
    three_function_program_value.span
  );
  let pub_function_program = textgrammar.parse_program(
    combinator.state(0, textlex.length(pub_function_tokens)),
    pub_function_tokens,
    seed + 5,
    seed + 7
  );
  let pub_function_program_value = textgrammar.program_or_fallback(
    pub_function_program,
    ast.program(
      seed + 5,
      0,
      ast.empty_decl(),
      ast.empty_decl(),
      textlex.source_span(pub_function_tokens)
    )
  );
  let checked_pub_function_program = checker.check_program(
    checker.empty_env(),
    pub_function_program_value,
    pub_function_program_value.span
  );
  let lowered_pub_function_program = lowering.lower_program(
    checked_pub_function_program,
    pub_function_program_value.span
  );
  let emitted_pub_function_program = wasm.emit_program(
    lowered_pub_function_program,
    pub_function_program_value.span
  );
  FrontendSummary {
    token_score: summary.token_score,
    declaration_score: summary.declaration_score,
    diagnostic_score: parser.parsed_diagnostic_score(parsed),
    check_score: checker.checked_decl_score(checked),
    lower_score: lowering.lowered_decl_score(lowered),
    wasm_score: wasm.module_score(emitted)
      + wasm.binary_score(wasm.encode_binary(emitted)),
    module_score: modgraph.graph_score(module_graph),
    resolver_score: resolver.step_score(resolve_step),
    artifact_score: artifact.table_score(artifacts),
    declgraph_score: declgraph.graph_score(symbol_graph),
    textlex_score: textlex.stream_score(text_tokens)
      + textlex.stream_score(function_tokens)
      + textlex.stream_score(multi_function_tokens)
      + textlex.stream_score(zero_function_tokens)
      + textlex.stream_score(three_function_tokens)
      + textlex.stream_score(pub_function_tokens),
    textparse_score: textgrammar.declaration_score(text_parsed)
      + textgrammar.declaration_diagnostic_score(text_parsed),
    program_score: textgrammar.program_score(text_program),
    program_check_score: checker.checked_program_score(checked_text_program),
    program_lower_score: lowering.lowered_program_score(lowered_text_program),
    function_program_score: textgrammar.program_score(function_program),
    function_check_score: checker.checked_program_score(checked_function_program),
    function_lower_score: lowering.lowered_program_score(lowered_function_program),
    program_wasm_score: wasm.module_score(emitted_text_program)
      + wasm.binary_score(wasm.encode_binary(emitted_text_program)),
    function_wasm_score: wasm.module_score(emitted_function_program)
      + wasm.binary_score(wasm.encode_binary(emitted_function_program)),
    multi_function_score: textgrammar.program_score(multi_function_program),
    multi_function_check_score: checker.checked_program_score(checked_multi_function_program),
    multi_function_lower_score: lowering.lowered_program_score(lowered_multi_function_program),
    multi_function_wasm_score: wasm.module_score(emitted_multi_function_program)
      + wasm.binary_score(wasm.encode_binary(emitted_multi_function_program)),
    zero_function_score: textgrammar.program_score(zero_function_program),
    zero_function_check_score: checker.checked_program_score(checked_zero_function_program),
    zero_function_lower_score: lowering.lowered_program_score(lowered_zero_function_program),
    zero_function_wasm_score: wasm.module_score(emitted_zero_function_program)
      + wasm.binary_score(wasm.encode_binary(emitted_zero_function_program)),
    three_function_score: textgrammar.program_score(three_function_program),
    three_function_check_score: checker.checked_program_score(checked_three_function_program),
    three_function_lower_score: lowering.lowered_program_score(lowered_three_function_program),
    three_function_wasm_score: wasm.module_score(emitted_three_function_program)
      + wasm.binary_score(wasm.encode_binary(emitted_three_function_program)),
    pub_function_score: textgrammar.program_score(pub_function_program),
    pub_function_check_score: checker.checked_program_score(checked_pub_function_program),
    pub_function_lower_score: lowering.lowered_program_score(lowered_pub_function_program),
    pub_function_wasm_score: wasm.module_score(emitted_pub_function_program)
      + wasm.binary_score(wasm.encode_binary(emitted_pub_function_program)),
    source_width: summary.source_width,
  }
}

fn entry(seed: i32) -> i32 {
  summary_score(compile_frontend_slice(seed))
}
