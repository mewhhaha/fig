const combinator = @import("./combinator.fig");
const parser = @import("./parser.fig");
const textlex = @import("./textlex.fig");
const textmodel = @import("./textmodel.fig");
const monad = @import("prelude.monad");
const operators = @import("prelude.operators");

type Context = struct {
  kind: textmodel.SummaryKind,
  arg: i32,
}

fn context(kind: textmodel.SummaryKind, arg: i32) -> Context {
  Context {kind: kind, arg: arg}
}

fn context_kind(context_value: Context) -> textmodel.SummaryKind {
  context_value.kind
}

fn context_arg(context_value: Context) -> i32 {
  context_value.arg
}

fn parser_summary_context_reader() -> monad.Reader(
  Context,
  parser.TextSummaryContext
) {
  do @monad(monad.Reader(Context, _)) {
    kind <- monad.Reader::asks(context_kind);
    arg <- monad.Reader::asks(context_arg);
    monad.Reader::pure(parser.text_summary_context(0, kind, arg))
  }
}

fn Context::parser_summary_context(
  context_value: Context
) -> parser.TextSummaryContext {
  monad.Reader::run(parser_summary_context_reader(), context_value)
}

fn Context::apply_decl(
  context_value: Context,
  source: textlex.TextTokenStream,
  current: combinator.ParseState,
  total: i32,
  result: combinator.Reply(parser.DeclFrame)
) -> i32 {
  parser.text_declaration_summary_total_for_slice(
    textmodel.decl_slice(
      source,
      current.cursor,
      result.state.cursor,
      result.value.decl
    ),
    Context::parser_summary_context(context_value),
    total
  )
}

fn Context::scan(
  context_value: Context,
  source: textlex.TextTokenStream,
  current: combinator.ParseState,
  total: i32
) -> i32 {
  match current.cursor < textlex.length(source) {
    false => total,
    true => match parser.parse_text_declaration_stream(
      current,
      source,
      total
    ) {
      Err(_) => total,
      Ok(result) => rec(
        context_value,
        source,
        parser.next_text_declaration_state(result.state, source),
        Context::apply_decl(context_value, source, current, total, result)
      ),
    },
  }
}

fn run(
  source: textlex.TextTokenStream,
  kind: textmodel.SummaryKind,
  arg: i32
) -> i32 {
  match kind {
    textmodel.SummaryKind::DeclarationDependencyDiagnosticSignature =>
      parser.text_declaration_dependency_diagnostic_signature_for_source(source),
    textmodel.SummaryKind::ResolvedValueBodyTypeClassSignature =>
      parser.text_resolved_value_body_type_class_signature_for_source(source),
    textmodel.SummaryKind::ResolvedValueBodyAbiClassSignature =>
      parser.text_resolved_value_body_abi_class_signature_for_source(source),
    textmodel.SummaryKind::ResolvedSimpleBodyTypeCheckSignature =>
      parser.text_resolved_simple_body_type_check_signature_for_source(source),
    _ => Context::scan(
      context(kind, arg),
      source,
      textmodel.full_window_state(source),
      0
    ),
  }
}

fn entry(seed: i32) -> i32 {
  seed
    + textmodel.SummaryKind::Declarations
    + textmodel.SummaryKind::ResolvedValueBodyAbiClassSignature
}
