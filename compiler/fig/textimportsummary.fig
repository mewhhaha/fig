const ast = @import("./ast.fig");
const combinator = @import("./combinator.fig");
const parser = @import("./parser.fig");
const textlex = @import("./textlex.fig");
const textmodel = @import("./textmodel.fig");
const monad = @import("prelude.monad");
const operators = @import("prelude.operators");

type Context = struct {
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  module_hash: i32,
}

type SignatureMetric = union {
  TypeEnvironmentSignature, ResolvedDeclaredTypeClassSignature,
  ResolvedDeclaredAbiClassSignature, ResolvedValueBodyTypeClassSignature,
  ResolvedValueBodyAbiClassSignature, ResolvedSimpleBodyTypeCheckSignature,
  ResolvedSymbolEnvironmentSignature, ResolvedExportAbiSignature
}

type DirectImportDeclKind = enum(i32) {
  Function = 1,
  ValueBinding = 2,
  TypeDeclaration = 3,
  Other = 4
}

type ResolutionRecord = struct {
  module_hash: i32,
  alias_hash: i32,
  type_environment_signature: i32,
  resolved_declared_type_signature: i32,
  resolved_declared_abi_signature: i32,
  resolved_value_body_type_signature: i32,
  resolved_value_body_abi_signature: i32,
  resolved_simple_body_type_check_signature: i32,
  resolved_symbol_environment_signature: i32,
  resolved_export_abi_signature: i32,
}

type ResolutionRecordScan = struct {
  current: combinator.ParseState,
  resolved_declared_type_signature: i32,
  resolved_declared_abi_signature: i32,
  resolved_value_body_type_signature: i32,
  resolved_value_body_abi_signature: i32,
  resolved_simple_body_type_check_signature: i32,
  resolved_symbol_environment_signature: i32,
  resolved_export_abi_signature: i32,
}

type DirectImportDeclFacts = struct {
  kind_tag: i32,
  declaration_name_hash: i32,
  export_name_hash: i32,
  param_count: i32,
  declared_type_class: i32,
  declared_type_payload: i32,
  declared_abi_class: i32,
  expected_body_type_class: i32,
  actual_body_type_class: i32,
  body_check_status: i32,
  export_tag: i32,
}

type DirectImportDeclTypeFacts = struct {
  declared_type_class: i32,
  declared_type_payload: i32,
  expected_body_type_class: i32,
}

fn context(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  module_hash: i32
) -> Context {
  Context {
    source: source,
    import_source: import_source,
    module_hash: module_hash,
  }
}

fn context_source(context_value: Context) -> textlex.TextTokenStream {
  context_value.source
}

fn context_import_source(context_value: Context) -> textlex.TextTokenStream {
  context_value.import_source
}

fn context_module_hash(context_value: Context) -> i32 {
  context_value.module_hash
}

fn direct_import_decl_kind(kind_tag: i32) -> DirectImportDeclKind {
  if parser.text_declaration_kind_is_function(kind_tag) {
    DirectImportDeclKind::Function
  } else if parser.text_declaration_kind_is_value_binding(kind_tag) {
    DirectImportDeclKind::ValueBinding
  } else if parser.text_declaration_kind_is_type(kind_tag) {
    DirectImportDeclKind::TypeDeclaration
  } else {
    DirectImportDeclKind::Other
  }
}

fn direct_import_decl_declared_abi_class(
  kind: DirectImportDeclKind,
  declared_type_class: i32
) -> i32 {
  match kind {
    Function => parser.text_abi_class_function_tag(),
    ValueBinding => parser.text_abi_class_tag_for_type_class(declared_type_class),
    TypeDeclaration => parser.text_abi_class_tag_for_type_class(declared_type_class),
    Other => parser.text_abi_class_void_tag(),
  }
}

fn direct_import_decl_has_value_body(kind: DirectImportDeclKind) -> bool {
  match kind {
    Function => true,
    ValueBinding => true,
    TypeDeclaration => false,
    Other => false,
  }
}

fn direct_import_export_is_enabled(export_tag: i32) -> bool {
  export_tag == 1
}

fn direct_import_decl_export_name_hash(
  source: textlex.TextTokenStream,
  index: i32,
  export_tag: i32
) -> i32 {
  if direct_import_export_is_enabled(export_tag) {
    textlex.text_hash_at(
      source,
      parser.text_function_name_index(source, index)
    )
  } else {
    0
  }
}

fn direct_import_decl_function_type_facts(
  context_value: Context,
  type_context: parser.TextDirectImportContext,
  index: i32,
  param_count: i32
) -> DirectImportDeclTypeFacts {
  let return_type = parser.text_function_return_direct_import_resolved_type_class_tag(
    context_value.source,
    context_value.import_source,
    index,
    type_context.alias_hash
  );
  DirectImportDeclTypeFacts {
    declared_type_class: parser.text_type_class_function_tag(),
    declared_type_payload: param_count * 31 + return_type,
    expected_body_type_class: return_type,
  }
}

fn direct_import_decl_value_type_facts(
  context_value: Context,
  type_context: parser.TextDirectImportContext,
  index: i32
) -> DirectImportDeclTypeFacts {
  let annotation_type = parser.text_value_annotation_direct_import_resolved_type_class_tag(
    context_value.source,
    context_value.import_source,
    index,
    type_context.alias_hash
  );
  DirectImportDeclTypeFacts {
    declared_type_class: annotation_type,
    declared_type_payload: 0,
    expected_body_type_class: annotation_type,
  }
}

fn direct_import_decl_type_declaration_type_facts(
  context_value: Context,
  index: i32,
  kind_tag: i32
) -> DirectImportDeclTypeFacts {
  DirectImportDeclTypeFacts {
    declared_type_class: parser.text_type_declaration_environment_type_class_tag(
      context_value.source,
      index,
      kind_tag
    ),
    declared_type_payload: 0,
    expected_body_type_class: parser.text_type_class_unknown_tag(),
  }
}

fn direct_import_decl_unknown_type_facts() -> DirectImportDeclTypeFacts {
  DirectImportDeclTypeFacts {
    declared_type_class: parser.text_type_class_unknown_tag(),
    declared_type_payload: 0,
    expected_body_type_class: parser.text_type_class_unknown_tag(),
  }
}

fn direct_import_decl_type_facts(
  context_value: Context,
  type_context: parser.TextDirectImportContext,
  index: i32,
  kind: DirectImportDeclKind,
  kind_tag: i32,
  param_count: i32
) -> DirectImportDeclTypeFacts {
  match kind {
    Function => direct_import_decl_function_type_facts(
      context_value,
      type_context,
      index,
      param_count
    ),
    ValueBinding => direct_import_decl_value_type_facts(
      context_value,
      type_context,
      index
    ),
    TypeDeclaration => direct_import_decl_type_declaration_type_facts(
      context_value,
      index,
      kind_tag
    ),
    Other => direct_import_decl_unknown_type_facts(),
  }
}

fn direct_import_decl_actual_body_type_class(
  type_context: parser.TextDirectImportContext,
  index: i32,
  decl: ast.Decl,
  kind: DirectImportDeclKind
) -> i32 {
  match direct_import_decl_has_value_body(kind) {
    true => parser.text_declaration_direct_import_resolved_value_body_type_class_tag(
      type_context,
      index,
      decl
    ),
    false => parser.text_type_class_unknown_tag(),
  }
}

fn direct_import_decl_export_tag(
  source: textlex.TextTokenStream,
  index: i32,
  kind: DirectImportDeclKind
) -> i32 {
  match kind {
    Function => parser.text_function_public_tag(source, index),
    ValueBinding => 0,
    TypeDeclaration => 0,
    Other => 0,
  }
}

fn direct_import_decl_facts(
  context_value: Context,
  type_context: parser.TextDirectImportContext,
  index: i32,
  decl: ast.Decl
) -> DirectImportDeclFacts {
  let kind_tag = parser.text_declaration_kind_tag(
    context_value.source,
    index,
    decl
  );
  let kind = direct_import_decl_kind(kind_tag);
  let declaration_name_hash = parser.text_declaration_name_hash(
    context_value.source,
    index,
    decl
  );
  let param_count = ast.decl_param_count(decl);
  let type_facts = direct_import_decl_type_facts(
    context_value,
    type_context,
    index,
    kind,
    kind_tag,
    param_count
  );
  let actual_body_type_class = direct_import_decl_actual_body_type_class(
    type_context,
    index,
    decl,
    kind
  );
  let body_check_status = parser.text_simple_body_type_check_status(
    type_facts.expected_body_type_class,
    actual_body_type_class
  );
  let export_tag = direct_import_decl_export_tag(
    context_value.source,
    index,
    kind
  );
  DirectImportDeclFacts {
    kind_tag,
    declaration_name_hash,
    export_name_hash: direct_import_decl_export_name_hash(
      context_value.source,
      index,
      export_tag
    ),
    param_count,
    declared_type_class: type_facts.declared_type_class,
    declared_type_payload: type_facts.declared_type_payload,
    declared_abi_class: direct_import_decl_declared_abi_class(
      kind,
      type_facts.declared_type_class
    ),
    expected_body_type_class: type_facts.expected_body_type_class,
    actual_body_type_class,
    body_check_status,
    export_tag,
  }
}

fn Context::type_environment_signature(context_value: Context) -> i32 {
  monad.Reader::run(type_environment_signature_reader(), context_value)
}

fn Context::resolved_declared_type_class_signature(context_value: Context) -> i32 {
  monad.Reader::run(resolved_declared_type_class_signature_reader(), context_value)
}

fn Context::resolved_declared_abi_class_signature(context_value: Context) -> i32 {
  monad.Reader::run(resolved_declared_abi_class_signature_reader(), context_value)
}

fn Context::resolved_value_body_type_class_signature(
  context_value: Context
) -> i32 {
  monad.Reader::run(resolved_value_body_type_class_signature_reader(), context_value)
}

fn Context::resolved_value_body_abi_class_signature(
  context_value: Context
) -> i32 {
  monad.Reader::run(resolved_value_body_abi_class_signature_reader(), context_value)
}

fn Context::resolved_simple_body_type_check_signature(
  context_value: Context
) -> i32 {
  monad.Reader::run(resolved_simple_body_type_check_signature_reader(), context_value)
}

fn Context::resolved_symbol_environment_signature(context_value: Context) -> i32 {
  monad.Reader::run(resolved_symbol_environment_signature_reader(), context_value)
}

fn Context::resolved_export_abi_signature(context_value: Context) -> i32 {
  monad.Reader::run(resolved_export_abi_signature_reader(), context_value)
}

fn signature_metric_value(
  metric: SignatureMetric,
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  module_hash: i32
) -> i32 {
  match metric {
    TypeEnvironmentSignature =>
      parser.text_direct_import_type_environment_signature(
        source,
        import_source,
        module_hash
      ),
    ResolvedDeclaredTypeClassSignature =>
      parser.text_direct_import_resolved_declared_type_class_signature(
        source,
        import_source,
        module_hash
      ),
    ResolvedDeclaredAbiClassSignature =>
      parser.text_direct_import_resolved_declared_abi_class_signature(
        source,
        import_source,
        module_hash
      ),
    ResolvedValueBodyTypeClassSignature =>
      parser.text_direct_import_resolved_value_body_type_class_signature(
        source,
        import_source,
        module_hash
      ),
    ResolvedValueBodyAbiClassSignature =>
      parser.text_direct_import_resolved_value_body_abi_class_signature(
        source,
        import_source,
        module_hash
      ),
    ResolvedSimpleBodyTypeCheckSignature =>
      parser.text_direct_import_resolved_simple_body_type_check_signature(
        source,
        import_source,
        module_hash
      ),
    ResolvedSymbolEnvironmentSignature =>
      parser.text_direct_import_resolved_symbol_environment_signature(
        source,
        import_source,
        module_hash
      ),
    ResolvedExportAbiSignature =>
      parser.text_direct_import_resolved_export_abi_signature(
        source,
        import_source,
        module_hash
      ),
  }
}

fn signature_reader(metric: SignatureMetric) -> monad.Reader(Context, i32) {
  do @monad(monad.Reader(Context, _)) {
    source <- monad.Reader::asks(context_source);
    import_source <- monad.Reader::asks(context_import_source);
    module_hash <- monad.Reader::asks(context_module_hash);
    monad.Reader::pure(signature_metric_value(
      metric,
      source,
      import_source,
      module_hash
    ))
  }
}

fn type_environment_signature_reader() -> monad.Reader(Context, i32) {
  signature_reader(TypeEnvironmentSignature)
}

fn resolved_declared_type_class_signature_reader() -> monad.Reader(Context, i32) {
  signature_reader(ResolvedDeclaredTypeClassSignature)
}

fn resolved_declared_abi_class_signature_reader() -> monad.Reader(Context, i32) {
  signature_reader(ResolvedDeclaredAbiClassSignature)
}

fn resolved_value_body_type_class_signature_reader() -> monad.Reader(
  Context,
  i32
) {
  signature_reader(ResolvedValueBodyTypeClassSignature)
}

fn resolved_value_body_abi_class_signature_reader() -> monad.Reader(
  Context,
  i32
) {
  signature_reader(ResolvedValueBodyAbiClassSignature)
}

fn resolved_simple_body_type_check_signature_reader() -> monad.Reader(
  Context,
  i32
) {
  signature_reader(ResolvedSimpleBodyTypeCheckSignature)
}

fn resolved_symbol_environment_signature_reader() -> monad.Reader(Context, i32) {
  signature_reader(ResolvedSymbolEnvironmentSignature)
}

fn resolved_export_abi_signature_reader() -> monad.Reader(Context, i32) {
  signature_reader(ResolvedExportAbiSignature)
}

fn resolution_record_reader(
  alias_hash: i32
) -> monad.Reader(Context, ResolutionRecord) {
  do @monad(monad.Reader(Context, _)) {
    module_hash <- monad.Reader::asks(context_module_hash);
    type_environment_signature <- type_environment_signature_reader();
    resolved_declared_type_signature <- resolved_declared_type_class_signature_reader();
    resolved_declared_abi_signature <- resolved_declared_abi_class_signature_reader();
    resolved_value_body_type_signature <- resolved_value_body_type_class_signature_reader();
    resolved_value_body_abi_signature <- resolved_value_body_abi_class_signature_reader();
    resolved_simple_body_type_check_signature <- resolved_simple_body_type_check_signature_reader();
    resolved_symbol_environment_signature <- resolved_symbol_environment_signature_reader();
    resolved_export_abi_signature <- resolved_export_abi_signature_reader();
    monad.Reader::pure(
      ResolutionRecord {
        module_hash,
        alias_hash,
        type_environment_signature,
        resolved_declared_type_signature,
        resolved_declared_abi_signature,
        resolved_value_body_type_signature,
        resolved_value_body_abi_signature,
        resolved_simple_body_type_check_signature,
        resolved_symbol_environment_signature,
        resolved_export_abi_signature,
      }
    )
  }
}

fn resolution_record_hash(
  record: ResolutionRecord
) -> i32 {
  let with_module = textmodel.signature_mix(73, record.module_hash);
  let with_alias = textmodel.signature_mix(with_module, record.alias_hash);
  let with_type_env = textmodel.signature_mix(
    with_alias,
    record.type_environment_signature
  );
  let with_resolved_type = textmodel.signature_mix(
    with_type_env,
    record.resolved_declared_type_signature
  );
  let with_resolved_abi = textmodel.signature_mix(
    with_resolved_type,
    record.resolved_declared_abi_signature
  );
  let with_value_body_type = textmodel.signature_mix(
    with_resolved_abi,
    record.resolved_value_body_type_signature
  );
  let with_value_body_abi = textmodel.signature_mix(
    with_value_body_type,
    record.resolved_value_body_abi_signature
  );
  let with_simple_body_check = textmodel.signature_mix(
    with_value_body_abi,
    record.resolved_simple_body_type_check_signature
  );
  let with_symbol_environment = textmodel.signature_mix(
    with_simple_body_check,
    record.resolved_symbol_environment_signature
  );
  textmodel.signature_mix(
    with_symbol_environment,
    record.resolved_export_abi_signature
  )
}

fn Context::record(context_value: Context, alias_hash: i32) -> ResolutionRecord {
  let resolution = parser.TextResolutionEnv::from_direct_import(
    context_value.source,
    context_value.import_source,
    alias_hash
  );
  let type_context = parser.text_direct_import_context_from_resolution(
    context_value.source,
    context_value.import_source,
    textmodel.ImportResolutionMode::TypeClass,
    alias_hash,
    resolution
  );
  let scan = Context::resolution_record_scan(
    context_value,
    type_context,
    resolution_record_scan_start(context_value.source)
  );
  ResolutionRecord {
    module_hash: context_value.module_hash,
    alias_hash,
    type_environment_signature: Context::type_environment_signature(context_value),
    resolved_declared_type_signature: scan.resolved_declared_type_signature,
    resolved_declared_abi_signature: scan.resolved_declared_abi_signature,
    resolved_value_body_type_signature: scan.resolved_value_body_type_signature,
    resolved_value_body_abi_signature: scan.resolved_value_body_abi_signature,
    resolved_simple_body_type_check_signature:
      scan.resolved_simple_body_type_check_signature,
    resolved_symbol_environment_signature: scan.resolved_symbol_environment_signature,
    resolved_export_abi_signature: scan.resolved_export_abi_signature,
  }
}

fn resolution_record_scan_start(
  source: textlex.TextTokenStream
) -> ResolutionRecordScan {
  ResolutionRecordScan {
    current: textmodel.full_window_state(source),
    resolved_declared_type_signature: 0,
    resolved_declared_abi_signature: 0,
    resolved_value_body_type_signature: 0,
    resolved_value_body_abi_signature: 0,
    resolved_simple_body_type_check_signature: 0,
    resolved_symbol_environment_signature: 0,
    resolved_export_abi_signature: 0,
  }
}

fn Context::resolution_record_scan(
  context_value: Context,
  type_context: parser.TextDirectImportContext,
  scan: ResolutionRecordScan
) -> ResolutionRecordScan {
  if combinator.state_has_more(scan.current) {
    match parser.parse_text_declaration_stream(
      scan.current,
      context_value.source,
      scan.resolved_declared_type_signature
    ) {
      Err(_) => scan,
      Ok(result) => rec(
        context_value,
        type_context,
        Context::resolution_record_scan_advance(
          context_value,
          type_context,
          scan,
          result
        )
      ),
    }
  } else {
    scan
  }
}

fn Context::resolution_record_scan_advance(
  context_value: Context,
  type_context: parser.TextDirectImportContext,
  scan: ResolutionRecordScan,
  result: combinator.Reply(parser.DeclFrame)
) -> ResolutionRecordScan {
  let index = scan.current.cursor;
  let current = parser.next_text_declaration_state(result.state, context_value.source);
  if parser.is_text_external_import_start(context_value.source, index) {
    ResolutionRecordScan {
      current,
      resolved_declared_type_signature: scan.resolved_declared_type_signature,
      resolved_declared_abi_signature: scan.resolved_declared_abi_signature,
      resolved_value_body_type_signature: scan.resolved_value_body_type_signature,
      resolved_value_body_abi_signature: scan.resolved_value_body_abi_signature,
      resolved_simple_body_type_check_signature:
        scan.resolved_simple_body_type_check_signature,
      resolved_symbol_environment_signature: scan.resolved_symbol_environment_signature,
      resolved_export_abi_signature: scan.resolved_export_abi_signature,
    }
  } else {
    Context::resolution_record_scan_advance_decl(
      context_value,
      type_context,
      scan,
      result,
      index,
      current
    )
  }
}

fn Context::resolution_record_scan_advance_decl(
  context_value: Context,
  type_context: parser.TextDirectImportContext,
  scan: ResolutionRecordScan,
  result: combinator.Reply(parser.DeclFrame),
  index: i32,
  current: combinator.ParseState
) -> ResolutionRecordScan {
  let decl = result.value.decl;
  let facts = direct_import_decl_facts(
    context_value,
    type_context,
    index,
    decl
  );
  ResolutionRecordScan {
    current,
    resolved_declared_type_signature:
      textmodel.signature_mix(
        scan.resolved_declared_type_signature,
        parser.text_declared_type_class_hash(
          facts.kind_tag,
          facts.declared_type_class,
          facts.declared_type_payload
        )
      ),
    resolved_declared_abi_signature:
      textmodel.signature_mix(
        scan.resolved_declared_abi_signature,
        parser.text_declared_abi_class_hash(
          facts.kind_tag,
          facts.declared_abi_class
        )
      ),
    resolved_value_body_type_signature:
      textmodel.signature_mix(
        scan.resolved_value_body_type_signature,
        parser.text_value_body_type_class_hash(
          facts.kind_tag,
          facts.actual_body_type_class
        )
      ),
    resolved_value_body_abi_signature:
      textmodel.signature_mix(
        scan.resolved_value_body_abi_signature,
        parser.text_value_body_abi_class_hash(
          facts.kind_tag,
          parser.text_abi_class_tag_for_type_class(facts.actual_body_type_class)
        )
      ),
    resolved_simple_body_type_check_signature:
      textmodel.signature_mix(
        scan.resolved_simple_body_type_check_signature,
        parser.text_simple_body_type_check_hash(
          facts.kind_tag,
          facts.expected_body_type_class,
          facts.actual_body_type_class,
          facts.body_check_status
        )
      ),
    resolved_symbol_environment_signature:
      textmodel.signature_mix(
        scan.resolved_symbol_environment_signature,
        parser.text_symbol_environment_hash(
          facts.kind_tag,
          facts.declaration_name_hash,
          facts.declared_type_class,
          facts.declared_type_payload,
          facts.declared_abi_class
        )
    ),
    resolved_export_abi_signature:
      if direct_import_export_is_enabled(facts.export_tag) {
        textmodel.signature_mix(
          scan.resolved_export_abi_signature,
          parser.text_export_abi_hash(
            facts.export_name_hash,
            facts.param_count,
            parser.text_abi_class_tag_for_type_class(
              facts.expected_body_type_class
            )
          )
        )
      } else {
        scan.resolved_export_abi_signature
      },
  }
}

fn direct_import_alias_is_present(alias_hash: i32) -> bool {
  alias_hash != 0
}

fn Context::resolution_record_signature(context_value: Context) -> i32 {
  let alias_hash = parser.text_direct_import_alias_hash(
    context_value.source,
    context_value.module_hash
  );
  if direct_import_alias_is_present(alias_hash) {
    resolution_record_hash(Context::record(context_value, alias_hash))
  } else {
    0
  }
}

fn type_environment_signature(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  module_hash: i32
) -> i32 {
  Context::type_environment_signature(context(source, import_source, module_hash))
}

fn resolved_declared_type_class_signature(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  module_hash: i32
) -> i32 {
  Context::resolved_declared_type_class_signature(
    context(source, import_source, module_hash)
  )
}

fn resolved_declared_abi_class_signature(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  module_hash: i32
) -> i32 {
  Context::resolved_declared_abi_class_signature(
    context(source, import_source, module_hash)
  )
}

fn resolved_value_body_type_class_signature(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  module_hash: i32
) -> i32 {
  Context::resolved_value_body_type_class_signature(
    context(source, import_source, module_hash)
  )
}

fn resolved_value_body_abi_class_signature(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  module_hash: i32
) -> i32 {
  Context::resolved_value_body_abi_class_signature(
