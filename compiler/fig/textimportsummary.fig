const parser = @import("./parser.fig");
const textlex = @import("./textlex.fig");
const textmodel = @import("./textmodel.fig");
const monad = @import("prelude.monad");
const operators = @import("prelude.operators");

type Context = struct {
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  module_hash: i32,
}

type SignatureMetric = union {
  TypeEnvironmentSignature, ResolvedDeclaredTypeClassSignature,
  ResolvedDeclaredAbiClassSignature, ResolvedValueBodyTypeClassSignature,
  ResolvedValueBodyAbiClassSignature, ResolvedSimpleBodyTypeCheckSignature,
  ResolvedSymbolEnvironmentSignature, ResolvedExportAbiSignature
}

type ResolutionRecord = struct {
  module_hash: i32,
  alias_hash: i32,
  type_environment_signature: i32,
  resolved_declared_type_signature: i32,
  resolved_declared_abi_signature: i32,
  resolved_value_body_type_signature: i32,
  resolved_value_body_abi_signature: i32,
  resolved_simple_body_type_check_signature: i32,
  resolved_symbol_environment_signature: i32,
  resolved_export_abi_signature: i32,
}

fn context(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  module_hash: i32
) -> Context {
  Context {
    source: source,
    import_source: import_source,
    module_hash: module_hash,
  }
}

fn context_source(context_value: Context) -> textlex.TextTokenStream {
  context_value.source
}

fn context_import_source(context_value: Context) -> textlex.TextTokenStream {
  context_value.import_source
}

fn context_module_hash(context_value: Context) -> i32 {
  context_value.module_hash
}

fn Context::type_environment_signature(context_value: Context) -> i32 {
  monad.Reader::run(type_environment_signature_reader(), context_value)
}

fn Context::resolved_declared_type_class_signature(context_value: Context) -> i32 {
  monad.Reader::run(resolved_declared_type_class_signature_reader(), context_value)
}

fn Context::resolved_declared_abi_class_signature(context_value: Context) -> i32 {
  monad.Reader::run(resolved_declared_abi_class_signature_reader(), context_value)
}

fn Context::resolved_value_body_type_class_signature(
  context_value: Context
) -> i32 {
  monad.Reader::run(resolved_value_body_type_class_signature_reader(), context_value)
}

fn Context::resolved_value_body_abi_class_signature(
  context_value: Context
) -> i32 {
  monad.Reader::run(resolved_value_body_abi_class_signature_reader(), context_value)
}

fn Context::resolved_simple_body_type_check_signature(
  context_value: Context
) -> i32 {
  monad.Reader::run(resolved_simple_body_type_check_signature_reader(), context_value)
}

fn Context::resolved_symbol_environment_signature(context_value: Context) -> i32 {
  monad.Reader::run(resolved_symbol_environment_signature_reader(), context_value)
}

fn Context::resolved_export_abi_signature(context_value: Context) -> i32 {
  monad.Reader::run(resolved_export_abi_signature_reader(), context_value)
}

fn signature_metric_value(
  metric: SignatureMetric,
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  module_hash: i32
) -> i32 {
  match metric {
    TypeEnvironmentSignature =>
      parser.text_direct_import_type_environment_signature(
        source,
        import_source,
        module_hash
      ),
    ResolvedDeclaredTypeClassSignature =>
      parser.text_direct_import_resolved_declared_type_class_signature(
        source,
        import_source,
        module_hash
      ),
    ResolvedDeclaredAbiClassSignature =>
      parser.text_direct_import_resolved_declared_abi_class_signature(
        source,
        import_source,
        module_hash
      ),
    ResolvedValueBodyTypeClassSignature =>
      parser.text_direct_import_resolved_value_body_type_class_signature(
        source,
        import_source,
        module_hash
      ),
    ResolvedValueBodyAbiClassSignature =>
      parser.text_direct_import_resolved_value_body_abi_class_signature(
        source,
        import_source,
        module_hash
      ),
    ResolvedSimpleBodyTypeCheckSignature =>
      parser.text_direct_import_resolved_simple_body_type_check_signature(
        source,
        import_source,
        module_hash
      ),
    ResolvedSymbolEnvironmentSignature =>
      parser.text_direct_import_resolved_symbol_environment_signature(
        source,
        import_source,
        module_hash
      ),
    ResolvedExportAbiSignature =>
      parser.text_direct_import_resolved_export_abi_signature(
        source,
        import_source,
        module_hash
      ),
  }
}

fn signature_reader(metric: SignatureMetric) -> monad.Reader(Context, i32) {
  do @monad(monad.Reader(Context, _)) {
    source <- monad.Reader::asks(context_source);
    import_source <- monad.Reader::asks(context_import_source);
    module_hash <- monad.Reader::asks(context_module_hash);
    monad.Reader::pure(signature_metric_value(
      metric,
      source,
      import_source,
      module_hash
    ))
  }
}

fn type_environment_signature_reader() -> monad.Reader(Context, i32) {
  signature_reader(TypeEnvironmentSignature)
}

fn resolved_declared_type_class_signature_reader() -> monad.Reader(Context, i32) {
  signature_reader(ResolvedDeclaredTypeClassSignature)
}

fn resolved_declared_abi_class_signature_reader() -> monad.Reader(Context, i32) {
  signature_reader(ResolvedDeclaredAbiClassSignature)
}

fn resolved_value_body_type_class_signature_reader() -> monad.Reader(
  Context,
  i32
) {
  signature_reader(ResolvedValueBodyTypeClassSignature)
}

fn resolved_value_body_abi_class_signature_reader() -> monad.Reader(
  Context,
  i32
) {
  signature_reader(ResolvedValueBodyAbiClassSignature)
}

fn resolved_simple_body_type_check_signature_reader() -> monad.Reader(
  Context,
  i32
) {
  signature_reader(ResolvedSimpleBodyTypeCheckSignature)
}

fn resolved_symbol_environment_signature_reader() -> monad.Reader(Context, i32) {
  signature_reader(ResolvedSymbolEnvironmentSignature)
}

fn resolved_export_abi_signature_reader() -> monad.Reader(Context, i32) {
  signature_reader(ResolvedExportAbiSignature)
}

fn resolution_record_reader(
  alias_hash: i32
) -> monad.Reader(Context, ResolutionRecord) {
  do @monad(monad.Reader(Context, _)) {
    module_hash <- monad.Reader::asks(context_module_hash);
    type_environment_signature <- type_environment_signature_reader();
    resolved_declared_type_signature <- resolved_declared_type_class_signature_reader();
    resolved_declared_abi_signature <- resolved_declared_abi_class_signature_reader();
    resolved_value_body_type_signature <- resolved_value_body_type_class_signature_reader();
    resolved_value_body_abi_signature <- resolved_value_body_abi_class_signature_reader();
    resolved_simple_body_type_check_signature <- resolved_simple_body_type_check_signature_reader();
    resolved_symbol_environment_signature <- resolved_symbol_environment_signature_reader();
    resolved_export_abi_signature <- resolved_export_abi_signature_reader();
    monad.Reader::pure(
      ResolutionRecord {
        module_hash,
        alias_hash,
        type_environment_signature,
        resolved_declared_type_signature,
        resolved_declared_abi_signature,
        resolved_value_body_type_signature,
        resolved_value_body_abi_signature,
        resolved_simple_body_type_check_signature,
        resolved_symbol_environment_signature,
        resolved_export_abi_signature,
      }
    )
  }
}

fn resolution_record_hash(
  record: ResolutionRecord
) -> i32 {
  let with_module = textmodel.signature_mix(73, record.module_hash);
  let with_alias = textmodel.signature_mix(with_module, record.alias_hash);
  let with_type_env = textmodel.signature_mix(
    with_alias,
    record.type_environment_signature
  );
  let with_resolved_type = textmodel.signature_mix(
    with_type_env,
    record.resolved_declared_type_signature
  );
  let with_resolved_abi = textmodel.signature_mix(
    with_resolved_type,
    record.resolved_declared_abi_signature
  );
  let with_value_body_type = textmodel.signature_mix(
    with_resolved_abi,
    record.resolved_value_body_type_signature
  );
  let with_value_body_abi = textmodel.signature_mix(
    with_value_body_type,
    record.resolved_value_body_abi_signature
  );
  let with_simple_body_check = textmodel.signature_mix(
    with_value_body_abi,
    record.resolved_simple_body_type_check_signature
  );
  let with_symbol_environment = textmodel.signature_mix(
    with_simple_body_check,
    record.resolved_symbol_environment_signature
  );
  textmodel.signature_mix(
    with_symbol_environment,
    record.resolved_export_abi_signature
  )
}

fn Context::record(context_value: Context, alias_hash: i32) -> ResolutionRecord {
  monad.Reader::run(resolution_record_reader(alias_hash), context_value)
}

fn Context::resolution_record_signature(context_value: Context) -> i32 {
  let alias_hash = parser.text_direct_import_alias_hash(
    context_value.source,
    context_value.module_hash
  );
  match alias_hash == 0 {
    true => 0,
    false => resolution_record_hash(Context::record(context_value, alias_hash)),
  }
}

fn type_environment_signature(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  module_hash: i32
) -> i32 {
  Context::type_environment_signature(context(source, import_source, module_hash))
}

fn resolved_declared_type_class_signature(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  module_hash: i32
) -> i32 {
  Context::resolved_declared_type_class_signature(
    context(source, import_source, module_hash)
  )
}

fn resolved_declared_abi_class_signature(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  module_hash: i32
) -> i32 {
  Context::resolved_declared_abi_class_signature(
    context(source, import_source, module_hash)
  )
}

fn resolved_value_body_type_class_signature(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  module_hash: i32
) -> i32 {
  Context::resolved_value_body_type_class_signature(
    context(source, import_source, module_hash)
  )
}

fn resolved_value_body_abi_class_signature(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  module_hash: i32
) -> i32 {
  Context::resolved_value_body_abi_class_signature(
    context(source, import_source, module_hash)
  )
}

fn resolved_simple_body_type_check_signature(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  module_hash: i32
) -> i32 {
  Context::resolved_simple_body_type_check_signature(
    context(source, import_source, module_hash)
  )
}

fn resolved_symbol_environment_signature(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  module_hash: i32
) -> i32 {
  Context::resolved_symbol_environment_signature(
    context(source, import_source, module_hash)
  )
}

fn resolved_export_abi_signature(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  module_hash: i32
) -> i32 {
  Context::resolved_export_abi_signature(
    context(source, import_source, module_hash)
  )
}

fn resolution_record_signature(
  source: textlex.TextTokenStream,
  import_source: textlex.TextTokenStream,
  module_hash: i32
) -> i32 {
  Context::resolution_record_signature(
    context(source, import_source, module_hash)
  )
}

fn entry(seed: i32) -> i32 {
  seed + 1
}
