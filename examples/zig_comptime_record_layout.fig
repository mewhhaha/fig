const operators = @import("prelude.operators");

// Zig-style comptime reflection: derive a compact runtime descriptor from a
// source record's slots and reject unsupported shapes at compile time.
type Payload = struct {id: i32, score: i32, debug: bool}

type fn KeepRuntimeSlot(key: const, _value: const) -> type {
  match key {
    #id => true,
    #score => true,
    _ => false,
  }
}

type fn DescriptorSlot(key: const, value: const) -> type {
  match key {
    #id => value,
    #score => value,
    _ => i32,
  }
}

type fn RuntimeDescriptor(row: type) -> type {
  let Slots = @type_slots(row);
  let RuntimeSlots = @shape_filter(
    Slots,
    KeepRuntimeSlot
  );
  let CheckedSlots = @shape_map_with_key(
    RuntimeSlots,
    DescriptorSlot
  );
  let Layout = @shape_concat(
    {field_count: i32},
    CheckedSlots
  );
  let RuntimeDescriptor = {field_count: i32, id: i32, score: i32};
  @require(
    @shape_count(RuntimeSlots) == 2,
    "descriptor expects two runtime slots"
  );
  @require(
    @shape_slot(RuntimeSlots, #id) == i32,
    "id must stay i32"
  );
  @require(
    @shape_slot(RuntimeSlots, #score) == i32,
    "score must stay i32"
  );
  @require(
    @shape_has_slot(Layout, #field_count),
    "layout has field count"
  );
  @require(
    @shape_has_slot(Layout, #id),
    "layout has id"
  );
  @require(
    @shape_has_slot(Layout, #score),
    "layout has score"
  );
  struct(RuntimeDescriptor)
}

fn descriptor() -> RuntimeDescriptor(Payload) {
  {field_count: 2, id: 11, score: 24}
}

pub fn main() -> i32 {
  let layout = descriptor();
  layout.field_count + layout.id + layout.score
}
