const merge = @import("prelude.std");

fn inc(x: i32) -> i32 {
  x + 1
}

fn ok(value: i32) -> result(i32, i32) {
  value
}

pub fn main() -> i32 {
  let xs: merge.array.layout.lane4_i32 = <1, 2, 3, 4>;
  let ones_a: merge.array.layout.lane4_i32 = <1, 1, 1, 1>;
  let ones_b: merge.array.layout.lane4_i32 = <1, 1, 1, 1>;
  let result_value: result(i32, i32) = ok(
    lane4_dot_i32(lane4_add_i32(map4_i32(inc, xs), ones_a), ones_b)
  );
  4 + 4 + 1
}
