const merge = @import("prelude.std");
const array = @import("prelude.array_static");
const layout = @import("prelude.layout");

fn inc(x: i32) -> i32 {
  x + 1
}

fn ok(value: i32) -> Result(i32, i32) {
  value
}

pub fn main() -> i32 {
  let xs: layout.Lane4I32 = #[1, 2, 3, 4];
  let ones_a: layout.Lane4I32 = #[1, 1, 1, 1];
  let ones_b: layout.Lane4I32 = #[1, 1, 1, 1];
  let result_value: Result(i32, i32) = ok(
    array.lane4_dot_i32(array.lane4_add_i32(array.map4_i32(inc, xs), ones_a), ones_b)
  );
  4 + 4 + 1
}
