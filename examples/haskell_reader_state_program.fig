const monad = @import("prelude.monad");

type fn Config() -> type {
  let Config = {start: i32, step: i32};
  struct(Config)
}

type fn Counter() -> type {
  let Counter = {count: i32};
  struct(Counter)
}

fn read_step() -> monad.Reader(Config, i32) {
  do @monad(monad.Reader(Config, _)) {
    config <- monad.Reader::ask();
    pure(config.step)
  }
}

fn add_step(step: i32) -> monad.State(Counter, Counter) {
  do @monad(monad.State(Counter, _)) {
    current <- monad.State::get();
    let next = Counter {count: current.count + step};
    monad.State::put(next);
    monad.State::get()
  }
}

fn configured_counter(config: Config) -> monad.State(Counter, Counter) {
  let step = read_step()
    \program -> monad.Reader::run(program, config);
  add_step(step)
}

pub fn main() -> i32 {
  let config = Config {start: 35, step: 7};
  let final = configured_counter(config)
    \program -> monad.State::eval(program, Counter {count: config.start});
  final.count
}
