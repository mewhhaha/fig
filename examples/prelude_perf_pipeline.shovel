module demo.prelude_perf_pipeline;

import module prelude.array_static;
import module prelude.schedule;

fn add(a: i32, b: i32) -> i32 {
  a + b
}

fn inc(x: i32) -> i32 {
  x + 1
}

pub fn main() -> i32 {
  let schedule_tile: tile2x4 = [rows: 2, cols: 4];
  let schedule_vector: vectorize4 = [lanes: 4];
  let schedule_unroll: unroll4 = [factor: 4];
  let lanes = map4_i32(inc, [1, 2, 3, 4]);
  fold4_i32(add, schedule_tile.rows + schedule_vector.lanes + schedule_unroll.factor, lanes)
}
