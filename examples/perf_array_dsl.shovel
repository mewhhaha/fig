module demo.perf_array_dsl;

// Futhark/Dex-inspired source API sketch for regular fixed-size arrays.
// Helpers are ergonomic names over explicit inline layouts, not imported DSL primitives.

type fn inline_array(N: count, A: type) -> type {
  let InlineArray = [N*A];
  struct(InlineArray)
}

type fn lane4_i32() -> type {
  inline_array(4, i32)
}

type fn tile2x4_i32() -> type {
  inline_array(2, lane4_i32)
}

type fn tensor2x2_i32() -> type {
  inline_array(2, inline_array(2, i32))
}

type fn lane_map_i32(T: type) -> type {
  let LaneMapI32 = [map: fn(x: T) -> T];
  struct(LaneMapI32)
}

fn add1_i32(x: i32) -> i32 {
  x + 1
}

fn add1_lane(x: lane4_i32) -> lane4_i32 {
  [add1_i32(x[0]), add1_i32(x[1]), add1_i32(x[2]), add1_i32(x[3])]
}

const i32x4_map: lane_map_i32(lane4_i32) = [map: add1_lane];

fn map_lane4(const ops: lane_map_i32(lane4_i32), xs: lane4_i32) -> lane4_i32 {
  ops.map(xs)
}

fn map_tile2x4(const ops: lane_map_i32(lane4_i32), tile: tile2x4_i32) -> tile2x4_i32 {
  [ops.map(tile[0]), ops.map(tile[1])]
}

fn dot2x2(lhs: tensor2x2_i32, rhs: tensor2x2_i32) -> i32 {
  lhs[0][0] * rhs[0][0] + lhs[0][1] * rhs[0][1] + lhs[1][0] * rhs[1][0] + lhs[1][1] * rhs[1][1]
}

pub fn main() -> i32 {
  let lane: lane4_i32 = [1, 2, 3, 4];
  let tile: tile2x4_i32 = [lane, [5, 6, 7, 8]];
  let mapped = map_tile2x4(i32x4_map, tile);
  let lhs: tensor2x2_i32 = [[1, 2], [3, 4]];
  let rhs: tensor2x2_i32 = [[5, 6], [7, 8]];
  mapped[0][0] + mapped[1][3] + dot2x2(lhs, rhs)
}
