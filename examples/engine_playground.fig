const merge = @import("prelude.geometry2d");
const ecs = @import("engine.ecs");
const tick_millis: fn() -> i32 !{time} = @capability("tick_millis");
const input_axis_x: fn() -> i32 !{event} = @capability("input_axis_x");
const input_pressed: fn() -> i32 !{event} = @capability("input_pressed");

type fn Player2d() -> type {
  let Player2d = {tag: i32};
  struct(Player2d)
}

type fn Enemy2d() -> type {
  let Enemy2d = {
    tag: i32
  };
  struct(Enemy2d)
}

type fn Transform2d() -> type {
  let Transform2d = {
    x: i32,
    y: i32,
    z: i32
  };
  struct(Transform2d)
}

type fn Velocity2d() -> type {
  let Velocity2d = {
    x: i32,
    y: i32
  };
  struct(Velocity2d)
}

type fn Sprite2d() -> type {
  let Sprite2d = {
    w: i32,
    h: i32,
    color: i32
  };
  struct(Sprite2d)
}

type fn PlaygroundEvents() -> type {
  let PlaygroundEvents = {
    dt_ms: i32,
    axis_x: i32,
    pressed: i32
  };
  struct(PlaygroundEvents)
}

const game_components = {
  player: Player2d,
  enemy: Enemy2d,
  transform: Transform2d,
  velocity: Velocity2d,
  sprite: Sprite2d,
}
;
const movement_reads = {
  transform: Transform2d,
  velocity: Velocity2d,
}
;
const movement_writes = {
  transform: Transform2d,
}
;
const render_reads = {
  transform: Transform2d,
  sprite: Sprite2d,
}

;

type fn PlaygroundWorld() -> type {
  ecs.SparseWorld(3, game_components)
}

fn seed_world() -> PlaygroundWorld {
  ecs.SparseWorld.empty(game_components)
    \w -> ecs.entity.add(
    w,
    {
      player: Player2d {
        tag: 1
      },
      transform: Transform2d {
        x: 12,
        y: 8,
        z: 1
      },
      velocity: Velocity2d {
        x: 4,
        y: 0
      },
      sprite: Sprite2d {
        w: 16,
        h: 16,
        color: 1
      }
    }
  )
    \w -> ecs.entity.add(
    w,
    {
      enemy: Enemy2d {
        tag: 1
      },
      transform: Transform2d {
        x: 24,
        y: 8,
        z: 1
      },
      velocity: Velocity2d {
        x: 0,
        y: 0
      },
      sprite: Sprite2d {
        w: 16,
        h: 16,
        color: 2
      }
    }
  )
    \w -> ecs.entity.add(
    w,
    {
      enemy: Enemy2d {
        tag: 2
      },
      transform: Transform2d {
        x: 40,
        y: 8,
        z: 1
      },
      sprite: Sprite2d {
        w: 16,
        h: 16,
        color: 3
      }
    }
  )
}

fn move_transform(
  transform: Transform2d,
  velocity: Velocity2d,
  events: &(playground_events)
) -> Transform2d {
  let speed = velocity.x + Events.pressed;
  let dx = Events.axis_x * speed * Events.dt_ms / 16;
  Transform2d {
    x: transform.x + dx,
    y: transform.y + velocity.y,
    z: transform.z
  }
}

fn move_row(
  row: ecs.Row(movement_reads),
  events: &(playground_events)
) -> ecs.Values(movement_writes) {
  {
    transform: move_transform(
      Row.transform,
      Row.velocity,
      events
    )
  }
}

fn movement_system(
  world: PlaygroundWorld,
  events: &(playground_events)
) -> PlaygroundWorld {
  ecs.each(world, events, move_row)
}

fn velocity_system(
  world: PlaygroundWorld,
  events: &(playground_events)
) -> PlaygroundWorld {
  world
}

fn render_components(
  transform: Transform2d,
  sprite: Sprite2d
) -> merge.Geometry2dBatch3I32 {
  merge.emit_rect2d_batch3(
    transform.x,
    transform.y,
    sprite.w,
    sprite.h,
    transform.z,
    sprite.color
  )
}

fn render_row(
  acc: merge.Geometry2dBatch3I32,
  row: ecs.Row(render_reads)
) -> merge.Geometry2dBatch3I32 {
  merge.append_geometry2d_batch3(
    acc,
    render_components(Row.transform, Row.sprite)
  )
}

fn render_system(world: PlaygroundWorld) -> merge.Geometry2dBatch3I32 {
  ecs.fold(
    world,
    merge.empty_geometry2d_batch3(),
    render_row
  )
}

fn run_frame() -> merge.Geometry2dBatch3I32 !{time, event} {
  let dt_ms = tick_millis();
  let axis_x = input_axis_x();
  let pressed = input_pressed();
  let events: PlaygroundEvents = PlaygroundEvents {
    dt_ms: dt_ms,
    axis_x: axis_x,
    pressed: pressed
  };
  seed_world()
    \w -> ecs.run(w, & events, movement_system)
    \w -> ecs.run(w, & events, velocity_system)
    \w -> render_system(w)
}

pub fn main() -> merge.Geometry2dBatch3I32 !{time, event} {
  run_frame()
}

pub fn playground_probe() -> i32 !{time, event} {
  let geometry = run_frame();
  Geometry.vertex_count
}
