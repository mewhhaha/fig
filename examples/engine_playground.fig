const geometry = @import("prelude.geometry2d");

const tick_millis: fn() -> i32 !{time} = @capability("tick_millis");
const input_axis_x: fn() -> i32 !{event} = @capability("input_axis_x");
const input_pressed: fn() -> i32 !{event} = @capability("input_pressed");

type fn Transform2d() -> type {
  let Transform2d = {x: i32, y: i32, z: i32};
  struct(Transform2d)
}

type fn Velocity2d() -> type {
  let Velocity2d = {x: i32, y: i32};
  struct(Velocity2d)
}

type fn Sprite2d() -> type {
  let Sprite2d = {w: i32, h: i32, color: i32};
  struct(Sprite2d)
}

type fn MovementEvents() -> type {
  let MovementEvents = {dt_ms: i32, axis_x: i32, pressed: i32};
  struct(MovementEvents)
}

fn move_transform(
  transform: Transform2d,
  velocity: Velocity2d,
  events: MovementEvents
) -> Transform2d {
  Transform2d {
    x: transform.x + velocity.x * events.dt_ms / 16,
    y: transform.y + velocity.y * events.dt_ms / 16,
    z: transform.z,
  }
}

fn render_box(transform: Transform2d, sprite: Sprite2d) -> geometry.Geometry2dBatch3I32 {
  geometry.emit_rect2d_batch3(
    transform.x,
    transform.y,
    sprite.w,
    sprite.h,
    transform.z,
    sprite.color
  )
}

fn render_three(
  first: geometry.Geometry2dBatch3I32,
  second: geometry.Geometry2dBatch3I32,
  third: geometry.Geometry2dBatch3I32
) -> geometry.Geometry2dBatch3I32 {
  let acc0 = geometry.empty_geometry2d_batch3();
  let acc1 = geometry.append_geometry2d_batch3(acc0, first);
  let acc2 = geometry.append_geometry2d_batch3(acc1, second);
  let acc3 = geometry.append_geometry2d_batch3(acc2, third);
  {vertices: acc3.vertices, vertex_count: 12}
}

fn run_frame() -> geometry.Geometry2dBatch3I32 !{time, event} {
  let events: MovementEvents = MovementEvents {
    dt_ms: tick_millis(),
    axis_x: input_axis_x(),
    pressed: input_pressed(),
  };
  let speed = 4 + events.pressed;
  let velocity0 = Velocity2d {x: events.axis_x * speed, y: 0};
  let velocity1 = Velocity2d {x: events.axis_x * speed, y: 0};
  let transform0 = move_transform(Transform2d {x: 12, y: 8, z: 1}, velocity0, events);
  let transform1 = move_transform(Transform2d {x: 24, y: 8, z: 1}, velocity1, events);
  let transform2 = Transform2d {x: 40, y: 8, z: 1};
  render_three(
    render_box(transform0, Sprite2d {w: 16, h: 16, color: 1}),
    render_box(transform1, Sprite2d {w: 16, h: 16, color: 2}),
    render_box(transform2, Sprite2d {w: 16, h: 16, color: 3})
  )
}

pub fn main() -> geometry.Geometry2dBatch3I32 !{time, event} {
  run_frame()
}

pub fn playground_probe() -> i32 !{time, event} {
  let output = run_frame();
  output.vertex_count
}
