const merge = @import("prelude.geometry2d");
const ecs = @import("engine.ecs");

const tick_millis: fn() -> i32 !{time} = @capability("tick_millis");
const input_axis_x: fn() -> i32 !{event} = @capability("input_axis_x");
const input_pressed: fn() -> i32 !{event} = @capability("input_pressed");

type fn transform2d() -> type {
  let Transform2d = [x: i32, y: i32, z: i32];
  struct(Transform2d)
}

type fn velocity2d() -> type {
  let Velocity2d = [x: i32, y: i32];
  struct(Velocity2d)
}

type fn sprite2d() -> type {
  let Sprite2d = [w: i32, h: i32, color: i32];
  struct(Sprite2d)
}

type fn entity2d() -> type {
  let Entity2d = [transform: i32, velocity: i32, sprite: i32];
  struct(Entity2d)
}

const game_components = [
  transforms: [count: 3, component: transform2d],
  velocities: [count: 3, component: velocity2d],
  sprites: [count: 3, component: sprite2d],
];

type fn transform_store() -> type {
  ecs.component_store(3, transform2d)
}

type fn velocity_store() -> type {
  ecs.component_store(3, velocity2d)
}

type fn sprite_store() -> type {
  ecs.component_store(3, sprite2d)
}

type fn entity_store() -> type {
  ecs.component_store(3, entity2d)
}

type fn game_world() -> type {
  ecs.world2d(3, game_components, entity2d)
}

const movement_query = [
  transforms: [count: 3, component: transform2d],
  velocities: [count: 3, component: velocity2d],
];

const render_query = [
  transforms: [count: 3, component: transform2d],
  sprites: [count: 3, component: sprite2d],
];

const movement_query_token: ecs.query(game_world, movement_query) = []
const render_query_token: ecs.query(game_world, render_query) = []

fn default_components() -> ecs.component_values(game_components) {
  [
    transforms: Transform2d [x: 0, y: 0, z: 0],
    velocities: Velocity2d [x: 0, y: 0],
    sprites: Sprite2d [w: 0, h: 0, color: 0]
  ]
}

fn default_entity() -> entity2d {
  Entity2d [transform: 0, velocity: 0, sprite: 0]
}

fn make_player(refs: ecs.component_refs(game_components)) -> entity2d {
  Entity2d [transform: refs.transforms, velocity: refs.velocities, sprite: refs.sprites]
}

fn make_renderable(refs: ecs.component_refs(game_components)) -> entity2d {
  Entity2d [transform: refs.transforms, velocity: refs.velocities, sprite: refs.sprites]
}

fn seed_world() -> game_world {
  let empty = ecs.world2d.empty(3, game_components, default_entity(), default_components());
  let cmd0 = ecs.command.add_entity(
    empty,
    game_components,
    default_components(),
    make_player
  );
  let cmd1 = ecs.command.add_entity(
    cmd0.world,
    render_query,
    [
      transforms: Transform2d [x: 8, y: 8, z: 1],
      sprites: Sprite2d [w: 16, h: 16, color: 1]
    ],
    make_renderable
  );
  let cmd2 = ecs.command.add_entity(
    cmd1.world,
    render_query,
    [
      transforms: Transform2d [x: 24, y: 8, z: 1],
      sprites: Sprite2d [w: 16, h: 16, color: 2]
    ],
    make_renderable
  );
  cmd2.world
}


fn move_transform(transform: transform2d, velocity: velocity2d, dt_ms: i32, axis_x: i32, pressed: i32) -> transform2d {
  let speed = velocity.x + pressed;
  let dx = axis_x * speed * dt_ms / 16;
  Transform2d [x: transform.x + dx, y: transform.y + velocity.y, z: transform.z]
}

fn update_movement_row(row: ecs.query_row(entity2d, movement_query)) -> ecs.component_values(movement_query) {
  [
    transforms: move_transform(row.transforms, row.velocities, 16, 1, 0),
    velocities: row.velocities
  ]
}

fn movement_system(
  const _query: ecs.query(game_world, movement_query),
  world: game_world,
  dt_ms: i32,
  axis_x: i32,
  pressed: i32
) -> game_world {
  ecs.query.update(world, movement_query_token, [transforms: transform_index, velocities: velocity_index], update_movement_row)
}

fn game_world.tick(world: game_world, dt_ms: i32, axis_x: i32, pressed: i32) -> game_world {
  movement_system(ecs.query(game_world, movement_query), world, dt_ms, axis_x, pressed)
}

fn render_components(transform: transform2d, sprite: sprite2d) -> merge.geometry2d_i32 {
  merge.emit_rect2d(transform.x, transform.y, sprite.w, sprite.h, transform.z, sprite.color)
}

fn transform_index(entity: entity2d) -> i32 {
  entity.transform
}

fn sprite_index(entity: entity2d) -> i32 {
  entity.sprite
}

fn velocity_index(entity: entity2d) -> i32 {
  entity.velocity
}

fn visible(row: ecs.query_row(entity2d, render_query)) -> bool {
  row.sprites.color > 0
}

fn append_rendered(
  acc: merge.geometry2d_i32,
  row: ecs.query_row(entity2d, render_query)
) -> merge.geometry2d_i32 {
  merge.append_geometry2d(acc, render_components(row.transforms, row.sprites))
}

fn render_system(world: game_world) -> merge.geometry2d_i32 {
  ecs.iter.fold(
    ecs.iter.filter(
      ecs.query.iter(
        render_query_token,
        world,
        [transforms: transform_index, sprites: sprite_index]
      ),
      visible
    ),
    merge.empty_geometry2d(),
    append_rendered
  )
}

fn game_world.render(world: game_world) -> merge.geometry2d_i32 {
  render_system(world)
}

pub fn main() -> merge.geometry2d_i32 !{time, event} {
  let dt_ms = tick_millis();
  let axis_x = input_axis_x();
  let pressed = input_pressed();
  let world = seed_world();
  let ticked_world = game_world.tick(world, dt_ms, axis_x, pressed);
  game_world.render(ticked_world)
}
