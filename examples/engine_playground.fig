const merge = @import("prelude.geometry2d");
const ecs = @import("engine.ecs");
const tick_millis: fn() -> i32 !{time} = @capability("tick_millis");
const input_axis_x: fn() -> i32 !{event} = @capability("input_axis_x");
const input_pressed: fn() -> i32 !{event} = @capability("input_pressed");

type fn player2d() -> type {
  let Player2d = {tag: i32};
  struct(Player2d)
}

type fn enemy2d() -> type {
  let Enemy2d = {tag: i32};
  struct(Enemy2d)
}

type fn transform2d() -> type {
  let Transform2d = {x: i32, y: i32, z: i32};
  struct(Transform2d)
}

type fn velocity2d() -> type {
  let Velocity2d = {x: i32, y: i32};
  struct(Velocity2d)
}

type fn sprite2d() -> type {
  let Sprite2d = {w: i32, h: i32, color: i32};
  struct(Sprite2d)
}

type fn playground_events() -> type {
  let PlaygroundEvents = {dt_ms: i32, axis_x: i32, pressed: i32};
  struct(PlaygroundEvents)
}

const game_components = {
  player: player2d,
  enemy: enemy2d,
  transform: transform2d,
  velocity: velocity2d,
  sprite: sprite2d,
};

const movement_reads = {
  transform: transform2d,
  velocity: velocity2d,
};

const movement_writes = {
  transform: transform2d,
};

const render_reads = {
  transform: transform2d,
  sprite: sprite2d,
};

type fn playground_world() -> type {
  ecs.sparse_world(3, game_components)
}

fn seed_world() -> playground_world {
  ecs.sparse_world.empty(game_components)
    \w -> ecs.entity.add(w, {
      player: Player2d {tag: 1},
      transform: Transform2d {x: 12, y: 8, z: 1},
      velocity: Velocity2d {x: 4, y: 0},
      sprite: Sprite2d {w: 16, h: 16, color: 1}
    })
    \w -> ecs.entity.add(w, {
      enemy: Enemy2d {tag: 1},
      transform: Transform2d {x: 24, y: 8, z: 1},
      velocity: Velocity2d {x: 0, y: 0},
      sprite: Sprite2d {w: 16, h: 16, color: 2}
    })
    \w -> ecs.entity.add(w, {
      enemy: Enemy2d {tag: 2},
      transform: Transform2d {x: 40, y: 8, z: 1},
      sprite: Sprite2d {w: 16, h: 16, color: 3}
    })
}

fn move_transform(
  transform: transform2d,
  velocity: velocity2d,
  events: &(playground_events)
) -> transform2d {
  let speed = velocity.x + events.pressed;
  let dx = events.axis_x * speed * events.dt_ms / 16;
  Transform2d {x: transform.x + dx, y: transform.y + velocity.y, z: transform.z}
}

fn move_row(
  row: ecs.row(movement_reads),
  events: &(playground_events)
) -> ecs.values(movement_writes) {
  {
    transform: move_transform(row.transform, row.velocity, events)
  }
}

fn movement_system(world: playground_world, events: &(playground_events)) -> playground_world {
  ecs.each(movement_reads, movement_writes, world, events, move_row)
}

fn velocity_system(world: playground_world, events: &(playground_events)) -> playground_world {
  world
}

fn render_components(
  transform: transform2d,
  sprite: sprite2d
) -> merge.geometry2d_i32 {
  merge.emit_rect2d(
    transform.x,
    transform.y,
    sprite.w,
    sprite.h,
    transform.z,
    sprite.color
  )
}

fn render_system(world: playground_world) -> merge.geometry2d_i32 {
  render_components(world.transform.values[0], world.sprite.values[0])
}

fn run_frame() -> merge.geometry2d_i32 !{time, event} {
  let dt_ms = tick_millis();
  let axis_x = input_axis_x();
  let pressed = input_pressed();
  let events: playground_events = PlaygroundEvents {
    dt_ms: dt_ms,
    axis_x: axis_x,
    pressed: pressed
  };
  seed_world()
    \w -> ecs.run(
      playground_world,
      playground_events,
      w,
      &events,
      movement_system
    )
    \w -> ecs.run(
      playground_world,
      playground_events,
      w,
      &events,
      velocity_system
    )
    \w -> render_system(w)
}

pub fn main() -> merge.geometry2d_i32 !{time, event} {
  run_frame()
}

pub fn playground_probe() -> i32 !{time, event} {
  let _geometry = run_frame();
  26
}
