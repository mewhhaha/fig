const ecs = @import("engine.ecs");
const canvas = @import("web.canvas");
const core = @import("prelude.core");
const effect = @import("prelude.effect");
const {
  Geometry2dBatchI32,
  append_geometry2d_batch,
  emit_rect2d_batch,
  empty_geometry2d_batch
} = @import("prelude.geometry2d");
const tick_millis = @external("tick_millis", fn(host: io) -> io(i32));
const input_axis_x = @external("input_axis_x", fn(host: io) -> io(i32));
const input_pressed = @external("input_pressed", fn(host: io) -> io(i32));
const entity_capacity: count = 4;

type fn Transform2d() -> type {
  let Transform2d = {x: i32, y: i32, z: i32};
  struct(Transform2d)
}

type fn Velocity2d() -> type {
  let Velocity2d = {x: i32, y: i32};
  struct(Velocity2d)
}

type fn Sprite2d() -> type {
  let Sprite2d = {w: i32, h: i32, color: i32};
  struct(Sprite2d)
}

const components = ecs.components({
  transform: Transform2d,
  velocity: Velocity2d,
  sprite: Sprite2d
});

type fn World() -> type {
  let ExpectedWorld = @type_slots(ecs.World(components));
  let World = {
    entities: ecs.Batch(i32),
    len: i32,
    transform: ecs.Batch(Transform2d),
    velocity: ecs.Batch(Velocity2d),
    sprite: ecs.Batch(Sprite2d)
  };
  let WorldMatchesEcs = @require(
    World == ExpectedWorld,
    "engine playground World must match ecs.World"
  );
  struct(World)
}

type fn EntityId() -> type {
  ecs.EntityId()
}

type fn FrameInput() -> type {
  let FrameInput = {dt_ms: i32, axis_x: i32, pressed: i32};
  struct(FrameInput)
}

type fn GameSystems() -> type {
  ecs.System(World, FrameInput)
}

type fn RenderItem2d() -> type {
  let RenderItem2d = {
    transform: Transform2d,
    sprite: Sprite2d
  };
  struct(RenderItem2d)
}

type fn RenderBatch() -> type {
  Geometry2dBatchI32(8)
}

type fn MovementRow() -> type {
  let MovementRow = {
    transform: Transform2d,
    velocity: Velocity2d,
    input: FrameInput
  };
  struct(MovementRow)
}

type fn SpriteAnimationRow() -> type {
  let SpriteAnimationRow = {
    sprite: Sprite2d,
    input: FrameInput
  };
  struct(SpriteAnimationRow)
}

fn movement_q() -> ecs.Query(World, FrameInput, MovementRow) {
  let transform: ecs.Query(World, FrameInput, Transform2d) = ecs.write(#transform);
  let velocity: ecs.Query(World, FrameInput, Velocity2d) = ecs.read(#velocity);
  let input: ecs.Query(World, FrameInput, FrameInput) = ecs.res();
  ecs.query(MovementRow)
}

fn sprite_animation_q() -> ecs.Query(
  World,
  FrameInput,
  SpriteAnimationRow
) {
  let sprite: ecs.Query(World, FrameInput, Sprite2d) = ecs.write(#sprite);
  let input: ecs.Query(World, FrameInput, FrameInput) = ecs.res();
  ecs.query(SpriteAnimationRow)
}

fn empty_world() -> World {
  {
    entities: ecs.batch_with_capacity(i32, entity_capacity),
    len: 0,
    transform: ecs.batch_with_capacity(Transform2d, entity_capacity),
    velocity: ecs.batch_with_capacity(Velocity2d, entity_capacity),
    sprite: ecs.batch_with_capacity(Sprite2d, entity_capacity)
  }
}

fn entity_index(raw: i32) -> EntityId {
  match core.Index::try(entity_capacity, raw) {
    Some(index) => index,
    None => @empty(EntityId),
  }
}

fn read_frame_input(host: io) -> FrameInput {
  FrameInput {
    dt_ms: tick_millis(host),
    axis_x: input_axis_x(host),
    pressed: input_pressed(host)
  }
}

fn moved_transform(row: MovementRow) -> struct({transform: Transform2d}) {
  {
    transform: Transform2d {
      x: row.transform.x
        + row.velocity.x
        * row.input.axis_x
        * row.input.dt_ms
        / 16,
      y: row.transform.y
        + row.velocity.y
        * row.input.dt_ms
        / 16,
      z: row.transform.z
    }
  }
}

fn animated_sprite(row: SpriteAnimationRow) -> struct({sprite: Sprite2d}) {
  {
    sprite: Sprite2d {
      w: row.sprite.w,
      h: row.sprite.h,
      color: row.sprite.color + row.input.pressed
    }
  }
}

fn movement_system() -> ecs.System(World, FrameInput) {
  do @monad(ecs.System(World, FrameInput)) {
    ecs.map(movement_q(), moved_transform);
  }
}

fn sprite_animation_system() -> ecs.System(
  World,
  FrameInput
) {
  do @monad(ecs.System(World, FrameInput)) {
    ecs.map(sprite_animation_q(), animated_sprite);
  }
}

fn frame_systems() -> ecs.System(World, FrameInput) {
  do @monad(ecs.System(World, FrameInput)) {
    movement_system();
    sprite_animation_system();
  }
}

fn run_frame(world: World, input: FrameInput) -> World {
  ecs.run(world, input, frame_systems)
}

fn run_frame_effect(
  world: World,
  input: FrameInput
) -> World {
  ecs.run(world, input, frame_systems)
}

fn render_system(world: World, input: FrameInput) -> RenderBatch {
  empty_render_batch()
    \batch -> append_visible_render_item(
    batch,
    0 < world.len,
    RenderItem2d {
      transform: ecs.batch_get(world.transform, 0),
      sprite: ecs.batch_get(world.sprite, 0)
    }
  )
    \batch -> append_visible_render_item(
    batch,
    1 < world.len,
    RenderItem2d {
      transform: ecs.batch_get(world.transform, 1),
      sprite: ecs.batch_get(world.sprite, 1)
    }
  )
}

fn empty_render_batch() -> RenderBatch {
  empty_geometry2d_batch(8)
}

fn emit_render_item(item: RenderItem2d) -> RenderBatch {
  emit_rect2d_batch(
    8,
    item.transform.x,
    item.transform.y,
    item.sprite.w,
    item.sprite.h,
    item.transform.z,
    item.sprite.color
  )
}

fn append_visible_render_item(
  acc: RenderBatch,
  visible: bool,
  item: RenderItem2d
) -> RenderBatch {
  match visible {
    true => append_geometry2d_batch(
      acc,
      emit_render_item(item)
    ),
    false => acc,
  }
}

fn render_effect(
  world: World,
  input: FrameInput
) -> RenderBatch {
  render_system(world, input)
}

fn render_item_at(
  world: World,
  index: i32
) -> RenderItem2d {
  RenderItem2d {
    transform: ecs.batch_get(world.transform, index),
    sprite: ecs.batch_get(world.sprite, index)
  }
}

fn draw_render_item(
  host: io,
  canvas_handle: i32,
  item: RenderItem2d
) -> i32 {
  canvas.draw_rect(
    host,
    canvas_handle,
    {
      x: item.transform.x,
      y: item.transform.y,
      z: item.transform.z,
      w: item.sprite.w,
      h: item.sprite.h,
      color: item.sprite.color
    }
  )
}

fn draw_render_items_loop(
  host: io,
  canvas_handle: i32,
  world: World,
  cursor: core.IndexCursor(entity_capacity),
  drawn: i32
) -> i32 {
  match core.IndexCursor::next(entity_capacity, cursor) {
    Yield(index, next) => match index < world.len {
      true => draw_render_items_loop(
        host,
        canvas_handle,
        world,
        next,
        drawn + draw_render_item(
          host,
          canvas_handle,
          render_item_at(world, index)
        )
      ),
      false => drawn,
    },
    Done => drawn,
  }
}

fn draw_render_items(host: io, canvas_handle: i32, world: World) -> i32 {
  draw_render_items_loop(
    host,
    canvas_handle,
    world,
    core.IndexCursor::start(entity_capacity),
    0
  )
}

fn build_demo_world() -> World {
  let world: World = empty_world();
  let first = entity_index(0);
  let second = entity_index(1);
  {
    entities: ecs.batch_set(
      ecs.batch_set(world.entities, first, first),
      second,
      second
    ),
    len: 2,
    transform: ecs.batch_set(
      ecs.batch_set(
        world.transform,
        first,
        Transform2d {x: 16, y: 8, z: 1}
      ),
      second,
      Transform2d {x: 24, y: 8, z: 1}
    ),
    velocity: ecs.batch_set(
      ecs.batch_set(
        world.velocity,
        first,
        Velocity2d {x: 4, y: 0}
      ),
      second,
      Velocity2d {x: 4, y: 0}
    ),
    sprite: ecs.batch_set(
      ecs.batch_set(
        world.sprite,
        first,
        Sprite2d {w: 16, h: 16, color: 1}
      ),
      second,
      Sprite2d {w: 16, h: 16, color: 2}
    )
  }
}

fn run_demo_frame(host: io) -> RenderBatch {
  run_demo_frame_effect(host)
}

fn run_demo_frame_effect(host: io) -> RenderBatch {
  let input = read_frame_input(host);
  let world = build_demo_world();
  let updated: World = run_frame_effect(world, input);
  render_effect(updated, input)
}

pub fn main(host: io) -> RenderBatch {
  run_demo_frame(host)
}

pub fn render_frame(
  host: io,
  target: i32,
  width: i32,
  height: i32
) -> i32 {
  let input = read_frame_input(host);
  let world = build_demo_world();
  let updated = run_frame(world, input);
  let canvas_handle = canvas.gpu_begin_frame(
    host,
    target,
    width,
    height
  );
  let drawn = draw_render_items(host, canvas_handle, updated);
  let presented = canvas.gpu_present(host, canvas_handle);
  canvas_handle + drawn + presented
}

pub fn playground_probe(host: io) -> i32 {
  let output = run_demo_frame(host);
  output.len
}

pub fn playground_world_len() -> i32 {
  let world = build_demo_world();
  world.len
}
