const merge = @import("prelude.geometry2d");
const ecs = @import("engine.ecs");
const tick_millis: fn() -> i32 !{time} = @capability("tick_millis");
const input_axis_x: fn() -> i32 !{event} = @capability("input_axis_x");
const input_pressed: fn() -> i32 !{event} = @capability("input_pressed");

fn run_frame() -> merge.Geometry2dBatch3I32 !{time, event} {
  let dt_ms = tick_millis();
  let axis_x = input_axis_x();
  let pressed = input_pressed();
  let first = merge.emit_rect2d_batch3(12 + axis_x, 8, 16, 16, 1, 1);
  let second = merge.emit_rect2d_batch3(24, 8 + pressed, 16, 16, 1, 2);
  let third = merge.emit_rect2d_batch3(40 + dt_ms / 16, 8, 16, 16, 1, 3);
  merge.append_geometry2d_batch3(merge.append_geometry2d_batch3(first, second), third)
}

pub fn main() -> merge.Geometry2dBatch3I32 !{time, event} {
  run_frame()
}

pub fn playground_probe() -> i32 !{time, event} {
  let geometry = run_frame();
  geometry.vertex_count
}
