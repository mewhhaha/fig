const ecs = @import("engine.ecs");
const {
  Geometry2dBatchI32,
  append_geometry2d_batch,
  emit_rect2d_batch,
  empty_geometry2d_batch
} = @import("prelude.geometry2d");
const tick_millis: fn() -> i32 !{time} = @capability("tick_millis");
const input_axis_x: fn() -> i32 !{event} = @capability("input_axis_x");
const input_pressed: fn() -> i32 !{event} = @capability("input_pressed");

type fn Read(component: type) -> type {
  ecs.Read(component)
}

type fn Write(component: type) -> type {
  ecs.Write(component)
}

type fn Transform2d() -> type {
  let Transform2d = {x: i32, y: i32, z: i32};
  struct(Transform2d)
}

type fn Velocity2d() -> type {
  let Velocity2d = {x: i32, y: i32};
  struct(Velocity2d)
}

type fn Sprite2d() -> type {
  let Sprite2d = {w: i32, h: i32, color: i32};
  struct(Sprite2d)
}

const components = ecs.components({
  transform: Transform2d,
  velocity: Velocity2d,
  sprite: Sprite2d
});

type fn World() -> type {
  let World = {
    entities: ecs.Batch(32, EntityId),
    len: i32,
    transform: ecs.Batch(32, Transform2d),
    velocity: ecs.Batch(32, Velocity2d),
    sprite: ecs.Batch(32, Sprite2d)
  };
  struct(World)
}

type fn EntityId() -> type {
  ecs.BatchIndex(32)
}

type fn FrameInput() -> type {
  let FrameInput = {dt_ms: i32, axis_x: i32, pressed: i32};
  struct(FrameInput)
}

type fn Command(world: type) -> type {
  ecs.Command(world)
}

fn Command::pure(value: World) -> Command(World) {
  value
}

fn Command::bind(
  value: Command(World),
  const step: fn(value: World) -> Command(World)
) -> Command(World) {
  step(value)
}

type fn Query(value: type) -> type {
  value
}

fn Query::pure(value: value_t) -> Query(value_t) {
  value
}

fn Query::map(
  const step: fn(value: value_t) -> Query(next_t),
  value: Query(value_t)
) -> Query(next_t) {
  step(value)
}

fn Query::bind(
  value: Query(value_t),
  const step: fn(value: value_t) -> Query(next_t)
) -> Query(next_t) {
  step(value)
}

type fn RenderState() -> type {
  let RenderState = {
    len: i32,
    transform: ecs.Batch(32, Transform2d),
    sprite: ecs.Batch(32, Sprite2d)
  };
  struct(RenderState)
}

type fn RenderRow2d() -> type {
  let RenderRow2d = {
    visible: bool,
    entity: EntityId,
    transform: Transform2d,
    sprite: Sprite2d
  };
  struct(RenderRow2d)
}

type fn RenderBatch() -> type {
  Geometry2dBatchI32(8)
}

fn read_frame_input() -> FrameInput !{time, event} {
  FrameInput {
    dt_ms: tick_millis(),
    axis_x: input_axis_x(),
    pressed: input_pressed()
  }
}

fn empty_world() -> World {
  World {
    entities: ecs.batch_fill(32, EntityId, 0),
    len: 0,
    transform: ecs.batch_fill(
      32,
      Transform2d,
      Transform2d {x: 0, y: 0, z: 0}
    ),
    velocity: ecs.batch_fill(
      32,
      Velocity2d,
      Velocity2d {x: 0, y: 0}
    ),
    sprite: ecs.batch_fill(
      32,
      Sprite2d,
      Sprite2d {w: 0, h: 0, color: 0}
    )
  }
}

fn setup(world: World) -> World {
  do @monad(Command(World)) {
    first <- ecs.spawn(
      world,
      {
        transform: Transform2d {x: 12, y: 8, z: 1},
        velocity: Velocity2d {x: 4, y: 0},
        sprite: Sprite2d {w: 16, h: 16, color: 1}
      }
    );
    ecs.spawn(
      first,
      {
        transform: Transform2d {x: 24, y: 8, z: 1},
        velocity: Velocity2d {x: 4, y: 0},
        sprite: Sprite2d {w: 16, h: 16, color: 2}
      }
    )
  }
}

fn movement_system(
  mut: ecs.Query({
    transform: Write(Transform2d),
    velocity: Read(Velocity2d)
  }),
  input: ecs.Res(FrameInput)
) -> ecs.System {
  do @applicative(Query) {
    row <- ecs.each(mut);
    ecs.write({
      transform: Transform2d {
        x: row.transform.x + row.velocity.x * input.dt_ms
          / 16,
        y: row.transform.y + row.velocity.y * input.dt_ms
          / 16,
        z: row.transform.z
      }
    })
  }
}

fn sprite_animation_system(
  mut: ecs.Query({sprite: Write(Sprite2d)}),
  input: ecs.Res(FrameInput)
) -> ecs.System {
  do @applicative(Query) {
    row <- ecs.each(mut);
    ecs.write({
      sprite: Sprite2d {
        w: row.sprite.w,
        h: row.sprite.h,
        color: row.sprite.color + input.pressed
      }
    })
  }
}

fn run_frame(world: World, input: FrameInput) -> World {
  do @monad(Command(World)) {
    moved <- ecs.run(world, input, movement_system);
    ecs.run(moved, input, sprite_animation_system)
  }
}

fn render_row(
  index: ecs.BatchIndex(32),
  entity: EntityId,
  state: RenderState
) -> RenderRow2d {
  RenderRow2d {
    visible: index < state.len,
    entity: entity,
    transform: state.transform[index],
    sprite: state.sprite[index]
  }
}

fn render_system(world: World, input: FrameInput) -> RenderBatch {
  append_render_row(
    append_render_row(
      empty_render_batch(),
      render_row(
        0,
        world.entities[0],
        RenderState {
          len: world.len,
          transform: world.transform,
          sprite: world.sprite
        }
      )
    ),
    render_row(
      1,
      world.entities[1],
      RenderState {
        len: world.len,
        transform: world.transform,
        sprite: world.sprite
      }
    )
  )
}

fn empty_render_batch() -> RenderBatch {
  empty_geometry2d_batch(8)
}

fn emit_render_row(row: RenderRow2d) -> RenderBatch {
  emit_rect2d_batch(
    8,
    row.transform.x,
    row.transform.y,
    row.sprite.w,
    row.sprite.h,
    row.transform.z,
    row.sprite.color
  )
}

fn append_render_row(
  acc: RenderBatch,
  row: RenderRow2d
) -> RenderBatch {
  match row.visible {
    true => append_geometry2d_batch(
      acc,
      emit_render_row(row)
    ),
    false => acc,
  }
}

fn build_demo_world() -> World {
  setup(empty_world())
}

fn run_demo_frame() -> RenderBatch !{time, event} {
  let input = read_frame_input();
  let world = build_demo_world();
  let updated = run_frame(world, input);
  render_system(updated, input)
}

pub fn main() -> RenderBatch !{time, event} {
  run_demo_frame()
}

pub fn playground_probe() -> i32 !{time, event} {
  let output = run_demo_frame();
  output.len
}

pub fn playground_world_len() -> i32 {
  let world = build_demo_world();
  world.len
}
