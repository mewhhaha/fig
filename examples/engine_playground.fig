const ecs = @import("engine.ecs");
const {
  Geometry2dBatchI32,
  append_geometry2d_batch,
  emit_rect2d_batch,
  empty_geometry2d_batch
} = @import("prelude.geometry2d");
const tick_millis: fn() -> i32 !{time} = @capability("tick_millis");
const input_axis_x: fn() -> i32 !{event} = @capability("input_axis_x");
const input_pressed: fn() -> i32 !{event} = @capability("input_pressed");

type fn Transform2d() -> type {
  let Transform2d = {x: i32, y: i32, z: i32};
  struct(Transform2d)
}

type fn Velocity2d() -> type {
  let Velocity2d = {x: i32, y: i32};
  struct(Velocity2d)
}

type fn Sprite2d() -> type {
  let Sprite2d = {w: i32, h: i32, color: i32};
  struct(Sprite2d)
}

const components = ecs.components({
  transform: Transform2d,
  velocity: Velocity2d,
  sprite: Sprite2d
});

type fn World() -> type {
  let ExpectedWorld = @type_slots(ecs.World(32, components));
  let World = {
    entities: ecs.Batch(32, EntityId),
    len: i32,
    transform: ecs.Batch(32, Transform2d),
    velocity: ecs.Batch(32, Velocity2d),
    sprite: ecs.Batch(32, Sprite2d)
  };
  let WorldMatchesEcs = @require(
    World == ExpectedWorld,
    "engine playground World must match ecs.World"
  );
  struct(World)
}

type fn EntityId() -> type {
  ecs.BatchIndex(32)
}

type fn FrameInput() -> type {
  let FrameInput = {dt_ms: i32, axis_x: i32, pressed: i32};
  struct(FrameInput)
}

type fn RenderRow2d() -> type {
  let RenderRow2d = {
    visible: bool,
    entity: EntityId,
    transform: Transform2d,
    sprite: Sprite2d
  };
  struct(RenderRow2d)
}

type fn RenderBatch() -> type {
  Geometry2dBatchI32(8)
}

type fn EntitySpawn2d() -> type {
  let EntitySpawn2d = {
    transform: Transform2d,
    velocity: Velocity2d,
    sprite: Sprite2d
  };
  struct(EntitySpawn2d)
}

fn empty_world() -> World {
  ecs.World::empty(32, components)
}

fn read_frame_input() -> FrameInput !{time, event} {
  FrameInput {
    dt_ms: tick_millis(),
    axis_x: input_axis_x(),
    pressed: input_pressed()
  }
}

fn setup(world: World) -> World {
  do @monad(ecs.Command(World)) {
    spawn_entity({
      transform: Transform2d {x: 12, y: 8, z: 1},
      velocity: Velocity2d {x: 4, y: 0},
      sprite: Sprite2d {w: 16, h: 16, color: 1}
    });
    spawn_entity(
      {
        transform: Transform2d {x: 24, y: 8, z: 1},
        velocity: Velocity2d {x: 4, y: 0},
        sprite: Sprite2d {w: 16, h: 16, color: 2}
      }
    )
  }
}

fn spawn_entity(world: World, entity: EntitySpawn2d) -> World {
  let id = world.len;
  World {
    entities: ecs.batch_set(world.entities, id, id),
    len: world.len + 1,
    transform: ecs.batch_set(
      world.transform,
      id,
      entity.transform
    ),
    velocity: ecs.batch_set(
      world.velocity,
      id,
      entity.velocity
    ),
    sprite: ecs.batch_set(world.sprite, id, entity.sprite)
  }
}

fn movement_system(
  mut: ecs.Query({
    transform: ecs.Write(Transform2d),
    velocity: ecs.Read(Velocity2d)
  }),
  input: ecs.Res(FrameInput)
) -> ecs.System {
  do @monad(ecs.System) {
    let update = do @applicative(ecs.Query(ecs.QueryRowFor({
      transform: ecs.Write(Transform2d),
      velocity: ecs.Read(Velocity2d)
    }))) {
      row <- ecs.each(mut);
      pure({
        transform: Transform2d {
          x: row.transform.x + row.velocity.x * input.axis_x
            * input.dt_ms / 16,
          y: row.transform.y + row.velocity.y * input.dt_ms
            / 16,
          z: row.transform.z
        }
      })
    };
    pure(update)
  }
}

fn sprite_animation_system(
  mut: ecs.Query({sprite: ecs.Write(Sprite2d)}),
  input: ecs.Res(FrameInput)
) -> ecs.System {
  do @monad(ecs.System) {
    let update = do @applicative(ecs.Query(ecs.QueryRowFor({
      sprite: ecs.Write(Sprite2d)
    }))) {
      row <- ecs.each(mut);
      pure({
        sprite: Sprite2d {
          w: row.sprite.w,
          h: row.sprite.h,
          color: row.sprite.color + input.pressed
        }
      })
    };
    pure(update)
  }
}

fn run_frame(world: World, input: FrameInput) -> World {
  do @monad(ecs.Command(World)) {
    ecs.run(input, movement_system);
    ecs.run(input, sprite_animation_system);
  }
}

fn render_system(world: World, input: FrameInput) -> RenderBatch {
  empty_render_batch()
    \batch -> append_render_row(
      batch,
      RenderRow2d {
        visible: 0 < world.len,
        entity: world.entities[0],
        transform: Transform2d {
          x: world.transform[0].x + world.velocity[0].x
            * input.axis_x
            * input.dt_ms / 16,
          y: world.transform[0].y + world.velocity[0].y
            * input.axis_x
            * input.dt_ms / 16,
          z: world.transform[0].z
        },
        sprite: Sprite2d {
          w: world.sprite[0].w,
          h: world.sprite[0].h,
          color: world.sprite[0].color + input.pressed
        }
      }
    )
    \batch -> append_render_row(
      batch,
      RenderRow2d {
        visible: 1 < world.len,
        entity: world.entities[1],
        transform: Transform2d {
          x: world.transform[1].x + world.velocity[1].x
            * input.axis_x
            * input.dt_ms / 16,
          y: world.transform[1].y + world.velocity[1].y
            * input.axis_x
            * input.dt_ms / 16,
          z: world.transform[1].z
        },
        sprite: Sprite2d {
          w: world.sprite[1].w,
          h: world.sprite[1].h,
          color: world.sprite[1].color + input.pressed
        }
      }
    )
}

fn empty_render_batch() -> RenderBatch {
  empty_geometry2d_batch(8)
}

fn emit_render_row(row: RenderRow2d) -> RenderBatch {
  emit_rect2d_batch(
    8,
    row.transform.x,
    row.transform.y,
    row.sprite.w,
    row.sprite.h,
    row.transform.z,
    row.sprite.color
  )
}

fn append_render_row(
  acc: RenderBatch,
  row: RenderRow2d
) -> RenderBatch {
  match row.visible {
    true => append_geometry2d_batch(
      acc,
      emit_render_row(row)
    ),
    false => acc,
  }
}

fn build_demo_world() -> World {
  setup(empty_world())
}

fn run_demo_frame() -> RenderBatch !{time, event} {
  let input = read_frame_input();
  let world = build_demo_world();
  let updated = run_frame(world, input);
  render_system(updated, input)
}

pub fn main() -> RenderBatch !{time, event} {
  run_demo_frame()
}

pub fn playground_probe() -> i32 !{time, event} {
  let output = run_demo_frame();
  output.len
}

pub fn playground_world_len() -> i32 {
  let world = build_demo_world();
  world.len
}
