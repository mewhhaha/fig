const effect = @import("prelude.effect");
const core = @import("prelude.core");

type fn Store() -> type {
  i32
}

fn bump() -> effect.Eff({state: Store}, core.Unit) {
  \ctx -> {value: core.unit(), state: ctx.state + 1}
}

fn program() -> effect.Eff({state: Store}, Store) {
  \ctx -> {
    let next = ctx.state + 2;
    {value: next, state: next}
  }
}

pub fn main() -> i32 {
  let result = program()
    \program -> effect.run_state_only(program, 10);
  result.value
}
