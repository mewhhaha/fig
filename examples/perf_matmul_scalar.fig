type fn InlineArray(n: count, a: type) -> type {
  let InlineArray = {n*a};
  struct(InlineArray)
}

type fn Mat4I32() -> type {
  InlineArray(16, i32)
}

pub fn main(a: Mat4I32, b_cols: Mat4I32) -> Mat4I32 {
  #[
    (a[0] * b_cols[0]) + (a[1] * b_cols[1]) + (a[2] * b_cols[2]) + (a[3] * b_cols[3]),
    (a[0] * b_cols[4]) + (a[1] * b_cols[5]) + (a[2] * b_cols[6]) + (a[3] * b_cols[7]),
    (a[0] * b_cols[8]) + (a[1] * b_cols[9]) + (a[2] * b_cols[10]) + (a[3] * b_cols[11]),
    (a[0] * b_cols[12]) + (a[1] * b_cols[13]) + (a[2] * b_cols[14]) + (a[3] * b_cols[15]),
    (a[4] * b_cols[0]) + (a[5] * b_cols[1]) + (a[6] * b_cols[2]) + (a[7] * b_cols[3]),
    (a[4] * b_cols[4]) + (a[5] * b_cols[5]) + (a[6] * b_cols[6]) + (a[7] * b_cols[7]),
    (a[4] * b_cols[8]) + (a[5] * b_cols[9]) + (a[6] * b_cols[10]) + (a[7] * b_cols[11]),
    (a[4] * b_cols[12]) + (a[5] * b_cols[13]) + (a[6] * b_cols[14]) + (a[7] * b_cols[15]),
    (a[8] * b_cols[0]) + (a[9] * b_cols[1]) + (a[10] * b_cols[2]) + (a[11] * b_cols[3]),
    (a[8] * b_cols[4]) + (a[9] * b_cols[5]) + (a[10] * b_cols[6]) + (a[11] * b_cols[7]),
    (a[8] * b_cols[8]) + (a[9] * b_cols[9]) + (a[10] * b_cols[10]) + (a[11] * b_cols[11]),
    (a[8] * b_cols[12]) + (a[9] * b_cols[13]) + (a[10] * b_cols[14]) + (a[11] * b_cols[15]),
    (a[12] * b_cols[0]) + (a[13] * b_cols[1]) + (a[14] * b_cols[2]) + (a[15] * b_cols[3]),
    (a[12] * b_cols[4]) + (a[13] * b_cols[5]) + (a[14] * b_cols[6]) + (a[15] * b_cols[7]),
    (a[12] * b_cols[8]) + (a[13] * b_cols[9]) + (a[14] * b_cols[10]) + (a[15] * b_cols[11]),
    (a[12] * b_cols[12]) + (a[13] * b_cols[13]) + (a[14] * b_cols[14]) + (a[15] * b_cols[15])
  ]
}
