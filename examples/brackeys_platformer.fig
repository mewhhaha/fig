fn empty_velocity() -> Velocity2d {
  Velocity2d {
    x: 0,
    y: 0
  }
}

fn no_gravity() -> Gravity2d {
  Gravity2d {value: 0}
}

fn not_grounded() -> Grounded {
  Grounded {value: 0}
}

fn no_player_control() -> PlayerControl {
  PlayerControl {enabled: 0, speed: 0, jump_impulse: 0}
}

fn sprite(
  atlas: asset.Handle(#texture),
  sw: i32,
  sh: i32,
  w: i32,
  h: i32,
  z: i32
) -> Sprite2d {
  Sprite2d {
    atlas: atlas,
    sx: 0,
    sy: 0,
    sw: sw,
    sh: sh,
    w: w,
    h: h,
    flip_x: 0,
    z: z,
    visible: 1
  }
}

fn no_collider() -> Collider2d {
  Collider2d {offset_x: 0, offset_y: 0, w: 0, h: 0, active: 0}
}

fn collider(
  offset_x: i32,
  offset_y: i32,
  w: i32,
  h: i32
) -> Collider2d {
  Collider2d {offset_x: offset_x, offset_y: offset_y, w: w, h: h, active: 1}
}

fn no_patrol() -> Patrol2d {
  Patrol2d {active: 0, dir: 0, min_x: 0, max_x: 0}
}

fn patrol(dir: i32, min_x: i32, max_x: i32) -> Patrol2d {
  Patrol2d {active: 1, dir: dir, min_x: min_x, max_x: max_x}
}

fn no_collectible() -> Collectible {
  Collectible {active: 0, collected: 0, sound: sound_none(), value: 0}
}

fn collectible(
  sound: asset.Handle(#sound),
  value: i32
) -> Collectible {
  Collectible {active: 1, collected: 0, sound: sound, value: value}
}

fn no_player_state() -> PlayerState {
  PlayerState {lives: 0, mode: mode_play, collected: 0, sound: sound_none()}
}

fn player_state(lives: i32) -> PlayerState {
  PlayerState {lives: lives, mode: mode_play, collected: 0, sound: sound_none()}
}

fn empty_world() -> World {
  @empty(World)
}

pub fn init_world() -> World {
  let world: World = empty_world();
  do @monad(ecs.Command(World)) {
    ecs.spawn({
      transform: Transform2d {x: 24, y: 104, z: 5},
      gravity: Gravity2d {value: 2},
      player_control: PlayerControl {enabled: 1, speed: 3, jump_impulse: 20},
      sprite: sprite(atlas_knight(), 32, 32, 32, 32, 5),
      collider: collider(0, 0, 12, 16),
      player_state: player_state(3)
    });
    ecs.spawn({
      transform: Transform2d {x: 166, y: 124, z: 4},
      velocity: Velocity2d {x: 0 - 1, y: 0},
      sprite: sprite(atlas_slime(), 32, 24, 32, 24, 4),
      collider: collider(8, 8, 16, 16),
      patrol: patrol(0 - 1, 146, 192)
    });
    ecs.spawn({
      transform: Transform2d {x: 50, y: 98, z: 4},
      sprite: sprite(atlas_coin(), 16, 16, 16, 16, 4),
      collider: collider(3, 3, 10, 10),
      collectible: collectible(sound_coin(), 1)
    });
    ecs.spawn({
      transform: Transform2d {x: 132, y: 76, z: 4},
      sprite: sprite(atlas_coin(), 16, 16, 16, 16, 4),
      collider: collider(3, 3, 10, 10),
      collectible: collectible(sound_coin(), 1)
    });
    ecs.spawn({
      transform: Transform2d {x: 196, y: 58, z: 4},
      sprite: sprite(atlas_coin(), 16, 16, 16, 16, 4),
      collider: collider(3, 3, 10, 10),
      collectible: collectible(sound_coin(), 1)
    });
    ecs.spawn({
      transform: Transform2d {x: 220, y: 56, z: 4},
      sprite: sprite(atlas_fruit(), 16, 16, 16, 16, 4),
      collider: collider(1, 1, 14, 14),
      collectible: collectible(sound_power(), 1)
    });
  }
}

fn clamp(value: i32, low: i32, high: i32) -> i32 {
  let below = value < low;
  let above = value > high;
  match below,
    above
  {
    true, _ => low,
    false, true => high,
    false, false => value
  }
}

fn bool_i32(value: bool) -> i32 {
  match value {
    true => 1,
    false => 0
  }
}

fn rect(x: i32, y: i32, w: i32, h: i32) -> Rect {
  Rect {x: x, y: y, w: w, h: h}
}

fn rect_for_entity(
  transform: Transform2d,
  collider: Collider2d
) -> Rect {
  rect(
    transform.x + collider.offset_x,
    transform.y + collider.offset_y,
    collider.w,
    collider.h
  )
}

fn overlaps(a: Rect, b: Rect) -> bool {
  let a_left_of_b_right = a.x < b.x + b.w;
  let b_left_of_a_right = b.x < a.x + a.w;
  let a_above_b_bottom = a.y < b.y + b.h;
  let b_above_a_bottom = b.y < a.y + a.h;
  match a_left_of_b_right,
    b_left_of_a_right,
    a_above_b_bottom,
    b_above_a_bottom
  {
    true, true, true, true => true,
    _ => false
  }
}

fn horizontal_overlap_rect(
  x: i32,
  w: i32,
  platform: Rect
) -> bool {
  let right_of_left_edge = x + w > platform.x;
  let left_of_right_edge = x < platform.x + platform.w;
  match right_of_left_edge,
    left_of_right_edge
  {
    true, true => true,
    _ => false
  }
}

fn landed_on_rect(
  x: i32,
  y: i32,
  w: i32,
  h: i32,
  platform: Rect
) -> bool {
  let horizontal = horizontal_overlap_rect(
    x,
    w,
    platform
  );
  let reaches_platform = y + h >= platform.y;
  let above_platform = y < platform.y;
  match horizontal,
    reaches_platform,
    above_platform
  {
    true, true, true => true,
    _ => false
  }
}

fn platform0() -> Rect {
  rect(0, 148, 256, 16)
}

fn platform1() -> Rect {
  rect(28, 116, 52, 12)
}

fn platform2() -> Rect {
  rect(108, 94, 58, 12)
}

fn platform3() -> Rect {
  rect(180, 76, 50, 12)
}

fn spike_rect() -> Rect {
  rect(92, 140, 24, 8)
}

fn land_y_for_collider(
  transform: Transform2d,
  collider: Collider2d
) -> i32 {
  let x = transform.x + collider.offset_x;
  let y = transform.y + collider.offset_y;
  let p3 = platform3();
  let p2 = platform2();
  let p1 = platform1();
  let p0 = platform0();
  let landed_p3 = landed_on_rect(
    x,
    y,
    collider.w,
    collider.h,
    p3
  );
  let landed_p2 = landed_on_rect(
    x,
    y,
    collider.w,
    collider.h,
    p2
  );
  let landed_p1 = landed_on_rect(
    x,
    y,
    collider.w,
    collider.h,
    p1
  );
  let landed_p0 = landed_on_rect(
    x,
    y,
    collider.w,
    collider.h,
    p0
  );
  match landed_p3,
    landed_p2,
    landed_p1,
    landed_p0
  {
    true, _, _, _ => p3.y - collider.h - collider.offset_y,
    false, true, _, _ => p2.y - collider.h - collider.offset_y,
    false, false, true, _ => p1.y - collider.h - collider.offset_y,
    false, false, false, true => p0.y - collider.h - collider.offset_y,
    false, false, false, false => transform.y
  }
}

fn velocity_for_row(row: struct({
  velocity: Velocity2d,
  gravity: Gravity2d,
  player_control: PlayerControl,
  grounded: Grounded,
  input: FrameInput
})) -> struct({velocity: Velocity2d}) {
  let controlled = row.player_control.enabled > 0;
  let jump_pressed = row.input.jump > 0;
  let on_ground = row.grounded.value > 0;
  let jump_now = match controlled,
    jump_pressed,
    on_ground
  {
    true, true, true => true,
    _ => false
  };
  {
    velocity: Velocity2d {
      x: match controlled {
        true => clamp(row.input.axis_x, 0 - 1, 1) * row.player_control.speed,
        false => row.velocity.x,
      },
      y: match jump_now {
        true => 0 - row.player_control.jump_impulse,
        false => row.velocity.y + row.gravity.value,
      }
    }
  }
}

fn transform_for_motion(row: struct({
  transform: Transform2d,
  velocity: Velocity2d,
  input: FrameInput
})) -> struct({transform: Transform2d}) {
  let dt = clamp(row.input.dt_ms, 1, 32);
  {
    transform: Transform2d {
      x: clamp(
        row.transform.x + row.velocity.x * dt / 16,
        0,
        244
      ),
      y: row.transform.y + row.velocity.y * dt / 16,
      z: row.transform.z
    }
  }
}

fn clear_grounded_row(row: struct({grounded: Grounded})) -> struct({grounded: Grounded}) {
  {grounded: not_grounded()}
}

fn clear_sound_row(row: struct({
  player_state: PlayerState,
  player_control: PlayerControl
})) -> struct({player_state: PlayerState}) {
  {
    player_state: match row.player_control.enabled > 0 {
      true => PlayerState {
        lives: row.player_state.lives,
        mode: row.player_state.mode,
        collected: row.player_state.collected,
        sound: sound_none()
      },
      false => row.player_state,
    },
  }
}

fn velocity_system() -> GameSystems {
  do @monad(ecs.System(World, FrameInput)) {
    ecs.map(velocity_q, velocity_for_row);
  }
}

fn movement_system() -> GameSystems {
  do @monad(ecs.System(World, FrameInput)) {
    ecs.map(movement_q, transform_for_motion);
  }
}

fn clear_grounded_system() -> GameSystems {
  do @monad(ecs.System(World, FrameInput)) {
    ecs.map(grounded_q, clear_grounded_row);
  }
}

fn physics_system() -> GameSystems {
  do @monad(ecs.System(World, FrameInput)) {
    velocity_system();
    movement_system();
    clear_grounded_system();
  }
}

fn clear_sound_system() -> GameSystems {
  do @monad(ecs.System(World, FrameInput)) {
    ecs.map(clear_sound_q, clear_sound_row);
  }
}

fn resolved_ground_y(row: struct({
  transform: Transform2d,
  velocity: Velocity2d,
  gravity: Gravity2d,
  grounded: Grounded,
  collider: Collider2d
})) -> i32 {
  let collides = row.collider.active > 0;
  let falls = row.gravity.value > 0;
  match collides,
    falls
  {
    true, true => land_y_for_collider(
      row.transform,
      row.collider
    ),
    _ => row.transform.y
  }
}

fn did_land(row: struct({
  transform: Transform2d,
  velocity: Velocity2d,
  gravity: Gravity2d,
  grounded: Grounded,
  collider: Collider2d
})) -> bool {
  resolved_ground_y(row) != row.transform.y
}

fn resolved_velocity_y(row: struct({
  transform: Transform2d,
  velocity: Velocity2d,
  gravity: Gravity2d,
  grounded: Grounded,
  collider: Collider2d
})) -> i32 {
  match did_land(row) {
    true => 0,
    false => row.velocity.y,
  }
}

fn resolved_grounded(row: struct({
  transform: Transform2d,
  velocity: Velocity2d,
  gravity: Gravity2d,
  grounded: Grounded,
  collider: Collider2d
})) -> struct({grounded: Grounded}) {
  {
    grounded: Grounded {
      value: match did_land(row) {
        true => 1,
        false => row.grounded.value,
      }
    }
  }
}

fn resolved_collision_transform(row: struct({
  transform: Transform2d,
  velocity: Velocity2d,
  gravity: Gravity2d,
  grounded: Grounded,
  collider: Collider2d
})) -> struct({transform: Transform2d}) {
  {
    transform: Transform2d {
      x: row.transform.x,
      y: resolved_ground_y(row),
      z: row.transform.z
    }
  }
}

fn resolved_collision_velocity(row: struct({
  transform: Transform2d,
  velocity: Velocity2d,
  gravity: Gravity2d,
  grounded: Grounded,
  collider: Collider2d
})) -> struct({velocity: Velocity2d}) {
  {
    velocity: Velocity2d {
      x: row.velocity.x,
      y: resolved_velocity_y(row)
    }
  }
}

fn collision_system() -> GameSystems {
  do @monad(ecs.System(World, FrameInput)) {
    ecs.map(collision_velocity_q, resolved_collision_velocity);
    ecs.map(collision_grounded_q, resolved_grounded);
    ecs.map(collision_transform_q, resolved_collision_transform);
  }
}

fn patrol_dir(row: struct({
  transform: Transform2d,
  velocity: Velocity2d,
  patrol: Patrol2d
})) -> i32 {
  let active = row.patrol.active > 0;
  let at_left_edge = row.transform.x <= row.patrol.min_x;
  let at_right_edge = row.transform.x >= row.patrol.max_x;
  match active,
    at_left_edge,
    at_right_edge
  {
    true, true, _ => 1,
    true, false, true => 0 - 1,
    _ => row.patrol.dir
  }
}

fn patrol_velocity_x(row: struct({
  transform: Transform2d,
  velocity: Velocity2d,
  patrol: Patrol2d
})) -> i32 {
  match row.patrol.active > 0 {
    true => patrol_dir(row),
    false => row.velocity.x,
  }
}

fn updated_patrol_velocity(row: struct({
  transform: Transform2d,
  velocity: Velocity2d,
  patrol: Patrol2d
})) -> struct({velocity: Velocity2d}) {
  {
    velocity: Velocity2d {
      x: patrol_velocity_x(row),
      y: row.velocity.y
    }
  }
}

fn updated_patrol_state(row: struct({
  transform: Transform2d,
  velocity: Velocity2d,
  patrol: Patrol2d
})) -> struct({patrol: Patrol2d}) {
  {
    patrol: Patrol2d {
      active: row.patrol.active,
      dir: patrol_dir(row),
      min_x: row.patrol.min_x,
      max_x: row.patrol.max_x
    }
  }
}

fn patrol_system() -> GameSystems {
  do @monad(ecs.System(World, FrameInput)) {
    ecs.map(patrol_velocity_q, updated_patrol_velocity);
    ecs.map(patrol_state_q, updated_patrol_state);
  }
}

fn choose_player_found(
  current: i32,
  index: EntityId,
  world: World
) -> i32 {
  let is_player = world.player_control[index].enabled > 0;
  match current > 0,
    is_player
  {
    false, true => 1,
    _, _ => current,
  }
}

fn player_found(world: World) -> i32 {
  ecs.fold_entities(world, 0, choose_player_found)
}

fn choose_player_rect(
  current: Rect,
  index: EntityId,
  world: World
) -> Rect {
  match world.player_control[index].enabled > 0 {
    true => rect_for_entity(
      world.transform[index],
      world.collider[index]
    ),
    false => current,
  }
}

fn player_rect_for_world(world: World) -> Rect {
  ecs.fold_entities(
    world,
    rect(0, 0, 0, 0),
    choose_player_rect
  )
}

fn choose_player_x(
  current: i32,
  index: EntityId,
  world: World
) -> i32 {
  match world.player_control[index].enabled > 0 {
    true => world.transform[index].x,
    false => current,
  }
}

fn player_x_for_world(world: World) -> i32 {
  ecs.fold_entities(world, 0, choose_player_x)
}

fn choose_player_y(
  current: i32,
  index: EntityId,
  world: World
) -> i32 {
  match world.player_control[index].enabled > 0 {
    true => world.transform[index].y,
    false => current,
  }
}

fn player_y_for_world(world: World) -> i32 {
  ecs.fold_entities(world, 0, choose_player_y)
}

fn choose_player_mode(
  current: i32,
  index: EntityId,
  world: World
) -> i32 {
  match world.player_control[index].enabled > 0 {
    true => world.player_state[index].mode,
    false => current,
  }
}

fn player_mode_for_world(world: World) -> i32 {
  ecs.fold_entities(
    world,
    mode_play,
    choose_player_mode
  )
}

fn choose_player_sound(
  current: asset.Handle(#sound),
  index: EntityId,
  world: World
) -> asset.Handle(#sound) {
  match world.player_control[index].enabled > 0 {
    true => world.player_state[index].sound,
    false => current,
  }
}

fn player_sound_for_world(world: World) -> asset.Handle(#sound) {
  ecs.fold_entities(
    world,
    sound_none(),
    choose_player_sound
  )
}

fn choose_player_collected(
  current: i32,
  index: EntityId,
  world: World
) -> i32 {
  match world.player_control[index].enabled > 0 {
    true => world.player_state[index].collected,
    false => current,
  }
}

fn player_collected_for_world(world: World) -> i32 {
  ecs.fold_entities(world, 0, choose_player_collected)
}

fn collectible_touched(
  collectible_value: Collectible,
  transform: Transform2d,
  collider_value: Collider2d,
  world: World
) -> bool {
  let found = player_found(world);
  let player_rect = player_rect_for_world(world);
  let player_exists = found > 0;
  let active_collectible = collectible_value.active > 0;
  let active_collider = collider_value.active > 0;
  let touches_player = overlaps(
    player_rect,
    rect_for_entity(transform, collider_value)
  );
  match player_exists,
    active_collectible,
    active_collider,
    touches_player
  {
    true, true, true, true => true,
    _ => false,
  }
}

fn collect_delta_entity(
  delta: CollectDelta,
  index: EntityId,
  world: World
) -> CollectDelta {
  let found = player_found(world);
  let player_rect = player_rect_for_world(world);
  let player_exists = found > 0;
  let active_collectible = world.collectible[index].active
    > 0;
  let active_collider = world.collider[index].active > 0;
  let touches_player = overlaps(
    player_rect,
    rect_for_entity(
      world.transform[index],
      world.collider[index]
    )
  );
  let collected = match player_exists,
    active_collectible,
    active_collider,
    touches_player
  {
    true, true, true, true => true,
    _ => false,
  };
  CollectDelta {
    score: match collected {
      true => delta.score + world.collectible[index].value,
      false => delta.score,
    },
    sound: match collected {
      true => world.collectible[index].sound,
      false => delta.sound,
    }
  }
}

fn collect_delta(world: World) -> CollectDelta {
  match player_found(world) > 0 {
    true => ecs.fold_entities(
      world,
      CollectDelta {score: 0, sound: sound_none()},
      collect_delta_entity
    ),
    false => CollectDelta {score: 0, sound: sound_none()},
  }
}

type fn HazardScan() -> type {
  let HazardScan = {
    player_rect: Rect,
    hurt: bool
  };
  struct(HazardScan)
}

fn hazard_entity(
  scan: HazardScan,
  index: EntityId,
  world: World
) -> HazardScan {
  let patrolling = world.patrol[index].active > 0;
  let active_collider = world.collider[index].active > 0;
  let touches_player = overlaps(
    scan.player_rect,
    rect_for_entity(
      world.transform[index],
      world.collider[index]
    )
  );
  let hazard = match patrolling,
    active_collider,
    touches_player
  {
    true, true, true => true,
    _ => false,
  };
  HazardScan {
    player_rect: scan.player_rect,
    hurt: combine_hurt(scan.hurt, hazard)
  }
}

fn hazard_scan(
  player_rect: Rect,
  world: World,
  initial: bool
) -> bool {
  ecs.fold_entities(
    world,
    HazardScan {player_rect: player_rect, hurt: initial},
    hazard_entity
  ).hurt
}

fn update_player_collect(
  row: struct({
    player_state: PlayerState,
    player_control: PlayerControl
  }),
  world: World
) -> struct({player_state: PlayerState}) {
  let delta = collect_delta(world);
  let is_player = row.player_control.enabled > 0;
  let collected = delta.score > 0;
  {
    player_state: match is_player,
      collected
    {
      true, true => PlayerState {
        lives: row.player_state.lives,
        mode: row.player_state.mode,
        collected: row.player_state.collected + delta.score,
        sound: delta.sound
      },
      _, _ => row.player_state,
    },
  }
}

fn update_collectible(
  row: struct({
    collectible: Collectible,
    transform: Transform2d,
    collider: Collider2d
  }),
  world: World
) -> struct({collectible: Collectible}) {
  let collected = collectible_touched(
    row.collectible,
    row.transform,
    row.collider,
    world
  );
  {
    collectible: Collectible {
      active: match collected {
        true => 0,
        false => row.collectible.active,
      },
      collected: match collected {
        true => 1,
        false => row.collectible.collected,
      },
      sound: row.collectible.sound,
      value: row.collectible.value
    }
  }
}

fn update_collectible_sprite(row: struct({
  sprite: Sprite2d,
  collectible: Collectible,
  transform: Transform2d,
  collider: Collider2d
})) -> struct({sprite: Sprite2d}) {
  let hidden = row.collectible.collected > 0;
  {
    sprite: Sprite2d {
      atlas: row.sprite.atlas,
      sx: row.sprite.sx,
      sy: row.sprite.sy,
      sw: row.sprite.sw,
      sh: row.sprite.sh,
      w: row.sprite.w,
      h: row.sprite.h,
      flip_x: row.sprite.flip_x,
      z: row.sprite.z,
      visible: match hidden {
        true => 0,
        false => row.sprite.visible,
      }
    }
  }
}

fn collect_system() -> GameSystems {
  do @monad(ecs.System(World, FrameInput)) {
    ecs.map_with_world(player_collect_q, update_player_collect);
    ecs.map_with_world(collectible_q, update_collectible);
    ecs.map(collectible_sprite_q, update_collectible_sprite);
  }
}

fn combine_hurt(current: bool, next: bool) -> bool {
  match current,
    next
  {
    true, _ => true,
    false, value => value,
  }
}

fn player_hurt(
  transform: Transform2d,
  collider_value: Collider2d,
  snapshot: World
) -> bool {
  let player_rect = rect_for_entity(
    transform,
    collider_value
  );
  let spike = spike_rect();
  let touches_spike = overlaps(player_rect, spike);
  let fell = transform.y > 180;
  let hurt = hazard_scan(
    player_rect,
    snapshot,
    match touches_spike,
      fell
    {
      true, _ => true,
      false, true => true,
      false, false => false,
    }
  );
  hurt
}

fn reset_lives(state: PlayerState) -> PlayerState {
  let lives = state.lives - 1;
  let mode = match lives <= 0 {
    true => mode_dead,
    false => mode_play
  };
  PlayerState {
    lives: lives,
    mode: mode,
    collected: state.collected,
    sound: sound_hurt()
  }
}

fn reset_player_transform(
  row: struct({
    transform: Transform2d,
    player_control: PlayerControl,
    collider: Collider2d
  }),
  world: World
) -> struct({transform: Transform2d}) {
  let is_player = row.player_control.enabled > 0;
  let hurt = player_hurt(
    row.transform,
    row.collider,
    world
  );
  {
    transform: match is_player,
      hurt
    {
      true, true => Transform2d {x: 24, y: 104, z: 5},
      _, _ => row.transform,
    }
  }
}

fn reset_player_velocity(
  row: struct({
    velocity: Velocity2d,
    player_control: PlayerControl,
    transform: Transform2d,
    collider: Collider2d
  }),
  world: World
) -> struct({velocity: Velocity2d}) {
  let is_player = row.player_control.enabled > 0;
  let hurt = player_hurt(
    row.transform,
    row.collider,
    world
  );
  {
    velocity: match is_player,
      hurt
    {
      true, true => Velocity2d {x: 0, y: 0},
      _, _ => row.velocity,
    }
  }
}

fn reset_player_grounded(
  row: struct({
    grounded: Grounded,
    player_control: PlayerControl,
    transform: Transform2d,
    collider: Collider2d
  }),
  world: World
) -> struct({grounded: Grounded}) {
  let is_player = row.player_control.enabled > 0;
  let hurt = player_hurt(
    row.transform,
    row.collider,
    world
  );
  {
    grounded: match is_player,
      hurt
    {
      true, true => Grounded {value: 0},
      _, _ => row.grounded,
    }
  }
}

fn reset_player_state(
  row: struct({
    player_state: PlayerState,
    player_control: PlayerControl,
    transform: Transform2d,
    collider: Collider2d
  }),
  world: World
) -> struct({player_state: PlayerState}) {
  let is_player = row.player_control.enabled > 0;
  let hurt = player_hurt(
    row.transform,
    row.collider,
    world
  );
  {
    player_state: match is_player,
      hurt
    {
      true, true => reset_lives(row.player_state),
      _, _ => row.player_state,
    }
  }
}

fn hazard_system() -> GameSystems {
  do @monad(ecs.System(World, FrameInput)) {
    ecs.map_with_world(hazard_state_q, reset_player_state);
    ecs.map_with_world(hazard_velocity_q, reset_player_velocity);
    ecs.map_with_world(hazard_grounded_q, reset_player_grounded);
    ecs.map_with_world(hazard_transform_q, reset_player_transform);
  }
}

fn update_win_state(row: struct({
  player_state: PlayerState,
  player_control: PlayerControl
})) -> struct({player_state: PlayerState}) {
  let is_player = row.player_control.enabled > 0;
  let won = row.player_state.collected >= 4;
  {
    player_state: match is_player,
      won
    {
      true, true => PlayerState {
        lives: row.player_state.lives,
        mode: mode_win,
        collected: row.player_state.collected,
        sound: sound_win()
      },
      _, _ => row.player_state,
    },
  }
}

fn win_system() -> GameSystems {
  do @monad(ecs.System(World, FrameInput)) {
    ecs.map(win_q, update_win_state);
  }
}

fn animate_sprite_row(row: struct({
  sprite: Sprite2d,
  velocity: Velocity2d,
  grounded: Grounded,
  player_control: PlayerControl,
  patrol: Patrol2d
})) -> struct({sprite: Sprite2d}) {
  let is_player = row.player_control.enabled > 0;
  let is_patrol = row.patrol.active > 0;
  {
    sprite: Sprite2d {
      atlas: row.sprite.atlas,
      sx: match is_player,
        row.grounded.value == 0,
        row.velocity.y < 0,
        row.velocity.x == 0
      {
        true, true, true, _ => 64,
        true, true, false, _ => 96,
        true, false, _, true => 0,
        true, false, _, false => 32,
        false, _, _, _ => row.sprite.sx,
      },
      sy: row.sprite.sy,
      sw: row.sprite.sw,
      sh: row.sprite.sh,
      w: row.sprite.w,
      h: row.sprite.h,
      flip_x: match is_player,
        is_patrol,
        row.velocity.x < 0
      {
        true, _, true => 1,
        true, _, false => 0,
        false, true, true => 1,
        false, true, false => 0,
        false, false, _ => row.sprite.flip_x,
      },
      z: row.sprite.z,
      visible: row.sprite.visible
    }
  }
}

fn animation_system() -> GameSystems {
  do @monad(ecs.System(World, FrameInput)) {
    ecs.map(animation_q, animate_sprite_row);
  }
}

fn gameplay_systems() -> GameSystems {
  do @monad(ecs.System(World, FrameInput)) {
    clear_sound_system();
    patrol_system();
    physics_system();
    collision_system();
    hazard_system();
    collect_system();
    win_system();
    animation_system();
  }
}

pub fn step_world(world: World, input: FrameInput) -> World {
  let current = match input.restart > 0 {
    true => init_world(),
    false => world
  };
  let active = player_mode_for_world(current) == mode_play;
  match active {
    true => ecs.run(current, input, gameplay_systems),
    false => current,
  }
}

fn play_sound(sound: asset.Handle(#sound)) -> i32 !{audio} {
  match asset.same(sound, sound_jump()),
    asset.same(sound, sound_coin()),
    asset.same(sound, sound_hurt()),
    asset.same(sound, sound_power()),
    asset.same(sound, sound_win())
  {
    true, _, _, _, _ => audio.play(sound_jump()),
    false, true, _, _, _ => audio.play(sound_coin()),
    false, false, true, _, _ => audio.play(sound_hurt()),
    false, false, false, true, _ => audio.play(sound_power()),
    false, false, false, false, true => audio.play(sound_win()),
    false, false, false, false, false => 0
  }
}

fn draw_sprite_entity(
  canvas_handle: i32,
  transform: Transform2d,
  sprite_value: Sprite2d
) -> i32 !{gpu} {
  match sprite_value.visible > 0 {
    true => canvas.draw_sprite(
      canvas_handle,
      {
        atlas: sprite_value.atlas,
        sx: sprite_value.sx,
        sy: sprite_value.sy,
        sw: sprite_value.sw,
        sh: sprite_value.sh,
        dx: transform.x,
        dy: transform.y,
        dw: sprite_value.w,
        dh: sprite_value.h,
        flip_x: sprite_value.flip_x,
        z: sprite_value.z
      }
    ),
    false => 0,
  }
}

fn draw_entities_loop(
  canvas_handle: i32,
  world: World,
  cursor: core.IndexCursor(entity_capacity),
  drawn: i32
) -> i32 !{gpu} {
  match core.IndexCursor::next(entity_capacity, cursor) {
    Yield(index, next) => match index < world.len {
      true => draw_entities_loop(
        canvas_handle,
        world,
        next,
        drawn + draw_sprite_entity(
          canvas_handle,
          world.transform[index],
          world.sprite[index]
        )
      ),
      false => drawn,
    },
    Done => drawn,
  }
}

fn draw_entities(canvas_handle: i32, world: World) -> i32 !{gpu} {
  draw_entities_loop(
    canvas_handle,
    world,
    core.IndexCursor::start(entity_capacity),
    0
  )
}

fn draw_tile(
  canvas_handle: i32,
  tile: i32,
  x: i32,
  y: i32
) -> i32 !{gpu} {
  canvas.draw_sprite(
    canvas_handle,
    {
      atlas: atlas_world(),
      sx: tile * 16,
      sy: 0,
      sw: 16,
      sh: 16,
      dx: x,
      dy: y,
      dw: 16,
      dh: 16,
      flip_x: 0,
      z: 1
    }
  )
}

fn draw_level(canvas_handle: i32) -> i32 !{gpu} {
  let g0 = draw_tile(canvas_handle, 1, 0, 148);
  let g1 = draw_tile(canvas_handle, 2, 32, 148);
  let g2 = draw_tile(canvas_handle, 2, 64, 148);
  let g3 = draw_tile(canvas_handle, 2, 96, 148);
  let g4 = draw_tile(canvas_handle, 2, 128, 148);
  let p1 = draw_tile(canvas_handle, 2, 28, 116);
  let p2 = draw_tile(canvas_handle, 2, 108, 94);
  let p3 = draw_tile(canvas_handle, 2, 180, 76);
  let spike = canvas.draw_sprite(
    canvas_handle,
    {
      atlas: atlas_platforms(),
      sx: 0,
      sy: 16,
      sw: 16,
      sh: 16,
      dx: 92,
      dy: 132,
      dw: 24,
      dh: 16,
      flip_x: 0,
      z: 2
    }
  );
  g0 + g1 + g2 + g3 + g4 + p1 + p2 + p3 + spike
}

pub fn render_world(
  target: i32,
  width: i32,
  height: i32,
  world: World
) -> i32 !{canvas, gpu, audio} {
  let canvas_handle = canvas.gpu_begin_frame(
    target,
    width,
    height
  );
  let music = audio.music(music_theme(), 1);
  let level = draw_level(canvas_handle);
  let entities = draw_entities(canvas_handle, world);
  let sound = play_sound(player_sound_for_world(world));
  let presented = canvas.gpu_present(canvas_handle);
  canvas_handle
    + music
    + level
    + entities
    + sound
    + presented
}

pub fn world_len(world: World) -> i32 {
  world.len
}

pub fn player_x(world: World) -> i32 {
  player_x_for_world(world)
}

pub fn player_y(world: World) -> i32 {
  player_y_for_world(world)
}

pub fn coin_count(world: World) -> i32 {
  player_collected_for_world(world)
}
