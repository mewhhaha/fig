const ecs = @import("engine.ecs");
const canvas = @import("web.canvas");
const audio = @import("web.audio");
const asset = @import("web.asset");
const core = @import("prelude.core");
const entity_capacity: count = 8;

type fn EntityId() -> type {
  ecs.BatchIndex(entity_capacity)
}

fn atlas_world() -> asset.Handle(#texture) {
  canvas.texture(1)
}

fn atlas_knight() -> asset.Handle(#texture) {
  canvas.texture(2)
}

fn atlas_coin() -> asset.Handle(#texture) {
  canvas.texture(3)
}

fn atlas_fruit() -> asset.Handle(#texture) {
  canvas.texture(4)
}

fn atlas_slime() -> asset.Handle(#texture) {
  canvas.texture(5)
}

fn atlas_platforms() -> asset.Handle(#texture) {
  canvas.texture(6)
}

fn sound_none() -> asset.Handle(#sound) {
  audio.sound(0)
}

fn sound_jump() -> asset.Handle(#sound) {
  audio.sound(1)
}

fn sound_coin() -> asset.Handle(#sound) {
  audio.sound(2)
}

fn sound_hurt() -> asset.Handle(#sound) {
  audio.sound(3)
}

fn sound_power() -> asset.Handle(#sound) {
  audio.sound(4)
}

fn sound_win() -> asset.Handle(#sound) {
  audio.sound(5)
}

fn music_theme() -> asset.Handle(#music) {
  audio.music_track(1)
}

const mode_play: i32 = 0;
const mode_dead: i32 = 1;
const mode_win: i32 = 2;

type fn Transform2d() -> type {
  let Transform2d = {x: i32, y: i32, z: i32};
  struct(Transform2d)
}

type fn Velocity2d() -> type {
  let Velocity2d = {
    x: i32,
    y: i32
  };
  struct(Velocity2d)
}

type fn Gravity2d() -> type {
  let Gravity2d = {value: i32};
  struct(Gravity2d)
}

type fn Grounded() -> type {
  let Grounded = {value: i32};
  struct(Grounded)
}

type fn PlayerControl() -> type {
  let PlayerControl = {
    enabled: i32,
    speed: i32,
    jump_impulse: i32
  };
  struct(PlayerControl)
}

type fn Sprite2d() -> type {
  let Sprite2d = {
    atlas: asset.Handle(#texture),
    sx: i32,
    sy: i32,
    sw: i32,
    sh: i32,
    w: i32,
    h: i32,
    flip_x: i32,
    z: i32,
    visible: i32
  };
  struct(Sprite2d)
}

type fn Collider2d() -> type {
  let Collider2d = {
    offset_x: i32,
    offset_y: i32,
    w: i32,
    h: i32,
    active: i32
  };
  struct(Collider2d)
}

type fn Patrol2d() -> type {
  let Patrol2d = {
    active: i32,
    dir: i32,
    min_x: i32,
    max_x: i32
  };
  struct(Patrol2d)
}

type fn Collectible() -> type {
  let Collectible = {
    active: i32,
    collected: i32,
    sound: asset.Handle(#sound),
    value: i32
  };
  struct(Collectible)
}

type fn PlayerState() -> type {
  let PlayerState = {
    lives: i32,
    mode: i32,
    collected: i32,
    sound: asset.Handle(#sound)
  };
  struct(PlayerState)
}

type fn FrameInput() -> type {
  let FrameInput = {
    dt_ms: i32,
    axis_x: i32,
    jump: i32,
    restart: i32
  };
  struct(FrameInput)
}

type fn Rect() -> type {
  let Rect = {x: i32, y: i32, w: i32, h: i32};
  struct(Rect)
}

const components = ecs.components({
  transform: Transform2d,
  velocity: Velocity2d,
  gravity: Gravity2d,
  grounded: Grounded,
  player_control: PlayerControl,
  sprite: Sprite2d,
  collider: Collider2d,
  patrol: Patrol2d,
  collectible: Collectible,
  player_state: PlayerState
});

type fn World() -> type {
  let ExpectedWorld = @type_slots(ecs.World(
    8,
    components
  ));
  let World = {
    entities: ecs.Batch(8, EntityId),
    len: i32,
    transform: ecs.Batch(8, Transform2d),
    velocity: ecs.Batch(8, Velocity2d),
    gravity: ecs.Batch(8, Gravity2d),
    grounded: ecs.Batch(8, Grounded),
    player_control: ecs.Batch(8, PlayerControl),
    sprite: ecs.Batch(8, Sprite2d),
    collider: ecs.Batch(8, Collider2d),
    patrol: ecs.Batch(8, Patrol2d),
    collectible: ecs.Batch(8, Collectible),
    player_state: ecs.Batch(8, PlayerState)
  };
  let WorldMatchesEcs = @require(
    World == ExpectedWorld,
    "brackeys platformer World must match ecs.World"
  );
  struct(World)
}

type fn GameSystems() -> type {
  ecs.System(World, FrameInput)
}

type fn CollectDelta() -> type {
  let CollectDelta = {
    score: i32,
    sound: asset.Handle(#sound)
  };
  struct(CollectDelta)
}

let velocity_q = do @applicative(ecs.Query(
  World,
  FrameInput
)) {
  velocity <- ecs.write(#velocity);
  gravity <- ecs.read(#gravity);
  player_control <- ecs.read(#player_control);
  grounded <- ecs.read(#grounded);
  input <- ecs.res();
  pure({
    velocity,
    gravity,
    player_control,
    grounded,
    input
  })
}

;
let movement_q = do @applicative(ecs.Query(
  World,
  FrameInput
)) {
  transform <- ecs.write(#transform);
  velocity <- ecs.read(#velocity);
  input <- ecs.res();
  pure({transform, velocity, input})
}

;
let grounded_q = do @applicative(ecs.Query(
  World,
  FrameInput
)) {
  grounded <- ecs.write(#grounded);
  pure({grounded})
}

;
let collision_velocity_q = do @applicative(ecs.Query(
  World,
  FrameInput
)) {
  transform <- ecs.read(#transform);
  velocity <- ecs.write(#velocity);
  grounded <- ecs.read(#grounded);
  gravity <- ecs.read(#gravity);
  collider <- ecs.read(#collider);
  pure({
    transform,
    velocity,
    gravity,
    grounded,
    collider
  })
}

;
