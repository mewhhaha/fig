const brackeys = @import("examples.brackeys_platformer_core");

type fn World() -> type {
  brackeys.World
}

type fn FrameInput() -> type {
  brackeys.FrameInput
}

type fn GameSystems() -> type {
  brackeys.GameSystems
}

const scene = {
  player_x: 18,
  player_y: 169,
  slime_x: 517,
  slime_y: 217,
  slime_min_x: 496,
  slime_max_x: 560,
  coin0_x: 65,
  coin0_y: 220,
  coin1_x: 209,
  coin1_y: 221,
  coin2_x: 224,
  coin2_y: 221,
  coin3_x: 96,
  coin3_y: 108,
  coin4_x: 495,
  coin4_y: 189,
  coin5_x: 749,
  coin5_y: 127,
  coin6_x: 768,
  coin6_y: 127,
  coin7_x: 787,
  coin7_y: 127,
  coin8_x: 576,
  coin8_y: 44
};

pub fn init_world() -> World {
  brackeys.init_world()
}

fn gameplay_systems(systems: GameSystems) -> GameSystems {
  systems
    \s -> brackeys.patrol_systems(s)
    \s -> brackeys.movement_systems(s)
    \s -> brackeys.hazard_systems(s)
    \s -> brackeys.collectible_systems(s)
    \s -> brackeys.animation_systems(s)
}

pub fn input_key(world: World, key: i32, down: i32) -> World {
  brackeys.input_key(world, key, down)
}

pub fn input_pointer(
  world: World,
  axis_x: i32,
  jump: i32,
  active: i32
) -> World {
  brackeys.input_pointer(world, axis_x, jump, active)
}

pub fn step_world(world: World, dt_ms: i32) -> World {
  brackeys.frame_input_for_world(world, dt_ms)
    \input -> brackeys.step_game_world(world, input)
}

pub fn render_world(
  target: i32,
  width: i32,
  height: i32,
  world: World
) -> i32 !{canvas, gpu, audio} {
  brackeys.render_world(target, width, height, world)
}

pub fn world_len(world: World) -> i32 {
  brackeys.world_len(world)
}

pub fn player_x(world: World) -> i32 {
  brackeys.player_x(world)
}

pub fn player_y(world: World) -> i32 {
  brackeys.player_y(world)
}

pub fn coin_count(world: World) -> i32 {
  brackeys.coin_count(world)
}

pub fn input_axis(world: World) -> i32 {
  brackeys.input_axis(world)
}

pub fn input_jump(world: World) -> i32 {
  brackeys.input_jump(world)
}
