const merge = @import("prelude.std");

fn inc(x: i32) -> i32 {
  x + 1
}

fn add(a: i32, b: i32) -> i32 {
  a + b
}

fn keep_gt_two(x: i32) -> bool {
  x > 2
}

pub fn main() -> i32 {
  let xs: merge.array.layout.Lane4I32 = <1, 2, 3, 4>;
  merge.array.fold4_i32(add, 0, merge.array.map4_i32(inc, xs))
}
