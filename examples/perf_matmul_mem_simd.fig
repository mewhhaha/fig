type fn InlineArray(n: count, a: type) -> type {
  let InlineArray = {n*a};
  struct(InlineArray)
}

type fn Lane4I32() -> type {
  InlineArray(4, i32)
}

type fn Ptr(a: type) -> type {
  let Ptr = {addr: i32};
  struct(Ptr)
}

type fn I32Ptr() -> type {
  Ptr(i32)
}

type fn Lane4I32Ptr() -> type {
  Ptr(Lane4I32)
}

fn memory.load_lane4_i32(mem: memory, p: Ptr(Lane4I32)) -> Lane4I32 {
  @memory_load_lane4_i32(mem, p)
}
fn memory.store_lane4_i32(mem: memory, p: Ptr(Lane4I32), value: Lane4I32) -> memory {
  @memory_store_lane4_i32(mem, p, value)
}
fn Ptr.from_i32(addr: i32) -> Ptr(a) {
  @ptr_from_i32(addr)
}
fn Ptr.add(p: Ptr(a), bytes: i32) -> Ptr(a) {
  @ptr_add(p, bytes)
}

pub fn main(mem0: memory, a: i32, b: i32, c: i32) -> memory {
  let ap: Ptr(Lane4I32) = Ptr.from_i32(a);
  let bp: Ptr(Lane4I32) = Ptr.from_i32(b);
  let cp: Ptr(Lane4I32) = Ptr.from_i32(c);
  let ap01, ap23 = fork(ap);
  let ap0, ap1 = fork(ap01);
  let ap2, ap3 = fork(ap23);
  let bp01, bp23 = fork(bp);
  let bp0, bp1 = fork(bp01);
  let bp2, bp3 = fork(bp23);
  let cp01, cp23 = fork(cp);
  let cp0, cp1 = fork(cp01);
  let cp2, cp3 = fork(cp23);

  let r0: Lane4I32 = memory.load_lane4_i32(mem0, ap0);
  let r1: Lane4I32 = memory.load_lane4_i32(mem0, Ptr.add(ap1, 16));
  let r2: Lane4I32 = memory.load_lane4_i32(mem0, Ptr.add(ap2, 32));
  let r3: Lane4I32 = memory.load_lane4_i32(mem0, Ptr.add(ap3, 48));

  let c0: Lane4I32 = memory.load_lane4_i32(mem0, bp0);
  let c1: Lane4I32 = memory.load_lane4_i32(mem0, Ptr.add(bp1, 16));
  let c2: Lane4I32 = memory.load_lane4_i32(mem0, Ptr.add(bp2, 32));
  let c3: Lane4I32 = memory.load_lane4_i32(mem0, Ptr.add(bp3, 48));

  let mem1: memory = memory.store_lane4_i32(mem0, cp0, <
    r0[0] * c0[0] + r0[1] * c0[1] + r0[2] * c0[2] + r0[3] * c0[3],
    r0[0] * c1[0] + r0[1] * c1[1] + r0[2] * c1[2] + r0[3] * c1[3],
    r0[0] * c2[0] + r0[1] * c2[1] + r0[2] * c2[2] + r0[3] * c2[3],
    r0[0] * c3[0] + r0[1] * c3[1] + r0[2] * c3[2] + r0[3] * c3[3]
  >);
  let mem2: memory = memory.store_lane4_i32(mem1, Ptr.add(cp1, 16), <
    r1[0] * c0[0] + r1[1] * c0[1] + r1[2] * c0[2] + r1[3] * c0[3],
    r1[0] * c1[0] + r1[1] * c1[1] + r1[2] * c1[2] + r1[3] * c1[3],
    r1[0] * c2[0] + r1[1] * c2[1] + r1[2] * c2[2] + r1[3] * c2[3],
    r1[0] * c3[0] + r1[1] * c3[1] + r1[2] * c3[2] + r1[3] * c3[3]
  >);
  let mem3: memory = memory.store_lane4_i32(mem2, Ptr.add(cp2, 32), <
    r2[0] * c0[0] + r2[1] * c0[1] + r2[2] * c0[2] + r2[3] * c0[3],
    r2[0] * c1[0] + r2[1] * c1[1] + r2[2] * c1[2] + r2[3] * c1[3],
    r2[0] * c2[0] + r2[1] * c2[1] + r2[2] * c2[2] + r2[3] * c2[3],
    r2[0] * c3[0] + r2[1] * c3[1] + r2[2] * c3[2] + r2[3] * c3[3]
  >);
  memory.store_lane4_i32(mem3, Ptr.add(cp3, 48), <
    r3[0] * c0[0] + r3[1] * c0[1] + r3[2] * c0[2] + r3[3] * c0[3],
    r3[0] * c1[0] + r3[1] * c1[1] + r3[2] * c1[2] + r3[3] * c1[3],
    r3[0] * c2[0] + r3[1] * c2[1] + r3[2] * c2[2] + r3[3] * c2[3],
    r3[0] * c3[0] + r3[1] * c3[1] + r3[2] * c3[2] + r3[3] * c3[3]
  >)
}
