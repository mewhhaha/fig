const merge = @import("prelude.std");

type fn Point() -> type {
  let Point = {x: i32, y: i32};
  struct(Point)
}

fn Point::eql(a: Point, b: Point) -> bool {
  a.x == b.x
}

fn Point::append(a: Point, b: Point) -> Point {
  Point {x: a.x + b.x, y: a.y + b.y}
}

type fn Box(a: type) -> type {
  let Box = {value: a};
  struct(Box)
}

fn Box::map(const f: fn(x: a) -> b, v: Box(a)) -> Box(b) {
  Box {value: f(v.value)}
}

fn Box::bind(v: Box(a), const f: fn(x: a) -> Box(b)) -> Box(b) {
  f(v.value)
}

fn inc(x: i32) -> i32 {
  x + 1
}

fn wrap(x: i32) -> Box(i32) {
  Box {value: x + 10}
}

pub fn main() -> i32 {
  let point_total = append(Point, Semigroup(Point), Point {x: 1, y: 2}, Point {x: 3, y: 4});
  let boxed = bind(fmap(Box {value: 1}, inc, Functor(Box)), wrap, Monad(Box));
  point_total.x + point_total.y + boxed.value
}
