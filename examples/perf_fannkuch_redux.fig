const operators = @import("prelude.operators");

// Adapted from the Computer Language Benchmarks Game fannkuch-redux benchmark
// materials, which are distributed under the BSD 3-Clause license.
const layout = @import("prelude.layout");

type fn Perm7() -> type {
  layout.InlineArray(7, u3)
}

type fn State() -> type {
  let State = {perm: Perm7, count: Perm7, r: i32, index: i32, checksum: i32, max_flips: i32};
  struct(State)
}

fn dec(x: u3) -> u3 {
  x - 1
}

fn max_i32(a: i32, b: i32) -> i32 {
  if a < b {
    b
  } else {
    a
  }
}

fn swap(xs: Perm7, left: i32, right: i32) -> Perm7 {
  let a = xs[left];
  let b = xs[right];
  layout.InlineArray::set(7, u3, xs, left, b)
    \ys -> layout.InlineArray::set(7, u3, ys, right, a)
}

fn reverse_prefix_loop(
  xs: Perm7,
  left: i32,
  right: i32
) -> Perm7 {
  if left < right {
    reverse_prefix_loop(
      swap(xs, left, right),
      left + 1,
      right - 1
    )
  } else {
    xs
  }
}

fn flip_count_loop(xs: Perm7, flips: i32) -> i32 {
  let first: u3 = xs[0];
  if first != 0 {
    flip_count_loop(
      reverse_prefix_loop(xs, 0, first),
      flips + 1
    )
  } else {
    flips
  }
}

fn score(state: State) -> State {
  let flips = flip_count_loop(state.perm, 0);
  State {
    perm: state.perm,
    count: state.count,
    r: state.r,
    index: state.index,
    checksum: if state.index
      % 2
      == 0 {
      state.checksum + flips
    } else {
      state.checksum - flips
    },
    max_flips: max_i32(state.max_flips, flips),
  }
}

fn prepare(state: State) -> State {
  if state.r != 1 {
    prepare(State {
      perm: state.perm,
      count: layout.InlineArray::set(
        7,
        u3,
        state.count,
        state.r - 1,
        state.r
      ),
      r: state.r - 1,
      index: state.index,
      checksum: state.checksum,
      max_flips: state.max_flips,
    })
  } else {
    state
  }
}

fn rotate_left_loop(
  xs: Perm7,
  i: i32,
  r: i32,
  first: u3
) -> Perm7 {
  if i < r {
    rotate_left_loop(
      layout.InlineArray::set(7, u3, xs, i, xs[i + 1]),
      i + 1,
      r,
      first
    )
  } else {
    layout.InlineArray::set(7, u3, xs, r, first)
  }
}

fn rotate_left(xs: Perm7, r: i32) -> Perm7 {
  let first: u3 = xs[0];
  rotate_left_loop(xs, 0, r, first)
}

fn step_continue(state: State, r: i32) -> State {
  let old_count = state.count[r];
  let rotated = rotate_left(state.perm, r);
  let count = layout.InlineArray::update(
    7,
    u3,
    state.count,
    r,
    dec
  );
  if old_count > 1 {
    State {
      perm: rotated,
      count: count,
      r: r,
      index: state.index + 1,
      checksum: state.checksum,
      max_flips: state.max_flips,
    }
  } else {
    step_active(
      State {
        perm: rotated,
        count: count,
        r: r + 1,
        index: state.index,
        checksum: state.checksum,
        max_flips: state.max_flips,
      },
      r + 1
    )
  }
}

fn step_active(state: State, r: i32) -> State {
  if r == 7 {
    state
  } else {
    step_continue(state, r)
  }
}

fn advance(state: State, r: i32) -> State {
  step_active(state, r)
}

fn search(state: State) -> State {
  let prepared = prepare(state);
  let scored = score(prepared);
  let next = advance(scored, scored.r);
  if next.r == 7 {
    next
  } else {
    search(next)
  }
}

pub fn main(seed: i32) -> i32 {
  let initial = State {
    perm: #[seed - seed, 1, 2, 3, 4, 5, 6],
    count: #[0, 0, 0, 0, 0, 0, 0],
    r: 7,
    index: 0,
    checksum: 0,
    max_flips: 0,
  };
  let result = search(initial);
  result.checksum * 100 + result.max_flips
}
