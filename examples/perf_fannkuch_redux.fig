// Adapted from the Computer Language Benchmarks Game fannkuch-redux benchmark
// materials, which are distributed under the BSD 3-Clause license.
const layout = @import("prelude.layout");

type fn Perm7() -> type {
  layout.InlineArray(7, u3)
}

type fn State() -> type {
  let State = {perm: Perm7, count: Perm7, r: i32, index: i32, checksum: i32, max_flips: i32};
  struct(State)
}

fn dec(x: u3) -> u3 {
  x - 1
}

fn max_i32(a: i32, b: i32) -> i32 {
  match a < b {
    true => b,
    false => a,
  }
}

fn swap(xs: Perm7, left: i32, right: i32) -> Perm7 {
  let a = xs[left];
  let b = xs[right];
  layout.InlineArray.set(7, u3, xs, left, b)
    \ys -> layout.InlineArray.set(7, u3, ys, right, a)
}

fn reverse_prefix_loop(
  xs: Perm7,
  left: i32,
  right: i32
) -> Perm7 {
  match left < right {
    true => reverse_prefix_loop(
      swap(xs, left, right),
      left + 1,
      right - 1
    ),
    false => xs,
  }
}

fn flip_count_loop(xs: Perm7, flips: i32) -> i32 {
  let first: u3 = xs[0];
  match first != 0 {
    true => flip_count_loop(
      reverse_prefix_loop(xs, 0, first),
      flips + 1
    ),
    false => flips,
  }
}

fn score(state: State) -> State {
  let flips = flip_count_loop(state.perm, 0);
  State {
    perm: state.perm,
    count: state.count,
    r: state.r,
    index: state.index,
    checksum: match state.index
      % 2
      == 0 {
      true => state.checksum + flips,
      false => state.checksum - flips,
    },
    max_flips: max_i32(state.max_flips, flips),
  }
}

fn prepare(state: State) -> State {
  match state.r != 1 {
    true => prepare(State {
      perm: state.perm,
      count: layout.InlineArray.set(
        7,
        u3,
        state.count,
        state.r - 1,
        state.r
      ),
      r: state.r - 1,
      index: state.index,
      checksum: state.checksum,
      max_flips: state.max_flips,
    }),
    false => state,
  }
}

fn rotate_left_loop(
  xs: Perm7,
  i: i32,
  r: i32,
  first: u3
) -> Perm7 {
  match i < r {
    true => rotate_left_loop(
      layout.InlineArray.set(7, u3, xs, i, xs[i + 1]),
      i + 1,
      r,
      first
    ),
    false => layout.InlineArray.set(
      7,
      u3,
      xs,
      r,
      first
    ),
  }
}

fn rotate_left(xs: Perm7, r: i32) -> Perm7 {
  xs[0] \first -> rotate_left_loop(xs, 0, r, first)
}

fn advance(state: State, r: i32) -> State {
  match r == 7 {
    true => state,
    false => state.count[r]
      \old_count ->(rotate_left(state.perm, r)
      \rotated ->(layout.InlineArray.update(
      7,
      u3,
      state.count,
      r,
      dec
    )
      \count -> match old_count > 1 {
      true => State {
        perm: rotated,
        count: count,
        r: r,
        index: state.index + 1,
        checksum: state.checksum,
        max_flips: state.max_flips,
      },
      false => advance(
        State {
          perm: rotated,
          count: count,
          r: r + 1,
          index: state.index,
          checksum: state.checksum,
          max_flips: state.max_flips,
        },
        r + 1
      ),
    })),
  }
}

fn search(state: State) -> State {
  prepare(state)
    \prepared ->(score(prepared)
    \scored ->(advance(scored, scored.r)
    \next -> match next.r == 7 {
    true => next,
    false => search(next),
  }))
}

pub fn main(seed: i32) -> i32 {
  State {
    perm: <seed - seed, 1, 2, 3, 4, 5, 6>,
    count: <0, 0, 0, 0, 0, 0, 0>,
    r: 7,
    index: 0,
    checksum: 0,
    max_flips: 0,
  }
    \initial -> search(initial)
    \result -> result.checksum * 100 + result.max_flips
}
