const operators = @import("prelude.operators");

// Futhark/Dex-inspired source API sketch for regular fixed-size arrays.
// Helpers are ergonomic names over explicit inline layouts, not imported DSL primitives.

type fn InlineArray(n: count, a: type) -> type {
  let InlineArray = {n*a};
  struct(InlineArray)
}

type fn Lane4I32() -> type {
  InlineArray(4, i32)
}

type fn Tile2x4I32() -> type {
  InlineArray(2, Lane4I32)
}

type fn Tensor2x2I32() -> type {
  InlineArray(2, InlineArray(2, i32))
}

type fn LaneMapI32(t: type) -> type {
  let LaneMapI32 = {map: fn(x: t) -> t};
  struct(LaneMapI32)
}

fn add1_i32(x: i32) -> i32 {
  x + 1
}

fn add1_lane(x: Lane4I32) -> Lane4I32 {
  #[add1_i32(x[0]), add1_i32(x[1]), add1_i32(x[2]), add1_i32(x[3])]
}

const i32x4_map: LaneMapI32(Lane4I32) = {map: add1_lane};

fn map_lane4(const ops: LaneMapI32(Lane4I32), xs: Lane4I32) -> Lane4I32 {
  ops.map(xs)
}

fn map_tile2x4(const ops: LaneMapI32(Lane4I32), tile: Tile2x4I32) -> Tile2x4I32 {
  #[ops.map(tile[0]), ops.map(tile[1])]
}

fn dot2x2(lhs: Tensor2x2I32, rhs: Tensor2x2I32) -> i32 {
  lhs[0][0] * rhs[0][0] + lhs[0][1] * rhs[0][1] + lhs[1][0] * rhs[1][0] + lhs[1][1] * rhs[1][1]
}

pub fn main() -> i32 {
  let lane: Lane4I32 = #[1, 2, 3, 4];
  let tile: Tile2x4I32 = #[lane, #[5, 6, 7, 8]];
  let mapped = map_tile2x4(i32x4_map, tile);
  let lhs: Tensor2x2I32 = #[#[1, 2], #[3, 4]];
  let rhs: Tensor2x2I32 = #[#[5, 6], #[7, 8]];
  mapped[0][0] + mapped[1][3] + dot2x2(lhs, rhs)
}
