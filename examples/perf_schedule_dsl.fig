// Halide-inspired static schedule vocabulary. These contracts document intent
// while the current backend still emits ordinary scalar code.

type fn InlineArray(n: count, a: type) -> type {
  let InlineArray = {n*a};
  struct(InlineArray)
}

type fn Lane4I32() -> type {
  InlineArray(4, i32)
}

type fn Tile2x4I32() -> type {
  InlineArray(2, Lane4I32)
}

type fn TileSchedule(tile: type) -> type {
  let TileSchedule = {tile_rows: i32, tile_cols: i32};
  struct(TileSchedule)
}

type fn VectorSchedule(lane: type) -> type {
  let VectorSchedule = {lanes: i32};
  struct(VectorSchedule)
}

type fn UnrollSchedule(body: type) -> type {
  let UnrollSchedule = {factor: i32};
  struct(UnrollSchedule)
}

type fn ScheduledTile(tile: type) -> type {
  let ScheduledTile = {
    data: tile,
    tile: TileSchedule(tile),
    vector: VectorSchedule(Lane4I32),
    unroll: UnrollSchedule(tile)
  };
  struct(ScheduledTile)
}

fn make_schedule(data: Tile2x4I32) -> ScheduledTile(Tile2x4I32) {
  {
    data: data,
    tile: {tile_rows: 2, tile_cols: 4},
    vector: {lanes: 4},
    unroll: {factor: 2}
  }
}

fn consume_schedule(plan: ScheduledTile(Tile2x4I32)) -> i32 {
  plan.data[0][0] + plan.data[1][3] + plan.Tile.tile_rows + plan.Tile.tile_cols + plan.vector.lanes + plan.Unroll.factor
}

pub fn main() -> i32 {
  let data: Tile2x4I32 = #[#[1, 2, 3, 4], #[5, 6, 7, 8]];
  consume_schedule(make_schedule(data))
}
