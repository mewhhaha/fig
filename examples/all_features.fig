const operators = @import("prelude.operators");

const clock = @external(
  "clock",
  fn(host: io) -> io(i64)
);
const random = @external(
  "random",
  fn(host: io) -> io(i32)
);

type Id = i32

type fn Pair(a: type) {
  let Pair = {fst: a, snd: a};
  struct(Pair)
}

type Point = struct {x: i32, y: i32}

type Box = struct {value: i32}

type fn Buffer(n: count) {
  let Buffer = {n*i32};
  struct(Buffer)
}

type fn Weird() {
  let Weird = {fst: i32, 4*i32, 1*i32};
  struct(Weird)
}

type fn Thunk() {
  fn() -> i32
}

type Option(a) = union {
  None, Some(value: a)
}

type Result(a) = union {
  Ok(value: a), Err(message: string)
}

type fn Eq(t: type) {
  let Eq = {
    eql: fn(a: t, b: t) -> bool,
    neq: fn(a: t, b: t) -> bool
  };
  match @type_is_product(t) {
    true => struct(Eq),
    false => @compile_error("Eq requires a product type"),
  }
}

type fn Functor(f: type) {
  let Functor = {map: fn(x: f) -> f};
  match @type_has_slot(f, #value) {
    true => struct(Functor),
    false => @compile_error("Functor requires value slot"),
  }
}

type fn Applicative(f: type) {
  let Applicative = {
    pure: fn(x: i32) -> f,
    apply: fn(f: f, x: f) -> f
  };
  match @type_slot_type(f, #value) {
    i32 => struct(Applicative),
    _ => @compile_error("Applicative requires i32 value"),
  }
}

type fn Monad(f: type) {
  let Monad = {bind: fn(x: f) -> f};
  match @type_is_product(f) {
    true => struct(Monad),
    false => @compile_error("Monad requires product type"),
  }
}

fn eql_point(a: Point, b: Point) -> bool {
  a.x == b.x
}

fn neq_point(a: Point, b: Point) -> bool {
  a.x != b.x
}

fn map_box(x: Box) -> Box {
  {value: x.value + 1}
}

fn pure_box(x: i32) -> Box {
  {value: x}
}

fn apply_box(f: Box, x: Box) -> Box {
  {value: f.value + x.value}
}

fn bind_box(x: Box) -> Box {
  {value: x.value + 10}
}

const point_eq: Eq(Point) = {eql: eql_point, neq: neq_point};
const box_functor: Functor(Box) = {map: map_box};
const box_applicative: Applicative(Box) = {pure: pure_box, apply: apply_box};
const box_monad: Monad(Box) = {bind: bind_box};
let module_tag = #Demo;

fn sink(x: i32) -> i32 {
  x
}

fn pair_first(pair: Pair(i32)) -> i32 {
  1
}

fn record_score(point: Point) -> i32 {
  Point.x
}

fn shape_first(weird: Weird) -> i32 {
  weird[0]
}

fn same(a: Point, b: Point) -> i32 {
  match eql_point(a, b) {
    true => 1,
    false => 0,
  }
}

fn mapped(x: Box) -> i32 {
  map_box(x).value
}

fn applied(x: i32) -> i32 {
  apply_box(pure_box(x), {value: 2}).value
}

fn bound(x: Box) -> i32 {
  bind_box(x).value
}

fn Choose(flag: bool) -> i32 {
  match flag {
    true => 1,
    false => 0,
  }
}

fn classify(x: i32) -> i32 {
  match x {
    0 => 0,
    1 => 1,
    _ => 2,
  }
}

pub fn main(host: io) -> i32 {
  let n: Id = 40;
  let point: Point = Point {x: 1, y: 2};
  let xs: Buffer(i32) = #[ 1, 2, 3, 4];
  let pair: Pair(i32) = {fst: 1, snd: 2};
  let weird: Weird = {fst: 1, [0]: 2, [1]: 3, [2]: 4, [3]: 5, [4]: 6};
  let label = "fig";
  let letter = 's';
  let text = ```multi
line```;
  let literal = #Widget;
  let ok = true;
  let span = 1 .. 4;
  let pair_sum = pair.fst + pair.snd;
  let now = clock(host);
  let entropy = random(host);
  let owned = 7;
  let sunk = sink(owned);
  let matched = same(
    Point {x: 1, y: 2},
    Point {x: 1, y: 2}
  );
  let mapped_value = mapped({value: 1});
  let applied_value = applied(2);
  let bound_value = bound({value: 3});
  Choose(ok)
    + classify(1)
    + pair_first(pair)
    + record_score(point)
    + owned
    + sunk
    + matched
    + mapped_value
    + applied_value
    + bound_value
    + n
    + 2
}
