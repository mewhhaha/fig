type fn owned(A: type) -> type {
  let Owned = {value: A};
  struct(Owned)
}

type fn borrow(A: type) -> type {
  let Borrow = {ptr: i32};
  struct(Borrow)
}

type fn arena_ref(Region: type, A: type) -> type {
  let ArenaRef = {region: Region, ptr: i32};
  struct(ArenaRef)
}

type fn inline_array(N: count, A: type) -> type {
  let InlineArray = {N*A};
  struct(InlineArray)
}

type fn words4() -> type {
  inline_array(4, i32)
}

type fn page() -> type {
  let Page = {id: i32};
  struct(Page)
}

type fn copyable(T: type) -> type {
  @require(@type_is_product(T), "Copyable values must have a product layout");
  T
}

type fn owns_value(T: type) -> type {
  @require(@type_has_slot(T, #value), "Owned values must expose a value slot");
  T
}

type fn droppable(T: type) -> type {
  let Expected = fn(v: T) -> i32;
  @require(@type_has_member(T, #drop), "Droppable values require drop");
  @require(@type_member_type(T, #drop) == Expected, "drop has wrong type");
  T
}

fn owned.drop(v: owned(A)) -> i32 {
  0
}

fn copy_i32(v: T, const _proof: copyable(T)) -> T {
  v
}

fn release(v: T) -> i32 {
  const Drop = droppable(T);
  Drop.drop(v)
}

fn retain_value(v: T) -> T {
  const Owned = owns_value(T);
  v
}

pub fn main() -> i32 {
  let owned_i32 = Owned {value: 7};
  let copied = copy_i32(owned_i32.value, copyable(i32));
  let kept = retain_value(owned_i32);
  let view: borrow(i32) = Borrow {ptr: 64};
  let arena: arena_ref(page, i32) = ArenaRef {region: Page {id: 1}, ptr: view.ptr};
  let words: words4 = <1, 2, 3, 4>;
  release(kept) + copied + arena.ptr + words[0]
}
