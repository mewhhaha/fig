const effect = @import("prelude.effect");

type fn DebugLog() -> type {
  i32
}

fn record(value: i32) -> effect.Eff({state: DebugLog}, i32) {
  \ctx -> {
    let next = ctx.state + value;
    {value: next, state: next}
  }
}

fn program() -> effect.Eff({state: DebugLog}, i32) {
  \ctx -> {
    let next = ctx.state + 9;
    {value: next, state: next}
  }
}

pub fn main() -> i32 {
  let result = program()
    \program -> effect.run_state_only(program, 33);
  result.value
}
