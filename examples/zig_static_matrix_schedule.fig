// Zig-style static parameters: concrete matrix shape, operation dictionaries,
// and schedule metadata are encoded in types and const values.

type fn InlineArray(n: count, a: type) -> type {
  let InlineArray = {n*a};
  struct(InlineArray)
}

type fn Row3I32() -> type {
  InlineArray(3, i32)
}

type fn Matrix2x3I32() -> type {
  InlineArray(2, Row3I32)
}

type fn ScaleOps() -> type {
  let ScaleOps = {factor: i32};
  struct(ScaleOps)
}

type fn Schedule2x3() -> type {
  let Schedule2x3 = {rows: i32, cols: i32, vector_width: i32, unroll: i32};
  struct(Schedule2x3)
}

type fn ScheduledMatrix2x3() -> type {
  let ScheduledMatrix2x3 = {
    data: Matrix2x3I32,
    schedule: Schedule2x3
  };
  struct(ScheduledMatrix2x3)
}

fn scale_i32(ops: ScaleOps, x: i32) -> i32 {
  x * ops.factor
}

fn double_i32() -> ScaleOps {
  {factor: 2}
}

fn map2x3(ops: ScaleOps, matrix: Matrix2x3I32) -> Matrix2x3I32 {
  #[
    #[scale_i32(ops, matrix[0][0]), scale_i32(ops, matrix[0][1]), scale_i32(ops, matrix[0][2])],
    #[scale_i32(ops, matrix[1][0]), scale_i32(ops, matrix[1][1]), scale_i32(ops, matrix[1][2])]
  ]
}

fn make_plan(matrix: Matrix2x3I32) -> ScheduledMatrix2x3 {
  {
    data: map2x3(double_i32(), matrix),
    schedule: {rows: 2, cols: 3, vector_width: 4, unroll: 2}
  }
}

fn consume(plan: ScheduledMatrix2x3) -> i32 {
  plan.data[0][0] + plan.data[0][1] + plan.data[1][2] +
    plan.schedule.rows + plan.schedule.cols +
    plan.schedule.vector_width + plan.schedule.unroll + 105
}

pub fn main() -> i32 {
  let matrix: Matrix2x3I32 = #[#[1, 2, 3], #[4, 5, 6]];
  consume(make_plan(matrix))
}
