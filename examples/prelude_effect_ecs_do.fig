const effect = @import("prelude.effect");

type fn FrameInput() -> type {
  let FrameInput = {dt: i32};
  struct(FrameInput)
}

fn program(seed: i32) -> effect.Eff({reader: FrameInput}, i32) {
  \ctx -> {
    seed + ctx.reader.dt
  }
}

pub fn main() -> i32 {
  program(4)
  \program -> effect.run_reader(program, FrameInput {dt: 3})
}
