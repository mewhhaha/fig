fn sprite_region(
  atlas: asset.Handle(#texture),
  sx: i32,
  sy: i32,
  sw: i32,
  sh: i32,
  w: i32,
  h: i32,
  z: i32
) -> Sprite2d {
  Sprite2d {
    atlas: atlas,
    sx: sx,
    sy: sy,
    sw: sw,
    sh: sh,
    w: w,
    h: h,
    flip_x: 0,
    z: z,
    visible: 1
  }
}

fn sprite(
  atlas: asset.Handle(#texture),
  sw: i32,
  sh: i32,
  w: i32,
  h: i32,
  z: i32
) -> Sprite2d {
  sprite_region(atlas, 0, 0, sw, sh, w, h, z)
}

fn collider(
  offset_x: i32,
  offset_y: i32,
  w: i32,
  h: i32
) -> Collider2d {
  Collider2d {offset_x: offset_x, offset_y: offset_y, w: w, h: h, active: 1}
}

fn patrol(dir: i32, min_x: i32, max_x: i32) -> Patrol2d {
  Patrol2d {active: 1, dir: dir, min_x: min_x, max_x: max_x}
}

fn collectible(
  sound: asset.Handle(#sound),
  value: i32
) -> Collectible {
  Collectible {active: 1, collected: 0, sound: sound, value: value}
}

const no_input_state: InputState = InputState {
