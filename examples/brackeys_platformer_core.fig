type fn Transform2d() -> type {
  let Transform2d = {x: i32, y: i32, z: i32};
  struct(Transform2d)
}

type fn Velocity2d() -> type {
  let Velocity2d = {
    x: i32,
    y: i32
  };
  struct(Velocity2d)
}

type fn Gravity2d() -> type {
  let Gravity2d = {value: i32};
  struct(Gravity2d)
}

type fn Grounded() -> type {
  let Grounded = {value: i32};
  struct(Grounded)
}

type fn PlayerControl() -> type {
  let PlayerControl = {
    enabled: i32,
    speed: i32,
    jump_impulse: i32
  };
  struct(PlayerControl)
}

type fn Sprite2d() -> type {
  let Sprite2d = {
    atlas: asset.Handle(#texture),
    sx: i32,
    sy: i32,
    sw: i32,
    sh: i32,
    w: i32,
    h: i32,
    flip_x: i32,
    z: i32,
    visible: i32
  };
  struct(Sprite2d)
}

type fn Animation2d() -> type {
  let Animation2d = {
    clock_ms: i32
  };
  struct(Animation2d)
}

type fn Collider2d() -> type {
  let Collider2d = {
    offset_x: i32,
    offset_y: i32,
    w: i32,
    h: i32,
    active: i32
  };
  struct(Collider2d)
}

type fn Patrol2d() -> type {
  let Patrol2d = {
    active: i32,
    dir: i32,
    min_x: i32,
    max_x: i32
  };
  struct(Patrol2d)
}

type fn Collectible() -> type {
  let Collectible = {
    active: i32,
    collected: i32,
    sound: asset.Handle(#sound),
    value: i32
  };
  struct(Collectible)
}

type fn PlayerState() -> type {
  let PlayerState = {
    lives: i32,
    mode: i32,
    collected: i32,
    sound: asset.Handle(#sound)
