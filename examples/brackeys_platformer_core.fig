    key_restart: i32,
    pointer_active: i32,
    pointer_axis_x: i32,
    pointer_jump: i32
  };
  struct(InputState)
}

type fn Rect() -> type {
  let Rect = {x: i32, y: i32, w: i32, h: i32};
  struct(Rect)
}

const components = ecs.components({
  transform: Transform2d,
  velocity: Velocity2d,
  gravity: Gravity2d,
  grounded: Grounded,
  player_control: PlayerControl,
  sprite: Sprite2d,
  animation: Animation2d,
  collider: Collider2d,
  patrol: Patrol2d,
  collectible: Collectible,
  player_state: PlayerState,
  input_state: InputState
});

type fn World() -> type {
  let ExpectedWorld = @type_slots(ecs.World(components));
  let World = {
    entities: ecs.Batch(i32),
    len: i32,
    transform: ecs.Batch(Transform2d),
    velocity: ecs.Batch(Velocity2d),
    gravity: ecs.Batch(Gravity2d),
    grounded: ecs.Batch(Grounded),
    player_control: ecs.Batch(PlayerControl),
    sprite: ecs.Batch(Sprite2d),
    animation: ecs.Batch(Animation2d),
    collider: ecs.Batch(Collider2d),
    patrol: ecs.Batch(Patrol2d),
    collectible: ecs.Batch(Collectible),
    player_state: ecs.Batch(PlayerState),
    input_state: ecs.Batch(InputState)
  };
  let WorldMatchesEcs = @require(
    World == ExpectedWorld,
    "brackeys platformer World must match ecs.World"
  );
  struct(World)
}

type fn GameSystems() -> type {
  ecs.System(World, FrameInput)
}

type fn EntitySeed() -> type {
  let EntitySeed = {
    transform: Transform2d,
    velocity: Velocity2d,
    gravity: Gravity2d,
    grounded: Grounded,
    player_control: PlayerControl,
    sprite: Sprite2d,
    animation: Animation2d,
    collider: Collider2d,
    patrol: Patrol2d,
    collectible: Collectible,
    player_state: PlayerState,
    input_state: InputState
  };
  struct(EntitySeed)
}

type fn CollectDelta() -> type {
  let CollectDelta = {
    score: i32,
    sound: asset.Handle(#sound)
  };
  struct(CollectDelta)
}

fn CollectDelta::empty() -> CollectDelta {
  CollectDelta {score: 0, sound: sound_none}
}

fn CollectDelta::append(
  left: CollectDelta,
  right: CollectDelta
) -> CollectDelta {
  CollectDelta {
    score: left.score + right.score,
    sound: match right.score > 0 {
      true => right.sound,
      false => left.sound,
    }
  }
}

