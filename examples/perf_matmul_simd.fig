const operators = @import("prelude.operators");

type fn InlineArray(n: count, a: type) -> type {
  let InlineArray = {n*a};
  struct(InlineArray)
}

type fn Lane4I32() -> type {
  InlineArray(4, i32)
}

type fn Mat4I32() -> type {
  InlineArray(4, Lane4I32)
}

pub fn main(
  r0: Lane4I32,
  r1: Lane4I32,
  r2: Lane4I32,
  r3: Lane4I32
) -> Mat4I32 {
  let c0 = r0;
  let c1 = r1;
  let c2 = r2;
  let c3 = r3;
  #[
    #[
      r0[0] * c0[0] + r0[1] * c0[1] + r0[2] * c0[2] + r0[3] * c0[3],
      r0[0] * c1[0] + r0[1] * c1[1] + r0[2] * c1[2] + r0[3] * c1[3],
      r0[0] * c2[0] + r0[1] * c2[1] + r0[2] * c2[2] + r0[3] * c2[3],
      r0[0] * c3[0] + r0[1] * c3[1] + r0[2] * c3[2] + r0[3] * c3[3]
    ],
    #[
      r1[0] * c0[0] + r1[1] * c0[1] + r1[2] * c0[2] + r1[3] * c0[3],
      r1[0] * c1[0] + r1[1] * c1[1] + r1[2] * c1[2] + r1[3] * c1[3],
      r1[0] * c2[0] + r1[1] * c2[1] + r1[2] * c2[2] + r1[3] * c2[3],
      r1[0] * c3[0] + r1[1] * c3[1] + r1[2] * c3[2] + r1[3] * c3[3]
    ],
    #[
      r2[0] * c0[0] + r2[1] * c0[1] + r2[2] * c0[2] + r2[3] * c0[3],
      r2[0] * c1[0] + r2[1] * c1[1] + r2[2] * c1[2] + r2[3] * c1[3],
      r2[0] * c2[0] + r2[1] * c2[1] + r2[2] * c2[2] + r2[3] * c2[3],
      r2[0] * c3[0] + r2[1] * c3[1] + r2[2] * c3[2] + r2[3] * c3[3]
    ],
    #[
      r3[0] * c0[0] + r3[1] * c0[1] + r3[2] * c0[2] + r3[3] * c0[3],
      r3[0] * c1[0] + r3[1] * c1[1] + r3[2] * c1[2] + r3[3] * c1[3],
      r3[0] * c2[0] + r3[1] * c2[1] + r3[2] * c2[2] + r3[3] * c2[3],
      r3[0] * c3[0] + r3[1] * c3[1] + r3[2] * c3[2] + r3[3] * c3[3]
    ]
  ]
}
