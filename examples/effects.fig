const operators = @import("prelude.operators");

const clock = @external("clock", fn(host: io) -> io(i32));
const random = @external("random", fn(host: io) -> io(i32));

pub fn main(host: io) -> io(i32) {
  do @io(_) {
    now <- clock(host);
    entropy <- random(host);
    return(now + entropy)
  }
}
