{
  "language": {
    "scope": "source.fig",
    "fileTypes": ["fig"],
    "comment": "//"
  },
  "word": "LowerIdent",
  "supertypes": ["Decl", "Expr", "Literal"],
  "conflicts": [
    ["Primary"],
    ["Call"],
    ["FieldName", "TypeAnn"],
    ["FieldName", "PatternIdent"],
    ["FieldName", "TypeParamDecl"],
    ["ImportBindingItems", "ImportBindingTail"]
  ],
  "queries": {
    "highlights": {
      "entries": [
        { "literal": "import", "capture": "keyword.control.import" },
        { "literal": "capability", "capture": "keyword" },
        { "literal": "type", "capture": "keyword.type" },
        { "literal": "const", "capture": "keyword" },
        { "literal": "fn", "capture": "keyword.function" },
        { "literal": "let", "capture": "keyword" },
        { "literal": "fork", "capture": "function.builtin" },
        { "literal": "match", "capture": "keyword.control" },
        { "node": "Visibility", "capture": "keyword" },
        { "node": "TypeParamsDecl", "capture": "type.parameter" },
        { "node": "TypeShapeRepeat", "capture": "number" },
        { "node": "CountRepeat", "capture": "number" },
        { "node": "PascalIdentRepeat", "capture": "number" },
        { "node": "TypeRepeatPrefix", "capture": "number" },
        { "node": "String", "capture": "string" },
        { "node": "Number", "capture": "number" },
        { "node": "Bool", "capture": "constant.builtin" },
        { "node": "Comment", "capture": "comment" },
        { "node": "Placeholder", "capture": "operator" }
      ],
      "patterns": [
        "(FnDecl (FnTail (FnName (LowerIdent) @function)))",
        "(Primary (LowerIdent) @variable)",
        "(Call (Primary (LowerIdent) @function.call) \"(\")",
        "(Call (Primary (ForkBuiltin) @function.builtin) \"(\")",
        "(Primary (StaticBuiltin (LowerIdent) @function.builtin))",
        "(TypePrimary (StaticBuiltin (LowerIdent) @function.builtin))",
        "(TypeAtom (LowerIdent) @type)",
        "(TypeAtom (PascalIdent) @type.parameter)",
        "(TypePrimary (LowerIdent) @type)",
        "(TypePrimary (PascalIdent) @type.parameter)",
        "(TypeFnDecl (LowerIdent) @type.definition)",
        "(TypeLetDecl (PascalIdent) @type)",
        "(ConstDecl (LowerIdent) @variable)",
        "(ImportBindingList (ImportBindingItems (LowerIdent) @variable))",
        "(ConstDecl (FieldName) @variable)",
        "(Param (PatternIdent (LowerIdent) @variable.parameter))",
        "(Param (PatternIdent (PascalIdent) @constructor))",
        "(Param (FieldName) @variable.parameter)",
        "(BlockLetDecl (LowerIdent) @variable)",
        "(BlockLetDecl (FieldName) @variable)",
        "(BlockProofConstDecl (PascalIdent) @type)",
        "(BlockLetTail (LowerIdent) @variable)",
        "(TopLetDecl (LowerIdent) @variable)",
        "(TopLetDecl (FieldName) @variable)",
        "(TypeShapeSlot (ShapeSlotKey (LowerIdent) @variable.other.member))",
        "(ShapeSlot (ShapeSlotKey (LowerIdent) @variable.other.member))",
        "(Call \".\" (LowerIdent) @variable.other.member)",
        "(Primary (PascalIdent) @constructor)"
      ],
      "defaults": {
        "suppress": [
          { "node": "LowerIdent" },
          { "node": "LowerIdentRepeat" },
          { "node": "PascalIdent" },
          { "node": "FieldName" }
        ]
      }
    },
    "folds": [
      { "node": "Block", "capture": "fold" }
    ],
    "tags": [
      { "node": "FnDecl", "capture": "tag.definition" },
      { "node": "TypeFnDecl", "capture": "tag.definition" }
    ],
    "textobjects": [
      { "node": "FnDecl", "capture": "function.around" },
      { "node": "Block", "capture": "function.inside" },
      { "node": "TypeFnDecl", "capture": "class.around" },
      { "node": "TypeBlock", "capture": "class.inside" },
      { "node": "Param", "capture": "parameter.around" },
      { "node": "TypeParamsDecl", "capture": "parameter.around" }
    ]
  },
  "formatter": {
    "blocks": ["Block"],
    "spacing": {
      "(": "tight",
      "[": "tight"
    }
  },
  "lsp": {
    "documentSymbols": ["FnDecl", "TypeFnDecl", "ConstDecl"],
    "diagnostics": ["Program"]
  }
}
