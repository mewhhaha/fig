type fn inline_array(N: count, Component: type) -> type {
  let InlineArray = {N*Component};
  struct(InlineArray)
}

type fn component_store(N: count, Component: type) -> type {
  inline_array(N, Component)
}

type fn component_count_for(Spec: const) -> type {
  3
}

type fn component_slot(N: count, Component: type) -> type {
  let ComponentSlot = {
    present: component_store(N, bool),
    values: component_store(N, Component)
  };
  struct(ComponentSlot)
}

type fn component_slot_for(Spec: const) -> type {
  component_slot(component_count_for(Spec), component_value_for(Spec))
}

type fn component_value_for(Spec: const) -> type {
  Spec
}

type fn component_values(Selected: const) -> type {
  let ComponentValues = @shape_map(Selected, component_value_for);
  struct(ComponentValues)
}

type fn sparse_world(EntityCount: count, Components: const) -> type {
  let Base = {
    next_entity_id: i32,
    defaults: component_values(Components)
  };
  let Slots = @shape_map(Components, component_slot_for);
  let SparseWorld = @shape_concat(Base, Slots);
  struct(SparseWorld)
}

type fn query_row(E: type, Selected: const) -> type {
  let QueryRow = @shape_concat({entity: E}, @shape_map(Selected, component_value_for));
  struct(QueryRow)
}

type fn row(Selected: const) -> type {
  query_row(i32, Selected)
}

type fn values(Selected: const) -> type {
  component_values(Selected)
}

type fn entity_row(Components: const, Row: type) -> type {
  let RowSlots = @type_slots(Row);
  let Matched = @shape_intersect(Components, RowSlots);
  let ComponentCountOk = @require(
    @shape_count(Matched) == @shape_count(RowSlots),
    "entity row field is not a world component"
  );
  let ComponentTypesOk = @require(
    Matched == RowSlots,
    "entity row field type must match component type"
  );
  Row
}

fn component_store.get_typed(
  const n: count,
  const component: type,
  store: component_store(n, component),
  index: i32
) -> component {
  match index == 0 {
    true => store[0],
    false => match index == 1 {
      true => store[1],
      false => store[2],
    },
  }
}

fn component_slot.set_typed(
  const component: type,
  slot: component_slot(3, component),
  index: i32,
  value: component
) -> component_slot(3, component) {
  let value0, value12 = fork(value);
  let value1, value2 = fork(value12);
  {
    present: slot.present,
    values: <
      match index == 0 { true => value0, false => slot.values[0] },
      match index == 1 { true => value1, false => slot.values[1] },
      match index == 2 { true => value2, false => slot.values[2] }
    >
  }
}

fn component_slot.put_typed(
  const component: type,
  slot: component_slot(3, component),
  index: i32,
  present: bool,
  value: component
) -> component_slot(3, component) {
  {
    present: <
      match index == 0 { true => present, false => slot.present[0] },
      match index == 1 { true => present, false => slot.present[1] },
      match index == 2 { true => present, false => slot.present[2] }
    >,
    values: <
      match index == 0 { true => value, false => slot.values[0] },
      match index == 1 { true => value, false => slot.values[1] },
      match index == 2 { true => value, false => slot.values[2] }
    >
  }
}

fn sparse_world.empty(const components: const) -> sparse_world(3, components) {
  {
    next_entity_id: 0,
    defaults: {
      for Key, Spec in components: @empty(@shape_slot(components, Key)),
    },
    for Key, Spec in components: {
      present: <false, false, false>,
      values: <
        @empty(@shape_slot(components, Key)),
        @empty(@shape_slot(components, Key)),
        @empty(@shape_slot(components, Key))
      >
    },
  }
}

fn entity.add(world: sparse_world(3, Components), entity_values: Row) -> sparse_world(3, Components) {
  const RowOk = entity_row(Components, Row);
  let index = world.next_entity_id;
  {
    next_entity_id: index + 1,
    defaults: {
      for Key, Spec in Components: @field(world.defaults, Key),
    },
    for Key, Spec in Components: component_slot.put_typed(
      @shape_slot(Components, Key),
      @field(world, Key),
      index,
      @shape_has_slot(@type_slots(Row), Key),
      match @shape_has_slot(@type_slots(Row), Key) {
        true => @field(entity_values, Key),
        false => @field(world.defaults, Key),
      }
    ),
  }
}

type fn sparse_query(W: type, Selected: const) -> type {
  let WorldSlots = @type_slots(W);
  let SelectedSlots = @shape_map(Selected, component_slot_for);
  let Matched = @shape_intersect(WorldSlots, SelectedSlots);
  let SlotCountOk = @require(
    @shape_count(Matched) == @shape_count(SelectedSlots),
    "sparse query selected slot is missing from world"
  );
  let SlotTypesOk = @require(
    Matched == SelectedSlots,
    "sparse query selected slots must match world slot types and order"
  );
  let Query = {};
  struct(Query)
}

fn bool_and(a: bool, b: bool) -> bool {
  match a {
    true => b,
    false => false
  }
}

fn selected_present(const selected: const, const world_type: type, world: world_type, entity: i32) -> bool {
  match @shape_count(selected) {
    0 => true,
    _ => selected_present_nonempty(selected, world_type, world, entity),
  }
}

fn selected_present_nonempty(const selected: const, const world_type: type, world: world_type, entity: i32) -> bool {
  let world_for_slot, world_for_tail = fork(world);
  let entity_for_slot, entity_for_tail = fork(entity);
  bool_and(
    component_store.get_typed(3, bool, @field(@field(world_for_slot, @shape_first_key(selected)), #present), entity_for_slot),
    selected_present(@shape_tail(selected), world_type, world_for_tail, entity_for_tail)
  )
}

fn selected_row(const selected: const, const world_type: type, world: world_type, entity: i32) -> row(selected) {
  {
    entity: entity,
    for Key, Spec in selected: component_store.get_typed(
      3,
      @shape_slot(selected, Key),
      @field(@field(world, Key), #values),
      entity
    ),
  }
}

fn apply_writes(const world_type: type, const writes: const, world: world_type, entity: i32, write_values: values(writes)) -> world_type {
  match @shape_count(writes) {
    0 => world,
    _ => apply_writes_nonempty(world_type, writes, world, entity, write_values),
  }
}

fn apply_writes_nonempty(const world_type: type, const writes: const, world: world_type, entity: i32, write_values: values(writes)) -> world_type {
  let world_for_slot, world_rest = fork(world);
  let values_for_value, values_for_tail = fork(write_values);
  let next_slot = component_slot.set_typed(
    @shape_slot(writes, @shape_first_key(writes)),
    @field(world_for_slot, @shape_first_key(writes)),
    entity,
    @field(values_for_value, @shape_first_key(writes))
  );
  let next_world: world_type = {
    for Key, Slot in @type_slots(world_type): match Key == @shape_first_key(writes) {
      true => {
        present: @field(next_slot, #present),
        values: @field(next_slot, #values),
      },
      false => @field(world_rest, Key),
    },
  };
  match @shape_count(@shape_tail(writes)) {
    0 => apply_writes(world_type, @shape_tail(writes), next_world, entity, {}),
    _ => apply_writes(world_type, @shape_tail(writes), next_world, entity, values_for_tail),
  }
}

fn each_loop(
  const i: count,
  const n: count,
  const reads: const,
  const writes: const,
  const world_type: type,
  const events_type: type,
  world: world_type,
  events: &(events_type),
  const step: fn(row: row(reads), events: &(events_type)) -> values(writes)
) -> world_type {
  match i == n {
    true => world,
    false => each_step(i, n, reads, writes, world_type, events_type, world, events, step),
  }
}

fn each_step(
  const i: count,
  const n: count,
  const reads: const,
  const writes: const,
  const world_type: type,
  const events_type: type,
  world: world_type,
  events: &(events_type),
  const step: fn(row: row(reads), events: &(events_type)) -> values(writes)
) -> world_type {
  let world_for_read, world_for_update = fork(world);
  let world_for_condition, world_for_row = fork(world_for_read);
  let world_for_update_true, world_for_update_false = fork(world_for_update);
  match bool_and(i < world_for_condition.next_entity_id, selected_present(reads, world_type, world_for_condition, i)) {
    true => each_step_present(i, n, reads, writes, world_type, events_type, world_for_row, world_for_update_true, events, step),
    false => each_loop(i + 1, n, reads, writes, world_type, events_type, world_for_update_false, events, step),
  }
}

fn each_step_present(
  const i: count,
  const n: count,
  const reads: const,
  const writes: const,
  const world_type: type,
  const events_type: type,
  world_for_read: world_type,
  world_for_update: world_type,
  events: &(events_type),
  const step: fn(row: row(reads), events: &(events_type)) -> values(writes)
) -> world_type {
  let selected_values = selected_row(reads, world_type, world_for_read, i);
  let write_values = step(selected_values, events);
  let next_world = apply_writes(world_type, writes, world_for_update, i, write_values);
  each_loop(i + 1, n, reads, writes, world_type, events_type, next_world, events, step)
}

fn each(
  const reads: const,
  const writes: const,
  world: W,
  events: &(Events),
  const step: fn(row: row(reads), events: &(Events)) -> values(writes)
) -> W {
  each_loop(0, 3, reads, writes, W, Events, world, events, step)
}

fn run(
  const w: type,
  const e: type,
  world: w,
  events: &(e),
  const system: fn(world: w, events: &(e)) -> w
) -> w {
  system(world, events)
}
