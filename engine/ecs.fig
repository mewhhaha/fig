const layout = @import("prelude.layout");
const monad = @import("prelude.monad");
const default_capacity = 1024;

type fn Batch(component: type) -> type {
  layout.HeapArray(component)
}

type fn BatchIndex() -> type {
  i32
}

type fn EntityId() -> type {
  i32
}

type fn BatchFillIter(capacity: count, component: type) -> type {
  component
}

fn batch_capacity(batch: Batch(component)) -> i32 {
  layout.HeapArray::capacity(component, batch)
}

fn batch_with_capacity(
  const component: type,
  capacity: i32
) -> Batch(component) {
  layout.HeapArray::new(component, capacity)
}

fn batch_fill(const capacity: count, value: component) -> Batch(component) {
  batch_fill_loop(
    0,
    layout.HeapArray::new(component, capacity),
    value
  )
}

fn batch_fill_loop(
  index: i32,
  batch: Batch(component),
  value: component
) -> Batch(component) {
  match index < batch.cap {
    true => batch_fill_loop(
      index + 1,
      layout.HeapArray::push(component, batch, value),
      value
    ),
    false => batch,
  }
}

fn batch_fill_iter(
  const capacity: count,
  value: component
) -> BatchFillIter(capacity, component) {
  value
}

fn batch_set(
  batch: Batch(component),
  index: i32,
  value: component
) -> Batch(component) {
  layout.HeapArray::set(component, batch, index, value)
}

fn batch_get(batch: Batch(component), index: i32) -> component {
  layout.HeapArray::get(component, batch, index)
}

fn batch_map(
  batch: Batch(component),
  const step: fn(item: component) -> result
) -> Batch(result) {
  batch_map_loop(
    0,
    batch,
    layout.HeapArray::new(result, batch.len),
    step
  )
}

fn batch_map_loop(
  index: i32,
  batch: Batch(component),
  out: Batch(result),
  const step: fn(item: component) -> result
) -> Batch(result) {
  match index < batch.len {
    true => batch_map_loop(
      index + 1,
      batch,
      layout.HeapArray::push(
        result,
        out,
        step(layout.HeapArray::get(
          component,
          batch,
          index
        ))
      ),
      step
    ),
    false => out,
  }
}

fn batch_map_with_state(
  batch: Batch(component),
  state_value: state,
  const step: fn(
    index: i32,
    item: component,
    state_value: state
  ) -> result
) -> Batch(result) {
  batch_map_with_state_loop(
    0,
    batch,
    layout.HeapArray::new(result, batch.len),
    state_value,
    step
  )
}

fn batch_map_with_state_loop(
  index: i32,
  batch: Batch(component),
  out: Batch(result),
  state_value: state,
  const step: fn(
    index: i32,
    item: component,
    state_value: state
  ) -> result
) -> Batch(result) {
  match index < batch.len {
    true => batch_map_with_state_loop(
      index + 1,
      batch,
      layout.HeapArray::push(
        result,
        out,
        step(
          index,
          layout.HeapArray::get(
            component,
            batch,
            index
          ),
          state_value
        )
      ),
      state_value,
      step
    ),
    false => out,
  }
}

fn batch_map2_with_state(
  write_batch: Batch(write_component),
  read_batch: Batch(read_component),
  state_value: state,
  const step: fn(
    index: i32,
    item: write_component,
    read: read_component,
    state_value: state
  ) -> write_component
) -> Batch(write_component) {
  batch_map2_with_state_loop(
    0,
    write_batch,
    read_batch,
    layout.HeapArray::new(
      write_component,
      write_batch.len
    ),
    state_value,
    step
  )
}

fn batch_map2_with_state_loop(
  index: i32,
  write_batch: Batch(write_component),
  read_batch: Batch(read_component),
  out: Batch(write_component),
  state_value: state,
  const step: fn(
    index: i32,
    item: write_component,
    read: read_component,
    state_value: state
  ) -> write_component
) -> Batch(write_component) {
  match index < write_batch.len {
    true => batch_map2_with_state_loop(
      index + 1,
      write_batch,
      read_batch,
      layout.HeapArray::push(
        write_component,
        out,
        step(
          index,
          layout.HeapArray::get(
            write_component,
            write_batch,
            index
          ),
          layout.HeapArray::get(
            read_component,
            read_batch,
            index
          ),
          state_value
        )
      ),
      state_value,
      step
    ),
    false => out,
  }
}

fn batch_map3_with_state(
  write_batch: Batch(write_component),
  read_a_batch: Batch(read_a_component),
  read_b_batch: Batch(read_b_component),
  state_value: state,
  const step: fn(
    index: i32,
    item: write_component,
    read_a: read_a_component,
    read_b: read_b_component,
    state_value: state
  ) -> write_component
) -> Batch(write_component) {
  batch_map3_with_state_loop(
    0,
    write_batch,
    read_a_batch,
    read_b_batch,
    {
      out: layout.HeapArray::new(
        write_component,
        write_batch.len
      ),
      state_value: state_value
    },
    step
  )
}

fn batch_map3_with_state_loop(
  index: i32,
  write_batch: Batch(write_component),
  read_a_batch: Batch(read_a_component),
  read_b_batch: Batch(read_b_component),
  rest: struct({out: Batch(write_component), state_value: state}),
  const step: fn(
    index: i32,
    item: write_component,
    read_a: read_a_component,
    read_b: read_b_component,
    state_value: state
  ) -> write_component
) -> Batch(write_component) {
  match index < write_batch.len {
    true => batch_map3_with_state_loop(
      index + 1,
      write_batch,
      read_a_batch,
      read_b_batch,
      {
        out: layout.HeapArray::push(
          write_component,
          rest.out,
          step(
            index,
            layout.HeapArray::get(
              write_component,
              write_batch,
              index
            ),
            layout.HeapArray::get(
              read_a_component,
              read_a_batch,
              index
            ),
            layout.HeapArray::get(
              read_b_component,
              read_b_batch,
              index
            ),
            rest.state_value
          )
        ),
        state_value: rest.state_value
      },
      step
    ),
    false => rest.out,
  }
}

fn batch_map4_with_state(
  write_batch: Batch(write_component),
  read_a_batch: Batch(read_a_component),
  read_b_batch: Batch(read_b_component),
  read_c_batch: Batch(read_c_component),
  state_value: state,
  const step: fn(
    index: i32,
    item: write_component,
    read_a: read_a_component,
    read_b: read_b_component,
    read_c: read_c_component,
    state_value: state
  ) -> write_component
) -> Batch(write_component) {
  batch_map4_with_state_loop(
    0,
    write_batch,
    read_a_batch,
    read_b_batch,
    {
      read_c_batch: read_c_batch,
      out: layout.HeapArray::new(
        write_component,
        write_batch.len
      ),
      state_value: state_value
    },
    step
  )
}

fn batch_map4_with_state_loop(
  index: i32,
  write_batch: Batch(write_component),
  read_a_batch: Batch(read_a_component),
  read_b_batch: Batch(read_b_component),
  rest: struct({
    read_c_batch: Batch(read_c_component),
    out: Batch(write_component),
    state_value: state
  }),
  const step: fn(
    index: i32,
    item: write_component,
    read_a: read_a_component,
    read_b: read_b_component,
    read_c: read_c_component,
    state_value: state
  ) -> write_component
) -> Batch(write_component) {
  match index < write_batch.len {
    true => batch_map4_with_state_loop(
      index + 1,
      write_batch,
      read_a_batch,
      read_b_batch,
      {
        read_c_batch: rest.read_c_batch,
        out: layout.HeapArray::push(
          write_component,
          rest.out,
          step(
            index,
            layout.HeapArray::get(
              write_component,
              write_batch,
              index
            ),
            layout.HeapArray::get(
              read_a_component,
              read_a_batch,
              index
            ),
            layout.HeapArray::get(
              read_b_component,
              read_b_batch,
              index
            ),
            layout.HeapArray::get(
              read_c_component,
              rest.read_c_batch,
              index
            ),
            rest.state_value
          )
        ),
        state_value: rest.state_value
      },
      step
    ),
    false => rest.out,
  }
}

fn batch_fold(
  batch: Batch(component),
  initial: accumulator,
  const step: fn(acc: accumulator, item: component) -> accumulator
) -> accumulator {
  batch_fold_loop(0, batch, initial, step)
}

fn batch_fold_loop(
  index: i32,
  batch: Batch(component),
  acc: accumulator,
  const step: fn(acc: accumulator, item: component) -> accumulator
) -> accumulator {
  match index < batch.len {
    true => batch_fold_loop(
      index + 1,
      batch,
      step(
        acc,
        layout.HeapArray::get(component, batch, index)
      ),
      step
    ),
    false => acc,
  }
}

fn batch_map_with_state_fold(
  batch: Batch(component),
  state_value: state,
  initial: accumulator,
  const map_step: fn(
    index: i32,
    item: component,
    state_value: state
  ) -> mapped,
  const reduce_step: fn(acc: accumulator, item: mapped) -> accumulator
) -> accumulator {
  batch_map_with_state_fold_loop(
    0,
    batch,
    state_value,
    initial,
    map_step,
    reduce_step
  )
}

fn batch_map_with_state_fold_loop(
  index: i32,
  batch: Batch(component),
  state_value: state,
  acc: accumulator,
  const map_step: fn(
    index: i32,
    item: component,
    state_value: state
  ) -> mapped,
  const reduce_step: fn(acc: accumulator, item: mapped) -> accumulator
) -> accumulator {
  match index < batch.len {
    true => batch_map_with_state_fold_loop(
      index + 1,
      batch,
      state_value,
      reduce_step(
        acc,
        map_step(
          index,
          layout.HeapArray::get(
            component,
            batch,
            index
          ),
          state_value
        )
      ),
      map_step,
      reduce_step
    ),
    false => acc,
  }
}

fn batch_iter_map_with_state_fold(
  const capacity: count,
  iter: BatchFillIter(capacity, component),
  state_value: state,
  initial: accumulator,
  const map_step: fn(
    index: i32,
    item: component,
    state_value: state
  ) -> mapped,
  const reduce_step: fn(acc: accumulator, item: mapped) -> accumulator
) -> accumulator {
  batch_fill_iter_map_with_state_fold_loop(
    capacity,
    0,
    iter,
    state_value,
    initial,
    map_step,
    reduce_step
  )
}

fn batch_fill_iter_map_with_state_fold_loop(
  const capacity: count,
  index: i32,
  value: component,
  state_value: state,
  acc: accumulator,
  const map_step: fn(
    index: i32,
    item: component,
    state_value: state
  ) -> mapped,
  const reduce_step: fn(acc: accumulator, item: mapped) -> accumulator
) -> accumulator {
  match index < capacity {
    true => batch_fill_iter_map_with_state_fold_loop(
      capacity,
      index + 1,
      value,
      state_value,
      reduce_step(
        acc,
        map_step(index, value, state_value)
      ),
      map_step,
      reduce_step
    ),
    false => acc,
  }
}

fn fold_entities(
  world: world_t,
  initial: accumulator,
  const step: fn(
    acc: accumulator,
    index: i32,
    world: world_t
  ) -> accumulator
) -> accumulator {
  fold_entities_loop(0, world, initial, step)
}

fn fold_entities_with_entities(
  entities: Batch(i32),
  world: world_t,
  initial: accumulator,
  const step: fn(
    acc: accumulator,
    index: i32,
    world: world_t
  ) -> accumulator
) -> accumulator {
  fold_entities_loop(0, world, initial, step)
}

fn fold_entities_loop(
  index: i32,
  world: world_t,
  acc: accumulator,
  const step: fn(
    acc: accumulator,
    index: i32,
    world: world_t
  ) -> accumulator
) -> accumulator {
  match index < world.len {
    true => fold_entities_loop(
      index + 1,
      world,
      step(acc, index, world),
      step
    ),
    false => acc,
  }
}

fn components(const spec) -> const {
  spec
}

type fn ComponentBatchFor(component: type) -> type {
  Batch(component)
}

type fn World(components: const) -> type {
  let Base = {
    entities: Batch(i32),
    len: i32
  };
  let Stores = @shape_map(
    components,
    ComponentBatchFor
  );
  let World = @shape_concat(Base, Stores);
  struct(World)
}

fn World::empty(const spec: const) -> World(spec) {
  World::with_capacity(spec, default_capacity)
}

fn World::with_capacity(
  const spec: const,
  initial_capacity: i32
) -> World(spec) {
  let base: World(spec) = @replace_field(
    @empty(World(spec)),
    #entities,
    layout.HeapArray::new(i32, initial_capacity)
  );
  init_component_batches(
    spec,
    initial_capacity,
    @replace_field(base, #len, 0)
  )
}

fn empty_world(const spec: const) -> World(spec) {
  World::empty(spec)
}

fn empty_world_with_capacity(
  const spec: const,
  initial_capacity: i32
) -> World(spec) {
  World::with_capacity(spec, initial_capacity)
}

fn init_component_batches(
  const fields,
  initial_capacity: i32,
  world: world_t
) -> world_t {
  match @shape_count(fields) {
    0 => world,
    _ => init_component_batches_nonempty(
      @shape_first_key(fields),
      @shape_tail(fields),
      @shape_slot(fields, @shape_first_key(fields)),
      initial_capacity,
      world
    ),
  }
}

fn init_component_batches_nonempty(
  const field: const,
  const rest,
  const component: type,
  initial_capacity: i32,
  world: world_t
) -> world_t {
  init_component_batches(
    rest,
    initial_capacity,
    @replace_field(
      world,
      field,
      layout.HeapArray::new(
        component,
        initial_capacity
      )
    )
  )
}

type fn Read(component: type) -> type {
  component
}

type fn Write(component: type) -> type {
  component
}

type fn Query(world: type, input: type, value: type) -> type {
  i32
}

fn Query::pure(value: value_t) -> Query(
  world_t,
  input_t,
  value_t
) {
  0
}

fn Query::map(
  const step: fn(value: value_t) -> Query(
    world_t,
    input_t,
    next_t
  ),
  value: Query(world_t, input_t, value_t)
) -> Query(world_t, input_t, next_t) {
  0
}

fn Query::bind(
  value: Query(world_t, input_t, value_t),
  const step: fn(value: value_t) -> Query(
    world_t,
    input_t,
    next_t
  )
) -> Query(world_t, input_t, next_t) {
  0
}

type fn Res(resource: type) -> type {
  resource
}

fn read(const field: const) -> Query(
  world_t,
  input_t,
  component
) {
  let world: world_t = @field;
  let values: Batch(component) = @field(world, field);
  0
}

fn write(const field: const) -> Query(
  world_t,
  input_t,
  component
) {
  let world: world_t = @field;
  let values: Batch(component) = @field(world, field);
  0
}

fn has(const field: const) -> Query(
  world_t,
  input_t,
  bool
) {
  true
}

fn res() -> Query(world_t, input_t, input_t) {
  0
}

fn entity() -> Query(world_t, input_t, i32) {
  0
}

fn snapshot() -> Query(world_t, input_t, world_t) {
  0
}

fn query(const row: type) -> Query(
  world_t,
  input_t,
  row
) {
  0
}

fn get(const field: const) -> Query(
  world_t,
  input_t,
  component
) {
  read(field)
}

fn without(const field: const) -> Query(
  world_t,
  input_t,
  bool
) {
  false
}

type fn Systems(world: type, input: type) -> type {
  let Systems = {
    world: world,
    input: input
  };
  struct(Systems)
}

fn systems_context(world: world_t, input: input_t) -> Systems(
  world_t,
  input_t
) {
  Systems {world: world, input: input}
}

fn system_world(systems: Systems(world_t, input_t)) -> world_t {
  systems.world
}

fn system_input(systems: Systems(world_t, input_t)) -> input_t {
  systems.input
}

type fn System(world: type, input: type) -> type {
  monad.State(Systems(world, input), Systems(world, input))
}

fn System::pure(value: Systems(world_t, input_t)) -> System(
  world_t,
  input_t
) {
  monad.State::pure(value)
}

fn System::bind(
  value: System(world_t, input_t),
  step: fn(value: Systems(world_t, input_t)) -> System(
    world_t,
    input_t
  )
) -> System(world_t, input_t) {
  \systems -> {
    let current: monad.StateResult(
      Systems(world_t, input_t),
      Systems(world_t, input_t)
    ) = value(systems);
    let next: System(world_t, input_t) = step(current.value);
    next(current.state)
  }
}

type fn Command(value: type) -> type {
  monad.State(value, value)
}

fn Command::pure(value: value_t) -> Command(value_t) {
  monad.State::pure(value)
}

fn Command::bind(
  value: Command(value_t),
  step: fn(value: value_t) -> Command(value_t)
) -> Command(value_t) {
  \state_value -> {
    let current: monad.StateResult(value_t, value_t) = value(state_value);
    let next: Command(value_t) = step(current.value);
    next(current.state)
  }
}

fn Command::eval(value: Command(value_t), initial: value_t) -> value_t {
  monad.State::eval(value, initial)
}

type fn QueryRowFor(access: const) -> type {
  struct(access)
}

pub fn query_row(
  const row_type: type,
  const fields,
  systems: Systems(world_t, input_t),
  index: i32,
  row: row_type
) -> row_type {
  match @shape_count(fields) {
    0 => row,
    _ => query_row_nonempty(
      row_type,
      fields,
      systems,
      index,
      row
    ),
  }
}

pub fn query_row_nonempty(
  const row_type: type,
  const fields,
  systems: Systems(world_t, input_t),
  index: i32,
  row: row_type
) -> row_type {
  let base = query_row(
    row_type,
    @shape_tail(fields),
    systems,
    index,
    row
  );
  match @shape_first_key(fields) {
    #input => @replace_field(
      base,
      #input,
      systems.input
    ),
    #entity => @replace_field(base, #entity, index),
    #snapshot => @replace_field(
      base,
      #snapshot,
      systems.world
    ),
    _ => @replace_field(
      base,
      @shape_first_key(fields),
      layout.HeapArray::get(
        @shape_slot(fields, @shape_first_key(fields)),
        @field(
          systems.world,
          @shape_first_key(fields)
        ),
        index
      )
    ),
  }
}

type fn PatchForQuery(row: type, patch: type) -> type {
  patch
}

fn map(
  query: Query(world_t, input_t, row_t),
  const step: fn(row: row_t) -> patch_t
) -> System(world_t, input_t) {
  \systems -> {
    let next = set(systems, query, step);
    {value: next, state: next}
  }
}

fn map_with_world(
  query: Query(world_t, input_t, row_t),
  const step: fn(row: row_t, world: world_t) -> patch_t
) -> System(world_t, input_t) {
  \systems -> {
    let next = set_with_world(systems, query, step);
    {value: next, state: next}
  }
}

fn fold(
  systems: Systems(world_t, input_t),
  query: Query(world_t, input_t, row_t),
  initial: accumulator,
  const step: fn(acc: accumulator, row: row_t) -> accumulator
) -> accumulator {
  fold_loop(0, systems, initial, step)
}

fn fold_map(
  systems: Systems(world_t, input_t),
  query: Query(world_t, input_t, row_t),
  initial: accumulator,
  const map_step: fn(row: row_t) -> mapped,
  const reduce_step: fn(acc: accumulator, item: mapped) -> accumulator
) -> accumulator {
  fold_map_loop(
    0,
    systems,
    initial,
    map_step,
    reduce_step
  )
}

fn fold_map_loop(
  index: i32,
  systems: Systems(world_t, input_t),
  acc: accumulator,
  const map_step: fn(row: row_t) -> mapped,
  const reduce_step: fn(acc: accumulator, item: mapped) -> accumulator
) -> accumulator {
  match index < systems.world.len {
    true => fold_map_loop(
      index + 1,
      systems,
      reduce_step(
        acc,
        map_step(query_row(
          row_t,
          @type_slots(row_t),
          systems,
          index,
          @empty(row_t)
        ))
      ),
      map_step,
      reduce_step
    ),
    false => acc,
  }
}

fn fold_map_entities(
  world: world_t,
  initial: accumulator,
  const map_step: fn(index: i32, world: world_t) -> mapped,
  const reduce_step: fn(acc: accumulator, item: mapped) -> accumulator
) -> accumulator {
  fold_map_entities_loop(
    0,
    world,
    initial,
    map_step,
    reduce_step
  )
}

fn fold_map_entities_loop(
  index: i32,
  world: world_t,
  acc: accumulator,
  const map_step: fn(index: i32, world: world_t) -> mapped,
  const reduce_step: fn(acc: accumulator, item: mapped) -> accumulator
) -> accumulator {
  match index < world.len {
    true => fold_map_entities_loop(
      index + 1,
      world,
      reduce_step(acc, map_step(index, world)),
      map_step,
      reduce_step
    ),
    false => acc,
  }
}

fn fold_loop(
  index: i32,
  systems: Systems(world_t, input_t),
  acc: accumulator,
  const step: fn(acc: accumulator, row: row_t) -> accumulator
) -> accumulator {
  match index < systems.world.len {
    true => fold_loop(
      index + 1,
      systems,
      step(
        acc,
        query_row(
          row_t,
          @type_slots(row_t),
          systems,
          index,
          @empty(row_t)
        )
      ),
      step
    ),
    false => acc,
  }
}

fn set(
  systems: Systems(world_t, input_t),
  query: Query(world_t, input_t, row_t),
  const step: fn(row: row_t) -> patch_t
) -> Systems(world_t, input_t) {
  Systems {
    world: set_fields(
      @type_slots(PatchForQuery(row_t, patch_t)),
      systems,
      systems.world,
      step
    ),
    input: systems.input
  }
}

fn set_with_world(
  systems: Systems(world_t, input_t),
  query: Query(world_t, input_t, row_t),
  const step: fn(row: row_t, world: world_t) -> patch_t
) -> Systems(world_t, input_t) {
  Systems {
    world: set_fields_with_world(
      @type_slots(PatchForQuery(row_t, patch_t)),
      systems,
      systems.world,
      step
    ),
    input: systems.input
  }
}

fn set_fields_with_world(
  const fields,
  systems: Systems(world_t, input_t),
  world: world_t,
  const step: fn(row: row_t, world: world_t) -> patch_t
) -> world_t {
  match @shape_count(fields) {
    0 => world,
    _ => set_fields_with_world_nonempty(
      fields,
      systems,
      world,
      step
    ),
  }
}

fn set_fields_with_world_nonempty(
  const fields,
  systems: Systems(world_t, input_t),
  world: world_t,
  const step: fn(row: row_t, world: world_t) -> patch_t
) -> world_t {
  set_fields_with_world(
    @shape_tail(fields),
    systems,
    set_field_with_world(
      @shape_first_key(fields),
      @shape_slot(fields, @shape_first_key(fields)),
      systems,
      world,
      step
    ),
    step
  )
}

fn set_field_with_world(
  const field: const,
  const component: type,
  systems: Systems(world_t, input_t),
  world: world_t,
  const step: fn(row: row_t, world: world_t) -> patch_t
) -> world_t {
  let mapped = set_field_with_world_loop(
    0,
    field,
    component,
    @field(world, field),
    systems,
    step
  );
  @replace_field(world, field, mapped)
}

fn set_field_with_world_loop(
  index: i32,
  const field: const,
  const component: type,
  values: Batch(component),
  systems: Systems(world_t, input_t),
  const step: fn(row: row_t, world: world_t) -> patch_t
) -> Batch(component) {
  match index < systems.world.len {
    true => query_row(
      row_t,
      @type_slots(row_t),
      systems,
      index,
      @empty(row_t)
    )
      \row_value -> step(row_value, systems.world)
      \patch_value -> set_field_with_world_loop(
      index + 1,
      field,
      component,
      layout.HeapArray::set(
        component,
        values,
        index,
        @field(patch_value, field)
      ),
      systems,
      step
    ),
    false => values,
  }
}

fn set_fields(
  const fields,
  systems: Systems(world_t, input_t),
  world: world_t,
  const step: fn(row: row_t) -> patch_t
) -> world_t {
  match @shape_count(fields) {
    0 => world,
    _ => set_fields_nonempty(
      fields,
      systems,
      world,
      step
    ),
  }
}

fn set_fields_nonempty(
  const fields,
  systems: Systems(world_t, input_t),
  world: world_t,
  const step: fn(row: row_t) -> patch_t
) -> world_t {
  set_fields(
    @shape_tail(fields),
    systems,
    set_field(
      @shape_first_key(fields),
      @shape_slot(fields, @shape_first_key(fields)),
      systems,
      world,
      step
    ),
    step
  )
}

fn set_field(
  const field: const,
  const component: type,
  systems: Systems(world_t, input_t),
  world: world_t,
  const step: fn(row: row_t) -> patch_t
) -> world_t {
  let mapped = set_field_loop(
    0,
    field,
    component,
    @field(world, field),
    systems,
    step
  );
  @replace_field(world, field, mapped)
}

fn set_field_loop(
  index: i32,
  const field: const,
  const component: type,
  values: Batch(component),
  systems: Systems(world_t, input_t),
  const step: fn(row: row_t) -> patch_t
) -> Batch(component) {
  match index < systems.world.len {
    true => query_row(
      row_t,
      @type_slots(row_t),
      systems,
      index,
      @empty(row_t)
    )
      \row_value -> step(row_value)
      \patch_value -> set_field_loop(
      index + 1,
      field,
      component,
      layout.HeapArray::set(
        component,
        values,
        index,
        @field(patch_value, field)
      ),
      systems,
      step
    ),
    false => values,
  }
}

fn run(
  world: world_t,
  input: input_t,
  const step: fn() -> System(
    world_t,
    input_t
  )
) -> world_t {
  let next = monad.State::eval(step(), systems_context(world, input));
  next.world
}

fn WorldComponents(const world: type) -> const {
  @shape_omit(
    @type_slots(world),
    {entities: true, len: true}
  )
}

fn spawn(
  entity_values: EntityRow(
    WorldComponents(world_t),
    row
  )
) -> Command(world_t) {
  \world -> {
    let entity_id = world.len;
    let with_entity_id: world_t = @replace_field(
      world,
      #entities,
      layout.HeapArray::push(
        i32,
        world.entities,
        entity_id
      )
    );
    let with_entity: world_t = @replace_field(
      with_entity_id,
      #len,
      world.len + 1
    );
    let next = spawn_components(
      @type_slots(row),
      with_entity,
      entity_id,
      entity_values
    );
    {value: next, state: next}
  }
}

fn spawn_with_entities(
  entities: Batch(i32),
  entity_values: EntityRow(
    WorldComponents(world_t),
    row
  )
) -> Command(world_t) {
  \world -> {
    let entity_id = world.len;
    let with_entity_id: world_t = @replace_field(
      world,
      #entities,
      layout.HeapArray::push(i32, entities, entity_id)
    );
    let with_entity: world_t = @replace_field(
      with_entity_id,
      #len,
      world.len + 1
    );
    let next = spawn_components(
      @type_slots(row),
      with_entity,
      entity_id,
      entity_values
    );
    {value: next, state: next}
  }
}

fn spawn_default_components(
  const fields,
  world: world_t
) -> world_t {
  match @shape_count(fields) {
    0 => world,
    _ => spawn_default_components_nonempty(
      @shape_first_key(fields),
      @shape_tail(fields),
      @shape_slot(fields, @shape_first_key(fields)),
      world
    ),
  }
}

fn spawn_default_components_nonempty(
  const field: const,
  const rest,
  const component: type,
  world: world_t
) -> world_t {
  spawn_default_components(
    rest,
    @replace_field(
      world,
      field,
      layout.HeapArray::push(
        component,
        @field(world, field),
        @empty(component)
      )
    )
  )
}

fn spawn_components(
  const fields,
  world: world_t,
  entity: i32,
  entity_values: row_t
) -> world_t {
  match @shape_count(fields) {
    0 => world,
    _ => spawn_components_nonempty(
      @shape_first_key(fields),
      @shape_tail(fields),
      @shape_slot(fields, @shape_first_key(fields)),
      world,
      entity,
      entity_values
    ),
  }
}

fn spawn_components_nonempty(
  const field: const,
  const rest,
  const component: type,
  world: world_t,
  entity: i32,
  entity_values: row_t
) -> world_t {
  spawn_components(
    rest,
    @replace_field(
      world,
      field,
      layout.HeapArray::push(
        component,
        @field(world, field),
        @field(entity_values, field)
      )
    ),
    entity,
    entity_values
  )
}

type fn EntityRow(components: const, row: type) -> type {
  let RowSlots = @type_slots(row);
  let Matched = @shape_intersect(components, RowSlots);
  let ComponentCountOk = @require(
    @shape_count(Matched) == @shape_count(RowSlots),
    "entity row field is not a world component"
  );
  let ComponentTypesOk = @require(
    Matched == RowSlots,
    "entity row field type must match component type"
  );
  row
}
