const layout = @import("prelude.layout");

type fn InlineArray(n: count, component: type) -> type {
  let InlineArray = {n*component};
  struct(InlineArray)
}

type fn Batch(capacity: count, component: type) -> type {
  layout.InlineArray(capacity, component)
}

type fn BatchIndex(capacity: count) -> type {
  layout.core.Index(capacity)
}

type fn BatchFillIter(capacity: count, component: type) -> type {
  component
}

fn batch_capacity(batch: Batch(capacity, component)) -> i32 {
  capacity
}

fn batch_fill(
const capacity: count, value: component) -> Batch(
  capacity,
  component
) {
  layout.InlineArray::fill(capacity, component, value)
}

fn batch_fill_iter(
  const capacity: count,
  value: component
) -> BatchFillIter(capacity, component) {
  value
}

fn batch_set(
  batch: Batch(capacity, component),
  index: BatchIndex(capacity),
  value: component
) -> Batch(capacity, component) {
  layout.InlineArray::set(
    capacity,
    component,
    batch,
    index,
    value
  )
}

fn batch_map(
  batch: Batch(capacity, component),
  const step: fn(item: component) -> result
) -> Batch(capacity, result) {
  layout.InlineArray::map(
    capacity,
    component,
    result,
    batch,
    step
  )
}

fn batch_map_with_state(
  batch: Batch(capacity, component),
  state_value: state,
  const step: fn(
    index: BatchIndex(capacity),
    item: component,
    state_value: state
  ) -> result
) -> Batch(capacity, result) {
  layout.InlineArray::imap_with_state(
    capacity,
    component,
    result,
    state,
    batch,
    state_value,
    step
  )
}

fn batch_map2_with_state(
  write_batch: Batch(capacity, write_component),
  read_batch: Batch(capacity, read_component),
  state_value: state,
  const step: fn(
    index: BatchIndex(capacity),
    item: write_component,
    read: read_component,
    state_value: state
  ) -> write_component
) -> Batch(capacity, write_component) {
  batch_map2_with_state_loop(
    layout.core.IndexCursor::start(capacity),
    layout.InlineArrayBuilder::start(
      capacity,
      write_component
    ),
    write_batch,
    read_batch,
    state_value,
    step
  )
}

fn batch_map2_with_state_loop(
  cursor: layout.core.IndexCursor(capacity),
  builder: layout.InlineArrayBuilder(
    capacity,
    write_component
  ),
  write_batch: Batch(capacity, write_component),
  read_batch: Batch(capacity, read_component),
  state_value: state,
  const step: fn(
    index: BatchIndex(capacity),
    item: write_component,
    read: read_component,
    state_value: state
  ) -> write_component
) -> Batch(capacity, write_component) {
  let builder_then = builder;
  let builder_else = builder;
  let write_then = write_batch;
  let write_else = write_batch;
  let read_then = read_batch;
  let read_else = read_batch;
  let state_then = state_value;
  let state_else = state_value;
  let write_current = write_then;
  let write_next = write_then;
  let read_current = read_then;
  let read_next = read_then;
  let state_call = state_then;
  let state_next = state_then;
  match layout.core.IndexCursor::next(capacity, cursor) {
    Yield(i, next) => batch_map2_with_state_loop(
      next,
      layout.InlineArrayBuilder::push(
        capacity,
        write_component,
        builder_then,
        i,
        step(
          i,
          write_current[i],
          read_current[i],
          state_call
        )
      ),
      write_next,
      read_next,
      state_next,
      step
    ),
    Done => layout.InlineArrayBuilder::finish(
      capacity,
      write_component,
      builder_else
    ),
  }
}

fn batch_map3_with_state(
  write_batch: Batch(capacity, write_component),
  read_a_batch: Batch(capacity, read_a_component),
  read_b_batch: Batch(capacity, read_b_component),
  state_value: state,
  const step: fn(
    index: BatchIndex(capacity),
    item: write_component,
    read_a: read_a_component,
    read_b: read_b_component,
    state_value: state
  ) -> write_component
) -> Batch(capacity, write_component) {
  batch_map3_with_state_loop(
    layout.core.IndexCursor::start(capacity),
    layout.InlineArrayBuilder::start(
      capacity,
      write_component
    ),
    write_batch,
    read_a_batch,
    read_b_batch,
    state_value,
    step
  )
}

fn batch_map3_with_state_loop(
  cursor: layout.core.IndexCursor(capacity),
  builder: layout.InlineArrayBuilder(
    capacity,
    write_component
  ),
  write_batch: Batch(capacity, write_component),
  read_a_batch: Batch(capacity, read_a_component),
  read_b_batch: Batch(capacity, read_b_component),
  state_value: state,
  const step: fn(
    index: BatchIndex(capacity),
    item: write_component,
    read_a: read_a_component,
    read_b: read_b_component,
    state_value: state
  ) -> write_component
) -> Batch(capacity, write_component) {
  let builder_then = builder;
  let builder_else = builder;
  let write_then = write_batch;
  let write_next = write_batch;
  let read_a_then = read_a_batch;
  let read_a_next = read_a_batch;
  let read_b_then = read_b_batch;
  let read_b_next = read_b_batch;
  let state_then = state_value;
  let state_else = state_value;
  match layout.core.IndexCursor::next(capacity, cursor) {
    Yield(i, next) => batch_map3_with_state_loop(
      next,
      layout.InlineArrayBuilder::push(
        capacity,
        write_component,
        builder_then,
        i,
        step(
          i,
          write_then[i],
          read_a_then[i],
          read_b_then[i],
          state_then
        )
      ),
      write_next,
      read_a_next,
      read_b_next,
      state_then,
      step
    ),
    Done => layout.InlineArrayBuilder::finish(
      capacity,
      write_component,
      builder_else
    ),
  }
}

fn batch_map4_with_state(
  write_batch: Batch(capacity, write_component),
  read_a_batch: Batch(capacity, read_a_component),
  read_b_batch: Batch(capacity, read_b_component),
  read_c_batch: Batch(capacity, read_c_component),
  state_value: state,
  const step: fn(
    index: BatchIndex(capacity),
    item: write_component,
    read_a: read_a_component,
    read_b: read_b_component,
    read_c: read_c_component,
    state_value: state
  ) -> write_component
) -> Batch(capacity, write_component) {
  batch_map4_with_state_loop(
    layout.core.IndexCursor::start(capacity),
    layout.InlineArrayBuilder::start(
      capacity,
      write_component
    ),
    write_batch,
    read_a_batch,
    read_b_batch,
    read_c_batch,
    state_value,
    step
  )
}

fn batch_map4_with_state_loop(
  cursor: layout.core.IndexCursor(capacity),
  builder: layout.InlineArrayBuilder(
    capacity,
    write_component
  ),
  write_batch: Batch(capacity, write_component),
  read_a_batch: Batch(capacity, read_a_component),
  read_b_batch: Batch(capacity, read_b_component),
  read_c_batch: Batch(capacity, read_c_component),
  state_value: state,
  const step: fn(
    index: BatchIndex(capacity),
    item: write_component,
    read_a: read_a_component,
    read_b: read_b_component,
    read_c: read_c_component,
    state_value: state
  ) -> write_component
) -> Batch(capacity, write_component) {
  let builder_then = builder;
  let builder_else = builder;
  let write_then = write_batch;
  let write_next = write_batch;
  let read_a_then = read_a_batch;
  let read_a_next = read_a_batch;
  let read_b_then = read_b_batch;
  let read_b_next = read_b_batch;
  let read_c_then = read_c_batch;
  let read_c_next = read_c_batch;
  let state_then = state_value;
  let state_else = state_value;
  match layout.core.IndexCursor::next(capacity, cursor) {
    Yield(i, next) => batch_map4_with_state_loop(
      next,
      layout.InlineArrayBuilder::push(
        capacity,
        write_component,
        builder_then,
        i,
        step(
          i,
          write_then[i],
          read_a_then[i],
          read_b_then[i],
          read_c_then[i],
          state_then
        )
      ),
      write_next,
      read_a_next,
      read_b_next,
      read_c_next,
      state_then,
      step
    ),
    Done => layout.InlineArrayBuilder::finish(
      capacity,
      write_component,
      builder_else
    ),
  }
}

fn batch_fold(
  batch: Batch(capacity, component),
  initial: accumulator,
  const step: fn(acc: accumulator, item: component) -> accumulator
) -> accumulator {
  batch_fold_loop(
    layout.core.IndexCursor::start(capacity),
    batch,
    initial,
    step
  )
}

fn batch_fold_loop(
  cursor: layout.core.IndexCursor(capacity),
  batch: Batch(capacity, component),
  acc: accumulator,
  const step: fn(acc: accumulator, item: component) -> accumulator
) -> accumulator {
  let batch_then = batch;
  let batch_else = batch;
  let acc_then = acc;
  let acc_else = acc;
  let batch_item = batch_then;
  let batch_next = batch_then;
  match layout.core.IndexCursor::next(capacity, cursor) {
    Yield(i, next) => batch_fold_loop(
      next,
      batch_next,
      step(acc_then, batch_item[i]),
      step
    ),
    Done => acc_else,
  }
}

fn batch_map_with_state_fold(
  batch: Batch(capacity, component),
  state_value: state,
  initial: accumulator,
  const map_step: fn(
    index: BatchIndex(capacity),
    item: component,
    state_value: state
  ) -> mapped,
  const reduce_step: fn(acc: accumulator, item: mapped) -> accumulator
) -> accumulator {
  batch_map_with_state_fold_loop(
    layout.core.IndexCursor::start(capacity),
    batch,
    state_value,
    initial,
    map_step,
    reduce_step
  )
}

fn batch_map_with_state_fold_loop(
  cursor: layout.core.IndexCursor(capacity),
  batch: Batch(capacity, component),
  state_value: state,
  acc: accumulator,
  const map_step: fn(
    index: BatchIndex(capacity),
    item: component,
    state_value: state
  ) -> mapped,
  const reduce_step: fn(acc: accumulator, item: mapped) -> accumulator
) -> accumulator {
  let batch_then = batch;
  let batch_else = batch;
  let state_then = state_value;
  let state_else = state_value;
  let acc_then = acc;
  let acc_else = acc;
  let batch_item = batch_then;
  let batch_next = batch_then;
  match layout.core.IndexCursor::next(capacity, cursor) {
    Yield(i, next) => batch_map_with_state_fold_loop(
      next,
      batch_next,
      state_then,
      reduce_step(
        acc_then,
        map_step(i, batch_item[i], state_then)
      ),
      map_step,
      reduce_step
    ),
    Done => acc_else,
  }
}

fn batch_iter_map_with_state_fold(
  const capacity: count,
  iter: BatchFillIter(capacity, component),
  state_value: state,
  initial: accumulator,
  const map_step: fn(
    index: BatchIndex(capacity),
    item: component,
    state_value: state
  ) -> mapped,
  const reduce_step: fn(acc: accumulator, item: mapped) -> accumulator
) -> accumulator {
  batch_fill_iter_map_with_state_fold_loop(
    layout.core.IndexCursor::start(capacity),
    iter,
    state_value,
    initial,
    map_step,
    reduce_step
  )
}

fn batch_fill_iter_map_with_state_fold_loop(
  cursor: layout.core.IndexCursor(capacity),
  value: component,
  state_value: state,
  acc: accumulator,
  const map_step: fn(
    index: BatchIndex(capacity),
    item: component,
    state_value: state
  ) -> mapped,
  const reduce_step: fn(acc: accumulator, item: mapped) -> accumulator
) -> accumulator {
  let value_then = value;
  let value_else = value;
  let state_then = state_value;
  let state_else = state_value;
  let acc_then = acc;
  let acc_else = acc;
  match layout.core.IndexCursor::next(capacity, cursor) {
    Yield(i, next) => batch_fill_iter_map_with_state_fold_loop(
      next,
      value_then,
      state_then,
      reduce_step(
        acc_then,
        map_step(i, value_then, state_then)
      ),
      map_step,
      reduce_step
    ),
    Done => acc_else,
  }
}

fn fold_entities(
  world: world_t,
  initial: accumulator,
  const step: fn(
    acc: accumulator,
    index: BatchIndex(capacity),
    world: world_t
  ) -> accumulator
) -> accumulator {
  fold_entities_with_entities(
    world.entities,
    world,
    initial,
    step
  )
}

fn fold_entities_with_entities(
  entities: Batch(capacity, BatchIndex(capacity)),
  world: world_t,
  initial: accumulator,
  const step: fn(
    acc: accumulator,
    index: BatchIndex(capacity),
    world: world_t
  ) -> accumulator
) -> accumulator {
  fold_entities_loop(
    layout.core.IndexCursor::start(capacity),
    world,
    initial,
    step
  )
}

fn fold_entities_loop(
  cursor: layout.core.IndexCursor(capacity),
  world: world_t,
  acc: accumulator,
  const step: fn(
    acc: accumulator,
    index: BatchIndex(capacity),
    world: world_t
  ) -> accumulator
) -> accumulator {
  match layout.core.IndexCursor::next(capacity, cursor) {
    Yield(i, next) => match i < world.len {
      true => fold_entities_loop(
        next,
        world,
        step(acc, i, world),
        step
      ),
      false => acc,
    },
    Done => acc,
  }
}

fn components(const spec) -> const {
  spec
}

type fn ComponentBatchFor(
  capacity: count,
  component: type
) -> type {
  Batch(capacity, component)
}

type fn World(capacity: count, components: const) -> type {
  let Base = {
    entities: Batch(capacity, BatchIndex(capacity)),
    len: i32
  };
  let Stores = @shape_map(
    components,
    ComponentBatchFor(capacity)
  );
  let World = @shape_concat(Base, Stores);
  struct(World)
}

fn World::empty(
  const capacity: count,
  const spec: const
) -> World(capacity, spec) {
  @empty(World(capacity, spec))
}

fn empty_world(
  const capacity: count,
  const spec: const
) -> World(capacity, spec) {
  World::empty(capacity, spec)
}

type fn Read(component: type) -> type {
  component
}

type fn Write(component: type) -> type {
  component
}

type fn Query(world: type, input: type, value: type) -> type {
  i32
}

fn Query::pure(value: value_t) -> Query(
  world_t,
  input_t,
  value_t
) {
  0
}

fn Query::map(
  const step: fn(value: value_t) -> Query(
    world_t,
    input_t,
    next_t
  ),
  value: Query(world_t, input_t, value_t)
) -> Query(world_t, input_t, next_t) {
  0
}

fn Query::bind(
  value: Query(world_t, input_t, value_t),
  const step: fn(value: value_t) -> Query(
    world_t,
    input_t,
    next_t
  )
) -> Query(world_t, input_t, next_t) {
  0
}

type fn Res(resource: type) -> type {
  resource
}

fn read(
const field: const) -> Query(world_t, input_t, component) {
  let world: world_t = @field;
  let values: Batch(capacity, component) = @field(
    world,
    field
  );
  0
}

fn write(
const field: const) -> Query(world_t, input_t, component) {
  let world: world_t = @field;
  let values: Batch(capacity, component) = @field(
    world,
    field
  );
  0
}

fn has(
const field: const) -> Query(world_t, input_t, bool) {
  true
}

fn res() -> Query(world_t, input_t, input_t) {
  0
}

fn entity() -> Query(world_t, input_t, BatchIndex(capacity)) {
  0
}

fn snapshot() -> Query(world_t, input_t, world_t) {
  0
}

fn get(
const field: const) -> Query(world_t, input_t, component) {
  read(field)
}

fn without(
const field: const) -> Query(world_t, input_t, bool) {
  false
}

type fn Systems(world: type, input: type) -> type {
  let Systems = {
    world: world,
    input: input
  };
  struct(Systems)
}

fn systems_context(world: world_t, input: input_t) -> Systems(
  world_t,
  input_t
) {
  Systems {world: world, input: input}
}

fn system_world(systems: Systems(world_t, input_t)) -> world_t {
  systems.world
}

fn system_input(systems: Systems(world_t, input_t)) -> input_t {
  systems.input
}

type fn System(world: type, input: type) -> type {
  Systems(world, input)
}

fn System::pure(value: Systems(world_t, input_t)) -> System(
  world_t,
  input_t
) {
  value
}

fn System::bind(
  value: System(world_t, input_t),
  const step: fn(value: System(world_t, input_t)) -> System(
    world_t,
    input_t
  )
) -> System(world_t, input_t) {
  step(value)
}

type fn Command(value: type) -> type {
  value
}

fn Command::pure(value: value_t) -> Command(value_t) {
  value
}

fn Command::bind(
  value: Command(value_t),
  const step: fn(value: value_t) -> Command(value_t)
) -> Command(value_t) {
  step(value)
}

type fn QueryRowFor(access: const) -> type {
  struct(access)
}

fn query_row(
  const fields,
  systems: Systems(world_t, input_t),
  index: BatchIndex(capacity),
  row: row_t
) -> row_t {
  match @shape_count(fields) {
    0 => row,
    _ => query_row_nonempty(
      fields,
      systems,
      index,
      row
    ),
  }
}

fn query_row_nonempty(
  const fields,
  systems: Systems(world_t, input_t),
  index: BatchIndex(capacity),
  row: row_t
) -> row_t {
  let base = query_row(
    @shape_tail(fields),
    systems,
    index,
    row
  );
  let value = match @shape_first_key(fields) {
    #input => systems.input,
    #entity => index,
    #snapshot => systems.world,
    _ => @field(
      systems.world,
      @shape_first_key(fields)
    )[index],
  };
  @replace_field(
    base,
    @shape_first_key(fields),
    value
  )
}

type fn PatchForQuery(row: type, patch: type) -> type {
  let RowSlots = @type_slots(row);
  let PatchSlots = @type_slots(patch);
  let Matched = @shape_intersect(RowSlots, PatchSlots);
  let PatchFieldsOk = @require(
    @shape_count(Matched) == @shape_count(PatchSlots),
    "ECS set patch field must be present in the query row"
  );
  patch
}

type fn SetOneValue(row: type, field: const, component: type) -> type {
  let RowSlot = @shape_slot(@type_slots(row), field);
  let FieldTypeOk = @require(
    RowSlot == component,
    "ECS set_one field must be present in the query row with matching type"
  );
  component
}

fn set_one(
  systems: Systems(world_t, input_t),
  query: Query(world_t, input_t, row_t),
  const field: const,
  const step: fn(row: row_t) -> component
) -> Systems(world_t, input_t) {
  Systems {
    world: set_one_field(
      systems,
      systems.world,
      field,
      step
    ),
    input: systems.input
  }
}

fn set_one_with_world(
  systems: Systems(world_t, input_t),
  query: Query(world_t, input_t, row_t),
  const field: const,
  const step: fn(row: row_t, world: world_t) -> component
) -> Systems(world_t, input_t) {
  Systems {
    world: set_one_field_with_world(
      systems,
      systems.world,
      field,
      step
    ),
    input: systems.input
  }
}

fn set_one_field(
  systems: Systems(world_t, input_t),
  world: world_t,
  const field: const,
  const step: fn(row: row_t) -> component
) -> world_t {
  let mapped = set_one_field_start(
    @field(world, field),
    systems,
    field,
    step
  );
  @replace_field(world, field, mapped)
}

fn set_one_field_start(
  values: Batch(capacity, component),
  systems: Systems(world_t, input_t),
  const field: const,
  const step: fn(row: row_t) -> SetOneValue(row_t, field, component)
) -> Batch(capacity, component) {
  set_one_field_loop(
    layout.core.IndexCursor::start(capacity),
    layout.InlineArrayBuilder::start(
      capacity,
      component
    ),
    values,
    systems,
    field,
    step
  )
}

fn set_one_field_loop(
  cursor: layout.core.IndexCursor(capacity),
  builder: layout.InlineArrayBuilder(capacity, component),
  values: Batch(capacity, component),
  systems: Systems(world_t, input_t),
  const field: const,
  const step: fn(row: row_t) -> SetOneValue(row_t, field, component)
) -> Batch(capacity, component) {
  let builder_then = builder;
  let builder_else = builder;
  let values_next = values;
  match layout.core.IndexCursor::next(capacity, cursor) {
    Yield(i, next) => set_one_field_loop(
      next,
      layout.InlineArrayBuilder::push(
        capacity,
        component,
        builder_then,
        i,
        step(query_row(
          @type_slots(row_t),
          systems,
          i,
          @empty(row_t)
        ))
      ),
      values_next,
      systems,
      field,
      step
    ),
    Done => layout.InlineArrayBuilder::finish(
      capacity,
      component,
      builder_else
    ),
  }
}

fn set_one_field_with_world(
  systems: Systems(world_t, input_t),
  world: world_t,
  const field: const,
  const step: fn(row: row_t, world: world_t) -> component
) -> world_t {
  let mapped = set_one_field_with_world_start(
    @field(world, field),
    systems,
    field,
    step
  );
  @replace_field(world, field, mapped)
}

fn set_one_field_with_world_start(
  values: Batch(capacity, component),
  systems: Systems(world_t, input_t),
  const field: const,
  const step: fn(row: row_t, world: world_t) -> SetOneValue(
    row_t,
    field,
    component
  )
) -> Batch(capacity, component) {
  set_one_field_with_world_loop(
    layout.core.IndexCursor::start(capacity),
    layout.InlineArrayBuilder::start(
      capacity,
      component
    ),
    values,
    systems,
    field,
    step
  )
}

fn set_one_field_with_world_loop(
  cursor: layout.core.IndexCursor(capacity),
  builder: layout.InlineArrayBuilder(capacity, component),
  values: Batch(capacity, component),
  systems: Systems(world_t, input_t),
  const field: const,
  const step: fn(row: row_t, world: world_t) -> SetOneValue(
    row_t,
    field,
    component
  )
) -> Batch(capacity, component) {
  let builder_then = builder;
  let builder_else = builder;
  let values_next = values;
  match layout.core.IndexCursor::next(capacity, cursor) {
    Yield(i, next) => set_one_field_with_world_loop(
      next,
      layout.InlineArrayBuilder::push(
        capacity,
        component,
        builder_then,
        i,
        step(
          query_row(
            @type_slots(row_t),
            systems,
            i,
            @empty(row_t)
          ),
          systems.world
        )
      ),
      values_next,
      systems,
      field,
      step
    ),
    Done => layout.InlineArrayBuilder::finish(
      capacity,
      component,
      builder_else
    ),
  }
}

fn set(
  systems: Systems(world_t, input_t),
  query: Query(world_t, input_t, row_t),
  const step: fn(row: row_t) -> patch_t
) -> Systems(world_t, input_t) {
  Systems {
    world: set_fields(
      @type_slots(PatchForQuery(row_t, patch_t)),
      systems,
      systems.world,
      step
    ),
    input: systems.input
  }
}

fn set_with_world(
  systems: Systems(world_t, input_t),
  query: Query(world_t, input_t, row_t),
  const step: fn(row: row_t, world: world_t) -> patch_t
) -> Systems(world_t, input_t) {
  Systems {
    world: set_fields_with_world(
      @type_slots(PatchForQuery(row_t, patch_t)),
      systems,
      systems.world,
      step
    ),
    input: systems.input
  }
}

fn set_fields_with_world(
  const fields,
  systems: Systems(world_t, input_t),
  world: world_t,
  const step: fn(row: row_t, world: world_t) -> patch_t
) -> world_t {
  match @shape_count(fields) {
    0 => world,
    _ => set_fields_with_world_nonempty(
      fields,
      systems,
      world,
      step
    ),
  }
}

fn set_fields_with_world_nonempty(
  const fields,
  systems: Systems(world_t, input_t),
  world: world_t,
  const step: fn(row: row_t, world: world_t) -> patch_t
) -> world_t {
  set_fields_with_world(
    @shape_tail(fields),
    systems,
    set_field_with_world(
      @shape_first_key(fields),
      systems,
      world,
      step
    ),
    step
  )
}

fn set_field_with_world(
  const field: const,
  systems: Systems(world_t, input_t),
  world: world_t,
  const step: fn(row: row_t, world: world_t) -> patch_t
) -> world_t {
  let mapped = set_field_with_world_start(
    field,
    @field(world, field),
    systems,
    step
  );
  @replace_field(world, field, mapped)
}

fn set_field_with_world_start(
  const field: const,
  values: Batch(capacity, component),
  systems: Systems(world_t, input_t),
  const step: fn(row: row_t, world: world_t) -> patch_t
) -> Batch(capacity, component) {
  set_field_with_world_loop(
    layout.core.IndexCursor::start(capacity),
    layout.InlineArrayBuilder::start(
      capacity,
      component
    ),
    values,
    systems,
    field,
    step
  )
}

fn set_field_with_world_loop(
  cursor: layout.core.IndexCursor(capacity),
  builder: layout.InlineArrayBuilder(capacity, component),
  values: Batch(capacity, component),
  systems: Systems(world_t, input_t),
  const field: const,
  const step: fn(row: row_t, world: world_t) -> patch_t
) -> Batch(capacity, component) {
  let builder_then = builder;
  let builder_else = builder;
  let values_next = values;
  match layout.core.IndexCursor::next(capacity, cursor) {
    Yield(i, next) => set_field_with_world_loop(
      next,
      layout.InlineArrayBuilder::push(
        capacity,
        component,
        builder_then,
        i,
        @field(
          step(
            query_row(
              @type_slots(row_t),
              systems,
              i,
              @empty(row_t)
            ),
            systems.world
          ),
          field
        )
      ),
      values_next,
      systems,
      field,
      step
    ),
    Done => layout.InlineArrayBuilder::finish(
      capacity,
      component,
      builder_else
    ),
  }
}

fn set_fields(
  const fields,
  systems: Systems(world_t, input_t),
  world: world_t,
  const step: fn(row: row_t) -> patch_t
) -> world_t {
  match @shape_count(fields) {
    0 => world,
    _ => set_fields_nonempty(
      fields,
      systems,
      world,
      step
    ),
  }
}

fn set_fields_nonempty(
  const fields,
  systems: Systems(world_t, input_t),
  world: world_t,
  const step: fn(row: row_t) -> patch_t
) -> world_t {
  set_fields(
    @shape_tail(fields),
    systems,
    set_field(
      @shape_first_key(fields),
      systems,
      world,
      step
    ),
    step
  )
}

fn set_field(
  const field: const,
  systems: Systems(world_t, input_t),
  world: world_t,
  const step: fn(row: row_t) -> patch_t
) -> world_t {
  let mapped = set_field_start(
    field,
    @field(world, field),
    systems,
    step
  );
  @replace_field(world, field, mapped)
}

fn set_field_start(
  const field: const,
  values: Batch(capacity, component),
  systems: Systems(world_t, input_t),
  const step: fn(row: row_t) -> patch_t
) -> Batch(capacity, component) {
  set_field_loop(
    layout.core.IndexCursor::start(capacity),
    layout.InlineArrayBuilder::start(
      capacity,
      component
    ),
    values,
    systems,
    field,
    step
  )
}

fn set_field_loop(
  cursor: layout.core.IndexCursor(capacity),
  builder: layout.InlineArrayBuilder(capacity, component),
  values: Batch(capacity, component),
  systems: Systems(world_t, input_t),
  const field: const,
  const step: fn(row: row_t) -> patch_t
) -> Batch(capacity, component) {
  let builder_then = builder;
  let builder_else = builder;
  let values_then = values;
  let values_next = values;
  let systems_then = systems;
  let systems_next = systems;
  match layout.core.IndexCursor::next(capacity, cursor) {
    Yield(i, next) => set_field_loop(
      next,
      layout.InlineArrayBuilder::push(
        capacity,
        component,
        builder_then,
        i,
        @field(
          step(query_row(
            @type_slots(row_t),
            systems_then,
            i,
            @empty(row_t)
          )),
          field
        )
      ),
      values_next,
      systems_next,
      field,
      step
    ),
    Done => layout.InlineArrayBuilder::finish(
      capacity,
      component,
      builder_else
    ),
  }
}

fn run(
  world: world_t,
  input: input_t,
  const step: fn(systems: System(world_t, input_t)) -> System(
    world_t,
    input_t
  )
) -> world_t {
  let next = step(systems_context(world, input));
  next.world
}

fn WorldComponents(const world: type) -> const {
  @shape_omit(@type_slots(world), {entities: true, len: true})
}

fn spawn(
  world: world_t,
  entity_values: EntityRow(WorldComponents(world_t), row)
) -> Command(world_t) {
  spawn_with_entities(world.entities, world, entity_values)
}

fn spawn_with_entities(
  entities: Batch(capacity, BatchIndex(capacity)),
  world: world_t,
  entity_values: EntityRow(WorldComponents(world_t), row)
) -> Command(world_t) {
  let entity = match layout.core.Index::try(
    capacity,
    world.len
  ) {
    Some(index) => index,
    None => 0,
  };
  let with_entity: world_t = @replace_field(
    world,
    #entities,
    layout.InlineArray::set(
      capacity,
      BatchIndex(capacity),
      entities,
      entity,
      entity
    )
  );
  let spawned: world_t = @replace_field(
    with_entity,
    #len,
    world.len + 1
  );
  spawn_components(
    @type_slots(row),
    capacity,
    spawned,
    entity,
    entity_values
  )
}

fn spawn_components(
  const fields,
  const capacity: count,
  world: world_t,
  entity: BatchIndex(capacity),
  entity_values: row_t
) -> Command(world_t) {
  match @shape_count(fields) {
    0 => world,
    _ => spawn_components_nonempty(
      @shape_first_key(fields),
      @shape_tail(fields),
      @shape_slot(fields, @shape_first_key(fields)),
      capacity,
      world,
      entity,
      entity_values
    ),
  }
}

fn spawn_components_nonempty(
  const field: const,
  const rest,
  const component: type,
  const capacity: count,
  world: world_t,
  entity: BatchIndex(capacity),
  entity_values: row_t
) -> Command(world_t) {
  let next_batch = layout.InlineArray::set(
    capacity,
    component,
    @field(world, field),
    entity,
    @field(entity_values, field)
  );
  let next_world: world_t = @replace_field(
    world,
    field,
    next_batch
  );
  spawn_components(
    rest,
    capacity,
    next_world,
    entity,
    entity_values
  )
}

type fn EntityRow(components: const, row: type) -> type {
  let RowSlots = @type_slots(row);
  let Matched = @shape_intersect(components, RowSlots);
  let ComponentCountOk = @require(
    @shape_count(Matched) == @shape_count(RowSlots),
    "entity row field is not a world component"
  );
  let ComponentTypesOk = @require(
    Matched == RowSlots,
    "entity row field type must match component type"
  );
  row
}
