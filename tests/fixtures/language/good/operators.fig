const ops = @import("prelude.operators");

type fn box() -> struct {
  let Box = [value: i32];
  struct(Box)
}

fn box.add(a: box, b: box) -> box { Box [value: a.value + b.value] }
fn box.eql(a: box, b: box) -> bool { a.value == b.value }
fn box.append(a: box, b: box) -> box { Box [value: a.value + b.value] }

pub fn main(a: box, b: box) -> i32 {
  let added = a + b;
  let appended = added <> Box [value: 1];
  match appended == Box [value: 3] {
    true => 1,
    false => 0,
  }
}
