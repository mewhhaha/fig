type Option(a) = union {
  None, Some(value: a)
}

fn score(true: bool, true: bool) -> i32 {
  3
}
fn score(_: bool, _: bool) -> i32 {
  0
}

fn unwrap(Some(value): Option(i32)) -> i32 {
  value
}
fn unwrap(None: Option(i32)) -> i32 {
  0
}

pub fn main() -> i32 {
  score(true, false) + unwrap(Some(4))
}
