const operators = @import("prelude.operators");

const clock = @external("clock", fn(host: io) -> io(i32));

type fn Pair() -> struct {
  let Pair = {first: i32, second: i32};
  struct(Pair)
}

fn make_pair() -> Pair {
  Pair {first: 2, second: 3}
}

fn sink(x: i32) -> i32 {
  x
}

pub fn main(host: io) -> i32 {
  let x = clock(host);
  let moved = sink(x);
  let first, second = make_pair();
  x + moved + first + second
}
