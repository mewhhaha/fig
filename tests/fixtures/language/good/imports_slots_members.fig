const { map4_i32, lane4_add_i32 } = @import("prelude.array_static");

const fields = {x: true, y: true};

type fn point() -> type {
  let Point = {x: i32, y: i32};
  struct(Point)
}

fn point.eql(a: point, b: point) -> bool {
  a.x == b.x && a.y == b.y
}

type fn has_eql(T: type) -> type {
  let Expected = fn(a: T, b: T) -> bool;
  @require(@type_has_member(T, #eql), "type requires eql");
  @require(@type_member_type(T, #eql) == Expected, "eql member has wrong type");
  T
}

type fn weird() -> type {
  let Weird = {fst: i32, [0]: i32, [1]: i32};
  struct(Weird)
}

fn inc(x: i32) -> i32 { x + 1 }

pub fn main() -> i32 {
  let left = 1;
  let right = 2;
  let record = {left, right};
  let point: has_eql(point) = Point {x: left, y: right};
  let generated = Point {for Key, Spec in (fields): 1};
  let weird: weird = {fst: 3, [0]: 4, [1]: 5};
  let xs = map4_i32(inc, <1, 2, 3, 4>);
  let doubled = lane4_add_i32(xs, xs);
  match point.eql(point, point) {
    true => record.left + generated.x + weird[0] + doubled[0],
    false => 0,
  }
}
