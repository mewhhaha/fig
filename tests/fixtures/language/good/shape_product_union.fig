type Point = struct {x: i32, y: i32}

type Option(a) = union {
  None, Some(value: a)
}

type Count = i32

fn make_point(x: i32, y: i32) -> Point {
  Point {x: x, y: y}
}

fn unwrap_or(value: Option(i32), fallback: i32) -> i32 {
  match value {
    Some(inner) => inner,
    None => fallback
  }
}

pub fn main() -> i32 {
  let count: Count = 4;
  make_point(1, 2).x + unwrap_or(Some(3), 0) + count
}
