const clock: fn() -> i32 !{time} = @effect("clock");

type fn Pair() -> struct {
  let Pair = {first: i32, second: i32};
  struct(Pair)
}

fn make_pair() -> Pair {
  Pair {first: 2, second: 3}
}

fn sink(x: i32) -> i32 {
  x
}

pub fn main() -> i32 !{time} {
  let x = clock();
  let moved = sink(x);
  let first, second = make_pair();
  x + moved + first + second
}
