token CountRepeat = /[0-9]+\*/ ;
token FrozenCollectionOpen = /#\[/ ;
token FrozenTypeOpen = /#\(/ ;
token CollectionOpen = /</ ;
token CollectionClose = />/ ;
token Number = /[0-9]+(\.[0-9]+)?(i32|u32|i64|u64|f32|f64)?/ ;
token Char = /'([^'\\]|\\.)'/ ;
token String = /"([^"\\]|\\.)*"/ ;
token LiteralType = /#([a-z_][a-z0-9_]*|[A-Z][A-Za-z0-9]*)/ ;
token LowerIdentRepeat = /[a-z_][a-z0-9_]*\*/ ;
token PascalIdentRepeat = /[A-Z][A-Za-z0-9]*\*/ ;
token TypeRepeatPrefix = /([A-Z][A-Za-z0-9]*|[0-9]+)\*(\s*[0-9]+\*)*/ ;
token LowerIdent = /[a-z_][a-z0-9_]*/ ;
token PascalIdent = /[A-Z][A-Za-z0-9]*/ ;
skip Whitespace = /[ \t\r\n]+/ ;
skip Comment = /\/\/[^\n]*/ ;

Program = Decl* ;
FieldName = LowerIdent ":" ;
Decl = TypeFnDecl | ConstDecl | FnDecl | TopLetDecl ;
TypeFnDecl = "type" "fn" LowerIdent "(" TypeParamsDecl? ")" TypeResultSig? TypeBlock ;
TypeBlock = "{" TypeBlockItem* "}" ;
TypeBlockItem = TypeLetDecl | TypeExpr ";"? ;
TypeLetDecl = ("let" | "const") PascalIdent "=" TypeExpr ";" ;
TypeExpr = TypeMatch | FnType | TypeBinary ;
TypeMatch = "match" TypeExpr "{" TypeArm* "}" ;
TypeArm = TypePattern "=>" TypeExpr ","? ;
TypePattern = "_" | Literal | LowerIdent | PascalIdent ;
TypeBinary = TypeCall (TypeOp TypeCall)* ;
TypeCall = TypePrimary ("(" TypeExprArgs? ")")* ;
TypePrimary = TypeOperatorDescriptor | FrozenType | TypeTuple | TypeShape | StaticBuiltin | Literal | TypeBuilderName | LowerIdent TypeQualifiedTail? | PascalIdent TypeQualifiedTail? ;
TypeOperatorDescriptor = "operator" "(" LiteralType "," Number "," String "," TypeOperatorTarget ")" ;
TypeOperatorTarget = (LowerIdent | PascalIdent) TypeQualifiedTail? ;
TypeQualifiedTail = ("." (LowerIdent | PascalIdent))+ ;
TypeBuilderName = "struct" | "union" ;
StaticBuiltin = "@" (LowerIdent | "import" | "capability") ;
TypeMember = "const" FieldName Type "=" Expr ;
TypeInlineMember = FnDecl ;
TypeExprArgs = TypeExpr ("," TypeExpr)* ","? ;
FnDecl = Visibility? FnTail ;
FnTail = "fn" FnName "(" Params? ")" ReturnSig? EffectRow? Block ;
FnName = LowerIdent ("." LowerIdent)* ;
FnSig = "fn" FnName "(" Params? ")" ReturnSig? EffectRow? ";" ;
ConstDecl = "const" (ImportBindingList | FieldName Type EffectRow? | LowerIdent TypeAnn?) "=" ConstValue ";"? ;
ImportBindingList = "{" ImportBindingItems ;
ImportBindingItems = "}" | LowerIdent ImportBindingTail ;
ImportBindingTail = "}" | "," "}" | "," ImportBindingItems ;
ConstValue = Expr ;
TopLetDecl = "let" (TuplePattern "=" Expr ";" | FieldName Type "=" Expr ";" | LowerIdent TopLetTail) ;
TopLetTail = TypeAnn? "=" Expr ";" ;
Block = "{" BlockStmt* Expr? "}" ;
BlockStmt = StaticForBlock | BlockLetDecl | BlockProofConstDecl ;
StaticForBlock = "static" "for" StaticForBinders "in" StaticForSource Block ;
StaticForBinders = (LowerIdent | PascalIdent) ("," (LowerIdent | PascalIdent))? ;
StaticForSource = Expr ;
BlockLetDecl = "let" (TuplePattern "=" Expr ";" | FieldName Type "=" Expr ";" | LowerIdent BlockLetTail) ;
BlockLetTail = TypeAnn? "=" Expr ";" | ("," LowerIdent)+ "=" Expr ";" ;
BlockProofConstDecl = "const" PascalIdent "=" TypeExpr ";" ;
Expr = PipeBind ;
PipeBind = PipeBindAtom ("\\" PipeBindName "->" PipeBindAtom)* ;
PipeBindAtom = MatchExpr | Binary ;
MatchExpr = "match" Expr "{" Arm* "}" ;
Arm = Pattern "=>" Expr ","? ;
PipeBindName = LowerIdent | Placeholder ;
Binary = Call (Op Call)* ;
Call = Primary ("(" Args? ")" | "." LowerIdent | "[" Expr "]")* ;
Primary = BorrowExpr | Literal | Placeholder | ForkBuiltin | StaticBuiltin | LowerIdent | PascalIdent ProductConstructorTail? | ParenExpr | ShapeValue | CollectionValue | FrozenCollectionValue | TupleValue ;
BorrowExpr = "&" Primary ;
Placeholder = "$" ;
ProductConstructorTail = ShapeValue ;
ForkBuiltin = "fork" ;
ParenExpr = "(" Expr ")" ;
ShapeValue = "{}" | "{" ShapeValueItems ;
ShapeValueItems = StaticForSlot ShapeValueTail | SpreadSlot ShapeValueTail | ShapeValueSlotKey Expr ShapeValueTail | PunnedShapeValueSlot ShapeValueTail ;
Range = Expr ".." Expr ;
ShapeValueTail = "}" | "," "}" | "," ShapeValueItems ;
ShapeValueSlot = ShapeValueSlotKey Expr ;
StaticForSlot = "for" StaticForBinders "in" StaticForSource ":" Expr ;
PunnedShapeValueSlot = LowerIdent ;
ShapeValueSlotKey = LowerIdent SlotPosition? ":" | SlotPosition ":" ;
SpreadSlot = "..." Expr ;
SlotPosition = "[" Number "]" ;
CollectionValue = CollectionOpen CollectionValueItems ;
CollectionValueItems = CollectionClose | CollectionSpreadSlot CollectionValueTail | CollectionExpr CollectionValueTail ;
CollectionValueTail = CollectionClose | "," CollectionValueItems ;
CollectionSpreadSlot = "..." CollectionExpr ;
CollectionExpr = CollectionPipeBind ;
CollectionPipeBind = CollectionPipeBindAtom ("\\" PipeBindName "->" CollectionPipeBindAtom)* ;
CollectionPipeBindAtom = MatchExpr | CollectionBinary ;
CollectionBinary = Call (OpNoCollectionClose Call)* ;
FrozenCollectionValue = FrozenCollectionOpen FrozenCollectionValueItems ;
FrozenCollectionValueItems = "]" | SpreadSlot FrozenCollectionValueTail | Expr FrozenCollectionValueTail ;
FrozenCollectionValueTail = "]" | "," FrozenCollectionValueItems ;
TupleValue = "[" TupleValueItems ;
TupleValueItems = "]" | TupleValueRepeat | Expr TupleValueTail ;
TupleValueTail = "]" | "," TupleValueItems ;
TupleValueRepeat = Expr ";" TypeRepeatCount "]" ;
Pattern = "_" | TuplePattern | PatternIdent | Literal ;
PatternIdent = LowerIdent | PascalIdent ("(" Args? ")")? ;
TuplePattern = "[" TuplePatternItems ;
TuplePatternItems = "]" | Pattern TuplePatternTail ;
TuplePatternTail = "]" | "," TuplePatternItems ;
Params = Param ("," Param)* ","? ;
Param = "const"? (FieldName Type? | Literal TypeAnn? | "_" TypeAnn? | TuplePattern ParamTail? | PatternIdent ParamTail?) ;
ParamTail = ":" Type? | Type ;
Args = Expr ("," Expr)* ","? ;
Type = BorrowType | FrozenType | FnType | "type" | "const" | Number | LowerIdent TypeQualifiedTail? TypeArgs? | PascalIdent TypeArgs? | ShapeType | TupleType ;
BorrowType = "&" "(" Type ")" ;
FrozenType = FrozenTypeOpen Type ")" ;
FnType = "fn" "(" Params? ")" ReturnSig ;
TypeArgs = "(" TypeExpr ("," TypeExpr)* ")" ;
TypeParamsDecl = TypeParamDecl ("," TypeParamDecl)* ","? ;
TypeParamDecl = (PascalIdent ":" | FieldName | LowerIdent ":" | Literal ":" | "_" ":") TypeParamKind ;
TypeParamKind = "type" TypeKindTail? | "const" | LowerIdent ;
TypeKindTail = "fn" TypeConstructorTail ;
TypeConstructorTail = "(" TypeParamsDecl? ")" TypeResultSig ;
TypeResultSig = "->" TypeResultKind ;
TypeResultKind = "type" | "struct" | "union" | "operator" ;
TypeAnn = ":" Type EffectRow? ;
ReturnSig = "->" Type ;
EffectRow = "!" ("{" LowerIdent ("," LowerIdent)* "}" | "{}") ;
ShapeType = "{}" | "{" ShapeTypeBody ;
ShapeTypeBody = ShapeSlot ShapeTypeTail ;
ShapeTypeTail = "}" | "," "}" | "," ShapeTypeBody ;
ShapeSlot = ShapeSlotKey? ShapeSlotBody ;
ShapeSlotKey = LowerIdent SlotPosition? ":" | SlotPosition ":" ;
ShapeSlotBody = CountRepeat Type | PascalIdentRepeat Type | LowerIdent TypeArgs? | PascalIdent TypeArgs? | ShapeType ;
TupleType = "[" TupleTypeBody ;
TupleTypeBody = "]" | TupleTypeRepeat | Type TupleTypeTail ;
TupleTypeTail = "," "]" | "," Type TupleTypeMore ;
TupleTypeMore = "]" | "," "]" | "," Type TupleTypeMore ;
TupleTypeRepeat = Type ";" TypeRepeatCount "]" ;
TypeShape = "{}" | "{" TypeShapeBody ;
TypeShapeBody = TypeShapeSlot TypeShapeTail ;
TypeShapeTail = "}" | "," "}" | "," TypeShapeBody ;
TypeShapeSlot = ShapeSlotKey? TypeShapeSlotBody ;
TypeShapeSlotBody = TypeShapeRepeat TypeExpr | TypeExpr ;
TypeShapeAnonSlotBody = TypeShapeRepeat TypeNonFnExpr | TypeNonFnExpr ;
TypeTuple = "[" TypeTupleBody ;
TypeTupleBody = "]" | TypeTupleRepeat | TypeExpr TypeTupleTail ;
TypeTupleTail = "," "]" | "," TypeExpr TypeTupleMore ;
TypeTupleMore = "]" | "," "]" | "," TypeExpr TypeTupleMore ;
TypeTupleRepeat = TypeExpr ";" TypeRepeatCount "]" ;
TypeNonFnExpr = TypeMatch | TypeBinary ;
TypeShapeRepeat = CountRepeat | PascalIdentRepeat | TypeRepeatPrefix ;
TypeRepeatCount = Number | LowerIdent | PascalIdent ;
Visibility = "pub" ;
Literal = Number | Bool | Char | String | fenced_text | LiteralType ;
Bool = "true" | "false" ;
Op = "+" | "-" | "*" | "/" | "%" | "==" | "!=" | CollectionOpen | "<=" | CollectionClose | ">=" | "&&" | "||" | "^^" | "<>" | "<$>" | "<*>" | ">>=" | "zip" | ".." ;
OpNoCollectionClose = "+" | "-" | "*" | "/" | "%" | "==" | "!=" | CollectionOpen | "<=" | ">=" | "&&" | "||" | "^^" | "<>" | "<$>" | "<*>" | ">>=" | "zip" | ".." ;
TypeOp = "==" | "!=" ;
