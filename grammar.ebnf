token CountRepeat = /[0-9]+\*/ ;
token Number = /[0-9]+(\.[0-9]+)?(i32|u32|i64|u64|f32|f64)?/ ;
token Char = /'([^'\\]|\\.)'/ ;
token String = /"([^"\\]|\\.)*"/ ;
token LiteralType = /#([a-z_][a-z0-9_]*|[A-Z][A-Za-z0-9]*)/ ;
token LowerFieldName = /[a-z_][a-z0-9_]*\s*:/ ;
token LowerIdentRepeat = /[a-z_][a-z0-9_]*\*/ ;
token PascalIdentRepeat = /[A-Z][A-Za-z0-9]*\*/ ;
token TypeRepeatPrefix = /([A-Z][A-Za-z0-9]*|[0-9]+)\*(\s*[0-9]+\*)*/ ;
token LowerIdent = /[a-z_][a-z0-9_]*/ ;
token PascalIdent = /[A-Z][A-Za-z0-9]*/ ;
skip Whitespace = /[ \t\r\n]+/ ;
skip Comment = /\/\/[^\n]*/ ;

Program = ModuleDecl? ImportDecl* Decl* ;
ModuleDecl = "module" Path ";" ;
ImportDecl = "import" (CapabilityImportTail | SourceImportTail) ;
CapabilityImportTail = "capability" ImportName Type EffectRow? ";" ;
SourceImportTail = "module" Path ";" ;
Decl = TypeFnDecl | ConstDecl | FnDecl | TopLetDecl ;
TypeFnDecl = "type" "fn" LowerIdent "(" TypeParamsDecl? ")" ReturnSig? TypeBlock ;
TypeBlock = "{" TypeBlockItem* "}" ;
TypeBlockItem = TypeLetDecl | TypeExpr ";"? ;
TypeLetDecl = "let" PascalIdent "=" TypeExpr ";" ;
TypeExpr = TypeMatch | FnType | TypeBinary ;
TypeMatch = "match" TypeExpr "{" TypeArm* "}" ;
TypeArm = TypePattern "=>" TypeExpr ","? ;
TypePattern = "_" | Literal | LowerIdent | PascalIdent ;
TypeBinary = TypeCall (TypeOp TypeCall)* ;
TypeCall = TypePrimary ("(" TypeExprArgs? ")")* ;
TypePrimary = TypeShape | StaticBuiltin | Literal | LowerIdent | PascalIdent ;
StaticBuiltin = "@" LowerIdent ;
TypeMember = "const" LowerFieldName Type "=" Expr ;
TypeInlineMember = FnDecl ;
TypeExprArgs = TypeExpr ("," TypeExpr)* ","? ;
FnDecl = Visibility? "fn" FnName "(" Params? ")" ReturnSig? EffectRow? Block ;
FnName = LowerIdent ("." LowerIdent)? ;
FnSig = "fn" FnName "(" Params? ")" ReturnSig? EffectRow? ";" ;
ConstDecl = "const" (LowerFieldName Type | LowerIdent TypeAnn?) "=" ConstValue ";"? ;
ConstValue = Expr ;
TopLetDecl = "let" (LowerFieldName Type "=" Expr ";" | LowerIdent TopLetTail) ;
TopLetTail = TypeAnn? "=" Expr ";" ;
Block = "{" BlockStmt* Expr? "}" ;
BlockStmt = BlockLetDecl | BlockProofConstDecl ;
BlockLetDecl = "let" (LowerFieldName Type "=" Expr ";" | LowerIdent BlockLetTail) ;
BlockLetTail = TypeAnn? "=" Expr ";" | "," LowerIdent "=" Expr ";" ;
BlockProofConstDecl = "const" PascalIdent "=" TypeExpr ";" ;
Expr = MatchExpr | Binary ;
MatchExpr = "match" Expr "{" Arm* "}" ;
Arm = Pattern "=>" Expr ","? ;
Binary = Call (Op Call)* ;
Call = Primary ("(" Args? ")" | "." LowerIdent | "[" Number "]")* ;
Primary = Literal | ForkBuiltin | StaticBuiltin | LowerIdent | PascalIdent ProductConstructorTail? | ParenExpr | ShapeValue ;
ProductConstructorTail = ShapeValue ;
ForkBuiltin = "fork" ;
ParenExpr = "(" Expr ")" ;
ShapeValue = "[" ShapeInit? "]" ;
Range = Expr ".." Expr ;
ShapeInit = ShapeValueSlot ("," ShapeValueSlot)* ","? ;
ShapeValueSlot = LowerFieldName Expr | Expr ;
Pattern = "_" | PatternIdent | Literal ;
PatternIdent = LowerIdent | PascalIdent ("(" Args? ")")? ;
Params = Param ("," Param)* ","? ;
Param = "const"? (LowerFieldName Type? | Literal TypeAnn? | "_" TypeAnn? | PatternIdent ParamTail?) ;
ParamTail = ":" Type? | Type ;
Args = Expr ("," Expr)* ","? ;
Type = FnType | "type" | LowerIdent TypeArgs? | PascalIdent TypeArgs? | ShapeType ;
FnType = "fn" "(" Params? ")" ReturnSig ;
TypeArgs = "(" Type ("," Type)* ")" ;
TypeParams = "(" PascalIdent ("," PascalIdent)* ")" ;
TypeParamsDecl = TypeParamDecl ("," TypeParamDecl)* ","? ;
TypeParamDecl = (PascalIdent ":" | LowerFieldName | LowerIdent ":" | Literal ":" | "_" ":") TypeParamKind ;
TypeParamKind = "count" | "type" TypeKindTail? ;
TypeKindTail = "fn" TypeConstructorTail ;
TypeConstructorTail = "(" TypeParamsDecl? ")" ReturnSig ;
TypeAnn = ":" Type ;
ReturnSig = "->" Type ;
EffectRow = "!" ("{" LowerIdent ("," LowerIdent)* "}" | "{}") ;
ShapeType = "[" ShapeSlot? ("," ShapeSlot)* ","? "]" ;
ShapeSlot = LowerFieldName ShapeSlotBody | ShapeSlotBody ;
ShapeSlotBody = CountRepeat Type | PascalIdentRepeat Type | LowerIdent TypeArgs? | PascalIdent TypeArgs? | ShapeType ;
TypeShape = "[" TypeShapeSlot? ("," TypeShapeSlot)* ","? "]" ;
TypeShapeSlot = LowerFieldName TypeShapeSlotBody | TypeShapeAnonSlotBody ;
TypeShapeSlotBody = TypeShapeRepeat TypeExpr | TypeExpr ;
TypeShapeAnonSlotBody = TypeShapeRepeat TypeNonFnExpr | TypeNonFnExpr ;
TypeNonFnExpr = TypeMatch | TypeBinary ;
TypeShapeRepeat = CountRepeat | PascalIdentRepeat | TypeRepeatPrefix ;
ImportName = LowerFieldName | LowerIdent ":" ;
ParamName = LowerFieldName | LowerIdent ":" ;
Visibility = "pub" ;
Literal = Number | Bool | Char | String | fenced_text | LiteralType ;
Bool = "true" | "false" ;
Path = LowerIdent ("." LowerIdent)* ;
Op = "+" | "-" | "*" | "/" | "==" | "!=" | "<" | "<=" | ">" | ">=" | "zip" | ".." ;
TypeOp = "==" | "!=" ;
